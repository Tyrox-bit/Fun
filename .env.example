# ===== Kopieren nach .env (lokal) bzw. in Vercel → Settings → Environment Variables =====

# Stripe: Dashboard → Entwickler → API-Schlüssel (erst sk_test_… zum Testen, dann sk_live_…)
STRIPE_SECRET_KEY=sk_test_xxx

# Stripe: Dashboard → Entwickler → Webhooks → Endpunkt https://DEINE-DOMAIN/api/stripe-webhook
# Events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Deine Live-Domain ohne / am Ende (für Weiterleitungen nach dem Bezahlen)
SITE_URL=https://www.kaspar-messer.de

# Optional: AGB-Häkchen im Stripe-Checkout (vorher AGB-URL in Stripe hinterlegen)
STRIPE_REQUIRE_TOS=false
# Optional: automatische Stripe-Rechnung als PDF (kostet Zusatzgebühr)
STRIPE_INVOICE=false

# E-Mails (Bestellbestätigung, Widerrufsbestätigung) über https://resend.com
RESEND_API_KEY=re_xxx
MAIL_FROM=Kaspar <bestellung@kaspar-messer.de>
# Hierhin gehen Bestell- und Widerrufs-Benachrichtigungen an dich
SHOP_EMAIL=hallo@kaspar-messer.de
