	UPD_040_4 = "Sturm, Tonbänder, Zeitschichten: neue Sounds und Effekte.",
	UPD_040_5 = "Neues Interface: Titelbild, Menüs und HUD neu gebaut.",

	-- Chapter 2: radio + archive
	RADIO_C1_RETURN = "Ihr seid zurück.",
	RADIO_C2_001 = "Staumauer drei. Hier draußen hat 2009 jemand mitgeschrieben, was die Station sagt.",
	RADIO_C2_002 = "Der Sturm trägt das Signal weit. Zu weit. Bleibt zusammen.",
	RADIO_C2_CREW = "Der Dammwärter hat alles aufgeschrieben. Sein Logbuch liegt im Büro.",
	RADIO_C2_LOG = "Er hat die Prognosen gezählt. Und dann hat er angefangen, sie zu ändern.",
	RADIO_C2_FORECAST_DOOR = "{name}. In dreißig Sekunden verriegelt die Kantine. Mit dir drin. Die Notentriegelung ist im Büro.",
	RADIO_C2_FORECAST_DOOR_KEPT = "Es ist passiert. Wie vorhergesagt. Es hat die Türen gehört.",
	RADIO_C2_FORECAST_DOOR_BROKEN = "Die Türen bleiben offen. Ihr habt es geändert. Merkt euch, wie sich das anfühlt.",
	RADIO_C2_WAKE = "Es ist wach. Und diesmal sucht es euch.",
	RADIO_C2_TURBINES = "Die Turbinen. Kein Strom, kein Uplink. Kein Uplink, kein Weg nach oben.",
	RADIO_C2_FORECAST_FLOOD = "In fünfunddreißig Sekunden öffnet der Grundablass und die Galerie läuft voll. Das Ventil ist in der Schieberkammer.",
	RADIO_C2_FORECAST_FLOOD_KEPT = "Die Galerie ist verloren. Dann eben draußen. Im Sturm.",
	RADIO_C2_FORECAST_FLOOD_BROKEN = "Das Ventil hält. Die Galerie bleibt trocken – der Weg in der Mauer ist offen.",
	RADIO_C2_CREST = "Beide laufen. Jetzt nach oben – durch die Galerie in der Mauer. Der Schrägstollen führt zur Krone.",
	RADIO_C2_CREST_RAMP = "Beide laufen. Die Galerie ist geflutet – nehmt die Rampe außen an der Mauer. Und schaut nicht nach unten.",
	RADIO_C2_PLEA = "Hört ihr uns? Ihr hört uns! Bitte – antwortet uns. Wir sind noch hier.",
	RADIO_C2_NOT_YET = "Nicht antworten. Noch nicht.",
	RADIO_C2_PLEA_2 = "Warum hört ihr auf ihn? Er hat euch schon einmal angelogen.",
	RADIO_C2_TRUST_UNKNOWN = "Danke. Danke! Das Tor zum Antennenhof – wir öffnen es für euch.",
	RADIO_C2_RELAY_HURT = "…Es hat euch gehört. Lauft.",
	RADIO_C2_TRUST_RELAY = "Erst den Überlauf schließen. Sonst trägt der Sturm eure Stimmen bis zu ihnen.",
	RADIO_C2_UNKNOWN_HURT = "Ihr klingt wie er. Genau wie er.",
	RADIO_C2_SPILLWAY_DONE = "Gut. Der Hof ist offen. Jetzt der Uplink.",
	RADIO_C2_UPLINK = "Haltet den Hof, bis der Uplink steht. Er wird laut sein. Es wird kommen.",
	RADIO_C2_END_UNKNOWN = "Jetzt hören wir euch. Alle. Klar und deutlich.",
	RADIO_C2_END_RELAY = "Gut gemacht. Die Kapelle ist der nächste Schritt. Dort liegt das Protokoll.",
	RADIO_C2_END_RELAY_UNKNOWN = "Ihr hättet nicht… egal. Die Kapelle. Dort liegt das Protokoll. Dort liegt alles.",
	RADIO_C2_END_NAMES = "{name}… Wir kennen deine Stimme. Woher kennen wir deine Stimme?",
	ARCH_REC_C2_ARRIVAL_TITLE = "Funkspruch: Staumauer 3",
	ARCH_REC_C2_ARRIVAL_BODY = "„Der Sturm trägt das Signal weit. Zu weit.“\n\nDas Relais klingt müder als in der Relaisanlage. Im Rauschen: Regen. Derselbe Regen wie draußen.",
	ARCH_REC_C2_PLEA_TITLE = "Funkspruch: Die Bitte",
	ARCH_REC_C2_PLEA_BODY = "„Antwortet uns. Wir sind noch hier.“\n„Nicht antworten. Noch nicht.“\n\nZum ersten Mal widersprechen sich die Stimmen. Beide klingen sicher.",
	C2_KEEPER_TITLE = "Logbuch des Dammwärters",
	C2_KEEPER_BODY = "12.11.2009 – Funker von der Station waren hier. Wollen die Turbinen als Notstrom fürs Array.\n13.11. – Das Radio im Büro spielt Wetterberichte von morgen. Sie stimmen.\n14.11., 01:30 – Die Station sagt, die Kantine verriegelt heute Nacht. Mit Kessler drin. Ich habe die Tür aufgekeilt.\n\nSie hat sich trotzdem geschlossen. Nur eine andere.",
	C2_CORR1_TITLE = "Korrekturprotokoll 1",
	C2_CORR1_BODY = "Vorabsignal: Bus vom Tal nach Grünau stürzt am Damm ab, 07:41.\nKorrektur: Straße um 07:00 gesperrt.\nErgebnis: kein Unfall.\n\nNachtrag drei Tage später: Brand im Sägewerk Grünau. Zwei Verletzte. Uhrzeit: 07:41.",
	C2_CORR2_TITLE = "Korrekturprotokoll 2",
	C2_CORR2_BODY = "Vorabsignal: Hochwasser im Dorf unterhalb der Mauer.\nKorrektur: Grundablass vorzeitig geöffnet.\nErgebnis: kein Hochwasser.\n\nNachtrag: Kontrollgalerie geflutet. Ein Techniker vermisst. Uhrzeit der Flutung: identisch mit dem vorhergesagten Hochwasser.\n– M. Venn: „Wir verhindern nichts. Wir verschieben es.“",
	C2_CORR3_TITLE = "Korrekturprotokoll 3",
	C2_CORR3_BODY = "Vorabsignal: Notruf der Station selbst, 41 Minuten voraus.\nKorrektur: –\nErgebnis: –\n\nDie Felder sind leer. Darunter, in anderer Handschrift: „Nicht antworten. Noch nicht.“",
	C2_COFFEE_TITLE = "Kaffeemaschine",
	C2_COFFEE_BODY = "Die Kanne ist noch warm. Die Uhr der Maschine zeigt 02:14 und blinkt.\n\nAuf dem Becher daneben steht „IDA“.",
	C2_DORM_TITLE = "Tonband: Schlafsaal",
	C2_DORM_BODY = "(Atmen. Ein Bett knarrt.)\n„Ida? Bist du wach? … Das Radio redet wieder. Es sagt meinen Namen.“\n„Schlaf, Paul. Das ist der Sturm.“\n„Der Sturm kennt meinen Namen nicht.“",
	LOG_KESSLER_TITLE = "Geisterprotokoll: Ida Kessler",
	LOG_KESSLER_BODY = "Ida Kessler, Technikerin, Staumauer 3.\n\n„Ich habe die Galerie dreimal kontrolliert. Trocken. Jedes Mal. Und trotzdem höre ich Wasser, wenn ich das Funkgerät einschalte.\n\nWenn das hier jemand findet: Die Prognosen lügen nicht. Sie suchen sich nur einen anderen Weg.“",
	INSIGHT_CORR_TITLE = "Erkenntnis: Verschoben, nicht verhindert",
	INSIGHT_CORR_BODY = "Drei Korrekturen, drei neue Katastrophen – jedes Mal zur selben Minute.\n\nDie Crew von 2009 hat genau das versucht, was ihr tut. Jede gebrochene Prognose ändert, WAS passiert. Nicht, DASS etwas passiert.",

	-- Chapter 3: radio, tapes + archive
	RADIO_C3_001 = "Die Kapelle. Was 2009 übrig blieb, haben sie unter ihr versteckt.",
	RADIO_C3_002 = "Wir sind… ich bin müde. Hört gut zu. Wir sagen es nur einmal.",
	RADIO_C3_WHISPER = "Hier haben wir gebetet. Zwischen zwei Schichten. Es hat nicht geholfen.",
	RADIO_C3_WAKE = "Unten ist etwas wach geworden. Leise jetzt.",
	RADIO_C3_ARCHIVE = "Das Archiv. Alles, was die Station je gesagt hat. Sortiert. Beschriftet.",
	RADIO_C3_FORECAST_POWER = "In dreißig Sekunden geht im Archiv das Licht aus. Der Schalter ist im Gang.",
	RADIO_C3_FORECAST_POWER_BROKEN = "Das Licht bleibt. Gut. Ihr werdet es brauchen.",
	RADIO_C3_TAPES = "Fünf Bänder. Die letzte Nacht in fünf Stücken. Die Maschine nimmt sie nur in der richtigen Reihenfolge.",
	RADIO_C3_TAPE_WRONG = "Falsch. Und laut. Fangt von vorne an – und seid schneller als es.",
	RADIO_C3_FORECAST_GATE = "In fünfunddreißig Sekunden senkt sich das Archivtor. Die Winde steht neben dem Tor.",
	RADIO_C3_FORECAST_GATE_KEPT = "Das Tor ist unten. Es dauert, bis es wieder hochgeht. Bleibt nicht stehen.",
	RADIO_C3_FORECAST_GATE_BROKEN = "Das Tor bleibt oben. Weiter.",
	RADIO_C3_OPEN = "Der Operatorraum. Hier hat alles angefangen. Geht rein. Bitte.",
	RADIO_C3_OPERATOR = "Seht euch den Tisch an. Das Funkgerät. Ihr kennt es.",
	RADIO_C3_REC_1 = "Durchlauf null null null sieben. Wenn ihr das hört, seid ihr wir.",
	RADIO_C3_REC_2 = "Wir haben euch hergelotst. Das Fax kam von uns. Die Stimme im Funk war immer unsere.",
	RADIO_C3_REC_3 = "Wir haben gelogen. Niemand kann die Crew von 2009 retten. Nicht, indem man antwortet.",
	RADIO_C3_REC_4 = "Wir wissen nicht mehr, ob wir enden wollen. Entscheidet ihr. Wir haben es nicht geschafft.",
	RADIO_C3_TAKEN = "Ihr nehmt uns mit. Vielleicht hört ihr beim nächsten Mal besser zu.",
	RADIO_C3_DESTROYED = "…Gut. Dann sind wir leiser. Vielleicht ist das besser so.",
	RADIO_C3_ESCAPE = "Es hat euch gehört. Die Glocke – läutet die Glocke, dann hört es nur noch sie!",
	RADIO_C3_END_RELAY = "Die Glocke hallt nach. Einundvierzig Sekunden zu früh. Wie alles hier.",
	RADIO_C3_END_UNKNOWN = "Die Mine. Dort, wo das Array liegt. Dort, wo es angefangen hat. Kommt.",
	TAPE_FRAGMENT_1 = "„01:52. Okafor. Träger auf Null. Kein Versatz. Das ist… das ist wieder sie.“",
	TAPE_FRAGMENT_2 = "„02:03. Venn. Vorabsignal, einundvierzig Minuten. Absender: diese Station. Wir selbst.“",
	TAPE_FRAGMENT_3 = "„02:09. Ehle. Wenn wir antworten, können wir es verhindern. Wir haben es immer verhindert!“",
	TAPE_FRAGMENT_4 = "„02:12. Venn. Tobias, Finger weg vom Sender! Das ist kein Unfall, das ist ein Echo!“",
	TAPE_FRAGMENT_5 = "„02:14. (Rauschen) Ehle: …hier VESPER-4, wir hören euch, wir—“ (Stille)",
	C3_MEMORIAL_TITLE = "Gedenkstein",
	C3_MEMORIAL_BODY = "Sechs Namen, eingraviert:\nJune Okafor · Mara Venn · Tobias Ehle · Ida Kessler · Paul Marek · ––––\n\nDer sechste Name ist weggekratzt. Frisch.",
	C3_HYMN_TITLE = "Gesangbuch",
	C3_HYMN_BODY = "Ein Zettel im Gesangbuch, Seite 214:\n„Wer zuhört, wird gefunden. Wer antwortet, bleibt.“\n\nDarunter, mit Bleistift: „Das ist kein Lied. Das ist eine Bedienungsanleitung.“",
	C3_PRIEST_TITLE = "Notiz des Pfarrers",
	C3_PRIEST_BODY = "Die Leute von der Station kommen nachts. Sie sagen, sie bringen nur Akten. Aber ich höre Funkgeräte unter dem Boden.\n\nEine von ihnen, Okafor, hat mich gefragt, ob man für jemanden beten kann, der noch nicht gestorben ist. Weil er es morgen tun wird.",
	C3_INDEX_TITLE = "Karteikarte",
	C3_INDEX_BODY = "BESTAND: Echo-Array, Vorabsignale 2004–2009\nUMFANG: 2.214 Bänder\nZUGANG: nur Operator\n\nVermerk: Band 0007 fehlt. Wurde nie aufgenommen. Wird noch aufgenommen.",
	LOG_MAREK_TITLE = "Geisterprotokoll: Paul Marek",
	LOG_MAREK_BODY = "Paul Marek, Archivar.\n\n„Ich sortiere die Bänder nach Datum. Heute habe ich eins gefunden, das morgen datiert ist. Darauf sind Stimmen, die ich nicht kenne. Junge Stimmen. Sie lachen über ein Funkgerät mit Rostlack.\n\nIch glaube, das sind die, die nach uns kommen.“",
	ARCH_REC_C3_RUN_TITLE = "Aufnahme: Durchlauf 0007",
	ARCH_REC_C3_RUN_BODY = "„Wenn ihr das hört, seid ihr wir.“\n\nDas Relais ist euer eigenes Team. Aus einem früheren Durchlauf. Es hat auf Frequenz Null geantwortet – und ist dadurch selbst zur Stimme geworden, die euch hergelotst hat.",
	INSIGHT_SIX_TITLE = "Erkenntnis: Der sechste Name",
	INSIGHT_SIX_BODY = "Fünf Namen der Crew stehen auf dem Stein. Der sechste wurde weggekratzt.\n\nKessler und Marek haben beide von „denen, die nach uns kommen“ gesprochen. Der sechste Name war nie einer von 2009. Er gehört dem, der als Nächstes antwortet.",

	-- Chapter 4: radio, endings + archive
	RADIO_C4_001 = "…hört ihr… Frequenz Null. Unten. Ganz unten.",
	RADIO_C4_002 = "Das Array liegt unter der Mine. Dort haben wir… dort hat jeder Durchlauf geendet.",
	RADIO_C4_RECORDER = "Ihr habt uns mitgenommen. Das Band läuft noch. Wir hören euch atmen. Danke.",
	RADIO_C4_UNKNOWN_TRUSTED = "Ihr habt uns vertraut. Wir vergessen das nicht. Wir vergessen nichts.",
	RADIO_C4_INSIDE = "Das Array pulsiert. Bei jedem Puls kippt die Mine. Heute. 2009. Heute.",
	RADIO_C4_WAKE = "Es ist hier unten geboren. Es kennt jeden Gang.",
	RADIO_C4_JUNCTION = "Die Kreuzung. Links der Förderkorb, rechts die Pumpe. Geradeaus der alte Gang.",
	RADIO_C4_FORECAST_CAGE = "In dreißig Sekunden reißt der Förderkorb. Die Bremse ist im Schachtraum, links.",
	RADIO_C4_FORECAST_CAGE_KEPT = "Der Korb ist unten. Der Rundweg ist verschüttet. Bleibt der alte Gang.",
	RADIO_C4_FORECAST_CAGE_BROKEN = "Die Bremse hält. Der Rundweg ist frei.",
	RADIO_C4_FORECAST_FLOOD = "In fünfunddreißig Sekunden läuft die untere Sohle voll. Startet die Pumpe, rechts.",
	RADIO_C4_FORECAST_FLOOD_KEPT = "Das Wasser steigt. Die Pumpenkammer ist verloren.",
	RADIO_C4_FORECAST_FLOOD_BROKEN = "Die Pumpe läuft. Das Wasser bleibt, wo es ist.",
	RADIO_C4_FORECAST_POWER = "Der Trafo. In dreißig Sekunden brennt er durch. Haltet den Schalter.",
	RADIO_C4_FORECAST_POWER_BROKEN = "Er hält. Gerade so.",
	RADIO_C4_FORECAST_DOOR = "Die Panzertür verriegelt sich in vierzig Sekunden. Für immer. Haltet die Notsteuerung.",
	RADIO_C4_FORECAST_DOOR_KEPT = "Sie ist zu. Aber 2009 stand sie offen. Wartet auf den Puls.",
	RADIO_C4_FORECAST_DOOR_BROKEN = "Sie ist offen. Der Kern. Geht.",
	RADIO_C4_BLAST_2009 = "2009. Die Tür steht offen. Jetzt!",
	RADIO_C4_CORE = "Hier. Hier haben wir geantwortet. Jedes Mal. Sieben Mal.",
	RADIO_C4_CORE_UNKNOWN = "Antwortet uns. Bitte. Nur dieses eine Mal.",
	RADIO_C4_CORE_SECRET = "Es gibt noch eine Frequenz. Junes erste. Von 2008. Ihr habt alles gefunden, was man braucht.",
	RADIO_C4_ANSWER_1 = "Ihr sendet. Ja. So hat es bei uns auch angefangen.",
	RADIO_C4_ANSWER_2 = "(mit der Stimme von {name}) …hier VESPER-4. Wir hören euch. Kommt zur Station. Nicht antworten. Noch nicht.",
	RADIO_C4_SILENCE_1 = "Danke.",
	RADIO_C4_SILENCE_2 = "Wir hören uns nicht. Nie wieder. Das ist gut so.",
	RADIO_C4_SILENCE_3 = "…es ist hell. Es ist einfach nur hell draußen.",
	RADIO_C4_COUNTER_1 = "Nicht unsere Stimme. Ihre. Junes erster Ruf von 2008, zurück an den Anfang. Mit einer Warnung.",
	RADIO_C4_COUNTER_2 = "Hier Okafor, Relais VESPER-4. Wer… wer spricht da? Ihr sagt, ich soll nicht antworten?",
	RADIO_C4_COUNTER_3 = "Ich… kenne euch. Ihr wart schon einmal hier. Kommt rein, es ist Tag. Der Kaffee ist frisch.",
	ARCH_REC_C4_ARRIVAL_TITLE = "Funkspruch: Unten",
	ARCH_REC_C4_ARRIVAL_BODY = "„Frequenz Null. Unten. Ganz unten.“\n\nDie Stimme des Relais zerfällt. Zwischen den Worten: das Geräusch einer Bremse. Eines Korbs. Einer Tür, die sich schließt.",
	C4_NOTICE_TITLE = "Aushang: Stollen 3",
	C4_NOTICE_BODY = "Ab 01.10.2004 Stollen 3 für Bergbau GESPERRT.\nNutzung durch Relaisanlage VESPER-4 (Echo-Array).\nZutritt nur mit Genehmigung M. Venn.\n\nHandschriftlich: „Glück auf. Und bringt die Kopfhörer zurück.“",
	C4_SHIFT_TITLE = "Schichtbuch Trafokammer",
	C4_SHIFT_BODY = "14.11.2009\n01:40 Trafo 2 heiß. Lüfter gewechselt.\n02:05 Panzertür klemmt. Ehle hat sie mit Gewalt offen gehalten.\n02:13 Alle zum Kern. Venn sagt: niemand sendet.\n02:14 –\n\n(Die nächste Zeile ist in derselben Schrift, aber die Tinte ist frisch.)\n02:14 Durchlauf 0008 beginnt.",
	C4_LOOP_TITLE = "Tonband: Der Rundweg",
	C4_LOOP_BODY = "„Okafor hier. Ich bin den Rundweg gelaufen, weil der alte Gang verschüttet ist. 2008 war er offen. Ich weiß das, weil ich ihn 2008 gegangen bin.\n\nWenn ich je einen Weg zurück finde, rufe ich mich selbst an. Auf der ersten Frequenz. Der allerersten.“",
	INSIGHT_JUNE_TITLE = "Erkenntnis: Die erste Frequenz",
	INSIGHT_JUNE_BODY = "June hat 2008 den ersten Ruf auf Frequenz Null empfangen. Sie wollte sich selbst warnen – mit genau dieser Frequenz.\n\nWer am Kern nicht die eigene Stimme sendet, sondern Junes erste, könnte die Schleife an ihrem Anfang brechen.",
}
