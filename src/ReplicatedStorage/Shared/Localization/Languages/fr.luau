	RADIO_C4_SILENCE_3 = "...il fait jour. Dehors, il fait simplement jour.",
	RADIO_C4_COUNTER_1 = "Pas notre voix. La sienne. Le premier appel de June en 2008, renvoyé au début. Avec un avertissement.",
	RADIO_C4_COUNTER_2 = "Ici Okafor, relais VESPER-4. Qui... qui parle ? Vous me dites de ne pas répondre ?",
	RADIO_C4_COUNTER_3 = "Je... vous connais. Vous êtes déjà venus. Entrez, il fait jour. Le café est frais.",
	ARCH_REC_C4_ARRIVAL_TITLE = "Radio : En bas",
	ARCH_REC_C4_ARRIVAL_BODY = "« Fréquence Zéro. En bas. Tout en bas. »\n\nLa voix du Relais se défait. Entre les mots : le bruit d'un frein. D'une cage. D'une porte qui se ferme.",
	C4_NOTICE_TITLE = "Avis : Galerie 3",
	C4_NOTICE_BODY = "À partir du 01/10/2004, la galerie 3 est FERMÉE à l'exploitation.\nUtilisation par la station VESPER-4 (Echo-Array).\nAccès uniquement avec l'accord de M. Venn.\n\nÀ la main : « Bonne chance en bas. Et rapportez les casques. »",
	C4_SHIFT_TITLE = "Cahier de poste du transformateur",
	C4_SHIFT_BODY = "14/11/2009\n01 h 40 Transfo 2 chaud. Ventilateur changé.\n02 h 05 La porte blindée coince. Ehle l'a tenue ouverte de force.\n02 h 13 Tous au cœur. Venn dit : personne n'émet.\n02 h 14 -\n\n(La ligne suivante est de la même écriture, mais l'encre est fraîche.)\n02 h 14 Début du passage 0008.",
	C4_LOOP_TITLE = "Bande : La boucle",
	C4_LOOP_BODY = "« Ici Okafor. J'ai pris la boucle parce que l'ancien passage est enseveli. En 2008, il était ouvert. Je le sais, je l'ai emprunté en 2008.\n\nSi je trouve un jour le chemin du retour, je m'appellerai moi-même. Sur la première fréquence. La toute première. »",
	INSIGHT_JUNE_TITLE = "Révélation : La première fréquence",
	INSIGHT_JUNE_BODY = "En 2008, June a reçu le premier appel sur la Fréquence Zéro. Elle voulait se prévenir elle-même - sur exactement cette fréquence.\n\nCelui qui, au cœur, n'émet pas sa propre voix mais la première de June pourrait briser la boucle à son origine.",
