	RADIO_C2_FORECAST_DOOR = "{name}. Dans trente secondes, la cantine se verrouille. Avec toi dedans. Le déverrouillage est dans le bureau.",
	RADIO_C2_FORECAST_DOOR_KEPT = "C'est arrivé. Comme prévu. Il a entendu les portes.",
	RADIO_C2_FORECAST_DOOR_BROKEN = "Les portes restent ouvertes. Vous l'avez changé. Retenez ce que ça fait.",
	RADIO_C2_WAKE = "Il est réveillé. Et cette fois, il vous cherche.",
	RADIO_C2_TURBINES = "Les turbines. Pas de courant, pas de liaison. Pas de liaison, pas de montée.",
	RADIO_C2_FORECAST_FLOOD = "Dans trente-cinq secondes, la vidange s'ouvre et la galerie se noie. La vanne est dans la salle des vannes.",
	RADIO_C2_FORECAST_FLOOD_KEPT = "La galerie est perdue. Par l'extérieur, alors. Dans la tempête.",
	RADIO_C2_FORECAST_FLOOD_BROKEN = "La vanne tient. La galerie reste sèche - le chemin dans le barrage est ouvert.",
	RADIO_C2_CREST = "Les deux tournent. Maintenant, en haut - par la galerie du barrage. Le puits incliné mène à la crête.",
	RADIO_C2_CREST_RAMP = "Les deux tournent. La galerie est noyée - prenez la rampe sur la façade. Et ne regardez pas en bas.",
	RADIO_C2_PLEA = "Vous nous entendez ? Vous nous entendez ! S'il vous plaît, répondez-nous. Nous sommes encore là.",
	RADIO_C2_NOT_YET = "Ne répondez pas. Pas encore.",
	RADIO_C2_PLEA_2 = "Pourquoi l'écoutez-vous ? Il vous a déjà menti.",
	RADIO_C2_TRUST_UNKNOWN = "Merci. Merci ! La grille de la cour d'antenne - nous l'ouvrons pour vous.",
	RADIO_C2_RELAY_HURT = "...Il vous a entendus. Courez.",
	RADIO_C2_TRUST_RELAY = "Fermez d'abord le déversoir. Sinon la tempête portera vos voix jusqu'à eux.",
	RADIO_C2_UNKNOWN_HURT = "Vous parlez comme lui. Exactement comme lui.",
	RADIO_C2_SPILLWAY_DONE = "Bien. La cour est ouverte. Maintenant la liaison.",
	RADIO_C2_UPLINK = "Tenez la cour jusqu'à ce que la liaison tienne. Ce sera bruyant. Il viendra.",
	RADIO_C2_END_UNKNOWN = "Maintenant nous vous entendons. Tous. Fort et clair.",
	RADIO_C2_END_RELAY = "Bien joué. La chapelle est la suite. C'est là qu'est le protocole.",
	RADIO_C2_END_RELAY_UNKNOWN = "Vous n'auriez pas dû... peu importe. La chapelle. Le protocole est là-bas. Tout est là-bas.",
	RADIO_C2_END_NAMES = "{name}... Nous connaissons ta voix. Comment connaissons-nous ta voix ?",
	ARCH_REC_C2_ARRIVAL_TITLE = "Radio : Barrage 3",
	ARCH_REC_C2_ARRIVAL_BODY = "« La tempête porte le signal loin. Trop loin. »\n\nLe Relais semble plus fatigué qu'à la station. Dans le grésillement : de la pluie. La même pluie que dehors.",
	ARCH_REC_C2_PLEA_TITLE = "Radio : La supplique",
	ARCH_REC_C2_PLEA_BODY = "« Répondez-nous. Nous sommes encore là. »\n« Ne répondez pas. Pas encore. »\n\nPour la première fois, les voix se contredisent. Les deux semblent sûres.",
	C2_KEEPER_TITLE = "Journal du gardien",
	C2_KEEPER_BODY = "12/11/2009 - Des radios de la station sont venus. Ils veulent les turbines comme secours pour l'Array.\n13/11 - La radio du bureau donne la météo de demain. Elle a raison.\n14/11, 01 h 30 - La station dit que la cantine se verrouillera cette nuit. Avec Kessler dedans. J'ai calé la porte.\n\nElle s'est fermée quand même. Juste une autre.",
	C2_CORR1_TITLE = "Protocole de correction 1",
	C2_CORR1_BODY = "Signal anticipé : un bus de la vallée vers Grünau chute au barrage, 07 h 41.\nCorrection : route fermée à 07 h 00.\nRésultat : aucun accident.\n\nAjout trois jours plus tard : incendie à la scierie de Grünau. Deux blessés. Heure : 07 h 41.",
	C2_CORR2_TITLE = "Protocole de correction 2",
	C2_CORR2_BODY = "Signal anticipé : crue dans le village sous le barrage.\nCorrection : vidange ouverte en avance.\nRésultat : pas de crue.\n\nAjout : galerie d'inspection noyée. Un technicien disparu. Heure de l'inondation : identique à la crue prévue.\n- M. Venn : « Nous n'empêchons rien. Nous le déplaçons. »",
	C2_CORR3_TITLE = "Protocole de correction 3",
	C2_CORR3_BODY = "Signal anticipé : appel de détresse de la station elle-même, 41 minutes à l'avance.\nCorrection : -\nRésultat : -\n\nLes champs sont vides. En dessous, d'une autre écriture : « Ne répondez pas. Pas encore. »",
	C2_COFFEE_TITLE = "Machine à café",
	C2_COFFEE_BODY = "La verseuse est encore chaude. L'horloge de la machine affiche 02:14 et clignote.\n\nSur la tasse à côté : « IDA ».",
	C2_DORM_TITLE = "Bande : Dortoir",
	C2_DORM_BODY = "(Une respiration. Un lit grince.)\n« Ida ? Tu dors ? ... La radio reparle. Elle dit mon nom. »\n« Dors, Paul. C'est la tempête. »\n« La tempête ne connaît pas mon nom. »",
	LOG_KESSLER_TITLE = "Journal fantôme : Ida Kessler",
	LOG_KESSLER_BODY = "Ida Kessler, technicienne, Barrage 3.\n\n« J'ai contrôlé la galerie trois fois. Sèche. À chaque fois. Et pourtant j'entends de l'eau quand j'allume la radio.\n\nSi quelqu'un trouve ceci : les prévisions ne mentent pas. Elles trouvent juste un autre chemin. »",
	INSIGHT_CORR_TITLE = "Révélation : Déplacé, pas empêché",
	INSIGHT_CORR_BODY = "Trois corrections, trois nouvelles catastrophes - chaque fois à la même minute.\n\nL'équipe de 2009 a tenté exactement ce que vous faites. Chaque prévision brisée change CE qui arrive. Pas le fait QUE quelque chose arrive.",

	-- Chapter 3: radio, tapes + archive
	RADIO_C3_001 = "La chapelle. Ce qui restait en 2009, ils l'ont caché dessous.",
	RADIO_C3_002 = "Nous sommes... je suis fatigué. Écoutez bien. Nous ne le dirons qu'une fois.",
	RADIO_C3_WHISPER = "Nous priions ici. Entre deux équipes. Ça n'a pas aidé.",
	RADIO_C3_WAKE = "Quelque chose s'est réveillé en bas. Doucement.",
	RADIO_C3_ARCHIVE = "Les archives. Tout ce que la station a jamais dit. Trié. Étiqueté.",
	RADIO_C3_FORECAST_POWER = "Dans trente secondes, les archives s'éteignent. Le disjoncteur est dans le couloir.",
	RADIO_C3_FORECAST_POWER_BROKEN = "La lumière reste. Bien. Vous en aurez besoin.",
	RADIO_C3_TAPES = "Cinq bandes. La dernière nuit en cinq morceaux. La machine ne les prend que dans le bon ordre.",
	RADIO_C3_TAPE_WRONG = "Faux. Et bruyant. Recommencez - et soyez plus rapides que lui.",
	RADIO_C3_FORECAST_GATE = "Dans trente-cinq secondes, la grille des archives tombe. Le treuil est à côté.",
	RADIO_C3_FORECAST_GATE_KEPT = "La grille est tombée. Elle mettra du temps à remonter. Ne restez pas immobiles.",
	RADIO_C3_FORECAST_GATE_BROKEN = "La grille reste en haut. Continuez.",
	RADIO_C3_OPEN = "La salle de l'opérateur. C'est là que tout a commencé. Entrez. S'il vous plaît.",
	RADIO_C3_OPERATOR = "Regardez la table. La radio. Vous la connaissez.",
	RADIO_C3_REC_1 = "Passage zéro zéro zéro sept. Si vous entendez ceci, vous êtes nous.",
	RADIO_C3_REC_2 = "Nous vous avons guidés ici. Le fax venait de nous. La voix à la radio a toujours été la nôtre.",
	RADIO_C3_REC_3 = "Nous avons menti. Personne ne peut sauver l'équipe de 2009. Pas en répondant.",
	RADIO_C3_REC_4 = "Nous ne savons plus si nous voulons que ça finisse. Décidez, vous. Nous n'y sommes pas arrivés.",
	RADIO_C3_TAKEN = "Vous nous emportez. Peut-être écouterez-vous mieux la prochaine fois.",
	RADIO_C3_DESTROYED = "...Bien. Alors nous serons plus silencieux. C'est peut-être mieux.",
	RADIO_C3_ESCAPE = "Il vous a entendus. La cloche - sonnez la cloche, il n'entendra plus qu'elle !",
	RADIO_C3_END_RELAY = "La cloche résonne encore. Quarante et une secondes trop tôt. Comme tout ici.",
	RADIO_C3_END_UNKNOWN = "La mine. Là où se trouve l'Array. Là où tout a commencé. Venez.",
	TAPE_FRAGMENT_1 = "« 01 h 52. Okafor. Porteuse à zéro. Aucun décalage. C'est... c'est encore elle. »",
	TAPE_FRAGMENT_2 = "« 02 h 03. Venn. Signal anticipé, quarante et une minutes. Expéditeur : cette station. Nous. »",
	TAPE_FRAGMENT_3 = "« 02 h 09. Ehle. Si on répond, on peut l'empêcher. On l'a toujours empêché ! »",
	TAPE_FRAGMENT_4 = "« 02 h 12. Venn. Tobias, ne touche pas à l'émetteur ! Ce n'est pas un accident, c'est un écho ! »",
	TAPE_FRAGMENT_5 = "« 02 h 14. (grésillement) Ehle : ...ici VESPER-4, on vous entend, on- » (silence)",
	C3_MEMORIAL_TITLE = "Stèle commémorative",
	C3_MEMORIAL_BODY = "Six noms gravés :\nJune Okafor · Mara Venn · Tobias Ehle · Ida Kessler · Paul Marek · ----\n\nLe sixième nom a été gratté. Récemment.",
	C3_HYMN_TITLE = "Livre de cantiques",
	C3_HYMN_BODY = "Une note dans le livre, page 214 :\n« Qui écoute sera trouvé. Qui répond restera. »\n\nEn dessous, au crayon : « Ce n'est pas un cantique. C'est un mode d'emploi. »",
	C3_PRIEST_TITLE = "Note du curé",
	C3_PRIEST_BODY = "Les gens de la station viennent la nuit. Ils disent n'apporter que des dossiers. Mais j'entends des radios sous le sol.\n\nL'une d'eux, Okafor, m'a demandé si l'on peut prier pour quelqu'un qui n'est pas encore mort. Parce qu'il le fera demain.",
	C3_INDEX_TITLE = "Fiche",
	C3_INDEX_BODY = "FONDS : Echo-Array, signaux anticipés 2004-2009\nVOLUME : 2 214 bandes\nACCÈS : opérateur uniquement\n\nNote : la bande 0007 manque. Jamais enregistrée. Encore en cours d'enregistrement.",
	LOG_MAREK_TITLE = "Journal fantôme : Paul Marek",
	LOG_MAREK_BODY = "Paul Marek, archiviste.\n\n« Je trie les bandes par date. Aujourd'hui, j'en ai trouvé une datée de demain. Il y a des voix que je ne connais pas. Des voix jeunes. Elles rient d'une radio peinte couleur rouille.\n\nJe crois que ce sont ceux qui viennent après nous. »",
	ARCH_REC_C3_RUN_TITLE = "Enregistrement : Passage 0007",
	ARCH_REC_C3_RUN_BODY = "« Si vous entendez ceci, vous êtes nous. »\n\nLe Relais, c'est votre propre équipe. D'un passage précédent. Elle a répondu sur la Fréquence Zéro - et est devenue la voix qui vous a guidés ici.",
	INSIGHT_SIX_TITLE = "Révélation : Le sixième nom",
	INSIGHT_SIX_BODY = "Cinq noms de l'équipe sont sur la pierre. Le sixième a été gratté.\n\nKessler et Marek ont tous deux parlé de « ceux qui viennent après nous ». Le sixième nom n'a jamais été de 2009. Il appartient au prochain qui répondra.",

	-- Chapter 4: radio, endings + archive
	RADIO_C4_001 = "...vous entendez... Fréquence Zéro. En bas. Tout en bas.",
	RADIO_C4_002 = "L'Array est sous la mine. C'est là que nous... que chaque passage s'est terminé.",
	RADIO_C4_RECORDER = "Vous nous avez emportés. La bande tourne encore. Nous vous entendons respirer. Merci.",
	RADIO_C4_UNKNOWN_TRUSTED = "Vous nous avez fait confiance. Nous ne l'oublierons pas. Nous n'oublions rien.",
	RADIO_C4_INSIDE = "L'Array pulse. À chaque pulsation, la mine bascule. Aujourd'hui. 2009. Aujourd'hui.",
	RADIO_C4_WAKE = "Il est né ici. Il connaît chaque galerie.",
	RADIO_C4_JUNCTION = "Le carrefour. À gauche la cage, à droite la pompe. Tout droit, l'ancien passage.",
	RADIO_C4_FORECAST_CAGE = "Dans trente secondes, la cage lâche. Le frein est dans la salle du puits, à gauche.",
	RADIO_C4_FORECAST_CAGE_KEPT = "La cage est tombée. La boucle est ensevelie. Reste l'ancien passage.",
	RADIO_C4_FORECAST_CAGE_BROKEN = "Le frein tient. La boucle est libre.",
	RADIO_C4_FORECAST_FLOOD = "Dans trente-cinq secondes, le niveau inférieur se noie. Démarrez la pompe, à droite.",
	RADIO_C4_FORECAST_FLOOD_KEPT = "L'eau monte. La salle des pompes est perdue.",
	RADIO_C4_FORECAST_FLOOD_BROKEN = "La pompe tourne. L'eau reste où elle est.",
	RADIO_C4_FORECAST_POWER = "Le transformateur. Dans trente secondes, il grille. Tenez le disjoncteur.",
	RADIO_C4_FORECAST_POWER_BROKEN = "Il tient. De justesse.",
	RADIO_C4_FORECAST_DOOR = "La porte blindée se verrouille dans quarante secondes. Pour toujours. Tenez la commande.",
	RADIO_C4_FORECAST_DOOR_KEPT = "Elle est fermée. Mais en 2009, elle était ouverte. Attendez la pulsation.",
	RADIO_C4_FORECAST_DOOR_BROKEN = "Elle est ouverte. Le cœur. Allez-y.",
	RADIO_C4_BLAST_2009 = "2009. La porte est ouverte. Maintenant !",
	RADIO_C4_CORE = "Ici. C'est ici que nous avons répondu. Chaque fois. Sept fois.",
	RADIO_C4_CORE_UNKNOWN = "Répondez-nous. S'il vous plaît. Juste cette fois.",
	RADIO_C4_CORE_SECRET = "Il existe une autre fréquence. La première de June. De 2008. Vous avez trouvé tout ce qu'il faut.",
	RADIO_C4_ANSWER_1 = "Vous émettez. Oui. C'est comme ça que ça a commencé pour nous aussi.",
