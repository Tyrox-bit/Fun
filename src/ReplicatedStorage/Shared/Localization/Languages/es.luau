	RADIO_C2_FORECAST_DOOR_BROKEN = "Las puertas siguen abiertas. Lo habéis cambiado. Recordad cómo se siente.",
	RADIO_C2_WAKE = "Está despierto. Y esta vez os busca a vosotros.",
	RADIO_C2_TURBINES = "Las turbinas. Sin energía no hay enlace. Sin enlace no hay subida.",
	RADIO_C2_FORECAST_FLOOD = "En treinta y cinco segundos se abre el desagüe y la galería se inunda. La válvula está en la cámara de válvulas.",
	RADIO_C2_FORECAST_FLOOD_KEPT = "La galería está perdida. Pues por fuera. En la tormenta.",
	RADIO_C2_FORECAST_FLOOD_BROKEN = "La válvula aguanta. La galería sigue seca: el camino por dentro está abierto.",
	RADIO_C2_CREST = "Las dos funcionan. Ahora arriba: por la galería de la presa. El pozo inclinado lleva a la coronación.",
	RADIO_C2_CREST_RAMP = "Las dos funcionan. La galería está inundada: usad la rampa exterior. Y no miréis abajo.",
	RADIO_C2_PLEA = "¿Nos oís? ¡Nos oís! Por favor, respondednos. Seguimos aquí.",
	RADIO_C2_NOT_YET = "No respondáis. Todavía no.",
	RADIO_C2_PLEA_2 = "¿Por qué le hacéis caso? Ya os mintió una vez.",
	RADIO_C2_TRUST_UNKNOWN = "Gracias. ¡Gracias! La puerta del patio de antenas: os la abrimos.",
	RADIO_C2_RELAY_HURT = "...Os ha oído. Corred.",
	RADIO_C2_TRUST_RELAY = "Primero cerrad el aliviadero. Si no, la tormenta llevará vuestras voces hasta ellos.",
	RADIO_C2_UNKNOWN_HURT = "Sonáis como él. Exactamente como él.",
	RADIO_C2_SPILLWAY_DONE = "Bien. El patio está abierto. Ahora el enlace.",
	RADIO_C2_UPLINK = "Mantened el patio hasta que el enlace esté listo. Hará ruido. Vendrá.",
	RADIO_C2_END_UNKNOWN = "Ahora os oímos. A todos. Alto y claro.",
	RADIO_C2_END_RELAY = "Bien hecho. La capilla es lo siguiente. Allí está el protocolo.",
	RADIO_C2_END_RELAY_UNKNOWN = "No deberíais haber... da igual. La capilla. Allí está el protocolo. Allí está todo.",
	RADIO_C2_END_NAMES = "{name}... Conocemos tu voz. ¿Cómo es que conocemos tu voz?",
	ARCH_REC_C2_ARRIVAL_TITLE = "Radio: Presa 3",
	ARCH_REC_C2_ARRIVAL_BODY = "«La tormenta lleva la señal lejos. Demasiado.»\n\nEl Relé suena más cansado que en la estación. En la estática: lluvia. La misma lluvia que fuera.",
	ARCH_REC_C2_PLEA_TITLE = "Radio: La súplica",
	ARCH_REC_C2_PLEA_BODY = "«Respondednos. Seguimos aquí.»\n«No respondáis. Todavía no.»\n\nPor primera vez las voces se contradicen. Las dos suenan seguras.",
	C2_KEEPER_TITLE = "Registro del guarda",
	C2_KEEPER_BODY = "12/11/2009 - Vinieron radiotelegrafistas de la estación. Quieren las turbinas como energía de reserva para el Array.\n13/11 - La radio de la oficina da el tiempo de mañana. Acierta.\n14/11, 01:30 - La estación dice que el comedor se cerrará esta noche. Con Kessler dentro. Calcé la puerta.\n\nSe cerró igualmente. Solo que otra.",
	C2_CORR1_TITLE = "Protocolo de corrección 1",
	C2_CORR1_BODY = "Señal anticipada: un autobús del valle a Grünau cae en la presa, 07:41.\nCorrección: carretera cerrada a las 07:00.\nResultado: sin accidente.\n\nAnexo tres días después: incendio en el aserradero de Grünau. Dos heridos. Hora: 07:41.",
	C2_CORR2_TITLE = "Protocolo de corrección 2",
	C2_CORR2_BODY = "Señal anticipada: inundación en el pueblo bajo la presa.\nCorrección: desagüe abierto antes de tiempo.\nResultado: sin inundación.\n\nAnexo: galería de inspección inundada. Un técnico desaparecido. Hora de la inundación: idéntica a la predicha.\n- M. Venn: «No evitamos nada. Lo desplazamos.»",
	C2_CORR3_TITLE = "Protocolo de corrección 3",
	C2_CORR3_BODY = "Señal anticipada: llamada de socorro de la propia estación, 41 minutos antes.\nCorrección: -\nResultado: -\n\nLos campos están vacíos. Debajo, con otra letra: «No respondáis. Todavía no.»",
	C2_COFFEE_TITLE = "Cafetera",
	C2_COFFEE_BODY = "La jarra aún está caliente. El reloj de la máquina marca 02:14 y parpadea.\n\nLa taza de al lado dice «IDA».",
	C2_DORM_TITLE = "Cinta: Dormitorio",
	C2_DORM_BODY = "(Respiración. Cruje una cama.)\n«¿Ida? ¿Estás despierta? ... La radio vuelve a hablar. Dice mi nombre.»\n«Duerme, Paul. Es la tormenta.»\n«La tormenta no sabe mi nombre.»",
	LOG_KESSLER_TITLE = "Registro fantasma: Ida Kessler",
	LOG_KESSLER_BODY = "Ida Kessler, técnica, Presa 3.\n\n«Revisé la galería tres veces. Seca. Siempre. Y aun así oigo agua cuando enciendo la radio.\n\nSi alguien encuentra esto: las predicciones no mienten. Solo buscan otro camino.»",
	INSIGHT_CORR_TITLE = "Revelación: Desplazado, no evitado",
	INSIGHT_CORR_BODY = "Tres correcciones, tres desastres nuevos, cada uno en el mismo minuto.\n\nLa tripulación de 2009 intentó exactamente lo que hacéis vosotros. Cada predicción rota cambia QUÉ pasa. No QUE pase algo.",

	-- Chapter 3: radio, tapes + archive
	RADIO_C3_001 = "La capilla. Lo que quedó en 2009 lo escondieron debajo.",
	RADIO_C3_002 = "Estamos... estoy cansado. Escuchad bien. Solo lo diremos una vez.",
	RADIO_C3_WHISPER = "Aquí rezábamos. Entre dos turnos. No sirvió.",
	RADIO_C3_WAKE = "Algo se ha despertado ahí abajo. Silencio.",
	RADIO_C3_ARCHIVE = "El archivo. Todo lo que la estación dijo jamás. Ordenado. Etiquetado.",
	RADIO_C3_FORECAST_POWER = "En treinta segundos el archivo se queda a oscuras. El interruptor está en el pasillo.",
	RADIO_C3_FORECAST_POWER_BROKEN = "La luz se queda. Bien. La necesitaréis.",
	RADIO_C3_TAPES = "Cinco cintas. La última noche en cinco trozos. La máquina solo las acepta en el orden correcto.",
	RADIO_C3_TAPE_WRONG = "Mal. Y con ruido. Empezad de nuevo, y sed más rápidos que eso.",
	RADIO_C3_FORECAST_GATE = "En treinta y cinco segundos cae la reja del archivo. El torno está junto a la reja.",
	RADIO_C3_FORECAST_GATE_KEPT = "La reja ha caído. Tardará en subir. No os quedéis quietos.",
	RADIO_C3_FORECAST_GATE_BROKEN = "La reja sigue arriba. Seguid.",
	RADIO_C3_OPEN = "La sala del operador. Aquí empezó todo. Entrad. Por favor.",
	RADIO_C3_OPERATOR = "Mirad la mesa. La radio. La conocéis.",
	RADIO_C3_REC_1 = "Ciclo cero cero cero siete. Si oís esto, sois nosotros.",
	RADIO_C3_REC_2 = "Os guiamos hasta aquí. El fax lo mandamos nosotros. La voz de la radio siempre fue la nuestra.",
	RADIO_C3_REC_3 = "Mentimos. Nadie puede salvar a la tripulación de 2009. No respondiendo.",
	RADIO_C3_REC_4 = "Ya no sabemos si queremos que termine. Decidid vosotros. Nosotros no pudimos.",
	RADIO_C3_TAKEN = "Nos lleváis con vosotros. Quizá la próxima vez escuchéis mejor.",
	RADIO_C3_DESTROYED = "...Bien. Entonces seremos más silenciosos. Quizá sea mejor así.",
	RADIO_C3_ESCAPE = "Os ha oído. La campana: ¡tocad la campana y solo la oirá a ella!",
	RADIO_C3_END_RELAY = "La campana sigue resonando. Cuarenta y un segundos antes de tiempo. Como todo aquí.",
	RADIO_C3_END_UNKNOWN = "La mina. Donde está el Array. Donde empezó. Venid.",
	TAPE_FRAGMENT_1 = "«01:52. Okafor. Portadora en cero. Sin desfase. Es... es ella otra vez.»",
	TAPE_FRAGMENT_2 = "«02:03. Venn. Señal anticipada, cuarenta y un minutos. Remitente: esta estación. Nosotros.»",
	TAPE_FRAGMENT_3 = "«02:09. Ehle. Si respondemos, podemos evitarlo. ¡Siempre lo hemos evitado!»",
	TAPE_FRAGMENT_4 = "«02:12. Venn. ¡Tobias, aparta las manos del transmisor! ¡No es un accidente, es un eco!»",
	TAPE_FRAGMENT_5 = "«02:14. (estática) Ehle: ...aquí VESPER-4, os oímos, nos...» (silencio)",
	C3_MEMORIAL_TITLE = "Monumento",
	C3_MEMORIAL_BODY = "Seis nombres grabados:\nJune Okafor · Mara Venn · Tobias Ehle · Ida Kessler · Paul Marek · ----\n\nEl sexto nombre está raspado. Hace poco.",
	C3_HYMN_TITLE = "Cantoral",
	C3_HYMN_BODY = "Una nota en el cantoral, página 214:\n«Quien escucha será encontrado. Quien responde se queda.»\n\nDebajo, a lápiz: «Esto no es un himno. Es un manual.»",
	C3_PRIEST_TITLE = "Nota del párroco",
	C3_PRIEST_BODY = "La gente de la estación viene de noche. Dicen que solo traen archivos. Pero oigo radios bajo el suelo.\n\nUna de ellos, Okafor, me preguntó si se puede rezar por alguien que aún no ha muerto. Porque lo hará mañana.",
	C3_INDEX_TITLE = "Ficha",
	C3_INDEX_BODY = "FONDO: Echo-Array, señales anticipadas 2004-2009\nVOLUMEN: 2.214 cintas\nACCESO: solo operador\n\nNota: falta la cinta 0007. Nunca se grabó. Se está grabando todavía.",
	LOG_MAREK_TITLE = "Registro fantasma: Paul Marek",
	LOG_MAREK_BODY = "Paul Marek, archivero.\n\n«Ordeno las cintas por fecha. Hoy encontré una fechada mañana. Tiene voces que no conozco. Voces jóvenes. Se ríen de una radio pintada color óxido.\n\nCreo que son los que vienen después de nosotros.»",
	ARCH_REC_C3_RUN_TITLE = "Grabación: Ciclo 0007",
	ARCH_REC_C3_RUN_BODY = "«Si oís esto, sois nosotros.»\n\nEl Relé es vuestro propio equipo. De un ciclo anterior. Respondió en la Frecuencia Cero y se convirtió en la voz que os trajo aquí.",
	INSIGHT_SIX_TITLE = "Revelación: El sexto nombre",
	INSIGHT_SIX_BODY = "Cinco nombres de la tripulación están en la piedra. El sexto fue raspado.\n\nKessler y Marek hablaron de «los que vienen después». El sexto nombre nunca fue de 2009. Pertenece al próximo que responda.",

	-- Chapter 4: radio, endings + archive
	RADIO_C4_001 = "...¿oís...? Frecuencia Cero. Abajo. Muy abajo.",
	RADIO_C4_002 = "El Array está bajo la mina. Allí nosotros... allí terminó cada ciclo.",
	RADIO_C4_RECORDER = "Nos trajisteis. La cinta sigue grabando. Os oímos respirar. Gracias.",
	RADIO_C4_UNKNOWN_TRUSTED = "Confiasteis en nosotros. No lo olvidaremos. No olvidamos nada.",
	RADIO_C4_INSIDE = "El Array late. Con cada pulso la mina cambia. Hoy. 2009. Hoy.",
	RADIO_C4_WAKE = "Nació aquí abajo. Conoce cada túnel.",
	RADIO_C4_JUNCTION = "El cruce. A la izquierda la jaula, a la derecha la bomba. De frente, el pasaje viejo.",
	RADIO_C4_FORECAST_CAGE = "En treinta segundos la jaula se suelta. El freno está en la sala del pozo, a la izquierda.",
	RADIO_C4_FORECAST_CAGE_KEPT = "La jaula ha caído. El rodeo está sepultado. Queda el pasaje viejo.",
	RADIO_C4_FORECAST_CAGE_BROKEN = "El freno aguanta. El rodeo está libre.",
	RADIO_C4_FORECAST_FLOOD = "En treinta y cinco segundos el nivel inferior se inunda. Arrancad la bomba, a la derecha.",
	RADIO_C4_FORECAST_FLOOD_KEPT = "El agua sube. La sala de bombas está perdida.",
	RADIO_C4_FORECAST_FLOOD_BROKEN = "La bomba funciona. El agua se queda donde está.",
	RADIO_C4_FORECAST_POWER = "El transformador. En treinta segundos se quema. Mantened el interruptor.",
	RADIO_C4_FORECAST_POWER_BROKEN = "Aguanta. Por poco.",
	RADIO_C4_FORECAST_DOOR = "La puerta blindada se cierra en cuarenta segundos. Para siempre. Mantened el control.",
	RADIO_C4_FORECAST_DOOR_KEPT = "Está cerrada. Pero en 2009 estaba abierta. Esperad el pulso.",
	RADIO_C4_FORECAST_DOOR_BROKEN = "Está abierta. El núcleo. Id.",
	RADIO_C4_BLAST_2009 = "2009. La puerta está abierta. ¡Ahora!",
	RADIO_C4_CORE = "Aquí. Aquí respondimos. Cada vez. Siete veces.",
	RADIO_C4_CORE_UNKNOWN = "Respondednos. Por favor. Solo esta vez.",
	RADIO_C4_CORE_SECRET = "Hay una frecuencia más. La primera de June. De 2008. Habéis encontrado todo lo necesario.",
	RADIO_C4_ANSWER_1 = "Estáis transmitiendo. Sí. Así empezó también para nosotros.",
	RADIO_C4_ANSWER_2 = "(con la voz de {name}) ...aquí VESPER-4. Os oímos. Venid a la estación. No respondáis. Todavía no.",
	RADIO_C4_SILENCE_1 = "Gracias.",
	RADIO_C4_SILENCE_2 = "No volveremos a oírnos. Nunca más. Está bien así.",
	RADIO_C4_SILENCE_3 = "...hay luz. Fuera simplemente hay luz.",
	RADIO_C4_COUNTER_1 = "No nuestra voz. La suya. La primera llamada de June en 2008, de vuelta al principio. Con una advertencia.",
	RADIO_C4_COUNTER_2 = "Aquí Okafor, relé VESPER-4. ¿Quién... quién habla? ¿Me decís que no responda?",
	RADIO_C4_COUNTER_3 = "Yo... os conozco. Ya habéis estado aquí. Pasad, es de día. El café está recién hecho.",
	ARCH_REC_C4_ARRIVAL_TITLE = "Radio: Abajo",
	ARCH_REC_C4_ARRIVAL_BODY = "«Frecuencia Cero. Abajo. Muy abajo.»\n\nLa voz del Relé se deshace. Entre palabras: el sonido de un freno. Una jaula. Una puerta que se cierra.",
	C4_NOTICE_TITLE = "Aviso: Galería 3",
	C4_NOTICE_BODY = "Desde el 01/10/2004 la galería 3 queda CERRADA a la minería.\nUso por la estación VESPER-4 (Echo-Array).\nAcceso solo con permiso de M. Venn.\n\nA mano: «Suerte ahí abajo. Y devolved los auriculares.»",
	C4_SHIFT_TITLE = "Libro de turnos del transformador",
	C4_SHIFT_BODY = "14/11/2009\n01:40 Transformador 2 caliente. Ventilador cambiado.\n02:05 La puerta blindada se atasca. Ehle la sujetó a la fuerza.\n02:13 Todos al núcleo. Venn dice: nadie transmite.\n02:14 -\n\n(La línea siguiente tiene la misma letra, pero la tinta es fresca.)\n02:14 Empieza el ciclo 0008.",
	C4_LOOP_TITLE = "Cinta: El rodeo",
	C4_LOOP_BODY = "«Aquí Okafor. Fui por el rodeo porque el pasaje viejo está sepultado. En 2008 estaba abierto. Lo sé porque lo recorrí en 2008.\n\nSi alguna vez encuentro el camino de vuelta, me llamaré a mí misma. En la primera frecuencia. La primerísima.»",
	INSIGHT_JUNE_TITLE = "Revelación: La primera frecuencia",
	INSIGHT_JUNE_BODY = "En 2008 June recibió la primera llamada en la Frecuencia Cero. Quería avisarse a sí misma, justo en esa frecuencia.\n\nQuien envíe desde el núcleo no su propia voz, sino la primera de June, podría romper el bucle en su origen.",

