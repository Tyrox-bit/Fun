	RADIO_C3_REC_1 = "Ciclo zero zero zero sete. Se vocês estão ouvindo isto, vocês são nós.",
	RADIO_C3_REC_2 = "Nós guiamos vocês até aqui. O fax veio de nós. A voz no rádio sempre foi a nossa.",
