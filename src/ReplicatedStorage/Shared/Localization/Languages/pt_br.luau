	C3_MEMORIAL_TITLE = "Pedra memorial",
	C3_MEMORIAL_BODY = "Seis nomes gravados:\nJune Okafor · Mara Venn · Tobias Ehle · Ida Kessler · Paul Marek · ----\n\nO sexto nome foi raspado. Recentemente.",
	C3_HYMN_TITLE = "Hinário",
	C3_HYMN_BODY = "Um bilhete no hinário, página 214:\n“Quem escuta será encontrado. Quem responde fica.”\n\nEmbaixo, a lápis: “Isto não é um hino. É um manual.”",
	C3_PRIEST_TITLE = "Bilhete do padre",
	C3_PRIEST_BODY = "O pessoal da estação vem à noite. Dizem que só trazem arquivos. Mas ouço rádios debaixo do chão.\n\nUma deles, Okafor, me perguntou se dá para rezar por alguém que ainda não morreu. Porque vai morrer amanhã.",
	C3_INDEX_TITLE = "Ficha",
	C3_INDEX_BODY = "ACERVO: Echo-Array, sinais antecipados 2004-2009\nVOLUME: 2.214 fitas\nACESSO: somente operador\n\nObs.: falta a fita 0007. Nunca foi gravada. Ainda está sendo gravada.",
	LOG_MAREK_TITLE = "Registro fantasma: Paul Marek",
	LOG_MAREK_BODY = "Paul Marek, arquivista.\n\n“Organizo as fitas por data. Hoje achei uma datada de amanhã. Tem vozes que não conheço. Vozes jovens. Riem de um rádio com pintura cor de ferrugem.\n\nAcho que são os que vêm depois de nós.”",
	ARCH_REC_C3_RUN_TITLE = "Gravação: Ciclo 0007",
	ARCH_REC_C3_RUN_BODY = "“Se vocês estão ouvindo isto, vocês são nós.”\n\nO Relé é a própria equipe de vocês. De um ciclo anterior. Respondeu na Frequência Zero - e virou a voz que trouxe vocês até aqui.",
	INSIGHT_SIX_TITLE = "Revelação: O sexto nome",
	INSIGHT_SIX_BODY = "Cinco nomes da equipe estão na pedra. O sexto foi raspado.\n\nKessler e Marek falaram dos “que vêm depois de nós”. O sexto nome nunca foi de 2009. Pertence a quem responder em seguida.",

