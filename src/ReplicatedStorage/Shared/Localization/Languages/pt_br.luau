	ARCH_REC_C2_ARRIVAL_TITLE = "Rádio: Barragem 3",
	ARCH_REC_C2_ARRIVAL_BODY = "“A tempestade leva o sinal longe. Longe demais.”\n\nO Relé soa mais cansado do que na estação. Na estática: chuva. A mesma chuva lá de fora.",
	ARCH_REC_C2_PLEA_TITLE = "Rádio: O apelo",
	ARCH_REC_C2_PLEA_BODY = "“Respondam. Ainda estamos aqui.”\n“Não respondam. Ainda não.”\n\nPela primeira vez as vozes se contradizem. As duas soam seguras.",
	C2_KEEPER_TITLE = "Diário do guarda",
	C2_KEEPER_BODY = "12/11/2009 - Radioperadores da estação estiveram aqui. Querem as turbinas como energia reserva para o Array.\n13/11 - O rádio do escritório dá a previsão do tempo de amanhã. Acerta.\n14/11, 01:30 - A estação diz que o refeitório vai trancar esta noite. Com Kessler dentro. Calcei a porta.\n\nTrancou mesmo assim. Só que outra.",
	C2_CORR1_TITLE = "Protocolo de correção 1",
	C2_CORR1_BODY = "Sinal antecipado: ônibus do vale para Grünau cai na barragem, 07:41.\nCorreção: estrada fechada às 07:00.\nResultado: nenhum acidente.\n\nAdendo três dias depois: incêndio na serraria de Grünau. Dois feridos. Hora: 07:41.",
	C2_CORR2_TITLE = "Protocolo de correção 2",
	C2_CORR2_BODY = "Sinal antecipado: enchente na vila abaixo da barragem.\nCorreção: descarga aberta antes.\nResultado: sem enchente.\n\nAdendo: galeria de inspeção inundada. Um técnico desaparecido. Hora da inundação: idêntica à enchente prevista.\n- M. Venn: “Não evitamos nada. Só mudamos de lugar.”",
	C2_CORR3_TITLE = "Protocolo de correção 3",
	C2_CORR3_BODY = "Sinal antecipado: pedido de socorro da própria estação, 41 minutos antes.\nCorreção: -\nResultado: -\n\nOs campos estão vazios. Embaixo, com outra letra: “Não respondam. Ainda não.”",
	C2_COFFEE_TITLE = "Cafeteira",
	C2_COFFEE_BODY = "A jarra ainda está quente. O relógio da máquina mostra 02:14 e pisca.\n\nNa caneca ao lado está escrito “IDA”.",
	C2_DORM_TITLE = "Fita: Dormitório",
	C2_DORM_BODY = "(Respiração. Uma cama range.)\n“Ida? Você está acordada? ... O rádio está falando de novo. Diz o meu nome.”\n“Dorme, Paul. É a tempestade.”\n“A tempestade não sabe o meu nome.”",
	LOG_KESSLER_TITLE = "Registro fantasma: Ida Kessler",
	LOG_KESSLER_BODY = "Ida Kessler, técnica, Barragem 3.\n\n“Verifiquei a galeria três vezes. Seca. Sempre. E mesmo assim ouço água quando ligo o rádio.\n\nSe alguém encontrar isto: as previsões não mentem. Só procuram outro caminho.”",
	INSIGHT_CORR_TITLE = "Revelação: Adiado, não evitado",
	INSIGHT_CORR_BODY = "Três correções, três novos desastres - sempre no mesmo minuto.\n\nA equipe de 2009 tentou exatamente o que vocês fazem. Cada previsão quebrada muda O QUE acontece. Não QUE algo aconteça.",

