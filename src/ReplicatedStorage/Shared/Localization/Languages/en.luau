	-- Chapter 2: radio + archive
	RADIO_C1_RETURN = "You're back.",
	RADIO_C2_001 = "Dam three. In 2009 somebody out here wrote down everything the station said.",
	RADIO_C2_002 = "The storm carries the signal far. Too far. Stay together.",
	RADIO_C2_CREW = "The dam keeper wrote everything down. His log is in the office.",
	RADIO_C2_LOG = "He counted the forecasts. And then he started to change them.",
	RADIO_C2_FORECAST_DOOR = "{name}. In thirty seconds the canteen locks. With you inside. The override is in the office.",
	RADIO_C2_FORECAST_DOOR_KEPT = "It happened. Just as forecast. It heard the doors.",
	RADIO_C2_FORECAST_DOOR_BROKEN = "The doors stay open. You changed it. Remember how that feels.",
	RADIO_C2_WAKE = "It's awake. And this time it is looking for you.",
	RADIO_C2_TURBINES = "The turbines. No power, no uplink. No uplink, no way up.",
	RADIO_C2_FORECAST_FLOOD = "In thirty-five seconds the bottom outlet opens and the gallery floods. The valve is in the valve room.",
	RADIO_C2_FORECAST_FLOOD_KEPT = "The gallery is lost. Outside, then. In the storm.",
	RADIO_C2_FORECAST_FLOOD_BROKEN = "The valve holds. The gallery stays dry - the way inside the dam is open.",
	RADIO_C2_CREST = "Both running. Now up - through the gallery inside the dam. The inclined shaft leads to the crest.",
	RADIO_C2_CREST_RAMP = "Both running. The gallery is flooded - take the ramp on the dam face. And don't look down.",
	RADIO_C2_PLEA = "Can you hear us? You can hear us! Please - answer us. We are still here.",
	RADIO_C2_NOT_YET = "Don't answer. Not yet.",
	RADIO_C2_PLEA_2 = "Why do you listen to him? He has lied to you before.",
	RADIO_C2_TRUST_UNKNOWN = "Thank you. Thank you! The gate to the antenna yard - we'll open it for you.",
	RADIO_C2_RELAY_HURT = "...It heard you. Run.",
	RADIO_C2_TRUST_RELAY = "Close the spillway first. Otherwise the storm carries your voices all the way to them.",
	RADIO_C2_UNKNOWN_HURT = "You sound like him. Exactly like him.",
	RADIO_C2_SPILLWAY_DONE = "Good. The yard is open. Now the uplink.",
	RADIO_C2_UPLINK = "Hold the yard until the uplink stands. It will be loud. It will come.",
	RADIO_C2_END_UNKNOWN = "Now we can hear you. All of you. Loud and clear.",
	RADIO_C2_END_RELAY = "Well done. The chapel is next. That's where the protocol is.",
	RADIO_C2_END_RELAY_UNKNOWN = "You shouldn't have... never mind. The chapel. The protocol is there. Everything is there.",
	RADIO_C2_END_NAMES = "{name}... We know your voice. How do we know your voice?",
	ARCH_REC_C2_ARRIVAL_TITLE = "Radio: Dam 3",
	ARCH_REC_C2_ARRIVAL_BODY = "“The storm carries the signal far. Too far.”\n\nThe Relay sounds more tired than at the station. In the static: rain. The same rain as outside.",
	ARCH_REC_C2_PLEA_TITLE = "Radio: The Plea",
	ARCH_REC_C2_PLEA_BODY = "“Answer us. We are still here.”\n“Don't answer. Not yet.”\n\nFor the first time the voices contradict each other. Both sound certain.",
	C2_KEEPER_TITLE = "Dam keeper's log",
	C2_KEEPER_BODY = "12 Nov 2009 - Radio people from the station were here. They want the turbines as backup power for the Array.\n13 Nov - The radio in the office plays tomorrow's weather reports. They are right.\n14 Nov, 01:30 - The station says the canteen locks tonight. With Kessler inside. I wedged the door open.\n\nIt locked anyway. Just a different one.",
	C2_CORR1_TITLE = "Correction protocol 1",
	C2_CORR1_BODY = "Early signal: bus from the valley to Grünau crashes at the dam, 07:41.\nCorrection: road closed at 07:00.\nResult: no accident.\n\nAddendum three days later: fire at the Grünau sawmill. Two injured. Time: 07:41.",
	C2_CORR2_TITLE = "Correction protocol 2",
	C2_CORR2_BODY = "Early signal: flood in the village below the dam.\nCorrection: bottom outlet opened early.\nResult: no flood.\n\nAddendum: inspection gallery flooded. One technician missing. Time of flooding: identical to the forecast flood.\n- M. Venn: “We don't prevent anything. We move it.”",
	C2_CORR3_TITLE = "Correction protocol 3",
	C2_CORR3_BODY = "Early signal: distress call from the station itself, 41 minutes ahead.\nCorrection: -\nResult: -\n\nThe fields are empty. Below, in different handwriting: “Don't answer. Not yet.”",
	C2_COFFEE_TITLE = "Coffee machine",
	C2_COFFEE_BODY = "The pot is still warm. The machine's clock shows 02:14 and blinks.\n\nThe mug next to it says “IDA”.",
	C2_DORM_TITLE = "Tape: Dormitory",
	C2_DORM_BODY = "(Breathing. A bed creaks.)\n“Ida? Are you awake? ... The radio is talking again. It says my name.”\n“Sleep, Paul. It's the storm.”\n“The storm doesn't know my name.”",
	LOG_KESSLER_TITLE = "Ghost log: Ida Kessler",
	LOG_KESSLER_BODY = "Ida Kessler, technician, Dam 3.\n\n“I checked the gallery three times. Dry. Every time. And still I hear water when I switch on the radio.\n\nIf anyone finds this: the forecasts don't lie. They just find another way.”",
	INSIGHT_CORR_TITLE = "Insight: Moved, not prevented",
	INSIGHT_CORR_BODY = "Three corrections, three new disasters - each at the same minute.\n\nThe 2009 crew tried exactly what you are doing. Every broken forecast changes WHAT happens. Not THAT something happens.",

	-- Chapter 3: radio, tapes + archive
	RADIO_C3_001 = "The chapel. Whatever was left in 2009, they hid beneath it.",
	RADIO_C3_002 = "We are... I am tired. Listen closely. We'll only say it once.",
	RADIO_C3_WHISPER = "We prayed here. Between two shifts. It didn't help.",
	RADIO_C3_WAKE = "Something woke up down there. Quiet now.",
	RADIO_C3_ARCHIVE = "The archive. Everything the station ever said. Sorted. Labelled.",
	RADIO_C3_FORECAST_POWER = "In thirty seconds the archive goes dark. The breaker is in the corridor.",
	RADIO_C3_FORECAST_POWER_BROKEN = "The light stays. Good. You'll need it.",
	RADIO_C3_TAPES = "Five tapes. The last night in five pieces. The deck only takes them in the right order.",
	RADIO_C3_TAPE_WRONG = "Wrong. And loud. Start over - and be faster than it.",
	RADIO_C3_FORECAST_GATE = "In thirty-five seconds the archive gate drops. The winch is next to the gate.",
	RADIO_C3_FORECAST_GATE_KEPT = "The gate is down. It takes a while to come back up. Don't stand still.",
	RADIO_C3_FORECAST_GATE_BROKEN = "The gate stays up. Keep going.",
	RADIO_C3_OPEN = "The operator room. This is where it all began. Go in. Please.",
	RADIO_C3_OPERATOR = "Look at the table. The radio. You know it.",
	RADIO_C3_REC_1 = "Run zero zero zero seven. If you hear this, you are us.",
	RADIO_C3_REC_2 = "We led you here. The fax came from us. The voice on the radio was always ours.",
	RADIO_C3_REC_3 = "We lied. Nobody can save the 2009 crew. Not by answering.",
	RADIO_C3_REC_4 = "We no longer know if we want it to end. You decide. We couldn't.",
	RADIO_C3_TAKEN = "You're taking us along. Maybe you'll listen better next time.",
	RADIO_C3_DESTROYED = "...Good. Then we'll be quieter. Maybe that's better.",
	RADIO_C3_ESCAPE = "It heard you. The bell - ring the bell, then it will only hear the bell!",
	RADIO_C3_END_RELAY = "The bell echoes on. Forty-one seconds too early. Like everything here.",
	RADIO_C3_END_UNKNOWN = "The mine. Where the Array lies. Where it began. Come.",
	TAPE_FRAGMENT_1 = "“01:52. Okafor. Carrier on zero. No offset. That's... that's her again.”",
	TAPE_FRAGMENT_2 = "“02:03. Venn. Early signal, forty-one minutes. Sender: this station. Us.”",
	TAPE_FRAGMENT_3 = "“02:09. Ehle. If we answer, we can stop it. We have always stopped it!”",
	TAPE_FRAGMENT_4 = "“02:12. Venn. Tobias, hands off the transmitter! This is no accident, it's an echo!”",
	TAPE_FRAGMENT_5 = "“02:14. (static) Ehle: ...this is VESPER-4, we hear you, we-” (silence)",
	C3_MEMORIAL_TITLE = "Memorial stone",
	C3_MEMORIAL_BODY = "Six names, engraved:\nJune Okafor · Mara Venn · Tobias Ehle · Ida Kessler · Paul Marek · ----\n\nThe sixth name has been scratched out. Recently.",
	C3_HYMN_TITLE = "Hymn book",
	C3_HYMN_BODY = "A note in the hymn book, page 214:\n“Whoever listens will be found. Whoever answers will stay.”\n\nBelow, in pencil: “This is not a hymn. It's a manual.”",
	C3_PRIEST_TITLE = "The priest's note",
	C3_PRIEST_BODY = "The people from the station come at night. They say they only bring files. But I hear radios beneath the floor.\n\nOne of them, Okafor, asked me whether one can pray for someone who hasn't died yet. Because he will do it tomorrow.",
	C3_INDEX_TITLE = "Index card",
	C3_INDEX_BODY = "HOLDINGS: Echo-Array, early signals 2004-2009\nEXTENT: 2,214 tapes\nACCESS: operator only\n\nNote: tape 0007 is missing. Was never recorded. Is still being recorded.",
	LOG_MAREK_TITLE = "Ghost log: Paul Marek",
	LOG_MAREK_BODY = "Paul Marek, archivist.\n\n“I sort the tapes by date. Today I found one dated tomorrow. On it are voices I don't know. Young voices. They laugh about a radio with rusty paint.\n\nI think those are the ones who come after us.”",
	ARCH_REC_C3_RUN_TITLE = "Recording: Run 0007",
	ARCH_REC_C3_RUN_BODY = "“If you hear this, you are us.”\n\nThe Relay is your own team. From an earlier run. It answered on Frequency Zero - and became the voice that led you here.",
	INSIGHT_SIX_TITLE = "Insight: The sixth name",
	INSIGHT_SIX_BODY = "Five names of the crew are on the stone. The sixth was scratched out.\n\nKessler and Marek both spoke of “those who come after us”. The sixth name was never one from 2009. It belongs to whoever answers next.",

	-- Chapter 4: radio, endings + archive
	RADIO_C4_001 = "...can you hear... Frequency Zero. Down. All the way down.",
	RADIO_C4_002 = "The Array lies beneath the mine. That's where we... where every run ended.",
	RADIO_C4_RECORDER = "You took us along. The tape is still running. We can hear you breathe. Thank you.",
	RADIO_C4_UNKNOWN_TRUSTED = "You trusted us. We won't forget that. We forget nothing.",
	RADIO_C4_INSIDE = "The Array pulses. With every pulse the mine flips. Today. 2009. Today.",
	RADIO_C4_WAKE = "It was born down here. It knows every tunnel.",
	RADIO_C4_JUNCTION = "The junction. Left the cage, right the pump. Straight on, the old passage.",
	RADIO_C4_FORECAST_CAGE = "In thirty seconds the cage snaps. The brake is in the shaft room, left.",
	RADIO_C4_FORECAST_CAGE_KEPT = "The cage is down. The loop is buried. That leaves the old passage.",
	RADIO_C4_FORECAST_CAGE_BROKEN = "The brake holds. The loop is clear.",
	RADIO_C4_FORECAST_FLOOD = "In thirty-five seconds the lower level floods. Start the pump, right side.",
	RADIO_C4_FORECAST_FLOOD_KEPT = "The water is rising. The pump room is lost.",
	RADIO_C4_FORECAST_FLOOD_BROKEN = "The pump runs. The water stays where it is.",
	RADIO_C4_FORECAST_POWER = "The transformer. In thirty seconds it burns out. Hold the breaker.",
	RADIO_C4_FORECAST_POWER_BROKEN = "It holds. Barely.",
	RADIO_C4_FORECAST_DOOR = "The blast door locks in forty seconds. For good. Hold the override.",
	RADIO_C4_FORECAST_DOOR_KEPT = "It's shut. But in 2009 it stood open. Wait for the pulse.",
	RADIO_C4_FORECAST_DOOR_BROKEN = "It's open. The core. Go.",
	RADIO_C4_BLAST_2009 = "2009. The door stands open. Now!",
	RADIO_C4_CORE = "Here. This is where we answered. Every time. Seven times.",
	RADIO_C4_CORE_UNKNOWN = "Answer us. Please. Just this once.",
	RADIO_C4_CORE_SECRET = "There is one more frequency. June's first. From 2008. You found everything it takes.",
	RADIO_C4_ANSWER_1 = "You're transmitting. Yes. That's how it started for us, too.",
	RADIO_C4_ANSWER_2 = "(in {name}'s voice) ...this is VESPER-4. We hear you. Come to the station. Don't answer. Not yet.",
	RADIO_C4_SILENCE_1 = "Thank you.",
	RADIO_C4_SILENCE_2 = "We won't hear from each other. Never again. That's good.",
	RADIO_C4_SILENCE_3 = "...it's light. It's just light outside.",
	RADIO_C4_COUNTER_1 = "Not our voice. Hers. June's first call from 2008, back to the beginning. With a warning.",
	RADIO_C4_COUNTER_2 = "This is Okafor, relay VESPER-4. Who... who is this? You're telling me not to answer?",
	RADIO_C4_COUNTER_3 = "I... know you. You've been here before. Come in, it's daytime. The coffee is fresh.",
	ARCH_REC_C4_ARRIVAL_TITLE = "Radio: Down",
	ARCH_REC_C4_ARRIVAL_BODY = "“Frequency Zero. Down. All the way down.”\n\nThe Relay's voice is falling apart. Between the words: the sound of a brake. A cage. A door closing.",
	C4_NOTICE_TITLE = "Notice: Adit 3",
	C4_NOTICE_BODY = "From 1 Oct 2004 adit 3 is CLOSED to mining.\nUse by relay station VESPER-4 (Echo-Array).\nAccess only with permission from M. Venn.\n\nHandwritten: “Good luck down there. And bring the headphones back.”",
	C4_SHIFT_TITLE = "Transformer room shift book",
	C4_SHIFT_BODY = "14 Nov 2009\n01:40 Transformer 2 hot. Fan replaced.\n02:05 Blast door jams. Ehle held it open by force.\n02:13 Everyone to the core. Venn says: nobody transmits.\n02:14 -\n\n(The next line is in the same handwriting, but the ink is fresh.)\n02:14 Run 0008 begins.",
	C4_LOOP_TITLE = "Tape: The loop",
	C4_LOOP_BODY = "“Okafor here. I took the loop because the old passage is buried. In 2008 it was open. I know because I walked it in 2008.\n\nIf I ever find a way back, I'll call myself. On the first frequency. The very first.”",
	INSIGHT_JUNE_TITLE = "Insight: The first frequency",
	INSIGHT_JUNE_BODY = "In 2008 June received the first call on Frequency Zero. She wanted to warn herself - on exactly that frequency.\n\nWhoever sends not their own voice from the core, but June's first, might break the loop at its very beginning.",
}
