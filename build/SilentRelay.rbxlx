	-- Chapter 2: radio + archive
	RADIO_C1_RETURN = "Vocês voltaram.",
	RADIO_C2_001 = "Barragem três. Em 2009 alguém aqui anotava tudo o que a estação dizia.",
	RADIO_C2_002 = "A tempestade leva o sinal longe. Longe demais. Fiquem juntos.",
	RADIO_C2_CREW = "O guarda anotou tudo. O diário dele está no escritório.",
	RADIO_C2_LOG = "Ele contou as previsões. E depois começou a mudá-las.",
	RADIO_C2_FORECAST_DOOR = "{name}. Em trinta segundos o refeitório tranca. Com você dentro. O destravamento fica no escritório.",
	RADIO_C2_FORECAST_DOOR_KEPT = "Aconteceu. Como previsto. Ele ouviu as portas.",
	RADIO_C2_FORECAST_DOOR_BROKEN = "As portas continuam abertas. Vocês mudaram isso. Lembrem dessa sensação.",
	RADIO_C2_WAKE = "Ele acordou. E desta vez está procurando vocês.",
	RADIO_C2_TURBINES = "As turbinas. Sem energia, sem uplink. Sem uplink, sem caminho para cima.",
	RADIO_C2_FORECAST_FLOOD = "Em trinta e cinco segundos a descarga abre e a galeria inunda. A válvula fica na câmara de válvulas.",
	RADIO_C2_FORECAST_FLOOD_KEPT = "A galeria está perdida. Por fora, então. Na tempestade.",
	RADIO_C2_FORECAST_FLOOD_BROKEN = "A válvula aguenta. A galeria fica seca - o caminho dentro da barragem está aberto.",
	RADIO_C2_CREST = "As duas funcionam. Agora para cima - pela galeria dentro da barragem. O poço inclinado leva à crista.",
	RADIO_C2_CREST_RAMP = "As duas funcionam. A galeria inundou - usem a rampa na face da barragem. E não olhem para baixo.",
	RADIO_C2_PLEA = "Vocês nos ouvem? Vocês nos ouvem! Por favor, respondam. Ainda estamos aqui.",
	RADIO_C2_NOT_YET = "Não respondam. Ainda não.",
	RADIO_C2_PLEA_2 = "Por que vocês escutam ele? Ele já mentiu para vocês.",
	RADIO_C2_TRUST_UNKNOWN = "Obrigado. Obrigado! O portão do pátio da antena - nós abrimos para vocês.",
	RADIO_C2_RELAY_HURT = "...Ele ouviu vocês. Corram.",
	RADIO_C2_TRUST_RELAY = "Fechem primeiro o vertedouro. Senão a tempestade leva as vozes de vocês até eles.",
	RADIO_C2_UNKNOWN_HURT = "Vocês soam como ele. Exatamente como ele.",
	RADIO_C2_SPILLWAY_DONE = "Bom. O pátio está aberto. Agora o uplink.",
	RADIO_C2_UPLINK = "Segurem o pátio até o uplink ficar pronto. Vai ser alto. Ele virá.",
	RADIO_C2_END_UNKNOWN = "Agora ouvimos vocês. Todos. Alto e claro.",
	RADIO_C2_END_RELAY = "Muito bem. A capela é o próximo passo. Lá está o protocolo.",
	RADIO_C2_END_RELAY_UNKNOWN = "Vocês não deviam ter... deixa. A capela. O protocolo está lá. Tudo está lá.",
	RADIO_C2_END_NAMES = "{name}... Conhecemos sua voz. Como conhecemos sua voz?",
	ARCH_REC_C2_ARRIVAL_TITLE = "Rádio: Barragem 3",
	ARCH_REC_C2_ARRIVAL_BODY = "“A tempestade leva o sinal longe. Longe demais.”\n\nO Relé soa mais cansado do que na estação. Na estática: chuva. A mesma chuva lá de fora.",
	ARCH_REC_C2_PLEA_TITLE = "Rádio: O apelo",
	ARCH_REC_C2_PLEA_BODY = "“Respondam. Ainda estamos aqui.”\n“Não respondam. Ainda não.”\n\nPela primeira vez as vozes se contradizem. As duas soam seguras.",
	C2_KEEPER_TITLE = "Diário do guarda",
	C2_KEEPER_BODY = "12/11/2009 - Radioperadores da estação estiveram aqui. Querem as turbinas como energia reserva para o Array.\n13/11 - O rádio do escritório dá a previsão do tempo de amanhã. Acerta.\n14/11, 01:30 - A estação diz que o refeitório vai trancar esta noite. Com Kessler dentro. Calcei a porta.\n\nTrancou mesmo assim. Só que outra.",
	C2_CORR1_TITLE = "Protocolo de correção 1",
	C2_CORR1_BODY = "Sinal antecipado: ônibus do vale para Grünau cai na barragem, 07:41.\nCorreção: estrada fechada às 07:00.\nResultado: nenhum acidente.\n\nAdendo três dias depois: incêndio na serraria de Grünau. Dois feridos. Hora: 07:41.",
	C2_CORR2_TITLE = "Protocolo de correção 2",
	C2_CORR2_BODY = "Sinal antecipado: enchente na vila abaixo da barragem.\nCorreção: descarga aberta antes.\nResultado: sem enchente.\n\nAdendo: galeria de inspeção inundada. Um técnico desaparecido. Hora da inundação: idêntica à enchente prevista.\n- M. Venn: “Não evitamos nada. Só mudamos de lugar.”",
	C2_CORR3_TITLE = "Protocolo de correção 3",
	C2_CORR3_BODY = "Sinal antecipado: pedido de socorro da própria estação, 41 minutos antes.\nCorreção: -\nResultado: -\n\nOs campos estão vazios. Embaixo, com outra letra: “Não respondam. Ainda não.”",
	C2_COFFEE_TITLE = "Cafeteira",
	C2_COFFEE_BODY = "A jarra ainda está quente. O relógio da máquina mostra 02:14 e pisca.\n\nNa caneca ao lado está escrito “IDA”.",
	C2_DORM_TITLE = "Fita: Dormitório",
	C2_DORM_BODY = "(Respiração. Uma cama range.)\n“Ida? Você está acordada? ... O rádio está falando de novo. Diz o meu nome.”\n“Dorme, Paul. É a tempestade.”\n“A tempestade não sabe o meu nome.”",
	LOG_KESSLER_TITLE = "Registro fantasma: Ida Kessler",
	LOG_KESSLER_BODY = "Ida Kessler, técnica, Barragem 3.\n\n“Verifiquei a galeria três vezes. Seca. Sempre. E mesmo assim ouço água quando ligo o rádio.\n\nSe alguém encontrar isto: as previsões não mentem. Só procuram outro caminho.”",
	INSIGHT_CORR_TITLE = "Revelação: Adiado, não evitado",
	INSIGHT_CORR_BODY = "Três correções, três novos desastres - sempre no mesmo minuto.\n\nA equipe de 2009 tentou exatamente o que vocês fazem. Cada previsão quebrada muda O QUE acontece. Não QUE algo aconteça.",

	-- Chapter 3: radio, tapes + archive
	RADIO_C3_001 = "A capela. O que sobrou em 2009 eles esconderam embaixo dela.",
	RADIO_C3_002 = "Estamos... estou cansado. Escutem bem. Só vamos dizer uma vez.",
	RADIO_C3_WHISPER = "Rezávamos aqui. Entre dois turnos. Não adiantou.",
	RADIO_C3_WAKE = "Algo acordou lá embaixo. Silêncio agora.",
	RADIO_C3_ARCHIVE = "O arquivo. Tudo o que a estação já disse. Organizado. Etiquetado.",
	RADIO_C3_FORECAST_POWER = "Em trinta segundos o arquivo fica no escuro. O disjuntor está no corredor.",
	RADIO_C3_FORECAST_POWER_BROKEN = "A luz fica. Bom. Vocês vão precisar.",
	RADIO_C3_TAPES = "Cinco fitas. A última noite em cinco pedaços. A máquina só aceita na ordem certa.",
	RADIO_C3_TAPE_WRONG = "Errado. E alto. Comecem de novo - e sejam mais rápidos que ele.",
	RADIO_C3_FORECAST_GATE = "Em trinta e cinco segundos o portão do arquivo desce. O guincho fica ao lado.",
	RADIO_C3_FORECAST_GATE_KEPT = "O portão desceu. Vai demorar para subir. Não fiquem parados.",
	RADIO_C3_FORECAST_GATE_BROKEN = "O portão fica em cima. Continuem.",
	RADIO_C3_OPEN = "A sala do operador. Foi aqui que tudo começou. Entrem. Por favor.",
	RADIO_C3_OPERATOR = "Olhem a mesa. O rádio. Vocês o conhecem.",
	RADIO_C3_REC_1 = "Ciclo zero zero zero sete. Se vocês estão ouvindo isto, vocês são nós.",
	RADIO_C3_REC_2 = "Nós guiamos vocês até aqui. O fax veio de nós. A voz no rádio sempre foi a nossa.",
	RADIO_C3_REC_3 = "Nós mentimos. Ninguém pode salvar a equipe de 2009. Não respondendo.",
	RADIO_C3_REC_4 = "Já não sabemos se queremos que acabe. Decidam vocês. Nós não conseguimos.",
	RADIO_C3_TAKEN = "Vocês nos levam junto. Talvez escutem melhor da próxima vez.",
	RADIO_C3_DESTROYED = "...Bom. Então seremos mais quietos. Talvez seja melhor assim.",
	RADIO_C3_ESCAPE = "Ele ouviu vocês. O sino - toquem o sino, aí ele só vai ouvir o sino!",
	RADIO_C3_END_RELAY = "O sino continua ecoando. Quarenta e um segundos adiantado. Como tudo aqui.",
	RADIO_C3_END_UNKNOWN = "A mina. Onde fica o Array. Onde tudo começou. Venham.",
	TAPE_FRAGMENT_1 = "“01:52. Okafor. Portadora no zero. Sem desvio. É... é ela de novo.”",
	TAPE_FRAGMENT_2 = "“02:03. Venn. Sinal antecipado, quarenta e um minutos. Remetente: esta estação. Nós mesmos.”",
	TAPE_FRAGMENT_3 = "“02:09. Ehle. Se respondermos, podemos impedir. Sempre impedimos!”",
	TAPE_FRAGMENT_4 = "“02:12. Venn. Tobias, tira a mão do transmissor! Isso não é acidente, é um eco!”",
	TAPE_FRAGMENT_5 = "“02:14. (estática) Ehle: ...aqui VESPER-4, nós ouvimos vocês, nós-” (silêncio)",
	C3_MEMORIAL_TITLE = "Pedra memorial",
	C3_MEMORIAL_BODY = "Seis nomes gravados:\nJune Okafor · Mara Venn · Tobias Ehle · Ida Kessler · Paul Marek · ----\n\nO sexto nome foi raspado. Recentemente.",
	C3_HYMN_TITLE = "Hinário",
	C3_HYMN_BODY = "Um bilhete no hinário, página 214:\n“Quem escuta será encontrado. Quem responde fica.”\n\nEmbaixo, a lápis: “Isto não é um hino. É um manual.”",
	C3_PRIEST_TITLE = "Bilhete do padre",
	C3_PRIEST_BODY = "O pessoal da estação vem à noite. Dizem que só trazem arquivos. Mas ouço rádios debaixo do chão.\n\nUma deles, Okafor, me perguntou se dá para rezar por alguém que ainda não morreu. Porque vai morrer amanhã.",
	C3_INDEX_TITLE = "Ficha",
	C3_INDEX_BODY = "ACERVO: Echo-Array, sinais antecipados 2004-2009\nVOLUME: 2.214 fitas\nACESSO: somente operador\n\nObs.: falta a fita 0007. Nunca foi gravada. Ainda está sendo gravada.",
	LOG_MAREK_TITLE = "Registro fantasma: Paul Marek",
	LOG_MAREK_BODY = "Paul Marek, arquivista.\n\n“Organizo as fitas por data. Hoje achei uma datada de amanhã. Tem vozes que não conheço. Vozes jovens. Riem de um rádio com pintura cor de ferrugem.\n\nAcho que são os que vêm depois de nós.”",
	ARCH_REC_C3_RUN_TITLE = "Gravação: Ciclo 0007",
	ARCH_REC_C3_RUN_BODY = "“Se vocês estão ouvindo isto, vocês são nós.”\n\nO Relé é a própria equipe de vocês. De um ciclo anterior. Respondeu na Frequência Zero - e virou a voz que trouxe vocês até aqui.",
	INSIGHT_SIX_TITLE = "Revelação: O sexto nome",
	INSIGHT_SIX_BODY = "Cinco nomes da equipe estão na pedra. O sexto foi raspado.\n\nKessler e Marek falaram dos “que vêm depois de nós”. O sexto nome nunca foi de 2009. Pertence a quem responder em seguida.",

	-- Chapter 4: radio, endings + archive
	RADIO_C4_001 = "...vocês ouvem... Frequência Zero. Embaixo. Bem lá embaixo.",
	RADIO_C4_002 = "O Array fica embaixo da mina. Foi lá que nós... que cada ciclo terminou.",
	RADIO_C4_RECORDER = "Vocês nos trouxeram. A fita ainda está rodando. Ouvimos vocês respirarem. Obrigado.",
