	RADIO_C4_JUNCTION = "O cruzamento. À esquerda a gaiola, à direita a bomba. Em frente, a passagem antiga.",
	RADIO_C4_FORECAST_CAGE = "Em trinta segundos a gaiola despenca. O freio fica na sala do poço, à esquerda.",
