	ARCH_REC_C4_ARRIVAL_BODY = "“Frequência Zero. Embaixo. Bem lá embaixo.”\n\nA voz do Relé se desfaz. Entre as palavras: o som de um freio. De uma gaiola. De uma porta fechando.",
