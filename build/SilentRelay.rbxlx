    </Item>
  </Item>
  <Item class="ServerScriptService" referent="28">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="29">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">AdminConfig</string>
          <string name="Source"><![CDATA[-- Who may use the owner/maintenance tools.
-- Authorization is ALWAYS decided here on the server. The in-game "gesture code" only
-- reveals the menu for people who are already authorized; it never grants rights.

return {
	-- Additional developer UserIds (numbers). The experience owner is detected automatically:
	-- * user-owned experience: game.CreatorId
	-- * group-owned experience: members with rank >= MinGroupRank in the owning group
	UserIds = {
		-- 123456789,
	},
	MinGroupRank = 254,

	-- Everyone who can open the place in Studio is a developer of it, so Studio test
	-- sessions are authorized by default. Set to false to test the "denied" path.
	AllowAllInStudio = true,
}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">Chapters</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Chapter1</string>
            <string name="Source"><![CDATA[-- Chapter 1 "The Reception" on Relay Station 07.
-- The gameplay loop of the design: Explore -> Discover -> Understand -> Decide -> Act ->
-- Consequences -> new secrets. Built only from the generic systems:
--   DecisionService (team votes), ForecastService (predictions you can break),
--   DirectorService (scares + hints), PowerService (systems), StoryService (lines).
--
--  1  Gate: arrival transmission (per player) -> gatehouse fax "sent tomorrow, 02:14"
--  2  DECISION: the unknown voice asks you to answer. Answer or stay silent? (saved)
--  3  Control room: emergency power carries only 2 of 3 systems (levers, changeable):
--       cameras (see where it is) / hall lights (see better - and be seen) /
--       ventilation (fans mask your steps - but it can use the vents)
--  4  3 fuses in 3 random sectors. 1st fuse wakes the creature (earlier if you answered)
--  5  FORECAST 1 at the 2nd fuse: "lights in Sector A go out" - hold breaker A to break it
--  6  Relay B -> core doors open. FORECAST 2: "the generator in E fails" - restart it
--  7  Core -> the Relay says a player's name ("this time, not the left door")
--  8  Antenna -> ending line -> back to the menu, chapter saved as completed

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local Services = script.Parent.Parent.Services
local StoryService = require(Services.StoryService)
local InteractionService = require(Services.InteractionService)
local PowerService = require(Services.PowerService)
local CreatureService = require(Services.CreatureService)
local DataService = require(Services.DataService)
local NoiseService = require(Services.NoiseService)
local DecisionService = require(Services.DecisionService)
local ForecastService = require(Services.ForecastService)
local DirectorService = require(Services.DirectorService)
local DoorService = require(Services.DoorService)
local HealthService = require(Services.HealthService)
local AnalyticsTracker = require(Services.AnalyticsTracker)
local BadgeTracker = require(Services.BadgeTracker)
local HorrorEvents = require(script.Parent.Parent.Director.HorrorEvents)
local LoreService = require(Services.LoreService)
local AchievementService = require(Services.AchievementService)
local ReferralService = require(Services.ReferralService)

local Chapter1 = {}
Chapter1.StartCheckpoint = "C1_START"

local TOTAL_FUSES = 3
local SYSTEMS = { "cameras", "halls", "vents" }

local active = false
local ctx = nil -- { setCheckpoint, finish, playersInGame }
local fuseFolder: Folder? = nil

local state = {
	stage = "arrival", -- arrival | decision | control | power | fuses | relay | core | antenna | done
	fuses = 0,
	answered = false,
	systems = {} :: { [string]: boolean },
	powerChosenOnce = false,
	completedBy = {} :: { [Player]: boolean },
}

local ARRIVAL = {
	{ delay = 1.5, text = "SFX_STATIC", channel = "sfx", duration = 2 },
	{ delay = 1.0, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C1_001", channel = "radio", duration = 5.5 },
	{ delay = 5.8, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C1_002", channel = "radio", duration = 4 },
	{ delay = 5.0, text = "SFX_FAX", channel = "world", duration = 3 },
}

local HINTS = {
	OBJECTIVE_CHECK_GATEHOUSE = "HINT_GATEHOUSE",
	OBJECTIVE_REACH_CONTROL = "HINT_CONTROL",
	OBJECTIVE_POWER = "HINT_POWER",
	OBJECTIVE_FIND_FUSES = "HINT_FUSES",
	OBJECTIVE_RELAY_B = "HINT_RELAY",
	OBJECTIVE_CORE = "HINT_CORE",
	OBJECTIVE_ANTENNA = "HINT_ANTENNA",
}

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local stepped: { [string]: boolean } = {}
local function step(name: string)
	if stepped[name] then
		return
	end
	stepped[name] = true
	for _, player in ctx.playersInGame() do
		AnalyticsTracker.ChapterStep(player, "Chapter1", name)
	end
end

local function rewardAll(amount: number)
	for _, player in ctx.playersInGame() do
		DataService.Grant(player, amount)
	end
end

local function sfxAt(name: string, position: Vector3)
	Net.Event("Sfx"):FireAllClients(name, position)
end

local function relay(text: string, params: { [string]: any }?, delay: number?)
	StoryService.Sequence("all", { { delay = delay or 0.5, speaker = "SPEAKER_RELAY", text = text, params = params, channel = "radio", duration = 4.5 } })
end

local function unknown(text: string, params: { [string]: any }?, delay: number?)
	StoryService.Sequence("all", { { delay = delay or 0.5, speaker = "SPEAKER_UNKNOWN", text = text, params = params, channel = "radio", duration = 5 } })
end

local function patrolCenter(area: string): Vector3?
	for _, node in CollectionService:GetTagged("FZ_CreaturePatrol") do
		if node:IsA("BasePart") and node:GetAttribute("Area") == area then
			return node.Position
		end
	end
	return nil
end

local function randomName(): string
	local team = ctx.playersInGame()
	local named = team[math.random(1, math.max(1, #team))]
	return if named then named.DisplayName else ""
end

local function wakeCreature()
	if CreatureService.Get() then
		return
	end
	CreatureService.Spawn()
	relay("RADIO_C1_WAKE", nil, 1.5)
end

---------------------------------------------------------------------------
-- Power distribution (decision in the world, can be changed any time)
---------------------------------------------------------------------------
local function applySystems()
	local s = state.systems
	SessionState.Set("Cameras", s.cameras == true)
	if not s.cameras then
		SessionState.Set("CctvArea", nil)
	end
	PowerService.Set("HALLS", s.halls == true)
	CreatureService.SetSightScale(if s.halls then 1.3 else 1)
	CreatureService.SetVentsEnabled(s.vents == true)
	NoiseService.SetFootstepScale(if s.vents then 0.6 else 1)
	for _, lamp in CollectionService:GetTagged("FZ_LeverLamp") do
		if lamp:IsA("BasePart") then
			local on = s[lamp:GetAttribute("LeverLamp")] == true
			lamp.Color = if on then Color3.fromRGB(90, 220, 140) else Color3.fromRGB(40, 40, 38)
		end
	end
end

local function systemsOn(): number
	local count = 0
	for _, name in SYSTEMS do
		if state.systems[name] then
			count += 1
		end
	end
	return count
end

local function spawnFuses()
	if fuseFolder then
		fuseFolder:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "FZ_Fuses"
	folder.Parent = workspace
	fuseFolder = folder
	local bySector: { [string]: { BasePart } } = {}
	for _, spot in CollectionService:GetTagged("FZ_FuseSpot") do
		if spot:IsA("BasePart") then
			local sector = tostring(spot:GetAttribute("Sector"))
			bySector[sector] = bySector[sector] or {}
			table.insert(bySector[sector], spot)
		end
	end
	local sectors = {}
	for sector in bySector do
		table.insert(sectors, sector)
	end
	for i = #sectors, 2, -1 do
		local j = math.random(1, i)
		sectors[i], sectors[j] = sectors[j], sectors[i]
	end
	for i = 1, math.min(TOTAL_FUSES, #sectors) do
		local spots = bySector[sectors[i]]
		local spot = spots[math.random(1, #spots)]
		local fuse = Instance.new("Part")
		fuse.Name = "Fuse"
		fuse.Size = Vector3.new(0.5, 0.5, 1.4)
		fuse.Color = Color3.fromRGB(214, 170, 60)
		fuse.Material = Enum.Material.Metal
		fuse.Anchored = true
		fuse.CanCollide = false
		fuse.CFrame = spot.CFrame * CFrame.new(0, 0.1, 0)
		local glow = Instance.new("PointLight")
		glow.Range = 5
		glow.Brightness = 0.8
		glow.Color = Color3.fromRGB(255, 200, 90)
		glow.Parent = fuse
		fuse:SetAttribute("InteractId", "c1_fuse")
		fuse:SetAttribute("ActionKey", "INTERACT_PICKUP")
		fuse:SetAttribute("ObjectKey", "OBJECT_FUSE")
		fuse:SetAttribute("MaxDistance", 7)
		fuse.Parent = folder
		CollectionService:AddTag(fuse, "FZ_Interactable")
	end
end

local function startFuses()
	state.stage = "fuses"
	relay("RADIO_C1_TERMINAL", nil, 3)
	spawnFuses()
	StoryService.SetObjective("OBJECTIVE_FIND_FUSES", { count = 0, total = TOTAL_FUSES })
	if state.answered then
		-- Consequence of answering: the station knows you are here. It wakes up now.
		task.delay(8, function()
			if active then
				wakeCreature()
			end
		end)
	end
end

---------------------------------------------------------------------------
-- Decision: answer the voice?
---------------------------------------------------------------------------
local function askAnswer()
	state.stage = "decision"
	unknown("RADIO_C1_ASK", nil, 2)
	task.delay(6, function()
		if not active then
			return
		end
		DecisionService.Ask({
			id = "c1_answer",
			prompt = "DECISION_C1_ANSWER",
			options = { "DECISION_ANSWER", "DECISION_SILENT" },
			seconds = 20,
			default = 2,
			onDecided = function(index)
				if not active then
					return
				end
				state.answered = index == 1
				step("Decision")
				for _, p in ctx.playersInGame() do
					BadgeTracker.Award(p, if state.answered then "answered" else "stayed_silent")
				end
				if state.answered then
					unknown("RADIO_C1_ANSWERED", { name = randomName() }, 1)
					relay("RADIO_C1_RELAY_ANSWERED", nil, 7)
				else
					unknown("RADIO_C1_SILENT", nil, 1)
					relay("RADIO_C1_RELAY_SILENT", nil, 6)
				end
				task.delay(10, function()
					if active and state.stage == "decision" then
						state.stage = "control"
						StoryService.SetObjective("OBJECTIVE_REACH_CONTROL")
					end
				end)
			end,
		}, ctx.playersInGame)
	end)
end

---------------------------------------------------------------------------
-- Forecasts
---------------------------------------------------------------------------
local function forecastLightsA()
	ForecastService.Start({
		id = "c1_lights_a",
		text = "RADIO_C1_FORECAST",
		hud = "FORECAST_LIGHTS_A",
		seconds = 30,
		breakWith = "c1_breaker_a",
		onKept = function()
			PowerService.Set("A", false)
			local center = patrolCenter("A")
			if center then
				sfxAt("power_down", center)
				CreatureService.Alert(center)
			end
			StoryService.Say("all", { text = "SFX_POWER_DOWN", channel = "world", duration = 3, critical = true })
		end,
		onBroken = function() end,
		keptLine = "RADIO_C1_FORECAST_KEPT",
		brokenLine = "RADIO_C1_FORECAST_BROKEN",
	})
end

local function forecastGenerator()
	ForecastService.Start({
		id = "c1_generator_e",
		text = "RADIO_C1_FORECAST_GEN",
		hud = "FORECAST_GENERATOR_E",
		seconds = 40,
		breakWith = "generator",
		onKept = function()
			PowerService.Set("E", false)
			local center = patrolCenter("E")
			if center then
				sfxAt("power_down", center)
				CreatureService.Alert(center)
			end
			StoryService.Say("all", { text = "SFX_POWER_DOWN", channel = "world", duration = 3, critical = true })
		end,
		onBroken = function(player)
			sfxAt("relay_activate", (player.Character :: Model):GetPivot().Position)
		end,
		keptLine = "RADIO_C1_FORECAST_KEPT",
		brokenLine = "RADIO_C1_FORECAST_GEN_BROKEN",
	})
end

---------------------------------------------------------------------------
-- Scares (HorrorDirector beats) - the moments of the first ten minutes
---------------------------------------------------------------------------
local function inBuilding(position: Vector3): boolean
	return math.abs(position.X) < 100 and position.Z > -85 and position.Z < 70
end

local function screenNear(position: Vector3, radius: number): boolean
	for _, screen in CollectionService:GetTagged("FZ_CctvScreen") do
		if screen:IsA("BasePart") and (screen.Position - position).Magnitude < radius then
			return true
		end
	end
	return false
end

local function beats()
	local function after(stage: string): boolean
		local order = { "arrival", "decision", "control", "power", "fuses", "relay", "core", "antenna", "done" }
		return (table.find(order, state.stage) or 0) >= (table.find(order, stage) or 0)
	end
	return {
		{
			-- The monitor shows the team in a hallway 20 s in the future - and something
			-- behind the last person. Only ONE player sees the figure; the others see the
			-- same feed without it.
			id = "cctv_future",
			kind = "cctv",
			once = true,
			weight = 50,
			others = true,
			condition = function(_player, info)
				return state.systems.cameras == true and after("power") and screenNear(info.position, 12)
			end,
			data = function()
				return { withFigure = true, offset = 20 }
			end,
		},
		{
			id = "name_call",
			kind = "namecall",
			once = true,
			weight = 20,
			condition = function(_player, info)
				return info.alone and after("fuses") and inBuilding(info.position)
			end,
			data = function(player)
				return { name = player.DisplayName, answered = state.answered }
			end,
		},
		{
			-- A figure at the end of a hallway that is gone a moment later.
			id = "apparition_hall",
			kind = "apparition",
			once = true,
			weight = 20,
			condition = function(_player, info)
				return info.area == "HALL" and after("control")
			end,
		},
		{
			id = "apparition_late",
			kind = "apparition",
			once = true,
			condition = function(_player, info)
				return info.area ~= nil and info.area ~= "HALL" and after("relay")
			end,
		},
		{
			id = "footsteps",
			kind = "footsteps",
			condition = function(_player, info)
				return info.alone and inBuilding(info.position) and after("control")
			end,
		},
		{
			id = "flicker",
			kind = "flicker",
			condition = function(_player, info)
				return info.area ~= nil and info.area ~= "HALL" and after("control")
			end,
		},
		{
			-- A familiar room changes: a door behind you closes by itself.
			id = "door_slam",
			kind = "doorslam",
			once = true,
			condition = function(_player, info)
				return after("fuses") and inBuilding(info.position)
			end,
			data = function(player)
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root then
					for _, panel in CollectionService:GetTagged("FZ_Door") do
						if panel:IsA("BasePart") and panel:GetAttribute("Open") and (panel.Position - root.Position).Magnitude < 25 then
							DoorService.Close(panel)
							break
						end
					end
				end
				return {}
			end,
		},
	}
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------
local function reset()
	state.stage = "arrival"
	state.fuses = 0
	state.answered = false
	state.powerChosenOnce = false
	table.clear(state.systems)
	table.clear(state.completedBy)
	if fuseFolder then
		fuseFolder:Destroy()
		fuseFolder = nil
	end
	ForecastService.Cancel()
	DecisionService.Cancel()
	DirectorService.Stop()
	StoryService.ResetFlags()
	StoryService.SetObjective(nil)
	SessionState.Set("Cameras", nil)
	SessionState.Set("CctvArea", nil)
end

function Chapter1.Begin()
	reset()
	table.clear(stepped)
	active = true
	applySystems()
	DirectorService.Configure(HorrorEvents.With(beats()), HINTS, ctx.playersInGame)
end

function Chapter1.Stop()
	active = false
	reset()
	NoiseService.SetFootstepScale(1)
	CreatureService.SetVentsEnabled(true)
	CreatureService.SetSightScale(1)
end

-- Registers interaction handlers once. Every handler ignores input unless chapter 1 is
-- the running session (the same objects are used by the survival mode).
function Chapter1.Init(context)
	ctx = context
	ForecastService.Breakable("c1_breaker_a")
	ForecastService.Breakable("generator")

	InteractionService.Register("c1_fax", function(player)
		if not active then
			return
		end
		StoryService.ShowDocument(player, { title = "FAX_TITLE", body = "FAX_BODY", date = os.time() + 24 * 60 * 60 })
		if StoryService.GetFlag("C1_FaxRead") then
			return
		end
		StoryService.SetFlag("C1_FaxRead", true)
		step("Fax")
		LoreService.UnlockAll(ctx.playersInGame(), "rec_c1_relay")
		relay("RADIO_C1_003", nil, 3)
		askAnswer()
	end)

	InteractionService.Register("c1_terminal", function()
		if not active or (state.stage ~= "control" and state.stage ~= "arrival" and state.stage ~= "decision") then
			return
		end
		DecisionService.Cancel()
		state.stage = "power"
		step("Power")
		for _, p in ctx.playersInGame() do
			ReferralService.Complete(p) -- invited new players: reached the control room
		end
		ctx.setCheckpoint("C1_CONTROL")
		relay("RADIO_C1_POWER")
		StoryService.SetObjective("OBJECTIVE_POWER", { count = systemsOn(), total = 2 })
	end)

	InteractionService.Register("c1_power", function(player, lever)
		if not active or state.stage == "arrival" or state.stage == "decision" or state.stage == "control" then
			return
		end
		local system = lever:GetAttribute("System")
		if type(system) ~= "string" or not table.find(SYSTEMS, system) then
			return
		end
		if state.systems[system] then
			state.systems[system] = nil
		elseif systemsOn() < 2 then
			state.systems[system] = true
		else
			Net.Event("Notify"):FireClient(player, "SYS_FULL")
			Net.Event("Sfx"):FireAllClients("door_locked", (lever :: BasePart).Position)
			return
		end
		Net.Event("Sfx"):FireAllClients("relay_activate", (lever :: BasePart).Position)
		NoiseService.Emit((lever :: BasePart).Position, Config.Noise.Door, player)
		applySystems()
		if state.stage == "power" then
			StoryService.SetObjective("OBJECTIVE_POWER", { count = systemsOn(), total = 2 })
			if systemsOn() == 2 and not state.powerChosenOnce then
				state.powerChosenOnce = true
				-- The Relay reacts to WHAT you chose (consequence you can hear).
				local leftOut = "cameras"
				for _, name in SYSTEMS do
					if not state.systems[name] then
						leftOut = name
					end
				end
				relay("RADIO_C1_POWER_NO_" .. string.upper(leftOut), nil, 1)
				task.delay(6, function()
					if active and state.stage == "power" then
						startFuses()
					end
				end)
			end
		end
	end)

	InteractionService.Register("c1_fuse", function(player, fuse)
		if not active or state.stage ~= "fuses" or not fuse.Parent then
			return
		end
		sfxAt("fuse_pickup", (fuse :: BasePart).Position)
		fuse:Destroy()
		state.fuses += 1
		rewardAll(Config.Rewards.Fuse)
		NoiseService.Emit((player.Character :: Model):GetPivot().Position, Config.Noise.Interact, player)
		step(if state.fuses == 1 then "FirstFuse" else "")
		if state.fuses >= Config.Creature.ActivateAfterFuses then
			wakeCreature()
		end
		if state.fuses == 2 then
			forecastLightsA()
		end
		if state.fuses >= TOTAL_FUSES then
			state.stage = "relay"
			step("AllFuses")
			StoryService.SetObjective("OBJECTIVE_RELAY_B")
		else
			StoryService.SetObjective("OBJECTIVE_FIND_FUSES", { count = state.fuses, total = TOTAL_FUSES })
		end
	end)

	InteractionService.Register("c1_relay_b", function(_player, panel)
		if not active or state.stage ~= "relay" then
			return
		end
		state.stage = "core"
		step("Relay")
		PowerService.Set("B", true)
		sfxAt("relay_activate", (panel :: BasePart).Position)
		NoiseService.Emit((panel :: BasePart).Position, 60, nil)
		StoryService.Say("all", { text = "SFX_RELAY", channel = "world", duration = 3 })
		rewardAll(Config.Rewards.Relay)
		ctx.setCheckpoint("C1_CORE")
		StoryService.SetObjective("OBJECTIVE_CORE")
		task.delay(12, function()
			if active and state.stage == "core" and not ForecastService.IsActive() then
				forecastGenerator()
			end
		end)
	end)

	InteractionService.Register("c1_core", function(_player, console)
		if not active or state.stage ~= "core" then
			return
		end
		state.stage = "antenna"
		step("Core")
		PowerService.Set("CORE", true)
		sfxAt("relay_activate", (console :: BasePart).Position)
		CreatureService.Alert((console :: BasePart).Position)
		StoryService.Sequence("all", {
			{ delay = 2, text = "SFX_STATIC", channel = "sfx", duration = 2 },
			{
				delay = 1.5,
				speaker = "SPEAKER_RELAY",
				text = if state.answered then "RADIO_C1_CORE_ANSWERED" else "RADIO_C1_CORE",
				params = { name = randomName() },
				channel = "radio",
				duration = 5,
			},
		})
		task.delay(8, function()
			if active then
				StoryService.SetObjective("OBJECTIVE_ANTENNA")
			end
		end)
	end)

	InteractionService.Register("c1_antenna", function()
		if not active or (state.stage ~= "antenna" and state.stage ~= "done") then
			return
		end
		if state.stage == "antenna" then
			state.stage = "done"
			step("Antenna")
			ForecastService.Cancel()
			unknown(if state.answered then "RADIO_C1_ANTENNA_ANSWERED" else "RADIO_C1_ANTENNA", nil, 1)
			CreatureService.SetAIEnabled(false)
			task.delay(14, function()
				if active and state.stage == "done" then
					ctx.finish()
				end
			end)
		end
		for _, p in ctx.playersInGame() do
			if not state.completedBy[p] then
				state.completedBy[p] = true
				DataService.Grant(p, Config.Rewards.ChapterComplete)
				DataService.Mutate(p, function(data)
					if data.progress.completedChapters.ch1 == nil then
						data.progress.completedChapters.ch1 = os.time()
					end
				end)
				DataService.SaveNow(p)
				Net.Event("Notify"):FireClient(p, "CHAPTER_COMPLETE")
				BadgeTracker.Award(p, "ch1_complete")
				if not CreatureService.Spotted[p] then
					AchievementService.Award(p, "unseen")
				end
				local team = ctx.playersInGame()
				if #team >= 2 and next(HealthService.SessionStats.eliminated) == nil then
					AchievementService.Award(p, "nobody_left")
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		state.completedBy[player] = nil
	end)
end

function Chapter1.OnPlayerEntered(player: Player, firstTime: boolean)
	if not firstTime or not active then
		return
	end
	if state.stage == "arrival" then
		AnalyticsTracker.ChapterStep(player, "Chapter1", "Gate")
		StoryService.Sequence(player, ARRIVAL)
		task.delay(12, function()
			if player.Parent then
				LoreService.Unlock(player, "rec_c1_arrival", true)
				AchievementService.Award(player, "first_contact")
			end
		end)
		if StoryService.GetObjective() == nil then
			task.delay(14, function()
				if active and StoryService.GetObjective() == nil then
					StoryService.SetObjective("OBJECTIVE_CHECK_GATEHOUSE")
				end
			end)
		end
	end
end

return Chapter1
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="33">
        <Properties>
          <string name="Name">Creature</string>
        </Properties>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Rig</string>
            <string name="Source"><![CDATA[-- Creature rig factory.
--
-- 1. Your own monster: put a Model into ServerStorage > Creatures. Requirements:
--    Humanoid + HumanoidRootPart (PrimaryPart), anchored = false, correct HipHeight.
--    Optional animation ids in Shared/Assets.luau (CreatureAnimations).
-- 2. Otherwise the built-in placeholder "Der Lauscher" is built from parts:
--    ~8.5 studs tall, very thin, horn-speaker head, arms down to the knees.
--    It is animated procedurally on the clients (CreatureVisualsController) by
--    driving Motor6D.Transform - no animation assets needed.

local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")

local Rig = {}

local SKIN = Color3.fromRGB(58, 52, 50)
local SKIN_DARK = Color3.fromRGB(34, 30, 30)
local FABRIC = Color3.fromRGB(24, 22, 22)

local function part(model: Model, name: string, size: Vector3, color: Color3, material: Enum.Material?, collide: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = collide == true
	p.CanQuery = true
	p.CanTouch = false
	p.Massless = not collide
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function motor(name: string, part0: BasePart, part1: BasePart, c0: CFrame, c1: CFrame)
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = c0
	m.C1 = c1
	m.Parent = part0
	return m
end

function Rig.BuildPlaceholder(): Model
	local model = Instance.new("Model")
	model.Name = "Lauscher"

	local root = part(model, "HumanoidRootPart", Vector3.new(2, 2, 1), SKIN, Enum.Material.SmoothPlastic, true)
	root.Transparency = 1
	model.PrimaryPart = root

	local torso = part(model, "Torso", Vector3.new(1.3, 3.2, 0.8), SKIN, Enum.Material.Fabric, true)
	local head = part(model, "Head", Vector3.new(1.3, 1.3, 1.6), SKIN_DARK, Enum.Material.Metal)
	local horn = part(model, "Horn", Vector3.new(0.4, 2.1, 2.1), SKIN_DARK, Enum.Material.Metal)
	horn.Shape = Enum.PartType.Cylinder
	local grille = part(model, "Grille", Vector3.new(0.12, 1.9, 1.9), FABRIC, Enum.Material.Fabric)
	grille.Shape = Enum.PartType.Cylinder

	motor("RootJoint", root, torso, CFrame.new(0, -1, 0), CFrame.new(0, -1.6, 0) * CFrame.Angles(math.rad(-12), 0, 0))
	motor("Neck", torso, head, CFrame.new(0, 1.6, 0), CFrame.new(0, -0.7, 0.2))
	-- Horn faces forward (-Z). Cylinders extend along X, so rotate 90 degrees around Y.
	local hornWeld = Instance.new("Weld")
	hornWeld.Part0 = head
	hornWeld.Part1 = horn
	hornWeld.C0 = CFrame.new(0, 0, -0.9) * CFrame.Angles(0, math.rad(90), 0)
	hornWeld.Parent = head
	local grilleWeld = Instance.new("Weld")
	grilleWeld.Part0 = head
	grilleWeld.Part1 = grille
	grilleWeld.C0 = CFrame.new(0, 0, -1.12) * CFrame.Angles(0, math.rad(90), 0)
	grilleWeld.Parent = head

	for _, side in { { "Left", -1 }, { "Right", 1 } } do
		local name, s = side[1], side[2]
		local upperArm = part(model, name .. "UpperArm", Vector3.new(0.35, 3.2, 0.35), SKIN, Enum.Material.Fabric)
		local lowerArm = part(model, name .. "LowerArm", Vector3.new(0.3, 3.4, 0.3), SKIN, Enum.Material.Fabric)
		local hand = part(model, name .. "Hand", Vector3.new(0.5, 1.1, 0.25), SKIN_DARK, Enum.Material.Fabric)
		motor(name .. "Shoulder", torso, upperArm, CFrame.new(s * 0.85, 1.3, 0), CFrame.new(0, 1.6, 0))
		motor(name .. "Elbow", upperArm, lowerArm, CFrame.new(0, -1.6, 0), CFrame.new(0, 1.7, 0))
		motor(name .. "Wrist", lowerArm, hand, CFrame.new(0, -1.7, 0), CFrame.new(0, 0.55, 0))

		local upperLeg = part(model, name .. "UpperLeg", Vector3.new(0.45, 2.4, 0.45), SKIN, Enum.Material.Fabric)
		local lowerLeg = part(model, name .. "LowerLeg", Vector3.new(0.4, 2.4, 0.4), SKIN, Enum.Material.Fabric)
		motor(name .. "Hip", root, upperLeg, CFrame.new(s * 0.4, -1, 0), CFrame.new(0, 1.2, 0))
		motor(name .. "Knee", upperLeg, lowerLeg, CFrame.new(0, -1.2, 0), CFrame.new(0, 1.2, 0))
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 4.8
	humanoid.AutomaticScalingEnabled = false
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.MaxHealth = 1e6
	humanoid.Health = 1e6
	humanoid.Parent = model
	Instance.new("Animator").Parent = humanoid

	model:SetAttribute("Procedural", true)
	return model
end

-- Returns the creature model to use (your model if present, else the placeholder).
function Rig.Create(): Model
	local folder = ServerStorage:FindFirstChild("Creatures")
	if folder then
		for _, candidate in folder:GetChildren() do
			if candidate:IsA("Model") and candidate:FindFirstChildOfClass("Humanoid") and candidate:FindFirstChild("HumanoidRootPart") then
				local clone = candidate:Clone()
				clone.PrimaryPart = clone:FindFirstChild("HumanoidRootPart") :: BasePart
				for _, descendant in clone:GetDescendants() do
					if descendant:IsA("BasePart") then
						descendant.Anchored = false
					end
				end
				if clone:GetAttribute("Procedural") == nil then
					clone:SetAttribute("Procedural", false)
				end
				return clone
			end
		end
		warn("[FZ-Creature] ServerStorage.Creatures has no valid model (needs Humanoid + HumanoidRootPart); using placeholder")
	end
	return Rig.BuildPlaceholder()
end

function Rig.Tag(model: Model)
	CollectionService:AddTag(model, "FZ_CreatureRig")
end

return Rig
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="35">
        <Properties>
          <string name="Name">Director</string>
        </Properties>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">HorrorEvents</string>
            <string name="Source"><![CDATA[-- The shared pool of psychological horror events (used by every mode).
-- Each entry: kind (performed by DirectorController), weight, cooldown, chance (rarity)
-- and a condition. The director never fires while a creature is chasing nearby and never
-- uses the real chase warning sound for a trick - danger always stays recognisable.

local Services = script.Parent.Parent.Services
local DirectorService = require(Services.DirectorService)
local CreatureService = require(Services.CreatureService)

local HorrorEvents = {}

local function noCreatureNear(position: Vector3, radius: number): boolean
	local model = CreatureService.Get()
	local root = model and model:FindFirstChild("HumanoidRootPart")
	return not root or ((root :: BasePart).Position - position).Magnitude > radius
end

local function inside(info): boolean
	return info.area ~= nil
end

function HorrorEvents.Pool(): { any }
	return {
		{ id = "ev_window", kind = "window", weight = 3, cooldown = 140, condition = function(_p, info)
			return DirectorService.NearTagged("FZ_Window", info.position, 6, 32)
		end },
		{ id = "ev_occupant", kind = "occupant", weight = 2, cooldown = 160, chance = 0.6, condition = function(_p, info)
			return info.area ~= nil and info.area ~= "HALL" and info.area ~= "CONTROL"
		end },
		{ id = "ev_speaker", kind = "speaker", weight = 3, cooldown = 100, condition = function(_p, info)
			return DirectorService.NearTagged("FZ_Speaker", info.position, 4, 40)
		end },
		{ id = "ev_neighbor_light", kind = "neighborlight", weight = 3, cooldown = 110, condition = function(_p, info)
			return inside(info)
		end },
		{ id = "ev_footsteps", kind = "footsteps", weight = 4, cooldown = 70, condition = function(_p, info)
			return info.alone and inside(info)
		end },
		{ id = "ev_shadow", kind = "shadow", weight = 2, cooldown = 150, condition = function(_p, info)
			return inside(info)
		end },
		-- Acoustic deception: creature sounds behind a wall although nothing is there.
		{ id = "ev_phantom", kind = "phantom", weight = 4, cooldown = 80, condition = function(_p, info)
			return inside(info) and noCreatureNear(info.position, 55)
		end },
		{ id = "ev_approach", kind = "approach", weight = 2, cooldown = 200, chance = 0.7, condition = function(_p, info)
			return info.area == "HALL" and noCreatureNear(info.position, 70)
		end },
		{ id = "ev_voices", kind = "voices", weight = 2, cooldown = 180, condition = function(_p, info)
			return inside(info) and info.alone
		end },
		-- Very rare: an object only YOU can see (another radio in your own colours...)
		{ id = "ev_object", kind = "object", weight = 1, cooldown = 600, chance = 0.35, condition = function(_p, info)
			return inside(info)
		end },
	}
end

-- Story beats first, then the pool (story beats keep their own conditions).
function HorrorEvents.With(storyBeats: { any }): { any }
	local list = table.clone(storyBeats)
	for _, beat in HorrorEvents.Pool() do
		table.insert(list, beat)
	end
	return list
end

return HorrorEvents
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="37">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- SILENT RELAY - server bootstrap.
-- Order matters: remotes and shared state first, then data, then gameplay services.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
require(Shared.Net).Init()
require(Shared.SessionState).Init()

local SERVICES = {
	"DataService",
	"MapService",
	"SettingsService",
	"AdminService",
	"CodeService",
	"InteractionService",
	"NoiseService",
	"DoorService",
	"PowerService",
	"HealthService",
	"InventoryService",
	"LoreService",
	"EvidenceService",
	"SecretService",
	"CommunityService",
	"ReferralService",
	"VoiceService",
	"ShopService",
	"CreatureService",
	"FlashlightService",
	"MovementGuardService",
	"LeaderboardService",
	"DecisionService",
	"DirectorService",
	"PlaceService",
	"PartyService",
	"SessionService",
}

for _, name in SERVICES do
	local module = script.Parent.Services:FindFirstChild(name)
	local ok, err = pcall(function()
		local service = require(module)
		if name == "PowerService" then
			service.Start(require(script.Parent.Services.DoorService))
		else
			service.Start()
		end
	end)
	if not ok then
		warn(string.format("[FZ] %s failed to start: %s", name, tostring(err)))
	end
end

print("[FZ] Server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="38">
        <Properties>
          <string name="Name">Map</string>
        </Properties>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">RelayStation07</string>
            <string name="Source"><![CDATA[-- Relay Station 07 - script-built playable map following the concept floor plan:
--
--            N (-Z)
--   [Sektor C]──────[N-Halle]──────[Sektor D]
--   [Sektor B]─[W]─( ZENTRALKERN )─[O]─[Sektor A]
--   [Sektor E]──────[S-Halle]──────[Eingang/Kontrolle]──► Hof, Straße, Tor
--                     Außenbereich: Antenne (Extraktion)
--
-- Everything gameplay-relevant is expressed through tags + attributes, so you can replace
-- any part of it with your own Studio build later (see docs/MAP_CONTRACT.md):
--   FZ_Interactable, FZ_Door, FZ_SectorLight, FZ_FuseSpot, FZ_CreaturePatrol, FZ_Vent,
--   FZ_CreatureSpawn, FZ_Checkpoint, FZ_MenuCamera, FZ_WorldText, FZ_KeyLight.
-- It is only built when Workspace has no "FZ_Map" model.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local Map = {}

local H = 14 -- wall height
local DOOR_H = 10
local T = 1 -- wall thickness

local C = {
	Concrete = Color3.fromRGB(104, 104, 100),
	ConcreteDark = Color3.fromRGB(64, 66, 66),
	Floor = Color3.fromRGB(78, 74, 66),
	Linoleum = Color3.fromRGB(92, 84, 66),
	Steel = Color3.fromRGB(64, 84, 82),
	SteelDark = Color3.fromRGB(42, 48, 50),
	Wood = Color3.fromRGB(82, 62, 44),
	Plastic = Color3.fromRGB(190, 184, 170),
	Paper = Color3.fromRGB(226, 220, 204),
	Sodium = Color3.fromRGB(255, 170, 96),
	Fluorescent = Color3.fromRGB(214, 236, 230),
	Emergency = Color3.fromRGB(200, 40, 30),
	Screen = Color3.fromRGB(90, 220, 140),
	Asphalt = Color3.fromRGB(36, 38, 40),
	Pine = Color3.fromRGB(28, 44, 34),
	Bark = Color3.fromRGB(52, 40, 32),
}

local root: Model
local exteriorDetail: (outside: Instance) -> ()
local rng = Random.new(707)

---------------------------------------------------------------------------
-- Primitive helpers
---------------------------------------------------------------------------
local function block(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function folder(name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = root
	return f
end

local function tag(instance: Instance, tagName: string, attributes: { [string]: any }?)
	for key, value in attributes or {} do
		instance:SetAttribute(key, value)
	end
	CollectionService:AddTag(instance, tagName)
end

local function worldText(target: BasePart, face: Enum.NormalId, key: string?, staticText: string?, params: { [string]: string }?, color: Color3?, font: Enum.Font?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 1
	gui.AutoLocalize = false
	gui.Parent = target
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.FontFace = Font.fromEnum(font or Enum.Font.RobotoMono)
	label.TextScaled = true
	label.TextWrapped = true
	label.TextColor3 = color or Color3.fromRGB(30, 28, 26)
	label.Text = staticText or ""
	label.AutoLocalize = false
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.06, 0)
	padding.PaddingRight = UDim.new(0.06, 0)
	padding.PaddingTop = UDim.new(0.1, 0)
	padding.PaddingBottom = UDim.new(0.1, 0)
	padding.Parent = label
	if key then
		label:SetAttribute("LocKey", key)
		for name, value in params or {} do
			label:SetAttribute("LocParam_" .. name, value)
		end
		CollectionService:AddTag(label, "FZ_WorldText")
	end
	label.Parent = gui
	return label
end

---------------------------------------------------------------------------
-- Walls with door gaps. gaps = { { center, width } }
---------------------------------------------------------------------------
local walls: Folder

local function wallSegments(a: number, b: number, gaps: { { number } }?): { { number } }
	local segments = {}
	local cursor = a
	local sorted = table.clone(gaps or {})
	table.sort(sorted, function(x, y)
		return x[1] < y[1]
	end)
	for _, gap in sorted do
		local g0, g1 = gap[1] - gap[2] / 2, gap[1] + gap[2] / 2
		if g0 > cursor then
			table.insert(segments, { cursor, g0, false })
		end
		table.insert(segments, { g0, g1, true })
		cursor = g1
	end
	if cursor < b then
		table.insert(segments, { cursor, b, false })
	end
	return segments
end

-- Wall running along X at constant z.
local function wallZ(z: number, x0: number, x1: number, gaps: { { number } }?, color: Color3?)
	for _, s in wallSegments(x0, x1, gaps) do
		local width = s[2] - s[1]
		local mid = (s[1] + s[2]) / 2
		if s[3] then
			block(walls, "Lintel", Vector3.new(width, H - DOOR_H, T), CFrame.new(mid, DOOR_H + (H - DOOR_H) / 2, z), color or C.Concrete, Enum.Material.Concrete)
		else
			block(walls, "Wall", Vector3.new(width, H, T), CFrame.new(mid, H / 2, z), color or C.Concrete, Enum.Material.Concrete)
		end
	end
end

-- Wall running along Z at constant x.
local function wallX(x: number, z0: number, z1: number, gaps: { { number } }?, color: Color3?)
	for _, s in wallSegments(z0, z1, gaps) do
		local depth = s[2] - s[1]
		local mid = (s[1] + s[2]) / 2
		if s[3] then
			block(walls, "Lintel", Vector3.new(T, H - DOOR_H, depth), CFrame.new(x, DOOR_H + (H - DOOR_H) / 2, mid), color or C.Concrete, Enum.Material.Concrete)
		else
			block(walls, "Wall", Vector3.new(T, H, depth), CFrame.new(x, H / 2, mid), color or C.Concrete, Enum.Material.Concrete)
		end
	end
end

---------------------------------------------------------------------------
-- Doors: sliding steel doors, optionally power-locked
---------------------------------------------------------------------------
local doors: Folder
local doorCount = 0

local function door(center: Vector3, alongX: boolean, width: number, locked: boolean?, sector: string?)
	doorCount += 1
	local size = if alongX then Vector3.new(width, DOOR_H, 0.6) else Vector3.new(0.6, DOOR_H, width)
	local closed = CFrame.new(center.X, DOOR_H / 2, center.Z)
	local slide = if alongX then Vector3.new(width - 0.4, 0, 0) else Vector3.new(0, 0, width - 0.4)
	local panel = block(doors, "Door" .. doorCount, size, closed, C.Steel, Enum.Material.Metal)
	-- frame (two posts + header) and yellow/black hazard stripes on the floor
	local along = if alongX then Vector3.new(1, 0, 0) else Vector3.new(0, 0, 1)
	for _, sideSign in { -1, 1 } do
		local postPos = Vector3.new(center.X, DOOR_H / 2, center.Z) + along * sideSign * (width / 2 + 0.35)
		block(doors, "DoorFrame", if alongX then Vector3.new(0.7, DOOR_H, 1.6) else Vector3.new(1.6, DOOR_H, 0.7), CFrame.new(postPos), C.SteelDark, Enum.Material.Metal)
	end
	block(doors, "DoorHeader", if alongX then Vector3.new(width + 1.4, 0.9, 1.6) else Vector3.new(1.6, 0.9, width + 1.4), CFrame.new(center.X, DOOR_H + 0.45, center.Z), C.SteelDark, Enum.Material.Metal)
	local stripes = math.max(2, math.floor(width / 1.2))
	for i = 0, stripes - 1 do
		local offset = -width / 2 + (i + 0.5) * width / stripes
		local stripe = block(doors, "Hazard", if alongX then Vector3.new(width / stripes, 0.05, 2.4) else Vector3.new(2.4, 0.05, width / stripes), CFrame.new(center.X, 0.03, center.Z) + along * offset, if i % 2 == 0 then Color3.fromRGB(214, 170, 40) else Color3.fromRGB(26, 24, 22), Enum.Material.SmoothPlastic)
		stripe.CanCollide = false
	end
	local stripe = block(panel, "Stripe", if alongX then Vector3.new(width, 0.4, 0.7) else Vector3.new(0.7, 0.4, width), closed * CFrame.new(0, 1.5, 0), if locked then C.Emergency else C.Plastic, Enum.Material.Neon)
	stripe.CanCollide = false
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = panel
	weld.Part1 = stripe
	weld.Parent = panel
	stripe.Anchored = false
	local modifier = Instance.new("PathfindingModifier")
	modifier.PassThrough = not locked
	modifier.Parent = panel
	tag(panel, "FZ_Door", {
		DoorId = "D" .. doorCount,
		Open = false,
		Locked = locked == true,
		PowerSector = sector or "",
		ClosedCFrame = closed,
		OpenCFrame = closed + slide,
	})
	tag(panel, "FZ_Interactable", {
		InteractId = "door",
		ActionKey = "INTERACT_OPEN",
		ObjectKey = "OBJECT_DOOR",
		MaxDistance = 9,
	})
	return panel
end

---------------------------------------------------------------------------
-- Lights (tagged by sector so PowerService can switch them)
---------------------------------------------------------------------------
local lights: Folder
local lightsPerSector: { [string]: number } = {}

-- The first light of every sector is a key light (on at every graphics level), so no
-- room is ever pitch black on low-end devices; further lights are decorative.
local function ceilingLight(position: Vector3, sector: string, color: Color3?, shadows: boolean?, forceKey: boolean?)
	lightsPerSector[sector] = (lightsPerSector[sector] or 0) + 1
	-- the first TWO lights per sector are key lights (on at every graphics level)
	local key = forceKey or lightsPerSector[sector] <= 2
	local housing = block(lights, "LampHousing", Vector3.new(6.6, 0.45, 1.6), CFrame.new(position.X, H - 0.25, position.Z), C.SteelDark, Enum.Material.Metal)
	housing.CanCollide = false
	local fixture = block(lights, "Fixture_" .. sector, Vector3.new(6, 0.15, 1.1), CFrame.new(position.X, H - 0.52, position.Z), color or C.Fluorescent, Enum.Material.Neon)
	fixture.CanCollide = false
	fixture.CastShadow = false
	local light = Instance.new("SurfaceLight")
	light.Face = Enum.NormalId.Bottom
	light.Range = 28
	light.Angle = 140
	light.Brightness = 1.9
	light.Color = color or C.Fluorescent
	light.Shadows = shadows == true
	light.Parent = fixture
	tag(fixture, "FZ_SectorLight", { Sector = sector, OnColor = color or C.Fluorescent })
	if key then
		CollectionService:AddTag(fixture, "FZ_KeyLight")
	else
		CollectionService:AddTag(fixture, "FZ_DecorLight")
	end
	return fixture
end

-- Fill a rectangular room with a grid of ceiling lights (spacing ~14 studs).
local function lightGrid(x0: number, x1: number, z0: number, z1: number, sector: string, color: Color3?)
	local nx = math.max(1, math.floor((x1 - x0) / 16))
	local nz = math.max(1, math.floor((z1 - z0) / 14))
	for ix = 1, nx do
		for iz = 1, nz do
			local x = x0 + (x1 - x0) * (ix - 0.5) / nx
			local z = z0 + (z1 - z0) * (iz - 0.5) / nz
			ceilingLight(Vector3.new(x, 0, z), sector, color, ix == 1 and iz == 1)
		end
	end
end

local function emergencyLight(position: Vector3, sector: string)
	local lamp = block(lights, "Emergency", Vector3.new(0.8, 0.5, 0.8), CFrame.new(position), C.Emergency, Enum.Material.Neon)
	lamp.CanCollide = false
	local light = Instance.new("PointLight")
	light.Range = 14
	light.Brightness = 0.7
	light.Color = C.Emergency
	light.Parent = lamp
	CollectionService:AddTag(lamp, "FZ_KeyLight") -- emergency lights never turn off: readable darkness
	lamp:SetAttribute("Sector", sector)
	return lamp
end

---------------------------------------------------------------------------
-- Props
---------------------------------------------------------------------------
local props: Folder

local function desk(cf: CFrame)
	block(props, "Desk", Vector3.new(6, 0.3, 3), cf * CFrame.new(0, 3, 0), C.Wood, Enum.Material.Wood)
	for _, x in { -2.7, 2.7 } do
		block(props, "DeskLeg", Vector3.new(0.4, 3, 2.6), cf * CFrame.new(x, 1.5, 0), C.SteelDark, Enum.Material.Metal)
	end
end

local function chair(cf: CFrame)
	block(props, "ChairSeat", Vector3.new(1.8, 0.3, 1.8), cf * CFrame.new(0, 1.8, 0), C.SteelDark, Enum.Material.Fabric)
	block(props, "ChairBack", Vector3.new(1.8, 2, 0.25), cf * CFrame.new(0, 2.9, 0.8), C.SteelDark, Enum.Material.Fabric)
	block(props, "ChairLeg", Vector3.new(0.25, 1.7, 0.25), cf * CFrame.new(0, 0.85, 0), C.Steel, Enum.Material.Metal)
	block(props, "ChairFoot", Vector3.new(1.6, 0.15, 1.6), cf * CFrame.new(0, 0.1, 0), C.Steel, Enum.Material.Metal)
end

local function console(cf: CFrame)
	block(props, "Console", Vector3.new(7, 3.4, 2.4), cf * CFrame.new(0, 1.7, 0), C.SteelDark, Enum.Material.Metal)
	block(props, "ConsoleTop", Vector3.new(7.2, 0.3, 2.8), cf * CFrame.new(0, 3.5, 0) * CFrame.Angles(math.rad(-12), 0, 0), C.Steel, Enum.Material.Metal)
	block(props, "Keyboard", Vector3.new(2.6, 0.15, 0.9), cf * CFrame.new(0, 3.72, -0.7) * CFrame.Angles(math.rad(-12), 0, 0), C.Plastic:Lerp(C.SteelDark, 0.5), Enum.Material.SmoothPlastic)
	-- status LEDs
	for i = -3, 3 do
		local led = block(props, "Led", Vector3.new(0.18, 0.18, 0.05), cf * CFrame.new(i * 0.6, 2.6, -1.22), if i % 3 == 0 then C.Emergency else C.Screen, Enum.Material.Neon)
		led.CanCollide = false
	end
	local screens = {}
	for i = -1, 1 do
		local monitor = block(props, "Monitor", Vector3.new(2, 1.7, 1.6), cf * CFrame.new(i * 2.25, 4.7, 0.5), Color3.fromRGB(58, 56, 52), Enum.Material.SmoothPlastic)
		local glass = block(props, "Screen", Vector3.new(1.6, 1.2, 0.05), monitor.CFrame * CFrame.new(0, 0.05, -0.82), C.Screen, Enum.Material.Neon)
		glass.Transparency = 0.2
		glass.CanCollide = false
		local glow = Instance.new("SurfaceLight")
		glow.Face = Enum.NormalId.Front
		glow.Range = 7
		glow.Brightness = 0.6
		glow.Angle = 90
		glow.Color = C.Screen
		glow.Parent = glass
		table.insert(screens, glass)
	end
	chair(cf * CFrame.new(1.2, 0, -2.8) * CFrame.Angles(0, math.rad(15), 0))
	return screens
end

local function serverRack(cf: CFrame)
	local rack = block(props, "ServerRack", Vector3.new(3, 9, 3), cf * CFrame.new(0, 4.5, 0), Color3.fromRGB(28, 30, 32), Enum.Material.Metal)
	for row = 0, 7 do
		local unit = block(props, "RackUnit", Vector3.new(2.6, 0.7, 0.1), rack.CFrame * CFrame.new(0, -3.6 + row * 1.05, -1.52), Color3.fromRGB(44, 46, 48), Enum.Material.DiamondPlate)
		unit.CanCollide = false
		for k = 0, 2 do
			local led = block(props, "RackLed", Vector3.new(0.14, 0.14, 0.05), unit.CFrame * CFrame.new(-1 + k * 0.25, 0, -0.06), if (row + k) % 4 == 0 then Color3.fromRGB(255, 170, 60) else C.Screen, Enum.Material.Neon)
			led.CanCollide = false
		end
	end
	return rack
end

local function crate(cf: CFrame, size: number?)
	local s = size or 2.4
	block(props, "Crate", Vector3.new(s, s, s), cf * CFrame.new(0, s / 2, 0), Color3.fromRGB(120, 96, 66), Enum.Material.WoodPlanks)
end

local function deskLamp(cf: CFrame)
	block(props, "LampBase", Vector3.new(0.6, 0.15, 0.6), cf, C.SteelDark, Enum.Material.Metal)
	block(props, "LampArm", Vector3.new(0.12, 1.2, 0.12), cf * CFrame.new(0, 0.65, 0) * CFrame.Angles(0, 0, math.rad(15)), C.SteelDark, Enum.Material.Metal)
	local head = block(props, "LampHead", Vector3.new(0.7, 0.35, 0.5), cf * CFrame.new(-0.3, 1.25, 0), Color3.fromRGB(255, 214, 150), Enum.Material.Neon)
	head.CanCollide = false
	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Bottom
	light.Range = 12
	light.Angle = 100
	light.Brightness = 1.4
	light.Color = Color3.fromRGB(255, 205, 140)
	light.Parent = head
	CollectionService:AddTag(head, "FZ_DecorLight")
end

local function papers(cf: CFrame)
	for i = 1, 3 do
		local sheet = block(props, "Paper", Vector3.new(0.9, 0.02, 1.2), cf * CFrame.new(i * 0.35, 0.01 * i, 0) * CFrame.Angles(0, math.rad(i * 17), 0), C.Paper, Enum.Material.SmoothPlastic)
		sheet.CanCollide = false
	end
end

-- Ceiling structure, cable tray and floor seams for a rectangular space.
local function roomDetail(x0: number, x1: number, z0: number, z1: number, floorColor: Color3?)
	local w, d = x1 - x0, z1 - z0
	local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
	local ceiling = block(props, "Ceiling", Vector3.new(w, 0.2, d), CFrame.new(cx, H - 0.1, cz), Color3.fromRGB(46, 48, 50), Enum.Material.Concrete)
	ceiling.CanCollide = false
	for x = x0 + 8, x1 - 4, 8 do
		local beam = block(props, "Beam", Vector3.new(0.6, 0.8, d), CFrame.new(x, H - 0.6, cz), Color3.fromRGB(58, 60, 62), Enum.Material.Metal)
		beam.CanCollide = false
	end
	local tray = block(props, "CableTray", Vector3.new(w - 2, 0.25, 1.2), CFrame.new(cx, H - 1.8, z0 + 1.2), C.SteelDark, Enum.Material.DiamondPlate)
	tray.CanCollide = false
	for i = 0, 2 do
		local cable = block(props, "Cable", Vector3.new(w - 2, 0.18, 0.18), CFrame.new(cx, H - 1.6, z0 + 0.8 + i * 0.35), Color3.fromRGB(20 + i * 30, 20, 20), Enum.Material.Rubber)
		cable.CanCollide = false
	end
	if floorColor then
		local overlay = block(props, "FloorFinish", Vector3.new(w - 1, 0.04, d - 1), CFrame.new(cx, 0.03, cz), floorColor, Enum.Material.Plastic)
		overlay.CanCollide = false
		for x = x0 + 5, x1 - 1, 5 do
			local seam = block(props, "Seam", Vector3.new(0.06, 0.05, d - 1), CFrame.new(x, 0.04, cz), floorColor:Lerp(Color3.new(0, 0, 0), 0.25), Enum.Material.Plastic)
			seam.CanCollide = false
		end
	end
end


local function cabinet(cf: CFrame)
	block(props, "Cabinet", Vector3.new(3, 7, 2), cf * CFrame.new(0, 3.5, 0), C.Steel, Enum.Material.Metal)
end

local function shelf(cf: CFrame)
	block(props, "Shelf", Vector3.new(8, 9, 2), cf * CFrame.new(0, 4.5, 0), C.Wood, Enum.Material.Wood)
	for row = 1, 4 do
		block(props, "Files", Vector3.new(7.2, 1.4, 1.6), cf * CFrame.new(0, row * 2 - 0.3, -0.1), C.Paper:Lerp(C.Wood, rng:NextNumber(0.2, 0.6)), Enum.Material.Cardboard)
	end
end

local function bunk(cf: CFrame)
	for _, y in { 1.6, 5.2 } do
		block(props, "Bed", Vector3.new(4, 0.8, 8), cf * CFrame.new(0, y, 0), C.Plastic:Lerp(C.Steel, 0.5), Enum.Material.Fabric)
	end
	for _, x in { -1.9, 1.9 } do
		for _, z in { -3.8, 3.8 } do
			block(props, "BunkPost", Vector3.new(0.3, 6.4, 0.3), cf * CFrame.new(x, 3.2, z), C.SteelDark, Enum.Material.Metal)
		end
	end
end

local function locker(cf: CFrame)
	block(props, "Locker", Vector3.new(2, 7, 2), cf * CFrame.new(0, 3.5, 0), C.Steel:Lerp(C.Plastic, 0.2), Enum.Material.Metal)
end

local function labTable(cf: CFrame)
	block(props, "LabTable", Vector3.new(8, 3.2, 3.5), cf * CFrame.new(0, 1.6, 0), C.Plastic, Enum.Material.SmoothPlastic)
	for i = -1, 1 do
		local flask = block(props, "Instrument", Vector3.new(1, 1.4, 1), cf * CFrame.new(i * 2.5, 3.9, 0), C.Screen:Lerp(C.Plastic, 0.6), Enum.Material.Glass)
		flask.Transparency = 0.3
	end
end

local function generator(cf: CFrame)
	local body = block(props, "Generator", Vector3.new(8, 6, 5), cf * CFrame.new(0, 3, 0), C.Steel:Lerp(C.Emergency, 0.15), Enum.Material.Metal)
	local drum = block(props, "Drum", Vector3.new(7, 4, 4), cf * CFrame.new(0, 7, 0) * CFrame.Angles(0, 0, math.rad(90)), C.SteelDark, Enum.Material.Metal)
	drum.Shape = Enum.PartType.Cylinder
	drum.Size = Vector3.new(7, 4, 4)
	drum.CFrame = cf * CFrame.new(0, 7.5, 0)
	return body
end

local function pipeRun(from: Vector3, to: Vector3, radius: number?)
	local length = (to - from).Magnitude
	local pipe = block(props, "Pipe", Vector3.new(length, (radius or 0.6) * 2, (radius or 0.6) * 2), CFrame.lookAt((from + to) / 2, to) * CFrame.Angles(0, math.rad(90), 0), C.SteelDark, Enum.Material.Metal)
	pipe.Shape = Enum.PartType.Cylinder
	pipe.CanCollide = false
end

local function sign(position: Vector3, facing: Vector3, key: string)
	local plate = block(props, "Sign", Vector3.new(8, 2.4, 0.2), CFrame.lookAt(position, position + facing), C.Plastic, Enum.Material.SmoothPlastic)
	plate.CanCollide = false
	worldText(plate, Enum.NormalId.Front, key)
end

local function vent(position: Vector3, facing: Vector3, group: string)
	local grate = block(props, "Vent", Vector3.new(3, 2, 0.3), CFrame.lookAt(position, position + facing), C.SteelDark, Enum.Material.DiamondPlate)
	grate.CanCollide = false
	tag(grate, "FZ_Vent", { VentGroup = group })
end

local function patrol(position: Vector3, area: string)
	local node = block(props, "PatrolNode", Vector3.new(1, 1, 1), CFrame.new(position.X, 3, position.Z), C.Concrete)
	node.Transparency = 1
	node.CanCollide = false
	node.CanQuery = false
	node.CanTouch = false
	tag(node, "FZ_CreaturePatrol", { Area = area })
end

local function fuseSpot(cf: CFrame, sector: string)
	local spot = block(props, "FuseSpot", Vector3.new(1, 1, 1), cf, C.Concrete)
	spot.Transparency = 1
	spot.CanCollide = false
	spot.CanQuery = false
	tag(spot, "FZ_FuseSpot", { Sector = sector })
end

local function checkpoint(id: string, cf: CFrame)
	local p = block(props, "CP_" .. id, Vector3.new(4, 1, 4), cf, C.Concrete)
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	tag(p, "FZ_Checkpoint", { CheckpointId = id })
end

local function interactable(part: BasePart, id: string, action: string, object: string, extra: { [string]: any }?)
	local attributes = { InteractId = id, ActionKey = action, ObjectKey = object }
	for key, value in extra or {} do
		attributes[key] = value
	end
	tag(part, "FZ_Interactable", attributes)
end

-- Breaker cabinet on a wall (forecasts are broken by holding the right breaker).
local function breakerBox(cf: CFrame, sector: string, interactId: string)
	local box = block(props, "Breaker" .. sector, Vector3.new(3, 4, 0.8), cf, C.Steel:Lerp(C.Emergency, 0.25), Enum.Material.Metal)
	interactable(box, interactId, "INTERACT_HOLD_BREAKER", "OBJECT_BREAKER_" .. sector, { MaxDistance = 8, Sector = sector })
	return box
end

---------------------------------------------------------------------------
-- Building
---------------------------------------------------------------------------
local function buildShell()
	walls = folder("Walls")
	doors = folder("Doors")
	lights = folder("Lights")
	props = folder("Props")
	local structure = folder("Structure")

	-- Floors
	block(structure, "Floor_West", Vector3.new(50, 1, 170), CFrame.new(-75, -0.5, 0), C.Floor, Enum.Material.Concrete)
	block(structure, "Floor_East", Vector3.new(50, 1, 155), CFrame.new(75, -0.5, -7.5), C.Linoleum, Enum.Material.Plastic)
	block(structure, "Floor_Center", Vector3.new(100, 1, 120), CFrame.new(0, -0.5, 0), C.Floor, Enum.Material.Concrete)
	-- Roofs (separate per block so the shape reads from outside)
	block(structure, "Roof_West", Vector3.new(52, 1.2, 172), CFrame.new(-75, H + 0.6, 0), C.ConcreteDark, Enum.Material.Concrete)
	block(structure, "Roof_East", Vector3.new(52, 1.2, 157), CFrame.new(75, H + 0.6, -7.5), C.ConcreteDark, Enum.Material.Concrete)
	block(structure, "Roof_Center", Vector3.new(100, 1.2, 122), CFrame.new(0, H + 0.6, 0), C.ConcreteDark, Enum.Material.Concrete)

	-- Radome on the roof above the core: the landmark visible from the whole site.
	local radome = block(structure, "Radome", Vector3.new(30, 30, 30), CFrame.new(0, H + 10, 0), Color3.fromRGB(200, 202, 198), Enum.Material.Fabric)
	radome.Shape = Enum.PartType.Ball
	block(structure, "RadomeBase", Vector3.new(24, 4, 24), CFrame.new(0, H + 2.5, 0), C.ConcreteDark, Enum.Material.Concrete)

	-- Outer walls
	wallZ(-85, -100, -50)
	wallZ(-85, 50, 100)
	wallZ(-60, -50, 50)
	wallX(-100, -85, 85)
	wallX(100, -85, 70)
	wallZ(85, -100, -50)
	wallZ(60, -50, 50)
	wallZ(70, 50, 100, { { 75, 8 } }) -- main entrance

	-- West block: C | B | E
	wallZ(-25, -100, -50, { { -75, 6 } })
	wallZ(25, -100, -50, { { -75, 6 } })
	wallX(-50, -85, -25, { { -55, 10 } })
	wallX(-50, -25, 25, { { 0, 18 } })
	wallX(-50, 25, 85, { { 55, 10 } })

	-- East block: D | A | Control
	wallZ(-25, 50, 100, { { 75, 6 } })
	wallZ(25, 50, 100, { { 75, 6 } })
	wallX(50, -85, -25, { { -55, 10 } })
	wallX(50, -25, 25, { { 0, 18 } })
	wallX(50, 25, 70, { { 55, 10 }, { 65, 6 } })
	-- Window from the control room to the dark outside (sill + glass)
	block(walls, "WindowSill", Vector3.new(T, 3.5, 6), CFrame.new(50, 1.75, 65), C.Concrete, Enum.Material.Concrete)
	local window = block(walls, "Window", Vector3.new(0.3, 6.5, 6), CFrame.new(50, 6.75, 65), Color3.fromRGB(150, 170, 175), Enum.Material.Glass)
	window.Transparency = 0.55
	CollectionService:AddTag(window, "FZ_Window")

	-- Halls
	wallZ(-50, -50, 50, { { 0, 18 } })
	wallZ(50, -50, 50, { { 0, 18 } })

	-- Corridors to the core (18 wide = the core openings). The four pockets between
	-- corridors, halls and the core ring are closed off by these walls.
	wallZ(-9, -50, -20)
	wallZ(9, -50, -20)
	wallZ(-9, 20, 50)
	wallZ(9, 20, 50)
	wallX(-9, -50, -20)
	wallX(9, -50, -20)
	wallX(-9, 20, 50)
	wallX(9, 20, 50)

	-- Core: 16-sided ring, radius 22, openings N/E/S/W
	local core = folder("Core")
	local segments = 16
	local radius = 22
	for i = 0, segments - 1 do
		local angle = (i + 0.5) / segments * math.pi * 2
		local onAxis = (i % 4 == 0) or (i % 4 == 3) -- the two segments around each axis
		local glass = i == 2 or i == 10 -- observation glass into the dark gaps behind the core
		local mid = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		local length = 2 * radius * math.tan(math.pi / segments) + 0.4
		if onAxis then
			-- opening (17.5 studs over two segments) with a lintel above
			local y = DOOR_H + (H - DOOR_H) / 2
			block(core, "CoreLintel", Vector3.new(length, H - DOOR_H, T), CFrame.lookAt(mid + Vector3.new(0, y, 0), Vector3.new(0, y, 0)), C.SteelDark, Enum.Material.Metal)
		else
			local segment = block(core, "CoreWall", Vector3.new(length, H, T), CFrame.lookAt(mid + Vector3.new(0, H / 2, 0), Vector3.new(0, H / 2, 0)), C.SteelDark, Enum.Material.Metal)
			if glass then
				segment.Material = Enum.Material.Glass
				segment.Color = Color3.fromRGB(120, 140, 145)
				segment.Transparency = 0.6
				CollectionService:AddTag(segment, "FZ_Window")
			end
		end
	end
	-- The core machine
	local column = block(core, "CoreColumn", Vector3.new(H, 10, 10), CFrame.new(0, H / 2, 0) * CFrame.Angles(0, 0, math.rad(90)), C.Steel, Enum.Material.Metal)
	column.Shape = Enum.PartType.Cylinder
	local ringA = block(core, "CoreRing", Vector3.new(1, 18, 18), CFrame.new(0, 3, 0) * CFrame.Angles(0, 0, math.rad(90)), C.SteelDark, Enum.Material.Metal)
	ringA.Shape = Enum.PartType.Cylinder
	local glow = block(core, "CoreGlow", Vector3.new(0.4, 11, 11), CFrame.new(0, 9, 0) * CFrame.Angles(0, 0, math.rad(90)), C.Emergency, Enum.Material.Neon)
	glow.Shape = Enum.PartType.Cylinder
	glow.CanCollide = false
	tag(glow, "FZ_SectorLight", { Sector = "CORE", OnColor = Color3.fromRGB(150, 210, 255) })
	local coreLight = Instance.new("PointLight")
	coreLight.Range = 30
	coreLight.Brightness = 1.4
	coreLight.Color = C.Emergency
	coreLight.Parent = glow

	local coreConsole = block(core, "CoreConsole", Vector3.new(5, 3.6, 2.4), CFrame.new(0, 1.8, 11), C.SteelDark, Enum.Material.Metal)
	local coreScreen = block(core, "CoreScreen", Vector3.new(4, 1.6, 0.1), CFrame.new(0, 4.4, 10.4) * CFrame.Angles(math.rad(-15), 0, 0), C.Screen, Enum.Material.Neon)
	coreScreen.CanCollide = false
	worldText(coreScreen, Enum.NormalId.Back, nil, "RELAIS 07 · DURCHLAUF 0007", nil, Color3.fromRGB(10, 40, 20))
	interactable(coreConsole, "c1_core", "INTERACT_ACTIVATE", "OBJECT_CORE", { HoldDuration = 3, MaxDistance = 8 })

	-- Core doors: locked until Relay Sector B is restored
	door(Vector3.new(0, 0, -21.6), true, 17.6, true, "B")
	door(Vector3.new(0, 0, 21.6), true, 17.6, true, "B")
	door(Vector3.new(-21.6, 0, 0), false, 17.6, true, "B")
	door(Vector3.new(21.6, 0, 0), false, 17.6, true, "B")

	-- Interior doors between sectors
	door(Vector3.new(-75, 0, -25), true, 6)
	door(Vector3.new(-75, 0, 25), true, 6)
	door(Vector3.new(75, 0, -25), true, 6)
	door(Vector3.new(75, 0, 25), true, 6)

	-- Signs at sector entrances
	-- (signs hang on the hall/corridor side of each lintel, facing the approaching player)
	sign(Vector3.new(-49.35, 12, -55), Vector3.new(1, 0, 0), "SIGN_SECTOR_C")
	sign(Vector3.new(-49.35, 12, 0), Vector3.new(1, 0, 0), "SIGN_SECTOR_B")
	sign(Vector3.new(-49.35, 12, 55), Vector3.new(1, 0, 0), "SIGN_SECTOR_E")
	sign(Vector3.new(49.35, 12, -55), Vector3.new(-1, 0, 0), "SIGN_SECTOR_D")
	sign(Vector3.new(49.35, 12, 0), Vector3.new(-1, 0, 0), "SIGN_SECTOR_A")
	sign(Vector3.new(75, 12, 70.65), Vector3.new(0, 0, 1), "SIGN_CONTROL")
	sign(Vector3.new(0, 12, -22.3), Vector3.new(0, 0, -1), "SIGN_CORE")
	sign(Vector3.new(0, 12, 22.3), Vector3.new(0, 0, 1), "SIGN_CORE")
end

local function furnish()
	-- Control room (start area, x 50..100, z 25..70)
	local cctv = console(CFrame.new(62, 0, 66) * CFrame.Angles(0, math.rad(180), 0))
	CollectionService:AddTag(cctv[2], "FZ_CctvScreen") -- the "future" camera feed
	CollectionService:AddTag(cctv[3], "FZ_CctvText") -- live creature location (cameras powered)

	-- Emergency power panel: the generator only carries two of three systems.
	block(props, "PowerPanel", Vector3.new(0.6, 6, 12), CFrame.new(50.8, 4.5, 38), C.SteelDark, Enum.Material.Metal)
	worldText(block(props, "PowerTitle", Vector3.new(10, 1, 0.1), CFrame.new(51.15, 8.1, 38) * CFrame.Angles(0, math.rad(90), 0), C.Plastic, Enum.Material.SmoothPlastic), Enum.NormalId.Back, "SYS_PANEL")
	for index, system in { "cameras", "halls", "vents" } do
		local z = 34 + (index - 1) * 4
		local lever = block(props, "Lever_" .. system, Vector3.new(0.8, 2.2, 0.8), CFrame.new(51.5, 4.4, z), C.Plastic, Enum.Material.Metal)
		interactable(lever, "c1_power", "INTERACT_SWITCH", "SYS_" .. string.upper(system), { System = system, MaxDistance = 8 })
		local lamp = block(props, "LeverLamp_" .. system, Vector3.new(0.3, 0.5, 0.5), CFrame.new(51.25, 6.4, z), C.ConcreteDark, Enum.Material.Neon)
		lamp:SetAttribute("LeverLamp", system)
		CollectionService:AddTag(lamp, "FZ_LeverLamp")
		local label = block(props, "LeverLabel_" .. system, Vector3.new(0.1, 0.8, 3.4), CFrame.new(51.2, 2.6, z) * CFrame.Angles(0, math.rad(90), 0), C.Plastic, Enum.Material.SmoothPlastic)
		label.Size = Vector3.new(3.4, 0.8, 0.1)
		worldText(label, Enum.NormalId.Back, "SYS_" .. string.upper(system))
	end
	console(CFrame.new(88, 0, 66) * CFrame.Angles(0, math.rad(180), 0))
	console(CFrame.new(96, 0, 40) * CFrame.Angles(0, math.rad(90), 0))
	local terminal = block(props, "ControlTerminal", Vector3.new(4, 3.6, 2.4), CFrame.new(75, 1.8, 38), C.SteelDark, Enum.Material.Metal)
	local screen = block(props, "TerminalScreen", Vector3.new(3.4, 1.5, 0.1), CFrame.new(75, 4.3, 37.2) * CFrame.Angles(math.rad(-15), 0, 0), C.Screen, Enum.Material.Neon)
	screen.CanCollide = false
	worldText(screen, Enum.NormalId.Front, nil, "KERN: OFFLINE  0/3", nil, Color3.fromRGB(10, 40, 20))
	interactable(terminal, "c1_terminal", "INTERACT_ACTIVATE", "OBJECT_CORE", { MaxDistance = 8 })
	desk(CFrame.new(62, 0, 45))
	cabinet(CFrame.new(98, 0, 30))
	lightGrid(50, 100, 25, 70, "CONTROL")
	roomDetail(50, 100, 25, 70, Color3.fromRGB(78, 82, 80))
	serverRack(CFrame.new(97, 0, 50) * CFrame.Angles(0, math.rad(-90), 0))
	serverRack(CFrame.new(97, 0, 46) * CFrame.Angles(0, math.rad(-90), 0))
	deskLamp(CFrame.new(60, 3.15, 44.5))
	papers(CFrame.new(63, 3.16, 45))
	chair(CFrame.new(62, 0, 47.5) * CFrame.Angles(0, math.rad(200), 0))
	-- vending machine with a cold glow
	local vending = block(props, "Vending", Vector3.new(3.4, 7, 2.6), CFrame.new(56, 3.5, 28) * CFrame.Angles(0, math.rad(180), 0), Color3.fromRGB(150, 40, 36), Enum.Material.SmoothPlastic)
	local front = block(props, "VendingFront", Vector3.new(2.6, 4.6, 0.05), vending.CFrame * CFrame.new(-0.2, 0.6, -1.32), Color3.fromRGB(200, 230, 255), Enum.Material.Neon)
	front.Transparency = 0.35
	front.CanCollide = false
	local vendLight = Instance.new("SurfaceLight")
	vendLight.Face = Enum.NormalId.Front
	vendLight.Range = 12
	vendLight.Brightness = 0.9
	vendLight.Color = Color3.fromRGB(190, 220, 255)
	vendLight.Parent = front
	crate(CFrame.new(96, 0, 66) * CFrame.Angles(0, math.rad(12), 0))
	crate(CFrame.new(96.5, 2.4, 66.2) * CFrame.Angles(0, math.rad(-7), 0), 1.8)
	checkpoint("C1_CONTROL", CFrame.new(75, 0.5, 52))

	-- Sector A: administration
	for x = 58, 92, 11 do
		desk(CFrame.new(x, 0, -10))
		desk(CFrame.new(x, 0, 10))
	end
	shelf(CFrame.new(99, 0, -14) * CFrame.Angles(0, math.rad(90), 0))
	cabinet(CFrame.new(98, 0, 18))
	local breaker = block(props, "BreakerA", Vector3.new(3, 4, 0.8), CFrame.new(99.2, 5, 4) * CFrame.Angles(0, math.rad(-90), 0), C.Steel:Lerp(C.Emergency, 0.25), Enum.Material.Metal)
	interactable(breaker, "c1_breaker_a", "INTERACT_HOLD_BREAKER", "OBJECT_BREAKER", { MaxDistance = 8, Sector = "A" })
	breaker:SetAttribute("Armed", false)
	lightGrid(50, 100, -25, 25, "A")
	roomDetail(50, 100, -25, 25, Color3.fromRGB(92, 88, 78))
	for x = 58, 91, 11 do
		deskLamp(CFrame.new(x - 2, 3.15, -10.5))
		papers(CFrame.new(x + 0.5, 3.16, 9.5))
		chair(CFrame.new(x, 0, -12.6))
		chair(CFrame.new(x, 0, 12.6) * CFrame.Angles(0, math.rad(180), 0))
	end
	emergencyLight(Vector3.new(99, 11, -20), "A")
	fuseSpot(CFrame.new(91, 3.45, 10), "A")
	fuseSpot(CFrame.new(58, 3.45, -10), "A")

	-- Sector D: quarters
	for z = -78, -38, 13 do
		bunk(CFrame.new(60, 0, z))
		bunk(CFrame.new(93, 0, z))
	end
	for z = -80, -60, 3 do
		locker(CFrame.new(75 + (z % 2), 0, z) * CFrame.Angles(0, math.rad(90), 0))
	end
	lightGrid(50, 100, -85, -25, "D", Color3.fromRGB(255, 214, 170))
	roomDetail(50, 100, -85, -25, Color3.fromRGB(70, 74, 66))
	deskLamp(CFrame.new(89.2, 3.0, -30.6))
	breakerBox(CFrame.new(99.2, 5, -30) * CFrame.Angles(0, math.rad(-90), 0), "D", "breaker")
	-- Break room corner: coffee still warm, calendar on November 2009 (document)
	local table_ = block(props, "CoffeeTable", Vector3.new(4, 3, 3), CFrame.new(90, 1.5, -30), C.Wood, Enum.Material.Wood)
	local mug = block(props, "Mug", Vector3.new(0.5, 0.6, 0.5), table_.CFrame * CFrame.new(0.8, 1.8, 0), C.Plastic, Enum.Material.SmoothPlastic)
	mug.Shape = Enum.PartType.Cylinder
	mug.CFrame = table_.CFrame * CFrame.new(0.8, 1.8, 0) * CFrame.Angles(0, 0, math.rad(90))
	local calendar = block(props, "Calendar", Vector3.new(2, 2.6, 0.1), CFrame.new(99.4, 6, -36) * CFrame.Angles(0, math.rad(-90), 0), C.Paper, Enum.Material.SmoothPlastic)
	worldText(calendar, Enum.NormalId.Front, nil, "NOV 2009\n14", nil, Color3.fromRGB(140, 30, 24))
	interactable(calendar, "lore", "INTERACT_READ", "OBJECT_CALENDAR", { MaxDistance = 7, LogId = "calendar_2009" })
	fuseSpot(CFrame.new(93, 5.8, -65), "D")
	fuseSpot(CFrame.new(60, 2.2, -39), "D")

	-- Sector C: research / archive
	for z = -80, -35, 11 do
		shelf(CFrame.new(-90, 0, z) * CFrame.Angles(0, math.rad(90), 0))
		shelf(CFrame.new(-74, 0, z) * CFrame.Angles(0, math.rad(90), 0))
	end
	desk(CFrame.new(-60, 0, -40))
	lightGrid(-100, -50, -85, -25, "C", Color3.fromRGB(235, 225, 200))
	roomDetail(-100, -50, -85, -25, Color3.fromRGB(84, 74, 58))
	deskLamp(CFrame.new(-58, 3.15, -39.5))
	papers(CFrame.new(-61.5, 3.16, -40.5))
	for i = 0, 4 do
		crate(CFrame.new(-56 + (i % 2) * 2.6, 0, -82 + i * 0.4) * CFrame.Angles(0, math.rad(i * 9), 0), 2.2)
	end
	breakerBox(CFrame.new(-99.2, 5, -45) * CFrame.Angles(0, math.rad(90), 0), "C", "breaker")
	fuseSpot(CFrame.new(-60, 3.45, -40), "C")
	fuseSpot(CFrame.new(-82, 0.4, -82), "C")

	-- Sector B: laboratories + Relay panel (starts without power)
	for z = -15, 15, 10 do
		labTable(CFrame.new(-86, 0, z))
		labTable(CFrame.new(-68, 0, z))
	end
	local relay = block(props, "RelayPanelB", Vector3.new(0.8, 7, 6), CFrame.new(-99.2, 4.5, 0), C.Steel, Enum.Material.Metal)
	local relayLamp = block(props, "RelayLampB", Vector3.new(0.3, 0.8, 4), CFrame.new(-98.7, 8.6, 0), C.Emergency, Enum.Material.Neon)
	relayLamp.CanCollide = false
	tag(relayLamp, "FZ_SectorLight", { Sector = "B", OnColor = C.Screen })
	interactable(relay, "c1_relay_b", "INTERACT_INSERT", "OBJECT_RELAY_B", { HoldDuration = 4, MaxDistance = 8 })
	lightGrid(-100, -50, -25, 25, "B", Color3.fromRGB(210, 240, 235))
	roomDetail(-100, -50, -25, 25, Color3.fromRGB(196, 200, 196))
	serverRack(CFrame.new(-97, 0, -20) * CFrame.Angles(0, math.rad(90), 0))
	emergencyLight(Vector3.new(-51.5, 9, 8), "B")

	-- Sector E: engineering
	local gen = generator(CFrame.new(-80, 0, 70))
	local gen2 = generator(CFrame.new(-80, 0, 45))
	gen:SetAttribute("SoundLoop", "generator_loop")
	CollectionService:AddTag(gen, "FZ_AmbientSource")
	-- Generators are survival objectives (restart them); chapter 1 ignores them.
	for index, g in { gen, gen2 } do
		interactable(g, "generator", "INTERACT_RESTART", "OBJECT_GENERATOR", { HoldDuration = 3, MaxDistance = 9, GeneratorId = index })
	end
	pipeRun(Vector3.new(-98, 12, 30), Vector3.new(-98, 12, 84))
	pipeRun(Vector3.new(-60, 12.5, 30), Vector3.new(-60, 12.5, 84), 0.9)
	lightGrid(-100, -50, 25, 85, "E", C.Sodium)
	roomDetail(-100, -50, 25, 85, nil)
	for i = 0, 3 do
		crate(CFrame.new(-56, 0, 40 + i * 3) * CFrame.Angles(0, math.rad(i * 13), 0))
	end
	-- warning floor markings around the generators
	for _, z in { 45, 70 } do
		for _, dz in { -3.4, 3.4 } do
			local stripe = block(props, "Hazard", Vector3.new(10, 0.05, 0.5), CFrame.new(-80, 0.03, z + dz), Color3.fromRGB(214, 170, 40), Enum.Material.SmoothPlastic)
			stripe.CanCollide = false
		end
	end
	breakerBox(CFrame.new(-99.2, 5, 35) * CFrame.Angles(0, math.rad(90), 0), "E", "breaker")
	fuseSpot(CFrame.new(-66, 0.4, 82), "E")
	fuseSpot(CFrame.new(-95, 0.4, 56), "E")

	-- Halls and corridors: emergency lighting only (readable, tense)
	for x = -40, 40, 20 do
		emergencyLight(Vector3.new(x, 12, -59), "HALL")
		emergencyLight(Vector3.new(x, 12, 59), "HALL")
	end
	for x = -35, 35, 35 do
		ceilingLight(Vector3.new(x, 0, -55), "HALLS", nil, false, true)
		ceilingLight(Vector3.new(x, 0, 55), "HALLS", nil, false, true)
	end
	roomDetail(-50, 50, -60, -50, nil)
	roomDetail(-50, 50, 50, 60, nil)
	roomDetail(-9, 9, -50, -21, nil)
	roomDetail(-9, 9, 21, 50, nil)
	roomDetail(-50, -21, -9, 9, nil)
	roomDetail(21, 50, -9, 9, nil)
	-- core: a cold ring of light around the machine
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local p = Vector3.new(math.cos(a) * 15, 0, math.sin(a) * 15)
		local spot = block(props, "CoreFloorLight", Vector3.new(1.2, 0.2, 1.2), CFrame.new(p.X, 0.1, p.Z), Color3.fromRGB(120, 180, 220), Enum.Material.Neon)
		spot.CanCollide = false
		local up = Instance.new("SpotLight")
		up.Face = Enum.NormalId.Top
		up.Range = 18
		up.Angle = 60
		up.Brightness = 1.2
		up.Color = Color3.fromRGB(140, 190, 230)
		up.Parent = spot
		CollectionService:AddTag(spot, "FZ_KeyLight")
	end
	pipeRun(Vector3.new(-50, 13, -51), Vector3.new(50, 13, -51))
	pipeRun(Vector3.new(-50, 13, 51), Vector3.new(50, 13, 51))
	for _, p in { Vector3.new(0, 12, -36), Vector3.new(0, 12, 36), Vector3.new(-36, 12, 0), Vector3.new(36, 12, 0) } do
		emergencyLight(p + Vector3.new(if p.X == 0 then 8.3 else 0, 0, if p.X == 0 then 0 else 8.3), "HALL")
	end
	checkpoint("C1_CORE", CFrame.new(0, 0.5, 40))

	-- Vents (creature shortcuts, always announced by a rattle)
	vent(Vector3.new(99.3, 1.5, -40), Vector3.new(-1, 0, 0), "east")
	vent(Vector3.new(99.3, 1.5, 15), Vector3.new(-1, 0, 0), "east")
	vent(Vector3.new(-99.3, 1.5, -60), Vector3.new(1, 0, 0), "west")
	vent(Vector3.new(-99.3, 1.5, 70), Vector3.new(1, 0, 0), "west")
	vent(Vector3.new(-20, 1.5, -59.3), Vector3.new(0, 0, 1), "hall")
	vent(Vector3.new(20, 1.5, 59.3), Vector3.new(0, 0, -1), "hall")

	-- Patrol graph: one node per space
	for _, node in {
		{ Vector3.new(75, 0, -55), "D" }, { Vector3.new(75, 0, 0), "A" }, { Vector3.new(75, 0, 45), "CONTROL" },
		{ Vector3.new(-75, 0, -55), "C" }, { Vector3.new(-75, 0, 0), "B" }, { Vector3.new(-75, 0, 55), "E" },
		{ Vector3.new(-30, 0, -55), "HALL" }, { Vector3.new(30, 0, -55), "HALL" },
		{ Vector3.new(-30, 0, 55), "HALL" }, { Vector3.new(30, 0, 55), "HALL" },
		{ Vector3.new(0, 0, -36), "HALL" }, { Vector3.new(0, 0, 36), "HALL" },
		{ Vector3.new(-36, 0, 0), "HALL" }, { Vector3.new(36, 0, 0), "HALL" },
	} do
		patrol(node[1], node[2])
	end

	-- Supernatural photographs (EvidenceService decides what they show)
	for _, ph in {
		{ "photo_past_self", "past_self", CFrame.new(80, 3.2, -10) }, -- administration desk
		{ "photo_team_future", "team_future", CFrame.new(-60, 3.2, -41.2) }, -- research desk
		{ "photo_mate_dark", "mate_dark", CFrame.new(93, 2.05, -52) }, -- quarters, on a bunk
	} do
		local frame = block(props, "Photo", Vector3.new(1.2, 0.05, 0.9), ph[3] * CFrame.Angles(0, math.random() * 0.6 - 0.3, 0), C.Paper, Enum.Material.SmoothPlastic)
		frame.CanCollide = false
		interactable(frame, "photo", "INTERACT_LOOK", "OBJECT_PHOTO", { MaxDistance = 7, PhotoId = ph[1], Kind = ph[2] })
	end

	-- First-aid cabinets (medkits for reviving teammates)
	for _, cab in {
		{ CFrame.new(99.3, 5, 62) * CFrame.Angles(0, math.rad(-90), 0) }, -- control room: security station
		{ CFrame.new(-99.3, 5, 18) * CFrame.Angles(0, math.rad(90), 0) }, -- laboratories: medical corner
		{ CFrame.new(-99.3, 5, 78) * CFrame.Angles(0, math.rad(90), 0) }, -- engineering: supply depot
		{ CFrame.new(99.3, 5, -80) * CFrame.Angles(0, math.rad(-90), 0) }, -- quarters
	} do
		local cabinet = block(props, "FirstAid", Vector3.new(2.6, 3.2, 0.9), cab[1], Color3.fromRGB(226, 224, 216), Enum.Material.SmoothPlastic)
		local crossV = block(props, "Cross", Vector3.new(0.4, 1.4, 0.05), cabinet.CFrame * CFrame.new(0, 0.2, -0.47), Color3.fromRGB(190, 40, 34), Enum.Material.Neon)
		local crossH = block(props, "Cross", Vector3.new(1.4, 0.4, 0.05), cabinet.CFrame * CFrame.new(0, 0.2, -0.47), Color3.fromRGB(190, 40, 34), Enum.Material.Neon)
		crossV.CanCollide = false
		crossH.CanCollide = false
		interactable(cabinet, "medcabinet", "INTERACT_TAKE_MEDKIT", "OBJECT_MEDCABINET", { MaxDistance = 7 })
		CollectionService:AddTag(cabinet, "FZ_MedCabinet")
	end

	-- PA loudspeakers (the station sometimes speaks with a voice nobody recognises)
	for _, sp in {
		{ Vector3.new(0, 12.5, -59.2), Vector3.new(0, 0, 1) }, { Vector3.new(0, 12.5, 59.2), Vector3.new(0, 0, -1) },
		{ Vector3.new(-49.2, 12.5, 20), Vector3.new(1, 0, 0) }, { Vector3.new(99.2, 12.5, 50), Vector3.new(-1, 0, 0) },
		{ Vector3.new(-99.2, 12.5, -10), Vector3.new(1, 0, 0) },
	} do
		local speaker = block(props, "Speaker", Vector3.new(1.4, 1.4, 1.6), CFrame.lookAt(sp[1], sp[1] + sp[2]), C.SteelDark, Enum.Material.Metal)
		speaker.CanCollide = false
		CollectionService:AddTag(speaker, "FZ_Speaker")
	end

	-- Hidden finds (ghost logs): tape recorders with a note
	for _, find in {
		{ "log_okafor", CFrame.new(-62, 0.6, -80) },
		{ "log_venn", CFrame.new(-86, 3.6, -15) },
		{ "log_ehle", CFrame.new(-60, 0.6, 30) },
		{ "log_0006", CFrame.new(-8, 0.6, 8) },
	} do
		local recorder = block(props, "Recorder", Vector3.new(1.4, 0.6, 1), find[2], Color3.fromRGB(48, 44, 40), Enum.Material.SmoothPlastic)
		local reel = block(props, "Reel", Vector3.new(0.1, 0.5, 0.5), find[2] * CFrame.new(0, 0.35, 0) * CFrame.Angles(0, 0, math.rad(90)), C.Plastic, Enum.Material.SmoothPlastic)
		reel.Shape = Enum.PartType.Cylinder
		reel.CanCollide = false
		local led = Instance.new("PointLight")
		led.Range = 3
		led.Brightness = 0.6
		led.Color = Color3.fromRGB(255, 120, 60)
		led.Parent = recorder
		interactable(recorder, "lore", "INTERACT_LISTEN", "OBJECT_RECORDER", { MaxDistance = 7, LogId = find[1] })
	end

	-- Item spots (bandages / syringes are placed at random spots per session)
	for _, cf in {
		CFrame.new(69, 3.45, -10), CFrame.new(80, 3.45, 10), CFrame.new(57.2, 2.2, -52), CFrame.new(-60, 3.45, -40.8),
		CFrame.new(-86, 3.4, 5), CFrame.new(-68, 3.4, -15), CFrame.new(-90, 0.4, 82), CFrame.new(62, 3.45, 45),
		CFrame.new(-30, 0.4, -58), CFrame.new(30, 0.4, 58), CFrame.new(4, 0.4, -16), CFrame.new(90, 3.2, -30),
	} do
		local spot = block(props, "ItemSpot", Vector3.new(1, 1, 1), cf, C.Concrete)
		spot.Transparency = 1
		spot.CanCollide = false
		spot.CanQuery = false
		CollectionService:AddTag(spot, "FZ_ItemSpot")
	end

	local spawn = block(props, "CreatureSpawn", Vector3.new(2, 1, 2), CFrame.new(-80, 3, -78), C.Concrete)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.CanQuery = false
	CollectionService:AddTag(spawn, "FZ_CreatureSpawn")
end

---------------------------------------------------------------------------
-- Outside: terrain, road, fence, gatehouse, antenna, forest
---------------------------------------------------------------------------
local function tree(parent: Instance, position: Vector3, scale: number)
	local height = 30 * scale
	local model = Instance.new("Model")
	model.Name = "Pine"
	model.Parent = parent
	local trunk = block(model, "Trunk", Vector3.new(height, 1.3 * scale, 1.3 * scale), CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), C.Bark, Enum.Material.Wood)
	trunk.Shape = Enum.PartType.Cylinder
	local tint = rng:NextNumber(-0.12, 0.12)
	local needleColor = Color3.new(math.clamp(C.Pine.R + tint * 0.3, 0, 1), math.clamp(C.Pine.G + tint * 0.4, 0, 1), math.clamp(C.Pine.B + tint * 0.3, 0, 1))
	local layers = 6
	for i = 0, layers - 1 do
		local t = i / (layers - 1)
		local radius = (7.5 - t * 5.8) * scale
		local y = height * (0.28 + t * 0.66)
		-- each layer: a flat wide disc that tapers - reads as a conifer silhouette
		local layer = block(model, "Needles", Vector3.new(1, 1, 1), CFrame.new(position + Vector3.new(0, y, 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), needleColor, Enum.Material.Grass)
		layer.CanCollide = false
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = Vector3.new(radius * 2, 4.2 * scale, radius * 2)
		mesh.Parent = layer
	end
end

local function rock(parent: Instance, position: Vector3, size: number)
	local stone = block(parent, "Rock", Vector3.new(size * 1.4, size * 0.8, size), CFrame.new(position + Vector3.new(0, size * 0.25, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3)), Color3.fromRGB(88, 88, 84), Enum.Material.Slate)
	return stone
end

local function container(parent: Instance, cf: CFrame, color: Color3)
	local box = block(parent, "Container", Vector3.new(8, 8.6, 20), cf * CFrame.new(0, 4.3, 0), color, Enum.Material.CorrodedMetal)
	for i = -4, 4 do
		local rib = block(parent, "ContainerRib", Vector3.new(8.2, 8.2, 0.3), box.CFrame * CFrame.new(0, 0, i * 2.2), color:Lerp(Color3.new(0, 0, 0), 0.25), Enum.Material.CorrodedMetal)
		rib.CanCollide = false
	end
	return box
end

local function aviationLight(parent: Instance, position: Vector3)
	local bulb = block(parent, "AviationLight", Vector3.new(0.8, 0.8, 0.8), CFrame.new(position), C.Emergency, Enum.Material.Neon)
	bulb.Shape = Enum.PartType.Ball
	bulb.CanCollide = false
	local light = Instance.new("PointLight")
	light.Range = 14
	light.Brightness = 1.6
	light.Color = C.Emergency
	light.Parent = bulb
	CollectionService:AddTag(bulb, "FZ_Beacon")
	return bulb
end

-- Facade, roof and yard detail: what you see on the walk from the gate to the door.
exteriorDetail = function(outside: Instance)
	local facade = Instance.new("Folder")
	facade.Name = "Facade"
	facade.Parent = outside
	-- plinth and roof edge around every outer wall
	local outline = {
		{ Vector3.new(-100, 0, -85), Vector3.new(100, 0, -85) },
		{ Vector3.new(100, 0, -85), Vector3.new(100, 0, 70) },
		{ Vector3.new(100, 0, 70), Vector3.new(50, 0, 70) },
		{ Vector3.new(50, 0, 60), Vector3.new(-50, 0, 60) },
		{ Vector3.new(-50, 0, 85), Vector3.new(-100, 0, 85) },
		{ Vector3.new(-100, 0, 85), Vector3.new(-100, 0, -85) },
	}
	for _, edge in outline do
		local a, b = edge[1], edge[2]
		local mid = (a + b) / 2
		local length = (b - a).Magnitude + 1
		local outward = (mid - Vector3.new(0, 0, 0)) * Vector3.new(1, 0, 1)
		local dir = (b - a).Unit
		local normal = Vector3.new(-dir.Z, 0, dir.X)
		if normal:Dot(outward) < 0 then
			normal = -normal
		end
		local base = CFrame.lookAt(mid, mid + dir)
		block(facade, "Plinth", Vector3.new(0.6, 1.6, length), base * CFrame.new(0, 0.8, 0) + normal * 0.75, C.ConcreteDark, Enum.Material.Concrete)
		block(facade, "Parapet", Vector3.new(1.2, 2.2, length), base * CFrame.new(0, H + 2.3, 0) + normal * 0.1, C.Concrete, Enum.Material.Concrete)
		block(facade, "Coping", Vector3.new(1.6, 0.25, length), base * CFrame.new(0, H + 3.5, 0) + normal * 0.1, C.SteelDark, Enum.Material.Metal)
		-- high slit windows: a few are lit from inside, the rest are dark glass
		local count = math.floor(length / 14)
		for i = 1, count do
			local t = (i - 0.5) / count
			local p = a:Lerp(b, t) + normal * 0.62 + Vector3.new(0, H - 3.4, 0)
			local lit = rng:NextNumber() < 0.28
			local pane = block(facade, "FacadeWindow", Vector3.new(0.12, 1.8, 5), CFrame.lookAt(p, p + dir), if lit then Color3.fromRGB(255, 214, 150) else Color3.fromRGB(26, 34, 40), if lit then Enum.Material.Neon else Enum.Material.Glass)
			pane.CanCollide = false
			if lit then
				pane.Transparency = 0.15
			else
				pane.Reflectance = 0.15
			end
			block(facade, "FacadeWindowFrame", Vector3.new(0.3, 0.3, 5.4), CFrame.lookAt(p - Vector3.new(0, 1.05, 0), p - Vector3.new(0, 1.05, 0) + dir), C.SteelDark, Enum.Material.Metal)
		end
	end
	-- vertical concrete pilasters along the long walls
	for z = -80, 65, 16 do
		block(facade, "Pilaster", Vector3.new(1.2, H, 2), CFrame.new(100.9, H / 2, z), C.ConcreteDark, Enum.Material.Concrete)
	end
	for z = -80, 80, 16 do
		block(facade, "Pilaster", Vector3.new(1.2, H, 2), CFrame.new(-100.9, H / 2, z), C.ConcreteDark, Enum.Material.Concrete)
	end

	-- entrance canopy with a lamp over the door (x 75, z 70)
	block(facade, "Canopy", Vector3.new(16, 0.6, 7), CFrame.new(75, DOOR_H + 0.8, 73.6), C.SteelDark, Enum.Material.Metal)
	for _, dx in { -7.4, 7.4 } do
		block(facade, "CanopyPost", Vector3.new(0.5, DOOR_H + 0.6, 0.5), CFrame.new(75 + dx, (DOOR_H + 0.6) / 2, 76.8), C.SteelDark, Enum.Material.Metal)
	end
	local canopyLamp = block(facade, "CanopyLamp", Vector3.new(4, 0.2, 1), CFrame.new(75, DOOR_H + 0.4, 73.6), Color3.fromRGB(230, 240, 255), Enum.Material.Neon)
	canopyLamp.CanCollide = false
	local canopyLight = Instance.new("SpotLight")
	canopyLight.Face = Enum.NormalId.Bottom
	canopyLight.Range = 22
	canopyLight.Angle = 120
	canopyLight.Brightness = 2.2
	canopyLight.Color = Color3.fromRGB(220, 232, 255)
	canopyLight.Shadows = true
	canopyLight.Parent = canopyLamp
	CollectionService:AddTag(canopyLamp, "FZ_KeyLight")
	for i = 0, 2 do
		block(facade, "Step", Vector3.new(12 - i, 0.3, 1.2), CFrame.new(75, 0.15 + i * 0.0, 71.4 + i * 1.2 - 0.6), C.Concrete, Enum.Material.Concrete)
	end

	-- roof: AC units, vents, cable trays, aviation lights at the corners
	local roof = Instance.new("Folder")
	roof.Name = "Roof"
	roof.Parent = outside
	for _, p in { Vector3.new(-80, 0, -60), Vector3.new(-72, 0, 40), Vector3.new(70, 0, -50), Vector3.new(84, 0, 10), Vector3.new(30, 0, -40), Vector3.new(-32, 0, 38) } do
		local unit = block(roof, "ACUnit", Vector3.new(6, 3.2, 4.4), CFrame.new(p.X, H + 2.8, p.Z), Color3.fromRGB(150, 152, 148), Enum.Material.Metal)
		local fan = block(roof, "ACFan", Vector3.new(0.2, 3.4, 3.4), unit.CFrame * CFrame.new(0, 1.65, 0) * CFrame.Angles(0, 0, math.rad(90)), C.SteelDark, Enum.Material.DiamondPlate)
		fan.Shape = Enum.PartType.Cylinder
		fan.CanCollide = false
	end
	for _, p in { Vector3.new(-99, H + 3.9, -84), Vector3.new(99, H + 3.9, -84), Vector3.new(-99, H + 3.9, 84), Vector3.new(99, H + 3.9, 69) } do
		aviationLight(roof, p)
	end
	local mast = block(roof, "RoofMast", Vector3.new(0.6, 16, 0.6), CFrame.new(88, H + 9, -70), C.SteelDark, Enum.Material.Metal)
	aviationLight(roof, mast.CFrame.Position + Vector3.new(0, 8.4, 0))
	block(roof, "MastDish", Vector3.new(0.6, 5, 5), CFrame.new(88, H + 12, -68.4) * CFrame.Angles(0, math.rad(-70), math.rad(-15)), C.Plastic, Enum.Material.Metal).Shape = Enum.PartType.Cylinder

	-- yard props: containers, barrels, pallets, rocks, road markings
	local yard = Instance.new("Folder")
	yard.Name = "Yard"
	yard.Parent = outside
	container(yard, CFrame.new(118, 0, 110) * CFrame.Angles(0, math.rad(4), 0), Color3.fromRGB(120, 56, 40))
	container(yard, CFrame.new(118, 0, 132) * CFrame.Angles(0, math.rad(-3), 0), Color3.fromRGB(44, 74, 96))
	container(yard, CFrame.new(118, 8.6, 121) * CFrame.Angles(0, math.rad(1), 0), Color3.fromRGB(70, 90, 60))
	for i = 0, 5 do
		local barrel = block(yard, "Barrel", Vector3.new(4, 2.6, 2.6), CFrame.new(24 + (i % 3) * 2.8, 2, 126 + math.floor(i / 3) * 2.8) * CFrame.Angles(0, 0, math.rad(90)), if i % 2 == 0 then Color3.fromRGB(150, 60, 34) else Color3.fromRGB(40, 70, 110), Enum.Material.CorrodedMetal)
		barrel.Shape = Enum.PartType.Cylinder
	end
	for i = 0, 3 do
		block(yard, "Pallet", Vector3.new(4, 0.6, 4), CFrame.new(10, 0.3 + i * 0.62, 118) * CFrame.Angles(0, math.rad(i * 6), 0), C.Wood, Enum.Material.WoodPlanks)
	end
	for z = 150, 236, 8 do
		local mark = block(yard, "RoadMark", Vector3.new(0.4, 0.05, 4), CFrame.new(75, 0.06, z), Color3.fromRGB(210, 206, 190), Enum.Material.SmoothPlastic)
		mark.CanCollide = false
	end
	for z = 250, 420, 8 do
		local mark = block(yard, "RoadMark", Vector3.new(0.4, 0.05, 4), CFrame.new(75, 0.06, z), Color3.fromRGB(210, 206, 190), Enum.Material.SmoothPlastic)
		mark.CanCollide = false
	end
	-- gate barrier arm (raised, red/white)
	block(yard, "BarrierBox", Vector3.new(1.4, 3.6, 1.4), CFrame.new(87, 1.8, 243), Color3.fromRGB(200, 170, 40), Enum.Material.Metal)
	for i = 0, 5 do
		local seg = block(yard, "BarrierArm", Vector3.new(0.5, 2.4, 0.5), CFrame.new(87, 3.6, 243) * CFrame.Angles(0, 0, math.rad(78)) * CFrame.new(0, 1.2 + i * 2.4, 0), if i % 2 == 0 then Color3.fromRGB(200, 40, 34) else Color3.fromRGB(230, 230, 225), Enum.Material.SmoothPlastic)
		seg.CanCollide = false
	end
	-- warning sign at the gate
	local warn = block(yard, "WarningSign", Vector3.new(4, 3, 0.2), CFrame.new(64, 5.5, 241), Color3.fromRGB(220, 180, 40), Enum.Material.SmoothPlastic)
	worldText(warn, Enum.NormalId.Back, nil, "⚠  ZUTRITT VERBOTEN\nRESTRICTED AREA", nil, Color3.fromRGB(20, 20, 20))
	block(yard, "WarningPost", Vector3.new(0.3, 5, 0.3), CFrame.new(64, 2.5, 241.3), C.SteelDark, Enum.Material.Metal)
	-- rocks scattered around the compound edge
	for _ = 1, 40 do
		local x = rng:NextNumber(-200, 220)
		local z = rng:NextNumber(-180, 320)
		local nearRoad = math.abs(x - 75) < 14 and z > 80
		local inside = x > -105 and x < 105 and z > -90 and z < 90
		if not nearRoad and not inside then
			rock(yard, Vector3.new(x, 0, z), rng:NextNumber(1.5, 5))
		end
	end
end

local function lampPost(parent: Instance, position: Vector3, facing: Vector3)
	local post = block(parent, "LampPost", Vector3.new(0.5, 14, 0.5), CFrame.new(position + Vector3.new(0, 7, 0)), C.SteelDark, Enum.Material.Metal)
	local head = block(parent, "LampHead", Vector3.new(2, 0.5, 1), CFrame.lookAt(post.CFrame.Position + Vector3.new(0, 7, 0), post.CFrame.Position + Vector3.new(0, 7, 0) + facing) * CFrame.new(0, 0, -1), C.Sodium, Enum.Material.Neon)
	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Bottom
	light.Angle = 110
	light.Range = 36
	light.Brightness = 2.4
	light.Color = C.Sodium
	light.Shadows = true
	light.Parent = head
	CollectionService:AddTag(head, "FZ_KeyLight")
end

local function buildOutside()
	local outside = folder("Outside")

	-- Edit-mode stand-in for the terrain ground (terrain is filled at runtime by BuildTerrain,
	-- which removes this part). Lets you see the site in Studio without pressing Play.
	local preview = block(outside, "EditPreviewGround", Vector3.new(900, 1, 900), CFrame.new(0, -0.62, 80), Color3.fromRGB(46, 58, 40), Enum.Material.Grass)
	preview:SetAttribute("FZ_EditPreview", true)
	exteriorDetail(outside)

	-- Yard and road (main entrance at x 75, z 70 -> gate at z 240)
	block(outside, "Yard", Vector3.new(120, 1, 60), CFrame.new(40, -0.45, 100), C.Asphalt, Enum.Material.Asphalt)
	block(outside, "Road", Vector3.new(16, 1, 140), CFrame.new(75, -0.45, 200), C.Asphalt, Enum.Material.Asphalt)
	block(outside, "RoadOut", Vector3.new(16, 1, 160), CFrame.new(75, -0.45, 350), C.Asphalt, Enum.Material.Asphalt)
	for z = 110, 230, 40 do
		lampPost(outside, Vector3.new(86, 0, z), Vector3.new(-1, 0, 0))
	end
	lampPost(outside, Vector3.new(40, 0, 82), Vector3.new(0, 0, 1))
	-- Parked service van (silhouette)
	block(outside, "Van", Vector3.new(7, 7, 15), CFrame.new(58, 3.6, 120) * CFrame.Angles(0, math.rad(8), 0), Color3.fromRGB(150, 150, 140), Enum.Material.Metal)

	-- Perimeter fence with gate gap
	local fence = Instance.new("Folder")
	fence.Name = "Fence"
	fence.Parent = outside
	local function fenceLine(a: Vector3, b: Vector3)
		local length = (b - a).Magnitude
		local count = math.max(1, math.floor(length / 12))
		for i = 0, count do
			local p = a:Lerp(b, i / count)
			block(fence, "Post", Vector3.new(0.4, 9, 0.4), CFrame.new(p + Vector3.new(0, 4.5, 0)), C.SteelDark, Enum.Material.Metal)
		end
		for _, y in { 0.6, 8.6 } do
			local rail = block(fence, "Rail", Vector3.new(0.25, 0.25, length), CFrame.lookAt((a + b) / 2 + Vector3.new(0, y, 0), b + Vector3.new(0, y, 0)), C.SteelDark, Enum.Material.Metal)
			rail.CanCollide = false
		end
		for _, side in { -0.35, 0.35 } do
			local wire = block(fence, "BarbedWire", Vector3.new(0.12, 0.12, length), CFrame.lookAt((a + b) / 2 + Vector3.new(0, 9.4, 0), b + Vector3.new(0, 9.4, 0)) * CFrame.new(side, 0, 0), C.Steel, Enum.Material.Metal)
			wire.CanCollide = false
		end
		local mesh = block(fence, "Mesh", Vector3.new(0.1, 8, length), CFrame.lookAt((a + b) / 2 + Vector3.new(0, 4.6, 0), b + Vector3.new(0, 4.6, 0)), C.Steel, Enum.Material.DiamondPlate)
		mesh.Transparency = 0.75
	end
	fenceLine(Vector3.new(-130, 0, -110), Vector3.new(150, 0, -110))
	fenceLine(Vector3.new(150, 0, -110), Vector3.new(150, 0, 240))
	fenceLine(Vector3.new(150, 0, 240), Vector3.new(84, 0, 240))
	fenceLine(Vector3.new(66, 0, 240), Vector3.new(-130, 0, 240))
	fenceLine(Vector3.new(-130, 0, 240), Vector3.new(-130, 0, -110))

	-- Gate + gatehouse (opening sequence: fax, logbook code, maintenance note)
	block(outside, "GatePillarL", Vector3.new(2, 10, 2), CFrame.new(65, 5, 240), C.Concrete, Enum.Material.Concrete)
	block(outside, "GatePillarR", Vector3.new(2, 10, 2), CFrame.new(85, 5, 240), C.Concrete, Enum.Material.Concrete)
	local stationSign = block(outside, "StationSign", Vector3.new(14, 3, 0.3), CFrame.new(75, 8.5, 240.6), C.Plastic, Enum.Material.SmoothPlastic)
	worldText(stationSign, Enum.NormalId.Back, "SIGN_STATION")

	local gx, gz = 100, 232
	local gh = Instance.new("Model")
	gh.Name = "Gatehouse"
	gh.Parent = outside
	block(gh, "Floor", Vector3.new(14, 0.4, 12), CFrame.new(gx, 0.2, gz), C.Linoleum, Enum.Material.Plastic)
	block(gh, "Roof", Vector3.new(15, 0.6, 13), CFrame.new(gx, 9.3, gz), C.ConcreteDark, Enum.Material.Concrete)
	block(gh, "WallN", Vector3.new(14, 9, 0.6), CFrame.new(gx, 4.5, gz - 6), C.Concrete, Enum.Material.Concrete)
	block(gh, "WallE", Vector3.new(0.6, 9, 12), CFrame.new(gx + 7, 4.5, gz), C.Concrete, Enum.Material.Concrete)
	block(gh, "WallS", Vector3.new(14, 9, 0.6), CFrame.new(gx, 4.5, gz + 6), C.Concrete, Enum.Material.Concrete)
	block(gh, "WallW_A", Vector3.new(0.6, 9, 4), CFrame.new(gx - 7, 4.5, gz - 4), C.Concrete, Enum.Material.Concrete)
	block(gh, "WallW_B", Vector3.new(0.6, 9, 4), CFrame.new(gx - 7, 4.5, gz + 4), C.Concrete, Enum.Material.Concrete)
	block(gh, "WallW_Top", Vector3.new(0.6, 2, 4), CFrame.new(gx - 7, 8, gz), C.Concrete, Enum.Material.Concrete)
	local lamp = block(gh, "CeilingLamp", Vector3.new(3, 0.2, 0.8), CFrame.new(gx, 8.9, gz), Color3.fromRGB(255, 214, 160), Enum.Material.Neon)
	local lampLight = Instance.new("PointLight")
	lampLight.Range = 16
	lampLight.Brightness = 0.9
	lampLight.Color = Color3.fromRGB(255, 206, 150)
	lampLight.Shadows = true
	lampLight.Parent = lamp
	CollectionService:AddTag(lamp, "FZ_KeyLight")
	local deskTop = block(gh, "Desk", Vector3.new(2.6, 3, 7), CFrame.new(gx + 5, 1.9, gz), C.Wood, Enum.Material.Wood)
	local fax = block(gh, "Fax", Vector3.new(1.2, 0.6, 1.6), deskTop.CFrame * CFrame.new(0, 1.8, -1.6), C.Plastic, Enum.Material.SmoothPlastic)
	interactable(fax, "c1_fax", "INTERACT_READ", "OBJECT_FAX", { MaxDistance = 7 })
	local faxLed = Instance.new("PointLight")
	faxLed.Range = 3
	faxLed.Brightness = 1.5
	faxLed.Color = Color3.fromRGB(255, 90, 60)
	faxLed.Parent = fax
	local logbook = block(gh, "Logbook", Vector3.new(1, 0.1, 1.4), deskTop.CFrame * CFrame.new(0.1, 1.55, 1.8), C.Paper, Enum.Material.Fabric)
	worldText(logbook, Enum.NormalId.Top, nil, "02:14  VESPER-0214")
	local board = block(gh, "NoticeBoard", Vector3.new(4.5, 3.2, 0.2), CFrame.new(gx, 4.6, gz - 5.6), Color3.fromRGB(120, 96, 70), Enum.Material.Cardboard)
	local note = block(gh, "Note", Vector3.new(2.4, 1.9, 0.05), board.CFrame * CFrame.new(0.4, 0.2, 0.13), C.Paper, Enum.Material.SmoothPlastic)
	worldText(note, Enum.NormalId.Back, "NOTE_MAINTENANCE", nil, { code = "SIGNAL-017" })

	-- Antenna (extraction) south-west in the yard
	local antenna = Instance.new("Model")
	antenna.Name = "Antenna"
	antenna.Parent = outside
	local ax, az = -60, 150
	block(antenna, "Pad", Vector3.new(30, 1, 30), CFrame.new(ax, 0, az), C.ConcreteDark, Enum.Material.Concrete)
	local levels = 8
	local height = 110
	for i = 0, levels - 1 do
		local y0, y1 = i / levels * height, (i + 1) / levels * height
		local w0, w1 = 10 - i * 1.0, 10 - (i + 1) * 1.0
		for _, corner in { { 1, 1 }, { -1, 1 }, { 1, -1 }, { -1, -1 } } do
			local a = Vector3.new(ax + corner[1] * w0, y0, az + corner[2] * w0)
			local b = Vector3.new(ax + corner[1] * w1, y1, az + corner[2] * w1)
			block(antenna, "Leg", Vector3.new(0.7, 0.7, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), C.Emergency:Lerp(C.SteelDark, 0.55), Enum.Material.Metal)
		end
		for _, side in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
			local a = Vector3.new(ax + side[1] * w0 + side[2] * w0, y0, az + side[2] * w0 - side[1] * w0)
			local b = Vector3.new(ax + side[1] * w1 - side[2] * w1, y1, az + side[2] * w1 + side[1] * w1)
			local brace = block(antenna, "Brace", Vector3.new(0.35, 0.35, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), C.SteelDark, Enum.Material.Metal)
			brace.CanCollide = false
		end
		if i % 2 == 1 then
			local beacon = block(antenna, "Beacon", Vector3.new(1, 1, 1), CFrame.new(ax + w1, y1, az + w1), C.Emergency, Enum.Material.Neon)
			beacon.CanCollide = false
			local beaconLight = Instance.new("PointLight")
			beaconLight.Range = 18
			beaconLight.Brightness = 2
			beaconLight.Color = C.Emergency
			beaconLight.Parent = beacon
			CollectionService:AddTag(beacon, "FZ_Beacon")
		end
	end
	local dish = block(antenna, "Dish", Vector3.new(1, 12, 12), CFrame.new(ax + 4, 40, az - 4) * CFrame.Angles(0, math.rad(40), math.rad(20)), C.Plastic, Enum.Material.Metal)
	dish.Shape = Enum.PartType.Cylinder
	local cabinetBox = block(antenna, "ExtractionCabinet", Vector3.new(3, 5, 2), CFrame.new(ax, 3, az + 12), C.Steel, Enum.Material.Metal)
	interactable(cabinetBox, "c1_antenna", "INTERACT_LEAVE", "OBJECT_ANTENNA", { HoldDuration = 2, MaxDistance = 8 })

	-- Forest ring outside the fence (deterministic)
	local forest = Instance.new("Folder")
	forest.Name = "Forest"
	forest.Parent = outside
	local placed = 0
	while placed < 170 do
		local x = rng:NextNumber(-360, 380)
		local z = rng:NextNumber(-330, 460)
		local insideCompound = x > -140 and x < 160 and z > -120 and z < 250
		local onRoad = (math.abs(x - 75) < 16 and z > 240) or (x > 20 and x < 130 and z > 240 and z < 330)
		if not insideCompound and not onRoad then
			tree(forest, Vector3.new(x, 0, z), rng:NextNumber(0.8, 1.35))
			placed += 1
		end
	end

	-- Spawn (behind the menu camera), checkpoint at the gate, menu camera
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "FZ_Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.CFrame = CFrame.new(75, 0.5, 300)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = outside
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
	checkpoint("C1_START", CFrame.new(75, 0.5, 252))
	-- Title screen shots (cycled with slow dolly moves, see Main.client setMenuCamera)
	local shots = {
		{ Vector3.new(80, 5.5, 134), Vector3.new(74, 8, 70), 7 }, -- yard: lit entrance under the canopy
		{ Vector3.new(-18, 3.2, 128), Vector3.new(-60, 60, 150), 4 }, -- low angle up the antenna mast
		{ Vector3.new(130, 34, 150), Vector3.new(10, 14, 10), 10 }, -- high over the containers: roof + radome
		{ Vector3.new(92, 5.5, 64), Vector3.new(60, 4, 35), 5 }, -- inside the control room
		{ Vector3.new(75, 4.5, 262), Vector3.new(75, 6, 200), 6 }, -- at the gate, looking in
	}
	for i, shot in shots do
		local menuCamera = block(outside, "MenuCamera" .. i, Vector3.new(1, 1, 1), CFrame.lookAt(shot[1], shot[2]), C.Concrete)
		menuCamera.Transparency = 1
		menuCamera.CanCollide = false
		menuCamera.CanQuery = false
		menuCamera.CanTouch = false
		menuCamera:SetAttribute("Shot", i)
		menuCamera:SetAttribute("Drift", shot[3])
		CollectionService:AddTag(menuCamera, "FZ_MenuCamera")
	end
end

-- Terrain cannot be saved by script tools, so it is filled at runtime (also for a pre-baked
-- FZ_Map). Removes the edit-mode preview ground.
function Map.BuildTerrain(model: Instance?)
	local terrain = workspace.Terrain
	terrain:FillBlock(CFrame.new(0, -5.1, 80), Vector3.new(900, 10, 900), Enum.Material.Grass)
	terrain:FillBlock(CFrame.new(-60, -1.2, 150), Vector3.new(60, 2, 40), Enum.Material.Mud)
	-- variety patches so the ground does not read as one flat colour
	local patches = Random.new(91)
	for _ = 1, 26 do
		local x = patches:NextNumber(-420, 420)
		local z = patches:NextNumber(-350, 500)
		local inside = x > -135 and x < 155 and z > -115 and z < 245
		if not inside then
			local material = if patches:NextNumber() < 0.5 then Enum.Material.LeafyGrass else Enum.Material.Ground
			terrain:FillBall(Vector3.new(x, -2.6, z), patches:NextNumber(10, 26), material)
		end
	end
	-- low hills on the horizon frame the site
	for i = 0, 11 do
		local a = i / 12 * math.pi * 2
		terrain:FillBall(Vector3.new(math.cos(a) * 470, -30, 80 + math.sin(a) * 470), 70 + (i % 3) * 18, if i % 2 == 0 then Enum.Material.Grass else Enum.Material.Rock)
	end
	terrain.WaterWaveSize = 0.05
	local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.62
	clouds.Density = 0.45
	clouds.Color = Color3.fromRGB(70, 78, 92)
	clouds.Parent = terrain
	local scope = model or root
	if scope then
		for _, part in scope:GetDescendants() do
			if part:IsA("BasePart") and part:GetAttribute("FZ_EditPreview") then
				part:Destroy()
			end
		end
	end
end

local function buildLighting()
	-- Readable moonlit night: you can see the silhouettes, the light sources lead the way.
	Lighting.ClockTime = 23.6
	Lighting.GeographicLatitude = 48
	Lighting.Brightness = 1.6
	Lighting.ExposureCompensation = 0.35
	Lighting.Ambient = Color3.fromRGB(38, 42, 50)
	Lighting.OutdoorAmbient = Color3.fromRGB(82, 92, 110)
	Lighting.ColorShift_Top = Color3.fromRGB(150, 165, 190)
	Lighting.ColorShift_Bottom = Color3.fromRGB(20, 22, 28)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.85
	Lighting.ShadowSoftness = 0.25
	Lighting.GlobalShadows = true
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.27
	atmosphere.Offset = 0.04
	atmosphere.Color = Color3.fromRGB(150, 165, 185)
	atmosphere.Decay = Color3.fromRGB(72, 86, 108)
	atmosphere.Glare = 0.15
	atmosphere.Haze = 0.9
	atmosphere.Parent = Lighting
	local sky = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky")
	sky.StarCount = 3000
	sky.MoonAngularSize = 14
	sky.CelestialBodiesShown = true
	sky.Parent = Lighting
end

function Map.Build(): Model
	root = Instance.new("Model")
	root.Name = "FZ_RelayStation07"
	buildShell()
	furnish()
	buildOutside()
	buildLighting()
	root:SetAttribute("FZ_Builder", "RelayStation07")
	root.Parent = workspace
	if not Map.SkipTerrain then
		Map.BuildTerrain(root)
	end
	return root
end

return Map
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="40">
        <Properties>
          <string name="Name">Modes</string>
        </Properties>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">Survival</string>
            <string name="Source"><![CDATA[-- Endless survival "Night shift" (works on any map that provides the tagged objects).
--
--   Shift n:  random task (never the same twice in a row) + from shift 2 a random event
--             creatures get slowly faster and hear better; a second one joins at shift 6
--   Task done -> marks are BANKED, downed teammates get up, 25 s calm break:
--             extraction at the antenna is open (whole team must be there) or keep going
--   Team down -> run over, 50 % of the banked marks; extraction -> 100 % + 20 % bonus
-- No daily tasks, no timers that run while you are offline, no day/night simulation.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local Services = script.Parent.Parent.Services
local StoryService = require(Services.StoryService)
local InteractionService = require(Services.InteractionService)
local PowerService = require(Services.PowerService)
local CreatureService = require(Services.CreatureService)
local DataService = require(Services.DataService)
local NoiseService = require(Services.NoiseService)
local HealthService = require(Services.HealthService)
local DoorService = require(Services.DoorService)
local LeaderboardService = require(Services.LeaderboardService)
local ForecastService = require(Services.ForecastService)
local DirectorService = require(Services.DirectorService)
local InventoryService = require(Services.InventoryService)
local DecisionService = require(Services.DecisionService)
local AchievementService = require(Services.AchievementService)
local BadgeTracker = require(Services.BadgeTracker)
local HorrorEvents = require(script.Parent.Parent.Director.HorrorEvents)

local Survival = {}
Survival.StartCheckpoint = "C1_CONTROL"

local SC = Config.Survival
local TASKS = { "fuses", "uplink", "generators", "stations" }
local EVENTS = { "blackout", "static", "hunt", "lockdown", "calm", "forecast" }
local EVENT_NAMES = { blackout = "SV_EVN_BLACKOUT", static = "SV_EVN_STATIC", hunt = "SV_EVN_HUNT", lockdown = "SV_EVN_LOCKDOWN", calm = "SV_EVN_CALM", forecast = "SV_EVN_FORECAST" }

-- Light, repeatable scares for survival (the director keeps the gaps).
local SURVIVAL_BEATS = {
	{ id = "sv_flicker", kind = "flicker", condition = function(_p, info) return info.area ~= nil end },
	{ id = "sv_footsteps", kind = "footsteps", condition = function(_p, info) return info.alone end },
	{ id = "sv_apparition", kind = "apparition", condition = function(_p, info) return info.area == "HALL" end },
}
local STATIONS = { "c1_terminal", "c1_breaker_a", "c1_core" }
local UPLINK_SECONDS = 40
local UPLINK_RADIUS = 17

local ctx = nil
local active = false
local token = 0 -- invalidates timers of an older run

type Run = {
	entry: any,
	shift: number,
	completed: number,
	phase: string, -- "intro" | "task" | "break" | "ended"
	task: string?,
	lastTask: string?,
	event: string?,
	lastEvent: string?,
	taskStarted: number,
	banked: number,
	participants: { [Player]: boolean },
	progress: { [string]: any },
	blackoutSector: string?,
	lockedDoors: { BasePart },
	fuses: Folder?,
	overloadAnnounced: boolean,
}
local run: Run? = nil

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local function say(key: string, params: { [string]: any }?)
	StoryService.Say("all", { speaker = "SPEAKER_RELAY", text = key, params = params, channel = "radio", duration = 4 })
end

local function pick(list: { string }, avoid: string?): string
	local options = {}
	for _, value in list do
		if value ~= avoid then
			table.insert(options, value)
		end
	end
	return options[math.random(1, #options)]
end

local function interactablePosition(id: string): Vector3?
	for _, instance in CollectionService:GetTagged("FZ_Interactable") do
		if instance:GetAttribute("InteractId") == id and instance:IsA("BasePart") then
			return instance.Position
		end
	end
	return nil
end

local function aliveInGame(): { Player }
	local list = {}
	for _, player in ctx.playersInGame() do
		if not player:GetAttribute("FZ_Downed") and not player:GetAttribute("FZ_Eliminated") then
			table.insert(list, player)
		end
	end
	return list
end

local function publish()
	local r = run
	SessionState.Set("SvShift", if r then r.shift else nil)
	SessionState.Set("SvEvent", if r and r.event and r.phase == "task" then EVENT_NAMES[r.event] else nil)
	SessionState.Set("SvPhase", if r then r.phase else nil)
end

local function objective(key: string, params: { [string]: any }?)
	StoryService.SetObjective(key, params)
end

---------------------------------------------------------------------------
-- Events
---------------------------------------------------------------------------
local function clearEvent(r: Run)
	ForecastService.Cancel()
	if r.blackoutSector then
		PowerService.Set(r.blackoutSector, true)
		r.blackoutSector = nil
	end
	for _, panel in r.lockedDoors do
		DoorService.SetLocked(panel, false)
	end
	table.clear(r.lockedDoors)
	SessionState.Set("SvStatic", nil)
	r.event = nil
end

local function startEvent(r: Run)
	if r.shift < SC.FirstEventShift then
		return
	end
	local event = pick(EVENTS, r.lastEvent)
	r.event = event
	r.lastEvent = event
	if event == "blackout" then
		local sector = pick({ "A", "C", "D", "E" }, nil)
		r.blackoutSector = sector
		PowerService.Set(sector, false)
		StoryService.Say("all", { text = "SFX_POWER_DOWN", channel = "world", duration = 3, critical = true })
	elseif event == "static" then
		SessionState.Set("SvStatic", true)
	elseif event == "forecast" then
		-- A prediction you can break: hold the right breaker before the deadline.
		local sector = pick({ "A", "C", "D", "E" }, nil)
		ForecastService.Start({
			id = "sv_blackout_" .. string.lower(sector),
			text = "SV_FORECAST_" .. sector,
			hud = "FORECAST_BLACKOUT_" .. sector,
			seconds = 35,
			breakWith = if sector == "A" then "c1_breaker_a" else "breaker",
			breakFilter = function(instance)
				return instance:GetAttribute("Sector") == sector
			end,
			onKept = function()
				if run == r and r.phase == "task" then
					r.blackoutSector = sector
					PowerService.Set(sector, false)
					StoryService.Say("all", { text = "SFX_POWER_DOWN", channel = "world", duration = 3, critical = true })
				end
			end,
			onBroken = function()
				r.banked += SC.ShiftReward -- breaking a forecast is worth an extra shift reward
			end,
			keptLine = "RADIO_C1_FORECAST_KEPT",
			brokenLine = "RADIO_C1_FORECAST_BROKEN",
		})
		return -- the forecast line replaces the event announcement
	elseif event == "lockdown" then
		local candidates = {}
		for _, panel in CollectionService:GetTagged("FZ_Door") do
			if panel:IsA("BasePart") and (panel:GetAttribute("PowerSector") or "") == "" then
				table.insert(candidates, panel)
			end
		end
		for _ = 1, math.min(2, #candidates) do
			local panel = table.remove(candidates, math.random(1, #candidates))
			DoorService.SetLocked(panel, true)
			table.insert(r.lockedDoors, panel)
		end
		local current = token
		task.delay(60, function()
			if token == current and run == r then
				for _, panel in r.lockedDoors do
					DoorService.SetLocked(panel, false)
				end
				table.clear(r.lockedDoors)
			end
		end)
	end
	say("SV_EV_" .. string.upper(event))
end

---------------------------------------------------------------------------
-- Tasks
---------------------------------------------------------------------------
local completeTask: (r: Run) -> ()
local startEvacuation: (r: Run) -> ()
local EVAC_SECONDS = 75

local function spawnFuses(r: Run)
	if r.fuses then
		r.fuses:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "FZ_SurvivalFuses"
	folder.Parent = workspace
	r.fuses = folder
	local spots = {}
	for _, spot in CollectionService:GetTagged("FZ_FuseSpot") do
		if spot:IsA("BasePart") then
			table.insert(spots, spot)
		end
	end
	for _ = 1, math.min(3, #spots) do
		local spot = table.remove(spots, math.random(1, #spots))
		local fuse = Instance.new("Part")
		fuse.Name = "Fuse"
		fuse.Size = Vector3.new(0.5, 0.5, 1.4)
		fuse.Color = Color3.fromRGB(214, 170, 60)
		fuse.Material = Enum.Material.Metal
		fuse.Anchored = true
		fuse.CanCollide = false
		fuse.CFrame = spot.CFrame * CFrame.new(0, 0.1, 0)
		local glow = Instance.new("PointLight")
		glow.Range = 5
		glow.Brightness = 0.8
		glow.Color = Color3.fromRGB(255, 200, 90)
		glow.Parent = fuse
		fuse:SetAttribute("InteractId", "sv_fuse")
		fuse:SetAttribute("ActionKey", "INTERACT_PICKUP")
		fuse:SetAttribute("ObjectKey", "OBJECT_FUSE")
		fuse:SetAttribute("MaxDistance", 7)
		fuse.Parent = folder
		CollectionService:AddTag(fuse, "FZ_Interactable")
	end
end

local function beginTask(r: Run)
	local taskName = pick(TASKS, r.lastTask)
	r.task = taskName
	r.lastTask = taskName
	r.taskStarted = os.clock()
	r.overloadAnnounced = false
	r.progress = {}
	if taskName == "fuses" then
		r.progress.found = 0
		spawnFuses(r)
		objective("OBJECTIVE_FIND_FUSES", { count = 0, total = 3 })
	elseif taskName == "uplink" then
		r.progress.seconds = 0
		objective("SV_TASK_UPLINK", { percent = 0 })
	elseif taskName == "generators" then
		r.progress.done = {}
		objective("SV_TASK_GENERATORS", { count = 0, total = 2 })
	elseif taskName == "stations" then
		r.progress.done = {}
		objective("SV_TASK_STATIONS", { count = 0, total = #STATIONS })
	end
end

local function startShift(r: Run, shift: number)
	if not active or run ~= r then
		return
	end
	r.shift = shift
	r.phase = "task"
	local step = shift - 1
	CreatureService.SetDifficulty({
		speed = math.min(SC.MaxSpeedScale, 1 + 0.03 * step),
		hearing = math.min(SC.MaxHearingScale, 1 + 0.06 * step),
		ventChance = math.min(0.7, Config.Creature.VentChance + 0.04 * step),
	})
	CreatureService.SetAIEnabled(true)
	if CreatureService.Count() == 0 then
		CreatureService.Spawn()
	end
	if shift >= SC.SecondCreatureShift and CreatureService.Count() < 2 then
		CreatureService.Spawn(nil, true)
		say("SV_SECOND_CREATURE")
	end
	startEvent(r)
	if r.event == "static" then
		CreatureService.SetDifficulty({
			speed = math.min(SC.MaxSpeedScale, 1 + 0.03 * step),
			hearing = math.min(SC.MaxHearingScale, 1 + 0.06 * step) * 1.4,
			ventChance = math.min(0.7, Config.Creature.VentChance + 0.04 * step),
		})
	end
	beginTask(r)
	publish()
end

completeTask = function(r: Run)
	if r.phase ~= "task" then
		return
	end
	r.completed += 1
	r.banked += SC.ShiftReward + SC.ShiftRewardGrowth * r.shift
	r.phase = "break"
	r.task = nil
	clearEvent(r)
	if r.fuses then
		r.fuses:Destroy()
		r.fuses = nil
	end
	CreatureService.SetAIEnabled(false)
	for _, player in ctx.playersInGame() do
		if player:GetAttribute("FZ_Downed") then
			HealthService.Revive(player, 50)
		end
	end
	HealthService.ReturnAllEliminated() -- the break brings eliminated teammates back
	InventoryService.RefillCabinets()
	say("SV_SHIFT_DONE", { shift = r.shift })
	InventoryService.SpawnWorldItems(Config.Inventory.SurvivalItemsPerBreak)
	publish()
	-- RISK OR RESCUE: the team decides. Secured marks, next reward and danger are shown.
	local nextShift = r.shift + 1
	SessionState.Set("SvBreakEnds", workspace:GetServerTimeNow() + SC.BreakSeconds)
	DecisionService.Ask({
		id = "sv_risk_" .. r.shift,
		prompt = "SV_RISK_PROMPT",
		promptParams = {
			banked = r.banked,
			nextReward = SC.ShiftReward + SC.ShiftRewardGrowth * nextShift,
			danger = math.clamp(math.ceil(nextShift / 3), 1, 4),
		},
		options = { "SV_RISK_EVACUATE", "SV_RISK_CONTINUE" },
		seconds = SC.BreakSeconds,
		default = 1,
		tieBreak = 1, -- a tie evacuates: one player alone can never drag the team further
		onDecided = function(index)
			if run ~= r or r.phase ~= "break" then
				return
			end
			if index == 1 then
				startEvacuation(r)
			else
				say("SV_RISK_CONTINUE_LINE")
				local current = token
				task.delay(6, function()
					if token == current and run == r and r.phase == "break" then
						startShift(r, nextShift)
					end
				end)
			end
		end,
	}, aliveInGame)
	objective("SV_RISK_OBJECTIVE")
end

---------------------------------------------------------------------------
-- Run end
---------------------------------------------------------------------------
-- extracted: true (everyone), false (wipe) or a set of players who made it out
local function endRun(r: Run, extracted: boolean | { [Player]: boolean })
	if r.phase == "ended" then
		return
	end
	r.phase = "ended"
	DecisionService.Cancel()
	publish()
	clearEvent(r)
	CreatureService.SetAIEnabled(false)
	local survivalId = r.entry.id
	local participants = {}
	for player in r.participants do
		if player.Parent then
			table.insert(participants, player)
		end
	end
	local outCount = 0
	for _, player in participants do
		if extracted == true or (type(extracted) == "table" and extracted[player]) then
			outCount += 1
		end
	end
	for _, player in participants do
		local madeIt = extracted == true or (type(extracted) == "table" and extracted[player] == true)
		local marks = math.floor(r.banked * (if madeIt then 1 + SC.ExtractBonus else SC.WipeKeep))
		do
			local newBest = false
			DataService.Mutate(player, function(data)
				local stats = data.modes.survival[survivalId] or { best = 0, runs = 0 }
				stats.runs += 1
				if r.completed > stats.best then
					stats.best = r.completed
					newBest = true
				end
				data.modes.survival[survivalId] = stats
			end)
			if marks > 0 then
				DataService.Grant(player, marks)
			end
			DataService.SaveNow(player)
			task.spawn(LeaderboardService.Submit, survivalId, player.UserId, r.completed)
			StoryService.ShowDocument(player, {
				title = "SV_RESULT_TITLE",
				body = if madeIt then "SV_RESULT_EXTRACTED" else "SV_RESULT_LOST",
				params = { shifts = r.completed, marks = marks },
			})
			if r.completed >= 10 then
				AchievementService.Award(player, "night_shift_10")
			end
			if madeIt and #participants >= 2 then
				if outCount == 1 then
					AchievementService.Award(player, "last_survivor")
				elseif outCount == #participants and next(HealthService.SessionStats.eliminated) == nil then
					AchievementService.Award(player, "nobody_left")
				end
			end
			if newBest then
				Net.Event("Notify"):FireClient(player, "SV_NEW_BEST")
			end
			if r.completed >= 5 then
				BadgeTracker.Award(player, "survival_5")
			end
			if r.completed >= 10 then
				BadgeTracker.Award(player, "survival_10")
			end
		end
	end
	HealthService.HealAll()
	local current = token
	task.delay(15, function() -- time to read the shift report
		if token == current and run == r then
			ctx.finish()
		end
	end)
end

-- Evacuation: the team has 75 s to reach the antenna. The creature keeps hunting (with
-- the current difficulty, no new events) - a real but fair chance to get out.
local function antennaPosition(): Vector3?
	return interactablePosition("c1_antenna")
end

local function playersAtAntenna(): { [Player]: boolean }
	local center = antennaPosition()
	local set = {}
	if not center then
		return set
	end
	for _, player in aliveInGame() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and (root.Position - center).Magnitude <= SC.ExtractRadius then
			set[player] = true
		end
	end
	return set
end

startEvacuation = function(r: Run)
	r.phase = "evac"
	CreatureService.SetAIEnabled(true)
	say("SV_EVAC_LINE")
	objective("SV_EVAC")
	SessionState.Set("SvBreakEnds", workspace:GetServerTimeNow() + EVAC_SECONDS)
	publish()
	local current = token
	task.delay(EVAC_SECONDS, function()
		if token == current and run == r and r.phase == "evac" then
			endRun(r, playersAtAntenna())
		end
	end)
end

---------------------------------------------------------------------------
-- Mode interface
---------------------------------------------------------------------------
function Survival.Begin(entry)
	token += 1
	active = true
	run = {
		entry = entry,
		shift = 0,
		completed = 0,
		phase = "intro",
		task = nil,
		lastTask = nil,
		event = nil,
		lastEvent = nil,
		taskStarted = 0,
		banked = 0,
		participants = {},
		progress = {},
		blackoutSector = nil,
		lockedDoors = {},
		fuses = nil,
		overloadAnnounced = false,
	}
	local r = run :: Run
	PowerService.Set("B", true) -- the core is reachable in survival
	PowerService.Set("HALLS", true)
	SessionState.Set("Cameras", true)
	DirectorService.Configure(HorrorEvents.With(SURVIVAL_BEATS), {}, ctx.playersInGame)
	HealthService.TeamWipeHandler = function()
		if run == r and active then
			endRun(r, false)
		end
	end
	StoryService.ResetFlags()
	objective("SV_INTRO")
	publish()
	local current = token
	task.delay(10, function()
		if token == current then
			say("SV_START")
			startShift(r, 1)
		end
	end)

	-- 1 Hz director: uplink progress, overload, hunt event
	task.spawn(function()
		local nextHunt = 0
		while token == current and active do
			task.wait(1)
			local rr = run
			if not rr or rr ~= r or rr.phase ~= "task" then
				continue
			end
			local now = os.clock()
			if rr.task == "uplink" then
				local center = interactablePosition("c1_core")
				if center then
					local inside = false
					for _, player in aliveInGame() do
						local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
						if root and (root.Position - center).Magnitude <= UPLINK_RADIUS then
							inside = true
						end
					end
					if inside then
						rr.progress.seconds += 1
						if rr.progress.seconds % 6 == 0 then
							NoiseService.Emit(center, 80, nil) -- the uplink is loud
						end
						objective("SV_TASK_UPLINK", { percent = math.floor(rr.progress.seconds / UPLINK_SECONDS * 100) })
						if rr.progress.seconds >= UPLINK_SECONDS then
							completeTask(rr)
							continue
						end
					end
				end
			end
			if now - rr.taskStarted > SC.TaskSoftLimit then
				if not rr.overloadAnnounced then
					rr.overloadAnnounced = true
					say("SV_OVERLOAD")
				end
				if now >= nextHunt then
					nextHunt = now + 20
					local targets = aliveInGame()
					local target = targets[math.random(1, math.max(1, #targets))]
					local root = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
					if root then
						CreatureService.Alert(root.Position)
					end
				end
			elseif rr.event == "hunt" and now >= nextHunt then
				nextHunt = now + 15
				local targets = aliveInGame()
				local target = targets[math.random(1, math.max(1, #targets))]
				local root = target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root then
					CreatureService.Alert(root.Position)
				end
			end
		end
	end)
end

function Survival.Stop()
	token += 1
	active = false
	local r = run
	if r then
		clearEvent(r)
		if r.fuses then
			r.fuses:Destroy()
		end
	end
	run = nil
	HealthService.TeamWipeHandler = nil
	DirectorService.Stop()
	ForecastService.Cancel()
	SessionState.Set("Cameras", nil)
	SessionState.Set("CctvArea", nil)
	SessionState.Set("SvShift", nil)
	SessionState.Set("SvEvent", nil)
	SessionState.Set("SvPhase", nil)
	SessionState.Set("SvStatic", nil)
	SessionState.Set("SvBreakEnds", nil)
end

function Survival.OnPlayerEntered(player: Player, _firstTime: boolean)
	local r = run
	if r and active then
		r.participants[player] = true
	end
end

function Survival.Init(context)
	ctx = context
	ForecastService.Breakable("c1_breaker_a")
	ForecastService.Breakable("breaker")

	InteractionService.Register("sv_fuse", function(_player, fuse)
		local r = run
		if not active or not r or r.task ~= "fuses" or not fuse.Parent then
			return
		end
		Net.Event("Sfx"):FireAllClients("fuse_pickup", (fuse :: BasePart).Position)
		fuse:Destroy()
		r.progress.found += 1
		if r.progress.found >= 3 then
			objective("OBJECTIVE_RELAY_B")
		else
			objective("OBJECTIVE_FIND_FUSES", { count = r.progress.found, total = 3 })
		end
	end)

	InteractionService.Register("c1_relay_b", function(_player, panel)
		local r = run
		if not active or not r or r.task ~= "fuses" or (r.progress.found or 0) < 3 then
			return
		end
		Net.Event("Sfx"):FireAllClients("relay_activate", (panel :: BasePart).Position)
		completeTask(r)
	end)

	InteractionService.Register("generator", function(_player, generator)
		local r = run
		if not active or not r or r.task ~= "generators" then
			return
		end
		local id = generator:GetAttribute("GeneratorId") or generator
		if r.progress.done[id] then
			return
		end
		r.progress.done[id] = true
		Net.Event("Sfx"):FireAllClients("relay_activate", (generator :: BasePart).Position)
		NoiseService.Emit((generator :: BasePart).Position, 40, nil)
		local count = 0
		for _ in r.progress.done do
			count += 1
		end
		objective("SV_TASK_GENERATORS", { count = count, total = 2 })
		if count >= 2 then
			completeTask(r)
		end
	end)

	for _, stationId in STATIONS do
		InteractionService.Register(stationId, function(_player, station)
			local r = run
			if not active or not r or r.task ~= "stations" or r.progress.done[stationId] then
				return
			end
			r.progress.done[stationId] = true
			Net.Event("Sfx"):FireAllClients("radio_channel_beep", (station :: BasePart).Position)
			local count = 0
			for _ in r.progress.done do
				count += 1
			end
			objective("SV_TASK_STATIONS", { count = count, total = #STATIONS })
			if count >= #STATIONS then
				completeTask(r)
			end
		end)
	end

	-- Antenna: during an evacuation the whole standing team leaves together; during a shift a
	-- single player may leave alone with their share (nobody is held hostage by the vote).
	InteractionService.Register("c1_antenna", function(player)
		local r = run
		if not active or not r then
			return
		end
		if r.phase == "evac" then
			local here = playersAtAntenna()
			for _, other in aliveInGame() do
				if not here[other] then
					Net.Event("Notify"):FireClient(player, "SV_EXTRACT_NEED_TEAM")
					return
				end
			end
			endRun(r, here)
		elseif r.phase == "task" and r.banked > 0 and #aliveInGame() > 1 then
			local share = r.banked
			r.participants[player] = nil
			DataService.Grant(player, share)
			Net.Event("Notify"):FireClient(player, "SV_LEFT_ALONE", { marks = share })
			ctx.leave(player)
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		if run then
			run.participants[player] = nil
		end
	end)
end

return Survival
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">AchievementService</string>
            <string name="Source"><![CDATA[-- AchievementService: one-time achievements with server-side rewards.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Achievements = require(Shared.Achievements)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)
local BadgeTracker = require(script.Parent.BadgeTracker)

local AchievementService = {}

local function definition(id: string)
	for _, item in Achievements do
		if item.id == id then
			return item
		end
	end
	return nil
end

function AchievementService.Has(player: Player, id: string): boolean
	local profile = DataService.Get(player)
	return profile ~= nil and profile.Data.achievements[id] ~= nil
end

function AchievementService.Award(player: Player, id: string)
	local item = definition(id)
	local profile = DataService.Get(player)
	if not item or not profile or profile.Data.achievements[id] then
		return
	end
	DataService.Mutate(player, function(data)
		data.achievements[id] = os.time()
	end)
	Net.Event("Notify"):FireClient(player, "ACH_UNLOCKED", { name = item.name })
	if item.marks and item.marks > 0 then
		task.delay(2.5, function()
			if player.Parent then
				DataService.Grant(player, item.marks)
			end
		end)
	end
	BadgeTracker.Award(player, id)
end

return AchievementService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[-- AdminService: server-side authorization and audit log for maintenance tools.
--
-- Security model:
--   1. IsAuthorized() checks UserId / ownership on the server (cached per session).
--   2. The gesture code is read from ServerStorage at runtime (attribute
--      "FZ_AdminGesture", set by the owner in Studio, NOT committed to git). It only
--      unlocks the hidden menu entry for authorized players.
--   3. Every admin remote call re-checks authorization; the client-visible attribute
--      FZ_Admin is only a UI hint and is never trusted.

local CollectionService = game:GetService("CollectionService")
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local AdminConfig = require(script.Parent.Parent.AdminConfig)
local DataService = require(script.Parent.DataService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local AdminService = {}

local authorizedCache: { [Player]: boolean } = {}
local unlocked: { [Player]: boolean } = {}
local auditLog: { { time: number, userId: number, name: string, action: string, detail: string } } = {}
local MAX_LOG = 200
local pendingLog: { any } = {} -- written to the DataStore "FZ_AdminLog_v1" once a minute

function AdminService.Log(player: Player, action: string, detail: string?)
	local entry = {
		time = os.time(),
		userId = player.UserId,
		name = player.Name,
		action = action,
		detail = detail or "",
	}
	table.insert(auditLog, entry)
	table.insert(pendingLog, entry)
	if #auditLog > MAX_LOG then
		table.remove(auditLog, 1)
	end
	print(string.format("[FZ-ADMIN] %s (%d) %s %s", entry.name, entry.userId, action, entry.detail))
end

function AdminService.IsAuthorized(player: Player): boolean
	local cached = authorizedCache[player]
	if cached ~= nil then
		return cached
	end
	local authorized = false
	local certain = true
	if RunService:IsStudio() and AdminConfig.AllowAllInStudio then
		authorized = true
	elseif table.find(AdminConfig.UserIds, player.UserId) then
		authorized = true
	elseif game.CreatorType == Enum.CreatorType.User then
		authorized = player.UserId == game.CreatorId
	elseif game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
		if ok then
			authorized = rank >= AdminConfig.MinGroupRank
		else
			certain = false -- web call failed: do not cache a false negative
		end
	end
	if certain then
		authorizedCache[player] = authorized
	end
	return authorized
end

function AdminService.MatchesGesture(normalizedCode: string): boolean
	local gesture = ServerStorage:GetAttribute("FZ_AdminGesture")
	if type(gesture) ~= "string" or #gesture < 6 then
		return false
	end
	return string.upper(gesture) == normalizedCode
end

function AdminService.Unlock(player: Player)
	unlocked[player] = true
	player:SetAttribute("FZ_Admin", true)
	AdminService.Log(player, "unlock")
end

local function isAllowed(player: Player): boolean
	return unlocked[player] == true and AdminService.IsAuthorized(player)
end

local ACTIONS = {}

ACTIONS.grant_test_marks = function(player: Player)
	local ok = DataService.Mutate(player, function(data)
		data.signalMarks += 100
	end)
	return { ok = ok }
end

-- World tools. Anything that can affect other players is limited to Studio and private
-- servers, so admins can never harass or break public sessions.
local function isTestServer(): boolean
	return RunService:IsStudio() or game.PrivateServerId ~= ""
end

local function lazy(name: string)
	return require(script.Parent[name])
end

ACTIONS.spawn_creature = function(player: Player)
	if not isTestServer() then
		return { ok = false, reason = "public" }
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return { ok = false }
	end
	local cf = root.CFrame * CFrame.new(0, 3, -18)
	lazy("CreatureService").Spawn(CFrame.lookAt(cf.Position, root.Position * Vector3.new(1, 0, 1) + Vector3.new(0, cf.Position.Y, 0)))
	return { ok = true }
end

ACTIONS.toggle_ai = function()
	local creatures = lazy("CreatureService")
	creatures.SetAIEnabled(not creatures.IsAIEnabled())
	return { ok = true, enabled = creatures.IsAIEnabled() }
end

ACTIONS.play_creature = function(player: Player)
	if not isTestServer() then
		return { ok = false, reason = "public" }
	end
	local Rig = require(script.Parent.Parent.Creature.Rig)
	local old = player.Character
	local pivot = if old then old:GetPivot() else CFrame.new(0, 10, 0)
	local model = Rig.Create()
	model.Name = player.Name
	model:PivotTo(pivot + Vector3.new(0, 4, 0))
	player:SetAttribute("FZ_MonsterMode", true)
	player.CameraMode = Enum.CameraMode.Classic
	player.CameraMinZoomDistance = 10
	player.CameraMaxZoomDistance = 18
	model.Parent = workspace
	Rig.Tag(model)
	player.Character = model
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = 14
	end
	if old then
		old:Destroy()
	end
	return { ok = true }
end

ACTIONS.play_human = function(player: Player)
	player:SetAttribute("FZ_MonsterMode", false)
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player.CameraMinZoomDistance = 0.5
	player.CameraMaxZoomDistance = 0.5
	player:LoadCharacter()
	return { ok = true }
end

ACTIONS.tp_core = function(player: Player)
	local character = player.Character
	if character then
		character:PivotTo(CFrame.new(0, 4, 32))
	end
	return { ok = true }
end

ACTIONS.toggle_speed = function(player: Player)
	player:SetAttribute("FZ_AdminSpeed", not player:GetAttribute("FZ_AdminSpeed"))
	return { ok = true }
end

ACTIONS.reset = function()
	lazy("SessionService").ResetActive()
	lazy("HealthService").HealAll()
	lazy("DoorService").CloseAll()
	return { ok = true }
end

-- Spawn where the owner is looking (the client sends the aimed point, the server checks it).
ACTIONS.spawn_creature_at = function(player: Player, payload: any)
	if not isTestServer() then
		return { ok = false, reason = "public" }
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local position = type(payload) == "table" and payload.position
	if not root or typeof(position) ~= "Vector3" or (position - root.Position).Magnitude > 400 then
		return { ok = false }
	end
	local creatures = lazy("CreatureService")
	creatures.Spawn(CFrame.lookAt(position + Vector3.new(0, 6, 0), Vector3.new(root.Position.X, position.Y + 6, root.Position.Z)), type(payload) == "table" and payload.add == true)
	return { ok = true }
end

ACTIONS.teleport_checkpoint = function(player: Player, payload: any)
	local id = type(payload) == "table" and payload.id
	for _, part in CollectionService:GetTagged("FZ_Checkpoint") do
		if part:IsA("BasePart") and part:GetAttribute("CheckpointId") == id and player.Character then
			player.Character:PivotTo(part.CFrame + Vector3.new(0, 4, 0))
			return { ok = true }
		end
	end
	return { ok = false }
end

local SCARES = { apparition = true, footsteps = true, flicker = true, cctv = true, namecall = true }
ACTIONS.scare_test = function(player: Player, payload: any)
	local kind = type(payload) == "table" and payload.kind
	if not SCARES[kind] then
		return { ok = false }
	end
	Net.Event("Scare"):FireClient(player, kind, { withFigure = true, offset = 20, name = player.DisplayName })
	return { ok = true }
end

ACTIONS.sound_test = function(player: Player, payload: any)
	local name = type(payload) == "table" and payload.name
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if type(name) ~= "string" or not root then
		return { ok = false }
	end
	Net.Event("Sfx"):FireClient(player, name, root.Position + root.CFrame.LookVector * 8)
	return { ok = true }
end

ACTIONS.light_test = function()
	if not isTestServer() then
		return { ok = false, reason = "public" }
	end
	local power = lazy("PowerService")
	task.spawn(function()
		for _, sector in { "A", "B", "C", "D", "E", "HALLS", "CORE" } do
			local was = power.IsOn(sector)
			power.Set(sector, not was)
			task.wait(1.2)
			power.Set(sector, was)
		end
	end)
	return { ok = true }
end

ACTIONS.forecast_test = function()
	if not isTestServer() then
		return { ok = false, reason = "public" }
	end
	local forecasts = lazy("ForecastService")
	local power = lazy("PowerService")
	forecasts.Breakable("c1_breaker_a")
	forecasts.Start({
		id = "admin_test",
		text = "RADIO_C1_FORECAST",
		hud = "FORECAST_LIGHTS_A",
		seconds = 20,
		breakWith = "c1_breaker_a",
		onKept = function()
			power.Set("A", false)
			task.delay(10, function()
				power.Set("A", true)
			end)
		end,
		onBroken = function() end,
		keptLine = "RADIO_C1_FORECAST_KEPT",
		brokenLine = "RADIO_C1_FORECAST_BROKEN",
	})
	return { ok = true }
end

ACTIONS.get_log = function()
	local recent = {}
	for i = math.max(1, #auditLog - 19), #auditLog do
		table.insert(recent, auditLog[i])
	end
	return { ok = true, log = recent }
end

function AdminService.Start()
	if type(ServerStorage:GetAttribute("FZ_AdminGesture")) ~= "string" then
		warn("[FZ-ADMIN] No gesture configured. Set the string attribute 'FZ_AdminGesture' on ServerStorage (min. 6 characters) to enable the hidden maintenance entry.")
	end

	local limiter = RateLimiter.new(10, 1)
	Net.Function("AdminAction").OnServerInvoke = function(player: Player, action: any, _payload: any)
		if not limiter:Allow(player) then
			return { ok = false, reason = "rate_limited" }
		end
		if type(action) ~= "string" or not isAllowed(player) then
			AdminService.Log(player, "denied", tostring(action))
			return { ok = false, reason = "denied" }
		end
		local handler = ACTIONS[action]
		if not handler then
			return { ok = false, reason = "unknown" }
		end
		AdminService.Log(player, action)
		return handler(player, _payload)
	end

	-- Monster mode attack: same telegraphed damage as the AI, test servers only.
	local attackLimiter = RateLimiter.new(1, 0.6)
	Net.Event("MonsterAttack").OnServerEvent:Connect(function(player: Player)
		if not player:GetAttribute("FZ_MonsterMode") or not isAllowed(player) or not isTestServer() or not attackLimiter:Allow(player) then
			return
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return
		end
		local creatureConfig = require(ReplicatedStorage.Shared.Config).Creature
		player.Character:SetAttribute("State", "Attack")
		task.delay(creatureConfig.AttackWindup, function()
			if not player.Character then
				return
			end
			player.Character:SetAttribute("State", "Chase")
			for _, other in Players:GetPlayers() do
				local otherRoot = other ~= player and other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if otherRoot and (otherRoot.Position - root.Position).Magnitude <= creatureConfig.AttackRange + 1.5 then
					lazy("HealthService").Damage(other, creatureConfig.Damage)
				end
			end
		end)
	end)

	-- Persist the audit log (one key per UTC day, newest 500 entries).
	local logStore = nil
	pcall(function()
		logStore = DataStoreService:GetDataStore("FZ_AdminLog_v1")
	end)
	local function flush()
		if not logStore or #pendingLog == 0 then
			return
		end
		local batch = pendingLog
		pendingLog = {}
		local ok = pcall(function()
			logStore:UpdateAsync(os.date("!%Y-%m-%d"), function(old)
				local list = if type(old) == "table" then old else {}
				for _, entry in batch do
					table.insert(list, entry)
				end
				while #list > 500 do
					table.remove(list, 1)
				end
				return list
			end)
		end)
		if not ok then
			for _, entry in batch do
				table.insert(pendingLog, entry)
			end
		end
	end
	task.spawn(function()
		while true do
			task.wait(60)
			flush()
		end
	end)
	game:BindToClose(flush)

	Players.PlayerRemoving:Connect(function(player)
		authorizedCache[player] = nil
		unlocked[player] = nil
	end)
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">AnalyticsTracker</string>
            <string name="Source"><![CDATA[-- AnalyticsTracker: measures where players stop, without collecting anything personal.
-- Uses Roblox AnalyticsService (Creator Hub -> Analytics -> Funnels / Economy):
--   * Onboarding funnel (first session only): language -> menu -> in game -> first task
--   * Chapter 1 funnel (every run): gate -> fax -> decision -> power -> fuses -> relay -> core -> end
--   * Economy: every Signal Mark source and sink
-- All calls are wrapped: analytics must never break gameplay.

local AnalyticsService = game:GetService("AnalyticsService")
local HttpService = game:GetService("HttpService")

local AnalyticsTracker = {}

local runIds: { [Player]: string } = {}
local onboardingDone: { [Player]: { [number]: boolean } } = {}

AnalyticsTracker.Chapter1Steps = {
	"Gate", "Fax", "Decision", "Power", "FirstFuse", "AllFuses", "Relay", "Core", "Antenna",
}

function AnalyticsTracker.Onboarding(player: Player, step: number, name: string)
	onboardingDone[player] = onboardingDone[player] or {}
	if onboardingDone[player][step] then
		return
	end
	onboardingDone[player][step] = true
	pcall(function()
		AnalyticsService:LogOnboardingFunnelStepEvent(player, step, name)
	end)
end

function AnalyticsTracker.NewRun(player: Player)
	runIds[player] = HttpService:GenerateGUID(false)
end

function AnalyticsTracker.ChapterStep(player: Player, funnel: string, stepName: string)
	local index = table.find(AnalyticsTracker.Chapter1Steps, stepName)
	if not index then
		return
	end
	local runId = runIds[player] or HttpService:GenerateGUID(false)
	runIds[player] = runId
	pcall(function()
		AnalyticsService:LogFunnelStepEvent(player, funnel, runId, index, stepName)
	end)
end

function AnalyticsTracker.Economy(player: Player, amount: number, balance: number, source: boolean, reason: string)
	pcall(function()
		AnalyticsService:LogEconomyEvent(
			player,
			if source then Enum.AnalyticsEconomyFlowType.Source else Enum.AnalyticsEconomyFlowType.Sink,
			"SignalMarks",
			math.abs(amount),
			balance,
			if source then Enum.AnalyticsEconomyTransactionType.Gameplay.Name else Enum.AnalyticsEconomyTransactionType.Shop.Name,
			reason
		)
	end)
end

function AnalyticsTracker.Forget(player: Player)
	runIds[player] = nil
	onboardingDone[player] = nil
end

return AnalyticsTracker
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">BadgeTracker</string>
            <string name="Source"><![CDATA[-- BadgeTracker: awards Roblox badges configured in Shared/Badges.luau (id 0 = skipped).

local BadgeService = game:GetService("BadgeService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Badges = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Badges"))

local BadgeTracker = {}

local awarded: { [string]: boolean } = {}

function BadgeTracker.Award(player: Player, key: string)
	local id = Badges[key]
	if type(id) ~= "number" or id <= 0 then
		return
	end
	local cacheKey = player.UserId .. ":" .. key
	if awarded[cacheKey] then
		return
	end
	awarded[cacheKey] = true
	task.spawn(function()
		local ok, has = pcall(BadgeService.UserHasBadgeAsync, BadgeService, player.UserId, id)
		if ok and not has then
			pcall(BadgeService.AwardBadge, BadgeService, player.UserId, id)
		end
	end)
end

return BadgeTracker
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">CodeService</string>
            <string name="Source"><![CDATA[-- CodeService: redeemable codes hidden inside the game world.
-- Codes are defined in ServerStorage.Secrets.Codes (never replicated to clients), checked
-- server-side, redeemable once per account (session lock in DataService prevents
-- cross-server duplication) and saved immediately.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local AdminService = require(script.Parent.AdminService)
local DataService = require(script.Parent.DataService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local Codes = require(ServerStorage:WaitForChild("Secrets"):WaitForChild("Codes"))

local CodeService = {}

local function normalize(raw: string): string
	local trimmed = string.gsub(raw, "%s+", "")
	return string.upper(trimmed)
end

function CodeService.Redeem(player: Player, raw: any): { [string]: any }
	if type(raw) ~= "string" or #raw == 0 or #raw > Config.Codes.MaxLength * 2 then
		return { status = "invalid" }
	end
	local code = normalize(raw)
	if #code == 0 or #code > Config.Codes.MaxLength then
		return { status = "invalid" }
	end

	if AdminService.MatchesGesture(code) then
		if AdminService.IsAuthorized(player) then
			AdminService.Unlock(player)
			return { status = "admin" }
		end
		AdminService.Log(player, "gesture_denied")
		return { status = "invalid" } -- indistinguishable from a wrong code
	end

	local definition = Codes[code]
	if not definition or definition.active == false then
		return { status = "invalid" }
	end

	local profile = DataService.Get(player)
	if not profile or not profile.Persistent then
		-- Never hand out a reward that cannot be saved (and could then be redeemed again).
		return { status = "error" }
	end
	if profile.Data.redeemedCodes[definition.id] then
		return { status = "used" }
	end

	-- No yield between the check above and this write, so double invocations are safe.
	local amount = definition.reward.signalMarks or 0
	DataService.Mutate(player, function(data)
		data.redeemedCodes[definition.id] = os.time()
		data.signalMarks += amount
	end)
	DataService.SaveNow(player) -- if this fails, autosave retries; the profile stays locked
	return { status = "ok", amount = amount, balance = profile.Data.signalMarks }
end

function CodeService.Start()
	local limiter = RateLimiter.new(5, 1 / 6) -- burst 5, then one attempt every 6 s
	Net.Function("RedeemCode").OnServerInvoke = function(player: Player, raw: any)
		if not limiter:Allow(player) then
			return { status = "rate_limited" }
		end
		return CodeService.Redeem(player, raw)
	end
end

return CodeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">CommunityService</string>
            <string name="Source"><![CDATA[-- CommunityService: one-time reward for joining the official Roblox community (group).
--   * Membership is checked on the server (Player:IsInGroupAsync, fallback IsInGroup)
--   * The claim is stored in the save -> it can never be claimed twice
--   * Join requests that still wait for approval simply are not members yet: the player
--     can check again later (rate limited); failed web calls never consume the claim
--   * Playing never requires the community

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Community = require(Shared.Community)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)
local BadgeTracker = require(script.Parent.BadgeTracker)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local CommunityService = {}

local function isMember(player: Player): boolean?
	local groupId = Community.GroupId
	local ok, result = pcall(function()
		return (player :: any):IsInGroupAsync(groupId)
	end)
	if ok and type(result) == "boolean" then
		return result
	end
	ok, result = pcall(player.IsInGroup, player, groupId) -- older API (cached per server)
	if ok and type(result) == "boolean" then
		return result
	end
	return nil -- unknown: web request failed
end

function CommunityService.Start()
	local limiter = RateLimiter.new(2, 0.1)
	Net.Function("Community").OnServerInvoke = function(player: Player, action: any)
		if Community.GroupId <= 0 then
			return { status = "off" }
		end
		local profile = DataService.Get(player)
		if not profile then
			return { status = "error" }
		end
		local claimed = profile.Data.community.claimed ~= nil
		if action == "status" then
			return { status = if claimed then "claimed" else "open", groupId = Community.GroupId, marks = Community.RewardMarks }
		elseif action ~= "claim" then
			return { status = "error" }
		end
		if claimed then
			return { status = "claimed" }
		end
		if not limiter:Allow(player) then
			return { status = "rate" }
		end
		if not profile.Persistent then
			return { status = "error" }
		end
		local member = isMember(player)
		if member == nil then
			return { status = "error" }
		elseif not member then
			return { status = "not_member" }
		end
		DataService.Mutate(player, function(data)
			data.community.claimed = os.time()
		end)
		DataService.Grant(player, Community.RewardMarks)
		DataService.SaveNow(player)
		BadgeTracker.Award(player, "community")
		return { status = "ok", marks = Community.RewardMarks }
	end
end

return CommunityService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">CreatureService</string>
            <string name="Source"><![CDATA[-- CreatureService: server-authoritative AI for "Der Lauscher".
--
-- Fair, learnable rules (see docs/GAME_DESIGN.md):
--   * It HEARS: walking (7 studs), sprinting (20), radio transmissions (28), doors (16).
--     Standing still is silent.
--   * It SEES within 42 studs in a 65 degree cone, only with line of sight.
--   * Light blinds it briefly (flashlight aimed at the head), then it backs off.
--   * Every attack has a wind-up (crackle + pose). Three hits put you down, never one.
--   * Vent travel is always announced by a rattle at the exit vent.
-- States: Dormant, Patrol, Listen, Investigate, Search, Chase, Attack, Blinded, Retreat, Vent
-- The current state is replicated as the model attribute "State" for visuals and audio.

local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared.Assets)
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local DoorService = require(script.Parent.DoorService)
local HealthService = require(script.Parent.HealthService)
local NoiseService = require(script.Parent.NoiseService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local Rig = require(script.Parent.Parent.Creature.Rig)

local CreatureService = {}

local CC = Config.Creature
local TICK = 0.1

type Creature = {
	model: Model,
	humanoid: Humanoid,
	root: BasePart,
	state: string,
	stateTime: number,
	target: Vector3?,
	targetPlayer: Player?,
	lastSeen: number,
	lastSeenPosition: Vector3?,
	waypoints: { PathWaypoint },
	waypointIndex: number,
	pathTarget: Vector3?,
	nextRepath: number,
	nextAttack: number,
	blindReadyAt: number,
	visitedPatrol: { [Instance]: number },
	searchCenter: Vector3?,
	pendingNoise: { position: Vector3, radius: number }?,
	tracks: { [string]: AnimationTrack },
	lastFootprint: number,
}

local creatures: { Creature } = {}

-- Players a creature has chased this session ("Unseen" achievement).
CreatureService.Spotted = {} :: { [Player]: boolean }
local aiEnabled = true
local difficulty = { speed = 1, hearing = 1, ventChance = CC.VentChance, sight = 1 }
local ventsEnabled = true -- story: only when the ventilation has power

local function alive(c: Creature): boolean
	return table.find(creatures, c) ~= nil and c.model.Parent ~= nil
end

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function soloScale(): number
	local count = 0
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("FZ_InGame") then
			count += 1
		end
	end
	return if count <= 1 then CC.SoloSpeedScale else 1
end

local function setState(c: Creature, state: string)
	if c.state == state then
		return
	end
	c.state = state
	c.stateTime = os.clock()
	c.model:SetAttribute("State", state)
	c.waypoints = {}
	c.pathTarget = nil
	-- Optional real animations for user-provided models
	for name, track in c.tracks do
		local wanted = (state == "Attack" and name == "Attack")
			or (state == "Listen" and name == "Listen")
			or ((state == "Chase") and name == "Run")
			or ((state == "Patrol" or state == "Investigate" or state == "Search" or state == "Retreat") and name == "Walk")
			or ((state == "Blinded" or state == "Dormant") and name == "Idle")
		if wanted and not track.IsPlaying then
			track:Play(0.2)
		elseif not wanted and track.IsPlaying then
			track:Stop(0.2)
		end
	end
	if state == "Chase" then
		Net.Event("Sfx"):FireAllClients("creature_alert", c.root)
		if c.targetPlayer then
			CreatureService.Spotted[c.targetPlayer] = true
		end
	end
end

local function playersInGame(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("FZ_InGame") and not player:GetAttribute("FZ_Downed") and not player:GetAttribute("FZ_Eliminated") and not player:GetAttribute("FZ_MonsterMode") then
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root then
				table.insert(list, player)
			end
		end
	end
	return list
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function hasLineOfSight(c: Creature, from: Vector3, to: Vector3, ignore: { Instance }): boolean
	local filter = { c.model }
	for _, instance in ignore do
		table.insert(filter, instance)
	end
	rayParams.FilterDescendantsInstances = filter
	local result = workspace:Raycast(from, to - from, rayParams)
	return result == nil
end

local function eyePosition(c: Creature): Vector3
	local head = c.model:FindFirstChild("Head")
	return if head and head:IsA("BasePart") then head.Position else c.root.Position + Vector3.new(0, 3, 0)
end

local function findVisiblePlayer(c: Creature): (Player?, number)
	local best, bestDistance = nil, math.huge
	local eye = eyePosition(c)
	local look = flat(c.root.CFrame.LookVector).Unit
	for _, player in playersInGame() do
		local character = player.Character :: Model
		local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
		local target = (head :: BasePart).Position
		local offset = target - eye
		local distance = offset.Magnitude
		if distance < CC.SightRange * difficulty.sight then
			local direction = flat(offset)
			local angle = if direction.Magnitude > 0 then math.deg(math.acos(math.clamp(look:Dot(direction.Unit), -1, 1))) else 0
			if (angle <= CC.SightAngle or distance < 9) and hasLineOfSight(c, eye, target, { character }) then
				if distance < bestDistance then
					best, bestDistance = player, distance
				end
			end
		end
	end
	return best, bestDistance
end

---------------------------------------------------------------------------
-- Movement
---------------------------------------------------------------------------
local function computePath(c: Creature, target: Vector3)
	local path = PathfindingService:CreatePath({
		AgentRadius = 2,
		AgentHeight = 9,
		AgentCanJump = false,
		WaypointSpacing = 5,
	})
	local ok = pcall(function()
		path:ComputeAsync(c.root.Position, target)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		c.waypoints = path:GetWaypoints()
		c.waypointIndex = math.min(2, #c.waypoints)
	else
		c.waypoints = { PathWaypoint.new(target, Enum.PathWaypointAction.Walk) }
		c.waypointIndex = 1
	end
	c.pathTarget = target
end

-- Returns true when the target is reached.
local function moveTowards(c: Creature, target: Vector3, speed: number, repathInterval: number?): boolean
	c.humanoid.WalkSpeed = speed * soloScale() * difficulty.speed
	local now = os.clock()
	if not c.pathTarget or (c.pathTarget - target).Magnitude > 4 or (repathInterval and now >= c.nextRepath) then
		computePath(c, target)
		c.nextRepath = now + (repathInterval or 2)
	end
	if flat(c.root.Position - target).Magnitude < 3.5 then
		c.humanoid:Move(Vector3.zero)
		return true
	end
	local waypoint = c.waypoints[c.waypointIndex]
	if not waypoint then
		return true
	end
	if flat(c.root.Position - waypoint.Position).Magnitude < 3 then
		c.waypointIndex += 1
		waypoint = c.waypoints[c.waypointIndex]
		if not waypoint then
			return flat(c.root.Position - target).Magnitude < 6
		end
	end
	c.humanoid:MoveTo(waypoint.Position)
	-- Open unlocked doors right in front of it (makes noise, very readable)
	for _, panel in CollectionService:GetTagged("FZ_Door") do
		if panel:IsA("BasePart") and not panel:GetAttribute("Open") and not panel:GetAttribute("Locked") then
			if (panel.Position - c.root.Position).Magnitude < 8 then
				DoorService.Open(panel)
			end
		end
	end
	return false
end

local function stop(c: Creature)
	c.humanoid:MoveTo(c.root.Position)
	c.humanoid.WalkSpeed = 0
end

local function face(c: Creature, position: Vector3)
	local from = c.root.Position
	local to = Vector3.new(position.X, from.Y, position.Z)
	if (to - from).Magnitude > 0.1 then
		c.root.CFrame = CFrame.lookAt(from, to)
	end
end

local function pickPatrolNode(c: Creature, near: Vector3?, radius: number?): Vector3?
	local nodes = CollectionService:GetTagged("FZ_CreaturePatrol")
	local candidates = {}
	local now = os.clock()
	for _, node in nodes do
		if node:IsA("BasePart") then
			local distance = (node.Position - (near or c.root.Position)).Magnitude
			local fresh = now - (c.visitedPatrol[node] or -999) > 40
			if (not radius or distance <= radius) and distance > 6 and fresh then
				table.insert(candidates, node)
			end
		end
	end
	if #candidates == 0 then
		for _, node in nodes do
			if node:IsA("BasePart") then
				table.insert(candidates, node)
			end
		end
	end
	if #candidates == 0 then
		return nil
	end
	local chosen = candidates[math.random(1, #candidates)] :: BasePart
	c.visitedPatrol[chosen] = now
	return chosen.Position
end

---------------------------------------------------------------------------
-- Vents
---------------------------------------------------------------------------
local function nearestVent(position: Vector3, exclude: Instance?): BasePart?
	local best, bestDistance = nil, math.huge
	for _, vent in CollectionService:GetTagged("FZ_Vent") do
		if vent ~= exclude and vent:IsA("BasePart") then
			local d = (vent.Position - position).Magnitude
			if d < bestDistance then
				best, bestDistance = vent, d
			end
		end
	end
	return best
end

local function travelVent(c: Creature, destination: Vector3)
	local entry = nearestVent(c.root.Position)
	local exit = nearestVent(destination, entry)
	if not entry or not exit or (entry.Position - c.root.Position).Magnitude > 12 then
		return false
	end
	setState(c, "Vent")
	Net.Event("Sfx"):FireAllClients("vent_rattle", entry.Position)
	c.root.Anchored = true
	c.model:SetAttribute("Hidden", true)
	c.model:PivotTo(CFrame.new(entry.Position.X, -200, entry.Position.Z))
	task.wait(CC.VentTravelTime - CC.VentWarning)
	if not alive(c) then
		return true
	end
	Net.Event("Sfx"):FireAllClients("vent_rattle", exit.Position)
	for _, player in Players:GetPlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and ((root :: BasePart).Position - exit.Position).Magnitude < 45 then
			Net.Event("Subtitle"):FireClient(player, { text = "SFX_VENT", channel = "world", duration = 3, critical = true })
		end
	end
	task.wait(CC.VentWarning)
	if not alive(c) then
		return true
	end
	local out = exit.CFrame * CFrame.new(0, 0, -4)
	c.model:PivotTo(CFrame.new(out.Position.X, exit.Position.Y + 5, out.Position.Z) * CFrame.Angles(0, select(2, out:ToOrientation()), 0))
	c.root.Anchored = false
	c.model:SetAttribute("Hidden", false)
	c.searchCenter = exit.Position
	setState(c, "Search")
	return true
end

---------------------------------------------------------------------------
-- State machine
---------------------------------------------------------------------------
local function startInvestigate(c: Creature, position: Vector3)
	c.target = position
	setState(c, "Listen")
	stop(c)
	face(c, position)
end

local function step(c: Creature)
	local now = os.clock()
	local elapsed = now - c.stateTime
	local state = c.state

	if state == "Dormant" or state == "Vent" then
		return
	end

	if state == "Blinded" then
		stop(c)
		if elapsed > CC.BlindDuration then
			setState(c, "Retreat")
			c.target = pickPatrolNode(c, nil, nil)
		end
		return
	end

	-- Perception (sight beats hearing)
	local seen, seenDistance = findVisiblePlayer(c)
	if seen and state ~= "Attack" then
		c.targetPlayer = seen
		c.lastSeen = now
		local root = (seen.Character :: Model):FindFirstChild("HumanoidRootPart") :: BasePart
		c.lastSeenPosition = root.Position
		if state ~= "Chase" and (seenDistance < 25 or state == "Investigate" or state == "Search") then
			setState(c, "Chase")
		elseif state == "Patrol" then
			startInvestigate(c, root.Position)
		end
	end
	local noise = c.pendingNoise
	c.pendingNoise = nil
	if noise and state ~= "Chase" and state ~= "Attack" and state ~= "Retreat" then
		if state == "Investigate" or state == "Search" then
			c.target = noise.position -- update the goal, keep moving
			if state == "Search" then
				setState(c, "Investigate")
			end
		elseif state ~= "Listen" then
			startInvestigate(c, noise.position)
		end
	end

	state = c.state
	elapsed = now - c.stateTime

	if state == "Patrol" then
		if not c.target then
			c.target = pickPatrolNode(c, nil, nil)
		end
		if c.target and moveTowards(c, c.target, CC.PatrolSpeed) then
			c.target = pickPatrolNode(c, nil, nil)
		end
	elseif state == "Listen" then
		stop(c)
		if elapsed > CC.ListenTime then
			setState(c, "Investigate")
		end
	elseif state == "Investigate" then
		if not c.target or moveTowards(c, c.target, CC.InvestigateSpeed) then
			c.searchCenter = c.target or c.root.Position
			setState(c, "Search")
		end
	elseif state == "Search" then
		if elapsed > CC.SearchTime then
			setState(c, "Patrol")
			c.target = nil
		else
			if not c.target or moveTowards(c, c.target, CC.PatrolSpeed + 1) then
				c.target = pickPatrolNode(c, c.searchCenter, 45) or c.searchCenter
			end
		end
	elseif state == "Chase" then
		local player = c.targetPlayer
		local character = player and player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not player or not root or player:GetAttribute("FZ_Downed") or not player:GetAttribute("FZ_InGame") then
			c.searchCenter = c.lastSeenPosition or c.root.Position
			setState(c, "Search")
			return
		end
		if now - c.lastSeen > CC.LoseTrackTime then
			c.searchCenter = c.lastSeenPosition
			c.target = c.lastSeenPosition
			-- Sometimes it takes the vents instead of following
			if ventsEnabled and c.lastSeenPosition and math.random() < difficulty.ventChance and (c.lastSeenPosition - c.root.Position).Magnitude > 40 then
				task.spawn(travelVent, c, c.lastSeenPosition)
				return
			end
			setState(c, "Investigate")
			return
		end
		local goal = if now - c.lastSeen < 0.5 then root.Position else (c.lastSeenPosition or root.Position)
		moveTowards(c, goal, CC.ChaseSpeed, 0.6)
		if (root.Position - c.root.Position).Magnitude <= CC.AttackRange and now >= c.nextAttack then
			setState(c, "Attack")
		end
	elseif state == "Attack" then
		local player = c.targetPlayer
		local root = player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		c.humanoid.WalkSpeed = 2
		if root then
			face(c, root.Position)
		end
		if elapsed >= CC.AttackWindup then
			if player and root and (root.Position - c.root.Position).Magnitude <= CC.AttackRange + 1.5 then
				HealthService.Damage(player, CC.Damage)
				Net.Event("Sfx"):FireAllClients("creature_static_burst", c.root)
			end
			c.nextAttack = now + CC.AttackCooldown
			setState(c, "Chase")
		end
	elseif state == "Retreat" then
		if not c.target or moveTowards(c, c.target, CC.InvestigateSpeed) or elapsed > 8 then
			setState(c, "Patrol")
			c.target = nil
		end
	end

	-- Observer set: fresh tracks
	if c.state ~= "Vent" and now - c.lastFootprint > 1.6 and c.root.AssemblyLinearVelocity.Magnitude > 2 then
		c.lastFootprint = now
		for _, player in Players:GetPlayers() do
			if player:GetAttribute("FZ_Footprints") then
				Net.Event("Footprint"):FireClient(player, c.root.Position - Vector3.new(0, 5.6, 0))
			end
		end
	end
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------
local function loadTracks(c: Creature)
	local animator = c.humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	for name, id in Assets.CreatureAnimations do
		if id ~= "" then
			local animation = Instance.new("Animation")
			animation.AnimationId = id
			local ok, track = pcall(animator.LoadAnimation, animator, animation)
			if ok then
				track.Looped = name ~= "Attack"
				c.tracks[name] = track
			end
		end
	end
end

function CreatureService.Despawn()
	for _, c in creatures do
		c.model:Destroy()
	end
	table.clear(creatures)
end

-- keepExisting = true adds another creature (survival escalation).
function CreatureService.Spawn(cframe: CFrame?, keepExisting: boolean?): Model
	if not keepExisting then
		CreatureService.Despawn()
	end
	local spawnCFrame = cframe
	if not spawnCFrame then
		local marker = CollectionService:GetTagged("FZ_CreatureSpawn")[1]
		spawnCFrame = if marker and marker:IsA("BasePart") then marker.CFrame else CFrame.new(0, 10, 0)
	end
	local model = Rig.Create()
	model:PivotTo(spawnCFrame :: CFrame)
	pcall(function()
		model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end)
	model.Parent = workspace
	Rig.Tag(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local c: Creature = {
		model = model,
		humanoid = humanoid,
		root = root,
		state = "",
		stateTime = os.clock(),
		target = nil,
		targetPlayer = nil,
		lastSeen = 0,
		lastSeenPosition = nil,
		waypoints = {},
		waypointIndex = 1,
		pathTarget = nil,
		nextRepath = 0,
		nextAttack = 0,
		blindReadyAt = 0,
		visitedPatrol = {},
		searchCenter = nil,
		pendingNoise = nil,
		tracks = {},
		lastFootprint = 0,
	}
	loadTracks(c)
	table.insert(creatures, c)
	setState(c, if aiEnabled then "Patrol" else "Dormant")

	task.spawn(function()
		while alive(c) do
			if aiEnabled then
				local ok, err = pcall(step, c)
				if not ok then
					warn("[FZ-Creature] AI step failed: " .. tostring(err))
				end
			end
			task.wait(TICK)
		end
	end)
	return model
end

function CreatureService.SetAIEnabled(enabled: boolean)
	aiEnabled = enabled
	for _, c in creatures do
		if enabled then
			setState(c, "Patrol")
		else
			setState(c, "Dormant")
			stop(c)
		end
	end
end

-- speed / hearing multipliers and vent chance (survival difficulty curve)
function CreatureService.SetDifficulty(values: { speed: number?, hearing: number?, ventChance: number? })
	if next(values) == nil then
		difficulty.sight = 1
		ventsEnabled = true
	end
	difficulty.speed = values.speed or 1
	difficulty.hearing = values.hearing or 1
	difficulty.ventChance = values.ventChance or CC.VentChance
end

function CreatureService.SetVentsEnabled(value: boolean)
	ventsEnabled = value
end

function CreatureService.SetSightScale(value: number)
	difficulty.sight = value
end

function CreatureService.IsChasingNear(position: Vector3, radius: number): boolean
	for _, c in creatures do
		if (c.state == "Chase" or c.state == "Attack") and (c.root.Position - position).Magnitude < radius then
			return true
		end
	end
	return false
end

function CreatureService.Count(): number
	return #creatures
end

function CreatureService.IsAIEnabled(): boolean
	return aiEnabled
end

function CreatureService.Get(): Model?
	return creatures[1] and creatures[1].model
end

-- Loud event somewhere: the nearest creature that is not busy comes to look.
function CreatureService.Alert(position: Vector3)
	local best, bestDistance = nil, math.huge
	for _, c in creatures do
		if c.state ~= "Chase" and c.state ~= "Vent" and c.state ~= "Dormant" then
			local d = (c.root.Position - position).Magnitude
			if d < bestDistance then
				best, bestDistance = c, d
			end
		end
	end
	if best and aiEnabled then
		startInvestigate(best, position)
	end
end

function CreatureService.Start()
	NoiseService.Heard:Connect(function(position, radius, _source)
		for _, c in creatures do
			if not c.model:GetAttribute("Hidden") then
				local distance = (position - c.root.Position).Magnitude
				if distance <= radius * CC.HearingScale * difficulty.hearing then
					local current = c.pendingNoise
					if not current or radius > current.radius then
						c.pendingNoise = { position = position, radius = radius }
					end
				end
			end
		end
	end)

	-- Flashlight: the client reports a hit, the server re-validates everything.
	local limiter = RateLimiter.new(4, 2)
	local function tryBlind(player: Player, c: Creature): boolean
		if os.clock() < c.blindReadyAt or c.state == "Vent" or c.state == "Blinded" or c.state == "Dormant" then
			return false
		end
		local character = player.Character
		local head = character and character:FindFirstChild("Head") :: BasePart?
		local light = head and head:FindFirstChild("FZ_Flashlight") :: SpotLight?
		if not head or not light or not light.Enabled or player:GetAttribute("FZ_Downed") then
			return false
		end
		local eye = eyePosition(c)
		local range = CC.BlindRange * (tonumber(player:GetAttribute("FZ_FlashRange")) or 1)
		local toCreature = eye - head.Position
		if toCreature.Magnitude > range then
			return false
		end
		local facing = flat((character :: Model):GetPivot().LookVector)
		local direction = flat(toCreature)
		if facing.Magnitude > 0 and direction.Magnitude > 0 and facing.Unit:Dot(direction.Unit) < math.cos(math.rad(60)) then
			return false
		end
		if not hasLineOfSight(c, head.Position, eye, { character :: Model }) then
			return false
		end
		local cooldown = CC.BlindCooldown * (tonumber(player:GetAttribute("FZ_BlindCooldownScale")) or 1)
		c.blindReadyAt = os.clock() + cooldown
		setState(c, "Blinded")
		stop(c)
		Net.Event("Sfx"):FireAllClients("creature_static_burst", c.root)
		return true
	end

	Net.Event("FlashCreature").OnServerEvent:Connect(function(player: Player)
		if not limiter:Allow(player) or not aiEnabled then
			return
		end
		for _, c in creatures do
			if tryBlind(player, c) then
				return
			end
		end
	end)
end

return CreatureService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- DataService: persistent player data with session locking.
--
-- * One profile per player, loaded with UpdateAsync and locked to this server (JobId),
--   so two servers can never write the same save at the same time (protects codes,
--   currency and progress against duplication when a player hops servers quickly).
-- * Autosave refreshes the lock; leaving releases it.
-- * If DataStores are unavailable (Studio without API access, outage) the player gets a
--   session-only profile and is told that progress will not be saved. Anything that must
--   persist (code rewards, purchases) refuses to run on such a profile.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Updates = require(Shared.Updates)
local Signal = require(Shared.Signal)
local Net = require(Shared.Net)

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local AnalyticsTracker = require(script.Parent.AnalyticsTracker)

local DataService = {}
DataService.ProfileLoaded = Signal.new() -- (player, profile)

export type Profile = {
	Player: Player,
	Key: string,
	Data: { [string]: any },
	Persistent: boolean,
	Dirty: boolean,
	Saving: boolean,
	Released: boolean,
}

local profiles: { [Player]: Profile } = {}
local store: DataStore? = nil

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Data.StoreName)
	end)
	if ok then
		store = result
	else
		warn("[FZ-Data] DataStore unavailable, running session-only: " .. tostring(result))
	end
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

local function defaultData(): { [string]: any }
	return {
		version = Config.Data.SchemaVersion,
		settings = Config.DefaultSettings(),
		signalMarks = 0,
		redeemedCodes = {}, -- [codeId] = unix time
		progress = {
			chapter = 1,
			checkpoint = "C1_START",
			completedChapters = {}, -- [chapterId] = unix time of first completion
		},
		modes = {
			survival = {}, -- [survivalMapId] = { best = shifts, runs = n }
		},
		seenContent = {}, -- [contentId] = true (NEW badges)
		storyChoices = {}, -- [decisionId] = option index chosen by the team
		secrets = {
			forecastsBroken = {}, -- [forecastId] = true
			logs = {}, -- [logId] = unix time (archive entries)
			photos = {}, -- [photoId] = { area, date, kind } (no images, no other players)
			solved = {}, -- [secretId] = unix time (community secrets)
		},
		achievements = {}, -- [achievementId] = unix time
		community = {}, -- { claimed = unix time }
		referral = {}, -- { by = inviterUserId, rewarded = time, rewardedInvites = n }
		lastSeenUpdate = "", -- newest update id the player opened in "What's new"
		lastSession = {}, -- { placeId, jobId, code?, time } for "back to your team" after a disconnect
		stats = { sessions = 0, firstJoin = os.time(), lastJoin = 0 },
		inventory = {}, -- [itemId] = true
		equipped = {}, -- { set = itemId?, radioSkin = itemId? }
	}
end

local function reconcile(data: { [string]: any }, template: { [string]: any })
	for key, value in template do
		if data[key] == nil then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil then
			reconcile(data[key], value)
		end
	end
end

local function sanitizeSettings(settings: { [string]: any })
	for key, definition in Config.Settings do
		local value = settings[key]
		if value ~= nil then
			local ok = Config.ValidateSetting(key, value)
			if not ok then
				settings[key] = definition.default
			end
		end
	end
	for key in settings do
		if Config.Settings[key] == nil then
			settings[key] = nil
		end
	end
end

-- Schema migrations. Rules (docs/UPDATES.md):
--   * one function per version step, executed in order, never edited after release
--   * only ADD or TRANSFORM data - never delete currency, inventory or progress
--   * new fields with simple defaults need no migration: reconcile() adds them
local MIGRATIONS: { [number]: (data: { [string]: any }) -> () } = {
	-- v1 -> v2: chapter progress by id instead of number, survival stats, NEW badges
	[2] = function(data)
		data.progress = data.progress or {}
		local completed = {}
		for _, number in data.progress.completed or {} do
			if type(number) == "number" then
				completed["ch" .. number] = os.time()
			end
		end
		data.progress.completedChapters = completed
		data.progress.completed = nil
	end,
}

local function migrate(data: { [string]: any })
	local version = tonumber(data.version) or 1
	for target = version + 1, Config.Data.SchemaVersion do
		local step = MIGRATIONS[target]
		if step then
			step(data)
		end
		data.version = target
	end
end

local function prepare(data: { [string]: any })
	migrate(data)
	reconcile(data, defaultData())
	if type(data.settings) ~= "table" then
		data.settings = Config.DefaultSettings()
	end
	sanitizeSettings(data.settings)
	if type(data.signalMarks) ~= "number" or data.signalMarks ~= data.signalMarks or data.signalMarks < 0 then
		data.signalMarks = 0
	end
	data.signalMarks = math.floor(data.signalMarks)
end

local function withRetries(label: string, attempts: number, callback: () -> any): (boolean, any)
	local delayTime = 1
	for attempt = 1, attempts do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		warn(string.format("[FZ-Data] %s failed (attempt %d/%d): %s", label, attempt, attempts, tostring(result)))
		if attempt < attempts then
			task.wait(delayTime)
			delayTime = math.min(delayTime * 2, 8)
		end
	end
	return false, nil
end

local function publishAttributes(profile: Profile)
	local player = profile.Player
	player:SetAttribute("FZ_SignalMarks", profile.Data.signalMarks)
	player:SetAttribute("FZ_DataPersistent", profile.Persistent)
end

local function loadProfile(player: Player): Profile?
	local key = "u_" .. player.UserId
	local profile: Profile = {
		Player = player,
		Key = key,
		Data = {},
		Persistent = false,
		Dirty = false,
		Saving = false,
		Released = false,
	}

	local loaded = nil
	if store then
		local maxLockAttempts = 6
		for lockAttempt = 1, maxLockAttempts do
			local lockedByOther = false
			local tooNew = false
			local ok, result = withRetries("Load " .. key, 4, function()
				return (store :: DataStore):UpdateAsync(key, function(old)
					lockedByOther = false
					local data = if type(old) == "table" then old else defaultData()
					local lock = data.lock
					if
						type(lock) == "table"
						and lock.job ~= game.JobId
						and os.time() - (tonumber(lock.time) or 0) < Config.Data.LockTimeout
						and lockAttempt < maxLockAttempts
					then
						-- Another server still owns this save (usually: it is finishing the
						-- save after the player left). Abort this write and retry shortly.
						lockedByOther = true
						return nil
					end
					if (tonumber(data.version) or 1) > Config.Data.SchemaVersion then
						-- Saved by a NEWER server version (rolling update). This old server
						-- must never write it back, or new fields could be lost.
						tooNew = true
						return nil
					end
					prepare(data)
					data.lock = { job = game.JobId, time = os.time() }
					data.stats.sessions += 1
					data.stats.lastJoin = os.time()
					return data
				end)
			end)
			if not ok then
				break
			end
			if tooNew then
				player:SetAttribute("FZ_DataTooNew", true)
				break
			end
			if not lockedByOther and type(result) == "table" then
				loaded = result
				break
			end
			if player.Parent == nil then
				return nil
			end
			task.wait(5)
		end
	end

	if loaded then
		profile.Data = loaded
		profile.Persistent = true
	else
		profile.Data = defaultData()
		profile.Persistent = false
		if store then
			warn("[FZ-Data] Using session-only profile for " .. key)
		end
	end
	return profile
end

local function saveProfile(profile: Profile, release: boolean): boolean
	if not profile.Persistent or not store then
		return true
	end
	while profile.Saving do
		task.wait()
	end
	if profile.Released then
		return true
	end
	profile.Saving = true
	local lostLock = false
	local wasDirty = profile.Dirty
	local ok = withRetries("Save " .. profile.Key, if release then 5 else 3, function()
		return (store :: DataStore):UpdateAsync(profile.Key, function(old)
			lostLock = false
			if type(old) == "table" and type(old.lock) == "table" and old.lock.job ~= game.JobId then
				lostLock = true
				return nil
			end
			local out = table.clone(profile.Data)
			out.lock = if release then nil else { job = game.JobId, time = os.time() }
			return out
		end)
	end)
	profile.Saving = false
	if lostLock then
		-- Another server took this save over. Never overwrite it from here.
		warn("[FZ-Data] Lost session lock for " .. profile.Key .. "; profile is now read-only")
		profile.Persistent = false
		publishAttributes(profile)
		return false
	end
	if ok then
		if wasDirty then
			profile.Dirty = false
		end
		if release then
			profile.Released = true
		end
	end
	return ok
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function DataService.Get(player: Player): Profile?
	return profiles[player]
end

function DataService.WaitFor(player: Player, timeout: number?): Profile?
	local deadline = os.clock() + (timeout or 20)
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

-- Mutate data through this function so the profile is marked dirty.
function DataService.Mutate(player: Player, mutator: ({ [string]: any }) -> ()): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	mutator(profile.Data)
	profile.Dirty = true
	publishAttributes(profile)
	return true
end

-- Adds earned Signal Marks (never negative) and tells the player.
function DataService.Grant(player: Player, amount: number): boolean
	if amount <= 0 then
		return false
	end
	local ok = DataService.Mutate(player, function(data)
		data.signalMarks += math.floor(amount)
	end)
	if ok then
		Net.Event("Notify"):FireClient(player, "REWARD_MARKS", { amount = math.floor(amount) })
		local profile = profiles[player]
		AnalyticsTracker.Economy(player, amount, if profile then profile.Data.signalMarks else 0, true, "Gameplay")
	end
	return ok
end

-- Immediate save for important changes (code rewards, chapter completion).
function DataService.SaveNow(player: Player): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	return saveProfile(profile, false)
end

function DataService.Start()
	local fetchLimiter = RateLimiter.new(3, 0.2)

	local function onPlayerAdded(player: Player)
		local profile = loadProfile(player)
		if not profile then
			return
		end
		if player.Parent == nil then
			-- Left while loading: release the lock right away.
			saveProfile(profile, true)
			return
		end
		profiles[player] = profile
		publishAttributes(profile)
		player:SetAttribute("FZ_NewPlayer", profile.Data.stats.sessions <= 1)
		if profile.Data.stats.sessions <= 1 then
			AnalyticsTracker.Onboarding(player, 1, "ProfileLoaded")
		end
		player:SetAttribute("FZ_DataReady", true)
		DataService.ProfileLoaded:Fire(player, profile)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		local profile = profiles[player]
		if profile then
			saveProfile(profile, true)
			profiles[player] = nil
		end
		AnalyticsTracker.Forget(player)
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for _, profile in profiles do
			pending += 1
			task.spawn(function()
				saveProfile(profile, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveInterval)
			for _, profile in profiles do
				-- Always save: this also refreshes the session lock.
				task.spawn(saveProfile, profile, false)
			end
		end
	end)

	-- NEW badges: the client reports what the player has opened (validated ids only).
	local seenLimiter = RateLimiter.new(10, 2)
	local validIds = {}
	for _, id in Content.AllIds() do
		validIds[id] = true
	end
	Net.Event("MarkSeen").OnServerEvent:Connect(function(player: Player, id: any)
		if type(id) ~= "string" or not seenLimiter:Allow(player) then
			return
		end
		local updateId = string.match(id, "^update:(.+)$")
		if updateId then
			for _, update in Updates do
				if update.id == updateId then
					DataService.Mutate(player, function(data)
						data.lastSeenUpdate = updateId
					end)
				end
			end
		elseif validIds[id] then
			DataService.Mutate(player, function(data)
				data.seenContent[id] = true
			end)
		end
	end)

	Net.Function("FetchProfile").OnServerInvoke = function(player: Player)
		if not fetchLimiter:Allow(player) then
			return nil
		end
		local profile = DataService.WaitFor(player, 20)
		if not profile then
			return nil
		end
		local data = profile.Data
		return {
			settings = deepCopy(data.settings),
			signalMarks = data.signalMarks,
			progress = { chapter = data.progress.chapter, completedChapters = deepCopy(data.progress.completedChapters) },
			survival = deepCopy(data.modes.survival),
			seenContent = deepCopy(data.seenContent),
			lastSeenUpdate = data.lastSeenUpdate,
			secrets = deepCopy(data.secrets),
			achievements = deepCopy(data.achievements),
			storyChoices = deepCopy(data.storyChoices),
			inventory = deepCopy(data.inventory),
			equipped = deepCopy(data.equipped),
			persistent = profile.Persistent,
			isNew = data.stats.sessions <= 1,
		}
	end
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">DecisionService</string>
            <string name="Source"><![CDATA[-- DecisionService: team decisions with consequences ("Entscheiden -> Konsequenzen").
--   * Every player in the session votes (big buttons, works with touch/gamepad/mouse).
--   * Majority wins; a tie goes to the option that got its first vote earliest;
--     nobody votes -> the default option. Solo: your vote decides immediately.
--   * The result is stored in the session (StoryService flag "Choice_<id>") AND in every
--     participant's save (data.storyChoices[id]) so later chapters and endings react.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)
local StoryService = require(script.Parent.StoryService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local DecisionService = {}

export type Decision = {
	id: string,
	prompt: string, -- localization key
	promptParams: { [string]: any }?,
	tieBreak: number?, -- option chosen on a tie (e.g. "evacuate" - nobody can sabotage alone)
	options: { string }, -- localization keys
	seconds: number,
	default: number,
	onDecided: (index: number) -> (),
}

type Running = {
	decision: Decision,
	votes: { [Player]: number },
	firstVoteAt: { [number]: number },
	ends: number,
	token: number,
	voters: () -> { Player },
}

local running: Running? = nil
local token = 0
local external: { [string]: (player: Player, id: string, index: number) -> () } = {}

-- Other systems can reuse the vote panel for their own questions (id prefix "party:" ...).
function DecisionService.RegisterExternal(prefix: string, handler: (player: Player, id: string, index: number) -> ())
	external[prefix] = handler
end

local function payload(r: Running)
	local counts = {}
	for index in r.decision.options do
		counts[index] = 0
	end
	for _, index in r.votes do
		counts[index] += 1
	end
	return {
		id = r.decision.id,
		prompt = r.decision.prompt,
		promptParams = r.decision.promptParams,
		options = r.decision.options,
		ends = r.ends,
		counts = counts,
		voters = #r.voters(),
	}
end

local function finish(r: Running)
	if running ~= r then
		return
	end
	running = nil
	Net.Event("Decision"):FireAllClients(nil)
	local counts = payload(r).counts
	local best, bestCount, bestTime = r.decision.default, 0, math.huge
	for index, count in counts do
		local first = r.firstVoteAt[index] or math.huge
		if count > bestCount or (count == bestCount and count > 0 and first < bestTime) then
			best, bestCount, bestTime = index, count, first
		end
	end
	if r.decision.tieBreak then
		local top, tied = 0, 0
		for _, count in counts do
			if count > top then
				top, tied = count, 1
			elseif count == top and count > 0 then
				tied += 1
			end
		end
		if tied > 1 then
			best = r.decision.tieBreak
		end
	end
	StoryService.SetFlag("Choice_" .. r.decision.id, best)
	for _, player in r.voters() do
		DataService.Mutate(player, function(data)
			data.storyChoices[r.decision.id] = best
		end)
	end
	r.decision.onDecided(best)
end

function DecisionService.IsOpen(): boolean
	return running ~= nil
end

function DecisionService.Cancel()
	token += 1
	if running then
		running = nil
		Net.Event("Decision"):FireAllClients(nil)
	end
end

-- voters: function returning the players allowed to vote (players in the session)
function DecisionService.Ask(decision: Decision, voters: () -> { Player })
	DecisionService.Cancel()
	token += 1
	local r: Running = {
		decision = decision,
		votes = {},
		firstVoteAt = {},
		ends = workspace:GetServerTimeNow() + decision.seconds,
		token = token,
		voters = voters,
	}
	running = r
	Net.Event("Decision"):FireAllClients(payload(r))
	task.delay(decision.seconds, function()
		if running == r then
			finish(r)
		end
	end)
end

function DecisionService.Start()
	local limiter = RateLimiter.new(4, 1)
	Net.Event("DecisionVote").OnServerEvent:Connect(function(player: Player, id: any, index: any)
		if type(id) == "string" and type(index) == "number" then
			local prefix = string.match(id, "^(%w+):")
			if prefix and external[prefix] then
				if limiter:Allow(player) then
					external[prefix](player, id, index)
				end
				return
			end
		end
		local r = running
		if not r or not limiter:Allow(player) or id ~= r.decision.id or type(index) ~= "number" then
			return
		end
		if index % 1 ~= 0 or index < 1 or index > #r.decision.options then
			return
		end
		if not table.find(r.voters(), player) then
			return
		end
		r.votes[player] = index
		r.firstVoteAt[index] = r.firstVoteAt[index] or os.clock()
		local everyone = true
		for _, voter in r.voters() do
			if r.votes[voter] == nil then
				everyone = false
			end
		end
		if everyone then
			finish(r)
		else
			Net.Event("Decision"):FireAllClients(payload(r))
		end
	end)
end

return DecisionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">DirectorService</string>
            <string name="Source"><![CDATA[-- DirectorService ("HorrorDirector"): decides WHEN a scare happens, so scares stay earned.
--   * Global gap between scares (70 s) and per-player gap (60 s) against habituation
--   * Never the same scare type twice in a row; nothing while a creature is chasing
--   * Many beats target ONE player only ("Did you see that too?")
--   * Optional hints when the team is stuck on an objective for a long time
-- The visual/audio side runs on the clients (DirectorController), scaled by each
-- player's own "Scare intensity" setting.

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local StoryService = require(script.Parent.StoryService)
local CreatureService = require(script.Parent.CreatureService)

local DirectorService = {}

local GLOBAL_GAP = 70
local PLAYER_GAP = 60
local HINT_AFTER = 150

export type Beat = {
	id: string,
	kind: string, -- see DirectorController for all kinds
	once: boolean?,
	weight: number?, -- relative chance among the eligible beats (default 1)
	cooldown: number?, -- seconds before this beat may happen again (default 120)
	chance: number?, -- 0..1 extra rarity roll per check (default 1)
	condition: (player: Player, info: { [string]: any }) -> boolean,
	data: ((player: Player) -> { [string]: any })?,
	others: boolean?, -- also notify the other players (for "cctv": they see it WITHOUT the figure)
}

local beats: { Beat } = {}
local used: { [string]: boolean } = {}
local lastFired: { [string]: number } = {}
local lastGlobal = 0
local lastKind: string? = nil
local lastForPlayer: { [Player]: number } = {}
local hints: { [string]: string } = {}
local objectiveSince = os.clock()
local lastObjective: any = nil
local lastHint = 0
local enabled = false
local playersInGame: (() -> { Player })? = nil

function DirectorService.AreaOf(position: Vector3): string?
	local best, bestDistance = nil, 45
	for _, node in CollectionService:GetTagged("FZ_CreaturePatrol") do
		if node:IsA("BasePart") then
			local d = (node.Position - position).Magnitude
			if d < bestDistance then
				best, bestDistance = node:GetAttribute("Area"), d
			end
		end
	end
	return best
end

-- Called by a mode when it begins / stops.
function DirectorService.Configure(newBeats: { Beat }, newHints: { [string]: string }, voters: () -> { Player })
	beats = newBeats
	hints = newHints
	playersInGame = voters
	table.clear(used)
	table.clear(lastFired)
	table.clear(lastForPlayer)
	lastGlobal = os.clock() - GLOBAL_GAP + 45 -- first scare no earlier than ~45 s in
	lastKind = nil
	objectiveSince = os.clock()
	lastHint = 0
	enabled = true
end

function DirectorService.Stop()
	enabled = false
	beats = {}
	hints = {}
end

local function fire(beat: Beat, player: Player)
	used[beat.id] = true
	lastFired[beat.id] = os.clock()
	lastGlobal = os.clock()
	lastKind = beat.kind
	lastForPlayer[player] = os.clock()
	local data = if beat.data then beat.data(player) else {}
	Net.Event("Scare"):FireClient(player, beat.kind, data)
	if beat.others and playersInGame then
		local quiet = table.clone(data)
		quiet.withFigure = false
		for _, other in playersInGame() do
			if other ~= player then
				Net.Event("Scare"):FireClient(other, beat.kind, quiet)
			end
		end
	end
end

local function nearestTeammate(player: Player, players: { Player }): number
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local best = math.huge
	if not root then
		return best
	end
	for _, other in players do
		local otherRoot = other ~= player and other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if otherRoot then
			best = math.min(best, (otherRoot.Position - root.Position).Magnitude)
		end
	end
	return best
end

-- Is a tagged object (window, speaker...) within [minDistance, maxDistance] of a position?
function DirectorService.NearTagged(tagName: string, position: Vector3, minDistance: number, maxDistance: number): boolean
	for _, instance in CollectionService:GetTagged(tagName) do
		if instance:IsA("BasePart") then
			local d = (instance.Position - position).Magnitude
			if d >= minDistance and d <= maxDistance then
				return true
			end
		end
	end
	return false
end

function DirectorService.Start()
	task.spawn(function()
		while true do
			task.wait(0.5)
			if not enabled or not playersInGame then
				continue
			end
			local now = os.clock()
			local players = playersInGame()

			-- Hints when stuck
			local objective = SessionState.Get("Objective")
			if objective ~= lastObjective then
				lastObjective = objective
				objectiveSince = now
			elseif type(objective) == "string" and hints[objective] and now - objectiveSince > HINT_AFTER and now - lastHint > HINT_AFTER then
				lastHint = now
				StoryService.Say("all", { speaker = "SPEAKER_RELAY", text = hints[objective], channel = "radio", duration = 5 })
			end

			-- Security cameras: where is the creature?
			if SessionState.Get("Cameras") then
				local creature = CreatureService.Get()
				local root = creature and creature:FindFirstChild("HumanoidRootPart") :: BasePart?
				SessionState.Set("CctvArea", if root then DirectorService.AreaOf(root.Position) or "?" else "-")
			end

			if now - lastGlobal < GLOBAL_GAP then
				continue
			end
			for _, player in players do
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root and not player:GetAttribute("FZ_Downed") and now - (lastForPlayer[player] or 0) > PLAYER_GAP and not CreatureService.IsChasingNear(root.Position, 60) then
					local info = {
						position = root.Position,
						area = DirectorService.AreaOf(root.Position),
						alone = nearestTeammate(player, players) > 25,
					}
					-- Weighted pick among everything that is allowed right now.
					local eligible, total = {}, 0
					for _, beat in beats do
						local cooled = now - (lastFired[beat.id] or -math.huge) > (beat.cooldown or 120)
						if not (beat.once and used[beat.id]) and cooled and beat.kind ~= lastKind and math.random() <= (beat.chance or 1) then
							local ok, allowed = pcall(beat.condition, player, info)
							if ok and allowed then
								table.insert(eligible, beat)
								total += beat.weight or 1
							end
						end
					end
					if #eligible > 0 then
						local roll = math.random() * total
						for _, beat in eligible do
							roll -= beat.weight or 1
							if roll <= 0 then
								fire(beat, player)
								break
							end
						end
						break
					end
				end
			end
		end
	end)
end

return DirectorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">DoorService</string>
            <string name="Source"><![CDATA[-- DoorService: sliding doors (tag FZ_Door). Opening makes noise; locked doors buzz.
-- The creature opens unlocked doors in its way (CreatureService calls Open).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local InteractionService = require(script.Parent.InteractionService)
local NoiseService = require(script.Parent.NoiseService)

local DoorService = {}

local TWEEN = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
local busy: { [Instance]: boolean } = {}

local function setOpen(panel: BasePart, open: boolean)
	if busy[panel] or panel:GetAttribute("Open") == open then
		return
	end
	busy[panel] = true
	panel:SetAttribute("Open", open)
	local target = panel:GetAttribute(if open then "OpenCFrame" else "ClosedCFrame")
	Net.Event("Sfx"):FireAllClients("door_open", panel.Position)
	NoiseService.Emit(panel.Position, Config.Noise.Door, nil)
	local tween = TweenService:Create(panel, TWEEN, { CFrame = target })
	tween.Completed:Once(function()
		busy[panel] = nil
	end)
	tween:Play()
end

function DoorService.Open(panel: BasePart)
	if not panel:GetAttribute("Locked") then
		setOpen(panel, true)
	end
end

function DoorService.Close(panel: BasePart)
	setOpen(panel, false)
end

function DoorService.SetLocked(panel: BasePart, locked: boolean)
	panel:SetAttribute("Locked", locked)
	local stripe = panel:FindFirstChild("Stripe")
	if stripe and stripe:IsA("BasePart") then
		stripe.Color = if locked then Color3.fromRGB(200, 40, 30) else Color3.fromRGB(90, 220, 140)
	end
	local modifier = panel:FindFirstChildOfClass("PathfindingModifier")
	if modifier then
		modifier.PassThrough = not locked
	end
	if locked and panel:GetAttribute("Open") then
		setOpen(panel, false)
	end
end

function DoorService.CloseAll()
	for _, panel in CollectionService:GetTagged("FZ_Door") do
		if panel:IsA("BasePart") then
			setOpen(panel, false)
		end
	end
end

function DoorService.Start()
	InteractionService.Register("door", function(player, panel)
		if not panel:IsA("BasePart") then
			return
		end
		if panel:GetAttribute("Locked") then
			Net.Event("Sfx"):FireAllClients("door_locked", panel.Position)
			Net.Event("Notify"):FireClient(player, "DOOR_LOCKED")
			return
		end
		setOpen(panel, not panel:GetAttribute("Open"))
	end)
end

return DoorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">EvidenceService</string>
            <string name="Source"><![CDATA[-- EvidenceService: supernatural photographs.
-- Photos are physical objects (tag FZ_Interactable, InteractId "photo", attributes PhotoId +
-- Kind). When picked up, the server decides WHAT the photo shows from real session context:
--   past_self   : you, in the area where you actually were about five minutes ago
--   team_future : your team in front of a place you have not reached yet
--   mate_dark   : a teammate standing in a dark corridor (solo: you, with someone behind)
-- The client renders it live from avatar copies (ViewportFrame) - no screenshots, nothing
-- stored except the photo id and an area name. No personal data is evaluated.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local InteractionService = require(script.Parent.InteractionService)
local DirectorService = require(script.Parent.DirectorService)
local DataService = require(script.Parent.DataService)
local LoreService = require(script.Parent.LoreService)

local EvidenceService = {}

local HISTORY_SECONDS = 600
local history: { [Player]: { { time: number, area: string } } } = {}

local FUTURE_AREA_BY_OBJECTIVE = {
	OBJECTIVE_CHECK_GATEHOUSE = "CONTROL",
	OBJECTIVE_REACH_CONTROL = "CONTROL",
	OBJECTIVE_POWER = "B",
	OBJECTIVE_FIND_FUSES = "B",
	OBJECTIVE_RELAY_B = "CORE",
	OBJECTIVE_CORE = "CORE",
	OBJECTIVE_ANTENNA = "ANTENNA",
}

local function areaAgo(player: Player, seconds: number): string?
	local list = history[player]
	if not list or #list == 0 then
		return nil
	end
	local target = os.clock() - seconds
	local best = list[1]
	for _, entry in list do
		if entry.time <= target then
			best = entry
		end
	end
	return best.area
end

local function randomPastDate(): string
	-- somewhere between 1979 (station built) and the night of 2009
	local year = math.random(1979, 2009)
	return string.format("%02d.%02d.%d", math.random(1, 28), math.random(1, 12), year)
end

function EvidenceService.Start()
	-- coarse movement history (area names only, every 5 s, 10 minutes)
	task.spawn(function()
		while true do
			task.wait(5)
			for _, player in Players:GetPlayers() do
				local root = player:GetAttribute("FZ_InGame") and player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root then
					local area = DirectorService.AreaOf(root.Position)
					if area then
						local list = history[player] or {}
						history[player] = list
						table.insert(list, { time = os.clock(), area = area })
						while list[1] and os.clock() - list[1].time > HISTORY_SECONDS do
							table.remove(list, 1)
						end
					end
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		history[player] = nil
	end)

	InteractionService.Register("photo", function(player, object)
		local id = object:GetAttribute("PhotoId")
		local kind = object:GetAttribute("Kind")
		if type(id) ~= "string" or type(kind) ~= "string" then
			return
		end
		local photo = { id = id, kind = kind, date = randomPastDate(), subjects = { player.UserId } }
		if kind == "past_self" then
			photo.area = areaAgo(player, 300) or areaAgo(player, 60) or "HALL"
		elseif kind == "team_future" then
			photo.area = FUTURE_AREA_BY_OBJECTIVE[SessionState.Get("Objective") or ""] or "CORE"
			for _, other in Players:GetPlayers() do
				if other ~= player and other:GetAttribute("FZ_InGame") then
					table.insert(photo.subjects, other.UserId)
				end
			end
		else -- mate_dark
			photo.area = "HALL"
			local others = {}
			for _, other in Players:GetPlayers() do
				if other ~= player and other:GetAttribute("FZ_InGame") then
					table.insert(others, other)
				end
			end
			if #others > 0 then
				photo.subjects = { others[math.random(1, #others)].UserId }
			else
				photo.figureBehind = true -- solo: you, and something behind you
			end
		end
		Net.Event("Photo"):FireClient(player, photo)
		-- Archive: only id + area are stored (re-rendered with avatars when viewed)
		if LoreService.Unlock(player, id) then
			DataService.Mutate(player, function(data)
				data.secrets.photos[id] = { area = photo.area, date = photo.date, kind = kind }
			end)
		end
	end)
end

return EvidenceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="55">
          <Properties>
            <string name="Name">FlashlightService</string>
            <string name="Source"><![CDATA[-- FlashlightService: replicated flashlight so teammates see each other's light.
-- The owning client additionally renders a camera-aligned local light for precision
-- and mutes its own replicated copy (see FlashlightController).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local FlashlightService = {}

local function attach(character: Model)
	local head = character:WaitForChild("Head", 10)
	if not head or not head:IsA("BasePart") or head:FindFirstChild("FZ_Flashlight") then
		return
	end
	local light = Instance.new("SpotLight")
	light.Name = "FZ_Flashlight"
	light.Face = Enum.NormalId.Front
	light.Angle = 55
	light.Range = 38
	light.Brightness = 2.2
	light.Color = Color3.fromRGB(255, 236, 206)
	light.Shadows = true
	light.Enabled = false
	light.Parent = head
	local player = game:GetService("Players"):GetPlayerFromCharacter(character)
	if player then
		local function color()
			local value = player:GetAttribute("FZ_FlashColor")
			if typeof(value) == "Color3" then
				light.Color = value
			end
		end
		color()
		player:GetAttributeChangedSignal("FZ_FlashColor"):Connect(color)
	end
end

function FlashlightService.Start()
	local limiter = RateLimiter.new(6, 3)
	Net.Event("SetFlashlight").OnServerEvent:Connect(function(player: Player, enabled: any)
		if type(enabled) ~= "boolean" or not limiter:Allow(player) then
			return
		end
		local head = player.Character and player.Character:FindFirstChild("Head")
		local light = head and head:FindFirstChild("FZ_Flashlight")
		if light and light:IsA("SpotLight") then
			light.Enabled = enabled
		end
	end)

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(attach)
		if player.Character then
			task.spawn(attach, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return FlashlightService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="56">
          <Properties>
            <string name="Name">ForecastService</string>
            <string name="Source"><![CDATA[-- ForecastService: the core mechanic "the radio tells you the future - you decide whether
-- it comes true". A forecast has a deadline, a way to break it (an interaction id that
-- must be used in time) and two outcomes. Used by story chapters and survival.
--
-- Replicated for the HUD: SessionState "Forecast" (text key) and "ForecastEnds" (server time).
-- Broken forecasts are remembered per player (secrets / endings), see DataService.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local SessionState = require(Shared.SessionState)

local StoryService = require(script.Parent.StoryService)
local InteractionService = require(script.Parent.InteractionService)
local DataService = require(script.Parent.DataService)
local BadgeTracker = require(script.Parent.BadgeTracker)
local AchievementService = require(script.Parent.AchievementService)

local ForecastService = {}

export type Forecast = {
	id: string, -- permanent id (saved when broken)
	text: string, -- Relay line announcing it
	hud: string, -- short HUD label
	seconds: number,
	breakWith: string, -- InteractId that breaks it
	breakFilter: ((instance: Instance) -> boolean)?, -- e.g. only the breaker of sector C
	onKept: () -> (),
	onBroken: (player: Player) -> (),
	keptLine: string?,
	brokenLine: string?,
}

local active: Forecast? = nil
local token = 0

function ForecastService.IsActive(): boolean
	return active ~= nil
end

function ForecastService.Cancel()
	token += 1
	active = nil
	SessionState.Set("Forecast", nil)
	SessionState.Set("ForecastEnds", nil)
end

function ForecastService.Start(forecast: Forecast)
	ForecastService.Cancel()
	active = forecast
	local current = token
	StoryService.Say("all", { speaker = "SPEAKER_RELAY", text = forecast.text, channel = "radio", duration = 5, critical = true })
	SessionState.Set("Forecast", forecast.hud)
	SessionState.Set("ForecastEnds", workspace:GetServerTimeNow() + forecast.seconds)
	task.delay(forecast.seconds, function()
		if token ~= current or active ~= forecast then
			return
		end
		ForecastService.Cancel()
		forecast.onKept()
		if forecast.keptLine then
			StoryService.Sequence("all", { { delay = 2, speaker = "SPEAKER_RELAY", text = forecast.keptLine, channel = "radio", duration = 3.5 } })
		end
	end)
end

-- Interactions are routed here by InteractionService (see Start).
local function tryBreak(player: Player, instance: Instance, interactId: string)
	local forecast = active
	if not forecast or forecast.breakWith ~= interactId then
		return
	end
	if forecast.breakFilter and not forecast.breakFilter(instance) then
		return
	end
	ForecastService.Cancel()
	forecast.onBroken(player)
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("FZ_InGame") then
			DataService.Grant(p, Config.Rewards.ForecastBroken)
			DataService.Mutate(p, function(data)
				data.secrets.forecastsBroken[forecast.id] = true
			end)
			BadgeTracker.Award(p, "forecast_breaker")
			AchievementService.Award(p, "forecast_breaker")
		end
	end
	if forecast.brokenLine then
		StoryService.Say("all", { speaker = "SPEAKER_RELAY", text = forecast.brokenLine, channel = "radio", duration = 4 })
	end
end

local registered: { [string]: boolean } = {}
-- Make an interaction id able to break forecasts. Safe to call many times.
function ForecastService.Breakable(interactId: string)
	if registered[interactId] then
		return
	end
	registered[interactId] = true
	InteractionService.Register(interactId, function(player, instance)
		tryBreak(player, instance, interactId)
	end)
end

return ForecastService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="57">
          <Properties>
            <string name="Name">HealthService</string>
            <string name="Source"><![CDATA[-- HealthService: damage, downed state and revive. Nobody dies instantly:
--   damage -> downed (crawling) -> a teammate helps up (hold prompt)
--   solo, whole team down, or timeout -> back to the last checkpoint, nothing is lost.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local InteractionService = require(script.Parent.InteractionService)

local HealthService = {}

local HC = Config.Health
local lastDamage: { [Player]: number } = {}
local downedSince: { [Player]: number } = {}
local eliminatedAt: { [Player]: number } = {}
local savedHipHeight: { [Player]: number } = {}

-- Per-session statistics for achievements ("nobody left behind", "last survivor").
HealthService.SessionStats = { eliminated = {} :: { [Player]: boolean } }
function HealthService.ResetSessionStats()
	table.clear(HealthService.SessionStats.eliminated)
end

local function humanoidOf(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function inGamePlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("FZ_InGame") and not player:GetAttribute("FZ_MonsterMode") then
			table.insert(list, player)
		end
	end
	return list
end

function HealthService.IsDowned(player: Player): boolean
	return player:GetAttribute("FZ_Downed") == true
end

function HealthService.IsEliminated(player: Player): boolean
	return player:GetAttribute("FZ_Eliminated") == true
end

local function standing(player: Player): boolean
	return not HealthService.IsDowned(player) and not HealthService.IsEliminated(player)
end

local function setLowered(player: Player, lowered: boolean)
	local humanoid = humanoidOf(player)
	if not humanoid then
		return
	end
	if lowered then
		savedHipHeight[player] = savedHipHeight[player] or humanoid.HipHeight
		humanoid.HipHeight = (savedHipHeight[player] :: number) * 0.35 -- crawling on the floor
		humanoid.JumpHeight = 0
	elseif savedHipHeight[player] then
		humanoid.HipHeight = savedHipHeight[player] :: number
		humanoid.JumpHeight = 7.2
		savedHipHeight[player] = nil
	end
end

local function clearRevivePrompt(player: Player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		CollectionService:RemoveTag(root, "FZ_Interactable")
		local prompt = root:FindFirstChild("FZ_Prompt")
		if prompt then
			prompt:Destroy()
		end
	end
end

function HealthService.Respawn(player: Player)
	downedSince[player] = nil
	eliminatedAt[player] = nil
	savedHipHeight[player] = nil
	player:SetAttribute("FZ_Downed", false)
	player:SetAttribute("FZ_Eliminated", false)
	player:SetAttribute("FZ_DownedUntil", nil)
	clearRevivePrompt(player)
	player:LoadCharacter() -- SessionService places the new character at the checkpoint
end

-- Eliminated players come back at the next checkpoint / survival break (or after a max wait).
function HealthService.ReturnAllEliminated()
	for player in table.clone(eliminatedAt) do
		if player.Parent then
			HealthService.Respawn(player)
		end
	end
end

-- Optional override (survival: a wipe ends the run instead of a checkpoint respawn).
HealthService.TeamWipeHandler = nil :: (() -> ())?

local function checkTeamWipe()
	local players = inGamePlayers()
	if #players == 0 then
		return
	end
	for _, player in players do
		if standing(player) then
			return
		end
	end
	if HealthService.TeamWipeHandler then
		task.delay(2, HealthService.TeamWipeHandler)
		return
	end
	task.delay(3, function()
		for _, player in inGamePlayers() do
			if not standing(player) then
				Net.Event("Notify"):FireClient(player, "HUD_SIGNAL_LOST")
				HealthService.Respawn(player)
			end
		end
	end)
end

local function setDowned(player: Player, humanoid: Humanoid)
	humanoid.Health = 1
	player:SetAttribute("FZ_Downed", true)
	player:SetAttribute("FZ_DownedUntil", workspace:GetServerTimeNow() + HC.DownedTimeout)
	downedSince[player] = os.clock()
	setLowered(player, true)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		root:SetAttribute("InteractId", "revive")
		root:SetAttribute("ActionKey", "INTERACT_REVIVE")
		root:SetAttribute("ObjectKey", "OBJECT_TEAMMATE")
		root:SetAttribute("HoldDuration", HC.ReviveHold)
		root:SetAttribute("MaxDistance", 7)
		CollectionService:AddTag(root, "FZ_Interactable")
	end
	checkTeamWipe()
end

function HealthService.Damage(player: Player, amount: number)
	local humanoid = humanoidOf(player)
	if not humanoid or not standing(player) or player:GetAttribute("FZ_MonsterMode") then
		return
	end
	lastDamage[player] = os.clock()
	Net.Event("Hurt"):FireClient(player, amount)
	if humanoid.Health - amount <= 1 then
		setDowned(player, humanoid)
	else
		humanoid.Health -= amount
	end
end

function HealthService.Revive(target: Player, healthValue: number)
	local humanoid = humanoidOf(target)
	if not humanoid or not HealthService.IsDowned(target) then
		return
	end
	clearRevivePrompt(target)
	downedSince[target] = nil
	target:SetAttribute("FZ_Downed", false)
	target:SetAttribute("FZ_DownedUntil", nil)
	setLowered(target, false)
	humanoid.Health = math.clamp(healthValue, 1, humanoid.MaxHealth)
	lastDamage[target] = os.clock()
end

function HealthService.Heal(player: Player, amount: number)
	local humanoid = humanoidOf(player)
	if humanoid and not HealthService.IsDowned(player) and humanoid.Health > 0 then
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
	end
end

function HealthService.HealAll()
	for _, player in Players:GetPlayers() do
		local humanoid = humanoidOf(player)
		if humanoid then
			if HealthService.IsDowned(player) then
				HealthService.Revive(player, humanoid.MaxHealth)
			end
			humanoid.Health = humanoid.MaxHealth
		end
	end
end

function HealthService.Start()
	InteractionService.Register("revive", function(helper, root)
		local target = Players:GetPlayerFromCharacter(root.Parent)
		if not target or target == helper or not standing(helper) or not HealthService.IsDowned(target) then
			return
		end
		-- A medkit is required for a full revive (first-aid cabinets / found in the world).
		local InventoryService = require(script.Parent.InventoryService)
		if not InventoryService.Take(helper, "medkit") then
			Net.Event("Notify"):FireClient(helper, "REVIVE_NEED_MEDKIT")
			return
		end
		local reviveHealth = tonumber(helper:GetAttribute("FZ_ReviveHealth")) or HC.ReviveHealth
		HealthService.Revive(target, reviveHealth)
		require(script.Parent.AchievementService).Award(helper, "rescuer")
	end)

	local function onCharacter(player: Player, character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid or not humanoid:IsA("Humanoid") then
			return
		end
		humanoid.MaxHealth = HC.Max
		humanoid.Health = HC.Max
		humanoid.BreakJointsOnDeath = false
		player:SetAttribute("FZ_Downed", false)
		player:SetAttribute("FZ_DownedUntil", nil)
		downedSince[player] = nil
		savedHipHeight[player] = nil
		if HealthService.IsEliminated(player) then
			task.defer(function()
				local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root and HealthService.IsEliminated(player) then
					character:PivotTo(CFrame.new(0, 600, 0))
					root.Anchored = true
				end
			end)
		end
		humanoid.Died:Connect(function()
			-- Safety net (falls, resets): never a game over, just back to the checkpoint.
			task.delay(2, function()
				if player.Parent and player.Character == character then
					HealthService.Respawn(player)
				end
			end)
		end)
	end
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastDamage[player] = nil
		downedSince[player] = nil
		eliminatedAt[player] = nil
		savedHipHeight[player] = nil
		HealthService.SessionStats.eliminated[player] = nil
		task.defer(checkTeamWipe)
	end)

	-- Regeneration and downed timeout (1 Hz is plenty)
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for _, player in Players:GetPlayers() do
				local humanoid = humanoidOf(player)
				if humanoid then
					local since = downedSince[player]
					local eliminatedSince = eliminatedAt[player]
					if eliminatedSince and now - eliminatedSince > HC.EliminatedMaxWait then
						HealthService.Respawn(player) -- never wait forever
					elseif since and now - since > HC.DownedTimeout then
						if #inGamePlayers() <= 1 then
							-- Solo: no elimination, back to the last checkpoint
							Net.Event("Notify"):FireClient(player, "HUD_SIGNAL_LOST")
							HealthService.Respawn(player)
						else
							-- Nobody came in time: out for this section / round, spectate the team
							downedSince[player] = nil
							clearRevivePrompt(player)
							setLowered(player, false)
							player:SetAttribute("FZ_Downed", false)
							player:SetAttribute("FZ_DownedUntil", nil)
							player:SetAttribute("FZ_Eliminated", true)
							eliminatedAt[player] = now
							HealthService.SessionStats.eliminated[player] = true
							Net.Event("Notify"):FireClient(player, "HUD_ELIMINATED")
							local character = player.Character
							local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
							if character and root then
								character:PivotTo(CFrame.new(0, 600, 0))
								root.Anchored = true
							end
							checkTeamWipe()
						end
					elseif not since and humanoid.Health > 0 then
						local cap = tonumber(player:GetAttribute("FZ_RegenCap")) or HC.RegenCap
						if now - (lastDamage[player] or 0) > HC.RegenDelay and humanoid.Health < cap then
							humanoid.Health = math.min(cap, humanoid.Health + HC.RegenPerSecond)
						end
					end
				end
			end
		end
	end)
end

return HealthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">InteractionService</string>
            <string name="Source"><![CDATA[-- InteractionService: one interaction system for every platform.
--
-- Level designers tag an object (BasePart, Model or Attachment) with "FZ_Interactable"
-- and set attributes:
--   InteractId   (string, required) handler id registered by a chapter module
--   ActionKey    (string) localization key for the verb, e.g. "INTERACT_READ"
--   ObjectKey    (string) localization key for the object, e.g. "OBJECT_FAX"
--   HoldDuration (number, optional) seconds to hold
--   MaxDistance  (number, optional) default 8 studs
--
-- A ProximityPrompt is generated automatically. ProximityPrompts give us keyboard (E),
-- gamepad (X / Square) and touch (tap) with the same logical action for free.
-- Text is localized per player on the client (prompts are tagged "FZ_Prompt").
-- The server validates distance and rate-limits every trigger.

local CollectionService = game:GetService("CollectionService")

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local AnalyticsTracker = require(script.Parent.AnalyticsTracker)

local TAG = "FZ_Interactable"
local PROMPT_TAG = "FZ_Prompt"
local DISTANCE_TOLERANCE = 6

local InteractionService = {}

type Handler = (player: Player, instance: Instance, prompt: ProximityPrompt) -> ()
local handlers: { [string]: { Handler } } = {}
local limiter = RateLimiter.new(6, 3)

-- Several modes may handle the same object (e.g. the relay panel is used by chapter 1
-- and by survival). Every handler checks itself whether its mode is active.
function InteractionService.Register(id: string, handler: Handler)
	handlers[id] = handlers[id] or {}
	table.insert(handlers[id], handler)
end

local function worldPosition(instance: Instance): Vector3?
	if instance:IsA("BasePart") then
		return instance.Position
	elseif instance:IsA("Model") then
		return instance:GetPivot().Position
	elseif instance:IsA("Attachment") then
		return instance.WorldPosition
	end
	return nil
end

local function onTriggered(player: Player, instance: Instance, prompt: ProximityPrompt)
	if not limiter:Allow(player) or not prompt.Enabled then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	if player:GetAttribute("FZ_Downed") or player:GetAttribute("FZ_Eliminated") then
		return -- downed / eliminated players cannot do tasks
	end
	local position = worldPosition(instance)
	if not position or ((root :: BasePart).Position - position).Magnitude > prompt.MaxActivationDistance + DISTANCE_TOLERANCE then
		return
	end
	local id = instance:GetAttribute("InteractId")
	local list = if type(id) == "string" then handlers[id] else nil
	if not list then
		warn("[FZ-Interact] No handler for InteractId " .. tostring(id) .. " on " .. instance:GetFullName())
		return
	end
	if player:GetAttribute("FZ_NewPlayer") then
		AnalyticsTracker.Onboarding(player, 4, "FirstInteraction")
	end
	for _, handler in list do
		local ok, err = pcall(handler, player, instance, prompt)
		if not ok then
			warn("[FZ-Interact] Handler " .. id .. " failed: " .. tostring(err))
		end
	end
end

local function setup(instance: Instance)
	if not worldPosition(instance) then
		warn("[FZ-Interact] Unsupported interactable: " .. instance:GetFullName())
		return
	end
	local prompt = instance:FindFirstChild("FZ_Prompt")
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = "FZ_Prompt"
		prompt.Parent = instance
	end
	local p = prompt :: ProximityPrompt
	p.ActionText = "" -- localized on each client
	p.ObjectText = ""
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonX
	p.HoldDuration = tonumber(instance:GetAttribute("HoldDuration")) or 0
	p.MaxActivationDistance = tonumber(instance:GetAttribute("MaxDistance")) or 8
	p.RequiresLineOfSight = true
	p.Style = Enum.ProximityPromptStyle.Custom -- drawn by PromptController (all devices)
	p:SetAttribute("FZ_Action", instance:GetAttribute("ActionKey"))
	p:SetAttribute("FZ_Object", instance:GetAttribute("ObjectKey"))
	CollectionService:AddTag(p, PROMPT_TAG)
	p.Triggered:Connect(function(player)
		onTriggered(player, instance, p)
	end)
end

function InteractionService.Start()
	CollectionService:GetInstanceAddedSignal(TAG):Connect(setup)
	for _, instance in CollectionService:GetTagged(TAG) do
		setup(instance)
	end
end

return InteractionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="59">
          <Properties>
            <string name="Name">InventoryService</string>
            <string name="Source"><![CDATA[-- InventoryService: small hotbar per player and session (bandages, syringes).
-- Server-authoritative; replicated as the player attribute "FZ_Items" ("bandage,syringe").
--   * 3 slots, technician set 4
--   * medic set: starts every session with 2 bandages + 1 syringe and heals 50 % more
--   * a syringe also gets you back up when you are down (self-revive)
-- Items reset per session; they are not a currency and cannot be bought.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local InteractionService = require(script.Parent.InteractionService)
local HealthService = require(script.Parent.HealthService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local InventoryService = {}

local inventories: { [Player]: { string } } = {}
local using: { [Player]: boolean } = {}
local worldFolder: Folder? = nil

local function slots(player: Player): number
	return if player:GetAttribute("FZ_Set") == "set_technician" then Config.Inventory.TechnicianSlots else Config.Inventory.Slots
end

local function publish(player: Player)
	player:SetAttribute("FZ_Items", table.concat(inventories[player] or {}, ","))
	player:SetAttribute("FZ_ItemSlots", slots(player))
end

function InventoryService.Give(player: Player, itemId: string): boolean
	local list = inventories[player]
	if not list then
		list = {}
		inventories[player] = list
	end
	if not Config.Items[itemId] or #list >= slots(player) then
		return false
	end
	table.insert(list, itemId)
	publish(player)
	return true
end

function InventoryService.Has(player: Player, itemId: string): boolean
	return table.find(inventories[player] or {}, itemId) ~= nil
end

function InventoryService.Take(player: Player, itemId: string): boolean
	local list = inventories[player]
	local index = list and table.find(list, itemId)
	if not index then
		return false
	end
	table.remove(list :: { string }, index)
	publish(player)
	return true
end

function InventoryService.Reset(player: Player)
	inventories[player] = {}
	for _, itemId in Config.Inventory.EveryoneStart do
		InventoryService.Give(player, itemId)
	end
	if player:GetAttribute("FZ_Set") == "set_medic" then
		for _, itemId in Config.Inventory.MedicStart do
			InventoryService.Give(player, itemId)
		end
	end
	publish(player)
end

function InventoryService.Clear(player: Player)
	inventories[player] = {}
	publish(player)
end

function InventoryService.ClearWorld()
	if worldFolder then
		worldFolder:Destroy()
		worldFolder = nil
	end
end

-- Places random items at free FZ_ItemSpot spots.
function InventoryService.SpawnWorldItems(count: number)
	if not worldFolder or not worldFolder.Parent then
		local folder = Instance.new("Folder")
		folder.Name = "FZ_WorldItems"
		folder.Parent = workspace
		worldFolder = folder
	end
	local folder = worldFolder :: Folder
	local spots = {}
	for _, spot in CollectionService:GetTagged("FZ_ItemSpot") do
		if spot:IsA("BasePart") and not spot:GetAttribute("Occupied") then
			table.insert(spots, spot)
		end
	end
	for _ = 1, math.min(count, #spots) do
		local spot = table.remove(spots, math.random(1, #spots))
		local roll = math.random()
		local itemId = if roll < 0.5 then "bandage" elseif roll < 0.85 then "medkit" else "syringe"
		local part = Instance.new("Part")
		part.Name = itemId
		part.Anchored = true
		part.CanCollide = false
		part.Size = if itemId == "bandage" then Vector3.new(0.9, 0.5, 0.9) elseif itemId == "medkit" then Vector3.new(1.4, 0.9, 1) else Vector3.new(0.25, 0.25, 1.2)
		part.Color = if itemId == "bandage" then Color3.fromRGB(226, 222, 210) elseif itemId == "medkit" then Color3.fromRGB(170, 60, 54) else Color3.fromRGB(120, 200, 220)
		part.Material = if itemId == "syringe" then Enum.Material.Glass else Enum.Material.Fabric
		part.CFrame = spot.CFrame
		local glow = Instance.new("PointLight")
		glow.Range = 4
		glow.Brightness = 0.6
		glow.Color = Color3.fromRGB(200, 230, 255)
		glow.Parent = part
		part:SetAttribute("InteractId", "item")
		part:SetAttribute("ItemId", itemId)
		part:SetAttribute("ActionKey", "INTERACT_PICKUP")
		part:SetAttribute("ObjectKey", Config.Items[itemId].name)
		part:SetAttribute("MaxDistance", 7)
		part.Parent = folder
		spot:SetAttribute("Occupied", true)
		part.Destroying:Connect(function()
			spot:SetAttribute("Occupied", nil)
		end)
		CollectionService:AddTag(part, "FZ_Interactable")
	end
end

-- First-aid cabinets (tag FZ_MedCabinet): hold medkits, refilled per session / survival break.
function InventoryService.RefillCabinets()
	for _, cabinet in CollectionService:GetTagged("FZ_MedCabinet") do
		cabinet:SetAttribute("Medkits", Config.Inventory.CabinetMedkits)
	end
end

function InventoryService.Start()
	InteractionService.Register("medcabinet", function(player, cabinet)
		local left = tonumber(cabinet:GetAttribute("Medkits")) or 0
		if left <= 0 then
			Net.Event("Notify"):FireClient(player, "CABINET_EMPTY")
			return
		end
		if InventoryService.Give(player, "medkit") then
			cabinet:SetAttribute("Medkits", left - 1)
			Net.Event("Sfx"):FireAllClients("door_open", (cabinet :: BasePart).Position, 0.4)
		else
			Net.Event("Notify"):FireClient(player, "INV_FULL")
		end
	end)

	InteractionService.Register("item", function(player, part)
		local itemId = part:GetAttribute("ItemId")
		if type(itemId) ~= "string" or not part.Parent then
			return
		end
		if InventoryService.Give(player, itemId) then
			Net.Event("Sfx"):FireAllClients("fuse_pickup", (part :: BasePart).Position)
			part:Destroy()
		else
			Net.Event("Notify"):FireClient(player, "INV_FULL")
		end
	end)

	local limiter = RateLimiter.new(3, 1)
	Net.Event("UseItem").OnServerEvent:Connect(function(player: Player, slot: any)
		local list = inventories[player]
		if not list or not limiter:Allow(player) or using[player] or type(slot) ~= "number" or slot % 1 ~= 0 then
			return
		end
		local itemId = list[slot]
		local item = itemId and Config.Items[itemId]
		if not item then
			return
		end
		local downed = player:GetAttribute("FZ_Downed") == true
		if downed and itemId ~= "syringe" then
			return
		end
		using[player] = true
		local character = player.Character
		player:SetAttribute("FZ_UsingItem", itemId)
		task.delay(item.useTime, function()
			using[player] = nil
			player:SetAttribute("FZ_UsingItem", nil)
			if player.Character ~= character or inventories[player] ~= list or list[slot] ~= itemId then
				return
			end
			table.remove(list, slot)
			publish(player)
			local bonus = if player:GetAttribute("FZ_Set") == "set_medic" then Config.Inventory.MedicHealBonus else 1
			if player:GetAttribute("FZ_Downed") then
				HealthService.Revive(player, 60 * bonus)
			else
				HealthService.Heal(player, item.heal * bonus)
			end
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		inventories[player] = nil
		using[player] = nil
	end)
end

return InventoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="60">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- LeaderboardService: global best shifts per survival map (OrderedDataStore).
-- Names are resolved and cached on the server. Reads are cached for 60 s.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Content = require(Shared.Content)
local Net = require(Shared.Net)

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local LeaderboardService = {}

local stores: { [string]: OrderedDataStore } = {}
local cache: { [string]: { time: number, entries: { any } } } = {}
local names: { [number]: string } = {}

local function store(survivalId: string): OrderedDataStore?
	if stores[survivalId] then
		return stores[survivalId]
	end
	local ok, result = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, "FZ_Survival_" .. survivalId .. "_v1")
	if ok then
		stores[survivalId] = result
		return result
	end
	return nil
end

local function nameOf(userId: number): string
	if names[userId] then
		return names[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	names[userId] = if ok then name else "?"
	return names[userId]
end

function LeaderboardService.Submit(survivalId: string, userId: number, shifts: number)
	local s = store(survivalId)
	if not s or shifts <= 0 then
		return
	end
	pcall(function()
		s:UpdateAsync(tostring(userId), function(old)
			if type(old) == "number" and old >= shifts then
				return nil -- keep the better score, no write
			end
			return math.floor(shifts)
		end)
	end)
	cache[survivalId] = nil
end

function LeaderboardService.Top(survivalId: string): { any }?
	local cached = cache[survivalId]
	if cached and os.clock() - cached.time < 60 then
		return cached.entries
	end
	local s = store(survivalId)
	if not s then
		return nil
	end
	local ok, pages = pcall(s.GetSortedAsync, s, false, 10)
	if not ok then
		return nil
	end
	local entries = {}
	for rank, item in pages:GetCurrentPage() do
		local userId = tonumber(item.key) or 0
		table.insert(entries, { rank = rank, name = nameOf(userId), shifts = item.value })
	end
	cache[survivalId] = { time = os.clock(), entries = entries }
	return entries
end

function LeaderboardService.Start()
	local limiter = RateLimiter.new(3, 0.2)
	Net.Function("GetLeaderboard").OnServerInvoke = function(player: Player, survivalId: any)
		if not limiter:Allow(player) or type(survivalId) ~= "string" or not Content.Survival(survivalId) then
			return { ok = false }
		end
		local entries = LeaderboardService.Top(survivalId)
		return { ok = entries ~= nil, entries = entries or {} }
	end
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="61">
          <Properties>
            <string name="Name">LoreService</string>
            <string name="Source"><![CDATA[-- LoreService: DAS ARCHIV on the server. Finds are saved per player (data.secrets.logs),
-- first finds pay a small reward, and insights unlock when their linked entries are known.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Lore = require(Shared.Lore)
local Net = require(Shared.Net)

local InteractionService = require(script.Parent.InteractionService)
local StoryService = require(script.Parent.StoryService)
local DataService = require(script.Parent.DataService)
local BadgeTracker = require(script.Parent.BadgeTracker)
local AchievementService = require(script.Parent.AchievementService)

local LoreService = {}

local REWARD = 50

function LoreService.Entry(id: string)
	for _, item in Lore do
		if item.id == id then
			return item
		end
	end
	return nil
end

local function checkInsights(player: Player)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local logs = profile.Data.secrets.logs
	for _, item in Lore do
		if item.links and not logs[item.id] then
			local complete = true
			for _, link in item.links do
				if not logs[link] then
					complete = false
				end
			end
			if complete then
				DataService.Mutate(player, function(data)
					data.secrets.logs[item.id] = os.time()
				end)
				DataService.Grant(player, item.reward or REWARD)
				Net.Event("Notify"):FireClient(player, "ARCHIVE_INSIGHT")
			end
		end
	end
	-- every regular find of Relay Station 07 -> badge
	local all = true
	for _, item in Lore do
		if item.map == "relay07" and not item.links and not item.secret and not logs[item.id] then
			all = false
		end
	end
	if all then
		BadgeTracker.Award(player, "ch1_archive")
		AchievementService.Award(player, "archivist")
	end
end

-- Saves an entry for a player (no document is shown). Returns true on a first find.
function LoreService.Unlock(player: Player, id: string, silent: boolean?): boolean
	local item = LoreService.Entry(id)
	local profile = DataService.Get(player)
	if not item or not profile or profile.Data.secrets.logs[id] then
		return false
	end
	DataService.Mutate(player, function(data)
		data.secrets.logs[id] = os.time()
	end)
	if not silent then
		DataService.Grant(player, REWARD)
		Net.Event("Notify"):FireClient(player, "ARCHIVE_NEW")
	end
	checkInsights(player)
	return true
end

function LoreService.UnlockAll(players: { Player }, id: string)
	for _, player in players do
		LoreService.Unlock(player, id, true)
	end
end

function LoreService.Start()
	InteractionService.Register("lore", function(player, object)
		local id = object:GetAttribute("LogId")
		local item = type(id) == "string" and LoreService.Entry(id)
		if not item then
			return
		end
		StoryService.ShowDocument(player, { title = item.title, body = item.body })
		LoreService.Unlock(player, id)
	end)
end

return LoreService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="62">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[-- MapService: exactly one map is loaded per server. Sources, in this order:
--   1. Workspace.FZ_Map (your own hand-built map for relay07, never destroyed)
--   2. ServerStorage.Maps.<model> (your own map models for any map id)
--   3. A script builder in ServerScriptService/Server/Map (relay07 today)
-- Switching maps only happens when no session is running.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Content = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Content"))

local MapService = {}

local current: { id: string, model: Instance?, owned: boolean }? = nil

function MapService.CurrentId(): string?
	return current and current.id
end

function MapService.IsAvailable(mapId: string): boolean
	local map = Content.Maps[mapId]
	if not map then
		return false
	end
	if mapId == "relay07" and workspace:FindFirstChild("FZ_Map") then
		return true
	end
	local maps = ServerStorage:FindFirstChild("Maps")
	if maps and map.model and maps:FindFirstChild(map.model) then
		return true
	end
	return map.builder ~= nil and script.Parent.Parent.Map:FindFirstChild(map.builder) ~= nil
end

function MapService.Load(mapId: string): boolean
	if current and current.id == mapId then
		return true
	end
	local map = Content.Maps[mapId]
	if not map or not MapService.IsAvailable(mapId) then
		warn("[FZ-Map] Map not available: " .. tostring(mapId))
		return false
	end
	if current and current.model and not current.owned then
		current.model:Destroy()
		workspace.Terrain:Clear()
	end
	local model: Instance? = nil
	local owned = false
	if mapId == "relay07" and workspace:FindFirstChild("FZ_Map") then
		model = workspace:FindFirstChild("FZ_Map")
		owned = true
		-- A pre-baked builder map (in the place file) still needs its terrain at runtime.
		local builderName = (model :: Instance):GetAttribute("FZ_Builder")
		local builder = type(builderName) == "string" and script.Parent.Parent.Map:FindFirstChild(builderName)
		if builder and builder:IsA("ModuleScript") then
			local ok, err = pcall(function()
				(require(builder) :: any).BuildTerrain(model)
			end)
			if not ok then
				warn("[FZ-Map] terrain failed: " .. tostring(err))
			end
		end
	else
		local maps = ServerStorage:FindFirstChild("Maps")
		local source = maps and map.model and maps:FindFirstChild(map.model)
		if source then
			model = source:Clone()
			;(model :: Instance).Parent = workspace
		else
			model = require(script.Parent.Parent.Map:FindFirstChild(map.builder) :: ModuleScript).Build()
		end
	end
	current = { id = mapId, model = model, owned = owned }
	return true
end

-- Loads the default map at boot so the menu has a live scene behind it.
function MapService.Start()
	MapService.Load("relay07")
end

return MapService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="63">
          <Properties>
            <string name="Name">MovementGuardService</string>
            <string name="Source"><![CDATA[-- MovementGuardService: server-side sanity check against speed exploits.
-- Player characters are simulated on the client, so the server compares the distance
-- moved between checks with what is possible (sprint + tolerance, admin speed x2).
-- Violations pull the character back to the last valid position and are logged.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local MovementGuardService = {}

local INTERVAL = 0.5
local TOLERANCE = 1.45 -- lag, slopes, knockback
local lastValid: { [Player]: { position: Vector3, time: number } } = {}
local strikes: { [Player]: number } = {}

local function allowedSpeed(player: Player): number
	local speed = Config.Movement.SprintSpeed
	if player:GetAttribute("FZ_AdminSpeed") then
		speed *= 2
	end
	if player:GetAttribute("FZ_MonsterMode") then
		speed = 30
	end
	return speed * TOLERANCE
end

function MovementGuardService.Forget(player: Player)
	lastValid[player] = nil
end

function MovementGuardService.Start(logViolation: ((Player, string) -> ())?)
	local report = logViolation or function(player: Player, message: string)
		warn(string.format("[FZ-Guard] %s (%d): %s", player.Name, player.UserId, message))
	end
	Players.PlayerRemoving:Connect(function(player)
		lastValid[player] = nil
		strikes[player] = nil
	end)
	Players.PlayerAdded:Connect(function(player)
		player.CharacterAdded:Connect(function()
			lastValid[player] = nil -- respawns and checkpoint placement are legitimate jumps
		end)
	end)
	task.spawn(function()
		while true do
			task.wait(INTERVAL)
			local now = os.clock()
			for _, player in Players:GetPlayers() do
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root and player:GetAttribute("FZ_InGame") then
					local last = lastValid[player]
					local position = root.Position
					if last and not player:GetAttribute("FZ_Teleporting") then
						local moved = Vector3.new(position.X - last.position.X, 0, position.Z - last.position.Z).Magnitude
						local possible = allowedSpeed(player) * (now - last.time) + 2
						if moved > possible then
							strikes[player] = (strikes[player] or 0) + 1
							if strikes[player] >= 2 then
								root.CFrame = CFrame.new(last.position) * root.CFrame.Rotation
								root.AssemblyLinearVelocity = Vector3.zero
								report(player, string.format("moved %.1f studs, max %.1f", moved, possible))
								strikes[player] = 0
								continue
							end
						else
							strikes[player] = 0
						end
					end
					lastValid[player] = { position = position, time = now }
				else
					lastValid[player] = nil
				end
			end
		end
	end)
end

return MovementGuardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="64">
          <Properties>
            <string name="Name">NoiseService</string>
            <string name="Source"><![CDATA[-- NoiseService: everything the creature can hear goes through here.
-- Footsteps are derived from server-side character velocity (no client trust needed):
-- standing still is silent, walking is quiet, sprinting is loud.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Signal = require(Shared.Signal)

local NoiseService = {}
NoiseService.Heard = Signal.new() -- (position: Vector3, radius: number, source: Player?)

local footstepScale = 1

-- Story systems can mask footsteps (e.g. loud ventilation fans): 0.6 = 40 % quieter.
function NoiseService.SetFootstepScale(value: number)
	footstepScale = value
end

function NoiseService.Emit(position: Vector3, radius: number, source: Player?)
	NoiseService.Heard:Fire(position, radius, source)
end

function NoiseService.Start()
	task.spawn(function()
		while true do
			task.wait(0.4)
			for _, player in Players:GetPlayers() do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if root and humanoid and humanoid.FloorMaterial ~= Enum.Material.Air and player:GetAttribute("FZ_InGame") and not player:GetAttribute("FZ_MonsterMode") then
					local velocity = root.AssemblyLinearVelocity
					local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
					if speed > Config.Movement.WalkSpeed + 2 then
						NoiseService.Emit(root.Position, Config.Noise.Sprint * footstepScale, player)
					elseif speed > 3 then
						NoiseService.Emit(root.Position, Config.Noise.Walk * footstepScale, player)
					end
				end
			end
		end
	end)
end

return NoiseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="65">
          <Properties>
            <string name="Name">PartyService</string>
            <string name="Source"><![CDATA[-- PartyService: "private session". The host invites everyone in this server who is in the
-- menu; whoever accepts within 15 s travels together into a fresh reserved server of this
-- place (not joinable by strangers). Works without any extra places.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local DecisionService = require(script.Parent.DecisionService)

local PartyService = {}

local INVITE_SECONDS = 15
type Invite = { id: string, host: Player, invited: { Player }, accepted: { [Player]: boolean }, answered: { [Player]: boolean }, done: boolean }
local invites: { [string]: Invite } = {}

local function teleport(invite: Invite)
	if invite.done then
		return
	end
	invite.done = true
	invites[invite.id] = nil
	local travellers = { invite.host }
	for player in invite.accepted do
		if player.Parent then
			table.insert(travellers, player)
		end
	end
	for _, player in invite.invited do
		if player.Parent then
			Net.Event("Decision"):FireClient(player, nil)
		end
	end
	local ok, code = pcall(function()
		return (TeleportService:ReserveServer(game.PlaceId))
	end)
	if not ok then
		Net.Event("Notify"):FireClient(invite.host, "SESSION_ERROR")
		return
	end
	local options = Instance.new("TeleportOptions")
	options.ReservedServerAccessCode = code
	options:SetTeleportData({ private = true, code = code })
	for _, player in travellers do
		Net.Event("Notify"):FireClient(player, "SESSION_TELEPORT")
	end
	local success, err = pcall(function()
		TeleportService:TeleportAsync(game.PlaceId, travellers, options)
	end)
	if not success then
		warn("[FZ-Party] Teleport failed: " .. tostring(err))
		for _, player in travellers do
			Net.Event("Notify"):FireClient(player, "SESSION_ERROR")
		end
	end
end

-- Returns "teleport" (alone, leaving now) or "invited".
function PartyService.CreatePrivate(host: Player): string
	local invite: Invite = { id = "party:" .. HttpService:GenerateGUID(false), host = host, invited = {}, accepted = {}, answered = {}, done = false }
	for _, player in Players:GetPlayers() do
		if player ~= host and not player:GetAttribute("FZ_InGame") then
			table.insert(invite.invited, player)
		end
	end
	if #invite.invited == 0 then
		task.spawn(teleport, invite)
		return "teleport"
	end
	invites[invite.id] = invite
	for _, player in invite.invited do
		Net.Event("Decision"):FireClient(player, {
			id = invite.id,
			prompt = "PARTY_INVITE",
			promptParams = { name = host.DisplayName },
			options = { "PARTY_ACCEPT", "PARTY_DECLINE" },
			ends = workspace:GetServerTimeNow() + INVITE_SECONDS,
			counts = { 0, 0 },
			voters = #invite.invited,
		})
	end
	task.delay(INVITE_SECONDS, function()
		teleport(invite)
	end)
	return "invited"
end

function PartyService.Start()
	DecisionService.RegisterExternal("party", function(player, id, index)
		local invite = invites[id]
		if not invite or invite.done or not table.find(invite.invited, player) then
			return
		end
		invite.answered[player] = true
		invite.accepted[player] = if index == 1 then true else nil
		Net.Event("Decision"):FireClient(player, nil)
		local all = true
		for _, invited in invite.invited do
			if invited.Parent and not invite.answered[invited] then
				all = false
			end
		end
		if all then
			teleport(invite)
		end
	end)
end

return PartyService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">PlaceService</string>
            <string name="Source"><![CDATA[-- PlaceService: server-side teleports between places of this experience.
-- Only used when Content.Places has real place ids. Teams travel together into a
-- reserved server; the destination reads the (validated) selection from TeleportData.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TeleportService = game:GetService("TeleportService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Content = require(Shared.Content)
local Net = require(Shared.Net)

local PlaceService = {}

function PlaceService.PlaceFor(mapId: string): number
	return Content.Places[mapId] or 0
end

function PlaceService.CanTeleport(mapId: string): boolean
	local placeId = PlaceService.PlaceFor(mapId)
	return placeId > 0 and placeId ~= game.PlaceId
end

-- Teleports players to a fresh reserved server of the map's place. Returns success.
function PlaceService.Teleport(players: { Player }, mapId: string, data: { mode: string, contentId: string }): boolean
	local placeId = PlaceService.PlaceFor(mapId)
	if placeId <= 0 then
		return false
	end
	local ok, accessCode = pcall(function()
		return (TeleportService:ReserveServer(placeId))
	end)
	if not ok or type(accessCode) ~= "string" then
		warn("[FZ-Place] ReserveServer failed: " .. tostring(accessCode))
		return false
	end
	local options = Instance.new("TeleportOptions")
	options.ReservedServerAccessCode = accessCode
	-- The access code travels along so the destination can offer "rejoin" after disconnects.
	options:SetTeleportData({ mode = data.mode, contentId = data.contentId, code = accessCode })
	for attempt = 1, 3 do
		local success, err = pcall(function()
			TeleportService:TeleportAsync(placeId, players, options)
		end)
		if success then
			return true
		end
		warn(string.format("[FZ-Place] Teleport attempt %d failed: %s", attempt, tostring(err)))
		task.wait(attempt * 2)
	end
	return false
end

-- Teleport a single player back into a specific running server (rejoin after disconnect).
function PlaceService.Rejoin(player: Player, placeId: number, jobId: string, code: string?): boolean
	local options = Instance.new("TeleportOptions")
	if code and code ~= "" then
		options.ReservedServerAccessCode = code
	else
		options.ServerInstanceId = jobId
	end
	local ok, err = pcall(function()
		TeleportService:TeleportAsync(placeId, { player }, options)
	end)
	if not ok then
		warn("[FZ-Place] Rejoin failed: " .. tostring(err))
	end
	return ok
end

-- Access code of the reserved server this player arrived in (if any).
function PlaceService.ArrivalCode(player: Player): string?
	local ok, joinData = pcall(player.GetJoinData, player)
	local data = ok and type(joinData) == "table" and joinData.TeleportData
	if type(data) == "table" and type(data.code) == "string" then
		return data.code
	end
	return nil
end

-- Selection a player arrived with (validated against the registry, never trusted blindly).
function PlaceService.ArrivalSelection(player: Player): (string?, string?)
	local ok, joinData = pcall(player.GetJoinData, player)
	local data = ok and type(joinData) == "table" and joinData.TeleportData
	if type(data) ~= "table" or type(data.mode) ~= "string" or type(data.contentId) ~= "string" then
		return nil, nil
	end
	if not Content.Entry(data.mode, data.contentId) then
		return nil, nil
	end
	return data.mode, data.contentId
end

function PlaceService.Start()
	TeleportService.TeleportInitFailed:Connect(function(player, result, message)
		warn(string.format("[FZ-Place] Teleport of %s failed (%s): %s", player.Name, tostring(result), tostring(message)))
		Net.Event("Notify"):FireClient(player, "SESSION_ERROR")
	end)
end

return PlaceService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="67">
          <Properties>
            <string name="Name">PowerService</string>
            <string name="Source"><![CDATA[-- PowerService: sector power. Switches tagged lights (FZ_SectorLight) and unlocks/locks
-- doors whose PowerSector attribute matches. State is replicated as "Power_<sector>".

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SessionState = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SessionState"))

local PowerService = {}

local DEFAULT = { A = true, B = false, C = true, D = true, E = true, CONTROL = true, CORE = false, HALL = true, HALLS = false }
local powered: { [string]: boolean } = {}
local OFF_COLOR = Color3.fromRGB(40, 40, 38)

local doorService = nil -- injected to avoid a require cycle

local function applyLight(fixture: Instance)
	local sector = fixture:GetAttribute("Sector")
	if type(sector) ~= "string" or not fixture:IsA("BasePart") then
		return
	end
	local on = powered[sector] ~= false
	fixture:SetAttribute("Powered", on)
	local onColor = fixture:GetAttribute("OnColor")
	fixture.Color = if on then (if typeof(onColor) == "Color3" then onColor else fixture.Color) else OFF_COLOR
	for _, child in fixture:GetChildren() do
		if child:IsA("Light") then
			child.Enabled = on
			if typeof(onColor) == "Color3" then
				child.Color = onColor
			end
		end
	end
end

function PowerService.IsOn(sector: string): boolean
	return powered[sector] ~= false
end

function PowerService.Set(sector: string, on: boolean)
	powered[sector] = on
	SessionState.Set("Power_" .. sector, on)
	for _, fixture in CollectionService:GetTagged("FZ_SectorLight") do
		if fixture:GetAttribute("Sector") == sector then
			applyLight(fixture)
		end
	end
	if doorService then
		for _, panel in CollectionService:GetTagged("FZ_Door") do
			if panel:GetAttribute("PowerSector") == sector then
				doorService.SetLocked(panel, not on)
			end
		end
	end
end

function PowerService.Reset()
	for sector, on in DEFAULT do
		PowerService.Set(sector, on)
	end
end

function PowerService.Start(injectedDoorService)
	doorService = injectedDoorService
	CollectionService:GetInstanceAddedSignal("FZ_SectorLight"):Connect(applyLight)
	PowerService.Reset()
end

return PowerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="68">
          <Properties>
            <string name="Name">ReferralService</string>
            <string name="Source"><![CDATA[-- ReferralService: small one-time reward when a NEW player joins through a friend's invite.
--   * The invite carries LaunchData "ref:<inviterUserId>" (ExperienceInviteOptions);
--     the server reads it from Player:GetJoinData() - nothing the client claims is trusted
--   * Only for genuinely new players (first session), account at least 7 days old,
--     never your own id, once per invited account, at most 10 rewards per inviter
--   * Reward only after a real condition: reaching the control room in chapter 1 or
--     15 minutes of play. Pressing "invite" alone never rewards anything.
--   * If the inviter is offline the reward waits in a DataStore and is paid on their
--     next join.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Community = require(Shared.Community)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)

local ReferralService = {}

local store = nil
pcall(function()
	store = DataStoreService:GetDataStore("FZ_Referrals_v1")
end)

local pending: { [Player]: { inviter: number, since: number } } = {}

local function payInviter(inviterId: number)
	local inviter = Players:GetPlayerByUserId(inviterId)
	if inviter and DataService.Get(inviter) then
		local paid = false
		DataService.Mutate(inviter, function(data)
			if (data.referral.rewardedInvites or 0) < Community.ReferralMaxPerPlayer then
				data.referral.rewardedInvites = (data.referral.rewardedInvites or 0) + 1
				paid = true
			end
		end)
		if paid then
			DataService.Grant(inviter, Community.ReferralMarks)
			Net.Event("Notify"):FireClient(inviter, "REFERRAL_REWARD")
		end
		return
	end
	if store then
		pcall(function()
			store:UpdateAsync(tostring(inviterId), function(old)
				local entry = if type(old) == "table" then old else { pending = 0 }
				entry.pending = (entry.pending or 0) + 1
				return entry
			end)
		end)
	end
end

-- Called when the invited player fulfils the condition.
function ReferralService.Complete(player: Player)
	local entry = pending[player]
	if not entry then
		return
	end
	pending[player] = nil
	local profile = DataService.Get(player)
	if not profile or profile.Data.referral.rewarded then
		return
	end
	DataService.Mutate(player, function(data)
		data.referral.rewarded = os.time()
	end)
	DataService.Grant(player, Community.ReferralMarks)
	Net.Event("Notify"):FireClient(player, "REFERRAL_REWARD")
	payInviter(entry.inviter)
end

function ReferralService.Start()
	DataService.ProfileLoaded:Connect(function(player, profile)
		-- 1) rewards waiting for this player as an inviter
		if store and profile.Persistent then
			local count = 0
			pcall(function()
				store:UpdateAsync(tostring(player.UserId), function(old)
					if type(old) ~= "table" or (old.pending or 0) <= 0 then
						return nil
					end
					count = old.pending
					old.pending = 0
					return old
				end)
			end)
			for _ = 1, count do
				payInviter(player.UserId)
			end
		end
		-- 2) did this NEW player arrive through an invite?
		local ok, joinData = pcall(player.GetJoinData, player)
		local launch = ok and type(joinData) == "table" and joinData.LaunchData
		local inviter = type(launch) == "string" and tonumber(string.match(launch, "^ref:(%d+)$"))
		if not inviter or inviter == player.UserId then
			return
		end
		if profile.Data.stats.sessions > 1 or profile.Data.referral.by or player.AccountAge < Community.ReferralMinAccountAgeDays then
			return
		end
		DataService.Mutate(player, function(data)
			data.referral.by = inviter
		end)
		pending[player] = { inviter = inviter, since = os.clock() }
	end)

	-- time-based condition (15 minutes)
	task.spawn(function()
		while true do
			task.wait(30)
			for player, entry in pending do
				if os.clock() - entry.since > 15 * 60 then
					ReferralService.Complete(player)
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player)
		pending[player] = nil
	end)
end

return ReferralService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="69">
          <Properties>
            <string name="Name">SecretService</string>
            <string name="Source"><![CDATA[-- SecretService: community secrets. Answers are checked on the server only, each secret
-- can be solved once per player, and a global counter shows how many players solved it
-- ("You are number 37") - the community can puzzle together without any external site.

local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Registry = require(Shared.SecretsRegistry)

local DataService = require(script.Parent.DataService)
local LoreService = require(script.Parent.LoreService)
local AchievementService = require(script.Parent.AchievementService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local Answers = require(ServerStorage:WaitForChild("Secrets"):WaitForChild("SecretAnswers"))

local SecretService = {}

local counter = nil
pcall(function()
	counter = DataStoreService:GetDataStore("FZ_SecretSolvers_v1")
end)

local function normalize(text: string): string
	return (string.gsub(string.upper(text), "[^%w]", ""))
end

local function solve(player: Player, raw: any)
	if type(raw) ~= "string" or #raw > 64 then
		return { status = "nothing" }
	end
	local input = normalize(raw)
	for _, secret in Registry do
		for _, answer in Answers[secret.id] or {} do
			if input == normalize(answer) then
				local profile = DataService.Get(player)
				if not profile or not profile.Persistent then
					return { status = "nothing" }
				end
				if profile.Data.secrets.solved[secret.id] then
					return { status = "known", unlock = secret.unlock }
				end
				DataService.Mutate(player, function(data)
					data.secrets.solved[secret.id] = os.time()
				end)
				LoreService.Unlock(player, secret.unlock, true)
				DataService.Grant(player, secret.marks or 0)
				AchievementService.Award(player, "decoder")
				local solvers = 0
				if counter then
					pcall(function()
						solvers = counter:IncrementAsync(secret.id, 1)
					end)
				end
				return { status = "ok", unlock = secret.unlock, solvers = solvers }
			end
		end
	end
	return { status = "nothing" }
end

function SecretService.Start()
	local limiter = RateLimiter.new(5, 0.1) -- burst 5, then one try every 10 s (no brute force)
	Net.Function("SolveSecret").OnServerInvoke = function(player: Player, raw: any)
		if not limiter:Allow(player) then
			return { status = "rate" }
		end
		return solve(player, raw)
	end
end

return SecretService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="70">
          <Properties>
            <string name="Name">SessionService</string>
            <string name="Source"><![CDATA[-- SessionService: what the team in this server is currently playing.
--
--   One Roblox server = one team = at most one running session:
--     { mode = "story" | "survival", contentId = "ch1" | "sv_relay07" | ..., mapId }
--   * The first player who picks something starts it; teammates join it with one tap.
--   * Picking something else while teammates are playing: if that content has its own
--     place, the player is teleported to a fresh reserved server; otherwise "busy".
--   * Nobody in game for a while -> the session ends and the map is free again.
--   * Players who arrive by teleport with a valid selection start/join automatically.
-- Mode modules (Chapters/*, Modes/*) implement: Init(context), Begin(entry), Stop(),
-- OnPlayerEntered(player, firstTime), StartCheckpoint.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local DataService = require(script.Parent.DataService)
local MapService = require(script.Parent.MapService)
local PlaceService = require(script.Parent.PlaceService)
local CreatureService = require(script.Parent.CreatureService)
local HealthService = require(script.Parent.HealthService)
local PowerService = require(script.Parent.PowerService)
local DoorService = require(script.Parent.DoorService)
local InventoryService = require(script.Parent.InventoryService)
local AnalyticsTracker = require(script.Parent.AnalyticsTracker)
local PartyService = require(script.Parent.PartyService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local SessionService = {}

local MODULES = {
	story = {
		ch1 = require(script.Parent.Parent.Chapters.Chapter1),
	},
	survival = {
		sv_relay07 = require(script.Parent.Parent.Modes.Survival),
	},
}

type Session = { mode: string, contentId: string, mapId: string, module: any, idleSince: number? }
local session: Session? = nil
local REJOIN_WINDOW = 15 * 60
local reservedCode: string? = nil -- known when this server was reached via a reserved teleport
local inGame: { [Player]: boolean } = {}
local entered: { [Player]: boolean } = {}

---------------------------------------------------------------------------
-- Checkpoints
---------------------------------------------------------------------------
local function findCheckpoint(id: string): BasePart?
	for _, part in CollectionService:GetTagged("FZ_Checkpoint") do
		if part:IsA("BasePart") and part:GetAttribute("CheckpointId") == id then
			return part
		end
	end
	return nil
end

local function placeAtCheckpoint(player: Player)
	local character = player.Character
	if not character or player:GetAttribute("FZ_MonsterMode") then
		return
	end
	local checkpoint = findCheckpoint(SessionState.Get("Checkpoint") or "C1_START")
	if not checkpoint then
		return
	end
	local index = table.find(Players:GetPlayers(), player) or 1
	local offset = Vector3.new(((index - 1) % 2) * 3 - 1.5, 3, math.floor((index - 1) / 2) * 3)
	local target = checkpoint.CFrame * CFrame.new(offset)
	pcall(function()
		player:RequestStreamAroundAsync(target.Position, 5)
	end)
	if player.Character == character then
		character:PivotTo(target)
	end
end

function SessionService.SetCheckpoint(id: string)
	local changed = SessionState.Get("Checkpoint") ~= id
	SessionState.Set("Checkpoint", id)
	if changed then
		HealthService.ReturnAllEliminated() -- reaching a checkpoint brings eliminated teammates back
	end
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------
function SessionService.Get(): Session?
	return session
end

function SessionService.IsActive(mode: string, contentId: string?): boolean
	return session ~= nil and session.mode == mode and (contentId == nil or session.contentId == contentId)
end

function SessionService.PlayersInGame(): { Player }
	local list = {}
	for player in inGame do
		table.insert(list, player)
	end
	return list
end

local function cleanWorld()
	CreatureService.Despawn()
	CreatureService.SetAIEnabled(true)
	CreatureService.SetDifficulty({})
	HealthService.TeamWipeHandler = nil
	PowerService.Reset()
	DoorService.CloseAll()
	HealthService.HealAll()
	InventoryService.ClearWorld()
end

local function start(mode: string, contentId: string): boolean
	local entry = Content.Entry(mode, contentId)
	local module = MODULES[mode] and MODULES[mode][contentId]
	if not entry or not module or entry.status ~= "available" then
		return false
	end
	if not MapService.Load(entry.map) then
		return false
	end
	cleanWorld()
	HealthService.ResetSessionStats()
	table.clear(CreatureService.Spotted)
	InventoryService.RefillCabinets()
	session = { mode = mode, contentId = contentId, mapId = entry.map, module = module, idleSince = nil }
	table.clear(entered)
	SessionService.SetCheckpoint(module.StartCheckpoint or "C1_START")
	SessionState.Set("Mode", mode)
	SessionState.Set("ContentId", contentId)
	module.Begin(entry)
	InventoryService.SpawnWorldItems(Config.Inventory.WorldItems)
	return true
end

local function leave(player: Player, respawn: boolean)
	if not inGame[player] then
		return
	end
	inGame[player] = nil
	InventoryService.Clear(player)
	DataService.Mutate(player, function(data)
		data.lastSession = {} -- left on purpose: no rejoin offer
	end)
	player:SetAttribute("FZ_InGame", false)
	player:SetAttribute("FZ_Downed", false)
	player:SetAttribute("FZ_Eliminated", false)
	player:SetAttribute("FZ_DownedUntil", nil)
	if respawn and player.Parent and not player:GetAttribute("FZ_MonsterMode") then
		player:LoadCharacter() -- back to the menu spawn, out of the station
	end
end

-- Ends the session for everyone (mode finished, or idle). Players return to the menu.
function SessionService.Finish()
	local current = session
	if not current then
		return
	end
	session = nil
	pcall(current.module.Stop)
	for player in table.clone(inGame) do
		leave(player, true)
	end
	cleanWorld()
	SessionState.Set("Mode", nil)
	SessionState.Set("ContentId", nil)
	SessionState.Set("Objective", nil)
	SessionState.Set("ObjectiveParams", nil)
end

local function join(player: Player)
	local current = session
	if not current then
		return false
	end
	inGame[player] = true
	current.idleSince = nil
	player:SetAttribute("FZ_InGame", true)
	player:SetAttribute("FZ_AutoJoin", nil)
	placeAtCheckpoint(player)
	local firstTime = not entered[player]
	entered[player] = true
	if firstTime then
		InventoryService.Reset(player)
		AnalyticsTracker.NewRun(player)
	end
	if player:GetAttribute("FZ_NewPlayer") then
		AnalyticsTracker.Onboarding(player, 3, "EnteredGame")
	end
	player:SetAttribute("FZ_RejoinAvailable", nil)
	DataService.Mutate(player, function(data)
		data.lastSession = { placeId = game.PlaceId, jobId = game.JobId, code = reservedCode or "", time = os.time() }
	end)
	if current.module.OnPlayerEntered then
		task.spawn(current.module.OnPlayerEntered, player, firstTime)
	end
	return true
end

local function completedChapters(player: Player): { [string]: any }
	local profile = DataService.Get(player)
	return if profile then profile.Data.progress.completedChapters else {}
end

local function request(player: Player, action: string, mode: any, contentId: any)
	if action == "leave" then
		leave(player, true)
		return { status = "ok" }
	elseif action == "private" then
		if inGame[player] then
			return { status = "error" }
		end
		return { status = PartyService.CreatePrivate(player) }
	elseif action == "rejoin" then
		local profile = DataService.Get(player)
		local last = profile and profile.Data.lastSession
		if not last or type(last.jobId) ~= "string" or last.jobId == game.JobId or os.time() - (last.time or 0) > REJOIN_WINDOW then
			return { status = "none" }
		end
		DataService.Mutate(player, function(data)
			data.lastSession = {}
		end)
		task.spawn(PlaceService.Rejoin, player, last.placeId, last.jobId, last.code)
		return { status = "teleport" }
	elseif action == "join" then
		return { status = if join(player) then "ok" else "none" }
	elseif action ~= "start" then
		return { status = "error" }
	end
	if type(mode) ~= "string" or type(contentId) ~= "string" then
		return { status = "error" }
	end
	local entry = Content.Entry(mode, contentId)
	if not entry or not Content.IsUnlocked(entry, completedChapters(player)) then
		return { status = "locked" }
	end
	if session and session.mode == mode and session.contentId == contentId then
		join(player)
		return { status = "ok" }
	end
	if session and #SessionService.PlayersInGame() > 0 then
		if PlaceService.CanTeleport(entry.map) then
			task.spawn(PlaceService.Teleport, { player }, entry.map, { mode = mode, contentId = contentId })
			return { status = "teleport" }
		end
		return { status = "busy", mode = session.mode, contentId = session.contentId }
	end
	if session then
		SessionService.Finish()
	end
	if not start(mode, contentId) then
		return { status = "error" }
	end
	join(player)
	return { status = "ok" }
end

function SessionService.ResetActive()
	local current = session
	if current then
		local mode, contentId = current.mode, current.contentId
		local players = SessionService.PlayersInGame()
		SessionService.Finish()
		start(mode, contentId)
		for _, player in players do
			join(player)
		end
	end
end

function SessionService.Start()
	local context = {
		setCheckpoint = SessionService.SetCheckpoint,
		finish = SessionService.Finish,
		playersInGame = SessionService.PlayersInGame,
		leave = function(player: Player)
			leave(player, true)
		end,
	}
	for _, modules in MODULES do
		for _, module in modules do
			module.Init(context)
		end
	end

	local limiter = RateLimiter.new(4, 0.5)
	Net.Function("Session").OnServerInvoke = function(player: Player, action: any, mode: any, contentId: any)
		if not limiter:Allow(player) or type(action) ~= "string" then
			return { status = "error" }
		end
		return request(player, action, mode, contentId)
	end

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function()
			if inGame[player] then
				task.defer(placeAtCheckpoint, player)
			end
		end)
		-- Arrived by teleport with a selection? Start or join it automatically.
		reservedCode = reservedCode or PlaceService.ArrivalCode(player)
		local mode, contentId = PlaceService.ArrivalSelection(player)
		if mode and contentId then
			if not session then
				start(mode :: string, contentId :: string)
			end
			if session and session.mode == mode and session.contentId == contentId then
				player:SetAttribute("FZ_AutoJoin", true)
			end
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		inGame[player] = nil
		entered[player] = nil
	end)

	-- Disconnected recently from a running session in another server? Offer the way back.
	DataService.ProfileLoaded:Connect(function(player, profile)
		local last = profile.Data.lastSession
		if type(last) == "table" and type(last.jobId) == "string" and last.jobId ~= game.JobId and os.time() - (last.time or 0) <= REJOIN_WINDOW then
			player:SetAttribute("FZ_RejoinAvailable", true)
		end
	end)

	-- End idle sessions so the next team can pick something else.
	task.spawn(function()
		local ticks = 0
		while true do
			task.wait(2)
			ticks += 1
			if ticks % 30 == 0 then
				-- keep the rejoin window fresh for long sessions (once a minute)
				for player in inGame do
					DataService.Mutate(player, function(data)
						if type(data.lastSession) == "table" and data.lastSession.jobId == game.JobId then
							data.lastSession.time = os.time()
						end
					end)
				end
			end
			local current = session
			if current then
				if next(inGame) == nil then
					current.idleSince = current.idleSince or os.clock()
					if os.clock() - current.idleSince > Config.Survival.SessionIdleEnd then
						SessionService.Finish()
					end
				else
					current.idleSince = nil
				end
			end
		end
	end)
end

return SessionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="71">
          <Properties>
            <string name="Name">SettingsService</string>
            <string name="Source"><![CDATA[-- SettingsService: persists player settings (language, subtitles, accessibility, graphics).
-- Settings are not security relevant, but are still validated against the shared schema
-- so a manipulated client can never write garbage into the save.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local AnalyticsTracker = require(script.Parent.AnalyticsTracker)

local SettingsService = {}

function SettingsService.Start()
	local limiter = RateLimiter.new(20, 5)
	Net.Event("UpdateSetting").OnServerEvent:Connect(function(player: Player, key: any, value: any)
		if not limiter:Allow(player) then
			return
		end
		local ok, sanitized = Config.ValidateSetting(key, value)
		if not ok then
			return
		end
		DataService.Mutate(player, function(data)
			data.settings[key] = sanitized
		end)
		if key == "language" and player:GetAttribute("FZ_NewPlayer") then
			AnalyticsTracker.Onboarding(player, 2, "LanguageChosen")
		end
	end)
end

return SettingsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="72">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[-- ShopService: unlock and equip items with earned Signal Marks (server-authoritative).
-- Effects are published as player attributes so client visuals and server rules read
-- the same values. Robux: only the cosmetic supporter game pass (Catalog.GamePasses).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Titles = require(Shared.Titles)
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local AnalyticsTracker = require(script.Parent.AnalyticsTracker)

local ShopService = {}

function ShopService.Publish(player: Player)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local data = profile.Data
	local effects = Catalog.Effects(data.inventory, data.equipped)
	player:SetAttribute("FZ_Set", data.equipped.set or "")
	player:SetAttribute("FZ_HoldMultiplier", effects.interactHoldMultiplier or 1)
	player:SetAttribute("FZ_NightVision", effects.nightVision == true)
	player:SetAttribute("FZ_Footprints", effects.footprints == true)
	player:SetAttribute("FZ_ReviveMultiplier", effects.reviveMultiplier or 1)
	player:SetAttribute("FZ_ReviveHealth", effects.reviveHealth or Config.Health.ReviveHealth)
	player:SetAttribute("FZ_RegenCap", effects.regenCap or Config.Health.RegenCap)
	player:SetAttribute("FZ_ScareDampening", effects.scareDampening == true)
	player:SetAttribute("FZ_FlashRange", effects.flashlightRange or 1)
	player:SetAttribute("FZ_BlindCooldownScale", effects.blindCooldown or 1)
	local skin = data.equipped.radioSkin and Catalog.Items[data.equipped.radioSkin]
	player:SetAttribute("FZ_RadioColor", if skin then skin.color else Catalog.DefaultRadioColor)
	local flash = data.equipped.flashlight and Catalog.Items[data.equipped.flashlight]
	player:SetAttribute("FZ_FlashColor", if flash then flash.light else Catalog.DefaultFlashlight)
	local title = data.equipped.title and Titles.Get(data.equipped.title)
	player:SetAttribute("FZ_Title", if title and title.earned(data) then title.name else nil)
end

local function earnedTitles(data): { string }
	local list = {}
	for _, title in Titles.List do
		local ok, earned = pcall(title.earned, data)
		if ok and earned then
			table.insert(list, title.id)
		end
	end
	return list
end

local function snapshot(player: Player)
	local profile = DataService.Get(player)
	if not profile then
		return { ok = false }
	end
	return {
		ok = true,
		inventory = table.clone(profile.Data.inventory),
		equipped = table.clone(profile.Data.equipped),
		balance = profile.Data.signalMarks,
		titles = earnedTitles(profile.Data),
	}
end

local function buy(player: Player, itemId: string)
	local item = Catalog.Items[itemId]
	local profile = DataService.Get(player)
	if not item or not profile then
		return { ok = false, reason = "error" }
	end
	if not profile.Persistent then
		return { ok = false, reason = "error" } -- never sell into a save that cannot be stored
	end
	if profile.Data.inventory[itemId] then
		return { ok = false, reason = "owned" }
	end
	if profile.Data.signalMarks < item.price then
		return { ok = false, reason = "funds" }
	end
	DataService.Mutate(player, function(data)
		data.signalMarks -= item.price
		data.inventory[itemId] = true
	end)
	DataService.SaveNow(player)
	AnalyticsTracker.Economy(player, item.price, profile.Data.signalMarks, false, itemId)
	return { ok = true }
end

local function equip(player: Player, itemId: string, on: boolean)
	local item = Catalog.Items[itemId]
	local profile = DataService.Get(player)
	if not item or not profile or not profile.Data.inventory[itemId] then
		return { ok = false, reason = "error" }
	end
	DataService.Mutate(player, function(data)
		if item.kind == "set" then
			data.equipped.set = if on then itemId else nil
		elseif item.kind == "radioSkin" then
			data.equipped.radioSkin = if on then itemId else nil
		elseif item.kind == "flashlightSkin" then
			data.equipped.flashlight = if on then itemId else nil
		end
	end)
	return { ok = true }
end

local function grantGamePass(player: Player, passKey: string)
	local pass = Catalog.GamePasses[passKey]
	if pass and pass.grantsRadioSkin then
		DataService.Mutate(player, function(data)
			data.inventory[pass.grantsRadioSkin] = true
		end)
	end
end

function ShopService.Start()
	local limiter = RateLimiter.new(8, 2)
	Net.Function("ShopAction").OnServerInvoke = function(player: Player, action: any, itemId: any)
		if not limiter:Allow(player) or type(action) ~= "string" then
			return { ok = false, reason = "error" }
		end
		local result
		if action == "get" then
			return snapshot(player)
		elseif type(itemId) ~= "string" then
			return { ok = false, reason = "error" }
		elseif action == "title" then
			local profile = DataService.Get(player)
			local title = Titles.Get(itemId)
			if profile and (itemId == "" or (title and title.earned(profile.Data))) then
				DataService.Mutate(player, function(data)
					data.equipped.title = if itemId == "" then nil else itemId
				end)
				result = { ok = true }
			else
				result = { ok = false, reason = "error" }
			end
		elseif action == "buy" then
			result = buy(player, itemId)
		elseif action == "equip" then
			result = equip(player, itemId, true)
		elseif action == "unequip" then
			result = equip(player, itemId, false)
		else
			return { ok = false, reason = "error" }
		end
		ShopService.Publish(player)
		local snap = snapshot(player)
		snap.ok = result.ok
		snap.reason = result.reason
		return snap
	end

	DataService.ProfileLoaded:Connect(function(player)
		for key, pass in Catalog.GamePasses do
			if pass.id > 0 then
				local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.id)
				if ok and owns then
					grantGamePass(player, key)
				end
			end
		end
		ShopService.Publish(player)
	end)

	for _, player in Players:GetPlayers() do
		if DataService.Get(player) then
			ShopService.Publish(player)
		end
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for key, pass in Catalog.GamePasses do
			if pass.id == passId then
				grantGamePass(player, key)
				ShopService.Publish(player)
			end
		end
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="73">
          <Properties>
            <string name="Name">StoryService</string>
            <string name="Source"><![CDATA[-- StoryService: sends story content (subtitles, documents, objectives) to clients.
-- Only localization KEYS travel over the network; every client renders them in its own
-- language. Targets can be a single player (individual perception) or "all".

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local StoryService = {}

export type Line = {
	text: string, -- localization key
	speaker: string?, -- localization key
	params: { [string]: any }?,
	duration: number?,
	channel: string?, -- "radio" | "world" | "sfx"
	critical: boolean?, -- shown even with subtitles off (safety-relevant sounds)
	delay: number?, -- seconds to wait before this line (Sequence only)
}

type Target = Player | "all"

local subtitleRemote = Net.Event("Subtitle")
local documentRemote = Net.Event("Document")
local flags: { [string]: any } = {}

function StoryService.Say(target: Target, line: Line)
	if target == "all" then
		subtitleRemote:FireAllClients(line)
	else
		subtitleRemote:FireClient(target :: Player, line)
	end
end

function StoryService.Sequence(target: Target, lines: { Line })
	task.spawn(function()
		for _, line in lines do
			if line.delay then
				task.wait(line.delay)
			end
			if target ~= "all" and (target :: Player).Parent == nil then
				return
			end
			StoryService.Say(target, line)
		end
	end)
end

function StoryService.ShowDocument(player: Player, document: { [string]: any })
	documentRemote:FireClient(player, document)
end

-- params are replicated as JSON (e.g. { count = 1, total = 3 } for "Find fuses (1/3)").
function StoryService.SetObjective(key: string?, params: { [string]: any }?)
	SessionState.Set("ObjectiveParams", if params then HttpService:JSONEncode(params) else nil)
	SessionState.Set("Objective", key)
end

function StoryService.GetObjective(): string?
	return SessionState.Get("Objective")
end

-- Session flags are shared by the whole team and replicated as "Flag_<name>".
function StoryService.SetFlag(name: string, value: any)
	flags[name] = value
	SessionState.Set("Flag_" .. name, value)
end

function StoryService.GetFlag(name: string): any
	return flags[name]
end

function StoryService.ResetFlags()
	for name in flags do
		SessionState.Set("Flag_" .. name, nil)
	end
	table.clear(flags)
end

return StoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="74">
          <Properties>
            <string name="Name">VoiceService</string>
            <string name="Source"><![CDATA[-- VoiceService: proximity voice + walkie-talkie radio on top of the Roblox Audio API.
--
-- Per player (server):  AudioDeviceInput (microphone)
--   -> AudioFader "FZ_VoiceFader" (clients use it to mute someone locally)
--   -> AudioEmitter "FZ_VoiceEmitter" in the head (spatial: quieter with distance)
-- The radio is mixed on every client (VoiceController): while a player transmits, each
-- listener wires that player's microphone through a radio filter whose volume and static
-- depend on the distance between them.
--
-- Requirements (Studio, not scriptable): VoiceChatService.UseAudioApi = Enabled and
-- VoiceChatService.EnableDefaultVoice = false (both set in default.project.json).
-- Players without Roblox voice chat simply have no microphone; everything else works.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local NoiseService = require(script.Parent.NoiseService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local VoiceService = {}

local transmitting: { [Player]: boolean } = {}

local function wire(source: Instance, target: Instance, parent: Instance)
	local w = Instance.new("Wire")
	w.SourceInstance = source
	w.TargetInstance = target
	w.Parent = parent
	return w
end

local function getInput(player: Player): Instance?
	local existing = player:FindFirstChildOfClass("AudioDeviceInput")
	if existing then
		return existing
	end
	local ok, input = pcall(function()
		local created = Instance.new("AudioDeviceInput")
		created.Name = "FZ_Microphone"
		;(created :: any).Player = player
		created.Parent = player
		return created
	end)
	if not ok then
		warn("[FZ-Voice] Audio API unavailable: " .. tostring(input))
		return nil
	end
	return input
end

local function setupCharacter(player: Player, character: Model)
	local input = getInput(player)
	local head = character:WaitForChild("Head", 10)
	if not input or not head then
		return
	end
	pcall(function()
		local fader = Instance.new("AudioFader")
		fader.Name = "FZ_VoiceFader"
		fader.Parent = head
		local emitter = Instance.new("AudioEmitter")
		emitter.Name = "FZ_VoiceEmitter"
		emitter.Parent = head
		;(emitter :: any):SetDistanceAttenuation({
			[0] = 1,
			[Config.Voice.ProximityFull] = 1,
			[Config.Voice.ProximityFull * 3] = 0.35,
			[Config.Voice.ProximityMax] = 0,
		})
		wire(input, fader, fader)
		wire(fader, emitter, emitter)
	end)
end

local function setTransmitting(player: Player, value: boolean)
	transmitting[player] = value or nil
	player:SetAttribute("FZ_RadioTx", value)
end

function VoiceService.Start()
	local radioLimiter = RateLimiter.new(8, 4)
	local muteLimiter = RateLimiter.new(6, 2)

	Net.Event("RadioState").OnServerEvent:Connect(function(player: Player, value: any)
		if type(value) ~= "boolean" or not radioLimiter:Allow(player) then
			return
		end
		if value and not player:GetAttribute("FZ_InGame") then
			return
		end
		setTransmitting(player, value)
	end)

	Net.Event("MicMute").OnServerEvent:Connect(function(player: Player, muted: any)
		if type(muted) ~= "boolean" or not muteLimiter:Allow(player) then
			return
		end
		local input = getInput(player)
		if input then
			pcall(function()
				(input :: any).Muted = muted
			end)
		end
		player:SetAttribute("FZ_MicMuted", muted)
	end)

	local function onPlayer(player: Player)
		player:SetAttribute("FZ_MicMuted", false)
		player:SetAttribute("FZ_RadioTx", false)
		player.CharacterAdded:Connect(function(character)
			setupCharacter(player, character)
		end)
		if player.Character then
			task.spawn(setupCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		transmitting[player] = nil
	end)

	-- A live radio is audible to the creature at the sender's position.
	task.spawn(function()
		while true do
			task.wait(1)
			for player in transmitting do
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if root then
					NoiseService.Emit((root :: BasePart).Position, Config.Noise.Radio, player)
				end
			end
		end
	end)
end

return VoiceService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="75">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="76">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[-- Token-bucket rate limiter per player. Every client->server remote uses one.

local Players = game:GetService("Players")

local RateLimiter = {}
RateLimiter.__index = RateLimiter

local limiters = {}

Players.PlayerRemoving:Connect(function(player)
	for _, limiter in limiters do
		limiter._buckets[player] = nil
	end
end)

-- capacity: burst size, refillPerSecond: sustained rate
function RateLimiter.new(capacity: number, refillPerSecond: number)
	local self = setmetatable({
		_capacity = capacity,
		_refill = refillPerSecond,
		_buckets = {},
	}, RateLimiter)
	table.insert(limiters, self)
	return self
end

function RateLimiter:Allow(player: Player, cost: number?): boolean
	local price = cost or 1
	local now = os.clock()
	local bucket = self._buckets[player]
	if not bucket then
		bucket = { tokens = self._capacity, time = now }
		self._buckets[player] = bucket
	end
	bucket.tokens = math.min(self._capacity, bucket.tokens + (now - bucket.time) * self._refill)
	bucket.time = now
	if bucket.tokens < price then
		return false
	end
	bucket.tokens -= price
	return true
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="77">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="78">
      <Properties>
        <string name="Name">Secrets</string>
      </Properties>
      <Item class="ModuleScript" referent="79">
        <Properties>
          <string name="Name">Codes</string>
          <string name="Source"><![CDATA[-- Redeemable codes. Lives in ServerStorage: never replicated to clients.
-- Key = exactly what the player types (normalized: uppercase, no whitespace).
-- id   = stable save id. Never reuse or rename an id, or players could redeem twice.
-- Each code must be physically findable in the world (see docs/GAME_DESIGN.md, "Codes").

return {
	-- Lobby notice board, maintenance note (Chapter 1).
	["SIGNAL-017"] = { id = "signal_017", reward = { signalMarks = 25 }, active = true },
	-- Gatehouse logbook, last line (Chapter 1).
	["VESPER-0214"] = { id = "vesper_0214", reward = { signalMarks = 40 }, active = true },
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="80">
        <Properties>
          <string name="Name">SecretAnswers</string>
          <string name="Source"><![CDATA[-- Answers to community secrets. Server only. Compared after normalising the input
-- (uppercase, letters and digits only), so "0214 · 0041 · 0007" works as well.
return {
	zero_frequency = { "021400410007" },
}
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="81">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="CameraMode">1</token>
      <float name="CharacterWalkSpeed">10</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterCharacterScripts" referent="82">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Script" referent="83">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Intentionally empty. A Script named "Health" in StarterCharacterScripts replaces
-- Roblox's default health regeneration, so HealthService alone controls healing.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="84">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="85">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="86">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="87">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[-- AudioController: every non-voice sound on the client.
--   * Sound groups (Ambience / SFX / Creature / UI) for clean mixing and ducking
--   * Ambience: wind outside, electric hum inside the building, generators (3D)
--   * Footsteps for every nearby character, by floor material (local, no network)
--   * Server-triggered 3D effects via the "Sfx" remote
-- Sounds play only when their id is set in Shared/Assets.luau; otherwise silently skipped.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared.Assets)
local Net = require(Shared.Net)

local AudioController = {}

local groups: { [string]: SoundGroup } = {}
local settings = nil
local scareFactor = 0.85
local duckFactor = 1
local inMenu = true
local tension: { [string]: Sound? } = {}
local tensionLevel = { music_menu = 0, tension_low = 0, tension_high = 0 }
local currentReverb: Enum.ReverbType? = nil

local BUILDING_MIN = Vector3.new(-100, -5, -85)
local BUILDING_MAX = Vector3.new(100, 20, 85)

local function insideBuilding(position: Vector3): boolean
	return position.X > BUILDING_MIN.X and position.X < BUILDING_MAX.X and position.Z > BUILDING_MIN.Z and position.Z < BUILDING_MAX.Z and position.Y < BUILDING_MAX.Y
end

local function group(name: string, volume: number): SoundGroup
	local g = Instance.new("SoundGroup")
	g.Name = "FZ_" .. name
	g.Volume = volume
	g.Parent = SoundService
	groups[name] = g
	return g
end

function AudioController.Id(name: string): string?
	local id = Assets.Sounds[name]
	if type(id) == "string" and id ~= "" then
		return id
	end
	return nil
end

-- Variants: "creature_growl" -> creature_growl_1 / _2 / _3 (only uploaded ones), never the
-- same one twice in a row, so repeated events do not sound repeated.
local lastVariant: { [string]: string } = {}
function AudioController.Variant(base: string): string
	local options = {}
	for i = 1, 9 do
		local name = base .. "_" .. i
		if AudioController.Id(name) and name ~= lastVariant[base] then
			table.insert(options, name)
		end
	end
	if #options == 0 then
		return lastVariant[base] or base
	end
	local choice = options[math.random(1, #options)]
	lastVariant[base] = choice
	return choice
end

-- Muffles a 3D sound when a wall is between the listener and the source.
local occlusionParams = RaycastParams.new()
occlusionParams.FilterType = Enum.RaycastFilterType.Exclude
local function occlude(sound: Sound, position: Vector3)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local filter: { Instance } = { camera }
	if Players.LocalPlayer.Character then
		table.insert(filter, Players.LocalPlayer.Character :: Instance)
	end
	occlusionParams.FilterDescendantsInstances = filter
	local origin = camera.CFrame.Position
	local hit = workspace:Raycast(origin, position - origin, occlusionParams)
	if hit and (hit.Position - position).Magnitude > 2 then
		local eq = Instance.new("EqualizerSoundEffect")
		eq.LowGain = 2
		eq.MidGain = -10
		eq.HighGain = -26
		eq.Parent = sound
		sound.Volume *= 0.75
	end
end

-- Plays a one-shot. `at` may be a Vector3, a BasePart/Attachment, or nil (2D).
-- muffle = true: sounds behind walls are low-passed (spatial credibility).
function AudioController.Play(name: string, at: any?, volume: number?, groupName: string?, muffle: boolean?): Sound?
	local id = AudioController.Id(name)
	if not id then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.8
	sound.SoundGroup = groups[groupName or "SFX"]
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 8
	sound.RollOffMaxDistance = 120
	if typeof(at) == "Vector3" then
		local attachment = Instance.new("Attachment")
		attachment.WorldPosition = at
		attachment.Parent = workspace.Terrain
		sound.Parent = attachment
		sound.Ended:Once(function()
			attachment:Destroy()
		end)
	elseif typeof(at) == "Instance" and (at:IsA("BasePart") or at:IsA("Attachment")) then
		sound.Parent = at
		sound.Ended:Once(function()
			sound:Destroy()
		end)
	else
		sound.Parent = SoundService
		sound.Ended:Once(function()
			sound:Destroy()
		end)
	end
	if muffle then
		local position = if typeof(at) == "Vector3" then at elseif typeof(at) == "Instance" and at:IsA("BasePart") then at.Position elseif typeof(at) == "Instance" and at:IsA("Attachment") then at.WorldPosition else nil
		if position then
			occlude(sound, position)
		end
	end
	sound:Play()
	return sound
end

function AudioController.PlayVariant(base: string, at: any?, volume: number?, groupName: string?, muffle: boolean?): Sound?
	return AudioController.Play(AudioController.Variant(base), at, volume, groupName, muffle)
end

function AudioController.Loop(name: string, parent: Instance, volume: number, groupName: string?): Sound?
	local id = AudioController.Id(name)
	if not id then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = "Loop_" .. name
	sound.SoundId = id
	sound.Looped = true
	sound.Volume = volume
	sound.SoundGroup = groups[groupName or "Ambience"]
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 6
	sound.RollOffMaxDistance = 70
	sound.Parent = parent
	sound:Play()
	return sound
end

local function setting(key: string): number
	local value = settings and settings.Get(key)
	return (if type(value) == "number" then value else 10) / 10
end

-- Applies the volume sliders (Settings -> Audio) to the sound groups.
function AudioController.ApplyVolumes()
	if not groups.SFX then
		return
	end
	local master = setting("volumeMaster")
	groups.SFX.Volume = master * setting("volumeEffects")
	groups.Creature.Volume = master * setting("volumeEffects") * scareFactor
	groups.Ambience.Volume = master * setting("volumeAmbience") * duckFactor
	groups.Music.Volume = master * setting("volumeMusic") * (0.6 + 0.4 * duckFactor)
	groups.UI.Volume = master * setting("volumeUI")
end

-- Scare intensity / medic set dampen creature sounds.
function AudioController.SetScareFactor(value: number)
	scareFactor = value
	AudioController.ApplyVolumes()
end

-- Lowers ambience and music while important voices/radio play.
local duckToken = 0
function AudioController.Duck(seconds: number)
	duckToken += 1
	local token = duckToken
	duckFactor = 0.45
	AudioController.ApplyVolumes()
	task.delay(seconds, function()
		if token == duckToken then
			duckFactor = 1
			AudioController.ApplyVolumes()
		end
	end)
end

function AudioController.SetMenu(value: boolean)
	inMenu = value
end

local function updateMusic(position: Vector3, elapsed: number)
	local targets = { music_menu = 0, tension_low = 0, tension_high = 0 }
	if inMenu then
		targets.music_menu = 0.6
	else
		local nearest, chasing = math.huge, false
		for _, model in CollectionService:GetTagged("FZ_CreatureRig") do
			local root = model:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and model ~= Players.LocalPlayer.Character and not model:GetAttribute("Hidden") then
				local d = (root.Position - position).Magnitude
				if d < nearest then
					nearest = d
					chasing = model:GetAttribute("State") == "Chase" or model:GetAttribute("State") == "Attack"
				end
			end
		end
		if chasing and nearest < 90 then
			targets.tension_high, targets.tension_low = 0.8, 0.3
		elseif nearest < 45 then
			targets.tension_low = 0.75
		elseif nearest < math.huge then
			targets.tension_low = 0.25
		end
	end
	for name, target in targets do
		local sound = tension[name]
		if sound then
			-- fade in slowly, fade out a bit faster (silence is a tool)
			local speed = if target > tensionLevel[name] then 0.6 else 1.2
			tensionLevel[name] += (target - tensionLevel[name]) * math.min(1, elapsed * speed)
			sound.Volume = tensionLevel[name]
		end
	end
end

local function updateReverb(position: Vector3)
	local reverb
	if math.abs(position.X) < 22 and math.abs(position.Z) < 22 then
		reverb = Enum.ReverbType.ConcertHall -- the round core
	elseif insideBuilding(position) then
		reverb = Enum.ReverbType.Hallway
	else
		reverb = Enum.ReverbType.Forest
	end
	if reverb ~= currentReverb then
		currentReverb = reverb
		SoundService.AmbientReverb = reverb
	end
end


local function materialSound(material: Enum.Material): string
	if material == Enum.Material.Metal or material == Enum.Material.DiamondPlate or material == Enum.Material.CorrodedMetal then
		return "footstep_metal_" .. math.random(1, 2)
	elseif material == Enum.Material.Grass or material == Enum.Material.Ground or material == Enum.Material.Mud or material == Enum.Material.LeafyGrass then
		return "footstep_grass_" .. math.random(1, 2)
	end
	return "footstep_concrete_" .. math.random(1, 3)
end

function AudioController.Init(settingsController)
	settings = settingsController
	group("Ambience", 1)
	group("SFX", 1)
	group("Creature", 1)
	group("UI", 0.7)
	group("Music", 0.6)
	AudioController.ApplyVolumes()
	settingsController.Changed:Connect(function(key)
		if string.sub(key, 1, 6) == "volume" then
			AudioController.ApplyVolumes()
		end
	end)
	for name in tensionLevel do
		tension[name] = AudioController.Loop(name, SoundService, 0, "Music")
	end

	-- Ambient beds (2D), crossfaded by position
	local wind = AudioController.Loop("ambience_wind_loop", SoundService, 0)
	local hum = AudioController.Loop("hum_electric_loop", SoundService, 0)
	if wind then
		wind.RollOffMaxDistance = 10000
	end

	for _, source in CollectionService:GetTagged("FZ_AmbientSource") do
		local loopName = source:GetAttribute("SoundLoop")
		if type(loopName) == "string" then
			AudioController.Loop(loopName, source, 0.6)
		end
	end
	CollectionService:GetInstanceAddedSignal("FZ_AmbientSource"):Connect(function(source)
		local loopName = source:GetAttribute("SoundLoop")
		if type(loopName) == "string" then
			AudioController.Loop(loopName, source, 0.6)
		end
	end)

	Net.Event("Sfx").OnClientEvent:Connect(function(name, at, volume)
		if type(name) ~= "string" then
			return
		end
		local groupName = if string.sub(name, 1, 8) == "creature" then "Creature" else "SFX"
		AudioController.Play(name, at, if type(volume) == "number" then volume else nil, groupName)
	end)

	-- Footsteps + ambience mix, 10 Hz is enough
	local stepTimers: { [Model]: number } = {}
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		for model, timer in stepTimers do
			stepTimers[model] = timer - dt
		end
		if accumulator < 0.1 then
			return
		end
		local elapsed = accumulator
		accumulator = 0
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local inside = insideBuilding(camera.CFrame.Position)
		updateMusic(camera.CFrame.Position, elapsed)
		updateReverb(camera.CFrame.Position)
		if wind then
			wind.Volume += ((if inside then 0.12 else 0.55) - wind.Volume) * math.min(1, elapsed * 2)
		end
		if hum then
			hum.Volume += ((if inside then 0.35 else 0) - hum.Volume) * math.min(1, elapsed * 2)
		end
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if root and humanoid and not player:GetAttribute("FZ_MonsterMode") and (root.Position - camera.CFrame.Position).Magnitude < 60 then
				local velocity = root.AssemblyLinearVelocity
				local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
				if speed > 2 and humanoid.FloorMaterial ~= Enum.Material.Air then
					local remaining = stepTimers[character :: Model] or 0
					if remaining <= 0 then
						local interval = math.clamp(4.2 / speed, 0.26, 0.65)
						stepTimers[character :: Model] = interval
						AudioController.Play(materialSound(humanoid.FloorMaterial), root.Position - Vector3.new(0, 2.5, 0), if speed > 13 then 0.9 else 0.55)
					end
				end
			end
		end
		for model in stepTimers do
			if not model.Parent then
				stepTimers[model] = nil
			end
		end
	end)
end

function AudioController.UI(name: string)
	AudioController.Play(name, nil, 0.5, "UI")
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="88">
            <Properties>
              <string name="Name">CreatureVisualsController</string>
              <string name="Source"><![CDATA[-- CreatureVisualsController: everything the player SEES and HEARS of the creature.
--   * Procedural animation (Motor6D.Transform) for the built-in rig: long-limbed gait,
--     listening head tilt, telegraphed attack wind-up, covering its head when blinded
--   * "Signal dropouts": the pose freezes for a few frames now and then, with a crackle
--   * Breath loop on the head, random clicks, a close-range warning caption
--   * Vent travel: hidden locally while the server moves it
-- Rigs with Procedural = false (your own model with real animations) only get audio.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local AudioController = require(script.Parent.AudioController)

local CreatureVisualsController = {}

type RigState = {
	model: Model,
	motors: { [string]: Motor6D },
	phase: number,
	frozenUntil: number,
	nextFreeze: number,
	nextClick: number,
	breath: Sound?,
	lastHidden: boolean?,
	nextBreath: number,
	nextVoice: number,
	lastStep: number,
}

local rigs: { [Model]: RigState } = {}
local showCaption: ((line: { [string]: any }) -> ())? = nil
local lastWarning = 0

local function angles(x: number, y: number, z: number): CFrame
	return CFrame.Angles(x, y, z)
end

local function register(model: Instance)
	if not model:IsA("Model") or rigs[model] then
		return
	end
	local motors = {}
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("Motor6D") then
			motors[descendant.Name] = descendant
		end
	end
	local head = model:WaitForChild("Head", 5)
	local state: RigState = {
		model = model,
		motors = motors,
		phase = 0,
		frozenUntil = 0,
		nextFreeze = os.clock() + 2,
		nextClick = os.clock() + 3,
		-- legacy loop only when the new breath variants are not uploaded yet
		breath = if head and head:IsA("BasePart") and not AudioController.Id("creature_breath_deep_1") then AudioController.Loop("creature_breath", head, 0.45, "Creature") else nil,
		lastHidden = nil,
		nextBreath = os.clock() + 1,
		nextVoice = os.clock() + 4,
		lastStep = 0,
	}
	rigs[model] = state
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			rigs[model] = nil
		end
	end)
end

local function setHidden(state: RigState, hidden: boolean)
	if state.lastHidden == hidden then
		return
	end
	state.lastHidden = hidden
	for _, descendant in state.model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.LocalTransparencyModifier = if hidden then 1 else 0
		end
	end
	if state.breath then
		state.breath.Volume = if hidden then 0 else 0.45
	end
end

local function animate(state: RigState, dt: number)
	local model = state.model
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local m = state.motors
	local now = os.clock()
	local creatureState = model:GetAttribute("State") or "Patrol"
	setHidden(state, model:GetAttribute("Hidden") == true)

	-- Audio cues (distance-limited)
	local camera = workspace.CurrentCamera
	local distance = if camera then (root.Position - camera.CFrame.Position).Magnitude else math.huge
	if model == Players.LocalPlayer.Character then
		distance = math.huge -- you are the monster (admin test mode): no warnings for yourself
	end
	local head = model:FindFirstChild("Head")
	local source = if head and head:IsA("BasePart") then head else root
	if creatureState ~= "Dormant" and distance < 70 and not state.lastHidden then
		-- Irregular deep breathing: never on a fixed rhythm
		if now >= state.nextBreath then
			state.nextBreath = now + math.random(28, 55) / 10
			AudioController.PlayVariant("creature_breath_deep", source, 0.55, "Creature", true)
		end
		-- Body cracks, growl while listening / investigating, knocking while searching
		if now >= state.nextClick then
			state.nextClick = now + math.random(30, 70) / 10
			AudioController.PlayVariant("creature_crack", source, 0.5, "Creature", true)
		end
		if now >= state.nextVoice and (creatureState == "Listen" or creatureState == "Investigate" or creatureState == "Search") then
			state.nextVoice = now + math.random(50, 110) / 10
			if creatureState == "Search" and math.random() < 0.4 then
				AudioController.Play("creature_rhythm", source, 0.45, "Creature", true)
			else
				AudioController.PlayVariant("creature_growl", source, 0.55, "Creature", true)
			end
		end
		-- Dragging steps synced to its movement
		local velocity = root.AssemblyLinearVelocity
		local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		if speed > 2 and now - state.lastStep > math.clamp(5 / speed, 0.35, 1.1) then
			state.lastStep = now
			AudioController.PlayVariant("creature_drag", root.Position - Vector3.new(0, 4.5, 0), 0.5, "Creature", true)
		end
	end
	if distance < 16 and creatureState ~= "Dormant" and not state.lastHidden and now - lastWarning > 25 and showCaption then
		lastWarning = now
		showCaption({ text = "SFX_CREATURE_NEAR", channel = "world", duration = 2.5, critical = true })
	end

	if model:GetAttribute("Procedural") ~= true then
		return
	end

	-- Signal dropout: freeze the pose for a few frames
	if now >= state.nextFreeze then
		state.frozenUntil = now + math.random(6, 16) / 100
		state.nextFreeze = now + math.random(8, 26) / 10
		if distance < 35 and math.random() < 0.35 then
			AudioController.Play("creature_static_burst", root, 0.35, "Creature")
		end
	end
	if now < state.frozenUntil then
		return
	end

	local velocity = root.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local stride = math.clamp(speed / 12, 0, 1.2)
	state.phase += dt * (2 + speed * 0.45)
	local p = state.phase
	local swing = math.sin(p) * 0.7 * stride
	local breathe = math.sin(now * 1.7) * 0.04

	local hunch, neckX, neckZ = -0.15, 0.25, 0
	local armL, armR, elbow = 0.25 - swing * 0.6, 0.25 + swing * 0.6, -0.35
	if creatureState == "Listen" then
		hunch, neckX, neckZ = 0.05, 0.1, math.sin(now * 0.8) * 0.15 + 0.55
		armL, armR = 0.05, 0.05
	elseif creatureState == "Attack" then
		hunch, neckX = -0.35, 0.45
		armL, armR, elbow = -2.3, -2.1, -0.6
	elseif creatureState == "Blinded" then
		hunch, neckX = 0.25, -0.4
		armL, armR, elbow = -2.6, -2.6, -2.0
	elseif creatureState == "Chase" then
		hunch, neckX = -0.45, 0.55
	end

	local function set(name: string, cf: CFrame)
		local motor = m[name]
		if motor then
			motor.Transform = cf
		end
	end
	set("RootJoint", angles(hunch + breathe, 0, math.sin(p) * 0.06 * stride))
	set("Neck", angles(neckX, math.sin(now * 0.37) * 0.15, neckZ))
	set("LeftShoulder", angles(armL, 0, -0.08))
	set("RightShoulder", angles(armR, 0, 0.08))
	set("LeftElbow", angles(elbow - math.max(0, swing) * 0.4, 0, 0))
	set("RightElbow", angles(elbow - math.max(0, -swing) * 0.4, 0, 0))
	set("LeftHip", angles(swing, 0, 0))
	set("RightHip", angles(-swing, 0, 0))
	set("LeftKnee", angles(-math.max(0, math.sin(p + 0.9)) * 1.1 * stride, 0, 0))
	set("RightKnee", angles(-math.max(0, math.sin(p + 0.9 + math.pi)) * 1.1 * stride, 0, 0))
end

function CreatureVisualsController.Init(captionCallback: (line: { [string]: any }) -> ())
	showCaption = captionCallback
	CollectionService:GetInstanceAddedSignal("FZ_CreatureRig"):Connect(register)
	for _, model in CollectionService:GetTagged("FZ_CreatureRig") do
		task.spawn(register, model)
	end
	CollectionService:GetInstanceRemovedSignal("FZ_CreatureRig"):Connect(function(model)
		rigs[model :: Model] = nil
	end)
	-- Stepped runs before physics/animation, the documented place for Motor6D.Transform.
	RunService.Stepped:Connect(function(_, dt)
		for _, state in rigs do
			animate(state, dt)
		end
	end)
end

return CreatureVisualsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="89">
            <Properties>
              <string name="Name">DirectorController</string>
              <string name="Source"><![CDATA[-- DirectorController: performs the HorrorDirector's moments on THIS client only.
-- Respects the player's "Scare intensity": reduced = farther away, shorter, no stinger;
-- intense = closer, stinger sound. Nothing here flashes the screen or spikes volume.
--
--   apparition : a tall figure at the end of the hallway you look down - gone a moment later
--   footsteps  : steps right behind you (turn around: nothing)
--   flicker    : the lights in your room stutter for a second
--   cctv       : the security monitor shows your team 20 s in the future (+ a figure)
--   namecall   : a voice on the radio says your name - only you hear it

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local AudioController = require(script.Parent.AudioController)

local DirectorController = {}

local player = Players.LocalPlayer
local settings = nil
local showSubtitle: ((line: { [string]: any }) -> ())? = nil

local function intensity(): string
	return settings and settings.Get("scareIntensity") or "standard"
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

---------------------------------------------------------------------------
-- Figure (local only, never collides, never hurts)
---------------------------------------------------------------------------
local function buildFigure(): Model
	local model = Instance.new("Model")
	model.Name = "FZ_Apparition"
	local color = Color3.fromRGB(14, 12, 12)
	local function part(name: string, size: Vector3, cf: CFrame)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = true
		p.Parent = model
		return p
	end
	local root = part("Torso", Vector3.new(1.3, 3.4, 0.7), CFrame.new(0, 6.3, 0))
	model.PrimaryPart = root
	part("Head", Vector3.new(1.2, 1.3, 1.5), CFrame.new(0, 8.6, -0.2))
	local horn = part("Horn", Vector3.new(0.4, 2, 2), CFrame.new(0, 8.6, -1.1) * CFrame.Angles(0, math.rad(90), 0))
	horn.Shape = Enum.PartType.Cylinder
	for _, s in { -1, 1 } do
		part("Arm", Vector3.new(0.3, 6.4, 0.3), CFrame.new(s * 0.9, 4.6, 0) * CFrame.Angles(0, 0, s * 0.06))
		part("Leg", Vector3.new(0.4, 4.8, 0.4), CFrame.new(s * 0.4, 2.4, 0))
	end
	return model
end

local function apparition()
	local camera = workspace.CurrentCamera
	local character = player.Character
	if not camera or not character then
		return
	end
	local level = intensity()
	local look = camera.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude < 0.1 then
		return
	end
	flatLook = flatLook.Unit
	rayParams.FilterDescendantsInstances = { character, camera }
	local origin = camera.CFrame.Position
	local hit = workspace:Raycast(origin, flatLook * 90, rayParams)
	local distance = if hit then hit.Distance - 3 else 70
	local minimum = if level == "reduced" then 45 elseif level == "intense" then 22 else 30
	if distance < minimum then
		return -- not a long enough sightline right now: skip rather than force it
	end
	local floor = workspace:Raycast(origin + flatLook * distance, Vector3.new(0, -30, 0), rayParams)
	local base = if floor then floor.Position else (origin + flatLook * distance - Vector3.new(0, 4.5, 0))
	local figure = buildFigure()
	figure:PivotTo(CFrame.lookAt(base, base - flatLook))
	figure.Parent = camera
	if level == "intense" then
		AudioController.Play("stinger_low", nil, 0.5, "Creature")
	end
	AudioController.Play("creature_click", base + Vector3.new(0, 6, 0), 0.6, "Creature")
	local lifetime = if level == "reduced" then 1.2 elseif level == "intense" then 2.4 else 1.8
	local started = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function()
		local cam = workspace.CurrentCamera
		local tooClose = cam and (cam.CFrame.Position - base).Magnitude < 18
		if os.clock() - started > lifetime or tooClose then
			connection:Disconnect()
			-- gone in a single frame, like a signal dropout
			figure:Destroy()
		end
	end)
end

local function footsteps()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local count = if intensity() == "reduced" then 2 elseif intensity() == "intense" then 6 else 4
	for i = 1, count do
		task.delay(i * 0.42, function()
			local cam = workspace.CurrentCamera
			if cam then
				local behind = cam.CFrame.Position - Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z).Unit * 7 - Vector3.new(0, 4, 0)
				AudioController.Play("footstep_concrete_" .. ((i % 3) + 1), behind, 0.7)
			end
		end)
	end
end

local function flicker()
	local camera = workspace.CurrentCamera
	if not camera or (settings and settings.Get("reduceFlicker")) then
		return -- accessibility: no light flicker at all
	end
	local lights = {}
	for _, fixture in CollectionService:GetTagged("FZ_SectorLight") do
		if fixture:IsA("BasePart") and (fixture.Position - camera.CFrame.Position).Magnitude < 35 then
			for _, child in fixture:GetChildren() do
				if child:IsA("Light") and child.Enabled then
					table.insert(lights, child)
				end
			end
		end
	end
	if #lights == 0 then
		return
	end
	AudioController.Play("creature_static_burst", camera.CFrame.Position + camera.CFrame.LookVector * 6, 0.3, "Creature")
	local pattern = if intensity() == "reduced" then { 0.08, 0.25 } else { 0.06, 0.12, 0.05, 0.3, 0.08 }
	task.spawn(function()
		local on = false
		for _, wait in pattern do
			for _, light in lights do
				light.Enabled = on
			end
			on = not on
			task.wait(wait)
		end
		for _, light in lights do
			-- restore only if the light is still supposed to have power
			local fixture = light.Parent
			light.Enabled = fixture == nil or fixture:GetAttribute("Powered") ~= false
		end
	end)
end

-- Security monitor: a little scene of the team in a hallway, time-stamped 20 s ahead.
local function cctv(data: { [string]: any })
	local screen = CollectionService:GetTagged("FZ_CctvScreen")[1]
	if not screen or not screen:IsA("BasePart") then
		return
	end
	local old = screen:FindFirstChild("FZ_Feed")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "FZ_Feed"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 120
	gui.AutoLocalize = false
	gui.LightInfluence = 0
	gui.Parent = screen
	local viewport = Instance.new("ViewportFrame")
	viewport.Size = UDim2.fromScale(1, 1)
	viewport.BackgroundColor3 = Color3.fromRGB(6, 12, 8)
	viewport.Ambient = Color3.fromRGB(110, 140, 120)
	viewport.LightColor = Color3.fromRGB(170, 220, 180)
	viewport.Parent = gui
	local world = Instance.new("WorldModel")
	world.Parent = viewport
	-- corridor
	local function slab(size: Vector3, cf: CFrame, color: Color3)
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = Enum.Material.Concrete
		p.Parent = world
	end
	slab(Vector3.new(14, 1, 60), CFrame.new(0, -0.5, -20), Color3.fromRGB(60, 62, 58))
	slab(Vector3.new(1, 14, 60), CFrame.new(-7, 7, -20), Color3.fromRGB(80, 82, 78))
	slab(Vector3.new(1, 14, 60), CFrame.new(7, 7, -20), Color3.fromRGB(80, 82, 78))
	-- the team (copies of the real characters, walking away from the camera)
	local index = 0
	for _, member in Players:GetPlayers() do
		local character = member.Character
		if character and member:GetAttribute("FZ_InGame") then
			local archivable = character.Archivable
			character.Archivable = true
			local copy = character:Clone()
			character.Archivable = archivable
			if copy then
				for _, d in copy:GetDescendants() do
					if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") or d:IsA("Light") then
						d:Destroy()
					elseif d:IsA("BasePart") then
						d.Anchored = true
					end
				end
				copy:PivotTo(CFrame.new((index % 2) * 3 - 1.5, 3, -18 - index * 4) * CFrame.Angles(0, math.rad(180), 0))
				copy.Parent = world
				index += 1
			end
		end
	end
	if data.withFigure then
		local figure = buildFigure()
		figure:PivotTo(CFrame.new(0, 0, -18 - index * 4 - 6))
		figure.Parent = world
	end
	local camera = Instance.new("Camera")
	camera.FieldOfView = 60
	camera.CFrame = CFrame.lookAt(Vector3.new(4.5, 11, 8), Vector3.new(0, 3, -22))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	local stamp = Instance.new("TextLabel")
	stamp.BackgroundTransparency = 1
	stamp.Size = UDim2.new(1, -8, 0, 16)
	stamp.Position = UDim2.fromOffset(4, 2)
	stamp.Font = Enum.Font.RobotoMono
	stamp.TextScaled = true
	stamp.TextXAlignment = Enum.TextXAlignment.Left
	stamp.TextColor3 = Color3.fromRGB(230, 236, 230)
	stamp.AutoLocalize = false
	stamp.Text = Localization.T("CCTV_STAMP", { seconds = data.offset or 20 })
	stamp.Parent = viewport
	-- static fade-out after a few seconds
	task.delay(if intensity() == "reduced" then 6 else 9, function()
		if gui.Parent then
			TweenService:Create(viewport, TweenInfo.new(0.6), { ImageTransparency = 1, BackgroundTransparency = 1 }):Play()
			task.wait(0.7)
			gui:Destroy()
		end
	end)
end

local function namecall(data: { [string]: any })
	if showSubtitle then
		showSubtitle({
			speaker = "SPEAKER_UNKNOWN",
			text = if data.answered then "RADIO_NAMECALL_ANSWERED" else "RADIO_NAMECALL",
			params = { name = tostring(data.name or player.DisplayName) },
			channel = "radio",
			duration = 3.5,
		})
	end
	AudioController.Play("radio_squelch_on", nil, 0.5)
end

-- Live creature location on the second monitor while the cameras have power.
local function bindCctvText()
	local function refresh()
		for _, screen in CollectionService:GetTagged("FZ_CctvText") do
			if screen:IsA("BasePart") then
				local gui = screen:FindFirstChild("FZ_CctvGui") :: SurfaceGui?
				if not gui then
					local g = Instance.new("SurfaceGui")
					g.Name = "FZ_CctvGui"
					g.Face = Enum.NormalId.Front
					g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
					g.PixelsPerStud = 120
					g.AutoLocalize = false
					g.LightInfluence = 0
					local label = Instance.new("TextLabel")
					label.Name = "Text"
					label.BackgroundTransparency = 1
					label.Size = UDim2.fromScale(1, 1)
					label.Font = Enum.Font.RobotoMono
					label.TextScaled = true
					label.TextColor3 = Color3.fromRGB(10, 40, 20)
					label.AutoLocalize = false
					label.Parent = g
					g.Parent = screen
					gui = g
				end
				local label = (gui :: SurfaceGui):FindFirstChild("Text") :: TextLabel
				local area = SessionState.Get("CctvArea")
				if SessionState.Get("Cameras") and area == "-" then
					label.Text = Localization.T("CCTV_NONE")
				elseif SessionState.Get("Cameras") and type(area) == "string" then
					local areaKey = if area == "?" then "AREA_UNKNOWN" else "AREA_" .. area
					label.Text = Localization.T("CCTV_AREA", { area = Localization.T(areaKey) })
				else
					label.Text = Localization.T("CCTV_OFFLINE")
				end
			end
		end
	end
	SessionState.Observe("Cameras", refresh)
	SessionState.Observe("CctvArea", refresh)
	Localization.Changed:Connect(refresh)
	CollectionService:GetInstanceAddedSignal("FZ_CctvText"):Connect(refresh)
end

---------------------------------------------------------------------------
-- 0.5 events (pool shared by all modes)
---------------------------------------------------------------------------
local function cameraPosition(): Vector3?
	local camera = workspace.CurrentCamera
	return camera and camera.CFrame.Position
end

local function nearestTagged(tagName: string, maxDistance: number): BasePart?
	local origin = cameraPosition()
	if not origin then
		return nil
	end
	local best, bestDistance = nil, maxDistance
	for _, instance in CollectionService:GetTagged(tagName) do
		if instance:IsA("BasePart") then
			local d = (instance.Position - origin).Magnitude
			if d < bestDistance then
				best, bestDistance = instance, d
			end
		end
	end
	return best
end

-- A figure stands behind the glass for a moment. Taps once. Gone when you look again.
local function window()
	local glass = nearestTagged("FZ_Window", 40)
	local origin = cameraPosition()
	if not glass or not origin then
		return
	end
	local toGlass = glass.Position - origin
	local away = Vector3.new(toGlass.X, 0, toGlass.Z)
	if away.Magnitude < 1 then
		return
	end
	away = away.Unit
	local base = Vector3.new(glass.Position.X, glass.Position.Y - glass.Size.Y / 2 - 3.5, glass.Position.Z) + away * 2.5
	local figure = buildFigure()
	figure:PivotTo(CFrame.lookAt(base, base - away))
	figure.Parent = workspace.CurrentCamera
	AudioController.Play("glass_tap", glass.Position, 0.45, "Creature")
	local started = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function()
		local camera = workspace.CurrentCamera
		local looking = camera and camera.CFrame.LookVector:Dot((base - camera.CFrame.Position).Unit) > 0.92
		if os.clock() - started > (if intensity() == "reduced" then 1.2 else 2.6) or (looking and os.clock() - started > 0.7) then
			connection:Disconnect()
			figure:Destroy()
		end
	end)
end

-- Someone stands in the room ahead (a room that was empty a second ago).
local function occupant()
	apparition()
end

local SPEAKER_LINES = { "SPK_LINE_1", "SPK_LINE_2", "SPK_LINE_3", "SPK_LINE_4" }
local function speaker()
	local box = nearestTagged("FZ_Speaker", 45)
	if not box then
		return
	end
	AudioController.Play("radio_squelch_on", box, 0.4, "SFX")
	AudioController.PlayVariant("speaker_voice", box, 0.6, "SFX")
	if showSubtitle then
		showSubtitle({ speaker = "SPEAKER_PA", text = SPEAKER_LINES[math.random(1, #SPEAKER_LINES)], channel = "radio", duration = 3.5 })
	end
end

-- The light in the neighbouring room switches on - nobody is there.
local function neighborLight()
	local origin = cameraPosition()
	if not origin then
		return
	end
	local candidates = {}
	for _, fixture in CollectionService:GetTagged("FZ_SectorLight") do
		if fixture:IsA("BasePart") then
			local d = (fixture.Position - origin).Magnitude
			if d > 18 and d < 48 then
				table.insert(candidates, fixture)
			end
		end
	end
	if #candidates == 0 then
		return
	end
	local fixture = candidates[math.random(1, #candidates)]
	local lights = {}
	for _, child in fixture:GetChildren() do
		if child:IsA("Light") then
			table.insert(lights, { light = child, enabled = child.Enabled, brightness = child.Brightness })
			child.Enabled = true
			child.Brightness *= 1.6
		end
	end
	AudioController.Play("light_click", fixture.Position, 0.5, "SFX", true)
	task.delay(if intensity() == "reduced" then 3 else 6, function()
		AudioController.Play("light_click", fixture.Position, 0.4, "SFX", true)
		for _, entry in lights do
			entry.light.Brightness = entry.brightness
			entry.light.Enabled = fixture:GetAttribute("Powered") ~= false and entry.enabled
		end
	end)
end

-- A shadow slides along the wall - against the direction the light would throw it.
local function shadow()
	local camera = workspace.CurrentCamera
	local character = player.Character
	if not camera or not character then
		return
	end
	rayParams.FilterDescendantsInstances = { character, camera }
	local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
	if look.Magnitude < 0.1 then
		return
	end
	local hit = workspace:Raycast(camera.CFrame.Position, look.Unit * 30, rayParams)
	if not hit or hit.Distance < 6 then
		return
	end
	local normal = hit.Normal
	local side = normal:Cross(Vector3.yAxis).Unit
	local base = hit.Position + normal * 0.08
	local plate = Instance.new("Part")
	plate.Anchored = true
	plate.CanCollide = false
	plate.CanQuery = false
	plate.CanTouch = false
	plate.CastShadow = false
	plate.Material = Enum.Material.SmoothPlastic
	plate.Color = Color3.new(0, 0, 0)
	plate.Transparency = if intensity() == "reduced" then 0.65 else 0.45
	plate.Size = Vector3.new(1.6, 7.5, 0.05)
	plate.CFrame = CFrame.lookAt(base - side * 4, base - side * 4 + normal)
	plate.Parent = camera
	local tween = TweenService:Create(plate, TweenInfo.new(1.3, Enum.EasingStyle.Sine), { CFrame = CFrame.lookAt(base + side * 4, base + side * 4 + normal), Transparency = 1 })
	tween.Completed:Once(function()
		plate:Destroy()
	end)
	tween:Play()
end

-- Find a wall next to the player and return a point just behind it.
local function behindWall(): Vector3?
	local camera = workspace.CurrentCamera
	local character = player.Character
	if not camera or not character then
		return nil
	end
	rayParams.FilterDescendantsInstances = { character, camera }
	local origin = camera.CFrame.Position
	local directions = { -camera.CFrame.RightVector, camera.CFrame.RightVector, -camera.CFrame.LookVector }
	for i = #directions, 2, -1 do
		local j = math.random(1, i)
		directions[i], directions[j] = directions[j], directions[i]
	end
	for _, direction in directions do
		local flat = Vector3.new(direction.X, 0, direction.Z)
		if flat.Magnitude > 0.1 then
			local hit = workspace:Raycast(origin, flat.Unit * 14, rayParams)
			if hit then
				return hit.Position + flat.Unit * 5
			end
		end
	end
	return nil
end

-- Acoustic deception: the creature seems to move behind the wall. It is not there.
local function phantom()
	local position = behindWall()
	if not position then
		return
	end
	local roll = math.random()
	if roll < 0.35 then
		AudioController.PlayVariant("creature_breath_deep", position, 0.4, "Creature", true)
	elseif roll < 0.6 then
		AudioController.PlayVariant("creature_growl", position, 0.35, "Creature", true)
	elseif roll < 0.8 then
		for i = 0, 2 do
			task.delay(i * 0.7, function()
				AudioController.PlayVariant("creature_drag", position + Vector3.new(i * 2, 0, 0), 0.4, "Creature", true)
			end)
		end
	else
		AudioController.PlayVariant("creature_crack", position, 0.45, "Creature", true)
	end
end

-- Something comes closer down the corridor... and stops.
local function approach()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local behind = -Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z).Unit
	local start = camera.CFrame.Position + behind * 45
	local sound = AudioController.Play("approach_corridor", start, 0.6, "Creature", true)
	if sound and sound.Parent and sound.Parent:IsA("Attachment") then
		local attachment = sound.Parent :: Attachment
		TweenService:Create(attachment, TweenInfo.new(6, Enum.EasingStyle.Linear), { WorldPosition = camera.CFrame.Position + behind * 8 }):Play()
	end
end

local function voices()
	local position = behindWall()
	if position then
		AudioController.PlayVariant("voices_muffled", position, 0.5, "SFX", true)
	end
end

-- Very rare: an object that only you can see - a radio in YOUR colours, hissing.
local function object()
	local camera = workspace.CurrentCamera
	local character = player.Character
	if not camera or not character then
		return
	end
	rayParams.FilterDescendantsInstances = { character, camera }
	local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
	if look.Magnitude < 0.1 then
		return
	end
	local spot = camera.CFrame.Position + look.Unit * 11
	local floor = workspace:Raycast(spot, Vector3.new(0, -20, 0), rayParams)
	if not floor then
		return
	end
	local radio = Instance.new("Part")
	radio.Anchored = true
	radio.CanCollide = false
	radio.CanQuery = false
	radio.Size = Vector3.new(0.75, 1.7, 0.42)
	local color = player:GetAttribute("FZ_RadioColor")
	radio.Color = if typeof(color) == "Color3" then color else Color3.fromRGB(46, 48, 50)
	radio.CFrame = CFrame.new(floor.Position + Vector3.new(0, 0.85, 0)) * CFrame.Angles(0, math.random() * 6, 0.2)
	radio.Parent = camera
	local led = Instance.new("PointLight")
	led.Color = Color3.fromRGB(255, 40, 30)
	led.Range = 4
	led.Brightness = 1
	led.Parent = radio
	AudioController.Play("radio_static_loop", radio, 0.25, "SFX")
	local started = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function()
		local cam = workspace.CurrentCamera
		local close = cam and (cam.CFrame.Position - radio.Position).Magnitude < 6
		local lookingAway = cam and cam.CFrame.LookVector:Dot((radio.Position - cam.CFrame.Position).Unit) < 0.2
		if close or (lookingAway and os.clock() - started > 2) or os.clock() - started > 20 then
			connection:Disconnect()
			radio:Destroy()
		end
	end)
end

function DirectorController.Init(settingsController, captionCallback: (line: { [string]: any }) -> ())
	settings = settingsController
	showSubtitle = captionCallback
	Net.Event("Scare").OnClientEvent:Connect(function(kind: any, data: any)
		if type(kind) ~= "string" then
			return
		end
		data = if type(data) == "table" then data else {}
		if kind == "apparition" then
			apparition()
		elseif kind == "footsteps" then
			footsteps()
		elseif kind == "flicker" then
			flicker()
		elseif kind == "cctv" then
			cctv(data)
		elseif kind == "namecall" then
			namecall(data)
		elseif kind == "window" then
			window()
		elseif kind == "occupant" then
			occupant()
		elseif kind == "speaker" then
			speaker()
		elseif kind == "neighborlight" then
			neighborLight()
		elseif kind == "shadow" then
			shadow()
		elseif kind == "phantom" then
			phantom()
		elseif kind == "approach" then
			approach()
		elseif kind == "voices" then
			voices()
		elseif kind == "object" then
			object()
		end
	end)
	bindCctvText()
end

return DirectorController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="90">
            <Properties>
              <string name="Name">EquipmentController</string>
              <string name="Source"><![CDATA[-- EquipmentController: client side of shop equipment.
--   Observer set: night vision (N / D-pad up / touch "Night") with a 30 s battery that
--   recharges, and fresh creature tracks (sent by the server only to observers).

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local InputController = require(script.Parent.InputController)

local EquipmentController = {}

local player = Players.LocalPlayer
local BATTERY_SECONDS = 30
local battery = BATTERY_SECONDS
local active = false
local effect: ColorCorrectionEffect? = nil
local loop: RBXScriptConnection? = nil

local function setNightVision(on: boolean)
	if on and (not player:GetAttribute("FZ_NightVision") or battery < 2) then
		return
	end
	active = on
	InputController.SetTouchActive("NightVision", on)
	if not effect then
		local e = Instance.new("ColorCorrectionEffect")
		e.Name = "FZ_NightVision"
		e.Enabled = false
		e.Parent = Lighting
		effect = e
	end
	local e = effect :: ColorCorrectionEffect
	e.Enabled = true
	TweenService:Create(e, TweenInfo.new(0.25), {
		Brightness = if on then 0.32 else 0,
		Contrast = if on then 0.25 else 0,
		Saturation = if on then -0.9 else 0,
		TintColor = if on then Color3.fromRGB(150, 255, 170) else Color3.new(1, 1, 1),
	}):Play()
	if not loop then
		loop = RunService.Heartbeat:Connect(function(dt)
			if active then
				battery -= dt
				if battery <= 0 then
					battery = 0
					setNightVision(false)
				end
			else
				battery = math.min(BATTERY_SECONDS, battery + dt * 0.5)
				if battery >= BATTERY_SECONDS and loop then
					loop:Disconnect()
					loop = nil
				end
			end
		end)
	end
end

local function footprint(position: Vector3)
	if typeof(position) ~= "Vector3" then
		return
	end
	local mark = Instance.new("Part")
	mark.Name = "FZ_Track"
	mark.Anchored = true
	mark.CanCollide = false
	mark.CanQuery = false
	mark.CanTouch = false
	mark.CastShadow = false
	mark.Size = Vector3.new(1.2, 0.05, 2.2)
	mark.CFrame = CFrame.new(position) * CFrame.Angles(0, math.random() * math.pi, 0)
	mark.Material = Enum.Material.Neon
	mark.Color = Color3.fromRGB(150, 30, 26)
	mark.Transparency = 0.35
	mark.Parent = workspace.CurrentCamera
	local fade = TweenService:Create(mark, TweenInfo.new(18, Enum.EasingStyle.Linear), { Transparency = 1 })
	fade.Completed:Once(function()
		mark:Destroy()
	end)
	fade:Play()
end

function EquipmentController.SetActive(gameplay: boolean)
	if not gameplay and active then
		setNightVision(false)
	end
end

function EquipmentController.Init()
	local function refresh()
		local owned = player:GetAttribute("FZ_NightVision") == true
		InputController.SetTouchVisible("NightVision", owned)
		if not owned and active then
			setNightVision(false)
		end
	end
	player:GetAttributeChangedSignal("FZ_NightVision"):Connect(refresh)
	refresh()
	InputController.Action:Connect(function(name, pressed)
		if name == "NightVision" and pressed then
			setNightVision(not active)
		end
	end)
	Net.Event("Footprint").OnClientEvent:Connect(footprint)
end

return EquipmentController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="91">
            <Properties>
              <string name="Name">FlashlightController</string>
              <string name="Source"><![CDATA[-- FlashlightController: precise camera-aligned light for the local player, plus the
-- replicated head light (FlashlightService) so teammates see it too. The local player's
-- own replicated copy is muted locally to avoid a double light.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local InputController = require(script.Parent.InputController)

local FlashlightController = {}

local player = Players.LocalPlayer
local enabled = false
local lightPart: Part? = nil
local follow: RBXScriptConnection? = nil
local setRemote = Net.Event("SetFlashlight")

local OFFSET = CFrame.new(0.6, -0.5, -0.4)
local BLIND_RANGE = 26 -- matches Config.Creature.BlindRange; the server re-validates
local nextBlindCheck = 0
local blindRay = RaycastParams.new()
blindRay.FilterType = Enum.RaycastFilterType.Exclude

-- While the light is on, report when the beam hits a creature's head (4 Hz).
local function checkBlind(camera: Camera)
	local now = os.clock()
	if now < nextBlindCheck then
		return
	end
	nextBlindCheck = now + 0.25
	local range = BLIND_RANGE * (tonumber(player:GetAttribute("FZ_FlashRange")) or 1)
	for _, model in CollectionService:GetTagged("FZ_CreatureRig") do
		local head = model:FindFirstChild("Head")
		if head and head:IsA("BasePart") and model ~= player.Character and not model:GetAttribute("Hidden") then
			local offset = head.Position - camera.CFrame.Position
			if offset.Magnitude < range and camera.CFrame.LookVector:Dot(offset.Unit) > math.cos(math.rad(14)) then
				blindRay.FilterDescendantsInstances = { player.Character :: Instance, camera }
				local hit = workspace:Raycast(camera.CFrame.Position, offset, blindRay)
				if hit and hit.Instance:IsDescendantOf(model) then
					Net.Event("FlashCreature"):FireServer()
				end
			end
		end
	end
end

local function ensurePart(): Part
	if lightPart and lightPart.Parent then
		return lightPart
	end
	local part = Instance.new("Part")
	part.Name = "FZ_LocalFlashlight"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	local light = Instance.new("SpotLight")
	light.Name = "Light"
	light.Face = Enum.NormalId.Front
	light.Angle = 50
	light.Range = 40
	light.Brightness = 2.4
	light.Color = Color3.fromRGB(255, 236, 206)
	light.Shadows = true
	light.Parent = part
	part.Parent = workspace.CurrentCamera
	lightPart = part
	return part
end

local function muteOwnReplicatedLight(character: Model)
	local head = character:WaitForChild("Head", 10)
	if not head then
		return
	end
	local function mute(child: Instance)
		if child.Name == "FZ_Flashlight" and child:IsA("SpotLight") then
			child.Brightness = 0 -- local only; the server never changes Brightness
		end
	end
	for _, child in head:GetChildren() do
		mute(child)
	end
	head.ChildAdded:Connect(mute)
end

function FlashlightController.Set(value: boolean)
	enabled = value
	local part = ensurePart()
	local light = part:FindFirstChild("Light") :: SpotLight
	light.Enabled = value
	light.Range = 40 * (tonumber(player:GetAttribute("FZ_FlashRange")) or 1)
	local color = player:GetAttribute("FZ_FlashColor")
	if typeof(color) == "Color3" then
		light.Color = color
	end
	if value and not follow then
		follow = RunService.RenderStepped:Connect(function()
			local camera = workspace.CurrentCamera
			if camera then
				part.CFrame = camera.CFrame * OFFSET
				checkBlind(camera)
			end
		end)
	elseif not value and follow then
		follow:Disconnect()
		follow = nil
	end
	InputController.SetTouchActive("Flashlight", value)
	setRemote:FireServer(value)
end

function FlashlightController.IsOn(): boolean
	return enabled
end

function FlashlightController.Init()
	InputController.Action:Connect(function(name, pressed)
		if name == "Flashlight" and pressed then
			if player:GetAttribute("FZ_MonsterMode") then
				Net.Event("MonsterAttack"):FireServer() -- admin test: F / RB attacks as the creature
				return
			end
			FlashlightController.Set(not enabled)
		end
	end)
	player.CharacterAdded:Connect(function(character)
		muteOwnReplicatedLight(character)
		if enabled then
			setRemote:FireServer(true) -- new character, re-sync state
		end
	end)
	if player.Character then
		task.spawn(muteOwnReplicatedLight, player.Character)
	end
end

return FlashlightController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="92">
            <Properties>
              <string name="Name">GraphicsController</string>
              <string name="Source"><![CDATA[-- GraphicsController: quality profiles for the parts an experience may control itself.
-- Roblox's own graphics quality slider is respected and never overridden.
--
-- Invariants on EVERY profile (fairness + atmosphere):
--   * Atmosphere/fog is identical, so creatures are never easier/harder to see.
--   * Lights tagged "FZ_KeyLight" (gameplay-relevant lighting) are always on.
--   * Only decoration scales: post effects, lights tagged "FZ_DecorLight",
--     and the particle multiplier other systems read via GetParticleScale().

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")

local GraphicsController = {}

local PROFILES = {
	low = { bloom = false, decorLights = false, particles = 0.35, grade = 0.8, depth = false },
	medium = { bloom = true, decorLights = true, particles = 0.65, grade = 1, depth = false },
	high = { bloom = true, decorLights = true, particles = 1, grade = 1, depth = true },
	ultra = { bloom = true, decorLights = true, particles = 1.4, grade = 1, depth = true },
}

local current = "high"
local resolvedProfile = PROFILES.high
local brightness = 5
local grade: ColorCorrectionEffect? = nil
local bloom: BloomEffect? = nil
local depth: DepthOfFieldEffect? = nil
local decorConnection: RBXScriptConnection? = nil

local function ensureEffects()
	-- Created on the client: these effects exist only for this player.
	if not grade then
		local effect = Instance.new("ColorCorrectionEffect")
		effect.Name = "FZ_Grade"
		effect.Parent = Lighting
		grade = effect
	end
	if not bloom then
		local effect = Instance.new("BloomEffect")
		effect.Name = "FZ_Bloom"
		effect.Intensity = 0.7
		effect.Size = 28
		effect.Threshold = 1.15 -- neon screens, lamps and the core glow softly; walls do not
		effect.Parent = Lighting
		bloom = effect
	end
	if not depth then
		-- very gentle: the far distance softens, everything you can interact with stays sharp
		local effect = Instance.new("DepthOfFieldEffect")
		effect.Name = "FZ_Depth"
		effect.FarIntensity = 0.12
		effect.FocusDistance = 40
		effect.InFocusRadius = 60
		effect.NearIntensity = 0
		effect.Parent = Lighting
		depth = effect
	end
end

local ORDER = { "low", "medium", "high" }
local autoLevel: string? = nil

local function resolve(name: string): string
	if name ~= "auto" then
		return name
	end
	if autoLevel then
		return autoLevel
	end
	-- Conservative start: phones/tablets at medium, everything else at high. The measured
	-- frame rate then adjusts it (see startAutoTuning).
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "medium"
	end
	return "high"
end

local watched: { [Instance]: boolean } = {}

local function applyDecor(fixture: Instance)
	-- A fixture without power stays off no matter which profile is selected.
	local on = resolvedProfile.decorLights and fixture:GetAttribute("Powered") ~= false
	for _, descendant in fixture:GetDescendants() do
		if descendant:IsA("Light") then
			descendant.Enabled = on
		end
	end
	if not watched[fixture] then
		watched[fixture] = true
		fixture:GetAttributeChangedSignal("Powered"):Connect(function()
			applyDecor(fixture)
		end)
		fixture.Destroying:Connect(function()
			watched[fixture] = nil
		end)
	end
end

local function apply()
	ensureEffects()
	resolvedProfile = PROFILES[resolve(current)] or PROFILES.high
	local g = grade :: ColorCorrectionEffect
	-- Base grade: slightly desaturated, cool shadows. Brightness setting 0..10 (5 = neutral).
	g.Saturation = -0.1 * resolvedProfile.grade
	g.Contrast = 0.14 * resolvedProfile.grade
	g.TintColor = Color3.fromRGB(228, 238, 248)
	g.Brightness = 0.02 + (brightness - 5) * 0.03
	;(depth :: DepthOfFieldEffect).Enabled = resolvedProfile.depth
	;(bloom :: BloomEffect).Enabled = resolvedProfile.bloom
	for _, light in CollectionService:GetTagged("FZ_DecorLight") do
		applyDecor(light)
	end
	if not decorConnection then
		decorConnection = CollectionService:GetInstanceAddedSignal("FZ_DecorLight"):Connect(applyDecor)
	end
end

-- "Automatic": measured FPS steps the profile down (< 28 fps for 10 s) or up
-- (> 55 fps for 30 s), never above "high". Roblox's own quality slider stays untouched.
local function startAutoTuning(settings)
	local RunService = game:GetService("RunService")
	local frames, elapsed, goodFor = 0, 0, 0
	RunService.Heartbeat:Connect(function(dt)
		if settings.Get("graphics") ~= "auto" then
			return
		end
		frames += 1
		elapsed += dt
		if elapsed < 10 then
			return
		end
		local fps = frames / elapsed
		frames, elapsed = 0, 0
		local level = table.find(ORDER, resolve("auto")) or 2
		if fps < 28 and level > 1 then
			autoLevel = ORDER[level - 1]
			goodFor = 0
			apply()
		elseif fps > 55 then
			goodFor += 10
			if goodFor >= 30 and level < #ORDER then
				autoLevel = ORDER[level + 1]
				goodFor = 0
				apply()
			end
		else
			goodFor = 0
		end
	end)
end

function GraphicsController.Init(settings)
	startAutoTuning(settings)
	current = settings.Get("graphics") or "auto"
	brightness = settings.Get("brightness") or 5
	apply()
	settings.Changed:Connect(function(key, value)
		if key == "graphics" then
			current = value
			apply()
		elseif key == "brightness" then
			brightness = value
			apply()
		end
	end)
end

function GraphicsController.GetParticleScale(): number
	return resolvedProfile.particles
end

function GraphicsController.GetProfileName(): string
	return resolve(current)
end

function GraphicsController.GetRobloxQualityLevel(): number
	local ok, level = pcall(function()
		return UserSettings().GameSettings.SavedQualityLevel.Value
	end)
	return if ok then level else -1
end

return GraphicsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="93">
            <Properties>
              <string name="Name">HealthController</string>
              <string name="Source"><![CDATA[-- HealthController: health HUD (only visible when hurt), damage vignette, downed overlay.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local Components = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)

local HealthController = {}

local player = Players.LocalPlayer

function HealthController.Init(hudGui: ScreenGui, settings)
	-- Damage flash: a red screen edge (UIStroke), no texture asset required.
	local edge = Instance.new("Frame")
	edge.Name = "DamageEdge"
	edge.BackgroundTransparency = 1
	edge.Size = UDim2.fromScale(1, 1)
	edge.Parent = hudGui
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Colors.Accent
	stroke.Thickness = 28
	stroke.Transparency = 1
	stroke.Parent = edge
	local gradient = Instance.new("UIGradient")
	gradient.Transparency = NumberSequence.new(0.2)
	gradient.Parent = stroke

	local bar = Instance.new("Frame")
	bar.Name = "Health"
	bar.AnchorPoint = Vector2.new(0, 1)
	bar.Position = UDim2.new(0, 24, 1, -16)
	bar.Size = UDim2.fromOffset(180, 4)
	bar.BackgroundColor3 = Theme.Colors.TextFaint
	bar.BackgroundTransparency = 0.4
	bar.BorderSizePixel = 0
	bar.Visible = false
	bar.Parent = hudGui
	local fill = Instance.new("Frame")
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = Theme.Colors.TextBright
	fill.Size = UDim2.fromScale(1, 1)
	Components.Corner(fill, 2)
	Components.Corner(bar, 2)
	fill.Parent = bar

	local downed = Components.Text({ Key = "HUD_DOWNED", Font = Theme.Fonts.Medium, TextSize = Theme.Sizes.TextHeading, Color = Theme.Colors.TextBright, XAlign = Enum.TextXAlignment.Center, Size = UDim2.new(0.8, 0, 0, 40), Position = UDim2.fromScale(0.5, 0.42), AnchorPoint = Vector2.new(0.5, 0.5), Parent = hudGui })
	downed.TextStrokeTransparency = 0.4
	downed.Visible = false

	local function cameraScale(): number
		local value = settings.Get("cameraEffects")
		return if value == "off" then 0 elseif value == "reduced" then 0.5 else 1
	end

	local function bindHumanoid(character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid or not humanoid:IsA("Humanoid") then
			return
		end
		local function update()
			local ratio = math.clamp(humanoid.Health / math.max(1, humanoid.MaxHealth), 0, 1)
			bar.Visible = (ratio < 0.999 or settings.Get("alwaysShowHealth") == true) and player:GetAttribute("FZ_InGame") == true and not player:GetAttribute("FZ_MonsterMode")
			fill.Size = UDim2.fromScale(ratio, 1)
			fill.BackgroundColor3 = if ratio < 0.35 then Theme.Colors.Accent else Theme.Colors.TextBright
		end
		humanoid.HealthChanged:Connect(update)
		settings.Changed:Connect(function(key)
			if key == "alwaysShowHealth" then
				update()
			end
		end)
		player:GetAttributeChangedSignal("FZ_InGame"):Connect(update)
		update()
	end
	player.CharacterAdded:Connect(bindHumanoid)
	if player.Character then
		task.spawn(bindHumanoid, player.Character)
	end

	Net.Event("Hurt").OnClientEvent:Connect(function()
		stroke.Transparency = 0.15
		TweenService:Create(stroke, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 1 }):Play()
		local camera = workspace.CurrentCamera
		local scale = cameraScale()
		if camera and scale > 0 then
			-- short, small kick (no strong shake)
			local original = camera.FieldOfView
			camera.FieldOfView = original - 3 * scale
			TweenService:Create(camera, TweenInfo.new(0.35), { FieldOfView = original }):Play()
		end
	end)

	-- (the downed countdown is shown by RescueController)
	downed:Destroy()
end

return HealthController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="94">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[-- InputController: one logical action layer for keyboard/mouse, gamepad and touch.
--
-- Primary path: Roblox Input Action System (InputContext / InputAction / InputBinding).
-- Fallback path: UserInputService, used automatically if the Input Action System cannot be
-- created on this client (or when Config FORCE_LEGACY is set for debugging).
--
-- Gameplay code only ever sees logical actions:
--   InputController.Action:Connect(function(name, pressed, device) ... end)
-- Interactions themselves use ProximityPrompts (E / X / tap) via InteractionService.
--
-- Default bindings
--   Sprint      LeftShift | L3 (left stick click) | touch "Run" (toggle)
--   Flashlight  F         | R1 / RB               | touch "Light"
--   Radio       R         | L1 / LB               | touch "Radio"   (push to talk)
--   Mic         M         | D-pad left            | touch "Mic"     (mute / unmute)
--   NightVision N         | D-pad up              | touch "Night"   (observer set only)
--   Pause       P         | View / Share (Select) | touch "II"
-- GuiService.AutoSelectGuiEnabled is turned off so the Select button is free for our
-- menu; the Router sets gamepad focus explicitly whenever a menu opens.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Signal)
local Localization = require(Shared.Localization)

local Theme = require(script.Parent.Parent.UI.Theme)

local FORCE_LEGACY = false

export type Device = "keyboard" | "gamepad" | "touch"

local InputController = {}
InputController.Action = Signal.new() -- (name: string, pressed: boolean, device: Device)
InputController.DeviceChanged = Signal.new() -- (device: Device)

local ACTIONS = {
	{ name = "Sprint", keys = { Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3 }, touchKey = "TOUCH_SPRINT" },
	{ name = "Flashlight", keys = { Enum.KeyCode.F, Enum.KeyCode.ButtonR1 }, touchKey = "TOUCH_LIGHT" },
	{ name = "Radio", keys = { Enum.KeyCode.R, Enum.KeyCode.ButtonL1 }, touchKey = "TOUCH_RADIO" },
	{ name = "NightVision", keys = { Enum.KeyCode.N, Enum.KeyCode.DPadUp }, touchKey = "TOUCH_NIGHT", hidden = true },
	{ name = "Mic", keys = { Enum.KeyCode.M, Enum.KeyCode.DPadLeft }, touchKey = "TOUCH_MIC", small = true, slot = 1 },
	{ name = "Pause", keys = { Enum.KeyCode.P, Enum.KeyCode.ButtonSelect }, touchText = "II", small = true, slot = 0 },
	-- Hotbar (touch uses the slot buttons of the hotbar itself)
	{ name = "Item1", keys = { Enum.KeyCode.One } },
	{ name = "Item2", keys = { Enum.KeyCode.Two } },
	{ name = "Item3", keys = { Enum.KeyCode.Three } },
	{ name = "Item4", keys = { Enum.KeyCode.Four } },
	{ name = "ItemNext", keys = { Enum.KeyCode.DPadRight } },
	{ name = "ItemUse", keys = { Enum.KeyCode.ButtonY } },
}

local device: Device = "keyboard"
local gameplayEnabled = false
local usingActionSystem = false
local held: { [string]: boolean } = {}
local touchButtons: { [string]: TextButton } = {}
local touchContainer: Frame? = nil
local context: Instance? = nil

local function fire(name: string, pressed: boolean)
	if pressed then
		if not gameplayEnabled or UserInputService:GetFocusedTextBox() then
			return
		end
		if held[name] then
			return
		end
		held[name] = true
	else
		if not held[name] then
			return
		end
		held[name] = nil
	end
	InputController.Action:Fire(name, pressed, device)
end

---------------------------------------------------------------------------
-- Device detection
---------------------------------------------------------------------------

local function deviceFromLastInput(inputType: Enum.UserInputType): Device?
	if inputType == Enum.UserInputType.Touch then
		return "touch"
	end
	local name = inputType.Name
	if string.sub(name, 1, 7) == "Gamepad" then
		return "gamepad"
	end
	if inputType == Enum.UserInputType.Keyboard or string.sub(name, 1, 5) == "Mouse" then
		return "keyboard"
	end
	return nil
end

local function setDevice(newDevice: Device?)
	if not newDevice or newDevice == device then
		return
	end
	device = newDevice
	if touchContainer then
		touchContainer.Visible = gameplayEnabled and device == "touch"
	end
	InputController.DeviceChanged:Fire(device)
end

local function readPreferredInput(): Device?
	local ok, preferred = pcall(function()
		return (UserInputService :: any).PreferredInput
	end)
	if not ok or preferred == nil then
		return nil
	end
	if preferred == Enum.PreferredInput.Touch then
		return "touch"
	elseif preferred == Enum.PreferredInput.Gamepad then
		return "gamepad"
	end
	return "keyboard"
end

local function initDeviceDetection()
	local preferred = readPreferredInput()
	if preferred then
		device = preferred
		UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(function()
			setDevice(readPreferredInput())
		end)
	else
		device = deviceFromLastInput(UserInputService:GetLastInputType())
			or (if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then "touch" else "keyboard")
		UserInputService.LastInputTypeChanged:Connect(function(inputType)
			setDevice(deviceFromLastInput(inputType))
		end)
	end
end

---------------------------------------------------------------------------
-- Touch buttons (large, few, right thumb area; Pause sits top-right)
---------------------------------------------------------------------------

local function createTouchButtons(parent: ScreenGui)
	local container = Instance.new("Frame")
	container.Name = "TouchControls"
	container.BackgroundTransparency = 1
	container.Size = UDim2.fromScale(1, 1)
	container.Visible = false
	container.Parent = parent
	touchContainer = container

	local index = 0
	for _, definition in ACTIONS do
		if not definition.touchKey and not definition.touchText then
			continue
		end
		local button = Instance.new("TextButton")
		button.Name = definition.name
		button.AutoButtonColor = false
		button.AutoLocalize = false
		button.BackgroundColor3 = Theme.Colors.Panel
		button.BackgroundTransparency = 0.35
		button.TextColor3 = Theme.Colors.TextBright
		button.Font = Theme.Fonts.Medium
		button.TextSize = 15
		button.Selectable = false
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = button
		local stroke = Instance.new("UIStroke")
		stroke.Color = Theme.Colors.TextFaint
		stroke.Transparency = 0.3
		stroke.Thickness = 1
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = button
		if definition.small then
			button.Size = UDim2.fromOffset(48, 48)
			button.AnchorPoint = Vector2.new(1, 0)
			button.Position = UDim2.new(1, -16 - (definition.slot or 0) * 58, 0, 8)
			button.TextSize = 12
		else
			button.Size = UDim2.fromOffset(72, 72)
			button.AnchorPoint = Vector2.new(1, 1)
			button.Position = UDim2.new(1, -150 - index * 84, 1, -28 - index * 60)
			index += 1
		end
		if definition.touchKey then
			Localization.Bind(button, definition.touchKey)
		else
			button.Text = definition.touchText or ""
		end
		button.Visible = not definition.hidden
		button.Parent = container
		touchButtons[definition.name] = button
	end
end

---------------------------------------------------------------------------
-- Binding paths
---------------------------------------------------------------------------

local function bindWithActionSystem(): boolean
	local ok, err = pcall(function()
		local newContext = Instance.new("InputContext")
		newContext.Name = "FZ_Gameplay"
		for _, definition in ACTIONS do
			local action = Instance.new("InputAction")
			action.Name = definition.name
			action.Type = Enum.InputActionType.Bool
			for _, key in definition.keys do
				local binding = Instance.new("InputBinding")
				binding.KeyCode = key
				binding.Parent = action
			end
			local touchButton = touchButtons[definition.name]
			if touchButton then
				local binding = Instance.new("InputBinding")
				binding.UIButton = touchButton
				binding.Parent = action
			end
			action.Pressed:Connect(function()
				fire(definition.name, true)
			end)
			action.Released:Connect(function()
				fire(definition.name, false)
			end)
			action.Parent = newContext
		end
		newContext.Enabled = gameplayEnabled
		newContext.Parent = Players.LocalPlayer:WaitForChild("PlayerScripts")
		context = newContext
	end)
	if not ok then
		warn("[FZ-Input] Input Action System unavailable, using fallback: " .. tostring(err))
		if context then
			context:Destroy()
			context = nil
		end
	end
	return ok
end

local function bindWithFallback()
	local keyToAction: { [Enum.KeyCode]: string } = {}
	for _, definition in ACTIONS do
		for _, key in definition.keys do
			keyToAction[key] = definition.name
		end
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local name = keyToAction[input.KeyCode]
		if name then
			fire(name, true)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		local name = keyToAction[input.KeyCode]
		if name then
			fire(name, false)
		end
	end)
	for name, button in touchButtons do
		button.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				fire(name, true)
			end
		end)
		button.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				fire(name, false)
			end
		end)
	end
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function InputController.Init(hudGui: ScreenGui)
	GuiService.AutoSelectGuiEnabled = false
	initDeviceDetection()
	createTouchButtons(hudGui)
	usingActionSystem = not FORCE_LEGACY and bindWithActionSystem()
	if not usingActionSystem then
		bindWithFallback()
	end
end

function InputController.GetDevice(): Device
	return device
end

function InputController.IsUsingActionSystem(): boolean
	return usingActionSystem
end

function InputController.SetGameplayEnabled(enabled: boolean)
	gameplayEnabled = enabled
	if context then
		(context :: any).Enabled = enabled
	end
	if touchContainer then
		touchContainer.Visible = enabled and device == "touch"
	end
	if not enabled then
		-- Release everything that is still held so nothing gets stuck "on".
		for name in table.clone(held) do
			held[name] = nil
			InputController.Action:Fire(name, false, device)
		end
	end
end

function InputController.SetTouchVisible(name: string, visible: boolean)
	local button = touchButtons[name]
	if button then
		button.Visible = visible
	end
end

-- Lets gameplay code reflect state on touch buttons (e.g. sprint toggle highlighted).
function InputController.SetTouchActive(name: string, active: boolean)
	local button = touchButtons[name]
	if button then
		button.BackgroundColor3 = if active then Theme.Colors.Accent else Theme.Colors.Panel
	end
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="95">
            <Properties>
              <string name="Name">InventoryController</string>
              <string name="Source"><![CDATA[-- InventoryController: the hotbar. Only visible when you carry something.
--   PC 1-4 = use slot directly · gamepad D-pad right = next slot, Y = use · touch: tap a slot

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local InputController = require(script.Parent.InputController)
local Components = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)

local InventoryController = {}

-- Emoji glyphs render on every platform without uploading image assets.
local ICONS = { bandage = "🩹", medkit = "🧰", syringe = "💉" }

local player = Players.LocalPlayer
local bar: Frame
local selected = 1
local items: { string } = {}

local function use(slot: number)
	if items[slot] then
		Net.Event("UseItem"):FireServer(slot)
	end
end

local function render()
	for _, child in bar:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	local raw = player:GetAttribute("FZ_Items")
	items = if type(raw) == "string" and raw ~= "" then string.split(raw, ",") else {}
	local slots = tonumber(player:GetAttribute("FZ_ItemSlots")) or Config.Inventory.Slots
	bar.Visible = #items > 0 and player:GetAttribute("FZ_InGame") == true
	selected = math.clamp(selected, 1, math.max(1, #items))
	local using = player:GetAttribute("FZ_UsingItem")
	for slot = 1, slots do
		local itemId = items[slot]
		local button = Instance.new("TextButton")
		button.Name = "Slot" .. slot
		button.AutoButtonColor = false
		button.AutoLocalize = false
		button.Text = ""
		button.Size = UDim2.fromOffset(68, 68)
		button.LayoutOrder = slot
		button.Selectable = false
		button.BackgroundColor3 = Theme.Colors.Panel
		button.BackgroundTransparency = if itemId then 0.15 else 0.6
		local stroke = Instance.new("UIStroke")
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = if slot == selected and itemId then Theme.Colors.Relay else Theme.Colors.PanelLine
		stroke.Thickness = if slot == selected and itemId then 2 else 1
		stroke.Parent = button
		Components.Corner(button, 8)
		if slot == selected and itemId then
			local underline = Instance.new("Frame")
			underline.Name = "Selected"
			underline.BackgroundColor3 = Theme.Colors.Relay
			underline.BorderSizePixel = 0
			underline.AnchorPoint = Vector2.new(0.5, 1)
			underline.Position = UDim2.new(0.5, 0, 1, -4)
			underline.Size = UDim2.fromOffset(22, 2)
			underline.Parent = button
		end
		Components.Text({ Text = tostring(slot), Font = Theme.Fonts.Mono, TextSize = 11, Color = Theme.Colors.TextFaint, Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(4, 2), Parent = button })
		if itemId then
			Components.Text({ Text = ICONS[itemId] or "◆", TextSize = 24, XAlign = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 8), Parent = button })
			local name = Components.Text({ Key = Config.Items[itemId].name, Font = Theme.Fonts.Medium, TextSize = 11, Color = if using == itemId then Theme.Colors.Relay else Theme.Colors.TextBright, XAlign = Enum.TextXAlignment.Center, Wrapped = false, Size = UDim2.new(1, -6, 0, 14), Position = UDim2.fromOffset(3, 42), Parent = button })
			name.TextTruncate = Enum.TextTruncate.AtEnd
		end
		button.Activated:Connect(function()
			use(slot)
		end)
		button.Parent = bar
	end
end

function InventoryController.Init(hudGui: ScreenGui)
	bar = Instance.new("Frame")
	bar.Name = "Hotbar"
	bar.BackgroundTransparency = 1
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position = UDim2.new(0.5, 0, 1, -22)
	bar.Size = UDim2.fromOffset(4 * 76, 68)
	bar.Visible = false
	bar.Parent = hudGui
	local layout = Components.List(bar, 6, true)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	for _, attribute in { "FZ_Items", "FZ_ItemSlots", "FZ_UsingItem", "FZ_InGame" } do
		player:GetAttributeChangedSignal(attribute):Connect(render)
	end
	Localization.Changed:Connect(render)
	render()

	InputController.Action:Connect(function(name, pressed)
		if not pressed then
			return
		end
		local direct = string.match(name, "^Item(%d)$")
		if direct then
			use(tonumber(direct) :: number)
		elseif name == "ItemNext" and #items > 0 then
			selected = (selected % #items) + 1
			render()
		elseif name == "ItemUse" then
			use(selected)
		end
	end)
end

return InventoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="96">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[-- MovementController: slow walk, short limited sprint with stamina.
-- Keyboard: hold to sprint. Gamepad (L3) and touch: toggle, ends automatically when the
-- player stops moving or runs out of breath. No permanent sprinting by design.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local InputController = require(script.Parent.InputController)

local MovementController = {}

local M = Config.Movement
local player = Players.LocalPlayer

local stamina = 1
local exhausted = false
local wantsSprint = false
local sprinting = false
local regenTimer = 0
local heartbeat: RBXScriptConnection? = nil
local settings = nil
local onStamina: ((number, boolean) -> ())? = nil

local function cameraEffectsScale(): number
	local value = settings and settings.Get("cameraEffects") or "full"
	return if value == "off" then 0 elseif value == "reduced" then 0.5 else 1
end

local function setSprinting(value: boolean)
	if sprinting == value then
		return
	end
	sprinting = value
	InputController.SetTouchActive("Sprint", value)
	local camera = workspace.CurrentCamera
	if camera then
		local fov = M.BaseFov + (if value then M.SprintFovBoost * cameraEffectsScale() else 0)
		TweenService:Create(camera, TweenInfo.new(0.35, Enum.EasingStyle.Sine), { FieldOfView = fov }):Play()
	end
end

local function step(dt: number)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local moving = humanoid.MoveDirection.Magnitude > 0.1
	if not moving and InputController.GetDevice() ~= "keyboard" then
		wantsSprint = false -- toggle sprint ends when the player stops
	end

	local canSprint = wantsSprint and moving and not exhausted and stamina > 0 and not player:GetAttribute("FZ_Downed")
	setSprinting(canSprint)

	if sprinting then
		stamina = math.max(0, stamina - dt / M.StaminaSeconds)
		regenTimer = M.RegenDelay
		if stamina <= 0 then
			exhausted = true
			wantsSprint = false
		end
	else
		regenTimer = math.max(0, regenTimer - dt)
		if regenTimer <= 0 then
			stamina = math.min(1, stamina + dt / M.RegenSeconds)
		end
		if exhausted and stamina >= M.ExhaustedThreshold then
			exhausted = false
		end
	end

	if player:GetAttribute("FZ_MonsterMode") then
		return -- the creature rig keeps the speed the server gave it
	end
	local speed = if sprinting then M.SprintSpeed else M.WalkSpeed
	if player:GetAttribute("FZ_Downed") then
		speed = Config.Health.CrawlSpeed
		wantsSprint = false
	end
	if player:GetAttribute("FZ_Rescuing") or player:GetAttribute("FZ_Eliminated") then
		speed = 0 -- kneeling next to a teammate: you cannot run away while helping
		wantsSprint = false
	end
	if player:GetAttribute("FZ_AdminSpeed") then
		speed *= 2
	end
	humanoid.WalkSpeed = speed
	if onStamina then
		onStamina(stamina, exhausted)
	end
end

function MovementController.Init(settingsController, staminaCallback: (number, boolean) -> ())
	settings = settingsController
	onStamina = staminaCallback
	InputController.Action:Connect(function(name, pressed, device)
		if name ~= "Sprint" then
			return
		end
		if device == "keyboard" then
			wantsSprint = pressed
		elseif pressed then
			wantsSprint = not wantsSprint
		end
	end)
end

function MovementController.SetActive(active: boolean)
	if active and not heartbeat then
		heartbeat = RunService.Heartbeat:Connect(step)
	elseif not active and heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
		wantsSprint = false
		setSprinting(false)
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = M.WalkSpeed
		end
	end
end

return MovementController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="97">
            <Properties>
              <string name="Name">PromptController</string>
              <string name="Source"><![CDATA[-- PromptController: our own interaction prompt (all prompts use Style = Custom).
-- Same look on every device; key glyph adapts to the input device:
--   keyboard "E" · gamepad "X" · touch: the whole prompt is a big tap / hold target
-- Hold prompts fill the key box; a short flash confirms the trigger.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Parent.UI.Theme)

local PromptController = {}

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

local function keyText(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType): string
	if inputType == Enum.ProximityPromptInputType.Gamepad then
		local name = prompt.GamepadKeyCode.Name
		return (string.gsub(name, "^Button", ""))
	elseif inputType == Enum.ProximityPromptInputType.Touch then
		return "●"
	end
	local ok, text = pcall(UserInputService.GetStringForKeyCode, UserInputService, prompt.KeyboardKeyCode)
	return if ok and text ~= "" then string.upper(text) else prompt.KeyboardKeyCode.Name
end

local function adornee(prompt: ProximityPrompt): Instance?
	local parent = prompt.Parent
	if parent and parent:IsA("Model") then
		return parent.PrimaryPart
	end
	return parent
end

local function build(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType)
	local touch = inputType == Enum.ProximityPromptInputType.Touch
	local gui = Instance.new("BillboardGui")
	gui.Name = "FZ_Prompt"
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Size = UDim2.fromOffset(if touch then 280 else 250, if touch then 72 else 58)
	gui.StudsOffset = Vector3.new(0, 1.6, 0)
	gui.ResetOnSpawn = false
	gui.AutoLocalize = false
	gui.Active = touch
	gui.ClipsDescendants = false
	gui.Adornee = adornee(prompt)

	local frame = Instance.new("TextButton")
	frame.Name = "Frame"
	frame.AutoButtonColor = false
	frame.Text = ""
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Theme.Colors.Panel
	frame.BackgroundTransparency = 1
	frame.Active = touch
	frame.Selectable = false
	frame.Parent = gui

	local key = Instance.new("Frame")
	key.Name = "Key"
	key.AnchorPoint = Vector2.new(0, 0.5)
	key.Position = UDim2.new(0, 4, 0.5, 0)
	key.Size = UDim2.fromOffset(if touch then 56 else 42, if touch then 56 else 42)
	key.BackgroundColor3 = Theme.Colors.Panel
	key.BackgroundTransparency = 0.15
	key.ClipsDescendants = true
	key.Parent = frame
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = key
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Colors.TextBright
	stroke.Transparency = 0.35
	stroke.Thickness = 1.5
	stroke.Parent = key

	local fill = Instance.new("Frame")
	fill.Name = "Hold"
	fill.AnchorPoint = Vector2.new(0, 1)
	fill.Position = UDim2.fromScale(0, 1)
	fill.Size = UDim2.fromScale(1, 0)
	fill.BackgroundColor3 = Theme.Colors.Relay
	fill.BackgroundTransparency = 0.35
	fill.BorderSizePixel = 0
	fill.Parent = key

	local keyLabel = Instance.new("TextLabel")
	keyLabel.BackgroundTransparency = 1
	keyLabel.Size = UDim2.fromScale(1, 1)
	keyLabel.Font = Theme.Fonts.Bold
	keyLabel.TextSize = if touch then 24 else 20
	keyLabel.TextColor3 = Theme.Colors.TextBright
	keyLabel.Text = keyText(prompt, inputType)
	keyLabel.AutoLocalize = false
	keyLabel.ZIndex = 2
	keyLabel.Parent = key

	local action = Instance.new("TextLabel")
	action.BackgroundTransparency = 1
	action.Position = UDim2.new(0, key.Size.X.Offset + 14, 0, if touch then 10 else 6)
	action.Size = UDim2.new(1, -(key.Size.X.Offset + 16), 0, 24)
	action.Font = Theme.Fonts.Bold
	action.TextSize = if touch then 20 else 18
	action.TextXAlignment = Enum.TextXAlignment.Left
	action.TextColor3 = Theme.Colors.TextBright
	action.TextStrokeTransparency = 0.5
	action.TextTruncate = Enum.TextTruncate.AtEnd
	action.AutoLocalize = false
	action.Parent = frame

	local object = action:Clone()
	object.Position = UDim2.new(0, key.Size.X.Offset + 14, 0, if touch then 34 else 30)
	object.Size = UDim2.new(1, -(key.Size.X.Offset + 16), 0, 20)
	object.Font = Theme.Fonts.Mono
	object.TextSize = 14
	object.TextColor3 = Theme.Colors.TextDim
	object.Parent = frame

	local function refreshText()
		action.Text = prompt.ActionText
		object.Text = prompt.ObjectText
	end
	refreshText()

	local connections = {
		prompt:GetPropertyChangedSignal("ActionText"):Connect(refreshText),
		prompt:GetPropertyChangedSignal("ObjectText"):Connect(refreshText),
	}
	local holdTween: Tween? = nil
	table.insert(connections, prompt.PromptButtonHoldBegan:Connect(function()
		if prompt.HoldDuration > 0 then
			fill.Size = UDim2.fromScale(1, 0)
			holdTween = TweenService:Create(fill, TweenInfo.new(prompt.HoldDuration, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(1, 1) })
			;(holdTween :: Tween):Play()
		end
	end))
	table.insert(connections, prompt.PromptButtonHoldEnded:Connect(function()
		if holdTween then
			holdTween:Cancel()
		end
		TweenService:Create(fill, Theme.Fast, { Size = UDim2.fromScale(1, 0) }):Play()
	end))
	table.insert(connections, prompt.Triggered:Connect(function()
		stroke.Color = Theme.Colors.Relay
		stroke.Transparency = 0
		TweenService:Create(stroke, TweenInfo.new(0.4), { Transparency = 0.35, Color = Theme.Colors.TextBright }):Play()
	end))

	if touch then
		-- Large target: tap = trigger, hold = hold prompt
		table.insert(connections, frame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				prompt:InputHoldBegin()
			end
		end))
		table.insert(connections, frame.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				prompt:InputHoldEnd()
			end
		end))
	end

	gui.Parent = playerGui
	return function()
		for _, connection in connections do
			connection:Disconnect()
		end
		gui:Destroy()
	end
end

function PromptController.Init()
	ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
		if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
			return
		end
		local cleanup = build(prompt, inputType)
		prompt.PromptHidden:Wait()
		cleanup()
	end)
end

return PromptController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="98">
            <Properties>
              <string name="Name">RadioController</string>
              <string name="Source"><![CDATA[-- RadioController: the walkie-talkie in your hand.
--   * Push to talk (R / LB / touch "Radio"), hold or toggle (Settings -> Radio button)
--   * Mute / unmute your own microphone (M / D-pad left / touch "Mic")
--   * Viewmodel: raised while transmitting, half-raised while receiving, otherwise away
--   * Small HUD line: "TRANSMITTING", "Receiving: name", "Microphone muted"
-- Transmitting is audible to the creature (server NoiseService) - talk with care.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local InputController = require(script.Parent.InputController)
local VoiceController = require(script.Parent.VoiceController)
local AudioController = require(script.Parent.AudioController)

local Theme = require(script.Parent.Parent.UI.Theme)
local Components = require(script.Parent.Parent.UI.Components)

local RadioController = {}

local player = Players.LocalPlayer
local settings = nil
local transmitting = false
local muted = false
local receiving: { string } = {}

local viewmodel: Model? = nil
local led: BasePart? = nil
local body: BasePart? = nil
local render: RBXScriptConnection? = nil
local pose = 0 -- 0 hidden, 0.5 receiving, 1 transmitting

local statusLabel: TextLabel
local micLabel: TextLabel

local HIDDEN = CFrame.new(0.9, -2.8, -1.4) * CFrame.Angles(math.rad(-30), 0, 0)
local HALF = CFrame.new(0.95, -1.45, -1.7) * CFrame.Angles(math.rad(8), math.rad(-14), math.rad(-6))
local RAISED = CFrame.new(0.55, -0.85, -1.35) * CFrame.Angles(math.rad(14), math.rad(-24), math.rad(-10))

local function part(model: Model, name: string, size: Vector3, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = model
	return p
end

local function buildViewmodel(): Model
	local model = Instance.new("Model")
	model.Name = "FZ_RadioViewmodel"
	local color = player:GetAttribute("FZ_RadioColor")
	local b = part(model, "Body", Vector3.new(0.75, 1.7, 0.42), if typeof(color) == "Color3" then color else Color3.fromRGB(46, 48, 50), Enum.Material.SmoothPlastic)
	model.PrimaryPart = b
	body = b
	local antenna = part(model, "Antenna", Vector3.new(0.14, 1.3, 0.14), Color3.fromRGB(26, 26, 26), Enum.Material.Rubber)
	antenna:SetAttribute("Offset", CFrame.new(-0.22, 1.45, 0))
	local screen = part(model, "Screen", Vector3.new(0.56, 0.42, 0.05), Color3.fromRGB(255, 150, 60), Enum.Material.Neon)
	screen.Transparency = 0.15
	screen:SetAttribute("Offset", CFrame.new(0, 0.42, -0.22))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 200
	gui.AutoLocalize = false
	gui.Parent = screen
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.RobotoMono
	text.TextScaled = true
	text.TextColor3 = Color3.fromRGB(40, 16, 0)
	text.Text = "CH-07\nRELAIS"
	text.AutoLocalize = false
	text.Parent = gui
	local grille = part(model, "Speaker", Vector3.new(0.5, 0.5, 0.05), Color3.fromRGB(20, 20, 20), Enum.Material.DiamondPlate)
	grille:SetAttribute("Offset", CFrame.new(0, -0.35, -0.22))
	local l = part(model, "Led", Vector3.new(0.1, 0.1, 0.06), Color3.fromRGB(60, 20, 20), Enum.Material.Neon)
	l:SetAttribute("Offset", CFrame.new(0.26, 0.74, -0.22))
	led = l
	local knob = part(model, "Knob", Vector3.new(0.18, 0.2, 0.18), Color3.fromRGB(30, 30, 30), Enum.Material.Metal)
	knob:SetAttribute("Offset", CFrame.new(0.2, 0.92, 0))
	return model
end

local function placeViewmodel(cframe: CFrame)
	local model = viewmodel :: Model
	local b = body :: BasePart
	b.CFrame = cframe
	for _, child in model:GetChildren() do
		if child ~= b and child:IsA("BasePart") then
			local offset = child:GetAttribute("Offset")
			if typeof(offset) == "CFrame" then
				child.CFrame = cframe * offset
			end
		end
	end
end

local function targetPose(): number
	if transmitting then
		return 1
	elseif #receiving > 0 then
		return 0.5
	end
	return 0
end

local function ensureRender()
	if render then
		return
	end
	render = RunService.RenderStepped:Connect(function(dt)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local goal = targetPose()
		pose += (goal - pose) * math.min(1, dt * 9)
		if math.abs(goal - pose) < 0.01 then
			pose = goal
		end
		if pose <= 0.001 and goal == 0 then
			if viewmodel then
				viewmodel:Destroy()
				viewmodel = nil
			end
			(render :: RBXScriptConnection):Disconnect()
			render = nil
			return
		end
		if not viewmodel or not viewmodel.Parent then
			viewmodel = buildViewmodel()
			viewmodel.Parent = camera
		end
		local offset = if pose <= 0.5 then HIDDEN:Lerp(HALF, pose * 2) else HALF:Lerp(RAISED, (pose - 0.5) * 2)
		local t = os.clock()
		local sway = CFrame.new(math.sin(t * 1.3) * 0.015, math.sin(t * 2.1) * 0.012, 0)
		placeViewmodel(camera.CFrame * offset * sway)
		if led then
			led.Color = if transmitting then Color3.fromRGB(255, 40, 30) elseif #receiving > 0 then Color3.fromRGB(80, 255, 120) else Color3.fromRGB(60, 20, 20)
		end
	end)
end

local function refreshHud()
	if transmitting then
		statusLabel.TextColor3 = Theme.Colors.Accent
		Localization.Bind(statusLabel, "RADIO_TX")
		statusLabel.Text = "● " .. statusLabel.Text
		statusLabel.Visible = true
	elseif #receiving > 0 then
		statusLabel.TextColor3 = Theme.Colors.Relay
		Localization.Bind(statusLabel, "RADIO_RX", { name = table.concat(receiving, ", ") })
		statusLabel.Visible = true
	else
		statusLabel.Visible = false
	end
	micLabel.Visible = muted
end

local function setTransmitting(value: boolean)
	if transmitting == value then
		return
	end
	transmitting = value
	Net.Event("RadioState"):FireServer(value)
	AudioController.Play(if value then "radio_squelch_on" else "radio_squelch_off", nil, 0.5, "SFX")
	InputController.SetTouchActive("Radio", value)
	ensureRender()
	refreshHud()
end

local function setMuted(value: boolean)
	muted = value
	Net.Event("MicMute"):FireServer(value)
	InputController.SetTouchActive("Mic", value)
	refreshHud()
end

function RadioController.IsMuted(): boolean
	return muted
end

function RadioController.ToggleMute()
	setMuted(not muted)
end

-- Called when gameplay is paused (menus, documents, downed is fine).
function RadioController.Stop()
	setTransmitting(false)
end

function RadioController.Init(hudGui: ScreenGui, settingsController)
	settings = settingsController
	statusLabel = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.Accent, Size = UDim2.fromOffset(360, 20), Position = UDim2.new(0, 24, 1, -64), Parent = hudGui })
	statusLabel.Visible = false
	statusLabel.TextStrokeTransparency = 0.5
	micLabel = Components.Text({ Key = "MIC_OFF", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, Size = UDim2.fromOffset(360, 20), Position = UDim2.new(0, 24, 1, -40), Parent = hudGui })
	micLabel.Visible = false
	micLabel.TextStrokeTransparency = 0.5

	InputController.Action:Connect(function(name, pressed)
		if name == "Radio" then
			if settings.Get("radioMode") == "toggle" then
				if pressed then
					setTransmitting(not transmitting)
				end
			else
				setTransmitting(pressed)
			end
		elseif name == "Mic" and pressed then
			setMuted(not muted)
		end
	end)

	VoiceController.ReceivingChanged:Connect(function(names)
		receiving = names
		ensureRender()
		refreshHud()
	end)
	Localization.Changed:Connect(refreshHud)
	player:GetAttributeChangedSignal("FZ_RadioColor"):Connect(function()
		if viewmodel then
			viewmodel:Destroy()
			viewmodel = nil
		end
	end)
end

return RadioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="99">
            <Properties>
              <string name="Name">RescueController</string>
              <string name="Source"><![CDATA[-- RescueController: everything around being down and helping someone up.
--   * You are down: bleed-out countdown, camera near the floor, hint about the syringe
--   * A teammate is down: an atmospheric "help" marker with the remaining time
--   * You are helping: you kneel (lower camera) and cannot move - you are vulnerable;
--     taking damage cancels the rescue. The prompt only shows if you carry a medkit.
--   * You are out: spectate your teammates (click / tap / A = next) until the team
--     reaches the next checkpoint or the survival break

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local Components = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)

local RescueController = {}

local player = Players.LocalPlayer
local markers: { [Player]: BillboardGui } = {}
local activeRescue: ProximityPrompt? = nil
local spectateIndex = 1

local function humanoid(): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function setCameraLow(depth: number)
	local h = humanoid()
	if h then
		h.CameraOffset = Vector3.new(0, -depth, 0)
	end
end

local function marker(target: Player)
	local old = markers[target]
	if old then
		old:Destroy()
		markers[target] = nil
	end
	if target == player or not target:GetAttribute("FZ_Downed") then
		return
	end
	local head = target.Character and target.Character:FindFirstChild("Head")
	if not head then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "FZ_HelpMarker"
	gui.Size = UDim2.fromOffset(150, 46)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.AutoLocalize = false
	gui.Adornee = head :: BasePart
	local label = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = 15, Color = Theme.Colors.Accent, XAlign = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = gui })
	label.TextStrokeTransparency = 0.3
	gui.Parent = player:WaitForChild("PlayerGui")
	markers[target] = gui
	task.spawn(function()
		while gui.Parent and target:GetAttribute("FZ_Downed") do
			local untilTime = target:GetAttribute("FZ_DownedUntil")
			local seconds = if type(untilTime) == "number" then math.max(0, math.ceil(untilTime - workspace:GetServerTimeNow())) else 0
			-- slow pulse instead of a bright blinking icon
			label.TextTransparency = 0.15 + 0.35 * (0.5 + 0.5 * math.sin(os.clock() * 3))
			label.Text = Localization.T("HELP_MARKER", { name = target.DisplayName, seconds = seconds })
			task.wait(0.1)
		end
		gui:Destroy()
	end)
end

local function watch(target: Player)
	target:GetAttributeChangedSignal("FZ_Downed"):Connect(function()
		marker(target)
	end)
	target.CharacterAdded:Connect(function()
		task.wait(0.5)
		marker(target)
	end)
	marker(target)
end

-- Spectator camera while eliminated
local function teammates(): { Player }
	local list = {}
	for _, other in Players:GetPlayers() do
		if other ~= player and other:GetAttribute("FZ_InGame") and not other:GetAttribute("FZ_Eliminated") and other.Character then
			table.insert(list, other)
		end
	end
	return list
end

local function spectate()
	local camera = workspace.CurrentCamera
	local list = teammates()
	if #list == 0 or not camera then
		return
	end
	spectateIndex = ((spectateIndex - 1) % #list) + 1
	local target = list[spectateIndex]
	local h = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
	if h then
		camera.CameraSubject = h
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 8
	end
end

function RescueController.Init(hudGui: ScreenGui)
	local downedPanel = Components.Text({ Text = "", Font = Theme.Fonts.Medium, TextSize = Theme.Sizes.TextBody, Color = Theme.Colors.TextBright, XAlign = Enum.TextXAlignment.Center, AutoY = true, Size = UDim2.new(0.7, 0, 0, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = hudGui })
	downedPanel.TextStrokeTransparency = 0.4
	downedPanel.Visible = false

	local function refreshSelf()
		local downed = player:GetAttribute("FZ_Downed") == true
		local eliminated = player:GetAttribute("FZ_Eliminated") == true
		downedPanel.Visible = downed or eliminated
		setCameraLow(if downed then 2.2 else 0)
		if eliminated then
			spectateIndex = 1
			spectate()
		else
			local h = humanoid()
			local camera = workspace.CurrentCamera
			if h and camera and camera.CameraSubject ~= h then
				camera.CameraSubject = h
			end
			if player.CameraMode ~= Enum.CameraMode.LockFirstPerson and not player:GetAttribute("FZ_MonsterMode") then
				player.CameraMode = Enum.CameraMode.LockFirstPerson
				player.CameraMinZoomDistance = 0.5
			end
		end
	end
	player:GetAttributeChangedSignal("FZ_Downed"):Connect(refreshSelf)
	player:GetAttributeChangedSignal("FZ_Eliminated"):Connect(refreshSelf)

	RunService.Heartbeat:Connect(function()
		if not downedPanel.Visible then
			return
		end
		if player:GetAttribute("FZ_Eliminated") then
			downedPanel.Text = Localization.T("HUD_SPECTATING")
		else
			local untilTime = player:GetAttribute("FZ_DownedUntil")
			local seconds = if type(untilTime) == "number" then math.max(0, math.ceil(untilTime - workspace:GetServerTimeNow())) else 0
			downedPanel.Text = Localization.T("HUD_DOWNED_TIMER", { seconds = seconds })
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not player:GetAttribute("FZ_Eliminated") then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.ButtonA then
			spectateIndex += 1
			spectate()
		end
	end)

	-- Helping someone up: kneel, frozen, cancelled by damage
	ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
		if prompt:GetAttribute("FZ_Object") == "OBJECT_TEAMMATE" then
			activeRescue = prompt
			player:SetAttribute("FZ_Rescuing", true)
			setCameraLow(1.4)
		end
	end)
	ProximityPromptService.PromptButtonHoldEnded:Connect(function(prompt)
		if prompt == activeRescue then
			activeRescue = nil
			player:SetAttribute("FZ_Rescuing", nil)
			setCameraLow(0)
		end
	end)
	Net.Event("Hurt").OnClientEvent:Connect(function()
		local prompt = activeRescue
		if prompt then
			pcall(function()
				prompt:InputHoldEnd()
			end)
			activeRescue = nil
			player:SetAttribute("FZ_Rescuing", nil)
			setCameraLow(0)
		end
	end)

	for _, other in Players:GetPlayers() do
		watch(other)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(other)
		if markers[other] then
			markers[other]:Destroy()
			markers[other] = nil
		end
	end)
end

return RescueController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="100">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[-- SettingsController: local source of truth for player settings.
-- Changes apply instantly on this client and are persisted through the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local SettingsController = {}
SettingsController.Changed = Signal.new() -- (key, value)

local values: { [string]: any } = Config.DefaultSettings()
local updateRemote = Net.Event("UpdateSetting")

function SettingsController.Load(saved: { [string]: any }?)
	for key, value in saved or {} do
		local ok, sanitized = Config.ValidateSetting(key, value)
		if ok then
			values[key] = sanitized
		end
	end
end

function SettingsController.Get(key: string): any
	return values[key]
end

function SettingsController.Set(key: string, value: any): boolean
	local ok, sanitized = Config.ValidateSetting(key, value)
	if not ok then
		return false
	end
	if values[key] == sanitized then
		return true
	end
	values[key] = sanitized
	if key == "language" then
		Localization.SetLanguage(sanitized)
	end
	SettingsController.Changed:Fire(key, sanitized)
	updateRemote:FireServer(key, sanitized)
	return true
end

-- Cycles enum / bool / int settings by delta (+1 / -1). Wraps for enums and bools.
function SettingsController.Step(key: string, delta: number)
	local definition = Config.Settings[key]
	if not definition then
		return
	end
	local current = values[key]
	if definition.kind == "bool" then
		SettingsController.Set(key, not current)
	elseif definition.kind == "enum" then
		local index = table.find(definition.values, current) or 1
		local nextIndex = ((index - 1 + delta) % #definition.values) + 1
		SettingsController.Set(key, definition.values[nextIndex])
	elseif definition.kind == "int" then
		SettingsController.Set(key, math.clamp((current or definition.default) + delta, definition.min, definition.max))
	end
end

-- Display text for a setting value in the current language.
function SettingsController.Describe(key: string): string
	local definition = Config.Settings[key]
	local value = values[key]
	if not definition then
		return ""
	end
	if key == "language" then
		return Config.LanguageNames[value] or ""
	elseif definition.kind == "bool" then
		return Localization.T(if value then "VALUE_ON" else "VALUE_OFF")
	elseif definition.kind == "enum" then
		return Localization.T(definition.labels[value])
	elseif definition.kind == "int" then
		return tostring(value)
	end
	return tostring(value)
end

return SettingsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="101">
            <Properties>
              <string name="Name">VoiceController</string>
              <string name="Source"><![CDATA[-- VoiceController: hearing voices on this client.
--
-- Proximity voice: one AudioListener on the camera hears every player's head emitter
-- (spatial, quieter with distance). Your own emitter is silenced locally so you never
-- hear yourself. Muting a teammate only changes YOUR local copy of their fader.
--
-- Radio (walkie-talkie, like Escape the Backrooms): while someone transmits, their
-- microphone is wired through a radio filter (band-pass + distortion) straight to your
-- speakers. Volume falls with distance and static rises; far away only static remains.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local VoiceChatService = game:GetService("VoiceChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Signal = require(Shared.Signal)

local AudioController = require(script.Parent.AudioController)

local VoiceController = {}
VoiceController.ReceivingChanged = Signal.new() -- (names: { string })

local localPlayer = Players.LocalPlayer
local output: Instance? = nil
local available = false
local locallyMuted: { [number]: boolean } = {}

type RadioChain = { nodes: { Instance }, fader: Instance, static: Sound? }
local radioChains: { [Player]: RadioChain } = {}

local function create(className: string, props: { [string]: any }, parent: Instance): Instance
	local instance = Instance.new(className)
	for key, value in props do
		(instance :: any)[key] = value
	end
	instance.Parent = parent
	return instance
end

local function wire(source: Instance, target: Instance, parent: Instance): Instance
	return create("Wire", { SourceInstance = source, TargetInstance = target }, parent)
end

local function voiceFader(player: Player): Instance?
	local head = player.Character and player.Character:FindFirstChild("Head")
	return head and head:FindFirstChild("FZ_VoiceFader")
end

local voiceVolume = 1

local function applyLocalVolume(player: Player)
	local fader = voiceFader(player)
	if fader then
		local volume = if player == localPlayer or locallyMuted[player.UserId] then 0 else voiceVolume
		pcall(function()
			(fader :: any).Volume = volume
		end)
	end
end

local function distanceTo(player: Player): number
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local camera = workspace.CurrentCamera
	if not root or not camera then
		return math.huge
	end
	return (root.Position - camera.CFrame.Position).Magnitude
end

local function radioVolume(distance: number): (number, number)
	local V = Config.Voice
	if distance <= V.RadioFull then
		return 1, 0.05
	end
	local t = math.clamp((distance - V.RadioFull) / (V.RadioMax - V.RadioFull), 0, 1)
	local voice = math.max(V.RadioMinVolume, (1 - t) ^ 1.6) * (if t >= 1 then 0 else 1)
	return voice, 0.05 + t * 0.5
end

local function stopRadio(player: Player)
	local chain = radioChains[player]
	if not chain then
		return
	end
	radioChains[player] = nil
	for _, node in chain.nodes do
		node:Destroy()
	end
	if chain.static then
		chain.static:Destroy()
	end
	AudioController.Play("radio_squelch_off", nil, 0.6, "SFX")
end

local function startRadio(player: Player)
	if radioChains[player] or player == localPlayer or locallyMuted[player.UserId] or not output then
		return
	end
	AudioController.Play("radio_squelch_on", nil, 0.6, "SFX")
	local static = AudioController.Loop("radio_static_loop", game:GetService("SoundService"), 0.05, "SFX")
	local input = player:FindFirstChildOfClass("AudioDeviceInput")
	local nodes = {}
	local fader = nil
	if input and available then
		local ok = pcall(function()
			local holder = Instance.new("Folder")
			holder.Name = "FZ_Radio_" .. player.UserId
			holder.Parent = localPlayer
			table.insert(nodes, holder)
			local bandpass = create("AudioFilter", { FilterType = Enum.AudioFilterType.Bandpass, Frequency = 1700, Q = 0.9 }, holder)
			local distortion = create("AudioDistortion", { Level = 0.35 }, holder)
			fader = create("AudioFader", { Volume = 1 }, holder)
			wire(input, bandpass, holder)
			wire(bandpass, distortion, holder)
			wire(distortion, fader, holder)
			wire(fader, output :: Instance, holder)
		end)
		if not ok then
			for _, node in nodes do
				node:Destroy()
			end
			nodes = {}
			fader = nil
		end
	end
	radioChains[player] = { nodes = nodes, fader = fader :: any, static = static }
end

local function refreshReceiving()
	local names = {}
	for player in radioChains do
		table.insert(names, player.DisplayName)
	end
	VoiceController.ReceivingChanged:Fire(names)
end

local function watchPlayer(player: Player)
	player:GetAttributeChangedSignal("FZ_RadioTx"):Connect(function()
		if player:GetAttribute("FZ_RadioTx") then
			startRadio(player)
		else
			stopRadio(player)
		end
		refreshReceiving()
	end)
	player.CharacterAdded:Connect(function(character)
		local head = character:WaitForChild("Head", 10)
		if head then
			head.ChildAdded:Connect(function(child)
				if child.Name == "FZ_VoiceFader" then
					applyLocalVolume(player)
				end
			end)
			applyLocalVolume(player)
		end
	end)
	applyLocalVolume(player)
end

function VoiceController.IsAvailable(): boolean
	return available
end

function VoiceController.SetMuted(player: Player, muted: boolean)
	locallyMuted[player.UserId] = muted or nil
	applyLocalVolume(player)
	if muted then
		stopRadio(player)
		refreshReceiving()
	end
end

function VoiceController.IsMuted(player: Player): boolean
	return locallyMuted[player.UserId] == true
end

-- Settings -> Audio -> "Voices and radio" (0..1)
function VoiceController.SetVolume(value: number)
	voiceVolume = value
	for _, player in Players:GetPlayers() do
		applyLocalVolume(player)
	end
end

function VoiceController.Init()
	local ok, enabled = pcall(function()
		return VoiceChatService:IsVoiceEnabledForUserIdAsync(localPlayer.UserId)
	end)
	available = ok and enabled == true

	pcall(function()
		local camera = workspace.CurrentCamera
		local listener = create("AudioListener", { Name = "FZ_Listener" }, camera)
		output = create("AudioDeviceOutput", { Name = "FZ_Output" }, localPlayer)
		wire(listener, output :: Instance, listener)
		workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
			if workspace.CurrentCamera then
				listener.Parent = workspace.CurrentCamera
			end
		end)
	end)

	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	Players.PlayerRemoving:Connect(function(player)
		stopRadio(player)
		refreshReceiving()
	end)

	-- Distance-based radio mix, 10 Hz
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.1 or next(radioChains) == nil then
			return
		end
		accumulator = 0
		for player, chain in radioChains do
			local voice, staticVolume = radioVolume(distanceTo(player))
			voice *= voiceVolume
			if chain.fader then
				pcall(function()
					(chain.fader :: any).Volume = voice
				end)
			end
			if chain.static then
				chain.static.Volume = staticVolume
			end
		end
	end)
end

return VoiceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="102">
            <Properties>
              <string name="Name">WorldTextController</string>
              <string name="Source"><![CDATA[-- WorldTextController: per-player localization of text that lives in the 3D world.
--   * ProximityPrompts tagged "FZ_Prompt" (attributes FZ_Action / FZ_Object)
--   * TextLabels on SurfaceGuis tagged "FZ_WorldText" (attribute LocKey, LocParam_<name>)
-- Text is set locally, so four players can read the same sign in four languages.
-- Works with StreamingEnabled: objects are localized whenever they stream in.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Localization = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Localization"))

local WorldTextController = {}

local function localizePrompt(prompt: Instance)
	if not prompt:IsA("ProximityPrompt") then
		return
	end
	local action = prompt:GetAttribute("FZ_Action")
	local object = prompt:GetAttribute("FZ_Object")
	prompt.ActionText = if type(action) == "string" then Localization.T(action) else ""
	prompt.ObjectText = if type(object) == "string" then Localization.T(object) else ""
	-- Equipment changes hold times locally (technician / medic). The base value is kept.
	if prompt:GetAttribute("FZ_BaseHold") == nil then
		prompt:SetAttribute("FZ_BaseHold", prompt.HoldDuration)
	end
	local base = prompt:GetAttribute("FZ_BaseHold") :: number
	local player = Players.LocalPlayer
	local multiplier = if object == "OBJECT_TEAMMATE"
		then tonumber(player:GetAttribute("FZ_ReviveMultiplier")) or 1
		else tonumber(player:GetAttribute("FZ_HoldMultiplier")) or 1
	prompt.HoldDuration = base * multiplier
	-- Your own "help up" prompt is for your teammates, not for you.
	local character = player.Character
	if character and prompt:IsDescendantOf(character) then
		prompt.Enabled = false
	elseif object == "OBJECT_TEAMMATE" then
		-- Helping someone up needs a medkit: without one the prompt says so and stays inactive.
		local items = player:GetAttribute("FZ_Items")
		local hasMedkit = type(items) == "string" and string.find(items, "medkit", 1, true) ~= nil
		prompt.Enabled = hasMedkit
	end
end

local function localizeText(label: Instance)
	if not label:IsA("TextLabel") then
		return
	end
	local key = label:GetAttribute("LocKey")
	if type(key) ~= "string" then
		return
	end
	local params = {}
	for name, value in label:GetAttributes() do
		local paramName = string.match(name, "^LocParam_(.+)$")
		if paramName then
			params[paramName] = value
		end
	end
	label.AutoLocalize = false
	label.Text = Localization.T(key, params)
end

local function refreshAll()
	for _, prompt in CollectionService:GetTagged("FZ_Prompt") do
		localizePrompt(prompt)
	end
	for _, label in CollectionService:GetTagged("FZ_WorldText") do
		localizeText(label)
	end
end

function WorldTextController.Init()
	CollectionService:GetInstanceAddedSignal("FZ_Prompt"):Connect(localizePrompt)
	CollectionService:GetInstanceAddedSignal("FZ_WorldText"):Connect(localizeText)
	Localization.Changed:Connect(refreshAll)
	local player = Players.LocalPlayer
	player:GetAttributeChangedSignal("FZ_HoldMultiplier"):Connect(refreshAll)
	player:GetAttributeChangedSignal("FZ_ReviveMultiplier"):Connect(refreshAll)
	player:GetAttributeChangedSignal("FZ_Items"):Connect(refreshAll)
	refreshAll()
end

return WorldTextController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="103">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- SILENT RELAY - client bootstrap.
--
-- Flow: boot screen (logo only) -> load profile -> apply saved language BEFORE any text
-- exists -> first start: language picker / otherwise: main menu -> play.
-- Because no localized UI is created before the language is known, players never see
-- placeholder or wrong-language text that changes a moment later.

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local LocalizationService = game:GetService("LocalizationService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Updates = require(Shared.Updates)
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local Controllers = script.Parent:WaitForChild("Controllers")
local UI = script.Parent:WaitForChild("UI")

local InputController = require(Controllers.InputController)
local SettingsController = require(Controllers.SettingsController)
local GraphicsController = require(Controllers.GraphicsController)
local MovementController = require(Controllers.MovementController)
local FlashlightController = require(Controllers.FlashlightController)
local WorldTextController = require(Controllers.WorldTextController)
local AudioController = require(Controllers.AudioController)
local VoiceController = require(Controllers.VoiceController)
local RadioController = require(Controllers.RadioController)
local CreatureVisualsController = require(Controllers.CreatureVisualsController)
local HealthController = require(Controllers.HealthController)
local EquipmentController = require(Controllers.EquipmentController)
local DirectorController = require(Controllers.DirectorController)
local InventoryController = require(Controllers.InventoryController)
local PromptController = require(Controllers.PromptController)
local RescueController = require(Controllers.RescueController)
local DecisionPanel = require(UI.DecisionPanel)

local Components = require(UI.Components)
local Theme = require(UI.Theme)
local Router = require(UI.Router)
local Hud = require(UI.Hud)
local DebugOverlay = require(UI.DebugOverlay)
local MainMenu = require(UI.Screens.MainMenu)
local LanguageSelect = require(UI.Screens.LanguageSelect)

---------------------------------------------------------------------------
-- 1. Screen layers (no text yet)
---------------------------------------------------------------------------
local backdropGui = Components.ScreenGui("FZ_Backdrop", 10, true)
local menuGui = Components.ScreenGui("FZ_Menu", 20)
Components.AttachScale(menuGui)
local hudGui = Components.ScreenGui("FZ_HUD", 30)
Components.AttachScale(hudGui)

-- Dark on the left (menu column), revealing the scene on the right.
local backdrop = Instance.new("Frame")
backdrop.Name = "Backdrop"
backdrop.BackgroundColor3 = Theme.Colors.Background
backdrop.BorderSizePixel = 0
backdrop.Size = UDim2.fromScale(1, 1)
backdrop.Visible = false
backdrop.Parent = backdropGui
local gradient = Instance.new("UIGradient")
gradient.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.55),
	NumberSequenceKeypoint.new(0.5, 0.85),
	NumberSequenceKeypoint.new(1, 0.92),
})
gradient.Parent = backdrop
Components.Vignette(backdrop, 0.6)
-- letterbox bars: cinematic frame for the title screen
for _, top in { true, false } do
	local bar = Instance.new("Frame")
	bar.Name = if top then "LetterboxTop" else "LetterboxBottom"
	bar.BackgroundColor3 = Color3.new(0, 0, 0)
	bar.BorderSizePixel = 0
	bar.AnchorPoint = Vector2.new(0, if top then 0 else 1)
	bar.Position = UDim2.fromScale(0, if top then 0 else 1)
	bar.Size = UDim2.new(1, 0, 0.055, 0)
	bar.Parent = backdrop
end
-- black frame used for cuts between menu camera shots
local cutFrame = Instance.new("Frame")
cutFrame.Name = "Cut"
cutFrame.BackgroundColor3 = Color3.new(0, 0, 0)
cutFrame.BackgroundTransparency = 1
cutFrame.BorderSizePixel = 0
cutFrame.Size = UDim2.fromScale(1, 1)
cutFrame.ZIndex = 60
cutFrame.Parent = backdropGui

InputController.Init(hudGui)

---------------------------------------------------------------------------
-- 2. Profile + language (before any localized UI is built)
---------------------------------------------------------------------------
local function waitForAttribute(name: string, timeout: number): boolean
	local deadline = os.clock() + timeout
	while player:GetAttribute(name) ~= true and os.clock() < deadline do
		task.wait(0.1)
	end
	return player:GetAttribute(name) == true
end

local profile = nil
if waitForAttribute("FZ_DataReady", 25) then
	local ok, result = pcall(function()
		return Net.Function("FetchProfile"):InvokeServer()
	end)
	if ok and type(result) == "table" then
		profile = result
	end
end
profile = profile
	or { settings = {}, signalMarks = 0, progress = { chapter = 1, completedChapters = {} }, survival = {}, seenContent = {}, lastSeenUpdate = "", persistent = false, isNew = true }

SettingsController.Load(profile.settings)

local function robloxLocale(): string
	local ok, locale = pcall(function()
		return LocalizationService.RobloxLocaleId
	end)
	if ok and type(locale) == "string" and locale ~= "" then
		return locale
	end
	return player.LocaleId
end

local savedLanguage = SettingsController.Get("language")
local detectedLanguage = Localization.Detect(robloxLocale()) or Config.FallbackLanguage
Localization.SetLanguage(savedLanguage or detectedLanguage)

if RunService:IsStudio() then
	for _, problem in Localization.Validate() do
		warn("[FZ-Loc] " .. problem)
	end
end

---------------------------------------------------------------------------
-- 3. Controllers and HUD
---------------------------------------------------------------------------
local state = "boot" -- boot | language | menu | playing | paused
local router = Router.new(menuGui, InputController)

local controls = nil
local function getControls()
	if controls then
		return controls
	end
	local ok, result = pcall(function()
		local playerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript)
		return (playerModule :: any):GetControls()
	end)
	if ok then
		controls = result
	else
		warn("[FZ] PlayerModule controls unavailable: " .. tostring(result))
	end
	return controls
end

local function setGameplay(enabled: boolean)
	InputController.SetGameplayEnabled(enabled)
	MovementController.SetActive(enabled)
	-- No world interactions (E / X / tap prompts) while a menu or document is open.
	pcall(function()
		(ProximityPromptService :: any).Enabled = enabled
	end)
	if not enabled then
		RadioController.Stop()
	end
	EquipmentController.SetActive(enabled)
	local c = getControls()
	if c then
		if enabled then
			c:Enable()
		else
			c:Disable()
		end
	end
end

-- Title screen camera: slow dolly shots between the FZ_MenuCamera anchors (ordered by
-- their "Shot" attribute), with short black cuts. One anchor = one slow drifting shot.
local menuCameraConnection: RBXScriptConnection? = nil
local SHOT_SECONDS = 14
local function menuShots(): { BasePart }
	local shots = {}
	for _, anchor in CollectionService:GetTagged("FZ_MenuCamera") do
		if anchor:IsA("BasePart") then
			table.insert(shots, anchor)
		end
	end
	table.sort(shots, function(a, b)
		return (a:GetAttribute("Shot") or 0) < (b:GetAttribute("Shot") or 0)
	end)
	return shots
end
local function setMenuCamera(active: boolean)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if menuCameraConnection then
		menuCameraConnection:Disconnect()
		menuCameraConnection = nil
	end
	cutFrame.BackgroundTransparency = 1
	if active then
		local shots = menuShots()
		if #shots == 0 then
			return
		end
		camera.CameraType = Enum.CameraType.Scriptable
		camera.FieldOfView = 62
		local index, elapsed = 1, 0
		local calm = SettingsController.Get("cameraEffects") == "off"
		menuCameraConnection = RunService.RenderStepped:Connect(function(dt)
			elapsed += dt
			if elapsed >= SHOT_SECONDS and #shots > 1 then
				elapsed = 0
				index = index % #shots + 1
			end
			local anchor = shots[index]
			if not anchor.Parent then
				return
			end
			local t = elapsed / SHOT_SECONDS
			local drift = anchor:GetAttribute("Drift") or 6
			local offset = if calm then CFrame.new() else CFrame.new((t - 0.5) * drift, math.sin(t * math.pi) * 0.4, -(t * drift * 0.35)) * CFrame.Angles(0, (0.5 - t) * 0.04, 0)
			camera.CFrame = anchor.CFrame * offset
			-- black cut at the end/start of each shot
			if #shots > 1 then
				local edge = math.min(elapsed, SHOT_SECONDS - elapsed)
				cutFrame.BackgroundTransparency = math.clamp(edge / 0.6, 0, 1)
			end
		end)
	else
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = Config.Movement.BaseFov
	end
end

-- Menu blur: the world softens behind any open menu while playing (pause, documents).
local Lighting = game:GetService("Lighting")
local menuBlur = Instance.new("BlurEffect")
menuBlur.Name = "FZ_MenuBlur"
menuBlur.Size = 0
menuBlur.Parent = Lighting
local function setMenuBlur(on: boolean)
	TweenService:Create(menuBlur, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = if on then 14 else 0 }):Play()
end

GraphicsController.Init(SettingsController)
WorldTextController.Init()
Hud.Init(hudGui, SettingsController, InputController, {
	onOpen = function()
