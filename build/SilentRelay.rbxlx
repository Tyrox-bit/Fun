	SIGN_CORE = "CENTRAL CORE\nRELAY SYSTEM",
	SIGN_CONTROL = "ENTRANCE / CONTROL",
	ADMIN_SPAWN_CREATURE = "Spawn creature in front of me",
	ADMIN_CREATURE_AI = "Creature AI on / off",
	ADMIN_PLAY_CREATURE = "Play as the creature",
	ADMIN_PLAY_HUMAN = "Back to my character",
	ADMIN_TP_CORE = "Teleport to the core",
	ADMIN_SPEED = "Test speed ×2 on / off",
	ADMIN_RESET = "Reset creature and events",
	ADMIN_PUBLIC_BLOCKED = "Not allowed in public servers.",

	-- 0.3: modes, maps, survival, updates
	PLAY_TITLE = "Choose your signal",
	MODE_STORY = "STORY",
	MODE_STORY_DESC = "Four chapters, one story. Alone or with up to three friends.",
	MODE_SURVIVAL = "ENDLESS SURVIVAL",
	MODE_SURVIVAL_DESC = "Keep the station running shift after shift. Leave whenever you want – during a break.",
	CHAPTER_01_DESC = "Relay Station 07 is transmitting again. Find out who.",
	CHAPTER_02_DESC = "Below the dam, the second voice gets louder.",
	CHAPTER_03_DESC = "In the old chapel, someone kept a record of every night.",
	CHAPTER_04_DESC = "Deep in the mine, the signal begins.",
	MAP_RELAY07 = "Relay Station 07",
	MAP_DAM03 = "Dam 3",
	MAP_MINE = "The Mine",
	MAP_CHURCH = "The Chapel",
	SV_MAP_RELAY07 = "Relay Station 07 – Night shift",
	SV_MAP_RELAY07_DESC = "Every shift a new task. Every shift it listens more closely.",
	SV_MAP_DAM03 = "Dam 3 – Floodgate",
	SV_MAP_DAM03_DESC = "Three sectors, one dam, a storm that never ends. Get out by the van at the barrier.",
	CONTENT_PLANNED = "In development",
	CONTENT_LOCKED = "After chapter {number}",
	CONTENT_NEW = "NEW",
	CONTENT_DONE = "Completed",
	CONTENT_DOT = "●",
	SV_BEST = "Best: shift {shifts}",
	SV_LEADERBOARD = "Leaderboard",
	LEADERBOARD_TITLE = "Leaderboard",
	LEADERBOARD_LOADING = "Receiving…",
