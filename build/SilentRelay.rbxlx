	TOUCH_RADIO = "Radio",
	TOUCH_MIC = "Mic",
	TOUCH_NIGHT = "Night",
	RADIO_TX = "TRANSMITTING",
	RADIO_RX = "Receiving: {name}",
	MIC_ON = "Microphone open",
	MIC_OFF = "Microphone muted",
	MIC_MUTE = "Mute my microphone",
	MIC_UNMUTE = "Unmute my microphone",
	VOICE_UNAVAILABLE = "Voice chat is off for your account. You can still hear the radio and play normally.",
	LOBBY_MUTE = "Mute",
	LOBBY_UNMUTE = "Unmute",
	MENU_SHOP = "Shop",
	SHOP_TAB_GEAR = "Equipment",
	SHOP_TAB_UPGRADES = "Upgrades",
	SHOP_TAB_COSMETIC = "Cosmetics",
	SHOP_BUY = "Unlock · {price}",
	SHOP_EQUIP = "Equip",
	SHOP_EQUIPPED = "Equipped",
	SHOP_UNEQUIP = "Take off",
	SHOP_OWNED = "Owned",
	SHOP_CONFIRM = "Unlock for {price} signal marks?",
	SHOP_CONFIRM_YES = "Yes, unlock",
	SHOP_NOT_ENOUGH = "Not enough signal marks yet.",
	SHOP_DONE = "Unlocked.",
	SHOP_ERROR = "That did not work. Nothing was charged.",
	SHOP_FAIR = "Equipment is earned in the game only – never with Robux.",
	SHOP_ONE_SET = "Only one set can be equipped at a time.",
	ITEM_TECH_NAME = "Technician set",
	ITEM_TECH_DESC = "Repair tools. Fuses, relays and doors are operated 40 % faster.",
	ITEM_OBSERVER_NAME = "Observer set",
	ITEM_OBSERVER_DESC = "Night vision with a rechargeable battery. Shows fresh tracks of the creature.",
	ITEM_MEDIC_NAME = "Medic set",
	ITEM_MEDIC_DESC = "Starts with 2 medkits, helps teammates up twice as fast and with more health. Healing items work 50 % better.",
	ITEM_FLASHLIGHT_NAME = "Flashlight upgrade",
	ITEM_FLASHLIGHT_DESC = "Longer beam. Blinding the creature recharges faster.",
	ITEM_SKIN_OLIVE_NAME = "Radio: Field olive",
	ITEM_SKIN_RUST_NAME = "Radio: Rust",
	ITEM_SKIN_SIGNAL_NAME = "Radio: Signal red",
	ITEM_SKIN_DESC = "Cosmetic housing for your radio.",
	ITEM_SUPPORTER_NAME = "Supporter pass",
	ITEM_SUPPORTER_DESC = "Supports development. Includes the signal-red radio housing. Purely cosmetic.",
	HUD_DOWNED = "You are down. Your team can help you up.",
	HUD_SIGNAL_LOST = "Signal lost. Back to the last checkpoint.",
	INTERACT_REVIVE = "Help up (medkit)",
	OBJECT_TEAMMATE = "Teammate",
	INTERACT_PICKUP = "Take",
	INTERACT_INSERT = "Insert fuses",
	INTERACT_ACTIVATE = "Activate",
	INTERACT_CLOSE = "Close",
	INTERACT_HOLD_BREAKER = "Hold the breaker",
	INTERACT_LEAVE = "Leave the station",
	OBJECT_FUSE = "Fuse",
	OBJECT_RELAY_B = "Relay Sector B",
	OBJECT_CORE = "Central core",
	OBJECT_BREAKER = "Breaker Sector A",
	OBJECT_ANTENNA = "Antenna",
	DOOR_LOCKED = "Locked – no power",
	OBJECTIVE_REACH_CONTROL = "Get into the control room.",
	OBJECTIVE_FIND_FUSES = "Find fuses ({count}/{total}).",
	OBJECTIVE_RELAY_B = "Reactivate Relay Sector B.",
	OBJECTIVE_CORE = "Activate the central core.",
	OBJECTIVE_ANTENNA = "Get to the antenna outside.",
	CHAPTER_COMPLETE = "End of the slice – thank you for testing.",
	REWARD_MARKS = "+{amount} signal marks",
	RADIO_C1_TERMINAL = "The core is offline. Three fuses are missing. They're somewhere in the sectors.",
	RADIO_C1_WAKE = "You took it. Now it's awake. Walk. Don't run.",
	RADIO_C1_FORECAST = "In thirty seconds the lights in Sector A go out. Then it will hear you.",
	RADIO_C1_FORECAST_KEPT = "There. Exactly like last time.",
	RADIO_C1_FORECAST_BROKEN = "You... held it. That has never happened before.",
	RADIO_C1_CORE = "{name}. This time, not the left door.",
	RADIO_C1_ANTENNA = "...they're leaving. Why are they leaving? We were never allowed to leave.",
	SFX_CREATURE_NEAR = "[Static crackling – very close]",
	SFX_VENT = "[Something moves inside the vents]",
	SFX_POWER_DOWN = "[The power fails]",
	SFX_RELAY = "[A relay starts humming]",
	SIGN_SECTOR_A = "SECTOR A\nADMINISTRATION",
	SIGN_SECTOR_B = "SECTOR B\nLABORATORIES",
	SIGN_SECTOR_C = "SECTOR C\nRESEARCH",
	SIGN_SECTOR_D = "SECTOR D\nQUARTERS",
