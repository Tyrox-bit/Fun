      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Achievements</string>
          <string name="Source"><![CDATA[-- Achievements: clear conditions, one-time server-side rewards, no daily obligations.
-- Conditions are checked where the event happens (see AchievementService.Award calls).

return {
	{ id = "first_contact", name = "ACH_FIRST_CONTACT", description = "ACH_FIRST_CONTACT_DESC", marks = 50 },
	{ id = "unseen", name = "ACH_UNSEEN", description = "ACH_UNSEEN_DESC", marks = 300 },
	{ id = "archivist", name = "ACH_ARCHIVIST", description = "ACH_ARCHIVIST_DESC", marks = 250 },
	{ id = "last_survivor", name = "ACH_LAST_SURVIVOR", description = "ACH_LAST_SURVIVOR_DESC", marks = 300 },
	{ id = "nobody_left", name = "ACH_NOBODY_LEFT", description = "ACH_NOBODY_LEFT_DESC", marks = 250 },
	{ id = "forecast_breaker", name = "ACH_BREAKER", description = "ACH_BREAKER_DESC", marks = 100 },
	{ id = "night_shift_10", name = "ACH_SHIFT10", description = "ACH_SHIFT10_DESC", marks = 400 },
	{ id = "decoder", name = "ACH_DECODER", description = "ACH_DECODER_DESC", marks = 200 },
	{ id = "rescuer", name = "ACH_RESCUER", description = "ACH_RESCUER_DESC", marks = 100 },
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Assets</string>
          <string name="Source"><![CDATA[-- Asset registry. The ONLY place where Roblox asset ids live.
-- Empty string = not uploaded yet: the game runs silently / with built-in fallbacks.
--
-- Sounds: upload the files from assets/audio/*.ogg (generated by tools/generate_sounds.py,
-- 100 % original) in the Creator Hub -> Development Items -> Audio, then paste the ids
-- here as "rbxassetid://<id>". Never invent ids.
--
-- Creature: put your own monster model into ServerStorage.Creatures (see docs/CREATURE.md)
-- and optionally its animation ids below. Without ids the built-in procedural
-- animation is used for the placeholder creature.

return {
	Sounds = {
		creature_breath_deep_1 = "",
		creature_breath_deep_2 = "",
		creature_breath_deep_3 = "",
		creature_growl_1 = "",
