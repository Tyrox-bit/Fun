	SHOP_CONFIRM_YES = "Ja, freischalten",
	SHOP_NOT_ENOUGH = "Noch nicht genug Signalmarken.",
	SHOP_DONE = "Freigeschaltet.",
	SHOP_ERROR = "Das hat nicht geklappt. Es wurde nichts abgezogen.",
	SHOP_FAIR = "Ausrüstung gibt es nur durch Spielen – niemals für Robux.",
	SHOP_ONE_SET = "Es kann immer nur ein Set ausgerüstet sein.",
