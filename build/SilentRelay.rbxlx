	HINT_C2_CREW = "Der Mannschaftstrakt liegt links der Straße unter der Mauer. Erleuchtete Fenster.",
	HINT_C2_LOG = "Im Büro brennt eine Schreibtischlampe. Daneben liegt das Logbuch.",
	HINT_C2_TURBINES = "Die Turbinenhalle ist das große Gebäude rechts der Straße. Haltet die Turbinen.",
	HINT_C2_CREST = "Der Galerie-Eingang ist mitten in der Mauer. Der Schrägstollen führt hoch.",
	HINT_C2_CREST_RAMP = "Die Rampe führt im Zickzack an der rechten Mauerseite hoch.",
	HINT_C2_SPILLWAY = "Das rote Handrad im Schieberhaus.",
	HINT_C2_UPLINK = "Der Antennenhof ist die Plattform mitten auf der Krone, über dem Wasser.",
	HINT_C3_CHAPEL = "Folgt dem Weg durch das Friedhofstor.",
	HINT_C3_ALTAR = "Der Altar steht am Ende des Kirchenschiffs, unter dem Kreuz.",
	HINT_C3_ARCHIVE = "Die Sakristeitür ist an der rechten Seite des Kirchenschiffs.",
	HINT_C3_TAPES = "Jedes Band nennt eine Uhrzeit. Die Maschine nimmt sie nur von früh nach spät.",
	HINT_C3_OPERATOR = "Die schwere Tür hinten im Archiv ist jetzt offen.",
	HINT_C3_BELL = "Zurück durch Sakristei und Kirchenschiff. Das Seil hängt im Turmeingang.",
	HINT_C4_GATE = "Das Backsteingebäude neben dem Förderturm.",
	HINT_C4_TRANSFORMER = "Von der Kreuzung geradeaus. Wenn die Farben warm werden, ist der Schutt weg.",
	HINT_C4_BLAST = "Die Notsteuerung hängt direkt neben der Panzertür.",
	HINT_C4_BLAST_WAIT = "Bleibt an der Tür. Wenn die Schicht auf 2009 kippt, geht sie auf.",
	HINT_C4_GATHER = "Die Konsole vor dem leuchtenden Kern. Niemand darf fehlen.",
	ACH_STORM = "Durch den Sturm",
	ACH_STORM_DESC = "Schließe Kapitel 2 auf der Staumauer ab. (+{marks})",
	ACH_RUN0007 = "Durchlauf 0007",
	ACH_RUN0007_DESC = "Hör, wer das Relais wirklich ist. (+{marks})",
