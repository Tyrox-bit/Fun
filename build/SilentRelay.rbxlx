	FAX_BODY_NEXT = "Inspektion der stillgelegten Relaisanlage 07.\nGrund: unerlaubte Sendungen im Notrufband.\nAnweisung: Eingehende Rufe nicht beantworten.\n\nAbsender: RELAISANLAGE 07 BETRIEB\nGesendet: {date}, 02:14 Uhr\n\nDurchlauf: 0008",
	FAX_BODY_EMPTY = "(Die Seite ist leer. Nur am Rand ein Datum: heute. Sonst nichts.)",
	OBJ_C2_CREW = "Geht zum Mannschaftstrakt am Fuß der Mauer.",
	OBJ_C2_LOG = "Lest das Logbuch des Dammwärters im Büro.",
	OBJ_C2_TURBINES = "Startet die Turbinen in der Turbinenhalle ({count}/{total}).",
	OBJ_C2_CREST = "Hoch zum Schieberhaus auf der Krone – durch die Galerie und den Schrägstollen.",
	OBJ_C2_CREST_RAMP = "Hoch zum Schieberhaus auf der Krone – die Galerie ist geflutet, nehmt die Rampe außen.",
	OBJ_C2_SPILLWAY = "Schließt den Überlauf im Schieberhaus.",
