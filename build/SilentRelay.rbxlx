            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="9297">
            <Properties>
              <string name="Name">AtmosphereController</string>
              <string name="Source"><![CDATA[-- AtmosphereController: weather and time-layer effects driven by SessionState.
--   Weather = "storm": rain around the camera (off under a roof), lightning flashes
--   TimeLayer = "2009": warm, faded colour grade; every layer change flashes once
-- Uses only built-in textures (no uploaded assets). Respects "reduce flicker" and the
-- particle budget of the graphics profile.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local SessionState = require(Shared.SessionState)

local GraphicsController = require(script.Parent.GraphicsController)

local AtmosphereController = {}

local settings = nil
local rainPart: Part? = nil
local rain: ParticleEmitter? = nil
local flash: ColorCorrectionEffect? = nil
local layerGrade: ColorCorrectionEffect? = nil
local nextLightning = 0

local function ensureEffects()
	if not flash then
		local effect = Instance.new("ColorCorrectionEffect")
		effect.Name = "FZ_Flash"
		effect.Parent = Lighting
		flash = effect
	end
	if not layerGrade then
		local effect = Instance.new("ColorCorrectionEffect")
		effect.Name = "FZ_TimeLayer"
		effect.Parent = Lighting
		layerGrade = effect
	end
	if not rainPart then
		local part = Instance.new("Part")
		part.Name = "FZ_Rain"
		part.Anchored = true
		part.CanCollide = false
		part.CanQuery = false
		part.CanTouch = false
		part.Transparency = 1
		part.Size = Vector3.new(80, 1, 80)
		part.Parent = workspace.CurrentCamera
		local emitter = Instance.new("ParticleEmitter")
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.EmissionDirection = Enum.NormalId.Bottom
		emitter.Speed = NumberRange.new(90, 110)
		emitter.Lifetime = NumberRange.new(0.55, 0.7)
		emitter.Size = NumberSequence.new(0.12)
		emitter.Squash = NumberSequence.new(-3.5) -- long thin streaks
		emitter.Transparency = NumberSequence.new(0.45)
		emitter.Color = ColorSequence.new(Color3.fromRGB(190, 205, 220))
		emitter.LightInfluence = 0.6
		emitter.LightEmission = 0.1
		emitter.Rate = 0
		emitter.Acceleration = Vector3.new(4, 0, 0) -- wind
		emitter.Parent = part
		rainPart = part
		rain = emitter
	end
end

local function flashOnce(strength: number, duration: number)
	local effect = flash :: ColorCorrectionEffect
	if settings and settings.Get("reduceFlicker") then
		strength *= 0.25
	end
	effect.Brightness = strength
	effect.Contrast = strength * 0.4
	TweenService:Create(effect, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Brightness = 0, Contrast = 0 }):Play()
end

-- Under a roof? (one ray straight up from the camera)
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function covered(position: Vector3): boolean
	local camera = workspace.CurrentCamera
	rayParams.FilterDescendantsInstances = { camera :: Instance, game:GetService("Players").LocalPlayer.Character :: Instance }
	return workspace:Raycast(position, Vector3.new(0, 60, 0), rayParams) ~= nil
end

local function applyLayer()
	local effect = layerGrade :: ColorCorrectionEffect
	local layer = SessionState.Get("TimeLayer")
	local goal = if layer == "2009"
		then { TintColor = Color3.fromRGB(255, 226, 192), Saturation = -0.35, Contrast = 0.12, Brightness = 0.03 }
		else { TintColor = Color3.new(1, 1, 1), Saturation = 0, Contrast = 0, Brightness = 0 }
	TweenService:Create(effect, TweenInfo.new(1.2, Enum.EasingStyle.Sine), goal):Play()
	if layer ~= nil then
		flashOnce(0.45, 1.1)
	end
end

-- Map dressing (MapDress): light cones follow their lamp (power cuts switch them off) and
-- the graphics profile; mist/steam rates follow the particle budget; some tubes flicker.
local function updateDressing()
	local profile = GraphicsController.GetProfileName()
	local particleScale = GraphicsController.GetParticleScale()
	for _, beam in CollectionService:GetTagged("FZ_LightCone") do
		if beam:IsA("Beam") then
			local lamp = beam.Parent
			local light = lamp and lamp:FindFirstChildWhichIsA("Light")
			local powered = lamp ~= nil and lamp:GetAttribute("Powered") ~= false and (light == nil or light.Enabled)
			beam.Enabled = profile ~= "low" and powered
		end
	end
	for _, emitter in CollectionService:GetTagged("FZ_Mist") do
		if emitter:IsA("ParticleEmitter") then
			local base = emitter:GetAttribute("BaseRate")
			if type(base) == "number" then
				emitter.Rate = if profile == "low" then 0 else base * particleScale
			end
		end
	end
end

local flickering: { [Instance]: boolean } = {}
local function flickerOnce(fixture: BasePart)
	if flickering[fixture] or fixture:GetAttribute("Powered") == false then
		return
	end
	local light = fixture:FindFirstChildWhichIsA("Light")
	if not light or not light.Enabled then
		return
	end
	flickering[fixture] = true
	local color = fixture.Color
	task.spawn(function()
		for _ = 1, math.random(2, 5) do
			light.Enabled = false
			fixture.Color = color:Lerp(Color3.new(0, 0, 0), 0.7)
			task.wait(math.random(3, 9) / 100)
			local powered = fixture:GetAttribute("Powered") ~= false
			light.Enabled = powered
			if powered then
				fixture.Color = color
			end
			task.wait(math.random(5, 25) / 100)
		end
		flickering[fixture] = nil
	end)
end

function AtmosphereController.Init(settingsController)
	settings = settingsController
	ensureEffects()
	task.spawn(function()
		while true do
			pcall(updateDressing)
			task.wait(0.5)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(math.random(30, 80) / 10)
			if not (settings and settings.Get("reduceFlicker")) then
				local list = CollectionService:GetTagged("FZ_Flicker")
				local camera = workspace.CurrentCamera
				if #list > 0 and camera then
					-- only tubes near the player flicker (nobody sees the others anyway)
					local fixture = list[math.random(1, #list)]
					if fixture:IsA("BasePart") and (fixture.Position - camera.CFrame.Position).Magnitude < 90 then
						flickerOnce(fixture)
					end
				end
			end
		end
	end)
	SessionState.Observe("TimeLayer", applyLayer)
	applyLayer()

	local accumulator = 0
	RunService.RenderStepped:Connect(function(dt)
		local camera = workspace.CurrentCamera
		local part = rainPart
		if not camera or not part or not rain then
			return
		end
		if part.Parent ~= camera then
			part.Parent = camera
		end
		local storm = SessionState.Get("Weather") == "storm"
		local position = camera.CFrame.Position
		part.CFrame = CFrame.new(position + Vector3.new(0, 28, 0))
		accumulator += dt
		if accumulator >= 0.25 then
			accumulator = 0
			local indoors = storm and covered(position)
			rain.Rate = if storm and not indoors then 700 * GraphicsController.GetParticleScale() else 0
		end
		if storm and os.clock() >= nextLightning then
			nextLightning = os.clock() + math.random(9, 22)
			if not covered(position) then
				flashOnce(0.55, 0.35)
				task.delay(0.12, function()
					flashOnce(0.35, 0.5)
				end)
			end
		end
	end)
end

return AtmosphereController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9298">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[-- AudioController: every non-voice sound on the client.
--   * Sound groups (Ambience / SFX / Creature / UI) for clean mixing and ducking
--   * Ambience: wind outside, electric hum inside the building, generators (3D)
--   * Footsteps for every nearby character, by floor material (local, no network)
--   * Server-triggered 3D effects via the "Sfx" remote
-- Sounds play only when their id is set in Shared/Assets.luau; otherwise silently skipped.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared.Assets)
local Net = require(Shared.Net)

local AudioController = {}

local groups: { [string]: SoundGroup } = {}
local settings = nil
local scareFactor = 0.85
local duckFactor = 1
local inMenu = true
local tension: { [string]: Sound? } = {}
local tensionLevel = { music_menu = 0, tension_low = 0, tension_high = 0 }
local currentReverb: Enum.ReverbType? = nil

local BUILDING_MIN = Vector3.new(-100, -5, -85)
local BUILDING_MAX = Vector3.new(100, 20, 85)

local function insideBuilding(position: Vector3): boolean
	return position.X > BUILDING_MIN.X and position.X < BUILDING_MAX.X and position.Z > BUILDING_MIN.Z and position.Z < BUILDING_MAX.Z and position.Y < BUILDING_MAX.Y
end

local function group(name: string, volume: number): SoundGroup
	local g = Instance.new("SoundGroup")
	g.Name = "FZ_" .. name
	g.Volume = volume
	g.Parent = SoundService
	groups[name] = g
	return g
end

function AudioController.Id(name: string): string?
	local id = Assets.Sounds[name]
	if type(id) == "string" and id ~= "" then
		return id
	end
	return nil
end

-- Variants: "creature_growl" -> creature_growl_1 / _2 / _3 (only uploaded ones), never the
-- same one twice in a row, so repeated events do not sound repeated.
local lastVariant: { [string]: string } = {}
function AudioController.Variant(base: string): string
	local options = {}
	for i = 1, 9 do
		local name = base .. "_" .. i
		if AudioController.Id(name) and name ~= lastVariant[base] then
			table.insert(options, name)
		end
	end
	if #options == 0 then
		return lastVariant[base] or base
	end
	local choice = options[math.random(1, #options)]
	lastVariant[base] = choice
	return choice
end

-- Muffles a 3D sound when a wall is between the listener and the source.
local occlusionParams = RaycastParams.new()
occlusionParams.FilterType = Enum.RaycastFilterType.Exclude
local function occlude(sound: Sound, position: Vector3)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local filter: { Instance } = { camera }
	if Players.LocalPlayer.Character then
		table.insert(filter, Players.LocalPlayer.Character :: Instance)
	end
	occlusionParams.FilterDescendantsInstances = filter
	local origin = camera.CFrame.Position
	local hit = workspace:Raycast(origin, position - origin, occlusionParams)
	if hit and (hit.Position - position).Magnitude > 2 then
		local eq = Instance.new("EqualizerSoundEffect")
		eq.LowGain = 2
		eq.MidGain = -10
		eq.HighGain = -26
		eq.Parent = sound
		sound.Volume *= 0.75
	end
end

-- Plays a one-shot. `at` may be a Vector3, a BasePart/Attachment, or nil (2D).
-- muffle = true: sounds behind walls are low-passed (spatial credibility).
function AudioController.Play(name: string, at: any?, volume: number?, groupName: string?, muffle: boolean?): Sound?
	local id = AudioController.Id(name)
	if not id then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.8
	sound.SoundGroup = groups[groupName or "SFX"]
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 8
	sound.RollOffMaxDistance = 120
	if typeof(at) == "Vector3" then
		local attachment = Instance.new("Attachment")
		attachment.WorldPosition = at
		attachment.Parent = workspace.Terrain
		sound.Parent = attachment
		sound.Ended:Once(function()
			attachment:Destroy()
		end)
	elseif typeof(at) == "Instance" and (at:IsA("BasePart") or at:IsA("Attachment")) then
		sound.Parent = at
		sound.Ended:Once(function()
			sound:Destroy()
		end)
	else
		sound.Parent = SoundService
		sound.Ended:Once(function()
			sound:Destroy()
		end)
	end
	if muffle then
		local position = if typeof(at) == "Vector3" then at elseif typeof(at) == "Instance" and at:IsA("BasePart") then at.Position elseif typeof(at) == "Instance" and at:IsA("Attachment") then at.WorldPosition else nil
		if position then
			occlude(sound, position)
		end
	end
	sound:Play()
	return sound
end

function AudioController.PlayVariant(base: string, at: any?, volume: number?, groupName: string?, muffle: boolean?): Sound?
	return AudioController.Play(AudioController.Variant(base), at, volume, groupName, muffle)
end

function AudioController.Loop(name: string, parent: Instance, volume: number, groupName: string?): Sound?
	local id = AudioController.Id(name)
	if not id then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = "Loop_" .. name
	sound.SoundId = id
	sound.Looped = true
	sound.Volume = volume
	sound.SoundGroup = groups[groupName or "Ambience"]
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 6
	sound.RollOffMaxDistance = 70
	sound.Parent = parent
	sound:Play()
	return sound
end

local function setting(key: string): number
	local value = settings and settings.Get(key)
	return (if type(value) == "number" then value else 10) / 10
end

-- Applies the volume sliders (Settings -> Audio) to the sound groups.
function AudioController.ApplyVolumes()
	if not groups.SFX then
		return
	end
	local master = setting("volumeMaster")
	groups.SFX.Volume = master * setting("volumeEffects")
	groups.Creature.Volume = master * setting("volumeEffects") * scareFactor
	groups.Ambience.Volume = master * setting("volumeAmbience") * duckFactor
	groups.Music.Volume = master * setting("volumeMusic") * (0.6 + 0.4 * duckFactor)
	groups.UI.Volume = master * setting("volumeUI")
end

-- Scare intensity / medic set dampen creature sounds.
function AudioController.SetScareFactor(value: number)
	scareFactor = value
	AudioController.ApplyVolumes()
end

-- Lowers ambience and music while important voices/radio play.
local duckToken = 0
function AudioController.Duck(seconds: number)
	duckToken += 1
	local token = duckToken
	duckFactor = 0.45
	AudioController.ApplyVolumes()
	task.delay(seconds, function()
		if token == duckToken then
			duckFactor = 1
			AudioController.ApplyVolumes()
		end
	end)
end

function AudioController.SetMenu(value: boolean)
	inMenu = value
end

local function updateMusic(position: Vector3, elapsed: number)
	local targets = { music_menu = 0, tension_low = 0, tension_high = 0 }
	if inMenu then
		targets.music_menu = 0.6
	else
		local nearest, chasing = math.huge, false
		for _, model in CollectionService:GetTagged("FZ_CreatureRig") do
			local root = model:FindFirstChild("HumanoidRootPart")
			if root and root:IsA("BasePart") and model ~= Players.LocalPlayer.Character and not model:GetAttribute("Hidden") then
				local d = (root.Position - position).Magnitude
				if d < nearest then
					nearest = d
					chasing = model:GetAttribute("State") == "Chase" or model:GetAttribute("State") == "Attack"
				end
			end
		end
		if chasing and nearest < 90 then
			targets.tension_high, targets.tension_low = 0.8, 0.3
		elseif nearest < 45 then
			targets.tension_low = 0.75
		elseif nearest < math.huge then
			targets.tension_low = 0.25
		end
	end
	for name, target in targets do
		local sound = tension[name]
		if sound then
			-- fade in slowly, fade out a bit faster (silence is a tool)
			local speed = if target > tensionLevel[name] then 0.6 else 1.2
			tensionLevel[name] += (target - tensionLevel[name]) * math.min(1, elapsed * speed)
			sound.Volume = tensionLevel[name]
		end
	end
end

local function updateReverb(position: Vector3)
	local reverb
	if math.abs(position.X) < 22 and math.abs(position.Z) < 22 then
		reverb = Enum.ReverbType.ConcertHall -- the round core
	elseif insideBuilding(position) then
		reverb = Enum.ReverbType.Hallway
	else
		reverb = Enum.ReverbType.Forest
	end
	if reverb ~= currentReverb then
		currentReverb = reverb
		SoundService.AmbientReverb = reverb
	end
end


local function materialSound(material: Enum.Material): string
	if material == Enum.Material.Metal or material == Enum.Material.DiamondPlate or material == Enum.Material.CorrodedMetal then
		return "footstep_metal_" .. math.random(1, 2)
	elseif material == Enum.Material.Grass or material == Enum.Material.Ground or material == Enum.Material.Mud or material == Enum.Material.LeafyGrass then
		return "footstep_grass_" .. math.random(1, 2)
	end
	return "footstep_concrete_" .. math.random(1, 3)
end

function AudioController.Init(settingsController)
	settings = settingsController
	group("Ambience", 1)
	group("SFX", 1)
	group("Creature", 1)
	group("UI", 0.7)
	group("Music", 0.6)
	AudioController.ApplyVolumes()
	settingsController.Changed:Connect(function(key)
		if string.sub(key, 1, 6) == "volume" then
			AudioController.ApplyVolumes()
		end
	end)
	for name in tensionLevel do
		tension[name] = AudioController.Loop(name, SoundService, 0, "Music")
	end

	-- Ambient beds (2D), crossfaded by position
	local wind = AudioController.Loop("ambience_wind_loop", SoundService, 0)
	local hum = AudioController.Loop("hum_electric_loop", SoundService, 0)
	if wind then
		wind.RollOffMaxDistance = 10000
	end

	for _, source in CollectionService:GetTagged("FZ_AmbientSource") do
		local loopName = source:GetAttribute("SoundLoop")
		if type(loopName) == "string" then
			AudioController.Loop(loopName, source, 0.6)
		end
	end
	CollectionService:GetInstanceAddedSignal("FZ_AmbientSource"):Connect(function(source)
		local loopName = source:GetAttribute("SoundLoop")
		if type(loopName) == "string" then
			AudioController.Loop(loopName, source, 0.6)
		end
	end)

	Net.Event("Sfx").OnClientEvent:Connect(function(name, at, volume)
		if type(name) ~= "string" then
			return
		end
		local groupName = if string.sub(name, 1, 8) == "creature" then "Creature" else "SFX"
		AudioController.Play(name, at, if type(volume) == "number" then volume else nil, groupName)
	end)

	-- Footsteps + ambience mix, 10 Hz is enough
	local stepTimers: { [Model]: number } = {}
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		for model, timer in stepTimers do
			stepTimers[model] = timer - dt
		end
		if accumulator < 0.1 then
			return
		end
		local elapsed = accumulator
		accumulator = 0
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local inside = insideBuilding(camera.CFrame.Position)
		updateMusic(camera.CFrame.Position, elapsed)
		updateReverb(camera.CFrame.Position)
		if wind then
			wind.Volume += ((if inside then 0.12 else 0.55) - wind.Volume) * math.min(1, elapsed * 2)
		end
		if hum then
			hum.Volume += ((if inside then 0.35 else 0) - hum.Volume) * math.min(1, elapsed * 2)
		end
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if root and humanoid and not player:GetAttribute("FZ_MonsterMode") and (root.Position - camera.CFrame.Position).Magnitude < 60 then
				local velocity = root.AssemblyLinearVelocity
				local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
				if speed > 2 and humanoid.FloorMaterial ~= Enum.Material.Air then
					local remaining = stepTimers[character :: Model] or 0
					if remaining <= 0 then
						local interval = math.clamp(4.2 / speed, 0.26, 0.65)
						stepTimers[character :: Model] = interval
						AudioController.Play(materialSound(humanoid.FloorMaterial), root.Position - Vector3.new(0, 2.5, 0), if speed > 13 then 0.9 else 0.55)
					end
				end
			end
		end
		for model in stepTimers do
			if not model.Parent then
				stepTimers[model] = nil
			end
		end
	end)
end

function AudioController.UI(name: string)
	AudioController.Play(name, nil, 0.5, "UI")
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9299">
            <Properties>
              <string name="Name">CreatureVisualsController</string>
              <string name="Source"><![CDATA[-- CreatureVisualsController: everything the player SEES and HEARS of the creature.
--   * Procedural animation (Motor6D.Transform) for the built-in rig: long-limbed gait,
--     listening head tilt, telegraphed attack wind-up, covering its head when blinded
--   * "Signal dropouts": the pose freezes for a few frames now and then, with a crackle
--   * Breath loop on the head, random clicks, a close-range warning caption
--   * Vent travel: hidden locally while the server moves it
-- Rigs with Procedural = false (your own model with real animations) only get audio.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local AudioController = require(script.Parent.AudioController)

local CreatureVisualsController = {}

type RigState = {
	model: Model,
	motors: { [string]: Motor6D },
	phase: number,
	frozenUntil: number,
	nextFreeze: number,
	nextClick: number,
	breath: Sound?,
	lastHidden: boolean?,
	nextBreath: number,
	nextVoice: number,
	lastStep: number,
}

local rigs: { [Model]: RigState } = {}
local showCaption: ((line: { [string]: any }) -> ())? = nil
local lastWarning = 0

local function angles(x: number, y: number, z: number): CFrame
	return CFrame.Angles(x, y, z)
end

local function register(model: Instance)
	if not model:IsA("Model") or rigs[model] then
		return
	end
	local motors = {}
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("Motor6D") then
			motors[descendant.Name] = descendant
		end
	end
	local head = model:WaitForChild("Head", 5)
	local state: RigState = {
		model = model,
		motors = motors,
		phase = 0,
		frozenUntil = 0,
		nextFreeze = os.clock() + 2,
		nextClick = os.clock() + 3,
		-- legacy loop only when the new breath variants are not uploaded yet
		breath = if head and head:IsA("BasePart") and not AudioController.Id("creature_breath_deep_1") then AudioController.Loop("creature_breath", head, 0.45, "Creature") else nil,
		lastHidden = nil,
		nextBreath = os.clock() + 1,
		nextVoice = os.clock() + 4,
		lastStep = 0,
	}
	rigs[model] = state
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			rigs[model] = nil
		end
	end)
end

local function setHidden(state: RigState, hidden: boolean)
	if state.lastHidden == hidden then
		return
	end
	state.lastHidden = hidden
	for _, descendant in state.model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.LocalTransparencyModifier = if hidden then 1 else 0
		end
	end
	if state.breath then
		state.breath.Volume = if hidden then 0 else 0.45
	end
end

local function animate(state: RigState, dt: number)
	local model = state.model
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local m = state.motors
	local now = os.clock()
	local creatureState = model:GetAttribute("State") or "Patrol"
	setHidden(state, model:GetAttribute("Hidden") == true)

	-- Audio cues (distance-limited)
	local camera = workspace.CurrentCamera
	local distance = if camera then (root.Position - camera.CFrame.Position).Magnitude else math.huge
	if model == Players.LocalPlayer.Character then
		distance = math.huge -- you are the monster (admin test mode): no warnings for yourself
	end
	local head = model:FindFirstChild("Head")
	local source = if head and head:IsA("BasePart") then head else root
	if creatureState ~= "Dormant" and distance < 70 and not state.lastHidden then
		-- Irregular deep breathing: never on a fixed rhythm
		if now >= state.nextBreath then
			state.nextBreath = now + math.random(28, 55) / 10
			AudioController.PlayVariant("creature_breath_deep", source, 0.55, "Creature", true)
		end
		-- Body cracks, growl while listening / investigating, knocking while searching
		if now >= state.nextClick then
			state.nextClick = now + math.random(30, 70) / 10
			AudioController.PlayVariant("creature_crack", source, 0.5, "Creature", true)
		end
		if now >= state.nextVoice and (creatureState == "Listen" or creatureState == "Investigate" or creatureState == "Search") then
			state.nextVoice = now + math.random(50, 110) / 10
			if creatureState == "Search" and math.random() < 0.4 then
				AudioController.Play("creature_rhythm", source, 0.45, "Creature", true)
			else
				AudioController.PlayVariant("creature_growl", source, 0.55, "Creature", true)
			end
		end
		-- Dragging steps synced to its movement
		local velocity = root.AssemblyLinearVelocity
		local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		if speed > 2 and now - state.lastStep > math.clamp(5 / speed, 0.35, 1.1) then
			state.lastStep = now
			AudioController.PlayVariant("creature_drag", root.Position - Vector3.new(0, 4.5, 0), 0.5, "Creature", true)
		end
	end
	if distance < 16 and creatureState ~= "Dormant" and not state.lastHidden and now - lastWarning > 25 and showCaption then
		lastWarning = now
		showCaption({ text = "SFX_CREATURE_NEAR", channel = "world", duration = 2.5, critical = true })
	end

	if model:GetAttribute("Procedural") ~= true then
		return
	end

	-- Signal dropout: freeze the pose for a few frames
	if now >= state.nextFreeze then
		state.frozenUntil = now + math.random(6, 16) / 100
		state.nextFreeze = now + math.random(8, 26) / 10
		if distance < 35 and math.random() < 0.35 then
			AudioController.Play("creature_static_burst", root, 0.35, "Creature")
		end
	end
	if now < state.frozenUntil then
		return
	end

	local velocity = root.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local stride = math.clamp(speed / 12, 0, 1.2)
	state.phase += dt * (2 + speed * 0.45)
	local p = state.phase
	local swing = math.sin(p) * 0.7 * stride
	local breathe = math.sin(now * 1.7) * 0.04

	local hunch, neckX, neckZ = -0.15, 0.25, 0
	local armL, armR, elbow = 0.25 - swing * 0.6, 0.25 + swing * 0.6, -0.35
	if creatureState == "Listen" then
		hunch, neckX, neckZ = 0.05, 0.1, math.sin(now * 0.8) * 0.15 + 0.55
		armL, armR = 0.05, 0.05
	elseif creatureState == "Attack" then
		hunch, neckX = -0.35, 0.45
		armL, armR, elbow = -2.3, -2.1, -0.6
	elseif creatureState == "Blinded" then
		hunch, neckX = 0.25, -0.4
		armL, armR, elbow = -2.6, -2.6, -2.0
	elseif creatureState == "Chase" then
		hunch, neckX = -0.45, 0.55
	end

	local function set(name: string, cf: CFrame)
		local motor = m[name]
		if motor then
			motor.Transform = cf
		end
	end
	set("RootJoint", angles(hunch + breathe, 0, math.sin(p) * 0.06 * stride))
	set("Neck", angles(neckX, math.sin(now * 0.37) * 0.15, neckZ))
	set("LeftShoulder", angles(armL, 0, -0.08))
	set("RightShoulder", angles(armR, 0, 0.08))
	set("LeftElbow", angles(elbow - math.max(0, swing) * 0.4, 0, 0))
	set("RightElbow", angles(elbow - math.max(0, -swing) * 0.4, 0, 0))
	set("LeftHip", angles(swing, 0, 0))
	set("RightHip", angles(-swing, 0, 0))
	set("LeftKnee", angles(-math.max(0, math.sin(p + 0.9)) * 1.1 * stride, 0, 0))
	set("RightKnee", angles(-math.max(0, math.sin(p + 0.9 + math.pi)) * 1.1 * stride, 0, 0))
end

function CreatureVisualsController.Init(captionCallback: (line: { [string]: any }) -> ())
	showCaption = captionCallback
	CollectionService:GetInstanceAddedSignal("FZ_CreatureRig"):Connect(register)
	for _, model in CollectionService:GetTagged("FZ_CreatureRig") do
		task.spawn(register, model)
	end
	CollectionService:GetInstanceRemovedSignal("FZ_CreatureRig"):Connect(function(model)
		rigs[model :: Model] = nil
	end)
	-- Stepped runs before physics/animation, the documented place for Motor6D.Transform.
	RunService.Stepped:Connect(function(_, dt)
		for _, state in rigs do
			animate(state, dt)
		end
	end)
end

return CreatureVisualsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9300">
            <Properties>
              <string name="Name">DirectorController</string>
              <string name="Source"><![CDATA[-- DirectorController: performs the HorrorDirector's moments on THIS client only.
-- Respects the player's "Scare intensity": reduced = farther away, shorter, no stinger;
-- intense = closer, stinger sound. Nothing here flashes the screen or spikes volume.
--
--   apparition : a tall figure at the end of the hallway you look down - gone a moment later
--   footsteps  : steps right behind you (turn around: nothing)
--   flicker    : the lights in your room stutter for a second
--   cctv       : the security monitor shows your team 20 s in the future (+ a figure)
--   namecall   : a voice on the radio says your name - only you hear it

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local AudioController = require(script.Parent.AudioController)

local DirectorController = {}

local player = Players.LocalPlayer
local settings = nil
local showSubtitle: ((line: { [string]: any }) -> ())? = nil

local function intensity(): string
	return settings and settings.Get("scareIntensity") or "standard"
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

---------------------------------------------------------------------------
-- Figure (local only, never collides, never hurts)
---------------------------------------------------------------------------
local function buildFigure(): Model
	local model = Instance.new("Model")
	model.Name = "FZ_Apparition"
	local color = Color3.fromRGB(14, 12, 12)
	local function part(name: string, size: Vector3, cf: CFrame)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = Enum.Material.SmoothPlastic
		p.Anchored = true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.CastShadow = true
		p.Parent = model
		return p
	end
	local root = part("Torso", Vector3.new(1.3, 3.4, 0.7), CFrame.new(0, 6.3, 0))
	model.PrimaryPart = root
	part("Head", Vector3.new(1.2, 1.3, 1.5), CFrame.new(0, 8.6, -0.2))
	local horn = part("Horn", Vector3.new(0.4, 2, 2), CFrame.new(0, 8.6, -1.1) * CFrame.Angles(0, math.rad(90), 0))
	horn.Shape = Enum.PartType.Cylinder
	for _, s in { -1, 1 } do
		part("Arm", Vector3.new(0.3, 6.4, 0.3), CFrame.new(s * 0.9, 4.6, 0) * CFrame.Angles(0, 0, s * 0.06))
		part("Leg", Vector3.new(0.4, 4.8, 0.4), CFrame.new(s * 0.4, 2.4, 0))
	end
	return model
end

local function apparition()
	local camera = workspace.CurrentCamera
	local character = player.Character
	if not camera or not character then
		return
	end
	local level = intensity()
	local look = camera.CFrame.LookVector
	local flatLook = Vector3.new(look.X, 0, look.Z)
	if flatLook.Magnitude < 0.1 then
		return
	end
	flatLook = flatLook.Unit
	rayParams.FilterDescendantsInstances = { character, camera }
	local origin = camera.CFrame.Position
	local hit = workspace:Raycast(origin, flatLook * 90, rayParams)
	local distance = if hit then hit.Distance - 3 else 70
	local minimum = if level == "reduced" then 45 elseif level == "intense" then 22 else 30
	if distance < minimum then
		return -- not a long enough sightline right now: skip rather than force it
	end
	local floor = workspace:Raycast(origin + flatLook * distance, Vector3.new(0, -30, 0), rayParams)
	local base = if floor then floor.Position else (origin + flatLook * distance - Vector3.new(0, 4.5, 0))
	local figure = buildFigure()
	figure:PivotTo(CFrame.lookAt(base, base - flatLook))
	figure.Parent = camera
	if level == "intense" then
		AudioController.Play("stinger_low", nil, 0.5, "Creature")
	end
	AudioController.Play("creature_click", base + Vector3.new(0, 6, 0), 0.6, "Creature")
	local lifetime = if level == "reduced" then 1.2 elseif level == "intense" then 2.4 else 1.8
	local started = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function()
		local cam = workspace.CurrentCamera
		local tooClose = cam and (cam.CFrame.Position - base).Magnitude < 18
		if os.clock() - started > lifetime or tooClose then
			connection:Disconnect()
			-- gone in a single frame, like a signal dropout
			figure:Destroy()
		end
	end)
end

local function footsteps()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local count = if intensity() == "reduced" then 2 elseif intensity() == "intense" then 6 else 4
	for i = 1, count do
		task.delay(i * 0.42, function()
			local cam = workspace.CurrentCamera
			if cam then
				local behind = cam.CFrame.Position - Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z).Unit * 7 - Vector3.new(0, 4, 0)
				AudioController.Play("footstep_concrete_" .. ((i % 3) + 1), behind, 0.7)
			end
		end)
	end
end

local function flicker()
	local camera = workspace.CurrentCamera
	if not camera or (settings and settings.Get("reduceFlicker")) then
		return -- accessibility: no light flicker at all
	end
	local lights = {}
	for _, fixture in CollectionService:GetTagged("FZ_SectorLight") do
		if fixture:IsA("BasePart") and (fixture.Position - camera.CFrame.Position).Magnitude < 35 then
			for _, child in fixture:GetChildren() do
				if child:IsA("Light") and child.Enabled then
					table.insert(lights, child)
				end
			end
		end
	end
	if #lights == 0 then
		return
	end
	AudioController.Play("creature_static_burst", camera.CFrame.Position + camera.CFrame.LookVector * 6, 0.3, "Creature")
	local pattern = if intensity() == "reduced" then { 0.08, 0.25 } else { 0.06, 0.12, 0.05, 0.3, 0.08 }
	task.spawn(function()
		local on = false
		for _, wait in pattern do
			for _, light in lights do
				light.Enabled = on
			end
			on = not on
			task.wait(wait)
		end
		for _, light in lights do
			-- restore only if the light is still supposed to have power
			local fixture = light.Parent
			light.Enabled = fixture == nil or fixture:GetAttribute("Powered") ~= false
		end
	end)
end

-- Security monitor: a little scene of the team in a hallway, time-stamped 20 s ahead.
local function cctv(data: { [string]: any })
	local screen = CollectionService:GetTagged("FZ_CctvScreen")[1]
	if not screen or not screen:IsA("BasePart") then
		return
	end
	local old = screen:FindFirstChild("FZ_Feed")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "FZ_Feed"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 120
	gui.AutoLocalize = false
	gui.LightInfluence = 0
	gui.Parent = screen
	local viewport = Instance.new("ViewportFrame")
	viewport.Size = UDim2.fromScale(1, 1)
	viewport.BackgroundColor3 = Color3.fromRGB(6, 12, 8)
	viewport.Ambient = Color3.fromRGB(110, 140, 120)
	viewport.LightColor = Color3.fromRGB(170, 220, 180)
	viewport.Parent = gui
	local world = Instance.new("WorldModel")
	world.Parent = viewport
	-- corridor
	local function slab(size: Vector3, cf: CFrame, color: Color3)
		local p = Instance.new("Part")
		p.Anchored = true
		p.Size = size
		p.CFrame = cf
		p.Color = color
		p.Material = Enum.Material.Concrete
		p.Parent = world
	end
	slab(Vector3.new(14, 1, 60), CFrame.new(0, -0.5, -20), Color3.fromRGB(60, 62, 58))
	slab(Vector3.new(1, 14, 60), CFrame.new(-7, 7, -20), Color3.fromRGB(80, 82, 78))
	slab(Vector3.new(1, 14, 60), CFrame.new(7, 7, -20), Color3.fromRGB(80, 82, 78))
	-- the team (copies of the real characters, walking away from the camera)
	local index = 0
	for _, member in Players:GetPlayers() do
		local character = member.Character
		if character and member:GetAttribute("FZ_InGame") then
			local archivable = character.Archivable
			character.Archivable = true
			local copy = character:Clone()
			character.Archivable = archivable
			if copy then
				for _, d in copy:GetDescendants() do
					if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") or d:IsA("Light") then
						d:Destroy()
					elseif d:IsA("BasePart") then
						d.Anchored = true
					end
				end
				copy:PivotTo(CFrame.new((index % 2) * 3 - 1.5, 3, -18 - index * 4) * CFrame.Angles(0, math.rad(180), 0))
				copy.Parent = world
				index += 1
			end
		end
	end
	if data.withFigure then
		local figure = buildFigure()
		figure:PivotTo(CFrame.new(0, 0, -18 - index * 4 - 6))
		figure.Parent = world
	end
	local camera = Instance.new("Camera")
	camera.FieldOfView = 60
	camera.CFrame = CFrame.lookAt(Vector3.new(4.5, 11, 8), Vector3.new(0, 3, -22))
	camera.Parent = viewport
	viewport.CurrentCamera = camera
	local stamp = Instance.new("TextLabel")
	stamp.BackgroundTransparency = 1
	stamp.Size = UDim2.new(1, -8, 0, 16)
	stamp.Position = UDim2.fromOffset(4, 2)
	stamp.Font = Enum.Font.RobotoMono
	stamp.TextScaled = true
	stamp.TextXAlignment = Enum.TextXAlignment.Left
	stamp.TextColor3 = Color3.fromRGB(230, 236, 230)
	stamp.AutoLocalize = false
	stamp.Text = Localization.T("CCTV_STAMP", { seconds = data.offset or 20 })
	stamp.Parent = viewport
	-- static fade-out after a few seconds
	task.delay(if intensity() == "reduced" then 6 else 9, function()
		if gui.Parent then
			TweenService:Create(viewport, TweenInfo.new(0.6), { ImageTransparency = 1, BackgroundTransparency = 1 }):Play()
			task.wait(0.7)
			gui:Destroy()
		end
	end)
end

local function namecall(data: { [string]: any })
	if showSubtitle then
		showSubtitle({
			speaker = "SPEAKER_UNKNOWN",
			text = if data.answered then "RADIO_NAMECALL_ANSWERED" else "RADIO_NAMECALL",
			params = { name = tostring(data.name or player.DisplayName) },
			channel = "radio",
			duration = 3.5,
		})
	end
	AudioController.Play("radio_squelch_on", nil, 0.5)
end

-- Live creature location on the second monitor while the cameras have power.
local function bindCctvText()
	local function refresh()
		for _, screen in CollectionService:GetTagged("FZ_CctvText") do
			if screen:IsA("BasePart") then
				local gui = screen:FindFirstChild("FZ_CctvGui") :: SurfaceGui?
				if not gui then
					local g = Instance.new("SurfaceGui")
					g.Name = "FZ_CctvGui"
					g.Face = Enum.NormalId.Front
					g.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
					g.PixelsPerStud = 120
					g.AutoLocalize = false
					g.LightInfluence = 0
					local label = Instance.new("TextLabel")
					label.Name = "Text"
					label.BackgroundTransparency = 1
					label.Size = UDim2.fromScale(1, 1)
					label.Font = Enum.Font.RobotoMono
					label.TextScaled = true
					label.TextColor3 = Color3.fromRGB(10, 40, 20)
					label.AutoLocalize = false
					label.Parent = g
					g.Parent = screen
					gui = g
				end
				local label = (gui :: SurfaceGui):FindFirstChild("Text") :: TextLabel
				local area = SessionState.Get("CctvArea")
				if SessionState.Get("Cameras") and area == "-" then
					label.Text = Localization.T("CCTV_NONE")
				elseif SessionState.Get("Cameras") and type(area) == "string" then
					local areaKey = if area == "?" then "AREA_UNKNOWN" else "AREA_" .. area
					label.Text = Localization.T("CCTV_AREA", { area = Localization.T(areaKey) })
				else
					label.Text = Localization.T("CCTV_OFFLINE")
				end
			end
		end
	end
	SessionState.Observe("Cameras", refresh)
	SessionState.Observe("CctvArea", refresh)
	Localization.Changed:Connect(refresh)
	CollectionService:GetInstanceAddedSignal("FZ_CctvText"):Connect(refresh)
end

---------------------------------------------------------------------------
-- 0.5 events (pool shared by all modes)
---------------------------------------------------------------------------
local function cameraPosition(): Vector3?
	local camera = workspace.CurrentCamera
	return camera and camera.CFrame.Position
end

local function nearestTagged(tagName: string, maxDistance: number): BasePart?
	local origin = cameraPosition()
	if not origin then
		return nil
	end
	local best, bestDistance = nil, maxDistance
	for _, instance in CollectionService:GetTagged(tagName) do
		if instance:IsA("BasePart") then
			local d = (instance.Position - origin).Magnitude
			if d < bestDistance then
				best, bestDistance = instance, d
			end
		end
	end
	return best
end

-- A figure stands behind the glass for a moment. Taps once. Gone when you look again.
local function window()
	local glass = nearestTagged("FZ_Window", 40)
	local origin = cameraPosition()
	if not glass or not origin then
		return
	end
	local toGlass = glass.Position - origin
	local away = Vector3.new(toGlass.X, 0, toGlass.Z)
	if away.Magnitude < 1 then
		return
	end
	away = away.Unit
	local base = Vector3.new(glass.Position.X, glass.Position.Y - glass.Size.Y / 2 - 3.5, glass.Position.Z) + away * 2.5
	local figure = buildFigure()
	figure:PivotTo(CFrame.lookAt(base, base - away))
	figure.Parent = workspace.CurrentCamera
	AudioController.Play("glass_tap", glass.Position, 0.45, "Creature")
	local started = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function()
		local camera = workspace.CurrentCamera
		local looking = camera and camera.CFrame.LookVector:Dot((base - camera.CFrame.Position).Unit) > 0.92
		if os.clock() - started > (if intensity() == "reduced" then 1.2 else 2.6) or (looking and os.clock() - started > 0.7) then
			connection:Disconnect()
			figure:Destroy()
		end
	end)
end

-- Someone stands in the room ahead (a room that was empty a second ago).
local function occupant()
	apparition()
end

local SPEAKER_LINES = { "SPK_LINE_1", "SPK_LINE_2", "SPK_LINE_3", "SPK_LINE_4" }
local function speaker()
	local box = nearestTagged("FZ_Speaker", 45)
	if not box then
		return
	end
	AudioController.Play("radio_squelch_on", box, 0.4, "SFX")
	AudioController.PlayVariant("speaker_voice", box, 0.6, "SFX")
	if showSubtitle then
		showSubtitle({ speaker = "SPEAKER_PA", text = SPEAKER_LINES[math.random(1, #SPEAKER_LINES)], channel = "radio", duration = 3.5 })
	end
end

-- The light in the neighbouring room switches on - nobody is there.
local function neighborLight()
	local origin = cameraPosition()
	if not origin then
		return
	end
	local candidates = {}
	for _, fixture in CollectionService:GetTagged("FZ_SectorLight") do
		if fixture:IsA("BasePart") then
			local d = (fixture.Position - origin).Magnitude
			if d > 18 and d < 48 then
				table.insert(candidates, fixture)
			end
		end
	end
	if #candidates == 0 then
		return
	end
	local fixture = candidates[math.random(1, #candidates)]
	local lights = {}
	for _, child in fixture:GetChildren() do
		if child:IsA("Light") then
			table.insert(lights, { light = child, enabled = child.Enabled, brightness = child.Brightness })
			child.Enabled = true
			child.Brightness *= 1.6
		end
	end
	AudioController.Play("light_click", fixture.Position, 0.5, "SFX", true)
	task.delay(if intensity() == "reduced" then 3 else 6, function()
		AudioController.Play("light_click", fixture.Position, 0.4, "SFX", true)
		for _, entry in lights do
			entry.light.Brightness = entry.brightness
			entry.light.Enabled = fixture:GetAttribute("Powered") ~= false and entry.enabled
		end
	end)
end

-- A shadow slides along the wall - against the direction the light would throw it.
local function shadow()
	local camera = workspace.CurrentCamera
	local character = player.Character
	if not camera or not character then
		return
	end
	rayParams.FilterDescendantsInstances = { character, camera }
	local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
	if look.Magnitude < 0.1 then
		return
	end
	local hit = workspace:Raycast(camera.CFrame.Position, look.Unit * 30, rayParams)
	if not hit or hit.Distance < 6 then
		return
	end
	local normal = hit.Normal
	local side = normal:Cross(Vector3.yAxis).Unit
	local base = hit.Position + normal * 0.08
	local plate = Instance.new("Part")
	plate.Anchored = true
	plate.CanCollide = false
	plate.CanQuery = false
	plate.CanTouch = false
	plate.CastShadow = false
	plate.Material = Enum.Material.SmoothPlastic
	plate.Color = Color3.new(0, 0, 0)
	plate.Transparency = if intensity() == "reduced" then 0.65 else 0.45
	plate.Size = Vector3.new(1.6, 7.5, 0.05)
	plate.CFrame = CFrame.lookAt(base - side * 4, base - side * 4 + normal)
	plate.Parent = camera
	local tween = TweenService:Create(plate, TweenInfo.new(1.3, Enum.EasingStyle.Sine), { CFrame = CFrame.lookAt(base + side * 4, base + side * 4 + normal), Transparency = 1 })
	tween.Completed:Once(function()
		plate:Destroy()
	end)
	tween:Play()
end

-- Find a wall next to the player and return a point just behind it.
local function behindWall(): Vector3?
	local camera = workspace.CurrentCamera
	local character = player.Character
	if not camera or not character then
		return nil
	end
	rayParams.FilterDescendantsInstances = { character, camera }
	local origin = camera.CFrame.Position
	local directions = { -camera.CFrame.RightVector, camera.CFrame.RightVector, -camera.CFrame.LookVector }
	for i = #directions, 2, -1 do
		local j = math.random(1, i)
		directions[i], directions[j] = directions[j], directions[i]
	end
	for _, direction in directions do
		local flat = Vector3.new(direction.X, 0, direction.Z)
		if flat.Magnitude > 0.1 then
			local hit = workspace:Raycast(origin, flat.Unit * 14, rayParams)
			if hit then
				return hit.Position + flat.Unit * 5
			end
		end
	end
	return nil
end

-- Acoustic deception: the creature seems to move behind the wall. It is not there.
local function phantom()
	local position = behindWall()
	if not position then
		return
	end
	local roll = math.random()
	if roll < 0.35 then
		AudioController.PlayVariant("creature_breath_deep", position, 0.4, "Creature", true)
	elseif roll < 0.6 then
		AudioController.PlayVariant("creature_growl", position, 0.35, "Creature", true)
	elseif roll < 0.8 then
		for i = 0, 2 do
			task.delay(i * 0.7, function()
				AudioController.PlayVariant("creature_drag", position + Vector3.new(i * 2, 0, 0), 0.4, "Creature", true)
			end)
		end
	else
		AudioController.PlayVariant("creature_crack", position, 0.45, "Creature", true)
	end
end

-- Something comes closer down the corridor... and stops.
local function approach()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local behind = -Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z).Unit
	local start = camera.CFrame.Position + behind * 45
	local sound = AudioController.Play("approach_corridor", start, 0.6, "Creature", true)
	if sound and sound.Parent and sound.Parent:IsA("Attachment") then
		local attachment = sound.Parent :: Attachment
		TweenService:Create(attachment, TweenInfo.new(6, Enum.EasingStyle.Linear), { WorldPosition = camera.CFrame.Position + behind * 8 }):Play()
	end
end

local function voices()
	local position = behindWall()
	if position then
		AudioController.PlayVariant("voices_muffled", position, 0.5, "SFX", true)
	end
end

-- Very rare: an object that only you can see - a radio in YOUR colours, hissing.
local function object()
	local camera = workspace.CurrentCamera
	local character = player.Character
	if not camera or not character then
		return
	end
	rayParams.FilterDescendantsInstances = { character, camera }
	local look = Vector3.new(camera.CFrame.LookVector.X, 0, camera.CFrame.LookVector.Z)
	if look.Magnitude < 0.1 then
		return
	end
	local spot = camera.CFrame.Position + look.Unit * 11
	local floor = workspace:Raycast(spot, Vector3.new(0, -20, 0), rayParams)
	if not floor then
		return
	end
	local radio = Instance.new("Part")
	radio.Anchored = true
	radio.CanCollide = false
	radio.CanQuery = false
	radio.Size = Vector3.new(0.75, 1.7, 0.42)
	local color = player:GetAttribute("FZ_RadioColor")
	radio.Color = if typeof(color) == "Color3" then color else Color3.fromRGB(46, 48, 50)
	radio.CFrame = CFrame.new(floor.Position + Vector3.new(0, 0.85, 0)) * CFrame.Angles(0, math.random() * 6, 0.2)
	radio.Parent = camera
	local led = Instance.new("PointLight")
	led.Color = Color3.fromRGB(255, 40, 30)
	led.Range = 4
	led.Brightness = 1
	led.Parent = radio
	AudioController.Play("radio_static_loop", radio, 0.25, "SFX")
	local started = os.clock()
	local connection
	connection = RunService.Heartbeat:Connect(function()
		local cam = workspace.CurrentCamera
		local close = cam and (cam.CFrame.Position - radio.Position).Magnitude < 6
		local lookingAway = cam and cam.CFrame.LookVector:Dot((radio.Position - cam.CFrame.Position).Unit) < 0.2
		if close or (lookingAway and os.clock() - started > 2) or os.clock() - started > 20 then
			connection:Disconnect()
			radio:Destroy()
		end
	end)
end

function DirectorController.Init(settingsController, captionCallback: (line: { [string]: any }) -> ())
	settings = settingsController
	showSubtitle = captionCallback
	Net.Event("Scare").OnClientEvent:Connect(function(kind: any, data: any)
		if type(kind) ~= "string" then
			return
		end
		data = if type(data) == "table" then data else {}
		if kind == "apparition" then
			apparition()
		elseif kind == "footsteps" then
			footsteps()
		elseif kind == "flicker" then
			flicker()
		elseif kind == "cctv" then
			cctv(data)
		elseif kind == "namecall" then
			namecall(data)
		elseif kind == "window" then
			window()
		elseif kind == "occupant" then
			occupant()
		elseif kind == "speaker" then
			speaker()
		elseif kind == "neighborlight" then
			neighborLight()
		elseif kind == "shadow" then
			shadow()
		elseif kind == "phantom" then
			phantom()
		elseif kind == "approach" then
			approach()
		elseif kind == "voices" then
			voices()
		elseif kind == "object" then
			object()
		end
	end)
	bindCctvText()
end

return DirectorController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9301">
            <Properties>
              <string name="Name">EquipmentController</string>
              <string name="Source"><![CDATA[-- EquipmentController: client side of shop equipment.
--   Observer set: night vision (N / D-pad up / touch "Night") with a 30 s battery that
--   recharges, and fresh creature tracks (sent by the server only to observers).

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local InputController = require(script.Parent.InputController)

local EquipmentController = {}

local player = Players.LocalPlayer
local BATTERY_SECONDS = 30
local battery = BATTERY_SECONDS
local active = false
local effect: ColorCorrectionEffect? = nil
local loop: RBXScriptConnection? = nil

local function setNightVision(on: boolean)
	if on and (not player:GetAttribute("FZ_NightVision") or battery < 2) then
		return
	end
	active = on
	InputController.SetTouchActive("NightVision", on)
	if not effect then
		local e = Instance.new("ColorCorrectionEffect")
		e.Name = "FZ_NightVision"
		e.Enabled = false
		e.Parent = Lighting
		effect = e
	end
	local e = effect :: ColorCorrectionEffect
	e.Enabled = true
	TweenService:Create(e, TweenInfo.new(0.25), {
		Brightness = if on then 0.32 else 0,
		Contrast = if on then 0.25 else 0,
		Saturation = if on then -0.9 else 0,
		TintColor = if on then Color3.fromRGB(150, 255, 170) else Color3.new(1, 1, 1),
	}):Play()
	if not loop then
		loop = RunService.Heartbeat:Connect(function(dt)
			if active then
				battery -= dt
				if battery <= 0 then
					battery = 0
					setNightVision(false)
				end
			else
				battery = math.min(BATTERY_SECONDS, battery + dt * 0.5)
				if battery >= BATTERY_SECONDS and loop then
					loop:Disconnect()
					loop = nil
				end
			end
		end)
	end
end

local function footprint(position: Vector3)
	if typeof(position) ~= "Vector3" then
		return
	end
	local mark = Instance.new("Part")
	mark.Name = "FZ_Track"
	mark.Anchored = true
	mark.CanCollide = false
	mark.CanQuery = false
	mark.CanTouch = false
	mark.CastShadow = false
	mark.Size = Vector3.new(1.2, 0.05, 2.2)
	mark.CFrame = CFrame.new(position) * CFrame.Angles(0, math.random() * math.pi, 0)
	mark.Material = Enum.Material.Neon
	mark.Color = Color3.fromRGB(150, 30, 26)
	mark.Transparency = 0.35
	mark.Parent = workspace.CurrentCamera
	local fade = TweenService:Create(mark, TweenInfo.new(18, Enum.EasingStyle.Linear), { Transparency = 1 })
	fade.Completed:Once(function()
		mark:Destroy()
	end)
	fade:Play()
end

function EquipmentController.SetActive(gameplay: boolean)
	if not gameplay and active then
		setNightVision(false)
	end
end

function EquipmentController.Init()
	local function refresh()
		local owned = player:GetAttribute("FZ_NightVision") == true
		InputController.SetTouchVisible("NightVision", owned)
		if not owned and active then
			setNightVision(false)
		end
	end
	player:GetAttributeChangedSignal("FZ_NightVision"):Connect(refresh)
	refresh()
	InputController.Action:Connect(function(name, pressed)
		if name == "NightVision" and pressed then
			setNightVision(not active)
		end
	end)
	Net.Event("Footprint").OnClientEvent:Connect(footprint)
end

return EquipmentController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9302">
            <Properties>
              <string name="Name">FlashlightController</string>
              <string name="Source"><![CDATA[-- FlashlightController: precise camera-aligned light for the local player, plus the
-- replicated head light (FlashlightService) so teammates see it too. The local player's
-- own replicated copy is muted locally to avoid a double light.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local InputController = require(script.Parent.InputController)

local FlashlightController = {}

local player = Players.LocalPlayer
local enabled = false
local lightPart: Part? = nil
local follow: RBXScriptConnection? = nil
local setRemote = Net.Event("SetFlashlight")

local OFFSET = CFrame.new(0.6, -0.5, -0.4)
local BLIND_RANGE = 26 -- matches Config.Creature.BlindRange; the server re-validates
local nextBlindCheck = 0
local blindRay = RaycastParams.new()
blindRay.FilterType = Enum.RaycastFilterType.Exclude

-- While the light is on, report when the beam hits a creature's head (4 Hz).
local function checkBlind(camera: Camera)
	local now = os.clock()
	if now < nextBlindCheck then
		return
	end
	nextBlindCheck = now + 0.25
	local range = BLIND_RANGE * (tonumber(player:GetAttribute("FZ_FlashRange")) or 1)
	for _, model in CollectionService:GetTagged("FZ_CreatureRig") do
		local head = model:FindFirstChild("Head")
		if head and head:IsA("BasePart") and model ~= player.Character and not model:GetAttribute("Hidden") then
			local offset = head.Position - camera.CFrame.Position
			if offset.Magnitude < range and camera.CFrame.LookVector:Dot(offset.Unit) > math.cos(math.rad(14)) then
				blindRay.FilterDescendantsInstances = { player.Character :: Instance, camera }
				local hit = workspace:Raycast(camera.CFrame.Position, offset, blindRay)
				if hit and hit.Instance:IsDescendantOf(model) then
					Net.Event("FlashCreature"):FireServer()
				end
			end
		end
	end
end

local function ensurePart(): Part
	if lightPart and lightPart.Parent then
		return lightPart
	end
	local part = Instance.new("Part")
	part.Name = "FZ_LocalFlashlight"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	local light = Instance.new("SpotLight")
	light.Name = "Light"
	light.Face = Enum.NormalId.Front
	light.Angle = 50
	light.Range = 40
	light.Brightness = 2.4
	light.Color = Color3.fromRGB(255, 236, 206)
	light.Shadows = true
	light.Parent = part
	part.Parent = workspace.CurrentCamera
	lightPart = part
	return part
end

local function muteOwnReplicatedLight(character: Model)
	local head = character:WaitForChild("Head", 10)
	if not head then
		return
	end
	local function mute(child: Instance)
		if child.Name == "FZ_Flashlight" and child:IsA("SpotLight") then
			child.Brightness = 0 -- local only; the server never changes Brightness
		end
	end
	for _, child in head:GetChildren() do
		mute(child)
	end
	head.ChildAdded:Connect(mute)
end

function FlashlightController.Set(value: boolean)
	enabled = value
	local part = ensurePart()
	local light = part:FindFirstChild("Light") :: SpotLight
	light.Enabled = value
	light.Range = 40 * (tonumber(player:GetAttribute("FZ_FlashRange")) or 1)
	local color = player:GetAttribute("FZ_FlashColor")
	if typeof(color) == "Color3" then
		light.Color = color
	end
	if value and not follow then
		follow = RunService.RenderStepped:Connect(function()
			local camera = workspace.CurrentCamera
			if camera then
				part.CFrame = camera.CFrame * OFFSET
				checkBlind(camera)
			end
		end)
	elseif not value and follow then
		follow:Disconnect()
		follow = nil
	end
	InputController.SetTouchActive("Flashlight", value)
	setRemote:FireServer(value)
end

function FlashlightController.IsOn(): boolean
	return enabled
end

function FlashlightController.Init()
	InputController.Action:Connect(function(name, pressed)
		if name == "Flashlight" and pressed then
			if player:GetAttribute("FZ_MonsterMode") then
				Net.Event("MonsterAttack"):FireServer() -- admin test: F / RB attacks as the creature
				return
			end
			FlashlightController.Set(not enabled)
		end
	end)
	player.CharacterAdded:Connect(function(character)
		muteOwnReplicatedLight(character)
		if enabled then
			setRemote:FireServer(true) -- new character, re-sync state
		end
	end)
	if player.Character then
		task.spawn(muteOwnReplicatedLight, player.Character)
	end
end

return FlashlightController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9303">
            <Properties>
              <string name="Name">GraphicsController</string>
              <string name="Source"><![CDATA[-- GraphicsController: quality profiles for the parts an experience may control itself.
-- Roblox's own graphics quality slider is respected and never overridden.
--
-- Invariants on EVERY profile (fairness + atmosphere):
--   * Atmosphere/fog is identical, so creatures are never easier/harder to see.
--   * Lights tagged "FZ_KeyLight" (gameplay-relevant lighting) are always on.
--   * Only decoration scales: post effects, lights tagged "FZ_DecorLight",
--     and the particle multiplier other systems read via GetParticleScale().

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")

local GraphicsController = {}

local PROFILES = {
	low = { bloom = false, decorLights = false, particles = 0.35, grade = 0.8, depth = false },
	medium = { bloom = true, decorLights = true, particles = 0.65, grade = 1, depth = false },
	high = { bloom = true, decorLights = true, particles = 1, grade = 1, depth = true },
	ultra = { bloom = true, decorLights = true, particles = 1.4, grade = 1, depth = true },
}

local current = "high"
local resolvedProfile = PROFILES.high
local brightness = 5
local grade: ColorCorrectionEffect? = nil
local bloom: BloomEffect? = nil
local depth: DepthOfFieldEffect? = nil
local decorConnection: RBXScriptConnection? = nil

local function ensureEffects()
	-- Created on the client: these effects exist only for this player.
	if not grade then
		local effect = Instance.new("ColorCorrectionEffect")
		effect.Name = "FZ_Grade"
		effect.Parent = Lighting
		grade = effect
	end
	if not bloom then
		local effect = Instance.new("BloomEffect")
		effect.Name = "FZ_Bloom"
		effect.Intensity = 0.7
		effect.Size = 28
		effect.Threshold = 1.15 -- neon screens, lamps and the core glow softly; walls do not
		effect.Parent = Lighting
		bloom = effect
	end
	if not depth then
		-- very gentle: the far distance softens, everything you can interact with stays sharp
		local effect = Instance.new("DepthOfFieldEffect")
		effect.Name = "FZ_Depth"
		effect.FarIntensity = 0.12
		effect.FocusDistance = 40
		effect.InFocusRadius = 60
		effect.NearIntensity = 0
		effect.Parent = Lighting
		depth = effect
	end
end

local ORDER = { "low", "medium", "high" }
local autoLevel: string? = nil

local function resolve(name: string): string
	if name ~= "auto" then
		return name
	end
	if autoLevel then
		return autoLevel
	end
	-- Conservative start: phones/tablets at medium, everything else at high. The measured
	-- frame rate then adjusts it (see startAutoTuning).
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "medium"
	end
	return "high"
end

local watched: { [Instance]: boolean } = {}

local function applyDecor(fixture: Instance)
	-- A fixture without power stays off no matter which profile is selected.
	local on = resolvedProfile.decorLights and fixture:GetAttribute("Powered") ~= false
	for _, descendant in fixture:GetDescendants() do
		if descendant:IsA("Light") then
			descendant.Enabled = on
		end
	end
	if not watched[fixture] then
		watched[fixture] = true
		fixture:GetAttributeChangedSignal("Powered"):Connect(function()
			applyDecor(fixture)
		end)
		fixture.Destroying:Connect(function()
			watched[fixture] = nil
		end)
	end
end

local function apply()
	ensureEffects()
	resolvedProfile = PROFILES[resolve(current)] or PROFILES.high
	local g = grade :: ColorCorrectionEffect
	-- Base grade: slightly desaturated, cool shadows. Brightness setting 0..10 (5 = neutral).
	g.Saturation = -0.1 * resolvedProfile.grade
	g.Contrast = 0.14 * resolvedProfile.grade
	g.TintColor = Color3.fromRGB(228, 238, 248)
	g.Brightness = 0.02 + (brightness - 5) * 0.03
	;(depth :: DepthOfFieldEffect).Enabled = resolvedProfile.depth
	;(bloom :: BloomEffect).Enabled = resolvedProfile.bloom
	for _, light in CollectionService:GetTagged("FZ_DecorLight") do
		applyDecor(light)
	end
	if not decorConnection then
		decorConnection = CollectionService:GetInstanceAddedSignal("FZ_DecorLight"):Connect(applyDecor)
	end
end

-- "Automatic": measured FPS steps the profile down (< 28 fps for 10 s) or up
-- (> 55 fps for 30 s), never above "high". Roblox's own quality slider stays untouched.
local function startAutoTuning(settings)
	local RunService = game:GetService("RunService")
	local frames, elapsed, goodFor = 0, 0, 0
	RunService.Heartbeat:Connect(function(dt)
		if settings.Get("graphics") ~= "auto" then
			return
		end
		frames += 1
		elapsed += dt
		if elapsed < 10 then
			return
		end
		local fps = frames / elapsed
		frames, elapsed = 0, 0
		local level = table.find(ORDER, resolve("auto")) or 2
		if fps < 28 and level > 1 then
			autoLevel = ORDER[level - 1]
			goodFor = 0
			apply()
		elseif fps > 55 then
			goodFor += 10
			if goodFor >= 30 and level < #ORDER then
				autoLevel = ORDER[level + 1]
				goodFor = 0
				apply()
			end
		else
			goodFor = 0
		end
	end)
end

function GraphicsController.Init(settings)
	startAutoTuning(settings)
	current = settings.Get("graphics") or "auto"
	brightness = settings.Get("brightness") or 5
	apply()
	settings.Changed:Connect(function(key, value)
		if key == "graphics" then
			current = value
			apply()
		elseif key == "brightness" then
			brightness = value
			apply()
		end
	end)
end

function GraphicsController.GetParticleScale(): number
	return resolvedProfile.particles
end

function GraphicsController.GetProfileName(): string
	return resolve(current)
end

function GraphicsController.GetRobloxQualityLevel(): number
	local ok, level = pcall(function()
		return UserSettings().GameSettings.SavedQualityLevel.Value
	end)
	return if ok then level else -1
end

return GraphicsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9304">
            <Properties>
              <string name="Name">HealthController</string>
              <string name="Source"><![CDATA[-- HealthController: health HUD (only visible when hurt), damage vignette, downed overlay.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local Components = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)

local HealthController = {}

local player = Players.LocalPlayer

function HealthController.Init(hudGui: ScreenGui, settings)
	-- Damage flash: a red screen edge (UIStroke), no texture asset required.
	local edge = Instance.new("Frame")
	edge.Name = "DamageEdge"
	edge.BackgroundTransparency = 1
	edge.Size = UDim2.fromScale(1, 1)
	edge.Parent = hudGui
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Colors.Accent
	stroke.Thickness = 28
	stroke.Transparency = 1
	stroke.Parent = edge
	local gradient = Instance.new("UIGradient")
	gradient.Transparency = NumberSequence.new(0.2)
	gradient.Parent = stroke

	local bar = Instance.new("Frame")
	bar.Name = "Health"
	bar.AnchorPoint = Vector2.new(0, 1)
	bar.Position = UDim2.new(0, 24, 1, -16)
	bar.Size = UDim2.fromOffset(180, 4)
	bar.BackgroundColor3 = Theme.Colors.TextFaint
	bar.BackgroundTransparency = 0.4
	bar.BorderSizePixel = 0
	bar.Visible = false
	bar.Parent = hudGui
	local fill = Instance.new("Frame")
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = Theme.Colors.TextBright
	fill.Size = UDim2.fromScale(1, 1)
	Components.Corner(fill, 2)
	Components.Corner(bar, 2)
	fill.Parent = bar

	local downed = Components.Text({ Key = "HUD_DOWNED", Font = Theme.Fonts.Medium, TextSize = Theme.Sizes.TextHeading, Color = Theme.Colors.TextBright, XAlign = Enum.TextXAlignment.Center, Size = UDim2.new(0.8, 0, 0, 40), Position = UDim2.fromScale(0.5, 0.42), AnchorPoint = Vector2.new(0.5, 0.5), Parent = hudGui })
	downed.TextStrokeTransparency = 0.4
	downed.Visible = false

	local function cameraScale(): number
		local value = settings.Get("cameraEffects")
		return if value == "off" then 0 elseif value == "reduced" then 0.5 else 1
	end

	local function bindHumanoid(character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid or not humanoid:IsA("Humanoid") then
			return
		end
		local function update()
			local ratio = math.clamp(humanoid.Health / math.max(1, humanoid.MaxHealth), 0, 1)
			bar.Visible = (ratio < 0.999 or settings.Get("alwaysShowHealth") == true) and player:GetAttribute("FZ_InGame") == true and not player:GetAttribute("FZ_MonsterMode")
			fill.Size = UDim2.fromScale(ratio, 1)
			fill.BackgroundColor3 = if ratio < 0.35 then Theme.Colors.Accent else Theme.Colors.TextBright
		end
		humanoid.HealthChanged:Connect(update)
		settings.Changed:Connect(function(key)
			if key == "alwaysShowHealth" then
				update()
			end
		end)
		player:GetAttributeChangedSignal("FZ_InGame"):Connect(update)
		update()
	end
	player.CharacterAdded:Connect(bindHumanoid)
	if player.Character then
		task.spawn(bindHumanoid, player.Character)
	end

	Net.Event("Hurt").OnClientEvent:Connect(function()
		stroke.Transparency = 0.15
		TweenService:Create(stroke, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 1 }):Play()
		local camera = workspace.CurrentCamera
		local scale = cameraScale()
		if camera and scale > 0 then
			-- short, small kick (no strong shake)
			local original = camera.FieldOfView
			camera.FieldOfView = original - 3 * scale
			TweenService:Create(camera, TweenInfo.new(0.35), { FieldOfView = original }):Play()
		end
	end)

	-- (the downed countdown is shown by RescueController)
	downed:Destroy()
end

return HealthController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9305">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[-- InputController: one logical action layer for keyboard/mouse, gamepad and touch.
--
-- Primary path: Roblox Input Action System (InputContext / InputAction / InputBinding).
-- Fallback path: UserInputService, used automatically if the Input Action System cannot be
-- created on this client (or when Config FORCE_LEGACY is set for debugging).
--
-- Gameplay code only ever sees logical actions:
--   InputController.Action:Connect(function(name, pressed, device) ... end)
-- Interactions themselves use ProximityPrompts (E / X / tap) via InteractionService.
--
-- Default bindings
--   Sprint      LeftShift | L3 (left stick click) | touch "Run" (toggle)
--   Flashlight  F         | R1 / RB               | touch "Light"
--   Radio       R         | L1 / LB               | touch "Radio"   (push to talk)
--   Mic         M         | D-pad left            | touch "Mic"     (mute / unmute)
--   NightVision N         | D-pad up              | touch "Night"   (observer set only)
--   Pause       P         | View / Share (Select) | touch "II"
-- GuiService.AutoSelectGuiEnabled is turned off so the Select button is free for our
-- menu; the Router sets gamepad focus explicitly whenever a menu opens.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Signal)
local Localization = require(Shared.Localization)

local Theme = require(script.Parent.Parent.UI.Theme)

local FORCE_LEGACY = false

export type Device = "keyboard" | "gamepad" | "touch"

local InputController = {}
InputController.Action = Signal.new() -- (name: string, pressed: boolean, device: Device)
InputController.DeviceChanged = Signal.new() -- (device: Device)

local ACTIONS = {
	{ name = "Sprint", keys = { Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3 }, touchKey = "TOUCH_SPRINT" },
	{ name = "Flashlight", keys = { Enum.KeyCode.F, Enum.KeyCode.ButtonR1 }, touchKey = "TOUCH_LIGHT" },
	{ name = "Radio", keys = { Enum.KeyCode.R, Enum.KeyCode.ButtonL1 }, touchKey = "TOUCH_RADIO" },
	{ name = "NightVision", keys = { Enum.KeyCode.N, Enum.KeyCode.DPadUp }, touchKey = "TOUCH_NIGHT", hidden = true },
	{ name = "Mic", keys = { Enum.KeyCode.M, Enum.KeyCode.DPadLeft }, touchKey = "TOUCH_MIC", small = true, slot = 1 },
	{ name = "Pause", keys = { Enum.KeyCode.P, Enum.KeyCode.ButtonSelect }, touchText = "II", small = true, slot = 0 },
	-- Hotbar (touch uses the slot buttons of the hotbar itself)
	{ name = "Item1", keys = { Enum.KeyCode.One } },
	{ name = "Item2", keys = { Enum.KeyCode.Two } },
	{ name = "Item3", keys = { Enum.KeyCode.Three } },
	{ name = "Item4", keys = { Enum.KeyCode.Four } },
	{ name = "ItemNext", keys = { Enum.KeyCode.DPadRight } },
	{ name = "ItemUse", keys = { Enum.KeyCode.ButtonY } },
}

local device: Device = "keyboard"
local gameplayEnabled = false
local usingActionSystem = false
local held: { [string]: boolean } = {}
local touchButtons: { [string]: TextButton } = {}
local touchContainer: Frame? = nil
local context: Instance? = nil

local function fire(name: string, pressed: boolean)
	if pressed then
		if not gameplayEnabled or UserInputService:GetFocusedTextBox() then
			return
		end
		if held[name] then
			return
		end
		held[name] = true
	else
		if not held[name] then
			return
		end
		held[name] = nil
	end
	InputController.Action:Fire(name, pressed, device)
end

---------------------------------------------------------------------------
-- Device detection
---------------------------------------------------------------------------

local function deviceFromLastInput(inputType: Enum.UserInputType): Device?
	if inputType == Enum.UserInputType.Touch then
		return "touch"
	end
	local name = inputType.Name
	if string.sub(name, 1, 7) == "Gamepad" then
		return "gamepad"
	end
	if inputType == Enum.UserInputType.Keyboard or string.sub(name, 1, 5) == "Mouse" then
		return "keyboard"
	end
	return nil
end

local function setDevice(newDevice: Device?)
	if not newDevice or newDevice == device then
		return
	end
	device = newDevice
	if touchContainer then
		touchContainer.Visible = gameplayEnabled and device == "touch"
	end
	InputController.DeviceChanged:Fire(device)
end

local function readPreferredInput(): Device?
	local ok, preferred = pcall(function()
		return (UserInputService :: any).PreferredInput
	end)
	if not ok or preferred == nil then
		return nil
	end
	if preferred == Enum.PreferredInput.Touch then
		return "touch"
	elseif preferred == Enum.PreferredInput.Gamepad then
		return "gamepad"
	end
	return "keyboard"
end

local function initDeviceDetection()
	local preferred = readPreferredInput()
	if preferred then
		device = preferred
		UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(function()
			setDevice(readPreferredInput())
		end)
	else
		device = deviceFromLastInput(UserInputService:GetLastInputType())
			or (if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then "touch" else "keyboard")
		UserInputService.LastInputTypeChanged:Connect(function(inputType)
			setDevice(deviceFromLastInput(inputType))
		end)
	end
end

---------------------------------------------------------------------------
-- Touch buttons (large, few, right thumb area; Pause sits top-right)
---------------------------------------------------------------------------

local function createTouchButtons(parent: ScreenGui)
	local container = Instance.new("Frame")
	container.Name = "TouchControls"
	container.BackgroundTransparency = 1
	container.Size = UDim2.fromScale(1, 1)
	container.Visible = false
	container.Parent = parent
	touchContainer = container

	local index = 0
	for _, definition in ACTIONS do
		if not definition.touchKey and not definition.touchText then
			continue
		end
		local button = Instance.new("TextButton")
		button.Name = definition.name
		button.AutoButtonColor = false
		button.AutoLocalize = false
		button.BackgroundColor3 = Theme.Colors.Panel
		button.BackgroundTransparency = 0.35
		button.TextColor3 = Theme.Colors.TextBright
		button.Font = Theme.Fonts.Medium
		button.TextSize = 15
		button.Selectable = false
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = button
		local stroke = Instance.new("UIStroke")
		stroke.Color = Theme.Colors.TextFaint
		stroke.Transparency = 0.3
		stroke.Thickness = 1
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = button
		if definition.small then
			button.Size = UDim2.fromOffset(48, 48)
			button.AnchorPoint = Vector2.new(1, 0)
			button.Position = UDim2.new(1, -16 - (definition.slot or 0) * 58, 0, 8)
			button.TextSize = 12
		else
			button.Size = UDim2.fromOffset(72, 72)
			button.AnchorPoint = Vector2.new(1, 1)
			button.Position = UDim2.new(1, -150 - index * 84, 1, -28 - index * 60)
			index += 1
		end
		if definition.touchKey then
			Localization.Bind(button, definition.touchKey)
		else
			button.Text = definition.touchText or ""
		end
		button.Visible = not definition.hidden
		button.Parent = container
		touchButtons[definition.name] = button
	end
end

---------------------------------------------------------------------------
-- Binding paths
---------------------------------------------------------------------------

local function bindWithActionSystem(): boolean
	local ok, err = pcall(function()
		local newContext = Instance.new("InputContext")
		newContext.Name = "FZ_Gameplay"
		for _, definition in ACTIONS do
			local action = Instance.new("InputAction")
			action.Name = definition.name
			action.Type = Enum.InputActionType.Bool
			for _, key in definition.keys do
				local binding = Instance.new("InputBinding")
				binding.KeyCode = key
				binding.Parent = action
			end
			local touchButton = touchButtons[definition.name]
			if touchButton then
				local binding = Instance.new("InputBinding")
				binding.UIButton = touchButton
				binding.Parent = action
			end
			action.Pressed:Connect(function()
				fire(definition.name, true)
			end)
			action.Released:Connect(function()
				fire(definition.name, false)
			end)
			action.Parent = newContext
		end
		newContext.Enabled = gameplayEnabled
		newContext.Parent = Players.LocalPlayer:WaitForChild("PlayerScripts")
		context = newContext
	end)
	if not ok then
		warn("[FZ-Input] Input Action System unavailable, using fallback: " .. tostring(err))
		if context then
			context:Destroy()
			context = nil
		end
	end
	return ok
end

local function bindWithFallback()
	local keyToAction: { [Enum.KeyCode]: string } = {}
	for _, definition in ACTIONS do
		for _, key in definition.keys do
			keyToAction[key] = definition.name
		end
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local name = keyToAction[input.KeyCode]
		if name then
			fire(name, true)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		local name = keyToAction[input.KeyCode]
		if name then
			fire(name, false)
		end
	end)
	for name, button in touchButtons do
		button.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				fire(name, true)
			end
		end)
		button.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				fire(name, false)
			end
		end)
	end
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function InputController.Init(hudGui: ScreenGui)
	GuiService.AutoSelectGuiEnabled = false
	initDeviceDetection()
	createTouchButtons(hudGui)
	usingActionSystem = not FORCE_LEGACY and bindWithActionSystem()
	if not usingActionSystem then
		bindWithFallback()
	end
end

function InputController.GetDevice(): Device
	return device
end

function InputController.IsUsingActionSystem(): boolean
	return usingActionSystem
end

function InputController.SetGameplayEnabled(enabled: boolean)
	gameplayEnabled = enabled
	if context then
		(context :: any).Enabled = enabled
	end
	if touchContainer then
		touchContainer.Visible = enabled and device == "touch"
	end
	if not enabled then
		-- Release everything that is still held so nothing gets stuck "on".
		for name in table.clone(held) do
			held[name] = nil
			InputController.Action:Fire(name, false, device)
		end
	end
end

function InputController.SetTouchVisible(name: string, visible: boolean)
	local button = touchButtons[name]
	if button then
		button.Visible = visible
	end
end

-- Lets gameplay code reflect state on touch buttons (e.g. sprint toggle highlighted).
function InputController.SetTouchActive(name: string, active: boolean)
	local button = touchButtons[name]
	if button then
		button.BackgroundColor3 = if active then Theme.Colors.Accent else Theme.Colors.Panel
	end
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9306">
            <Properties>
              <string name="Name">InventoryController</string>
              <string name="Source"><![CDATA[-- InventoryController: the hotbar. Only visible when you carry something.
--   PC 1-4 = use slot directly · gamepad D-pad right = next slot, Y = use · touch: tap a slot

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local InputController = require(script.Parent.InputController)
local Components = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)

local InventoryController = {}

-- Emoji glyphs render on every platform without uploading image assets.
local ICONS = { bandage = "🩹", medkit = "🧰", syringe = "💉" }

local player = Players.LocalPlayer
local bar: Frame
local selected = 1
local items: { string } = {}

local function use(slot: number)
	if items[slot] then
		Net.Event("UseItem"):FireServer(slot)
	end
end

local function render()
	for _, child in bar:GetChildren() do
		if child:IsA("GuiButton") then
			child:Destroy()
		end
	end
	local raw = player:GetAttribute("FZ_Items")
	items = if type(raw) == "string" and raw ~= "" then string.split(raw, ",") else {}
	local slots = tonumber(player:GetAttribute("FZ_ItemSlots")) or Config.Inventory.Slots
	bar.Visible = #items > 0 and player:GetAttribute("FZ_InGame") == true
	selected = math.clamp(selected, 1, math.max(1, #items))
	local using = player:GetAttribute("FZ_UsingItem")
	for slot = 1, slots do
		local itemId = items[slot]
		local button = Instance.new("TextButton")
		button.Name = "Slot" .. slot
		button.AutoButtonColor = false
		button.AutoLocalize = false
		button.Text = ""
		button.Size = UDim2.fromOffset(68, 68)
		button.LayoutOrder = slot
		button.Selectable = false
		button.BackgroundColor3 = Theme.Colors.Panel
		button.BackgroundTransparency = if itemId then 0.15 else 0.6
		local stroke = Instance.new("UIStroke")
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = if slot == selected and itemId then Theme.Colors.Relay else Theme.Colors.PanelLine
		stroke.Thickness = if slot == selected and itemId then 2 else 1
		stroke.Parent = button
		Components.Corner(button, 8)
		if slot == selected and itemId then
			local underline = Instance.new("Frame")
			underline.Name = "Selected"
			underline.BackgroundColor3 = Theme.Colors.Relay
			underline.BorderSizePixel = 0
			underline.AnchorPoint = Vector2.new(0.5, 1)
			underline.Position = UDim2.new(0.5, 0, 1, -4)
			underline.Size = UDim2.fromOffset(22, 2)
			underline.Parent = button
		end
		Components.Text({ Text = tostring(slot), Font = Theme.Fonts.Mono, TextSize = 11, Color = Theme.Colors.TextFaint, Size = UDim2.fromOffset(14, 14), Position = UDim2.fromOffset(4, 2), Parent = button })
		if itemId then
			Components.Text({ Text = ICONS[itemId] or "◆", TextSize = 24, XAlign = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 30), Position = UDim2.fromOffset(0, 8), Parent = button })
			local name = Components.Text({ Key = Config.Items[itemId].name, Font = Theme.Fonts.Medium, TextSize = 11, Color = if using == itemId then Theme.Colors.Relay else Theme.Colors.TextBright, XAlign = Enum.TextXAlignment.Center, Wrapped = false, Size = UDim2.new(1, -6, 0, 14), Position = UDim2.fromOffset(3, 42), Parent = button })
			name.TextTruncate = Enum.TextTruncate.AtEnd
		end
		button.Activated:Connect(function()
			use(slot)
		end)
		button.Parent = bar
	end
end

function InventoryController.Init(hudGui: ScreenGui)
	bar = Instance.new("Frame")
	bar.Name = "Hotbar"
	bar.BackgroundTransparency = 1
	bar.AnchorPoint = Vector2.new(0.5, 1)
	bar.Position = UDim2.new(0.5, 0, 1, -22)
	bar.Size = UDim2.fromOffset(4 * 76, 68)
	bar.Visible = false
	bar.Parent = hudGui
	local layout = Components.List(bar, 6, true)
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	for _, attribute in { "FZ_Items", "FZ_ItemSlots", "FZ_UsingItem", "FZ_InGame" } do
		player:GetAttributeChangedSignal(attribute):Connect(render)
	end
	Localization.Changed:Connect(render)
	render()

	InputController.Action:Connect(function(name, pressed)
		if not pressed then
			return
		end
		local direct = string.match(name, "^Item(%d)$")
		if direct then
			use(tonumber(direct) :: number)
		elseif name == "ItemNext" and #items > 0 then
			selected = (selected % #items) + 1
			render()
		elseif name == "ItemUse" then
			use(selected)
		end
	end)
end

return InventoryController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9307">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[-- MovementController: slow walk, short limited sprint with stamina.
-- Keyboard: hold to sprint. Gamepad (L3) and touch: toggle, ends automatically when the
-- player stops moving or runs out of breath. No permanent sprinting by design.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local InputController = require(script.Parent.InputController)

local MovementController = {}

local M = Config.Movement
local player = Players.LocalPlayer

local stamina = 1
local exhausted = false
local wantsSprint = false
local sprinting = false
local regenTimer = 0
local heartbeat: RBXScriptConnection? = nil
local settings = nil
local onStamina: ((number, boolean) -> ())? = nil

local function cameraEffectsScale(): number
	local value = settings and settings.Get("cameraEffects") or "full"
	return if value == "off" then 0 elseif value == "reduced" then 0.5 else 1
end

local function setSprinting(value: boolean)
	if sprinting == value then
		return
	end
	sprinting = value
	InputController.SetTouchActive("Sprint", value)
	local camera = workspace.CurrentCamera
	if camera then
		local fov = M.BaseFov + (if value then M.SprintFovBoost * cameraEffectsScale() else 0)
		TweenService:Create(camera, TweenInfo.new(0.35, Enum.EasingStyle.Sine), { FieldOfView = fov }):Play()
	end
end

local function step(dt: number)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local moving = humanoid.MoveDirection.Magnitude > 0.1
	if not moving and InputController.GetDevice() ~= "keyboard" then
		wantsSprint = false -- toggle sprint ends when the player stops
	end

	local canSprint = wantsSprint and moving and not exhausted and stamina > 0 and not player:GetAttribute("FZ_Downed")
	setSprinting(canSprint)

	if sprinting then
		stamina = math.max(0, stamina - dt / M.StaminaSeconds)
		regenTimer = M.RegenDelay
		if stamina <= 0 then
			exhausted = true
			wantsSprint = false
		end
	else
		regenTimer = math.max(0, regenTimer - dt)
		if regenTimer <= 0 then
			stamina = math.min(1, stamina + dt / M.RegenSeconds)
		end
		if exhausted and stamina >= M.ExhaustedThreshold then
			exhausted = false
		end
	end

	if player:GetAttribute("FZ_MonsterMode") then
		return -- the creature rig keeps the speed the server gave it
	end
	local speed = if sprinting then M.SprintSpeed else M.WalkSpeed
	if player:GetAttribute("FZ_Downed") then
		speed = Config.Health.CrawlSpeed
		wantsSprint = false
	end
	if player:GetAttribute("FZ_Rescuing") or player:GetAttribute("FZ_Eliminated") then
		speed = 0 -- kneeling next to a teammate: you cannot run away while helping
		wantsSprint = false
	end
	if player:GetAttribute("FZ_AdminSpeed") then
		speed *= 2
	end
	humanoid.WalkSpeed = speed
	if onStamina then
		onStamina(stamina, exhausted)
	end
end

function MovementController.Init(settingsController, staminaCallback: (number, boolean) -> ())
	settings = settingsController
	onStamina = staminaCallback
	InputController.Action:Connect(function(name, pressed, device)
		if name ~= "Sprint" then
			return
		end
		if device == "keyboard" then
			wantsSprint = pressed
		elseif pressed then
			wantsSprint = not wantsSprint
		end
	end)
end

function MovementController.SetActive(active: boolean)
	if active and not heartbeat then
		heartbeat = RunService.Heartbeat:Connect(step)
	elseif not active and heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
		wantsSprint = false
		setSprinting(false)
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = M.WalkSpeed
		end
	end
end

return MovementController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9308">
            <Properties>
              <string name="Name">PromptController</string>
              <string name="Source"><![CDATA[-- PromptController: our own interaction prompt (all prompts use Style = Custom).
-- Same look on every device; key glyph adapts to the input device:
--   keyboard "E" · gamepad "X" · touch: the whole prompt is a big tap / hold target
-- Hold prompts fill the key box; a short flash confirms the trigger.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Theme = require(script.Parent.Parent.UI.Theme)

local PromptController = {}

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

local function keyText(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType): string
	if inputType == Enum.ProximityPromptInputType.Gamepad then
		local name = prompt.GamepadKeyCode.Name
		return (string.gsub(name, "^Button", ""))
	elseif inputType == Enum.ProximityPromptInputType.Touch then
		return "●"
	end
	local ok, text = pcall(UserInputService.GetStringForKeyCode, UserInputService, prompt.KeyboardKeyCode)
	return if ok and text ~= "" then string.upper(text) else prompt.KeyboardKeyCode.Name
end

local function adornee(prompt: ProximityPrompt): Instance?
	local parent = prompt.Parent
	if parent and parent:IsA("Model") then
		return parent.PrimaryPart
	end
	return parent
end

local function build(prompt: ProximityPrompt, inputType: Enum.ProximityPromptInputType)
	local touch = inputType == Enum.ProximityPromptInputType.Touch
	local gui = Instance.new("BillboardGui")
	gui.Name = "FZ_Prompt"
	gui.AlwaysOnTop = true
	gui.LightInfluence = 0
	gui.Size = UDim2.fromOffset(if touch then 280 else 250, if touch then 72 else 58)
	gui.StudsOffset = Vector3.new(0, 1.6, 0)
	gui.ResetOnSpawn = false
	gui.AutoLocalize = false
	gui.Active = touch
	gui.ClipsDescendants = false
	gui.Adornee = adornee(prompt)

	local frame = Instance.new("TextButton")
	frame.Name = "Frame"
	frame.AutoButtonColor = false
	frame.Text = ""
	frame.Size = UDim2.fromScale(1, 1)
	frame.BackgroundColor3 = Theme.Colors.Panel
	frame.BackgroundTransparency = 1
	frame.Active = touch
	frame.Selectable = false
	frame.Parent = gui

	local key = Instance.new("Frame")
	key.Name = "Key"
	key.AnchorPoint = Vector2.new(0, 0.5)
	key.Position = UDim2.new(0, 4, 0.5, 0)
	key.Size = UDim2.fromOffset(if touch then 56 else 42, if touch then 56 else 42)
	key.BackgroundColor3 = Theme.Colors.Panel
	key.BackgroundTransparency = 0.15
	key.ClipsDescendants = true
	key.Parent = frame
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = key
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Colors.TextBright
	stroke.Transparency = 0.35
	stroke.Thickness = 1.5
	stroke.Parent = key

	local fill = Instance.new("Frame")
	fill.Name = "Hold"
	fill.AnchorPoint = Vector2.new(0, 1)
	fill.Position = UDim2.fromScale(0, 1)
	fill.Size = UDim2.fromScale(1, 0)
	fill.BackgroundColor3 = Theme.Colors.Relay
	fill.BackgroundTransparency = 0.35
	fill.BorderSizePixel = 0
	fill.Parent = key

	local keyLabel = Instance.new("TextLabel")
	keyLabel.BackgroundTransparency = 1
	keyLabel.Size = UDim2.fromScale(1, 1)
	keyLabel.Font = Theme.Fonts.Bold
	keyLabel.TextSize = if touch then 24 else 20
	keyLabel.TextColor3 = Theme.Colors.TextBright
	keyLabel.Text = keyText(prompt, inputType)
	keyLabel.AutoLocalize = false
	keyLabel.ZIndex = 2
	keyLabel.Parent = key

	local action = Instance.new("TextLabel")
	action.BackgroundTransparency = 1
	action.Position = UDim2.new(0, key.Size.X.Offset + 14, 0, if touch then 10 else 6)
	action.Size = UDim2.new(1, -(key.Size.X.Offset + 16), 0, 24)
	action.Font = Theme.Fonts.Bold
	action.TextSize = if touch then 20 else 18
	action.TextXAlignment = Enum.TextXAlignment.Left
	action.TextColor3 = Theme.Colors.TextBright
	action.TextStrokeTransparency = 0.5
	action.TextTruncate = Enum.TextTruncate.AtEnd
	action.AutoLocalize = false
	action.Parent = frame

	local object = action:Clone()
	object.Position = UDim2.new(0, key.Size.X.Offset + 14, 0, if touch then 34 else 30)
	object.Size = UDim2.new(1, -(key.Size.X.Offset + 16), 0, 20)
	object.Font = Theme.Fonts.Mono
	object.TextSize = 14
	object.TextColor3 = Theme.Colors.TextDim
	object.Parent = frame

	local function refreshText()
		action.Text = prompt.ActionText
		object.Text = prompt.ObjectText
	end
	refreshText()

	local connections = {
		prompt:GetPropertyChangedSignal("ActionText"):Connect(refreshText),
		prompt:GetPropertyChangedSignal("ObjectText"):Connect(refreshText),
	}
	local holdTween: Tween? = nil
	table.insert(connections, prompt.PromptButtonHoldBegan:Connect(function()
		if prompt.HoldDuration > 0 then
			fill.Size = UDim2.fromScale(1, 0)
			holdTween = TweenService:Create(fill, TweenInfo.new(prompt.HoldDuration, Enum.EasingStyle.Linear), { Size = UDim2.fromScale(1, 1) })
			;(holdTween :: Tween):Play()
		end
	end))
	table.insert(connections, prompt.PromptButtonHoldEnded:Connect(function()
		if holdTween then
			holdTween:Cancel()
		end
		TweenService:Create(fill, Theme.Fast, { Size = UDim2.fromScale(1, 0) }):Play()
	end))
	table.insert(connections, prompt.Triggered:Connect(function()
		stroke.Color = Theme.Colors.Relay
		stroke.Transparency = 0
		TweenService:Create(stroke, TweenInfo.new(0.4), { Transparency = 0.35, Color = Theme.Colors.TextBright }):Play()
	end))

	if touch then
		-- Large target: tap = trigger, hold = hold prompt
		table.insert(connections, frame.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				prompt:InputHoldBegin()
			end
		end))
		table.insert(connections, frame.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
				prompt:InputHoldEnd()
			end
		end))
	end

	gui.Parent = playerGui
	return function()
		for _, connection in connections do
			connection:Disconnect()
		end
		gui:Destroy()
	end
end

function PromptController.Init()
	ProximityPromptService.PromptShown:Connect(function(prompt, inputType)
		if prompt.Style ~= Enum.ProximityPromptStyle.Custom then
			return
		end
		local cleanup = build(prompt, inputType)
		prompt.PromptHidden:Wait()
		cleanup()
	end)
end

return PromptController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9309">
            <Properties>
              <string name="Name">RadioController</string>
              <string name="Source"><![CDATA[-- RadioController: the walkie-talkie in your hand.
--   * Push to talk (R / LB / touch "Radio"), hold or toggle (Settings -> Radio button)
--   * Mute / unmute your own microphone (M / D-pad left / touch "Mic")
--   * Viewmodel: raised while transmitting, half-raised while receiving, otherwise away
--   * Small HUD line: "TRANSMITTING", "Receiving: name", "Microphone muted"
-- Transmitting is audible to the creature (server NoiseService) - talk with care.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local InputController = require(script.Parent.InputController)
local VoiceController = require(script.Parent.VoiceController)
local AudioController = require(script.Parent.AudioController)

local Theme = require(script.Parent.Parent.UI.Theme)
local Components = require(script.Parent.Parent.UI.Components)

local RadioController = {}

local player = Players.LocalPlayer
local settings = nil
local transmitting = false
local muted = false
local receiving: { string } = {}

local viewmodel: Model? = nil
local led: BasePart? = nil
local body: BasePart? = nil
local render: RBXScriptConnection? = nil
local pose = 0 -- 0 hidden, 0.5 receiving, 1 transmitting

local statusLabel: TextLabel
local micLabel: TextLabel

local HIDDEN = CFrame.new(0.9, -2.8, -1.4) * CFrame.Angles(math.rad(-30), 0, 0)
local HALF = CFrame.new(0.95, -1.45, -1.7) * CFrame.Angles(math.rad(8), math.rad(-14), math.rad(-6))
local RAISED = CFrame.new(0.55, -0.85, -1.35) * CFrame.Angles(math.rad(14), math.rad(-24), math.rad(-10))

local function part(model: Model, name: string, size: Vector3, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = model
	return p
end

local function buildViewmodel(): Model
	local model = Instance.new("Model")
	model.Name = "FZ_RadioViewmodel"
	local color = player:GetAttribute("FZ_RadioColor")
	local b = part(model, "Body", Vector3.new(0.75, 1.7, 0.42), if typeof(color) == "Color3" then color else Color3.fromRGB(46, 48, 50), Enum.Material.SmoothPlastic)
	model.PrimaryPart = b
	body = b
	local antenna = part(model, "Antenna", Vector3.new(0.14, 1.3, 0.14), Color3.fromRGB(26, 26, 26), Enum.Material.Rubber)
	antenna:SetAttribute("Offset", CFrame.new(-0.22, 1.45, 0))
	local screen = part(model, "Screen", Vector3.new(0.56, 0.42, 0.05), Color3.fromRGB(255, 150, 60), Enum.Material.Neon)
	screen.Transparency = 0.15
	screen:SetAttribute("Offset", CFrame.new(0, 0.42, -0.22))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 200
	gui.AutoLocalize = false
	gui.Parent = screen
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.RobotoMono
	text.TextScaled = true
	text.TextColor3 = Color3.fromRGB(40, 16, 0)
	text.Text = "CH-07\nRELAIS"
	text.AutoLocalize = false
	text.Parent = gui
	local grille = part(model, "Speaker", Vector3.new(0.5, 0.5, 0.05), Color3.fromRGB(20, 20, 20), Enum.Material.DiamondPlate)
	grille:SetAttribute("Offset", CFrame.new(0, -0.35, -0.22))
	local l = part(model, "Led", Vector3.new(0.1, 0.1, 0.06), Color3.fromRGB(60, 20, 20), Enum.Material.Neon)
	l:SetAttribute("Offset", CFrame.new(0.26, 0.74, -0.22))
	led = l
	local knob = part(model, "Knob", Vector3.new(0.18, 0.2, 0.18), Color3.fromRGB(30, 30, 30), Enum.Material.Metal)
	knob:SetAttribute("Offset", CFrame.new(0.2, 0.92, 0))
	return model
end

local function placeViewmodel(cframe: CFrame)
	local model = viewmodel :: Model
	local b = body :: BasePart
	b.CFrame = cframe
	for _, child in model:GetChildren() do
		if child ~= b and child:IsA("BasePart") then
			local offset = child:GetAttribute("Offset")
			if typeof(offset) == "CFrame" then
				child.CFrame = cframe * offset
			end
		end
	end
end

local function targetPose(): number
	if transmitting then
		return 1
	elseif #receiving > 0 then
		return 0.5
	end
	return 0
end

local function ensureRender()
	if render then
		return
	end
	render = RunService.RenderStepped:Connect(function(dt)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local goal = targetPose()
		pose += (goal - pose) * math.min(1, dt * 9)
		if math.abs(goal - pose) < 0.01 then
			pose = goal
		end
		if pose <= 0.001 and goal == 0 then
			if viewmodel then
				viewmodel:Destroy()
				viewmodel = nil
			end
			(render :: RBXScriptConnection):Disconnect()
			render = nil
			return
		end
		if not viewmodel or not viewmodel.Parent then
			viewmodel = buildViewmodel()
			viewmodel.Parent = camera
		end
		local offset = if pose <= 0.5 then HIDDEN:Lerp(HALF, pose * 2) else HALF:Lerp(RAISED, (pose - 0.5) * 2)
		local t = os.clock()
		local sway = CFrame.new(math.sin(t * 1.3) * 0.015, math.sin(t * 2.1) * 0.012, 0)
		placeViewmodel(camera.CFrame * offset * sway)
		if led then
			led.Color = if transmitting then Color3.fromRGB(255, 40, 30) elseif #receiving > 0 then Color3.fromRGB(80, 255, 120) else Color3.fromRGB(60, 20, 20)
		end
	end)
end

local function refreshHud()
	if transmitting then
		statusLabel.TextColor3 = Theme.Colors.Accent
		Localization.Bind(statusLabel, "RADIO_TX")
		statusLabel.Text = "● " .. statusLabel.Text
		statusLabel.Visible = true
	elseif #receiving > 0 then
		statusLabel.TextColor3 = Theme.Colors.Relay
		Localization.Bind(statusLabel, "RADIO_RX", { name = table.concat(receiving, ", ") })
		statusLabel.Visible = true
	else
		statusLabel.Visible = false
	end
	micLabel.Visible = muted
end

local function setTransmitting(value: boolean)
	if transmitting == value then
		return
	end
	transmitting = value
	Net.Event("RadioState"):FireServer(value)
	AudioController.Play(if value then "radio_squelch_on" else "radio_squelch_off", nil, 0.5, "SFX")
	InputController.SetTouchActive("Radio", value)
	ensureRender()
	refreshHud()
end

local function setMuted(value: boolean)
	muted = value
	Net.Event("MicMute"):FireServer(value)
	InputController.SetTouchActive("Mic", value)
	refreshHud()
end

function RadioController.IsMuted(): boolean
	return muted
end

function RadioController.ToggleMute()
	setMuted(not muted)
end

-- Called when gameplay is paused (menus, documents, downed is fine).
function RadioController.Stop()
	setTransmitting(false)
end

function RadioController.Init(hudGui: ScreenGui, settingsController)
	settings = settingsController
	statusLabel = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.Accent, Size = UDim2.fromOffset(360, 20), Position = UDim2.new(0, 24, 1, -64), Parent = hudGui })
	statusLabel.Visible = false
	statusLabel.TextStrokeTransparency = 0.5
	micLabel = Components.Text({ Key = "MIC_OFF", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, Size = UDim2.fromOffset(360, 20), Position = UDim2.new(0, 24, 1, -40), Parent = hudGui })
	micLabel.Visible = false
	micLabel.TextStrokeTransparency = 0.5

	InputController.Action:Connect(function(name, pressed)
		if name == "Radio" then
			if settings.Get("radioMode") == "toggle" then
				if pressed then
					setTransmitting(not transmitting)
				end
			else
				setTransmitting(pressed)
			end
		elseif name == "Mic" and pressed then
			setMuted(not muted)
		end
	end)

	VoiceController.ReceivingChanged:Connect(function(names)
		receiving = names
		ensureRender()
		refreshHud()
	end)
	Localization.Changed:Connect(refreshHud)
	player:GetAttributeChangedSignal("FZ_RadioColor"):Connect(function()
		if viewmodel then
			viewmodel:Destroy()
			viewmodel = nil
		end
	end)
end

return RadioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9310">
            <Properties>
              <string name="Name">RescueController</string>
              <string name="Source"><![CDATA[-- RescueController: everything around being down and helping someone up.
--   * You are down: bleed-out countdown, camera near the floor, hint about the syringe
--   * A teammate is down: an atmospheric "help" marker with the remaining time
--   * You are helping: you kneel (lower camera) and cannot move - you are vulnerable;
--     taking damage cancels the rescue. The prompt only shows if you carry a medkit.
--   * You are out: spectate your teammates (click / tap / A = next) until the team
--     reaches the next checkpoint or the survival break

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local Components = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)

local RescueController = {}

local player = Players.LocalPlayer
local markers: { [Player]: BillboardGui } = {}
local activeRescue: ProximityPrompt? = nil
local spectateIndex = 1

local function humanoid(): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function setCameraLow(depth: number)
	local h = humanoid()
	if h then
		h.CameraOffset = Vector3.new(0, -depth, 0)
	end
end

local function marker(target: Player)
	local old = markers[target]
	if old then
		old:Destroy()
		markers[target] = nil
	end
	if target == player or not target:GetAttribute("FZ_Downed") then
		return
	end
	local head = target.Character and target.Character:FindFirstChild("Head")
	if not head then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "FZ_HelpMarker"
	gui.Size = UDim2.fromOffset(150, 46)
	gui.StudsOffset = Vector3.new(0, 2.6, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 140
	gui.LightInfluence = 0
	gui.AutoLocalize = false
	gui.Adornee = head :: BasePart
	local label = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = 15, Color = Theme.Colors.Accent, XAlign = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = gui })
	label.TextStrokeTransparency = 0.3
	gui.Parent = player:WaitForChild("PlayerGui")
	markers[target] = gui
	task.spawn(function()
		while gui.Parent and target:GetAttribute("FZ_Downed") do
			local untilTime = target:GetAttribute("FZ_DownedUntil")
			local seconds = if type(untilTime) == "number" then math.max(0, math.ceil(untilTime - workspace:GetServerTimeNow())) else 0
			-- slow pulse instead of a bright blinking icon
			label.TextTransparency = 0.15 + 0.35 * (0.5 + 0.5 * math.sin(os.clock() * 3))
			label.Text = Localization.T("HELP_MARKER", { name = target.DisplayName, seconds = seconds })
			task.wait(0.1)
		end
		gui:Destroy()
	end)
end

local function watch(target: Player)
	target:GetAttributeChangedSignal("FZ_Downed"):Connect(function()
		marker(target)
	end)
	target.CharacterAdded:Connect(function()
		task.wait(0.5)
		marker(target)
	end)
	marker(target)
end

-- Spectator camera while eliminated
local function teammates(): { Player }
	local list = {}
	for _, other in Players:GetPlayers() do
		if other ~= player and other:GetAttribute("FZ_InGame") and not other:GetAttribute("FZ_Eliminated") and other.Character then
			table.insert(list, other)
		end
	end
	return list
end

local function spectate()
	local camera = workspace.CurrentCamera
	local list = teammates()
	if #list == 0 or not camera then
		return
	end
	spectateIndex = ((spectateIndex - 1) % #list) + 1
	local target = list[spectateIndex]
	local h = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
	if h then
		camera.CameraSubject = h
		player.CameraMode = Enum.CameraMode.Classic
		player.CameraMinZoomDistance = 8
	end
end

function RescueController.Init(hudGui: ScreenGui)
	local downedPanel = Components.Text({ Text = "", Font = Theme.Fonts.Medium, TextSize = Theme.Sizes.TextBody, Color = Theme.Colors.TextBright, XAlign = Enum.TextXAlignment.Center, AutoY = true, Size = UDim2.new(0.7, 0, 0, 0), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), Parent = hudGui })
	downedPanel.TextStrokeTransparency = 0.4
	downedPanel.Visible = false

	local function refreshSelf()
		local downed = player:GetAttribute("FZ_Downed") == true
		local eliminated = player:GetAttribute("FZ_Eliminated") == true
		downedPanel.Visible = downed or eliminated
		setCameraLow(if downed then 2.2 else 0)
		if eliminated then
			spectateIndex = 1
			spectate()
		else
			local h = humanoid()
			local camera = workspace.CurrentCamera
			if h and camera and camera.CameraSubject ~= h then
				camera.CameraSubject = h
			end
			if player.CameraMode ~= Enum.CameraMode.LockFirstPerson and not player:GetAttribute("FZ_MonsterMode") then
				player.CameraMode = Enum.CameraMode.LockFirstPerson
				player.CameraMinZoomDistance = 0.5
			end
		end
	end
	player:GetAttributeChangedSignal("FZ_Downed"):Connect(refreshSelf)
	player:GetAttributeChangedSignal("FZ_Eliminated"):Connect(refreshSelf)

	RunService.Heartbeat:Connect(function()
		if not downedPanel.Visible then
			return
		end
		if player:GetAttribute("FZ_Eliminated") then
			downedPanel.Text = Localization.T("HUD_SPECTATING")
		else
			local untilTime = player:GetAttribute("FZ_DownedUntil")
			local seconds = if type(untilTime) == "number" then math.max(0, math.ceil(untilTime - workspace:GetServerTimeNow())) else 0
			downedPanel.Text = Localization.T("HUD_DOWNED_TIMER", { seconds = seconds })
		end
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not player:GetAttribute("FZ_Eliminated") then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch or input.KeyCode == Enum.KeyCode.ButtonA then
			spectateIndex += 1
			spectate()
		end
	end)

	-- Helping someone up: kneel, frozen, cancelled by damage
	ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
		if prompt:GetAttribute("FZ_Object") == "OBJECT_TEAMMATE" then
			activeRescue = prompt
			player:SetAttribute("FZ_Rescuing", true)
			setCameraLow(1.4)
		end
	end)
	ProximityPromptService.PromptButtonHoldEnded:Connect(function(prompt)
		if prompt == activeRescue then
			activeRescue = nil
			player:SetAttribute("FZ_Rescuing", nil)
			setCameraLow(0)
		end
	end)
	Net.Event("Hurt").OnClientEvent:Connect(function()
		local prompt = activeRescue
		if prompt then
			pcall(function()
				prompt:InputHoldEnd()
			end)
			activeRescue = nil
			player:SetAttribute("FZ_Rescuing", nil)
			setCameraLow(0)
		end
	end)

	for _, other in Players:GetPlayers() do
		watch(other)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(other)
		if markers[other] then
			markers[other]:Destroy()
			markers[other] = nil
		end
	end)
end

return RescueController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9311">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[-- SettingsController: local source of truth for player settings.
-- Changes apply instantly on this client and are persisted through the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local SettingsController = {}
SettingsController.Changed = Signal.new() -- (key, value)

local values: { [string]: any } = Config.DefaultSettings()
local updateRemote = Net.Event("UpdateSetting")

function SettingsController.Load(saved: { [string]: any }?)
	for key, value in saved or {} do
		local ok, sanitized = Config.ValidateSetting(key, value)
		if ok then
			values[key] = sanitized
		end
	end
end

function SettingsController.Get(key: string): any
	return values[key]
end

function SettingsController.Set(key: string, value: any): boolean
	local ok, sanitized = Config.ValidateSetting(key, value)
	if not ok then
		return false
	end
	if values[key] == sanitized then
		return true
	end
	values[key] = sanitized
	if key == "language" then
		Localization.SetLanguage(sanitized)
	end
	SettingsController.Changed:Fire(key, sanitized)
	updateRemote:FireServer(key, sanitized)
	return true
end

-- Cycles enum / bool / int settings by delta (+1 / -1). Wraps for enums and bools.
function SettingsController.Step(key: string, delta: number)
	local definition = Config.Settings[key]
	if not definition then
		return
	end
	local current = values[key]
	if definition.kind == "bool" then
		SettingsController.Set(key, not current)
	elseif definition.kind == "enum" then
		local index = table.find(definition.values, current) or 1
		local nextIndex = ((index - 1 + delta) % #definition.values) + 1
		SettingsController.Set(key, definition.values[nextIndex])
	elseif definition.kind == "int" then
		SettingsController.Set(key, math.clamp((current or definition.default) + delta, definition.min, definition.max))
	end
end

-- Display text for a setting value in the current language.
function SettingsController.Describe(key: string): string
	local definition = Config.Settings[key]
	local value = values[key]
	if not definition then
		return ""
	end
	if key == "language" then
		return Config.LanguageNames[value] or ""
	elseif definition.kind == "bool" then
		return Localization.T(if value then "VALUE_ON" else "VALUE_OFF")
	elseif definition.kind == "enum" then
		return Localization.T(definition.labels[value])
	elseif definition.kind == "int" then
		return tostring(value)
	end
	return tostring(value)
end

return SettingsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9312">
            <Properties>
              <string name="Name">VoiceController</string>
              <string name="Source"><![CDATA[-- VoiceController: hearing voices on this client.
--
-- Proximity voice: one AudioListener on the camera hears every player's head emitter
-- (spatial, quieter with distance). Your own emitter is silenced locally so you never
-- hear yourself. Muting a teammate only changes YOUR local copy of their fader.
--
-- Radio (walkie-talkie, like Escape the Backrooms): while someone transmits, their
-- microphone is wired through a radio filter (band-pass + distortion) straight to your
-- speakers. Volume falls with distance and static rises; far away only static remains.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local VoiceChatService = game:GetService("VoiceChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Signal = require(Shared.Signal)

local AudioController = require(script.Parent.AudioController)

local VoiceController = {}
VoiceController.ReceivingChanged = Signal.new() -- (names: { string })

local localPlayer = Players.LocalPlayer
local output: Instance? = nil
local available = false
local locallyMuted: { [number]: boolean } = {}

type RadioChain = { nodes: { Instance }, fader: Instance, static: Sound? }
local radioChains: { [Player]: RadioChain } = {}

local function create(className: string, props: { [string]: any }, parent: Instance): Instance
	local instance = Instance.new(className)
	for key, value in props do
		(instance :: any)[key] = value
	end
	instance.Parent = parent
	return instance
end

local function wire(source: Instance, target: Instance, parent: Instance): Instance
	return create("Wire", { SourceInstance = source, TargetInstance = target }, parent)
end

local function voiceFader(player: Player): Instance?
	local head = player.Character and player.Character:FindFirstChild("Head")
	return head and head:FindFirstChild("FZ_VoiceFader")
end

local voiceVolume = 1

local function applyLocalVolume(player: Player)
	local fader = voiceFader(player)
	if fader then
		local volume = if player == localPlayer or locallyMuted[player.UserId] then 0 else voiceVolume
		pcall(function()
			(fader :: any).Volume = volume
		end)
	end
end

local function distanceTo(player: Player): number
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local camera = workspace.CurrentCamera
	if not root or not camera then
		return math.huge
	end
	return (root.Position - camera.CFrame.Position).Magnitude
end

local function radioVolume(distance: number): (number, number)
	local V = Config.Voice
	if distance <= V.RadioFull then
		return 1, 0.05
	end
	local t = math.clamp((distance - V.RadioFull) / (V.RadioMax - V.RadioFull), 0, 1)
	local voice = math.max(V.RadioMinVolume, (1 - t) ^ 1.6) * (if t >= 1 then 0 else 1)
	return voice, 0.05 + t * 0.5
end

local function stopRadio(player: Player)
	local chain = radioChains[player]
	if not chain then
		return
	end
	radioChains[player] = nil
	for _, node in chain.nodes do
		node:Destroy()
	end
	if chain.static then
		chain.static:Destroy()
	end
	AudioController.Play("radio_squelch_off", nil, 0.6, "SFX")
end

local function startRadio(player: Player)
	if radioChains[player] or player == localPlayer or locallyMuted[player.UserId] or not output then
		return
	end
	AudioController.Play("radio_squelch_on", nil, 0.6, "SFX")
	local static = AudioController.Loop("radio_static_loop", game:GetService("SoundService"), 0.05, "SFX")
	local input = player:FindFirstChildOfClass("AudioDeviceInput")
	local nodes = {}
	local fader = nil
	if input and available then
		local ok = pcall(function()
			local holder = Instance.new("Folder")
			holder.Name = "FZ_Radio_" .. player.UserId
			holder.Parent = localPlayer
			table.insert(nodes, holder)
			local bandpass = create("AudioFilter", { FilterType = Enum.AudioFilterType.Bandpass, Frequency = 1700, Q = 0.9 }, holder)
			local distortion = create("AudioDistortion", { Level = 0.35 }, holder)
			fader = create("AudioFader", { Volume = 1 }, holder)
			wire(input, bandpass, holder)
			wire(bandpass, distortion, holder)
			wire(distortion, fader, holder)
			wire(fader, output :: Instance, holder)
		end)
		if not ok then
			for _, node in nodes do
				node:Destroy()
			end
			nodes = {}
			fader = nil
		end
	end
	radioChains[player] = { nodes = nodes, fader = fader :: any, static = static }
end

local function refreshReceiving()
	local names = {}
	for player in radioChains do
		table.insert(names, player.DisplayName)
	end
	VoiceController.ReceivingChanged:Fire(names)
end

local function watchPlayer(player: Player)
	player:GetAttributeChangedSignal("FZ_RadioTx"):Connect(function()
		if player:GetAttribute("FZ_RadioTx") then
			startRadio(player)
		else
			stopRadio(player)
		end
		refreshReceiving()
	end)
	player.CharacterAdded:Connect(function(character)
		local head = character:WaitForChild("Head", 10)
		if head then
			head.ChildAdded:Connect(function(child)
				if child.Name == "FZ_VoiceFader" then
					applyLocalVolume(player)
				end
			end)
			applyLocalVolume(player)
		end
	end)
	applyLocalVolume(player)
end

function VoiceController.IsAvailable(): boolean
	return available
end

function VoiceController.SetMuted(player: Player, muted: boolean)
	locallyMuted[player.UserId] = muted or nil
	applyLocalVolume(player)
	if muted then
		stopRadio(player)
		refreshReceiving()
	end
end

function VoiceController.IsMuted(player: Player): boolean
	return locallyMuted[player.UserId] == true
end

-- Settings -> Audio -> "Voices and radio" (0..1)
function VoiceController.SetVolume(value: number)
	voiceVolume = value
	for _, player in Players:GetPlayers() do
		applyLocalVolume(player)
	end
end

function VoiceController.Init()
	local ok, enabled = pcall(function()
		return VoiceChatService:IsVoiceEnabledForUserIdAsync(localPlayer.UserId)
	end)
	available = ok and enabled == true

	pcall(function()
		local camera = workspace.CurrentCamera
		local listener = create("AudioListener", { Name = "FZ_Listener" }, camera)
		output = create("AudioDeviceOutput", { Name = "FZ_Output" }, localPlayer)
		wire(listener, output :: Instance, listener)
		workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
			if workspace.CurrentCamera then
				listener.Parent = workspace.CurrentCamera
			end
		end)
	end)

	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	Players.PlayerRemoving:Connect(function(player)
		stopRadio(player)
		refreshReceiving()
	end)

	-- Distance-based radio mix, 10 Hz
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.1 or next(radioChains) == nil then
			return
		end
		accumulator = 0
		for player, chain in radioChains do
			local voice, staticVolume = radioVolume(distanceTo(player))
			voice *= voiceVolume
			if chain.fader then
				pcall(function()
					(chain.fader :: any).Volume = voice
				end)
			end
			if chain.static then
				chain.static.Volume = staticVolume
			end
		end
	end)
end

return VoiceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9313">
            <Properties>
              <string name="Name">WorldTextController</string>
              <string name="Source"><![CDATA[-- WorldTextController: per-player localization of text that lives in the 3D world.
--   * ProximityPrompts tagged "FZ_Prompt" (attributes FZ_Action / FZ_Object)
--   * TextLabels on SurfaceGuis tagged "FZ_WorldText" (attribute LocKey, LocParam_<name>)
-- Text is set locally, so four players can read the same sign in four languages.
-- Works with StreamingEnabled: objects are localized whenever they stream in.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Localization = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Localization"))

local WorldTextController = {}

local function localizePrompt(prompt: Instance)
	if not prompt:IsA("ProximityPrompt") then
		return
	end
	local action = prompt:GetAttribute("FZ_Action")
	local object = prompt:GetAttribute("FZ_Object")
	prompt.ActionText = if type(action) == "string" then Localization.T(action) else ""
	prompt.ObjectText = if type(object) == "string" then Localization.T(object) else ""
	-- Equipment changes hold times locally (technician / medic). The base value is kept.
	if prompt:GetAttribute("FZ_BaseHold") == nil then
		prompt:SetAttribute("FZ_BaseHold", prompt.HoldDuration)
	end
	local base = prompt:GetAttribute("FZ_BaseHold") :: number
	local player = Players.LocalPlayer
	local multiplier = if object == "OBJECT_TEAMMATE"
		then tonumber(player:GetAttribute("FZ_ReviveMultiplier")) or 1
		else tonumber(player:GetAttribute("FZ_HoldMultiplier")) or 1
	prompt.HoldDuration = base * multiplier
	-- Your own "help up" prompt is for your teammates, not for you.
	local character = player.Character
	if character and prompt:IsDescendantOf(character) then
		prompt.Enabled = false
	elseif object == "OBJECT_TEAMMATE" then
		-- Helping someone up needs a medkit: without one the prompt says so and stays inactive.
		local items = player:GetAttribute("FZ_Items")
		local hasMedkit = type(items) == "string" and string.find(items, "medkit", 1, true) ~= nil
		prompt.Enabled = hasMedkit
	end
end

local function localizeText(label: Instance)
	if not label:IsA("TextLabel") then
		return
	end
	local key = label:GetAttribute("LocKey")
	if type(key) ~= "string" then
		return
	end
	local params = {}
	for name, value in label:GetAttributes() do
		local paramName = string.match(name, "^LocParam_(.+)$")
		if paramName then
			params[paramName] = value
		end
	end
	label.AutoLocalize = false
	label.Text = Localization.T(key, params)
end

local function refreshAll()
	for _, prompt in CollectionService:GetTagged("FZ_Prompt") do
		localizePrompt(prompt)
	end
	for _, label in CollectionService:GetTagged("FZ_WorldText") do
		localizeText(label)
	end
end

function WorldTextController.Init()
	CollectionService:GetInstanceAddedSignal("FZ_Prompt"):Connect(localizePrompt)
	CollectionService:GetInstanceAddedSignal("FZ_WorldText"):Connect(localizeText)
	Localization.Changed:Connect(refreshAll)
	local player = Players.LocalPlayer
	player:GetAttributeChangedSignal("FZ_HoldMultiplier"):Connect(refreshAll)
	player:GetAttributeChangedSignal("FZ_ReviveMultiplier"):Connect(refreshAll)
	player:GetAttributeChangedSignal("FZ_Items"):Connect(refreshAll)
	refreshAll()
end

return WorldTextController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="9314">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- SILENT RELAY - client bootstrap.
--
-- Flow: boot screen (logo only) -> load profile -> apply saved language BEFORE any text
-- exists -> first start: language picker / otherwise: main menu -> play.
-- Because no localized UI is created before the language is known, players never see
-- placeholder or wrong-language text that changes a moment later.

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local LocalizationService = game:GetService("LocalizationService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Content = require(Shared.Content)
local Updates = require(Shared.Updates)
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local Controllers = script.Parent:WaitForChild("Controllers")
local UI = script.Parent:WaitForChild("UI")

local InputController = require(Controllers.InputController)
local SettingsController = require(Controllers.SettingsController)
local GraphicsController = require(Controllers.GraphicsController)
local MovementController = require(Controllers.MovementController)
local FlashlightController = require(Controllers.FlashlightController)
local WorldTextController = require(Controllers.WorldTextController)
local AudioController = require(Controllers.AudioController)
local VoiceController = require(Controllers.VoiceController)
local RadioController = require(Controllers.RadioController)
local CreatureVisualsController = require(Controllers.CreatureVisualsController)
local HealthController = require(Controllers.HealthController)
local EquipmentController = require(Controllers.EquipmentController)
local DirectorController = require(Controllers.DirectorController)
local InventoryController = require(Controllers.InventoryController)
local PromptController = require(Controllers.PromptController)
local RescueController = require(Controllers.RescueController)
local AtmosphereController = require(Controllers.AtmosphereController)
local DecisionPanel = require(UI.DecisionPanel)

local Components = require(UI.Components)
local Theme = require(UI.Theme)
local Router = require(UI.Router)
local Hud = require(UI.Hud)
local DebugOverlay = require(UI.DebugOverlay)
local MainMenu = require(UI.Screens.MainMenu)
local LanguageSelect = require(UI.Screens.LanguageSelect)

---------------------------------------------------------------------------
-- 1. Screen layers (no text yet)
---------------------------------------------------------------------------
local backdropGui = Components.ScreenGui("FZ_Backdrop", 10, true)
local menuGui = Components.ScreenGui("FZ_Menu", 20)
Components.AttachScale(menuGui)
local hudGui = Components.ScreenGui("FZ_HUD", 30)
Components.AttachScale(hudGui)

-- Dark on the left (menu column), revealing the scene on the right.
local backdrop = Instance.new("Frame")
backdrop.Name = "Backdrop"
backdrop.BackgroundColor3 = Theme.Colors.Background
backdrop.BorderSizePixel = 0
backdrop.Size = UDim2.fromScale(1, 1)
backdrop.Visible = false
backdrop.Parent = backdropGui
local gradient = Instance.new("UIGradient")
gradient.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.55),
	NumberSequenceKeypoint.new(0.5, 0.85),
	NumberSequenceKeypoint.new(1, 0.92),
})
gradient.Parent = backdrop
Components.Vignette(backdrop, 0.6)
-- letterbox bars: cinematic frame for the title screen
for _, top in { true, false } do
	local bar = Instance.new("Frame")
	bar.Name = if top then "LetterboxTop" else "LetterboxBottom"
	bar.BackgroundColor3 = Color3.new(0, 0, 0)
	bar.BorderSizePixel = 0
	bar.AnchorPoint = Vector2.new(0, if top then 0 else 1)
	bar.Position = UDim2.fromScale(0, if top then 0 else 1)
	bar.Size = UDim2.new(1, 0, 0.055, 0)
	bar.Parent = backdrop
end
-- black frame used for cuts between menu camera shots
local cutFrame = Instance.new("Frame")
cutFrame.Name = "Cut"
cutFrame.BackgroundColor3 = Color3.new(0, 0, 0)
cutFrame.BackgroundTransparency = 1
cutFrame.BorderSizePixel = 0
cutFrame.Size = UDim2.fromScale(1, 1)
cutFrame.ZIndex = 60
cutFrame.Parent = backdropGui

InputController.Init(hudGui)

---------------------------------------------------------------------------
-- 2. Profile + language (before any localized UI is built)
---------------------------------------------------------------------------
local function waitForAttribute(name: string, timeout: number): boolean
	local deadline = os.clock() + timeout
	while player:GetAttribute(name) ~= true and os.clock() < deadline do
		task.wait(0.1)
	end
	return player:GetAttribute(name) == true
end

local profile = nil
if waitForAttribute("FZ_DataReady", 25) then
	local ok, result = pcall(function()
		return Net.Function("FetchProfile"):InvokeServer()
	end)
	if ok and type(result) == "table" then
		profile = result
	end
end
profile = profile
	or { settings = {}, signalMarks = 0, progress = { chapter = 1, completedChapters = {} }, survival = {}, seenContent = {}, lastSeenUpdate = "", persistent = false, isNew = true }

SettingsController.Load(profile.settings)

local function robloxLocale(): string
	local ok, locale = pcall(function()
		return LocalizationService.RobloxLocaleId
	end)
	if ok and type(locale) == "string" and locale ~= "" then
		return locale
	end
	return player.LocaleId
end

local savedLanguage = SettingsController.Get("language")
local detectedLanguage = Localization.Detect(robloxLocale()) or Config.FallbackLanguage
Localization.SetLanguage(savedLanguage or detectedLanguage)

if RunService:IsStudio() then
	for _, problem in Localization.Validate() do
		warn("[FZ-Loc] " .. problem)
	end
end

---------------------------------------------------------------------------
-- 3. Controllers and HUD
---------------------------------------------------------------------------
local state = "boot" -- boot | language | menu | playing | paused
local router = Router.new(menuGui, InputController)

local controls = nil
local function getControls()
	if controls then
		return controls
	end
	local ok, result = pcall(function()
		local playerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript)
		return (playerModule :: any):GetControls()
	end)
	if ok then
		controls = result
	else
		warn("[FZ] PlayerModule controls unavailable: " .. tostring(result))
	end
	return controls
end

local function setGameplay(enabled: boolean)
	InputController.SetGameplayEnabled(enabled)
	MovementController.SetActive(enabled)
	-- No world interactions (E / X / tap prompts) while a menu or document is open.
	pcall(function()
		(ProximityPromptService :: any).Enabled = enabled
	end)
	if not enabled then
		RadioController.Stop()
	end
	EquipmentController.SetActive(enabled)
	local c = getControls()
	if c then
		if enabled then
			c:Enable()
		else
			c:Disable()
		end
	end
end

-- Title screen camera: slow dolly shots between the FZ_MenuCamera anchors (ordered by
-- their "Shot" attribute), with short black cuts. One anchor = one slow drifting shot.
local menuCameraConnection: RBXScriptConnection? = nil
local SHOT_SECONDS = 14
local function menuShots(): { BasePart }
	local shots = {}
	for _, anchor in CollectionService:GetTagged("FZ_MenuCamera") do
		if anchor:IsA("BasePart") then
			table.insert(shots, anchor)
		end
	end
	table.sort(shots, function(a, b)
		return (a:GetAttribute("Shot") or 0) < (b:GetAttribute("Shot") or 0)
	end)
	return shots
end
local function setMenuCamera(active: boolean)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if menuCameraConnection then
		menuCameraConnection:Disconnect()
		menuCameraConnection = nil
	end
	cutFrame.BackgroundTransparency = 1
	if active then
		local shots = menuShots()
		if #shots == 0 then
			return
		end
		camera.CameraType = Enum.CameraType.Scriptable
		camera.FieldOfView = 62
		local index, elapsed = 1, 0
		local calm = SettingsController.Get("cameraEffects") == "off"
		menuCameraConnection = RunService.RenderStepped:Connect(function(dt)
			elapsed += dt
			if elapsed >= SHOT_SECONDS and #shots > 1 then
				elapsed = 0
				index = index % #shots + 1
			end
			local anchor = shots[index]
			if not anchor.Parent then
				return
			end
			local t = elapsed / SHOT_SECONDS
			local drift = anchor:GetAttribute("Drift") or 6
			local offset = if calm then CFrame.new() else CFrame.new((t - 0.5) * drift, math.sin(t * math.pi) * 0.4, -(t * drift * 0.35)) * CFrame.Angles(0, (0.5 - t) * 0.04, 0)
			camera.CFrame = anchor.CFrame * offset
			-- black cut at the end/start of each shot
			if #shots > 1 then
				local edge = math.min(elapsed, SHOT_SECONDS - elapsed)
				cutFrame.BackgroundTransparency = math.clamp(edge / 0.6, 0, 1)
			end
		end)
	else
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = Config.Movement.BaseFov
	end
end

-- Menu blur: the world softens behind any open menu while playing (pause, documents).
local Lighting = game:GetService("Lighting")
local menuBlur = Instance.new("BlurEffect")
menuBlur.Name = "FZ_MenuBlur"
menuBlur.Size = 0
menuBlur.Parent = Lighting
local function setMenuBlur(on: boolean)
	TweenService:Create(menuBlur, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Size = if on then 14 else 0 }):Play()
end

GraphicsController.Init(SettingsController)
AtmosphereController.Init(SettingsController)
WorldTextController.Init()
Hud.Init(hudGui, SettingsController, InputController, {
	onOpen = function()
		setGameplay(false)
	end,
	onClose = function()
		if state == "playing" then
			setGameplay(true)
		end
	end,
})
DebugOverlay.Init(hudGui, {
	profile = GraphicsController.GetProfileName,
	quality = GraphicsController.GetRobloxQualityLevel,
	device = InputController.GetDevice,
	input = function()
		return if InputController.IsUsingActionSystem() then "IAS" else "UIS"
	end,
})
MovementController.Init(SettingsController, Hud.SetStamina)
FlashlightController.Init()
AudioController.Init(SettingsController)
VoiceController.SetVolume((SettingsController.Get("volumeVoice") or 10) / 10)
SettingsController.Changed:Connect(function(key, value)
	if key == "volumeVoice" then
		VoiceController.SetVolume(value / 10)
	end
end)
VoiceController.Init()
RadioController.Init(hudGui, SettingsController)
CreatureVisualsController.Init(Hud.ShowSubtitle)
HealthController.Init(hudGui, SettingsController)
EquipmentController.Init()
DirectorController.Init(SettingsController, Hud.ShowSubtitle)
DecisionPanel.Init(hudGui, InputController)
InventoryController.Init(hudGui)
PromptController.Init()
RescueController.Init(hudGui)

-- Forecast countdown (the prediction you can break)
local function updateForecast()
	local key = SessionState.Get("Forecast")
	local ends = SessionState.Get("ForecastEnds")
	if type(key) == "string" and type(ends) == "number" then
		Hud.SetForecast(key, ends - workspace:GetServerTimeNow())
	else
		Hud.SetForecast(nil)
	end
end
SessionState.Observe("Forecast", updateForecast)
task.spawn(function()
	while true do
		task.wait(0.5)
		if SessionState.Get("Forecast") then
			updateForecast()
		end
	end
end)

-- Scare intensity: creature sounds are mixed down on "reduced" (medic set dampens too).
local function applyScareMix()
	local level = SettingsController.Get("scareIntensity")
	local volume = if level == "reduced" then 0.55 elseif level == "intense" then 1 else 0.85
	if player:GetAttribute("FZ_ScareDampening") then
		volume *= 0.8
	end
	AudioController.SetScareFactor(volume)
end
applyScareMix()
SettingsController.Changed:Connect(applyScareMix)
player:GetAttributeChangedSignal("FZ_ScareDampening"):Connect(applyScareMix)

if not VoiceController.IsAvailable() then
	task.delay(8, function()
		Hud.Notify("VOICE_UNAVAILABLE")
	end)
end

Net.Event("Subtitle").OnClientEvent:Connect(Hud.ShowSubtitle)
Net.Event("Document").OnClientEvent:Connect(Hud.ShowDocument)
Net.Event("Photo").OnClientEvent:Connect(function(photo)
	if type(photo) ~= "table" or type(photo.id) ~= "string" then
		return
	end
	local entry = nil
	for _, item in require(Shared.Lore) do
		if item.id == photo.id then
			entry = item
		end
	end
	if entry then
		Hud.ShowDocument({ title = entry.title, body = entry.body, photo = photo })
	end
end)
Net.Event("Notify").OnClientEvent:Connect(function(key, params)
	if type(key) == "string" then
		Hud.Notify(key, if type(params) == "table" then params else nil)
	end
end)
local function objectiveParams(): { [string]: any }?
	local raw = SessionState.Get("ObjectiveParams")
	if type(raw) ~= "string" then
		return nil
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	return if ok and type(decoded) == "table" then decoded else nil
end
local function showObjective(announce: boolean?)
	local key = SessionState.Get("Objective")
	if state == "playing" and type(key) == "string" then
		Hud.ShowObjective(key, announce, objectiveParams())
	end
end
SessionState.Observe("Objective", function()
	showObjective()
end)
SessionState.Observe("ObjectiveParams", function()
	showObjective()
end)

---------------------------------------------------------------------------
-- 4. App flow
---------------------------------------------------------------------------
local sessionRemote = Net.Function("Session")
local pauseOpenedAt = 0
local leaving = false

local app = {
	Settings = SettingsController,
	Input = InputController,
	Hud = Hud,
	Debug = DebugOverlay,
	Profile = profile,
	Voice = VoiceController,
	Radio = RadioController,
}
router.App = app
router.ShouldIgnoreBack = Hud.IsDocumentOpen

function app.HasProgress(): boolean
	return profile.isNew == false
end

function app.HasNewContent(): boolean
	local seen = profile.seenContent or {}
	for _, entry in Content.Chapters do
		if entry.since and entry.status == "available" and not seen[entry.id] then
			return true
		end
	end
	for _, entry in Content.SurvivalMaps do
		if entry.since and entry.status == "available" and not seen[entry.id] then
			return true
		end
	end
	return false
end

function app.HasNewUpdate(): boolean
	local newest = Updates[1]
	return newest ~= nil and profile.lastSeenUpdate ~= newest.id
end

local function enterGame()
	setMenuBlur(false)
	AudioController.SetMenu(false)
	state = "playing"
	router:Clear()
	backdrop.Visible = false
	setMenuCamera(false)
	setGameplay(true)
	showObjective(false)
end

local function showMainMenu()
	setMenuBlur(false)
	AudioController.SetMenu(true)
	state = "menu"
	setGameplay(false)
	backdrop.Visible = true
	setMenuCamera(true)
	Hud.SetStatus(nil)
	router:Replace(MainMenu, { mode = "main" })
end

local function callSession(action: string, mode: string?, contentId: string?)
	local ok, result = pcall(function()
		return sessionRemote:InvokeServer(action, mode, contentId)
	end)
	return if ok and type(result) == "table" then result else { status = "error" }
end

local SESSION_MESSAGES = { teleport = "SESSION_TELEPORT", locked = "SESSION_LOCKED", error = "SESSION_ERROR" }

-- Start (or join) a chapter / survival map chosen in the Play screen.
function app.Start(mode: string, contentId: string)
	local result = callSession("start", mode, contentId)
	if result.status == "ok" then
		enterGame()
	elseif result.status == "busy" then
		local entry = Content.Entry(result.mode, result.contentId)
		Hud.Notify("SESSION_BUSY", { name = if entry then Localization.T(entry.title) else "?" })
	else
		Hud.Notify(SESSION_MESSAGES[result.status] or "SESSION_ERROR")
	end
end

-- Join whatever the team in this server is playing.
function app.Join()
	local result = callSession("join")
	if result.status == "ok" then
		enterGame()
	else
		router:Push(require(UI.Screens.Play))
	end
end

-- Close the menu (pause) or, for owner tests, walk around without a session.
function app.Resume()
	AudioController.SetMenu(false)
	if state == "paused" or state == "menu" then
		state = "playing"
		router:Clear()
		backdrop.Visible = false
		setMenuBlur(false)
		setMenuCamera(false)
		setGameplay(true)
	end
end

function app.CreatePrivate()
	local result = callSession("private")
	Hud.Notify(if result.status == "teleport" then "SESSION_TELEPORT" elseif result.status == "invited" then "PARTY_SENT" else "SESSION_ERROR")
end

function app.Rejoin()
	local result = callSession("rejoin")
	Hud.Notify(if result.status == "teleport" then "SESSION_TELEPORT" else "SESSION_ERROR")
end

function app.Leave()
	leaving = true
	callSession("leave")
	leaving = false
	showMainMenu()
end

-- The server ended the session (chapter finished, run over, idle): back to the menu.
player:GetAttributeChangedSignal("FZ_InGame"):Connect(function()
	if player:GetAttribute("FZ_InGame") ~= true and not leaving and (state == "playing" or state == "paused") then
		if not player:GetAttribute("FZ_MonsterMode") then
			Hud.CloseDocument()
			task.delay(0.5, showMainMenu)
		end
	end
end)

-- Survival status line
local function updateStatus()
	local shift = SessionState.Get("SvShift")
	if type(shift) ~= "number" or shift <= 0 then
		Hud.SetStatus(nil)
		return
	end
	local phase = SessionState.Get("SvPhase")
	if phase == "break" or phase == "evac" then
		local ends = SessionState.Get("SvBreakEnds")
		local seconds = if type(ends) == "number" then math.max(0, math.ceil(ends - workspace:GetServerTimeNow())) else 0
		Hud.SetStatus(if phase == "evac" then "SV_EVAC_TIMER" else "SV_VOTE_TIMER", { seconds = seconds })
	else
		local event = SessionState.Get("SvEvent")
		Hud.SetStatus("SV_SHIFT", { shift = shift }, if type(event) == "string" then event else nil)
	end
end
for _, key in { "SvShift", "SvEvent", "SvPhase", "SvBreakEnds" } do
	SessionState.Observe(key, updateStatus)
end
task.spawn(function()
	while true do
		task.wait(1)
		if SessionState.Get("SvPhase") == "break" or SessionState.Get("SvPhase") == "evac" then
			updateStatus()
		end
	end
end)
Localization.Changed:Connect(updateStatus)

local function openPause()
	if state ~= "playing" or Hud.IsDocumentOpen() then
		return
	end
	state = "paused"
	pauseOpenedAt = os.clock()
	setGameplay(false)
	backdrop.Visible = true
	setMenuBlur(true)
	router:Replace(MainMenu, { mode = "pause" })
end

InputController.Action:Connect(function(name, pressed)
	if name == "Pause" and pressed then
		openPause()
	end
end)

-- The same buttons close the in-game menu again (only from its first page).
UserInputService.InputBegan:Connect(function(input)
	if state ~= "paused" or #router.Stack ~= 1 or os.clock() - pauseOpenedAt < 0.25 then
		return
	end
	local key = input.KeyCode
	if key == Enum.KeyCode.ButtonSelect or (key == Enum.KeyCode.P and not UserInputService:GetFocusedTextBox()) then
		app.Resume()
	end
end)

local function afterMenu()
	-- Arrived by teleport with a selection: straight into the session.
	if player:GetAttribute("FZ_AutoJoin") then
		app.Join()
	end
end

setGameplay(false)
if savedLanguage == nil then
	state = "language"
	backdrop.Visible = true
	router:Replace(LanguageSelect, {
		firstStart = true,
		suggested = detectedLanguage,
		onChosen = function(code: string)
			SettingsController.Set("language", code)
			showMainMenu()
			afterMenu()
		end,
	})
else
	showMainMenu()
	afterMenu()
end

if player:GetAttribute("FZ_DataTooNew") then
	Hud.Notify("ERROR_DATA_NEWER")
elseif player:GetAttribute("FZ_DataPersistent") == false then
	Hud.Notify("ERROR_DATA")
end

---------------------------------------------------------------------------
-- 5. Remove boot screen (fade)
---------------------------------------------------------------------------
local boot = player:WaitForChild("PlayerGui"):FindFirstChild("FZ_Boot")
if boot then
	local background = boot:FindFirstChild("Background")
	if background then
		for _, child in background:GetDescendants() do
			if child:IsA("TextLabel") then
				TweenService:Create(child, Theme.Slow, { TextTransparency = 1 }):Play()
			elseif child:IsA("Frame") then
				TweenService:Create(child, Theme.Slow, { BackgroundTransparency = 1 }):Play()
			end
		end
		local fade = TweenService:Create(background, Theme.Slow, { BackgroundTransparency = 1 })
		fade.Completed:Once(function()
			boot:Destroy()
		end)
		fade:Play()
	else
		boot:Destroy()
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="9315">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="9316">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source"><![CDATA[-- Components: small set of UI building blocks shared by every screen.
-- All text goes through Localization.Bind, so language changes update instantly and
-- Roblox auto-translation never touches our text.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Localization = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Localization"))
local Theme = require(script.Parent.Theme)
local AudioController = require(script.Parent.Parent.Controllers.AudioController)

local lastFocusSound = 0
local function focusSound()
	if os.clock() - lastFocusSound > 0.06 then
		lastFocusSound = os.clock()
		AudioController.UI("ui_focus")
	end
end

local Components = {}

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

-- Shared invisible selection object: we draw our own focus state instead of Roblox's box.
local hiddenSelection = Instance.new("Frame")
hiddenSelection.BackgroundTransparency = 1
hiddenSelection.Size = UDim2.fromScale(1, 1)

function Components.ScreenGui(name: string, displayOrder: number, fullBleed: boolean?): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.DisplayOrder = displayOrder
	gui.AutoLocalize = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.ScreenInsets = if fullBleed then Enum.ScreenInsets.None else Enum.ScreenInsets.CoreUISafeInsets
	gui.Parent = playerGui
	return gui
end

-- Responsive scaling: logical layout at 720p height, clamped so touch targets stay large
-- on phones and text does not become huge on 4K screens.
function Components.AttachScale(gui: ScreenGui): UIScale
	local scale = Instance.new("UIScale")
	scale.Parent = gui
	local function update()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local viewport = camera.ViewportSize
		scale.Scale = math.clamp(viewport.Y / 720, 0.9, 1.5)
	end
	local connection
	local function bindCamera()
		if connection then
			connection:Disconnect()
		end
		local camera = workspace.CurrentCamera
		if camera then
			connection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
		end
		update()
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
	bindCamera()
	return scale
end

-- Height of the screen in layout units (after AttachScale): < 600 means phone-sized.
function Components.LogicalHeight(): number
	local camera = workspace.CurrentCamera
	if not camera then
		return 720
	end
	local y = camera.ViewportSize.Y
	return y / math.clamp(y / 720, 0.9, 1.5)
end

export type TextProps = {
	Name: string?,
	Key: string?,
	Params: { [string]: any }?,
	Text: string?,
	Font: Enum.Font?,
	TextSize: number?,
	Color: Color3?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	XAlign: Enum.TextXAlignment?,
	YAlign: Enum.TextYAlignment?,
	Wrapped: boolean?,
	AutoY: boolean?,
	RichText: boolean?,
	LayoutOrder: number?,
	Parent: Instance?,
}

function Components.Text(props: TextProps): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = props.Name or (props.Key or "Text")
	label.BackgroundTransparency = 1
	label.AutoLocalize = false
	label.Font = props.Font or Theme.Fonts.Body
	label.TextSize = props.TextSize or Theme.Sizes.TextBody
	label.TextColor3 = props.Color or Theme.Colors.Text
	label.TextXAlignment = props.XAlign or Enum.TextXAlignment.Left
	label.TextYAlignment = props.YAlign or Enum.TextYAlignment.Center
	label.TextWrapped = props.Wrapped ~= false
	label.RichText = props.RichText == true
	label.Size = props.Size or UDim2.new(1, 0, 0, (props.TextSize or Theme.Sizes.TextBody) + 8)
	if props.AutoY then
		label.AutomaticSize = Enum.AutomaticSize.Y
	end
	if props.Position then
		label.Position = props.Position
	end
	if props.AnchorPoint then
		label.AnchorPoint = props.AnchorPoint
	end
	label.LayoutOrder = props.LayoutOrder or 0
	if props.Key then
		Localization.Bind(label, props.Key, props.Params)
	else
		label.Text = props.Text or ""
	end
	label.Parent = props.Parent
	return label
end

function Components.List(parent: Instance, padding: number?, horizontal: boolean?): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, padding or Theme.Sizes.Gap)
	layout.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	layout.Parent = parent
	return layout
end

function Components.Padding(parent: Instance, left: number, top: number?, right: number?, bottom: number?)
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, left)
	padding.PaddingTop = UDim.new(0, top or left)
	padding.PaddingRight = UDim.new(0, right or left)
	padding.PaddingBottom = UDim.new(0, bottom or top or left)
	padding.Parent = parent
	return padding
end

export type ButtonProps = {
	Key: string?,
	Params: { [string]: any }?,
	Text: string?,
	TagKey: string?, -- small right-aligned hint ("Suggested", "No signal yet", ...)
	TagParams: { [string]: any }?,
	OnActivated: (() -> ())?,
	LayoutOrder: number?,
	Height: number?,
	Disabled: boolean?,
	Font: Enum.Font?,
	Index: number?, -- small "01" number in front of the label (menu lists)
	Centered: boolean?, -- tabs / short choice buttons: centred label, no chevron
	Parent: Instance?,
}

export type Button = {
	Instance: TextButton,
	Label: TextLabel,
	Tag: TextLabel,
	SetDisabled: (disabled: boolean) -> (),
	SetFocused: (focused: boolean) -> (),
}

function Components.Corner(parent: Instance, radius: number?): UICorner
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or Theme.Sizes.Corner)
	corner.Parent = parent
	return corner
end

function Components.Stroke(parent: Instance, color: Color3?, transparency: number?, thickness: number?): UIStroke
	local stroke = Instance.new("UIStroke")
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Color = color or Theme.Colors.PanelLine
	stroke.Transparency = transparency or 0.35
	stroke.Thickness = thickness or 1
	stroke.Parent = parent
	return stroke
end

-- Glass card: dark translucent panel with a soft top highlight and a hairline border.
function Components.Panel(props: { Name: string?, Size: UDim2?, Position: UDim2?, AnchorPoint: Vector2?, Transparency: number?, LayoutOrder: number?, Parent: Instance? }): Frame
	local panel = Instance.new("Frame")
	panel.Name = props.Name or "Panel"
	panel.BackgroundColor3 = Theme.Colors.Panel
	panel.BackgroundTransparency = props.Transparency or 0.18
	panel.BorderSizePixel = 0
	panel.Size = props.Size or UDim2.fromScale(1, 0)
	panel.Position = props.Position or UDim2.new()
	panel.AnchorPoint = props.AnchorPoint or Vector2.zero
	panel.LayoutOrder = props.LayoutOrder or 0
	Components.Corner(panel)
	Components.Stroke(panel, Theme.Colors.PanelLine, 0.45)
	local sheen = Instance.new("UIGradient")
	sheen.Rotation = 90
	sheen.Color = ColorSequence.new(Color3.fromRGB(255, 255, 255), Color3.fromRGB(170, 178, 186))
	sheen.Parent = panel
	panel.Parent = props.Parent
	return panel
end

function Components.Button(props: ButtonProps): Button
	local height = props.Height or Theme.Sizes.Button
	local compact = height < 44
	local button = Instance.new("TextButton")
	button.Name = props.Key or "Button"
	button.AutoButtonColor = false
	button.AutoLocalize = false
	button.Text = ""
	button.BackgroundColor3 = Theme.Colors.PanelRaised
	button.BackgroundTransparency = 0.45
	button.BorderSizePixel = 0
	button.ClipsDescendants = true
	button.Size = UDim2.new(1, 0, 0, height)
	button.LayoutOrder = props.LayoutOrder or 0
	button.Selectable = true
	button.SelectionImageObject = hiddenSelection
	Components.Corner(button, 5)
	local stroke = Components.Stroke(button, Theme.Colors.PanelLine, 0.6)

	-- Accent sweep: a red glow that slides in from the left on focus/hover.
	local sweep = Instance.new("Frame")
	sweep.Name = "Sweep"
	sweep.BackgroundColor3 = Theme.Colors.Accent
	sweep.BorderSizePixel = 0
	sweep.Size = UDim2.fromScale(0, 1)
	sweep.ZIndex = 0
	sweep.Parent = button
	local sweepGradient = Instance.new("UIGradient")
	sweepGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.62),
		NumberSequenceKeypoint.new(0.55, 0.9),
		NumberSequenceKeypoint.new(1, 1),
	})
	sweepGradient.Parent = sweep

	local bar = Instance.new("Frame")
	bar.Name = "FocusBar"
	bar.BackgroundColor3 = Theme.Colors.Accent
	bar.BorderSizePixel = 0
	bar.AnchorPoint = Vector2.new(0, 0.5)
	bar.Position = UDim2.fromScale(0, 0.5)
	bar.Size = UDim2.new(0, 3, 1, 0)
	bar.BackgroundTransparency = 1
	bar.Parent = button

	local centered = props.Centered == true
	local textLeft = if centered then 6 else 18
	local index: TextLabel? = nil
	if props.Index then
		index = Components.Text({
			Name = "Index",
			Text = string.format("%02d", props.Index),
			Font = Theme.Fonts.Mono,
			TextSize = 13,
			Color = Theme.Colors.TextFaint,
			Wrapped = false,
			Size = UDim2.new(0, 26, 1, 0),
			Position = UDim2.fromOffset(16, 0),
			Parent = button,
		})
		textLeft = 48
	end

	local label = Components.Text({
		Name = "Label",
		Key = props.Key,
		Params = props.Params,
		Text = props.Text,
		Font = props.Font or Theme.Fonts.Medium,
		TextSize = if compact then Theme.Sizes.TextSmall + 1 else Theme.Sizes.TextButton,
		Wrapped = false,
		Size = if centered then UDim2.new(1, -12, 1, 0) else UDim2.new(1, -(textLeft + 34), 1, 0),
		Position = UDim2.fromOffset(textLeft, 0),
		XAlign = if centered then Enum.TextXAlignment.Center else nil,
		Parent = button,
	})
	label.TextTruncate = Enum.TextTruncate.AtEnd
	if centered then
		-- tabs are narrow: shrink long labels ("Barrierefreiheit") instead of cutting them
		label.TextScaled = true
		local limit = Instance.new("UITextSizeConstraint")
		limit.MaxTextSize = label.TextSize
		limit.MinTextSize = 9
		limit.Parent = label
		label.Size = UDim2.new(1, -12, 0.62, 0)
		label.Position = UDim2.new(0, textLeft, 0.19, 0)
	end

	local chevron = Components.Text({
		Name = "Chevron",
		Text = "›",
		Font = Theme.Fonts.Bold,
		TextSize = if compact then 18 else 24,
		Color = Theme.Colors.TextFaint,
		XAlign = Enum.TextXAlignment.Center,
		Wrapped = false,
		AnchorPoint = Vector2.new(1, 0.5),
		Size = UDim2.new(0, 24, 1, 0),
		Position = UDim2.new(1, -8, 0.5, 0),
		Parent = button,
	})

	local tag = Components.Text({
		Name = "Tag",
		Key = props.TagKey,
		Params = props.TagParams,
		Font = Theme.Fonts.Mono,
		TextSize = Theme.Sizes.TextSmall - 1,
		Color = Theme.Colors.TextDim,
		XAlign = Enum.TextXAlignment.Right,
		Wrapped = false,
		Size = UDim2.new(0.45, -16, 1, 0),
		Position = UDim2.new(0.55, 0, 0, 0),
		Parent = button,
	})
	tag.Visible = props.TagKey ~= nil
	chevron.Visible = not centered
	if tag.Visible then
		-- the tag only takes what its text needs; the title gets the rest
		tag.AutomaticSize = Enum.AutomaticSize.X
		tag.Size = UDim2.new(0, 0, 1, 0)
		tag.AnchorPoint = Vector2.new(1, 0)
		tag.Position = UDim2.new(1, -14, 0, 0)
		label.Size = UDim2.new(0.68, -textLeft, 1, 0)
		chevron.Visible = false
	end

	local disabled = props.Disabled == true
	local focused = false
	local hovered = false
	local pressed = false

	local function render()
		local active = (focused or hovered) and not disabled
		TweenService:Create(bar, Theme.Fast, { BackgroundTransparency = if active then 0 else 1 }):Play()
		TweenService:Create(sweep, Theme.Fade, { Size = UDim2.fromScale(if active then 1 else 0, 1) }):Play()
		TweenService:Create(button, Theme.Fast, {
			BackgroundTransparency = if pressed and active then 0.05 elseif active then 0.2 else 0.45,
		}):Play()
		TweenService:Create(stroke, Theme.Fast, {
			Color = if active then Theme.Colors.Accent else Theme.Colors.PanelLine,
			Transparency = if active then 0.35 else 0.6,
		}):Play()
		TweenService:Create(label, Theme.Fast, {
			TextColor3 = if disabled then Theme.Colors.TextFaint elseif active then Theme.Colors.TextBright else Theme.Colors.Text,
			Position = if centered then UDim2.new(0, textLeft, 0.19, 0) else UDim2.fromOffset(if active then textLeft + 4 else textLeft, 0),
		}):Play()
		TweenService:Create(chevron, Theme.Fast, {
			TextColor3 = if active then Theme.Colors.Accent else Theme.Colors.TextFaint,
			Position = UDim2.new(1, if active then -4 else -8, 0.5, 0),
		}):Play()
		if index then
			TweenService:Create(index, Theme.Fast, { TextColor3 = if active then Theme.Colors.Accent else Theme.Colors.TextFaint }):Play()
		end
	end

	button.MouseEnter:Connect(function()
		hovered = true
		if not disabled then
			focusSound()
		end
		render()
	end)
	button.MouseLeave:Connect(function()
		hovered = false
		pressed = false
		render()
	end)
	button.MouseButton1Down:Connect(function()
		pressed = true
		render()
	end)
	button.MouseButton1Up:Connect(function()
		pressed = false
		render()
	end)
	button.SelectionGained:Connect(function()
		focused = true
		focusSound()
		render()
	end)
	button.SelectionLost:Connect(function()
		focused = false
		render()
	end)
	button.Activated:Connect(function()
		if disabled or not props.OnActivated then
			return
		end
		AudioController.UI("ui_select")
		props.OnActivated()
	end)

	render()
	button.Parent = props.Parent

	return {
		Instance = button,
		Label = label,
		Tag = tag,
		SetDisabled = function(value: boolean)
			disabled = value
			render()
		end,
		SetFocused = function(value: boolean)
			focused = value
			render()
		end,
	}
end

-- Scrollable vertical column. Gamepad selection scrolls it automatically.
function Components.ScrollColumn(parent: Instance, size: UDim2, position: UDim2?): ScrollingFrame
	local frame = Instance.new("ScrollingFrame")
	frame.Name = "Scroll"
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Size = size
	frame.Position = position or UDim2.new()
	frame.CanvasSize = UDim2.new()
	frame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	frame.ScrollingDirection = Enum.ScrollingDirection.Y
	frame.ScrollBarThickness = 3
	frame.ScrollBarImageColor3 = Theme.Colors.TextFaint
	frame.Selectable = false
	frame.Parent = parent
	Components.List(frame, Theme.Sizes.Gap)
	Components.Padding(frame, 2, 2, 8, 12)
	return frame
end

function Components.Heading(parent: Instance, key: string, layoutOrder: number?): TextLabel
	local heading = Components.Text({
		Key = key,
		Font = Theme.Fonts.Bold, -- Michroma is reserved for the Latin-only logo (accent coverage)
		TextSize = Theme.Sizes.TextHeading + 8,
		Color = Theme.Colors.TextBright,
		Size = UDim2.new(1, 0, 0, 52),
		LayoutOrder = layoutOrder or 0,
		Parent = parent,
	})
	heading.TextYAlignment = Enum.TextYAlignment.Top
	local rule = Instance.new("Frame")
	rule.Name = "Rule"
	rule.BackgroundColor3 = Theme.Colors.Accent
	rule.BorderSizePixel = 0
	rule.AnchorPoint = Vector2.new(0, 1)
	rule.Position = UDim2.new(0, 0, 1, -2)
	rule.Size = UDim2.fromOffset(36, 2)
	rule.Parent = heading
	local line = Instance.new("Frame")
	line.Name = "Line"
	line.BackgroundColor3 = Theme.Colors.PanelLine
	line.BackgroundTransparency = 0.5
	line.BorderSizePixel = 0
	line.AnchorPoint = Vector2.new(0, 1)
	line.Position = UDim2.new(0, 42, 1, -2.5)
	line.Size = UDim2.new(1, -42, 0, 1)
	line.Parent = heading
	return heading
end

function Components.Spacer(parent: Instance, height: number, layoutOrder: number)
	local spacer = Instance.new("Frame")
	spacer.BackgroundTransparency = 1
	spacer.Size = UDim2.new(1, 0, 0, height)
	spacer.LayoutOrder = layoutOrder
	spacer.Parent = parent
	return spacer
end

-- Standard screen root: a CanvasGroup (for fades) holding a left-aligned content column.
function Components.ScreenRoot(name: string): (CanvasGroup, Frame)
	local root = Instance.new("CanvasGroup")
	root.Name = name
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.GroupTransparency = 1

	-- Side slab: dark glass from the left edge, fading out towards the scene.
	local slab = Instance.new("Frame")
	slab.Name = "Slab"
	slab.BackgroundColor3 = Theme.Colors.Background
	slab.BorderSizePixel = 0
	slab.Size = UDim2.new(0, Theme.Sizes.Margin * 2 + Theme.Sizes.ContentWidth + 120, 1, 0)
	slab.ZIndex = 0
	slab.Parent = root
	local fade = Instance.new("UIGradient")
	fade.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.12),
		NumberSequenceKeypoint.new(0.72, 0.3),
		NumberSequenceKeypoint.new(1, 1),
	})
	fade.Parent = slab
	local edge = Instance.new("Frame")
	edge.Name = "Edge"
	edge.BackgroundColor3 = Theme.Colors.Accent
	edge.BackgroundTransparency = 0.2
	edge.BorderSizePixel = 0
	edge.Size = UDim2.new(0, 2, 1, 0)
	edge.Parent = root
	local edgeFade = Instance.new("UIGradient")
	edgeFade.Rotation = 90
	edgeFade.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.5, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	edgeFade.Parent = edge

	local column = Instance.new("Frame")
	column.Name = "Column"
	column.BackgroundTransparency = 1
	column.AnchorPoint = Vector2.new(0, 0.5)
	column.Position = UDim2.new(0, Theme.Sizes.Margin, 0.5, 0)
	column.Size = UDim2.new(0, Theme.Sizes.ContentWidth, 1, -64)
	column.Parent = root
	local constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = Vector2.new(Theme.Sizes.ContentWidth, math.huge)
	constraint.Parent = column
	return root, column
end

-- Full-screen vignette (four soft edges, no image assets needed).
function Components.Vignette(parent: Instance, strength: number?): Frame
	local holder = Instance.new("Frame")
	holder.Name = "Vignette"
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromScale(1, 1)
	holder.ZIndex = 50
	holder.Active = false
	holder.Parent = parent
	local s = strength or 0.35
	for i, rotation in { 0, 90, 180, 270 } do
		local edge = Instance.new("Frame")
		edge.Name = "Edge" .. i
		edge.BackgroundColor3 = Color3.new(0, 0, 0)
		edge.BorderSizePixel = 0
		edge.AnchorPoint = Vector2.new(0.5, 0.5)
		edge.Position = UDim2.fromScale(0.5, 0.5)
		edge.Size = if rotation % 180 == 0 then UDim2.fromScale(1, 1) else UDim2.fromScale(1, 1)
		edge.ZIndex = 50
		edge.Parent = holder
		local g = Instance.new("UIGradient")
		g.Rotation = rotation
		g.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1 - s),
			NumberSequenceKeypoint.new(0.22, 1),
			NumberSequenceKeypoint.new(1, 1),
		})
		g.Parent = edge
	end
	return holder
end

return Components
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9317">
            <Properties>
              <string name="Name">DebugOverlay</string>
              <string name="Source"><![CDATA[-- DebugOverlay: real measured performance numbers (admin only, toggled from Maintenance).
-- Runs no per-frame work while hidden.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local Components = require(script.Parent.Components)
local Theme = require(script.Parent.Theme)

local DebugOverlay = {}

local label: TextLabel? = nil
local connection: RBXScriptConnection? = nil
local providers = {}

function DebugOverlay.Init(gui: ScreenGui, infoProviders)
	providers = infoProviders
	label = Components.Text({
		Name = "Debug",
		Text = "",
		Font = Theme.Fonts.Mono,
		TextSize = 14,
		Color = Theme.Colors.TextBright,
		XAlign = Enum.TextXAlignment.Right,
		Size = UDim2.new(0, 520, 0, 20),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -136, 0, 18),
		Parent = gui,
	})
	;(label :: TextLabel).TextStrokeTransparency = 0.4
	;(label :: TextLabel).Visible = false
end

function DebugOverlay.IsVisible(): boolean
	return connection ~= nil
end

function DebugOverlay.Toggle()
	local l = label :: TextLabel
	if connection then
		connection:Disconnect()
		connection = nil
		l.Visible = false
		return
	end
	l.Visible = true
	local frames, elapsed, worst = 0, 0, 0
	connection = RunService.RenderStepped:Connect(function(dt)
		frames += 1
		elapsed += dt
		worst = math.max(worst, dt)
		if elapsed < 0.5 then
			return
		end
		local fps = frames / elapsed
		local ping = math.floor(Players.LocalPlayer:GetNetworkPing() * 1000 + 0.5)
		local memory = math.floor(Stats:GetTotalMemoryUsageMb())
		l.Text = string.format(
			"%d FPS (min %d) | %d ms | %d MB | %s Q%d | %s | %s",
			math.floor(fps + 0.5),
			math.floor(1 / worst + 0.5),
			ping,
			memory,
			providers.profile(),
			providers.quality(),
			providers.device(),
			providers.input()
		)
		frames, elapsed, worst = 0, 0, 0
	end)
end

return DebugOverlay
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9318">
            <Properties>
              <string name="Name">DecisionPanel</string>
              <string name="Source"><![CDATA[-- DecisionPanel: the team vote UI. Big buttons, live vote counts, a time bar.
-- Mouse is freed while it is open (first person), gamepad focus jumps to the first option,
-- touch just taps. Movement keeps working - the world does not pause for a vote.

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local Components = require(script.Parent.Components)
local Theme = require(script.Parent.Theme)

local DecisionPanel = {}

local root: Frame
local promptLabel: TextLabel
local optionsRow: Frame
local timeBar: Frame
local current: { [string]: any }? = nil
local myVote: number? = nil
local buttons: { any } = {}
local timer: RBXScriptConnection? = nil
local input = nil

local function close()
	current = nil
	myVote = nil
	root.Visible = false
	if timer then
		timer:Disconnect()
		timer = nil
	end
	if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(root) then
		GuiService.SelectedObject = nil
	end
end

local function render(decision)
	local changed = not current or current.id ~= decision.id
	if changed then
		decision.total = math.max(1, decision.ends - workspace:GetServerTimeNow())
	else
		decision.total = (current :: any).total
	end
	current = decision
	root.Visible = true
	Localization.Bind(promptLabel, decision.prompt, decision.promptParams)
	if changed then
		myVote = nil
		for _, b in buttons do
			b.Instance:Destroy()
		end
		table.clear(buttons)
		for index, key in decision.options do
			local button = Components.Button({
				Key = key,
				TagKey = "DECISION_VOTES",
				TagParams = { count = 0 },
				LayoutOrder = index,
				Parent = optionsRow,
				OnActivated = function()
					if current and current.id == decision.id then
						myVote = index
						Net.Event("DecisionVote"):FireServer(decision.id, index)
						for i, b in buttons do
							b.SetFocused(i == index)
						end
					end
				end,
			})
			button.Instance.Size = UDim2.new(1 / #decision.options, -6, 1, 0)
			table.insert(buttons, button)
		end
		if input.GetDevice() == "gamepad" and buttons[1] then
			GuiService.SelectedObject = buttons[1].Instance
		end
	end
	for index, button in buttons do
		Localization.Bind(button.Tag, "DECISION_VOTES", { count = decision.counts[index] or 0 })
		button.Tag.Visible = true
	end
	if not timer then
		timer = RunService.Heartbeat:Connect(function()
			local d = current
			if not d then
				return
			end
			local remaining = math.max(0, d.ends - workspace:GetServerTimeNow())
			timeBar.Size = UDim2.new(math.clamp(remaining / (d.total or 20), 0, 1), 0, 0, 2)
		end)
	end
end

function DecisionPanel.Init(hudGui: ScreenGui, inputController)
	input = inputController
	root = Instance.new("Frame")
	root.Name = "Decision"
	root.AnchorPoint = Vector2.new(0.5, 1)
	root.Position = UDim2.new(0.5, 0, 1, -150)
	root.Size = UDim2.fromOffset(560, 120)
	root.BackgroundColor3 = Theme.Colors.Panel
	root.BackgroundTransparency = 0.1
	root.BorderSizePixel = 0
	root.Visible = false
	root.ZIndex = 15
	root.Parent = hudGui
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Colors.Relay
	stroke.Transparency = 0.4
	stroke.Parent = root
	Components.Padding(root, 14, 10)
	local unlock = Instance.new("TextButton")
	unlock.Modal = true
	unlock.Text = ""
	unlock.BackgroundTransparency = 1
	unlock.Size = UDim2.fromOffset(0, 0)
	unlock.Selectable = false
	unlock.Parent = root

	promptLabel = Components.Text({ Text = "", Font = Theme.Fonts.Medium, TextSize = Theme.Sizes.TextBody, Color = Theme.Colors.TextBright, XAlign = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 28), Parent = root })
	optionsRow = Instance.new("Frame")
	optionsRow.BackgroundTransparency = 1
	optionsRow.Position = UDim2.fromOffset(0, 36)
	optionsRow.Size = UDim2.new(1, 0, 0, Theme.Sizes.Button)
	optionsRow.Parent = root
	Components.List(optionsRow, 8, true)
	timeBar = Instance.new("Frame")
	timeBar.BackgroundColor3 = Theme.Colors.Relay
	timeBar.BorderSizePixel = 0
	timeBar.AnchorPoint = Vector2.new(0, 1)
	timeBar.Position = UDim2.fromScale(0, 1)
	timeBar.Size = UDim2.new(1, 0, 0, 2)
	timeBar.Parent = root

	Net.Event("Decision").OnClientEvent:Connect(function(decision)
		if type(decision) ~= "table" then
			close()
		else
			render(decision)
		end
	end)
end

return DecisionPanel
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9319">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- HUD: deliberately minimal. Nothing is permanently on screen; every element appears in
-- context and fades away again.
--   * Subtitles (radio / voices / sound captions). Safety-relevant captions ("critical")
--     are shown even when subtitles are turned off.
--   * Objective toast
--   * Document reader (fax, notes)
--   * Short notifications
--   * Stamina line (only while not full)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Localization = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Localization"))

local Components = require(script.Parent.Components)
local PhotoView = require(script.Parent.PhotoView)
local AudioController = require(script.Parent.Parent.Controllers.AudioController)
local Theme = require(script.Parent.Theme)

local Hud = {}

local SUBTITLE_SIZES = { small = 18, medium = 22, large = 28 }
local MAX_LINES = 3

local gui: ScreenGui
local settings
local input
local subtitleFrame: Frame
local objectiveFrame: CanvasGroup
local objectiveText: TextLabel
local notifyLabel: TextLabel
local staminaTrack: Frame
local staminaFill: Frame
local documentLayer: Frame? = nil
local documentCallbacks: { onOpen: () -> (), onClose: () -> () }? = nil

type ActiveLine = { label: TextLabel, pill: Frame, line: { [string]: any }, expires: number }
local activeLines: { ActiveLine } = {}
local currentObjective: string? = nil
local objectiveToken = 0
local notifyToken = 0
local lineCounter = 0

local function escape(text: string): string
	return (string.gsub(text, "[<>&]", { ["<"] = "&lt;", [">"] = "&gt;", ["&"] = "&amp;" }))
end

local function escapeParams(params: { [string]: any }?): { [string]: any }?
	if not params then
		return nil
	end
	local out = {}
	for key, value in params do
		out[key] = escape(tostring(value))
	end
	return out
end

local function subtitleText(line: { [string]: any }): string
	-- Base strings are ours (no markup); only runtime params (e.g. player names) are escaped.
	local text = Localization.T(line.text, escapeParams(line.params))
	if line.speaker then
		local color = if line.speaker == "SPEAKER_RELAY" then Theme.Colors.Relay else Theme.Colors.Radio
		return string.format('<font color="%s">%s</font>  %s', Theme.Hex(color), escape(Localization.T(line.speaker)), text)
	end
	return string.format('<font color="%s"><i>%s</i></font>', Theme.Hex(Theme.Colors.World), text)
end

local function subtitleSize(): number
	return SUBTITLE_SIZES[settings.Get("subtitleSize")] or SUBTITLE_SIZES.medium
end

local function removeLine(entry: ActiveLine)
	local index = table.find(activeLines, entry)
	if index then
		table.remove(activeLines, index)
	end
	TweenService:Create(entry.pill, Theme.Fade, { BackgroundTransparency = 1 }):Play()
	local tween = TweenService:Create(entry.label, Theme.Fade, { TextTransparency = 1, TextStrokeTransparency = 1 })
	tween.Completed:Once(function()
		entry.pill:Destroy()
	end)
	tween:Play()
end

function Hud.ShowSubtitle(line: { [string]: any })
	if type(line) ~= "table" or type(line.text) ~= "string" then
		return
	end
	if not settings.Get("subtitles") and not line.critical then
		return
	end
	if #activeLines >= MAX_LINES then
		removeLine(activeLines[1])
	end
	-- each line sits on its own dark pill: readable on bright and dark scenes alike
	local pill = Instance.new("Frame")
	pill.Name = "Line"
	pill.BackgroundColor3 = Color3.fromRGB(4, 6, 8)
	pill.BackgroundTransparency = 1
	pill.BorderSizePixel = 0
	pill.AutomaticSize = Enum.AutomaticSize.XY
	pill.Size = UDim2.new()
	Components.Corner(pill, 6)
	Components.Padding(pill, 14, 6)
	lineCounter += 1
	pill.LayoutOrder = lineCounter
	pill.Parent = subtitleFrame
	if line.speaker then
		local accent = Instance.new("Frame")
		accent.Name = "Accent"
		accent.BackgroundColor3 = if line.speaker == "SPEAKER_RELAY" then Theme.Colors.Relay else Theme.Colors.Radio
		accent.BorderSizePixel = 0
		accent.Position = UDim2.new(0, -14, 0, -6)
		accent.Size = UDim2.new(0, 2, 1, 12)
		accent.Parent = pill
	end
	local label = Components.Text({
		Name = "Text",
		Text = "",
		RichText = true,
		Font = Theme.Fonts.Medium,
		TextSize = subtitleSize(),
		Color = Theme.Colors.TextBright,
		XAlign = Enum.TextXAlignment.Center,
		Size = UDim2.new(),
		Parent = pill,
	})
	label.AutomaticSize = Enum.AutomaticSize.XY
	local maxWidth = Instance.new("UISizeConstraint")
	maxWidth.MaxSize = Vector2.new(780, math.huge)
	maxWidth.Parent = label
	label.Text = subtitleText(line)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 1
	label.TextTransparency = 1
	TweenService:Create(label, Theme.Fast, { TextTransparency = 0, TextStrokeTransparency = 0.7 }):Play()
	TweenService:Create(pill, Theme.Fast, { BackgroundTransparency = 0.38 }):Play()

	local duration = math.clamp(tonumber(line.duration) or 4, 1.5, 12)
	if line.speaker then
		AudioController.Duck(duration) -- voices sit on top of the mix
	end
	local entry: ActiveLine = { label = label, pill = pill, line = line, expires = os.clock() + duration }
	table.insert(activeLines, entry)
	task.delay(duration, function()
		if table.find(activeLines, entry) then
			removeLine(entry)
		end
	end)
end

function Hud.ShowObjective(key: string?, announce: boolean?, params: { [string]: any }?)
	currentObjective = key
	if not key then
		objectiveFrame.Visible = false
		return
	end
	Localization.Bind(objectiveText, key, params)
	objectiveToken += 1
	local token = objectiveToken
	objectiveFrame.Visible = true
	objectiveFrame.GroupTransparency = 1
	objectiveFrame.Position = UDim2.fromOffset(4, 16)
	TweenService:Create(objectiveFrame, Theme.Slow, { GroupTransparency = 0, Position = UDim2.fromOffset(24, 16) }):Play()
	task.delay(if announce == false then 4 else 7, function()
		if token == objectiveToken then
			TweenService:Create(objectiveFrame, Theme.Slow, { GroupTransparency = 1 }):Play()
		end
	end)
end

function Hud.Notify(key: string, params: { [string]: any }?)
	-- params may carry text keys (e.g. an achievement name): show them translated
	if params then
		local translated = {}
		for name, value in params do
			translated[name] = if type(value) == "string" and string.match(value, "^[A-Z][A-Z0-9_]+$") and Localization.Has(value) then Localization.T(value) else value
		end
		params = translated
	end
	notifyToken += 1
	local token = notifyToken
	Localization.Bind(notifyLabel, key, params)
	local toast = notifyLabel.Parent :: CanvasGroup
	toast.Visible = true
	notifyLabel.Visible = true
	toast.GroupTransparency = 1
	toast.Position = UDim2.new(0.5, 0, 0, 6)
	TweenService:Create(toast, Theme.Fade, { GroupTransparency = 0, Position = UDim2.new(0.5, 0, 0, 18) }):Play()
	task.delay(4, function()
		if token == notifyToken then
			TweenService:Create(toast, Theme.Slow, { GroupTransparency = 1 }):Play()
		end
	end)
end

function Hud.SetStamina(value: number, exhausted: boolean)
	local visible = value < 0.999
	if staminaTrack.Visible ~= visible then
		staminaTrack.Visible = visible
	end
	staminaFill.Size = UDim2.fromScale(value, 1)
	staminaFill.BackgroundColor3 = if exhausted then Theme.Colors.Accent else Theme.Colors.Text
end

local function formatDate(unix: number): string
	local t = os.date("*t", unix)
	return Localization.T("DATE_FORMAT", {
		d = string.format("%02d", t.day),
		m = string.format("%02d", t.month),
		y = tostring(t.year),
	})
end

function Hud.IsDocumentOpen(): boolean
	return documentLayer ~= nil
end

function Hud.CloseDocument()
	if not documentLayer then
		return
	end
	documentLayer:Destroy()
	documentLayer = nil
	GuiService.SelectedObject = nil
	if documentCallbacks then
		documentCallbacks.onClose()
	end
end

function Hud.ShowDocument(document: { [string]: any })
	if type(document) ~= "table" or type(document.title) ~= "string" or type(document.body) ~= "string" then
		return
	end
	Hud.CloseDocument()

	local layer = Instance.new("Frame")
	layer.Name = "Document"
	layer.BackgroundColor3 = Color3.new(0, 0, 0)
	layer.BackgroundTransparency = 0.35
	layer.Size = UDim2.fromScale(1, 1)
	layer.ZIndex = 20
	layer.Parent = gui
	documentLayer = layer

	local unlock = Instance.new("TextButton")
	unlock.Modal = true
	unlock.Text = ""
	unlock.BackgroundTransparency = 1
	unlock.Size = UDim2.fromOffset(0, 0)
	unlock.Selectable = false
	unlock.Parent = layer

	local panel = Instance.new("Frame")
	panel.Name = "Paper"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.new(0, 520, 0, 0)
	panel.AutomaticSize = Enum.AutomaticSize.Y
	panel.BackgroundColor3 = Theme.Colors.Panel
	panel.BorderSizePixel = 0
	panel.ZIndex = 21
	panel.Parent = layer
	local sizeLimit = Instance.new("UISizeConstraint")
	sizeLimit.MaxSize = Vector2.new(520, 600)
	sizeLimit.Parent = panel
	Components.Corner(panel, 8)
	Components.Stroke(panel, Theme.Colors.PanelLine, 0.3)
	local topBar = Instance.new("Frame")
	topBar.Name = "TopBar"
	topBar.BackgroundColor3 = Theme.Colors.Accent
	topBar.BorderSizePixel = 0
	topBar.Size = UDim2.fromOffset(40, 2)
	topBar.LayoutOrder = -1
	topBar.ZIndex = 22
	topBar.Parent = panel
	layer.BackgroundTransparency = 1
	TweenService:Create(layer, Theme.Fade, { BackgroundTransparency = 0.25 }):Play()
	Components.Padding(panel, 28, 24)
	Components.List(panel, 12)

	local params = if type(document.params) == "table" then table.clone(document.params) else nil
	if type(document.date) == "number" then
		params = params or {}
		params.date = formatDate(document.date)
	end
	if type(document.photo) == "table" then
		local photo = PhotoView.Build(document.photo)
		photo.LayoutOrder = 0
		photo.ZIndex = 22
		for _, d in photo:GetDescendants() do
			if d:IsA("GuiObject") then
				d.ZIndex = 23
			end
		end
		photo.Parent = panel
	end
	local title = Components.Text({ Key = document.title, Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.Accent, LayoutOrder = 1, Parent = panel })
	title.ZIndex = 22
	local body = Components.Text({ Key = document.body, Params = params, Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextBody, Color = Theme.Colors.TextBright, AutoY = true, Size = UDim2.fromScale(1, 0), YAlign = Enum.TextYAlignment.Top, LayoutOrder = 2, Parent = panel })
	body.ZIndex = 22
	local close = Components.Button({ Key = "DOC_CLOSE", LayoutOrder = 3, OnActivated = Hud.CloseDocument, Parent = panel })
	close.Instance.ZIndex = 22
	for _, child in close.Instance:GetDescendants() do
		if child:IsA("GuiObject") then
			child.ZIndex = 23
		end
	end

	if documentCallbacks then
		documentCallbacks.onOpen()
	end
	if input.GetDevice() == "gamepad" then
		GuiService.SelectedObject = close.Instance
	end
end

-- Survival status line (top centre): "SHIFT 3 · BLACKOUT" or the break countdown.
local statusLine: TextLabel? = nil
function Hud.SetStatus(key: string?, params: { [string]: any }?, suffixKey: string?)
	local label = statusLine :: TextLabel
	if not key then
		label.Visible = false
		return
	end
	local text = Localization.T(key, params)
	if suffixKey then
		text ..= "  ·  " .. Localization.T(suffixKey)
	end
	label.Text = text
	label.Visible = true
end

-- Forecast line (top centre, under the status line): "FORECAST · Lights in Sector A · 0:24"
local forecastLine: TextLabel? = nil
function Hud.SetForecast(key: string?, seconds: number?)
	local label = forecastLine :: TextLabel
	if not key then
		label.Visible = false
		return
	end
	local s = math.max(0, math.floor(seconds or 0))
	label.Text = Localization.T("FORECAST_LABEL", { text = Localization.T(key), time = string.format("%d:%02d", s // 60, s % 60) })
	label.Visible = true
end

function Hud.Init(hudGui: ScreenGui, settingsController, inputController, callbacks: { onOpen: () -> (), onClose: () -> () })
	gui = hudGui
	settings = settingsController
	input = inputController
	documentCallbacks = callbacks

	subtitleFrame = Instance.new("Frame")
	subtitleFrame.Name = "Subtitles"
	subtitleFrame.BackgroundTransparency = 1
	subtitleFrame.AnchorPoint = Vector2.new(0.5, 1)
	subtitleFrame.Position = UDim2.new(0.5, 0, 1, -96) -- above the hotbar
	subtitleFrame.Size = UDim2.new(0.62, 0, 0.4, 0)
	subtitleFrame.Parent = gui
	local subtitleLayout = Components.List(subtitleFrame, 6)
	subtitleLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	subtitleLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	objectiveFrame = Instance.new("CanvasGroup")
	objectiveFrame.Name = "Objective"
	objectiveFrame.BackgroundColor3 = Theme.Colors.Panel
	objectiveFrame.BackgroundTransparency = 0.3
	objectiveFrame.BorderSizePixel = 0
	objectiveFrame.Position = UDim2.fromOffset(24, 16)
	objectiveFrame.Size = UDim2.fromOffset(400, 0)
	objectiveFrame.AutomaticSize = Enum.AutomaticSize.Y
	objectiveFrame.Visible = false
	objectiveFrame.Parent = gui
	Components.Corner(objectiveFrame, 6)
	Components.Padding(objectiveFrame, 18, 10, 14, 12)
	Components.List(objectiveFrame, 2)
	local objectiveBar = Instance.new("Frame")
	objectiveBar.Name = "Bar"
	objectiveBar.BackgroundColor3 = Theme.Colors.Accent
	objectiveBar.BorderSizePixel = 0
	objectiveBar.Size = UDim2.fromOffset(28, 2)
	objectiveBar.LayoutOrder = 0
	objectiveBar.Parent = objectiveFrame
	Components.Text({ Key = "OBJECTIVE_NEW", Font = Theme.Fonts.Mono, TextSize = 13, Color = Theme.Colors.Accent, LayoutOrder = 1, Parent = objectiveFrame })
	objectiveText = Components.Text({ Text = "", Font = Theme.Fonts.Bold, TextSize = Theme.Sizes.TextHeading - 2, Color = Theme.Colors.TextBright, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 2, Parent = objectiveFrame })

	-- notification toast (top centre)
	local toast = Instance.new("CanvasGroup")
	toast.Name = "Toast"
	toast.BackgroundColor3 = Theme.Colors.Panel
	toast.BackgroundTransparency = 0.2
	toast.BorderSizePixel = 0
	toast.AnchorPoint = Vector2.new(0.5, 0)
	toast.Position = UDim2.new(0.5, 0, 0, 18)
	toast.Size = UDim2.new()
	toast.AutomaticSize = Enum.AutomaticSize.XY
	toast.Visible = false
	toast.Parent = gui
	Components.Corner(toast, 18)
	Components.Stroke(toast, Theme.Colors.Accent, 0.55)
	Components.Padding(toast, 18, 8)
	notifyLabel = Components.Text({ Text = "", Font = Theme.Fonts.Medium, TextSize = Theme.Sizes.TextBody, Color = Theme.Colors.TextBright, XAlign = Enum.TextXAlignment.Center, Size = UDim2.new(), Parent = toast })
	notifyLabel.AutomaticSize = Enum.AutomaticSize.XY
	local toastLimit = Instance.new("UISizeConstraint")
	toastLimit.MaxSize = Vector2.new(640, math.huge)
	toastLimit.Parent = notifyLabel

	local function pillLine(color: Color3, y: number): TextLabel
		local holder = Instance.new("Frame")
		holder.BackgroundColor3 = Color3.fromRGB(4, 6, 8)
		holder.BackgroundTransparency = 0.4
		holder.BorderSizePixel = 0
		holder.AnchorPoint = Vector2.new(0.5, 0)
		holder.Position = UDim2.new(0.5, 0, 0, y)
		holder.AutomaticSize = Enum.AutomaticSize.XY
		holder.Size = UDim2.new()
		holder.Parent = gui
		Components.Corner(holder, 4)
		Components.Padding(holder, 12, 3)
		local label = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = color, XAlign = Enum.TextXAlignment.Center, Wrapped = false, Size = UDim2.new(), Parent = holder })
		label.AutomaticSize = Enum.AutomaticSize.XY
		-- the holder follows the label's visibility
		holder.Visible = false
		label:GetPropertyChangedSignal("Visible"):Connect(function()
			holder.Visible = label.Visible
		end)
		return label
	end
	statusLine = pillLine(Theme.Colors.Radio, 62)
	forecastLine = pillLine(Theme.Colors.Relay, 90)
	;(statusLine :: TextLabel).Visible = false
	;(forecastLine :: TextLabel).Visible = false

	staminaTrack = Instance.new("Frame")
	staminaTrack.Name = "Stamina"
	staminaTrack.AnchorPoint = Vector2.new(0.5, 1)
	staminaTrack.Position = UDim2.new(0.5, 0, 1, -10)
	staminaTrack.Size = UDim2.fromOffset(220, 4)
	staminaTrack.BackgroundColor3 = Color3.new(0, 0, 0)
	staminaTrack.BackgroundTransparency = 0.45
	staminaTrack.BorderSizePixel = 0
	staminaTrack.Visible = false
	staminaTrack.Parent = gui
	Components.Corner(staminaTrack, 2)
	staminaFill = Instance.new("Frame")
	staminaFill.BorderSizePixel = 0
	staminaFill.BackgroundColor3 = Theme.Colors.Text
	staminaFill.Size = UDim2.fromScale(1, 1)
	staminaFill.Parent = staminaTrack
	Components.Corner(staminaFill, 2)

	-- Re-render visible subtitles when the language or subtitle size changes.
	Localization.Changed:Connect(function()
		for _, entry in activeLines do
			entry.label.Text = subtitleText(entry.line)
		end
	end)
	settings.Changed:Connect(function(key)
		if key == "subtitleSize" then
			for _, entry in activeLines do
				entry.label.TextSize = subtitleSize()
			end
		end
	end)

	UserInputService.InputBegan:Connect(function(inputObject)
		if not documentLayer then
			return
		end
		local key = inputObject.KeyCode
		if key == Enum.KeyCode.ButtonB or (key == Enum.KeyCode.Backspace and not UserInputService:GetFocusedTextBox()) then
			Hud.CloseDocument()
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9320">
            <Properties>
              <string name="Name">PhotoView</string>
              <string name="Source"><![CDATA[-- PhotoView: renders a "supernatural" photograph from live avatar copies in a small
-- prepared scene (ViewportFrame). Sepia print, white border, a date from long ago.
-- Subjects that are no longer in the server are shown as dark silhouettes.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Localization = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Localization"))

local Theme = require(script.Parent.Theme)

local PhotoView = {}

local function slab(world: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?)
	local p = Instance.new("Part")
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.Concrete
	p.Parent = world
	return p
end

local function silhouette(world: Instance, cf: CFrame, tall: boolean?)
	local model = Instance.new("Model")
	local color = Color3.fromRGB(12, 10, 10)
	local scale = if tall then 1.7 else 1
	slab(model, Vector3.new(1.2, 2.2, 0.7) * scale, cf * CFrame.new(0, 3 * scale, 0), color, Enum.Material.SmoothPlastic)
	slab(model, Vector3.new(1, 1, 1) * scale, cf * CFrame.new(0, 4.7 * scale, 0), color, Enum.Material.SmoothPlastic)
	slab(model, Vector3.new(1.2, 2, 0.6) * scale, cf * CFrame.new(0, 1 * scale, 0), color, Enum.Material.SmoothPlastic)
	model.Parent = world
end

local function avatarCopy(userId: number): Model?
	local member = Players:GetPlayerByUserId(userId)
	local character = member and member.Character
	if not character then
		return nil
	end
	local archivable = character.Archivable
	character.Archivable = true
	local copy = character:Clone()
	character.Archivable = archivable
	if not copy then
		return nil
	end
	for _, d in copy:GetDescendants() do
		if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") or d:IsA("Light") or d:IsA("BillboardGui") or d:IsA("ProximityPrompt") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true
		end
	end
	return copy
end

-- Scene per area type: hallway, room, core door, antenna.
local function buildScene(world: Instance, area: string)
	local wall = Color3.fromRGB(110, 106, 98)
	if area == "CORE" then
		slab(world, Vector3.new(30, 1, 30), CFrame.new(0, -0.5, -10), Color3.fromRGB(70, 68, 64))
		slab(world, Vector3.new(18, 14, 1), CFrame.new(0, 7, -20), Color3.fromRGB(60, 66, 66), Enum.Material.Metal)
		slab(world, Vector3.new(14, 0.6, 1.2), CFrame.new(0, 7.5, -19.6), Color3.fromRGB(200, 60, 50), Enum.Material.Neon)
	elseif area == "ANTENNA" then
		slab(world, Vector3.new(60, 1, 60), CFrame.new(0, -0.5, -20), Color3.fromRGB(50, 56, 46), Enum.Material.Grass)
		for i = 0, 6 do
			slab(world, Vector3.new(0.6, 6, 0.6), CFrame.new(-4 + i * 0.2, 3 + i * 6, -30), Color3.fromRGB(90, 50, 40), Enum.Material.Metal)
		end
	elseif area == "HALL" then
		slab(world, Vector3.new(14, 1, 60), CFrame.new(0, -0.5, -20), Color3.fromRGB(60, 62, 58))
		slab(world, Vector3.new(1, 14, 60), CFrame.new(-7, 7, -20), wall)
		slab(world, Vector3.new(1, 14, 60), CFrame.new(7, 7, -20), wall)
	else
		slab(world, Vector3.new(30, 1, 30), CFrame.new(0, -0.5, -12), Color3.fromRGB(84, 76, 62), Enum.Material.Plastic)
		slab(world, Vector3.new(30, 14, 1), CFrame.new(0, 7, -26), wall)
		slab(world, Vector3.new(6, 0.3, 3), CFrame.new(-6, 3, -18), Color3.fromRGB(82, 62, 44), Enum.Material.Wood)
		slab(world, Vector3.new(3, 7, 2), CFrame.new(8, 3.5, -22), Color3.fromRGB(64, 84, 82), Enum.Material.Metal)
	end
end

-- photo = { id, kind, area, date, subjects = {userId...}, figureBehind? }
function PhotoView.Build(photo: { [string]: any }): Frame
	local frame = Instance.new("Frame")
	frame.Name = "Photo"
	frame.Size = UDim2.new(1, 0, 0, 300)
	frame.BackgroundColor3 = Color3.fromRGB(236, 230, 214) -- white print border
	frame.BorderSizePixel = 0
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 10)
	padding.PaddingLeft = UDim.new(0, 10)
	padding.PaddingRight = UDim.new(0, 10)
	padding.PaddingBottom = UDim.new(0, 34)
	padding.Parent = frame

	local viewport = Instance.new("ViewportFrame")
	viewport.Size = UDim2.fromScale(1, 1)
	viewport.BackgroundColor3 = Color3.fromRGB(40, 32, 22)
	viewport.ImageColor3 = Color3.fromRGB(235, 205, 160) -- sepia
	viewport.Ambient = Color3.fromRGB(150, 130, 100)
	viewport.LightColor = Color3.fromRGB(255, 225, 180)
	viewport.Parent = frame
	local world = Instance.new("WorldModel")
	world.Parent = viewport
	buildScene(world, tostring(photo.area or "HALL"))

	local subjects = photo.subjects or {}
	for index, userId in subjects do
		local cf = CFrame.new((index - 1) * 3 - (#subjects - 1) * 1.5, 3, -14 - (index % 2) * 2) * CFrame.Angles(0, math.rad(if photo.kind == "past_self" then 160 else 180), 0)
		local copy = avatarCopy(userId)
		if copy then
			copy:PivotTo(cf)
			copy.Parent = world
		else
			silhouette(world, cf - Vector3.new(0, 3, 0))
		end
	end
	if photo.figureBehind or photo.kind == "mate_dark" then
		silhouette(world, CFrame.new(1.5, 0, -24), true)
	end

	local camera = Instance.new("Camera")
	camera.FieldOfView = 55
	camera.CFrame = CFrame.lookAt(Vector3.new(3, 8, 6), Vector3.new(0, 3, -16))
	camera.Parent = viewport
	viewport.CurrentCamera = camera

	local caption = Instance.new("TextLabel")
	caption.BackgroundTransparency = 1
	caption.AnchorPoint = Vector2.new(0, 0)
	caption.Position = UDim2.new(0, 0, 1, 4)
	caption.Size = UDim2.new(1, 0, 0, 24)
	caption.Font = Theme.Fonts.Mono
	caption.TextSize = 15
	caption.TextXAlignment = Enum.TextXAlignment.Left
	caption.TextColor3 = Color3.fromRGB(60, 50, 40)
	caption.AutoLocalize = false
	caption.Text = Localization.T("PHOTO_CAPTION", { date = tostring(photo.date or "??.??.19??"), place = Localization.T("AREA_" .. tostring(photo.area or "UNKNOWN")) })
	caption.Parent = frame
	return frame
end

return PhotoView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="9321">
            <Properties>
              <string name="Name">Router</string>
              <string name="Source"><![CDATA[-- Router: screen stack for menus with fades, gamepad focus and universal "back".
--
-- A screen module exposes .new(router, args) and returns:
--   { Root: GuiObject, Focus: GuiObject?, OnBack: (() -> boolean)?, Destroy: (() -> ())? }
-- OnBack returning true means "handled", otherwise the router pops the screen.
-- Back works with: gamepad B / Circle, keyboard Backspace, and the on-screen Back button.

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Signal = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Signal"))
local Theme = require(script.Parent.Theme)

local Router = {}
Router.__index = Router

function Router.new(container: GuiObject, input)
	local self = setmetatable({
		Container = container,
		Input = input,
		Stack = {},
		Changed = Signal.new(), -- fired with the number of open screens
		RootBackHandler = nil :: (() -> ())?, -- called when Back is pressed on the last screen
	}, Router)

	-- Modal button: frees the mouse in first person while any menu is open.
	local modal = Instance.new("TextButton")
	modal.Name = "MouseUnlock"
	modal.Modal = true
	modal.Text = ""
	modal.BackgroundTransparency = 1
	modal.Size = UDim2.fromOffset(0, 0)
	modal.Selectable = false
	modal.Visible = false
	modal.Parent = container
	self._modal = modal

	UserInputService.InputBegan:Connect(function(inputObject)
		if #self.Stack == 0 then
			return
		end
		local key = inputObject.KeyCode
		if self.ShouldIgnoreBack and self.ShouldIgnoreBack() then
			return -- e.g. a document is open on top of the menu: Back closes that first
		end
		if key == Enum.KeyCode.ButtonB or (key == Enum.KeyCode.Backspace and not UserInputService:GetFocusedTextBox()) then
			self:Back()
		end
	end)

	input.DeviceChanged:Connect(function()
		self:RefreshFocus()
	end)

	return self
end

function Router:Top()
	return self.Stack[#self.Stack]
end

function Router:IsOpen(): boolean
	return #self.Stack > 0
end

function Router:RefreshFocus()
	local top = self:Top()
	if top and self.Input.GetDevice() == "gamepad" then
		local current = GuiService.SelectedObject
		if not current or not current:IsDescendantOf(top.Root) then
			GuiService.SelectedObject = top.Focus
		end
	elseif not top then
		GuiService.SelectedObject = nil
	end
end

local function fadeIn(root: GuiObject)
	root.Visible = true
	if root:IsA("CanvasGroup") then
		root.GroupTransparency = 1
		TweenService:Create(root, Theme.Fade, { GroupTransparency = 0 }):Play()
	end
	local column = root:FindFirstChild("Column")
	if column and column:IsA("GuiObject") then
		local target = column:GetAttribute("FZ_Home") or column.Position
		column:SetAttribute("FZ_Home", target)
		column.Position = target + UDim2.fromOffset(-28, 0)
		TweenService:Create(column, TweenInfo.new(0.32, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Position = target }):Play()
	end
end

function Router:_show(screen)
	screen.Root.Parent = self.Container
	fadeIn(screen.Root)
	self._modal.Visible = true
	self:RefreshFocus()
	self.Changed:Fire(#self.Stack)
end

function Router:Push(screenModule, args: any?)
	local previous = self:Top()
	if previous then
		previous.Root.Visible = false
	end
	local screen = screenModule.new(self, args)
	table.insert(self.Stack, screen)
	self:_show(screen)
	return screen
end

function Router:Pop()
	local screen = table.remove(self.Stack)
	if not screen then
		return
	end
	if screen.Destroy then
		screen.Destroy()
	end
	screen.Root:Destroy()
	local top = self:Top()
	if top then
		self:_show(top)
	else
		self._modal.Visible = false
		GuiService.SelectedObject = nil
		self.Changed:Fire(0)
	end
end

function Router:Replace(screenModule, args: any?)
	self:Clear(true)
	return self:Push(screenModule, args)
end

function Router:Clear(silent: boolean?)
	while #self.Stack > 0 do
		local screen = table.remove(self.Stack)
		if screen.Destroy then
			screen.Destroy()
		end
		screen.Root:Destroy()
	end
	self._modal.Visible = false
	GuiService.SelectedObject = nil
	if not silent then
		self.Changed:Fire(0)
	end
end

function Router:Back()
	local top = self:Top()
	if not top then
		return
	end
	if top.OnBack and top.OnBack() then
		return
	end
	if #self.Stack > 1 then
		self:Pop()
	elseif self.RootBackHandler then
		self.RootBackHandler()
	end
end

return Router
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="9322">
            <Properties>
              <string name="Name">Screens</string>
            </Properties>
            <Item class="ModuleScript" referent="9323">
              <Properties>
                <string name="Name">Admin</string>
                <string name="Source"><![CDATA[-- Maintenance (owner/developer tools). The server re-checks authorization on every
-- action; this screen is only a convenience UI. World tools (creature spawning, monster
-- mode, teleports, story triggers) are added together with the creature and the map.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local Admin = {}

function Admin.new(router)
	local app = router.App
	local root, column = Components.ScreenRoot("Admin")
	local scroll = Components.ScrollColumn(column, UDim2.fromScale(1, 1))
	column = scroll :: any

	Components.Heading(column, "ADMIN_TITLE", 1)
	Components.Text({
		Text = string.format("input: %s | device: %s", if app.Input.IsUsingActionSystem() then "InputActionSystem" else "fallback", app.Input.GetDevice()),
		Font = Theme.Fonts.Mono,
		TextSize = 13,
		Color = Theme.Colors.TextFaint,
		LayoutOrder = 2,
		Parent = column,
	})
	Components.Spacer(column, 10, 3)

	local status = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, LayoutOrder = 98, Parent = column })

	local debugButton = Components.Button({ Key = "ADMIN_DEBUG", LayoutOrder = 10, Parent = column, OnActivated = function()
		app.Debug.Toggle()
	end })
	Components.Button({ Key = "ADMIN_GRANT_TEST", LayoutOrder = 11, Parent = column, OnActivated = function()
		local ok, response = pcall(function()
			return Net.Function("AdminAction"):InvokeServer("grant_test_marks")
		end)
		local success = ok and type(response) == "table" and response.ok
		Localization.Bind(status, if success then "ADMIN_DONE" else "ADMIN_DENIED")
	end })
	local function action(key: string, order: number, actionName: string, payload: (() -> any)?, params: { [string]: any }?)
		Components.Button({ Key = key, Params = params, LayoutOrder = order, Height = 40, Parent = column, OnActivated = function()
			local ok, response = pcall(function()
				return Net.Function("AdminAction"):InvokeServer(actionName, if payload then payload() else nil)
			end)
			local success = ok and type(response) == "table" and response.ok
			local reason = ok and type(response) == "table" and response.reason
			Localization.Bind(status, if success then "ADMIN_DONE" elseif reason == "public" then "ADMIN_PUBLIC_BLOCKED" else "ADMIN_DENIED")
			if success and (actionName == "play_creature" or actionName == "play_human" or actionName == "tp_core") then
				app.Resume()
			end
		end })
	end
	action("ADMIN_SPAWN_CREATURE", 12, "spawn_creature")
	action("ADMIN_CREATURE_AI", 13, "toggle_ai")
	action("ADMIN_PLAY_CREATURE", 14, "play_creature")
	action("ADMIN_PLAY_HUMAN", 15, "play_human")
	action("ADMIN_TP_CORE", 16, "tp_core")
	action("ADMIN_SPEED", 17, "toggle_speed")
	action("ADMIN_RESET", 18, "reset")

	-- Where the owner is looking (max 300 studs), for "spawn here"
	local function aimed()
		local camera = workspace.CurrentCamera
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { game:GetService("Players").LocalPlayer.Character :: Instance }
		local hit = workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * 300, params)
		return { position = if hit then hit.Position else camera.CFrame.Position + camera.CFrame.LookVector * 30 }
	end
	action("ADMIN_SPAWN_AIM", 40, "spawn_creature_at", aimed)
	action("ADMIN_SPAWN_AIM_ADD", 41, "spawn_creature_at", function()
		local p = aimed()
		p.add = true
		return p
	end)
	for index, checkpoint in { "C1_START", "C1_CONTROL", "C1_CORE" } do
		action("ADMIN_TP_CHECKPOINT", 42 + index, "teleport_checkpoint", function()
			return { id = checkpoint }
		end, { id = checkpoint })
	end
	action("ADMIN_FORECAST_TEST", 50, "forecast_test")
	action("ADMIN_LIGHT_TEST", 51, "light_test")
	for index, kind in { "apparition", "footsteps", "flicker", "cctv", "namecall" } do
		action("ADMIN_SCARE_TEST", 52 + index, "scare_test", function()
			return { kind = kind }
		end, { kind = kind })
	end
	for index, sound in { "creature_alert", "vent_rattle", "door_open", "radio_squelch_on", "stinger_low" } do
		action("ADMIN_SOUND_TEST", 60 + index, "sound_test", function()
			return { name = sound }
		end, { name = sound })
	end
	Components.Spacer(column, 10, 19)
	Components.Button({ Key = "MENU_BACK", LayoutOrder = 99, Parent = column, OnActivated = function()
		router:Pop()
	end })

	return { Root = root, Focus = debugButton.Instance }
end

return Admin
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="9324">
              <Properties>
                <string name="Name">Archive</string>
                <string name="Source"><![CDATA[-- DAS ARCHIV: the station's archive terminal.
-- Green monospace, file numbers, categories, locked files that do not reveal their content,
-- link progress for insights ("2/3 files"), a frequency input for hidden secrets, and the
-- player's earned titles. Opens documents and re-renders photographs on demand.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Localization = require(Shared.Localization)
local Lore = require(Shared.Lore)
local Net = require(Shared.Net)
local Titles = require(Shared.Titles)
local Achievements = require(Shared.Achievements)

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local Archive = {}

local GREEN = Color3.fromRGB(120, 230, 150)
local GREEN_DIM = Color3.fromRGB(60, 120, 80)
local CATEGORIES = { "all", "photo", "report", "tape", "observation", "radio", "confidential", "past", "insight", "achievements", "titles" }

local function terminalText(props)
	props.Font = Theme.Fonts.Mono
	props.Color = props.Color or GREEN
	local label = Components.Text(props)
	label.TextStrokeTransparency = 0.85
	return label
end

function Archive.new(router)
	local app = router.App
	local root = Instance.new("CanvasGroup")
	root.Name = "Archive"
	root.BackgroundColor3 = Color3.fromRGB(4, 10, 6)
	root.BackgroundTransparency = 0.08
	root.Size = UDim2.fromScale(1, 1)

	-- scanlines (static, no flicker)
	local scan = Instance.new("Frame")
	scan.BackgroundTransparency = 1
	scan.Size = UDim2.fromScale(1, 1)
	scan.ZIndex = 5
	scan.Parent = root
	local gradient = Instance.new("UIGradient")
	local points = {}
	for i = 0, 18 do
		table.insert(points, NumberSequenceKeypoint.new(i / 18, if i % 2 == 0 then 0.94 else 1))
	end
	gradient.Transparency = NumberSequence.new(points)
	gradient.Rotation = 90
	gradient.Parent = scan
	scan.BackgroundColor3 = Color3.new(0, 0, 0)
	scan.BackgroundTransparency = 0

	local column = Instance.new("Frame")
	column.BackgroundTransparency = 1
	column.AnchorPoint = Vector2.new(0.5, 0.5)
	column.Position = UDim2.fromScale(0.5, 0.5)
	column.Size = UDim2.new(1, -48, 1, -32)
	column.Parent = root
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize = Vector2.new(760, math.huge)
	limit.Parent = column

	terminalText({ Text = "RELAY 07 · " .. Localization.T("ARCHIVE_TERMINAL") .. " · " .. Players.LocalPlayer.DisplayName, TextSize = 14, Color = GREEN_DIM, Size = UDim2.new(1, 0, 0, 20), Parent = column })
	terminalText({ Key = "ARCHIVE_TITLE", TextSize = 26, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 20), Parent = column })

	local tabs = Instance.new("ScrollingFrame")
	tabs.BackgroundTransparency = 1
	tabs.BorderSizePixel = 0
	tabs.Position = UDim2.fromOffset(0, 58)
	tabs.Size = UDim2.new(1, 0, 0, 38)
	tabs.CanvasSize = UDim2.new()
	tabs.AutomaticCanvasSize = Enum.AutomaticSize.X
	tabs.ScrollingDirection = Enum.ScrollingDirection.X
	tabs.ScrollBarThickness = 0
	tabs.Selectable = false
	tabs.Parent = column
	Components.List(tabs, 4, true)

	local list = Components.ScrollColumn(column, UDim2.new(1, 0, 1, -200), UDim2.fromOffset(0, 100))
	list.ScrollBarImageColor3 = GREEN_DIM

	-- frequency input (secrets)
	local inputRow = Instance.new("Frame")
	inputRow.BackgroundTransparency = 1
	inputRow.AnchorPoint = Vector2.new(0, 1)
	inputRow.Position = UDim2.new(0, 0, 1, -52)
	inputRow.Size = UDim2.new(1, 0, 0, 40)
	inputRow.Parent = column
	local box = Instance.new("TextBox")
	box.AutoLocalize = false
	box.ClearTextOnFocus = false
	box.Text = ""
	box.Font = Theme.Fonts.Mono
	box.TextSize = 18
	box.TextColor3 = GREEN
	box.PlaceholderColor3 = GREEN_DIM
	box.BackgroundColor3 = Color3.fromRGB(8, 22, 12)
	box.BorderSizePixel = 0
	box.Size = UDim2.new(0.62, -6, 1, 0)
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.Selectable = true
	Localization.Bind(box, "ARCHIVE_FREQ_PLACEHOLDER", nil, "PlaceholderText")
	Components.Padding(box, 10, 0)
	box.Parent = inputRow
	local status = terminalText({ Text = "", TextSize = 14, Color = GREEN_DIM, Size = UDim2.new(1, 0, 0, 18), AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -96), Parent = column })

	local back = Components.Button({ Key = "MENU_BACK", Height = 44, Parent = column })
	back.Instance.AnchorPoint = Vector2.new(0, 1)
	back.Instance.Position = UDim2.fromScale(0, 1)
	back.Instance.Size = UDim2.new(1, 0, 0, 44)
	back.Instance.Activated:Connect(function()
		router:Pop()
	end)

	local data = { logs = {}, photos = {}, achievements = {} }
	local titlesEarned, equippedTitle = {}, nil
	local category = "all"
	local render: () -> ()

	local transmit = Components.Button({ Key = "ARCHIVE_FREQ_SEND", Height = 40, Centered = true, Parent = inputRow, OnActivated = function()
		local text = box.Text
		if #string.gsub(text, "%s", "") == 0 then
			return
		end
		local ok, result = pcall(function()
			return Net.Function("SolveSecret"):InvokeServer(text)
		end)
		local outcome = if ok and type(result) == "table" then result.status else "error"
		status.TextColor3 = if outcome == "ok" then GREEN else GREEN_DIM
		Localization.Bind(status, if outcome == "ok" then "SECRET_SOLVED" elseif outcome == "known" then "SECRET_KNOWN" elseif outcome == "rate" then "CODE_RATE_LIMITED" else "SECRET_NOTHING", { count = if ok and type(result) == "table" then result.solvers or 0 else 0 })
		if outcome == "ok" then
			box.Text = ""
			data.logs[result.unlock] = os.time()
			render()
		end
	end })
	transmit.Instance.AnchorPoint = Vector2.new(1, 0)
	transmit.Instance.Position = UDim2.fromScale(1, 0)
	transmit.Instance.Size = UDim2.new(0.38, 0, 1, 0)
	transmit.Label.TextSize = 15

	local function openEntry(item)
		local doc = { title = item.title, body = item.body }
		if item.photo then
			local saved = data.photos[item.id] or {}
			doc.photo = {
				id = item.id,
				kind = item.photo,
				area = saved.area or "HALL",
				date = saved.date,
				subjects = { Players.LocalPlayer.UserId }, -- others are never stored: silhouettes
				figureBehind = item.photo == "mate_dark",
			}
		end
		app.Hud.ShowDocument(doc)
	end

	render = function()
		for _, child in list:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		local order = 0
		if category == "achievements" then
			for _, achievement in Achievements do
				order += 1
				local done = data.achievements[achievement.id] ~= nil
				terminalText({ Text = (if done then "[OK]  " else "[  ]  ") .. Localization.T(achievement.name), TextSize = 16, Color = if done then GREEN else GREEN_DIM, LayoutOrder = order, Parent = list })
				order += 1
				terminalText({ Key = achievement.description, Params = { marks = achievement.marks }, TextSize = 13, Color = GREEN_DIM, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = order, Parent = list })
			end
			return
		end
		if category == "titles" then
			for _, title in Titles.List do
				order += 1
				if titlesEarned[title.id] then
					local button
					button = Components.Button({ Key = title.name, TagKey = if equippedTitle == title.id then "SHOP_EQUIPPED" else "SHOP_EQUIP", Height = 40, LayoutOrder = order, Parent = list, OnActivated = function()
						local wearing = equippedTitle == title.id
						pcall(function()
							Net.Function("ShopAction"):InvokeServer("title", if wearing then "" else title.id)
						end)
						equippedTitle = if wearing then nil else title.id
						render()
					end })
					button.Label.TextColor3 = GREEN
				else
					terminalText({ Key = title.hint, TextSize = 15, Color = GREEN_DIM, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = order, Parent = list })
				end
			end
			return
		end
		local found, total = 0, 0
		for index, item in Lore do
			if category == "all" or item.category == category then
				total += 1
				order += 1
				local number = string.format("07-%02d", index)
				if data.logs[item.id] then
					found += 1
					local button = Components.Button({
						Text = string.format("[%s]  %s", number, Localization.T(item.title)),
						TagKey = "ARCHIVE_CAT_" .. string.upper(item.category),
						Height = 40,
						LayoutOrder = order,
						Parent = list,
						OnActivated = function()
							openEntry(item)
						end,
					})
					button.Label.Font = Theme.Fonts.Mono
					button.Label.TextSize = 15
					button.Label.TextColor3 = GREEN
					button.Tag.TextColor3 = GREEN_DIM
				elseif item.links then
					local have = 0
					for _, link in item.links do
						if data.logs[link] then
							have += 1
						end
					end
					terminalText({ Key = "ARCHIVE_LINK_PROGRESS", Params = { number = number, have = have, need = #item.links }, TextSize = 15, Color = GREEN_DIM, LayoutOrder = order, Parent = list })
				else
					terminalText({ Key = "ARCHIVE_LOCKED", Params = { number = number }, TextSize = 15, Color = GREEN_DIM, LayoutOrder = order, Parent = list })
				end
			end
		end
		order += 1
		terminalText({ Key = "ARCHIVE_COUNT", Params = { found = found, total = total }, TextSize = 13, Color = GREEN_DIM, LayoutOrder = order, Parent = list })
	end

	local tabButtons = {}
	for index, name in CATEGORIES do
		local tab = Components.Button({ Key = "ARCHIVE_CAT_" .. string.upper(name), Height = 34, Centered = true, LayoutOrder = index, Parent = tabs, OnActivated = function()
			category = name
			for n, b in tabButtons do
				b.SetFocused(n == name)
			end
			render()
		end })
		tab.Instance.Size = UDim2.fromOffset(150, 34)
		tab.Instance.AutomaticSize = Enum.AutomaticSize.X
		tab.Label.Font = Theme.Fonts.Mono
		tab.Label.TextSize = 14
		tab.Label.TextColor3 = GREEN
		tabButtons[name] = tab
	end
	tabButtons.all.SetFocused(true)
	render()

	task.spawn(function()
		local okProfile, profile = pcall(function()
			return Net.Function("FetchProfile"):InvokeServer()
		end)
		local okShop, shop = pcall(function()
			return Net.Function("ShopAction"):InvokeServer("get")
		end)
		if not list.Parent then
			return
		end
		local secrets = (okProfile and type(profile) == "table" and profile.secrets) or app.Profile.secrets or {}
		data.logs = secrets.logs or {}
		data.photos = secrets.photos or {}
		data.achievements = (okProfile and type(profile) == "table" and profile.achievements) or {}
		if okShop and type(shop) == "table" then
			for _, id in shop.titles or {} do
				titlesEarned[id] = true
			end
			equippedTitle = shop.equipped and shop.equipped.title
		end
		render()
	end)

	return { Root = root, Focus = tabButtons.all.Instance }
end

return Archive
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="9325">
              <Properties>
                <string name="Name">Community</string>
                <string name="Source"><![CDATA[-- Community: optional one-time reward for joining the official Roblox community.
-- Nothing is required to play. The reward is only granted after the SERVER confirmed the
-- membership. Pending join requests: check again after they were accepted.

local GroupService = game:GetService("GroupService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Community = require(Shared.Community)
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local CommunityScreen = {}

local STATUS = {
	ok = "COMMUNITY_OK",
	claimed = "COMMUNITY_CLAIMED",
	not_member = "COMMUNITY_NOT_MEMBER",
	rate = "CODE_RATE_LIMITED",
	error = "COMMUNITY_ERROR",
	off = "COMMUNITY_OFF",
}

function CommunityScreen.new(router)
	local root, column = Components.ScreenRoot("Community")
	local layout = Components.List(column, Theme.Sizes.Gap)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center

	Components.Heading(column, "COMMUNITY_TITLE", 1)
	Components.Text({ Key = "COMMUNITY_DESC", Params = { marks = Community.RewardMarks }, TextSize = Theme.Sizes.TextBody, Color = Theme.Colors.Text, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 2, Parent = column })
	Components.Text({ Key = "COMMUNITY_OPTIONAL", TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 3, Parent = column })
	local status = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 8, Parent = column })

	local function show(result)
		local key = STATUS[type(result) == "table" and result.status or "error"] or "COMMUNITY_ERROR"
		status.TextColor3 = if key == "COMMUNITY_OK" or key == "COMMUNITY_CLAIMED" then Theme.Colors.Relay else Theme.Colors.TextDim
		Localization.Bind(status, key, { marks = Community.RewardMarks })
	end

	local join = Components.Button({ Key = "COMMUNITY_JOIN", LayoutOrder = 5, Parent = column, OnActivated = function()
		task.spawn(function()
			local ok = pcall(function()
				(GroupService :: any):PromptJoinAsync(Community.GroupId)
			end)
			if not ok then
				Localization.Bind(status, "COMMUNITY_JOIN_MANUAL")
			end
		end)
	end })
	Components.Button({ Key = "COMMUNITY_CHECK", LayoutOrder = 6, Parent = column, OnActivated = function()
		local ok, result = pcall(function()
			return Net.Function("Community"):InvokeServer("claim")
		end)
		show(if ok then result else nil)
	end })
	Components.Spacer(column, 8, 9)
	Components.Button({ Key = "MENU_BACK", LayoutOrder = 10, Parent = column, OnActivated = function()
		router:Pop()
	end })

	task.spawn(function()
		local ok, result = pcall(function()
			return Net.Function("Community"):InvokeServer("status")
		end)
		if ok and type(result) == "table" and result.status == "claimed" then
			show(result)
		end
	end)
	return { Root = root, Focus = join.Instance }
end

return CommunityScreen
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="9326">
              <Properties>
                <string name="Name">Extras</string>
                <string name="Source"><![CDATA[-- Extras: transmission codes found in the world. The hidden maintenance entry appears
-- here only after the server confirmed authorization (see AdminService).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local Extras = {}

local RESULT_KEYS = {
	ok = "CODE_OK",
	invalid = "CODE_INVALID",
	used = "CODE_USED",
	rate_limited = "CODE_RATE_LIMITED",
	error = "CODE_ERROR",
	admin = "ADMIN_GRANTED",
}

function Extras.new(router)
	local player = Players.LocalPlayer
	local root, column = Components.ScreenRoot("Extras")
	local layout = Components.List(column, Theme.Sizes.Gap)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center

	Components.Heading(column, "EXTRAS_TITLE", 1)
	local balance = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, LayoutOrder = 2, Parent = column })
	local function refreshBalance()
		Localization.Bind(balance, "EXTRAS_BALANCE", { amount = player:GetAttribute("FZ_SignalMarks") or 0 })
	end
	refreshBalance()

	Components.Spacer(column, 12, 3)
	Components.Text({ Key = "EXTRAS_CODE_TITLE", Font = Theme.Fonts.Medium, TextSize = Theme.Sizes.TextButton, Color = Theme.Colors.TextBright, LayoutOrder = 4, Parent = column })
	Components.Text({ Key = "EXTRAS_CODE_HINT", TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 5, Parent = column })

	local box = Instance.new("TextBox")
	box.Name = "CodeInput"
	box.AutoLocalize = false
	box.ClearTextOnFocus = false
	box.Text = ""
	box.Font = Theme.Fonts.Mono
	box.TextSize = Theme.Sizes.TextButton
	box.TextColor3 = Theme.Colors.TextBright
	box.PlaceholderColor3 = Theme.Colors.TextFaint
	box.BackgroundColor3 = Theme.Colors.Panel
	box.BackgroundTransparency = 0.1
	box.BorderSizePixel = 0
	box.Size = UDim2.new(1, 0, 0, Theme.Sizes.Button)
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.LayoutOrder = 6
	box.Selectable = true
	Localization.Bind(box, "EXTRAS_CODE_PLACEHOLDER", nil, "PlaceholderText")
	Components.Padding(box, 16, 0)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Colors.PanelLine
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = box
	box.Parent = column
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if #box.Text > Config.Codes.MaxLength then
			box.Text = string.sub(box.Text, 1, Config.Codes.MaxLength)
		end
	end)
	box.SelectionGained:Connect(function()
		stroke.Color = Theme.Colors.Accent
	end)
	box.SelectionLost:Connect(function()
		stroke.Color = Theme.Colors.PanelLine
	end)

	local result = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextBright, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 8, Parent = column })

	local maintenance
	local pending = false
	local redeemButton
	local function redeem()
		local text = box.Text
		if pending or #string.gsub(text, "%s", "") == 0 then
			return
		end
		pending = true
		redeemButton.SetDisabled(true)
		local ok, response = pcall(function()
			return Net.Function("RedeemCode"):InvokeServer(text)
		end)
		pending = false
		redeemButton.SetDisabled(false)
		local status = if ok and type(response) == "table" then response.status else "error"
		local key = RESULT_KEYS[status] or "CODE_ERROR"
		local positive = status == "ok" or status == "admin"
		result.TextColor3 = if positive then Theme.Colors.Relay else Theme.Colors.TextDim
		Localization.Bind(result, key, { amount = if ok and type(response) == "table" then response.amount or 0 else 0 })
		if positive then
			box.Text = ""
		end
		if status == "admin" then
			maintenance.Instance.Visible = true
		end
	end

	redeemButton = Components.Button({ Key = "EXTRAS_REDEEM", LayoutOrder = 7, Parent = column, OnActivated = redeem })
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			redeem()
		end
	end)

	Components.Spacer(column, 10, 9)
	Components.Button({ Key = "ARCHIVE_TITLE", LayoutOrder = 9, Parent = column, OnActivated = function()
		router:Push(require(script.Parent.Archive))
	end })
	if require(Shared.Community).GroupId > 0 then
		Components.Button({ Key = "COMMUNITY_TITLE", LayoutOrder = 9, Parent = column, OnActivated = function()
			router:Push(require(script.Parent.Community))
		end })
	end
	maintenance = Components.Button({ Key = "ADMIN_TITLE", LayoutOrder = 10, Parent = column, OnActivated = function()
		router:Push(require(script.Parent.Admin))
	end })
	maintenance.Instance.Visible = player:GetAttribute("FZ_Admin") == true

	Components.Button({ Key = "MENU_BACK", LayoutOrder = 11, Parent = column, OnActivated = function()
		router:Pop()
	end })

	local connections = {
		player:GetAttributeChangedSignal("FZ_SignalMarks"):Connect(refreshBalance),
	}

	return {
		Root = root,
		Focus = box,
		Destroy = function()
			for _, connection in connections do
				connection:Disconnect()
			end
		end,
	}
end

return Extras
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="9327">
              <Properties>
                <string name="Name">LanguageSelect</string>
                <string name="Source"><![CDATA[-- Language selection. Used on the very first start (before the main menu, cannot be
-- skipped with Back) and from Settings -> Language. One click / one button press selects.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Localization = require(Shared.Localization)

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local LanguageSelect = {}

-- args: { firstStart: boolean, suggested: string?, onChosen: ((string) -> ())? }
function LanguageSelect.new(router, args)
	local app = router.App
	local firstStart = args and args.firstStart
	local suggested = args and args.suggested
	local current = if firstStart then suggested else app.Settings.Get("language")

	local root = Instance.new("CanvasGroup")
	root.Name = "LanguageSelect"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)

	local column = Instance.new("Frame")
	column.BackgroundTransparency = 1
	column.AnchorPoint = Vector2.new(0.5, 0.5)
	column.Position = UDim2.fromScale(0.5, 0.5)
	column.Size = UDim2.new(0, 420, 1, -32)
	column.Parent = root
	local layout = Components.List(column, Theme.Sizes.Gap)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center

	if firstStart then
		Components.Text({ Text = "SILENT RELAY", Font = Theme.Fonts.Title, TextSize = 18, Color = Theme.Colors.TextDim, LayoutOrder = 1, Parent = column })
	end
	Components.Heading(column, "LANG_PROMPT", 2)
	if firstStart and Localization.GetLanguage() ~= Config.FallbackLanguage then
		-- Bilingual header on first start, in case the suggestion is wrong.
		Components.Text({
			Text = Localization.T("LANG_PROMPT", nil, Config.FallbackLanguage),
			Font = Theme.Fonts.Body,
			TextSize = Theme.Sizes.TextBody,
			Color = Theme.Colors.TextDim,
			LayoutOrder = 3,
			Parent = column,
		})
	end
	Components.Spacer(column, 8, 4)

	local focus = nil
	for index, code in Config.Languages do
		local button = Components.Button({
			Text = Config.LanguageNames[code],
			TagKey = if code == suggested and firstStart then "LANG_SUGGESTED" else nil,
			LayoutOrder = 10 + index,
			Parent = column,
			OnActivated = function()
				if firstStart and args.onChosen then
					args.onChosen(code)
				else
					app.Settings.Set("language", code)
					router:Pop()
				end
			end,
		})
		if code == current or (focus == nil and index == 1) then
			focus = button.Instance
		end
		if code == current and not firstStart then
			button.Tag.Visible = true
			button.Tag.Text = "●"
			button.Tag.TextColor3 = Theme.Colors.Accent
		end
	end

	Components.Spacer(column, 8, 20)
	Components.Text({ Key = "LANG_HINT", TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 21, Parent = column })
	if not firstStart then
		Components.Button({ Key = "MENU_BACK", LayoutOrder = 30, Parent = column, OnActivated = function()
			router:Pop()
		end })
	end

	return {
		Root = root,
		Focus = focus,
		OnBack = function()
			return firstStart == true -- first start: a language must be chosen
		end,
	}
end

return LanguageSelect
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="9328">
              <Properties>
                <string name="Name">Leaderboard</string>
                <string name="Source"><![CDATA[-- Global best shifts for one survival map (top 10) + your own best.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local Leaderboard = {}

function Leaderboard.new(router, args)
	local app = router.App
	local entry = args.entry
	local root, column = Components.ScreenRoot("Leaderboard")
	local layout = Components.List(column, Theme.Sizes.Gap)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center

	Components.Heading(column, "LEADERBOARD_TITLE", 1)
	Components.Text({ Key = entry.title, Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, LayoutOrder = 2, Parent = column })
	local stats = app.Profile.survival and app.Profile.survival[entry.id]
	Components.Text({ Key = "SV_BEST", Params = { shifts = stats and stats.best or 0 }, Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.Radio, LayoutOrder = 3, Parent = column })

	local list = Instance.new("Frame")
	list.BackgroundTransparency = 1
	list.Size = UDim2.fromScale(1, 0)
	list.AutomaticSize = Enum.AutomaticSize.Y
	list.LayoutOrder = 4
	list.Parent = column
	Components.List(list, 2)
	local status = Components.Text({ Key = "LEADERBOARD_LOADING", TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, Parent = list })

	local back = Components.Button({ Key = "MENU_BACK", LayoutOrder = 10, Parent = column, OnActivated = function()
		router:Pop()
	end })

	task.spawn(function()
		local ok, result = pcall(function()
			return Net.Function("GetLeaderboard"):InvokeServer(entry.id)
		end)
		if not list.Parent then
			return
		end
		if not ok or type(result) ~= "table" or not result.ok then
			Localization.Bind(status, "LEADERBOARD_ERROR")
			return
		end
		if #result.entries == 0 then
			Localization.Bind(status, "LEADERBOARD_EMPTY")
			return
		end
		status:Destroy()
		for index, row in result.entries do
			Components.Text({ Key = "LEADERBOARD_ROW", Params = { rank = row.rank, name = row.name, shifts = row.shifts }, Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextBody, Color = if index == 1 then Theme.Colors.Radio else Theme.Colors.Text, LayoutOrder = index, Parent = list })
		end
	end)

	return { Root = root, Focus = back.Instance }
end

return Leaderboard
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="9329">
              <Properties>
                <string name="Name">Lobby</string>
                <string name="Source"><![CDATA[-- Team screen: who is in this session, one-tap invite, clear solo message.
-- One Roblox server = one team. Friends who accept the invite join this server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)
local Localization = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Localization"))

local Lobby = {}

function Lobby.new(router)
	local app = router.App
	local root, column = Components.ScreenRoot("Lobby")
	local layout = Components.List(column, Theme.Sizes.Gap)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center

	Components.Heading(column, "LOBBY_TITLE", 1)
	local count = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, LayoutOrder = 2, Parent = column })

	local list = Instance.new("Frame")
	list.Name = "Players"
	list.BackgroundTransparency = 1
	list.Size = UDim2.fromScale(1, 0)
	list.AutomaticSize = Enum.AutomaticSize.Y
	list.LayoutOrder = 3
	list.Parent = column
	Components.List(list, 2)

	local function refresh()
		for _, child in list:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		local players = Players:GetPlayers()
		Localization.Bind(count, "LOBBY_COUNT", { count = #players, max = Config.MaxPartySize })
		for index, player in players do
			local isSelf = player == Players.LocalPlayer
			local suffix = if isSelf then "  " .. Localization.T("LOBBY_YOU") else ""
			local title = player:GetAttribute("FZ_Title")
			if type(title) == "string" then
				suffix ..= "  · " .. Localization.T(title)
			end
			if isSelf then
				Components.Text({
					Text = string.format("%s  @%s%s", player.DisplayName, player.Name, suffix),
					Font = Theme.Fonts.Body,
					TextSize = Theme.Sizes.TextBody,
					Color = Theme.Colors.Text,
					Wrapped = false,
					LayoutOrder = index,
					Parent = list,
				})
			else
				-- Tap a teammate to mute / unmute their voice and radio for you only.
				local muted = app.Voice.IsMuted(player)
				local otherTitle = player:GetAttribute("FZ_Title")
				local row = Components.Button({
					Text = string.format("%s  @%s%s", player.DisplayName, player.Name, if type(otherTitle) == "string" then "  · " .. Localization.T(otherTitle) else ""),
					TagKey = if muted then "LOBBY_UNMUTE" else "LOBBY_MUTE",
					Height = 40,
					LayoutOrder = index,
					Parent = list,
				})
				row.Instance.Activated:Connect(function()
					app.Voice.SetMuted(player, not app.Voice.IsMuted(player))
					refresh()
				end)
			end
		end
	end
	refresh()
	local connections = {
		Players.PlayerAdded:Connect(refresh),
		Players.PlayerRemoving:Connect(function()
			task.defer(refresh)
		end),
		Localization.Changed:Connect(refresh),
	}

	Components.Spacer(column, 10, 4)
	local invite = Components.Button({ Key = "LOBBY_INVITE", LayoutOrder = 5, Parent = column, OnActivated = function()
		task.spawn(function()
			local ok, canInvite = pcall(SocialService.CanSendGameInviteAsync, SocialService, Players.LocalPlayer)
			if ok and canInvite then
				-- The invite carries who invited (server checks it on join; tapping alone pays nothing).
				local sent = pcall(function()
					local options = Instance.new("ExperienceInviteOptions")
					options.LaunchData = "ref:" .. Players.LocalPlayer.UserId
					SocialService:PromptGameInvite(Players.LocalPlayer, options)
				end)
				if not sent then
					pcall(SocialService.PromptGameInvite, SocialService, Players.LocalPlayer)
				end
			else
				app.Hud.Notify("LOBBY_INVITE_UNAVAILABLE")
			end
		end)
	end })
	Components.Button({ Key = "LOBBY_PRIVATE", LayoutOrder = 5, Parent = column, OnActivated = function()
		app.CreatePrivate()
	end })
	Components.Text({ Key = "LOBBY_PRIVATE_HINT", TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 5, Parent = column })
	Components.Text({ Key = "LOBBY_SOLO_HINT", TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 6, Parent = column })
	Components.Spacer(column, 10, 7)
	Components.Button({ Key = "MENU_BACK", LayoutOrder = 8, Parent = column, OnActivated = function()
		router:Pop()
	end })

	return {
		Root = root,
		Focus = invite.Instance,
		Destroy = function()
			for _, connection in connections do
				connection:Disconnect()
			end
		end,
	}
end

return Lobby
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="9330">
              <Properties>
                <string name="Name">MainMenu</string>
                <string name="Source"><![CDATA[-- Main menu (mode "main") and in-game menu (mode "pause").
-- No shop button yet: the shop arrives after the vertical slice (see roadmap).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Localization = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Localization"))
local SessionState = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SessionState"))

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local MainMenu = {}

-- Title block: kicker line, two-tone logo, live waveform, tagline.
function MainMenu.Logo(column: Frame, app, root: GuiObject, compact: boolean?)
	local block = Instance.new("Frame")
	block.Name = "Logo"
	block.BackgroundTransparency = 1
	block.Size = UDim2.new(1, 0, 0, if compact then 62 else 196)
	block.LayoutOrder = 1
	block.Parent = column

	local live = Instance.new("Frame")
	live.Name = "LiveDot"
	live.BackgroundColor3 = Theme.Colors.Accent
	live.BorderSizePixel = 0
	live.Size = UDim2.fromOffset(8, 8)
	live.Position = UDim2.fromOffset(0, 7)
	live.Parent = block
	Components.Corner(live, 4)
	Components.Text({ Text = "LIVE  ·  RELAY 07  ·  147.300 MHz", Font = Theme.Fonts.Mono, TextSize = 13, Color = Theme.Colors.TextDim, Size = UDim2.new(1, -16, 0, 22), Position = UDim2.fromOffset(16, 0), Parent = block })

	local big = if compact then 34 else 56
	local silent = Components.Text({ Text = "SILENT", Font = Theme.Fonts.Title, TextSize = big, Color = Theme.Colors.TextBright, Wrapped = false, Size = UDim2.new(1, 0, 0, 60), Position = UDim2.fromOffset(-3, 24), Parent = block })
	silent.TextStrokeTransparency = 0.85
	local relayX = if compact then 232 else 0
	local relayY = if compact then 24 else 82
	local relayGlow = Components.Text({ Text = "RELAY", Font = Theme.Fonts.Title, TextSize = big, Color = Theme.Colors.AccentDeep, Wrapped = false, Size = UDim2.new(1, -relayX, 0, 60), Position = UDim2.fromOffset(relayX - 1, relayY + 2), Parent = block })
	relayGlow.TextTransparency = 0.35
	local relay = Components.Text({ Text = "RELAY", Font = Theme.Fonts.Title, TextSize = big, Color = Theme.Colors.Accent, Wrapped = false, Size = UDim2.new(1, -relayX, 0, 60), Position = UDim2.fromOffset(relayX - 3, relayY), Parent = block })
	relay.TextStrokeColor3 = Theme.Colors.Accent
	relay.TextStrokeTransparency = 0.7
	if compact then
		-- one line, sized by the font itself (no guessed offsets)
		silent.RichText = true
		silent.Text = string.format('SILENT <font color="%s">RELAY</font>', Theme.Hex(Theme.Colors.Accent))
		silent.Position = UDim2.fromOffset(-2, 18)
		silent.Size = UDim2.new(1, 0, 0, 40)
		relay.Visible = false
		relayGlow.Visible = false
	end

	-- live waveform: thin bars that breathe like a carrier signal with bursts of noise
	local wave = Instance.new("Frame")
	wave.Name = "Wave"
	wave.BackgroundTransparency = 1
	wave.Size = UDim2.new(1, 0, 0, 26)
	wave.Position = UDim2.fromOffset(0, if compact then 76 else 146)
	wave.Visible = not compact
	wave.ClipsDescendants = true
	wave.Parent = block
	local bars = {}
	local count = 64
	for i = 1, count do
		local bar = Instance.new("Frame")
		bar.BorderSizePixel = 0
		bar.AnchorPoint = Vector2.new(0, 0.5)
		bar.Position = UDim2.new((i - 1) / count, 0, 0.5, 0)
		bar.Size = UDim2.new(1 / count, -2, 0, 2)
		bar.BackgroundColor3 = if i % 9 == 0 then Theme.Colors.Accent else Theme.Colors.TextDim
		bar.BackgroundTransparency = 0.25
		bar.Parent = wave
		bars[i] = bar
	end
	Components.Text({ Key = "MENU_TAGLINE", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 176), Parent = block }).Visible = not compact

	local calm = app.Settings.Get("reduceFlicker") == true
	local t = 0
	local burst = 0
	local connection
	connection = RunService.RenderStepped:Connect(function(dt)
		if not root.Parent then
			connection:Disconnect()
			return
		end
		t += dt
		if burst <= 0 and math.random() < dt * 0.25 then
			burst = 0.5
		end
		burst = math.max(0, burst - dt)
		for i, bar in bars do
			local x = i / count
			local carrier = math.sin(x * 18 + t * 3.1) * 0.5 + math.sin(x * 41 - t * 5.3) * 0.25
			local noise = if burst > 0 then math.random() * 1.2 else 0
			local h = math.clamp(math.abs(carrier) * 14 + noise * 12 + 2, 2, 26)
			bar.Size = UDim2.new(1 / count, -2, 0, h)
		end
		live.BackgroundTransparency = 0.15 + (math.sin(t * 4) * 0.5 + 0.5) * 0.6
		if not calm then
			-- rare glitch: the red word jumps a pixel and drops out for a frame
			if burst > 0.42 then
				relay.Position = UDim2.fromOffset(relayX - 3 + math.random(-3, 3), relayY)
				relay.TextTransparency = math.random() * 0.5
			else
				relay.Position = UDim2.fromOffset(relayX - 3, relayY)
				relay.TextTransparency = 0
			end
		end
	end)
end

-- Bottom-right: avatar, name, signal marks.
function MainMenu.PlayerCard(root: GuiObject, app)
	local player = Players.LocalPlayer
	local card = Components.Panel({ Name = "PlayerCard", Size = UDim2.fromOffset(280, 64), AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -20), Parent = root })
	local avatar = Instance.new("ImageLabel")
	avatar.BackgroundColor3 = Theme.Colors.PanelRaised
	avatar.BorderSizePixel = 0
	avatar.Size = UDim2.fromOffset(48, 48)
	avatar.Position = UDim2.fromOffset(8, 8)
	avatar.Parent = card
	Components.Corner(avatar, 24)
	Components.Stroke(avatar, Theme.Colors.Accent, 0.4)
	task.spawn(function()
		local ok, image = pcall(function()
			return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		if ok and avatar.Parent then
			avatar.Image = image
		end
	end)
	Components.Text({ Text = player.DisplayName, Font = Theme.Fonts.Bold, TextSize = 18, Color = Theme.Colors.TextBright, Wrapped = false, Size = UDim2.new(1, -72, 0, 22), Position = UDim2.fromOffset(66, 10), Parent = card }).TextTruncate = Enum.TextTruncate.AtEnd
	Components.Text({ Key = "EXTRAS_BALANCE", Params = { amount = (app.Profile and app.Profile.signalMarks) or 0 }, Font = Theme.Fonts.Mono, TextSize = 13, Color = Theme.Colors.Radio, Wrapped = false, Size = UDim2.new(1, -72, 0, 18), Position = UDim2.fromOffset(66, 34), Parent = card })
end

function MainMenu.new(router, args)
	local app = router.App
	local pause = args and args.mode == "pause"
	-- phones in landscape: compact logo and slimmer buttons so everything fits without scrolling
	local compact = Components.LogicalHeight() < 600
	local buttonHeight = if compact then 38 else nil
	local root, column = Components.ScreenRoot(if pause then "PauseMenu" else "MainMenu")
	local layout = Components.List(column, Theme.Sizes.Gap)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center

	if pause then
		Components.Heading(column, "PAUSE_TITLE", 1)
		Components.Text({ Key = "PAUSE_NOTE", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 2, Parent = column })
	else
		MainMenu.Logo(column, app, root, compact)
	end
	Components.Spacer(column, if compact then 4 else 14, 3)

	local Lobby = require(script.Parent.Lobby)
	local Settings = require(script.Parent.Settings)
	local Extras = require(script.Parent.Extras)
	local Shop = require(script.Parent.Shop)
	local Play = require(script.Parent.Play)
	local UpdatesScreen = require(script.Parent.Updates)

	local primary
	if pause then
		primary = Components.Button({ Key = "MENU_RESUME", Height = buttonHeight, Index = 1, LayoutOrder = 10, Parent = column, OnActivated = function()
			app.Resume()
		end })
	else
		-- Lost connection a moment ago? Offer the way back to the team first.
		if game:GetService("Players").LocalPlayer:GetAttribute("FZ_RejoinAvailable") then
			local rejoin = Components.Button({ Key = "MENU_REJOIN", Height = buttonHeight, Index = 1, LayoutOrder = 8, Parent = column, OnActivated = function()
				app.Rejoin()
			end })
			rejoin.Label.TextColor3 = Theme.Colors.Relay
			primary = rejoin
		end
		-- "Continue" only when the team in this server is already playing something.
		if type(SessionState.Get("Mode")) == "string" then
			primary = Components.Button({ Key = "MENU_CONTINUE", Height = buttonHeight, Index = 1, LayoutOrder = 9, Parent = column, OnActivated = function()
				app.Join()
			end })
		end
		local play = Components.Button({ Key = "MENU_PLAY", Height = buttonHeight, Index = 2, TagKey = if app.HasNewContent() then "CONTENT_NEW" else nil, LayoutOrder = 10, Parent = column, OnActivated = function()
			router:Push(Play)
		end })
		play.Tag.TextColor3 = Theme.Colors.Accent
		primary = primary or play
	end
	Components.Button({ Key = "MENU_LOBBY", Height = buttonHeight, Index = 3, LayoutOrder = 11, Parent = column, OnActivated = function()
		router:Push(Lobby)
	end })
	Components.Button({ Key = "ARCHIVE_TITLE", Height = buttonHeight, Index = 4, LayoutOrder = 12, Parent = column, OnActivated = function()
		router:Push(require(script.Parent.Archive))
	end })
	Components.Button({ Key = "MENU_SHOP", Height = buttonHeight, Index = 5, LayoutOrder = 13, Parent = column, OnActivated = function()
		router:Push(Shop)
	end })
	Components.Button({ Key = "MENU_SETTINGS", Height = buttonHeight, Index = 6, LayoutOrder = 14, Parent = column, OnActivated = function()
		router:Push(Settings)
	end })
	Components.Button({ Key = "MENU_EXTRAS", Height = buttonHeight, Index = 7, LayoutOrder = 15, Parent = column, OnActivated = function()
		router:Push(Extras)
	end })
	if pause then
		local mic = Components.Button({ Key = if app.Radio.IsMuted() then "MIC_UNMUTE" else "MIC_MUTE", Height = buttonHeight, Index = 8, LayoutOrder = 16, Parent = column })
		mic.Instance.Activated:Connect(function()
			app.Radio.ToggleMute()
			Localization.Bind(mic.Label, if app.Radio.IsMuted() then "MIC_UNMUTE" else "MIC_MUTE")
		end)
		Components.Button({ Key = "MENU_LEAVE", Height = buttonHeight, Index = 9, LayoutOrder = 17, Parent = column, OnActivated = function()
			app.Leave()
		end })
	else
		-- Quiet "What's new" link with a small dot when there is an unseen update.
		local updates = Components.Button({ Key = "MENU_UPDATES", TagKey = if app.HasNewUpdate() then "CONTENT_DOT" else nil, Height = 36, LayoutOrder = 20, Parent = column, OnActivated = function()
			router:Push(UpdatesScreen)
		end })
		updates.Label.TextSize = Theme.Sizes.TextSmall
		if compact then
			-- no room in the column on phones: small link above the player card
			updates.Instance.Parent = root
			updates.Instance.AnchorPoint = Vector2.new(1, 1)
			updates.Instance.Position = UDim2.new(1, -24, 1, -92)
			updates.Instance.Size = UDim2.fromOffset(220, 32)
		end
		updates.Label.TextColor3 = Theme.Colors.TextDim
		updates.Tag.TextColor3 = Theme.Colors.Accent
	end

	-- number the entries in display order (01, 02, ...) whatever subset is shown
	local numbered = {}
	for _, child in column:GetChildren() do
		if child:IsA("TextButton") and child:FindFirstChild("Index") then
			table.insert(numbered, child)
		end
	end
	table.sort(numbered, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for i, button in numbered do
		(button:FindFirstChild("Index") :: TextLabel).Text = string.format("%02d", i)
	end
	if not pause then
		MainMenu.PlayerCard(root, app)
	end
	Components.Text({
		Text = "SILENT RELAY  ·  v" .. Config.Version .. "  ·  RELAY 07",
		Font = Theme.Fonts.Mono,
		TextSize = 13,
		Color = Theme.Colors.TextFaint,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, Theme.Sizes.Margin + 16, 1, -12),
		Size = UDim2.fromOffset(320, 18),
		Parent = root,
	})

	return {
		Root = root,
		Focus = primary.Instance,
		OnBack = function()
			if pause then
				app.Resume()
			end
			return true
		end,
	}
end

return MainMenu
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="9331">
              <Properties>
                <string name="Name">Play</string>
                <string name="Source"><![CDATA[-- Play: choose a story chapter or a survival map. Everything comes from Shared/Content,
-- so new chapters and maps appear here automatically after an update.
-- Card tags: In development / Locked / NEW / Completed / Best shift.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Content = require(Shared.Content)
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local Play = {}

local function chapterNumber(id: string?): number?
	local chapter = id and Content.Chapter(id)
	return chapter and chapter.number
end

function Play.new(router)
	local app = router.App
	local profile = app.Profile
	local completed = (profile.progress and profile.progress.completedChapters) or {}
	local seen = profile.seenContent or {}
	local survivalStats = profile.survival or {}

	local root, column = Components.ScreenRoot("Play")
	column.Size = UDim2.new(0, Theme.Sizes.ContentWidth + 80, 1, -48)
	local scroll = Components.ScrollColumn(column, UDim2.fromScale(1, 1))
	local order = 0
	local function nextOrder(): number
		order += 1
		return order
	end
	local focus = nil

	Components.Heading(scroll, "PLAY_TITLE", nextOrder())

	-- A session is already running in this server: offer to join it first.
	local runningMode, runningId = SessionState.Get("Mode"), SessionState.Get("ContentId")
	if type(runningMode) == "string" and type(runningId) == "string" then
		local entry = Content.Entry(runningMode, runningId)
		if entry then
			local join = Components.Button({ Key = "SESSION_JOIN_RUNNING", Params = { name = Localization.T(entry.title) }, LayoutOrder = nextOrder(), Parent = scroll, OnActivated = function()
				app.Join()
			end })
			join.Label.TextColor3 = Theme.Colors.Relay
			focus = join.Instance
		end
	end

	local function tagFor(mode: string, entry): (string, { [string]: any }?)
		if entry.status ~= "available" then
			return "CONTENT_PLANNED", nil
		end
		if not Content.IsUnlocked(entry, completed) then
			return "CONTENT_LOCKED", { number = chapterNumber(entry.requires) or "?" }
		end
		if entry.since and not seen[entry.id] then
			return "CONTENT_NEW", nil
		end
		if mode == "story" then
			if completed[entry.id] then
				return "CONTENT_DONE", nil
			end
			return "CHAPTER_LABEL", { number = entry.number }
		end
		local stats = survivalStats[entry.id]
		if stats and stats.best and stats.best > 0 then
			return "SV_BEST", { shifts = stats.best }
		end
		return "MODE_SURVIVAL", nil
	end

	for _, modeId in Content.ModeOrder do
		local mode = Content.Modes[modeId]
		Components.Spacer(scroll, 8, nextOrder())
		Components.Text({ Key = mode.name, Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.Accent, LayoutOrder = nextOrder(), Parent = scroll })
		Components.Text({ Key = mode.description, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = nextOrder(), Parent = scroll })
		local entries = if modeId == "story" then Content.Chapters else Content.SurvivalMaps
		for _, entry in entries do
			local tagKey, tagParams = tagFor(modeId, entry)
			local playable = Content.IsUnlocked(entry, completed)
			local card = Components.Button({
				Key = entry.title,
				TagKey = tagKey,
				TagParams = tagParams,
				Disabled = not playable,
				LayoutOrder = nextOrder(),
				Parent = scroll,
				OnActivated = function()
					if not seen[entry.id] then
						seen[entry.id] = true
						Net.Event("MarkSeen"):FireServer(entry.id)
					end
					app.Start(modeId, entry.id)
				end,
			})
			if tagKey == "CONTENT_NEW" then
				card.Tag.TextColor3 = Theme.Colors.Accent
			end
			if playable and not focus then
				focus = card.Instance
			end
			if modeId == "survival" and playable then
				Components.Button({ Key = "SV_LEADERBOARD", Height = 34, LayoutOrder = nextOrder(), Parent = scroll, OnActivated = function()
					router:Push(require(script.Parent.Leaderboard), { entry = entry })
				end }).Label.TextSize = Theme.Sizes.TextSmall
			end
		end
	end

	Components.Spacer(scroll, 10, nextOrder())
	local back = Components.Button({ Key = "MENU_BACK", LayoutOrder = nextOrder(), Parent = scroll, OnActivated = function()
		router:Pop()
	end })

	return { Root = root, Focus = focus or back.Instance }
end

return Play
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="9332">
              <Properties>
                <string name="Name">Settings</string>
                <string name="Source"><![CDATA[-- Settings. Every row works the same on every device:
--   mouse / touch: tap the row (next value) or the ‹ › arrows
--   gamepad: A = next value, D-pad left / right = previous / next
--   keyboard: click, or arrow keys while the row is focused
-- Changes apply immediately (no "apply" step) and are saved automatically.

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Localization = require(Shared.Localization)

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local Settings = {}

local function arrow(text: string, parent: Instance, position: UDim2, onActivated: () -> ()): TextButton
	local button = Instance.new("TextButton")
	button.AutoLocalize = false
	button.Text = text
	button.Font = Theme.Fonts.Medium
	button.TextSize = 24
	button.TextColor3 = Theme.Colors.TextDim
	button.BackgroundTransparency = 1
	button.Size = UDim2.new(0, 36, 1, 0)
	button.Position = position
	button.Selectable = false
	button.ZIndex = 3
	button.Parent = parent
	button.Activated:Connect(onActivated)
	return button
end

function Settings.new(router)
	local app = router.App
	local settings = app.Settings
	local root, column = Components.ScreenRoot("Settings")
	column.Size = UDim2.new(0, Theme.Sizes.ContentWidth + 60, 1, -48)
	Components.List(column, Theme.Sizes.Gap)

	Components.Heading(column, "SETTINGS_TITLE", 1)
	local tabsRow = Instance.new("Frame")
	tabsRow.BackgroundTransparency = 1
	tabsRow.Size = UDim2.new(1, 0, 0, 36)
	tabsRow.LayoutOrder = 2
	tabsRow.Parent = column
	Components.List(tabsRow, 4, true)
	local scroll = Components.ScrollColumn(column, UDim2.new(1, 0, 1, -150))
	scroll.LayoutOrder = 3
	local currentCategory = "general"
	local tabButtons = {}
	local rebuild: () -> ()

	local rows: { [GuiObject]: string } = {}
	local valueLabels: { [string]: TextLabel } = {}
	local focus = nil

	local function refreshValues()
		for key, label in valueLabels do
			label.Text = settings.Describe(key)
		end
	end

	local function step(key: string, delta: number, wrapInts: boolean?)
		if key == "language" then
			router:Push(require(script.Parent.LanguageSelect), { firstStart = false })
			return
		end
		local definition = Config.Settings[key]
		if wrapInts and definition.kind == "int" and settings.Get(key) >= definition.max then
			settings.Set(key, definition.min)
		else
			settings.Step(key, delta)
		end
	end

	local CONTROLS = {
		{ "CONTROL_INTERACT", "E", "X / Square", "TOUCH_TAP" },
		{ "CONTROL_SPRINT", "Shift", "L3", "TOUCH_SPRINT" },
		{ "CONTROL_LIGHT", "F", "R1 / RB", "TOUCH_LIGHT" },
		{ "CONTROL_RADIO", "R", "L1 / LB", "TOUCH_RADIO" },
		{ "CONTROL_MIC", "M", "PAD_LEFT", "TOUCH_MIC" },
		{ "CONTROL_NIGHT", "N", "PAD_UP", "TOUCH_NIGHT" },
		{ "CONTROL_ITEMS", "1 – 4", "PAD_RIGHT_Y", "TOUCH_TAP" },
		{ "CONTROL_MENU", "P", "View / Share", "II" },
		{ "CONTROL_BACK", "Backspace", "B / Circle", "MENU_BACK" },
	}

	local function controlsList(startOrder: number)
		local device = app.Input.GetDevice()
		local column = if device == "gamepad" then 3 elseif device == "touch" then 4 else 2
		Components.Text({ Key = "CONTROL_DEVICE_" .. string.upper(device), Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.Accent, LayoutOrder = startOrder, Parent = scroll })
		for index, row in CONTROLS do
			local binding = row[column]
			local line = Components.Text({ Key = row[1], TextSize = Theme.Sizes.TextBody, Color = Theme.Colors.Text, LayoutOrder = startOrder + index, Parent = scroll })
			Components.Text({
				Text = if string.match(binding, "^[A-Z_]+$") and Localization.Has(binding) then Localization.T(binding) else binding,
				Font = Theme.Fonts.Mono,
				TextSize = Theme.Sizes.TextSmall + 1,
				Color = Theme.Colors.TextBright,
				XAlign = Enum.TextXAlignment.Right,
				Size = UDim2.fromScale(0.5, 1),
				Position = UDim2.fromScale(0.5, 0),
				Parent = line,
			})
		end
	end

	rebuild = function()
	for _, child in scroll:GetChildren() do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end
	table.clear(rows)
	table.clear(valueLabels)
	focus = nil
	for index, entry in Config.SettingsOrder do
		if entry.category ~= currentCategory then
			continue
		end
		local key = entry.key
		-- Row button and value area are siblings (value area on top), so a tap on an
		-- arrow is handled only by the arrow, never also by the row.
		local wrapper = Instance.new("Frame")
		wrapper.Name = key
		wrapper.BackgroundTransparency = 1
		wrapper.Size = UDim2.new(1, 0, 0, Theme.Sizes.Button)
		wrapper.LayoutOrder = index * 2
		wrapper.Parent = scroll

		local row = Components.Button({
			Key = entry.label,
			Parent = wrapper,
			OnActivated = function()
				step(key, 1, true)
			end,
		})
		row.Instance.Size = UDim2.fromScale(1, 1)
		row.Label.Size = UDim2.new(0.5, -16, 1, 0)
		;(row.Instance:FindFirstChild("Chevron") :: GuiObject).Visible = false
		rows[row.Instance] = key
		if not focus then
			focus = row.Instance
		end

		local valueArea = Instance.new("Frame")
		valueArea.Name = "Value"
		valueArea.BackgroundTransparency = 1
		valueArea.Active = false
		valueArea.ZIndex = 2
		valueArea.AnchorPoint = Vector2.new(1, 0)
		valueArea.Position = UDim2.fromScale(1, 0)
		valueArea.Size = UDim2.new(0.5, 0, 1, 0)
		valueArea.Parent = wrapper

		local value = Components.Text({
			Text = "",
			Font = Theme.Fonts.Mono,
			TextSize = Theme.Sizes.TextSmall + 1,
			Color = Theme.Colors.TextBright,
			XAlign = Enum.TextXAlignment.Center,
			Wrapped = false,
			Size = UDim2.new(1, -72, 1, 0),
			Position = UDim2.fromOffset(36, 0),
			Parent = valueArea,
		})
		value.TextTruncate = Enum.TextTruncate.AtEnd
		value.ZIndex = 2
		valueLabels[key] = value

		if key ~= "language" then
			arrow("‹", valueArea, UDim2.fromScale(0, 0), function()
				step(key, -1)
			end)
			arrow("›", valueArea, UDim2.new(1, -36, 0, 0), function()
				step(key, 1)
			end)
		end

		if entry.description then
			Components.Text({
				Key = entry.description,
				TextSize = Theme.Sizes.TextSmall,
				Color = Theme.Colors.TextDim,
				AutoY = true,
				Size = UDim2.fromScale(1, 0),
				LayoutOrder = index * 2 + 1,
				Parent = scroll,
			})
		end
	end

	if currentCategory == "controls" then
		controlsList(100)
	end
	-- D-pad left/right must change values instead of moving focus out of the row.
	for row in rows do
		row.NextSelectionLeft = row
		row.NextSelectionRight = row
	end
	refreshValues()
	end

	for index, category in Config.SettingsCategories do
		local tab = Components.Button({ Key = Config.SettingsCategoryLabels[category], Height = 36, Centered = true, LayoutOrder = index, Parent = tabsRow, OnActivated = function()
			currentCategory = category
			for c, b in tabButtons do
				b.SetFocused(c == category)
			end
			rebuild()
		end })
		tab.Instance.Size = UDim2.new(1 / #Config.SettingsCategories, -4, 1, 0)
		tab.Label.TextSize = Theme.Sizes.TextSmall
		tab.Label.TextTruncate = Enum.TextTruncate.AtEnd
		tabButtons[category] = tab
	end
	rebuild()
	tabButtons.general.SetFocused(true)

	local back = Components.Button({ Key = "MENU_BACK", LayoutOrder = 4, Parent = column, OnActivated = function()
		router:Pop()
	end })
	back.Instance.Size = UDim2.new(1, 0, 0, Theme.Sizes.Button)

	local connections = {
		app.Input.DeviceChanged:Connect(function()
			if currentCategory == "controls" then
				rebuild()
			end
		end),
		settings.Changed:Connect(refreshValues),
		Localization.Changed:Connect(refreshValues),
		UserInputService.InputBegan:Connect(function(input)
			local selected = GuiService.SelectedObject
			local key = selected and rows[selected]
			if not key or key == "language" then
				return
			end
			if input.KeyCode == Enum.KeyCode.DPadLeft or input.KeyCode == Enum.KeyCode.Left then
				step(key, -1)
			elseif input.KeyCode == Enum.KeyCode.DPadRight or input.KeyCode == Enum.KeyCode.Right then
				step(key, 1)
			end
		end),
	}

	return {
		Root = root,
		Focus = tabButtons.general.Instance,
		Destroy = function()
			for _, connection in connections do
				connection:Disconnect()
			end
		end,
	}
end

return Settings
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="9333">
              <Properties>
                <string name="Name">Shop</string>
                <string name="Source"><![CDATA[-- Shop: tabs (Equipment / Upgrades / Cosmetics) with large cards, Signal Mark balance,
-- confirmation before every unlock. Works with mouse, touch and gamepad (cards are
-- selectable buttons, tabs too). No Robux prompts in here except the clearly labelled,
-- purely cosmetic supporter pass (only shown when its id is configured).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local Shop = {}

local RESULT = { funds = "SHOP_NOT_ENOUGH", error = "SHOP_ERROR", owned = "SHOP_OWNED" }

function Shop.new(router)
	local app = router.App
	local player = Players.LocalPlayer
	local root, column = Components.ScreenRoot("Shop")
	column.Size = UDim2.new(0, 640, 1, -48)
	local sizeLimit = column:FindFirstChildOfClass("UISizeConstraint")
	if sizeLimit then
		sizeLimit.MaxSize = Vector2.new(640, math.huge)
	end
	Components.List(column, Theme.Sizes.Gap)

	local header = Instance.new("Frame")
	header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, 0, 0, 44)
	header.LayoutOrder = 1
	header.Parent = column
	Components.Heading(header, "MENU_SHOP")
	local balance = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextBody, Color = Theme.Colors.Radio, XAlign = Enum.TextXAlignment.Right, Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.fromScale(0.5, 0), Parent = header })

	local tabsRow = Instance.new("Frame")
	tabsRow.BackgroundTransparency = 1
	tabsRow.Size = UDim2.new(1, 0, 0, 40)
	tabsRow.LayoutOrder = 2
	tabsRow.Parent = column
	Components.List(tabsRow, 4, true)

	local grid = Instance.new("ScrollingFrame")
	grid.Name = "Grid"
	grid.BackgroundTransparency = 1
	grid.BorderSizePixel = 0
	grid.Size = UDim2.new(1, 0, 1, -220)
	grid.CanvasSize = UDim2.new()
	grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	grid.ScrollBarThickness = 3
	grid.ScrollBarImageColor3 = Theme.Colors.TextFaint
	grid.Selectable = false
	grid.LayoutOrder = 3
	grid.Parent = column
	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.new(0.5, -6, 0, 132)
	gridLayout.CellPadding = UDim2.fromOffset(8, 8)
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.Parent = grid

	local status = Components.Text({ Key = "SHOP_FAIR", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 4, Parent = column })
	Components.Button({ Key = "MENU_BACK", LayoutOrder = 6, Parent = column, OnActivated = function()
		router:Pop()
	end })

	local data = { inventory = {}, equipped = {}, balance = 0 }
	local currentTab = "gear"
	local pendingConfirm: string? = nil
	local busy = false
	local firstCard: GuiObject? = nil
	local render: () -> ()

	local function setStatus(key: string, params: { [string]: any }?, positive: boolean?)
		status.TextColor3 = if positive then Theme.Colors.Relay else Theme.Colors.TextDim
		Localization.Bind(status, key, params)
	end

	local function call(action: string, itemId: string?)
		if busy then
			return
		end
		busy = true
		local ok, result = pcall(function()
			return Net.Function("ShopAction"):InvokeServer(action, itemId)
		end)
		busy = false
		if ok and type(result) == "table" and result.inventory then
			data = result
		end
		if not ok or type(result) ~= "table" or not result.ok then
			setStatus(RESULT[(type(result) == "table" and result.reason) or "error"] or "SHOP_ERROR")
		elseif action == "buy" then
			setStatus("SHOP_DONE", nil, true)
		elseif action == "equip" and Catalog.Items[itemId :: string].kind == "set" then
			setStatus("SHOP_ONE_SET")
		end
		render()
	end

	local function card(itemId: string, order: number)
		local item = Catalog.Items[itemId]
		local owned = data.inventory[itemId] == true
		local equipped = data.equipped.set == itemId or data.equipped.radioSkin == itemId or data.equipped.flashlight == itemId
		local button = Instance.new("TextButton")
		button.Name = itemId
		button.AutoButtonColor = false
		button.Text = ""
		button.AutoLocalize = false
		button.BackgroundColor3 = Theme.Colors.Panel
		button.BackgroundTransparency = 0.05
		button.LayoutOrder = order
		button.Selectable = true
		local stroke = Instance.new("UIStroke")
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = if equipped then Theme.Colors.Relay else Theme.Colors.PanelLine
		stroke.Thickness = if equipped then 2 else 1
		stroke.Parent = button
		local selection = Instance.new("Frame")
		selection.BackgroundTransparency = 1
		local selectionStroke = Instance.new("UIStroke")
		selectionStroke.Color = Theme.Colors.Accent
		selectionStroke.Thickness = 2
		selectionStroke.Parent = selection
		button.SelectionImageObject = selection
		button.Parent = grid
		Components.Padding(button, 12, 10)

		local icon = Instance.new("Frame")
		icon.Size = UDim2.fromOffset(56, 56)
		icon.BackgroundColor3 = item.color
		icon.BorderSizePixel = 0
		icon.Parent = button
		Components.Text({ Text = item.icon, Font = Theme.Fonts.Mono, TextSize = 14, Color = Theme.Colors.TextBright, XAlign = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = icon })

		Components.Text({ Key = item.name, Font = Theme.Fonts.Bold, TextSize = Theme.Sizes.TextBody, Color = Theme.Colors.TextBright, Size = UDim2.new(1, -66, 0, 22), Position = UDim2.fromOffset(66, 0), Wrapped = false, Parent = button })
		local desc = Components.Text({ Key = item.description, TextSize = 13, Color = Theme.Colors.TextDim, Size = UDim2.new(1, -66, 0, 54), Position = UDim2.fromOffset(66, 22), YAlign = Enum.TextYAlignment.Top, Parent = button })
		desc.TextTruncate = Enum.TextTruncate.AtEnd

		local actionKey, params
		if pendingConfirm == itemId then
			actionKey, params = "SHOP_CONFIRM_YES", nil
		elseif not owned then
			actionKey, params = "SHOP_BUY", { price = item.price }
		elseif equipped and item.kind ~= "upgrade" then
			actionKey = "SHOP_UNEQUIP"
		elseif item.kind == "upgrade" then
			actionKey = "SHOP_OWNED"
		else
			actionKey = "SHOP_EQUIP"
		end
		local action = Components.Text({ Key = actionKey, Params = params, Font = Theme.Fonts.Mono, TextSize = 14, Color = if pendingConfirm == itemId then Theme.Colors.Accent elseif owned then Theme.Colors.Relay else Theme.Colors.Radio, XAlign = Enum.TextXAlignment.Right, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -20), Parent = button })
		action.Name = "Action"

		button.Activated:Connect(function()
			if not owned then
				if pendingConfirm == itemId then
					pendingConfirm = nil
					call("buy", itemId)
				else
					pendingConfirm = itemId
					setStatus("SHOP_CONFIRM", { price = item.price })
					render()
					GuiService.SelectedObject = grid:FindFirstChild(itemId) :: GuiObject?
				end
			elseif item.kind ~= "upgrade" then
				call(if equipped then "unequip" else "equip", itemId)
			end
		end)
		if not firstCard then
			firstCard = button
		end
	end

	local tabButtons = {}
	render = function()
		local selectedName = GuiService.SelectedObject and GuiService.SelectedObject.Name
		Localization.Bind(balance, "EXTRAS_BALANCE", { amount = data.balance or 0 })
		for _, child in grid:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		firstCard = nil
		for index, itemId in Catalog.Order do
			if Catalog.Items[itemId].tab == currentTab then
				card(itemId, index)
			end
		end
		for tab, button in tabButtons do
			button.SetFocused(tab == currentTab)
		end
		if selectedName and app.Input.GetDevice() == "gamepad" then
			local again = grid:FindFirstChild(selectedName)
			if again then
				GuiService.SelectedObject = again :: GuiObject
			end
		end
	end

	for index, tab in Catalog.Tabs do
		local tabButton = Components.Button({ Key = Catalog.TabLabels[tab], Height = 40, Centered = true, LayoutOrder = index, Parent = tabsRow, OnActivated = function()
			currentTab = tab
			pendingConfirm = nil
			render()
		end })
		tabButton.Instance.Size = UDim2.new(1 / #Catalog.Tabs, -4, 1, 0)
		tabButton.Label.TextSize = Theme.Sizes.TextBody
		tabButtons[tab] = tabButton
	end

	-- Cosmetic supporter pass (Robux), only if configured
	for _, pass in Catalog.GamePasses do
		if pass.id > 0 then
			Components.Button({ Key = pass.name, TagKey = pass.description, LayoutOrder = 5, Parent = column, OnActivated = function()
				MarketplaceService:PromptGamePassPurchase(player, pass.id)
			end })
		end
	end

	render()
	task.spawn(call, "get")

	return {
		Root = root,
		Focus = tabButtons.gear.Instance,
		OnBack = function()
			if pendingConfirm then
				pendingConfirm = nil
				render()
				return true
			end
			return false
		end,
	}
end

return Shop
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="9334">
              <Properties>
                <string name="Name">Updates</string>
                <string name="Source"><![CDATA[-- "What's new": optional, opened by the player from the main menu. Never a pop-up.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local Updates = require(Shared.Updates)

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local UpdatesScreen = {}

function UpdatesScreen.new(router)
	local app = router.App
	local root, column = Components.ScreenRoot("Updates")
	local scroll = Components.ScrollColumn(column, UDim2.fromScale(1, 1))
	Components.Heading(scroll, "UPDATES_TITLE", 1)
	local order = 1
	for _, update in Updates do
		order += 1
		Components.Spacer(scroll, 10, order)
		order += 1
		Components.Text({ Key = update.title, Font = Theme.Fonts.Bold, TextSize = Theme.Sizes.TextBody, Color = Theme.Colors.TextBright, LayoutOrder = order, Parent = scroll })
		order += 1
		Components.Text({ Text = "v" .. update.id, Font = Theme.Fonts.Mono, TextSize = 13, Color = Theme.Colors.TextFaint, LayoutOrder = order, Parent = scroll })
		for _, line in update.lines do
			order += 1
			Components.Text({ Key = line, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.Text, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = order, Parent = scroll })
		end
	end
	order += 1
	local back = Components.Button({ Key = "MENU_BACK", LayoutOrder = order + 1, Parent = scroll, OnActivated = function()
		router:Pop()
	end })

	-- Opening the overview marks the newest update as seen (removes the small dot).
	local newest = Updates[1]
	if newest and app.Profile.lastSeenUpdate ~= newest.id then
		app.Profile.lastSeenUpdate = newest.id
		Net.Event("MarkSeen"):FireServer("update:" .. newest.id)
	end

	return { Root = root, Focus = back.Instance }
end

return UpdatesScreen
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="9335">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- Visual language of every interface: quiet, cinematic, high contrast, one accent colour.

local Theme = {}

Theme.Colors = {
	Background = Color3.fromRGB(5, 7, 10),
	Panel = Color3.fromRGB(12, 16, 21),
	PanelRaised = Color3.fromRGB(20, 26, 33),
	PanelLine = Color3.fromRGB(52, 62, 72),
	Text = Color3.fromRGB(212, 216, 220),
	TextBright = Color3.fromRGB(246, 246, 242),
	TextDim = Color3.fromRGB(136, 146, 156),
	TextFaint = Color3.fromRGB(82, 92, 102),
	Accent = Color3.fromRGB(232, 62, 50), -- "signal red": focus, warnings, live signal
	AccentDeep = Color3.fromRGB(120, 22, 18),
	Radio = Color3.fromRGB(226, 192, 124), -- unknown voices on the radio (warm amber)
	Relay = Color3.fromRGB(140, 214, 208), -- the Relay voice (cold teal)
	World = Color3.fromRGB(190, 192, 186), -- sound captions
	Good = Color3.fromRGB(120, 214, 150),
}

Theme.Fonts = {
	Title = Enum.Font.Michroma,
	Body = Enum.Font.BuilderSans,
	Medium = Enum.Font.BuilderSansMedium,
	Bold = Enum.Font.BuilderSansBold,
	Mono = Enum.Font.RobotoMono,
}

-- Logical sizes at UIScale 1 (UIScale adapts them to the device, see Components.AttachScale).
Theme.Sizes = {
	Button = 52,
	Gap = 6,
	TextTitle = 30,
	TextHeading = 24,
	TextButton = 22,
	TextBody = 18,
	TextSmall = 15,
	Margin = 48,
	ContentWidth = 460,
	Corner = 6,
}

Theme.Fast = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
Theme.Fade = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
Theme.Slow = TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

function Theme.Hex(color: Color3): string
	return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
