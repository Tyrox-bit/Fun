	-- Phase 2: radio, shop, creature, map
	SETTINGS_RADIO_MODE = "Botão do rádio",
	SETTINGS_RADIO_MODE_DESC = "Segure para falar, ou toque uma vez para começar e outra para parar.",
	VALUE_HOLD = "Segurar",
	VALUE_TOGGLE = "Alternar",
	TOUCH_RADIO = "Rádio",
	TOUCH_MIC = "Mic",
	TOUCH_NIGHT = "Noite",
	RADIO_TX = "TRANSMITINDO",
	RADIO_RX = "Recebendo: {name}",
	MIC_ON = "Microfone aberto",
	MIC_OFF = "Microfone mudo",
	MIC_MUTE = "Silenciar meu microfone",
	MIC_UNMUTE = "Ativar meu microfone",
	VOICE_UNAVAILABLE = "O chat de voz está desligado na sua conta. Você ainda pode ouvir o rádio e jogar normalmente.",
	LOBBY_MUTE = "Silenciar",
	LOBBY_UNMUTE = "Ativar",
	MENU_SHOP = "Loja",
	SHOP_TAB_GEAR = "Equipamento",
	SHOP_TAB_UPGRADES = "Melhorias",
	SHOP_TAB_COSMETIC = "Cosméticos",
	SHOP_BUY = "Desbloquear · {price}",
	SHOP_EQUIP = "Equipar",
	SHOP_EQUIPPED = "Equipado",
	SHOP_UNEQUIP = "Remover",
	SHOP_OWNED = "Desbloqueado",
	SHOP_CONFIRM = "Desbloquear por {price} marcas de sinal?",
	SHOP_CONFIRM_YES = "Sim, desbloquear",
	SHOP_NOT_ENOUGH = "Ainda não há marcas de sinal suficientes.",
	SHOP_DONE = "Desbloqueado.",
	SHOP_ERROR = "Não deu certo. Nada foi descontado.",
	SHOP_FAIR = "Equipamentos só se conseguem jogando, nunca com Robux.",
	SHOP_ONE_SET = "Só é possível equipar um conjunto por vez.",
	ITEM_TECH_NAME = "Kit de técnico",
	ITEM_TECH_DESC = "Ferramentas de reparo. Fusíveis, relés e portas são operados 40 % mais rápido.",
	ITEM_OBSERVER_NAME = "Kit de observador",
	ITEM_OBSERVER_DESC = "Visão noturna com bateria recarregável. Mostra rastros recentes da criatura.",
	ITEM_MEDIC_NAME = "Kit de socorrista",
	ITEM_MEDIC_DESC = "Começa com 2 kits médicos, levanta colegas duas vezes mais rápido e com mais vida. Itens de cura 50 % mais fortes.",
	ITEM_FLASHLIGHT_NAME = "Melhoria da lanterna",
	ITEM_FLASHLIGHT_DESC = "Feixe mais longo. Ofuscar a criatura recarrega mais rápido.",
	ITEM_SKIN_OLIVE_NAME = "Rádio: oliva de campo",
	ITEM_SKIN_RUST_NAME = "Rádio: ferrugem",
	ITEM_SKIN_SIGNAL_NAME = "Rádio: vermelho sinal",
	ITEM_SKIN_DESC = "Carcaça cosmética para o seu rádio.",
	ITEM_SUPPORTER_NAME = "Passe de apoiador",
	ITEM_SUPPORTER_DESC = "Apoia o desenvolvimento. Inclui a carcaça vermelho sinal. Apenas cosmético.",
	HUD_DOWNED = "Você caiu. Sua equipe pode te levantar.",
	HUD_SIGNAL_LOST = "Sinal perdido. De volta ao último ponto de controle.",
	INTERACT_REVIVE = "Levantar (kit médico)",
	OBJECT_TEAMMATE = "Colega",
	INTERACT_PICKUP = "Pegar",
	INTERACT_INSERT = "Colocar fusíveis",
	INTERACT_ACTIVATE = "Ativar",
	INTERACT_CLOSE = "Fechar",
	INTERACT_HOLD_BREAKER = "Segurar o disjuntor",
	INTERACT_LEAVE = "Sair da estação",
	OBJECT_FUSE = "Fusível",
	OBJECT_RELAY_B = "Relé do setor B",
	OBJECT_CORE = "Núcleo central",
	OBJECT_BREAKER = "Disjuntor do setor A",
	OBJECT_ANTENNA = "Antena",
	DOOR_LOCKED = "Trancada – sem energia",
	OBJECTIVE_REACH_CONTROL = "Entre na sala de controle.",
	OBJECTIVE_FIND_FUSES = "Encontre fusíveis ({count}/{total}).",
	OBJECTIVE_RELAY_B = "Reative o relé do setor B.",
	OBJECTIVE_CORE = "Ative o núcleo central.",
	OBJECTIVE_ANTENNA = "Chegue à antena do lado de fora.",
