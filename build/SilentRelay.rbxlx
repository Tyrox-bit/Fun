      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Badges</string>
          <string name="Source"><![CDATA[-- Roblox badges. Create them in the Creator Hub (Experience -> Associated Items -> Badges)
-- and paste the ids here. 0 = not created yet (nothing is awarded, no errors).

return {
	ch1_complete = 0, -- finished chapter 1
	ch1_archive = 0, -- found every find on Relay Station 07
	ch2_complete = 0, -- finished chapter 2
	ch3_complete = 0, -- finished chapter 3
	ch4_complete = 0, -- finished chapter 4 (any ending)
	ending_counter = 0, -- the secret ending
	forecast_breaker = 0, -- broke a forecast
	survival_5 = 0, -- survived 5 shifts
	survival_10 = 0, -- survived 10 shifts
	answered = 0, -- answered the voice
	stayed_silent = 0, -- stayed silent
	community = 0, -- joined the official community (exclusive relay badge)
	-- achievements (same ids as Shared/Achievements.luau)
	first_contact = 0,
	unseen = 0,
	archivist = 0,
	last_survivor = 0,
	nobody_left = 0,
	night_shift_10 = 0,
	decoder = 0,
	rescuer = 0,
	storm_chaser = 0,
	run_0007 = 0,
	ending_answer = 0,
	ending_silence = 0,
}
]]></string>
        </Properties>
