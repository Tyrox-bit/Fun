      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">Lore</string>
          <string name="Source"><![CDATA[-- Archive entries (DAS ARCHIV). Every entry has a permanent id saved in data.secrets.logs.
--   category: photo | report | tape | observation | radio | confidential | past | insight
--   links:    insights unlock automatically once every linked entry has been found
--   photo:    rendered live from avatar copies (see EvidenceService / PhotoView)
-- New entries for new chapters are simply appended here (+ texts in the language files).

return {
	-- Chapter 1 · Relay Station 07
	{ id = "rec_c1_arrival", category = "radio", title = "ARCH_REC_ARRIVAL_TITLE", body = "ARCH_REC_ARRIVAL_BODY", map = "relay07" },
	{ id = "rec_c1_relay", category = "radio", title = "ARCH_REC_RELAY_TITLE", body = "ARCH_REC_RELAY_BODY", map = "relay07" },
	{ id = "calendar_2009", category = "past", title = "CAL_TITLE", body = "CAL_BODY", map = "relay07" },
	{ id = "log_okafor", category = "tape", title = "LOG_OKAFOR_TITLE", body = "LOG_OKAFOR_BODY", map = "relay07" },
	{ id = "log_venn", category = "report", title = "LOG_VENN_TITLE", body = "LOG_VENN_BODY", map = "relay07" },
	{ id = "log_ehle", category = "observation", title = "LOG_EHLE_TITLE", body = "LOG_EHLE_BODY", map = "relay07" },
	{ id = "log_0006", category = "confidential", title = "LOG_0006_TITLE", body = "LOG_0006_BODY", map = "relay07" },
	{ id = "photo_past_self", category = "photo", title = "PHOTO_PAST_TITLE", body = "PHOTO_PAST_BODY", map = "relay07", photo = "past_self" },
	{ id = "photo_team_future", category = "photo", title = "PHOTO_FUTURE_TITLE", body = "PHOTO_FUTURE_BODY", map = "relay07", photo = "team_future" },
	{ id = "photo_mate_dark", category = "photo", title = "PHOTO_DARK_TITLE", body = "PHOTO_DARK_BODY", map = "relay07", photo = "mate_dark" },
	-- Insights: connections between documents (optional secrets)
	{ id = "insight_same_words", category = "insight", title = "INSIGHT_WORDS_TITLE", body = "INSIGHT_WORDS_BODY", map = "relay07", links = { "log_okafor", "rec_c1_relay" }, reward = 100 },
	{ id = "insight_how_long", category = "insight", title = "INSIGHT_LOOP_TITLE", body = "INSIGHT_LOOP_BODY", map = "relay07", links = { "log_0006", "photo_past_self", "calendar_2009" }, reward = 150 },
	-- Chapter 2 · Staumauer 3
	{ id = "rec_c2_arrival", category = "radio", title = "ARCH_REC_C2_ARRIVAL_TITLE", body = "ARCH_REC_C2_ARRIVAL_BODY", map = "dam03" },
	{ id = "rec_c2_plea", category = "radio", title = "ARCH_REC_C2_PLEA_TITLE", body = "ARCH_REC_C2_PLEA_BODY", map = "dam03" },
	{ id = "c2_keeper_log", category = "report", title = "C2_KEEPER_TITLE", body = "C2_KEEPER_BODY", map = "dam03" },
	{ id = "c2_correction_1", category = "confidential", title = "C2_CORR1_TITLE", body = "C2_CORR1_BODY", map = "dam03" },
	{ id = "c2_correction_2", category = "confidential", title = "C2_CORR2_TITLE", body = "C2_CORR2_BODY", map = "dam03" },
	{ id = "c2_correction_3", category = "confidential", title = "C2_CORR3_TITLE", body = "C2_CORR3_BODY", map = "dam03" },
	{ id = "c2_coffee", category = "observation", title = "C2_COFFEE_TITLE", body = "C2_COFFEE_BODY", map = "dam03" },
	{ id = "c2_dorm_tape", category = "tape", title = "C2_DORM_TITLE", body = "C2_DORM_BODY", map = "dam03" },
	{ id = "log_kessler", category = "tape", title = "LOG_KESSLER_TITLE", body = "LOG_KESSLER_BODY", map = "dam03" },
	{ id = "insight_corrections", category = "insight", title = "INSIGHT_CORR_TITLE", body = "INSIGHT_CORR_BODY", map = "dam03", links = { "c2_correction_1", "c2_correction_2", "c2_correction_3" }, reward = 150 },
	-- Chapter 3 · Kapelle
	{ id = "c3_memorial", category = "past", title = "C3_MEMORIAL_TITLE", body = "C3_MEMORIAL_BODY", map = "church" },
	{ id = "c3_hymn", category = "observation", title = "C3_HYMN_TITLE", body = "C3_HYMN_BODY", map = "church" },
	{ id = "c3_priest_note", category = "report", title = "C3_PRIEST_TITLE", body = "C3_PRIEST_BODY", map = "church" },
	{ id = "c3_index_card", category = "report", title = "C3_INDEX_TITLE", body = "C3_INDEX_BODY", map = "church" },
	{ id = "log_marek", category = "tape", title = "LOG_MAREK_TITLE", body = "LOG_MAREK_BODY", map = "church" },
	{ id = "rec_c3_run0007", category = "confidential", title = "ARCH_REC_C3_RUN_TITLE", body = "ARCH_REC_C3_RUN_BODY", map = "church" },
	{ id = "insight_six", category = "insight", title = "INSIGHT_SIX_TITLE", body = "INSIGHT_SIX_BODY", map = "church", links = { "c3_memorial", "log_kessler", "log_marek" }, reward = 150 },
	-- Chapter 4 · Mine
	{ id = "rec_c4_arrival", category = "radio", title = "ARCH_REC_C4_ARRIVAL_TITLE", body = "ARCH_REC_C4_ARRIVAL_BODY", map = "mine" },
	{ id = "c4_mine_notice", category = "past", title = "C4_NOTICE_TITLE", body = "C4_NOTICE_BODY", map = "mine" },
	{ id = "c4_shift_log", category = "report", title = "C4_SHIFT_TITLE", body = "C4_SHIFT_BODY", map = "mine" },
	{ id = "c4_loop_tape", category = "tape", title = "C4_LOOP_TITLE", body = "C4_LOOP_BODY", map = "mine" },
	{ id = "insight_june", category = "insight", title = "INSIGHT_JUNE_TITLE", body = "INSIGHT_JUNE_BODY", map = "mine", links = { "log_okafor", "c4_loop_tape", "rec_c3_run0007" }, reward = 200 },
	-- Community secret (see Shared/SecretsRegistry): only unlocked by solving it
	{ id = "file_null", category = "confidential", title = "FILE_NULL_TITLE", body = "FILE_NULL_BODY", map = "relay07", secret = true },
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Net: declares every remote in one place. The server creates them, clients wait for them.
-- Direction is documented per remote; every client->server remote is validated and
-- rate limited on the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "FZ_Remotes"

local EVENTS = {
	"UpdateSetting", -- C->S (key, value)
	"SetFlashlight", -- C->S (enabled)
	"Subtitle", -- S->C (line)
	"Document", -- S->C (document)
	"Notify", -- S->C (key, params)
	"Sfx", -- S->C (soundName, position | instance, volume?)
	"RadioState", -- C->S (transmitting)
	"MicMute", -- C->S (muted)
	"FlashCreature", -- C->S () flashlight cone hits the creature (server validates)
	"MonsterAttack", -- C->S () admin monster mode
	"Footprint", -- S->C (position) observer set only
	"Hurt", -- S->C (amount)
	"MarkSeen", -- C->S (contentId | "update:<id>") NEW badges
	"Scare", -- S->C (beat, data) HorrorDirector moments (often for ONE player only)
	"Decision", -- S->C (decision | nil) open / update / close a team decision
	"DecisionVote", -- C->S (decisionId, optionIndex)
	"UseItem", -- C->S (slot)
	"Photo", -- S->C (photo) supernatural evidence to render
}

local FUNCTIONS = {
	"FetchProfile", -- C->S () -> snapshot of settings/progress
	"RedeemCode", -- C->S (code) -> result
	"AdminAction", -- C->S (action, payload) -> result
	"ShopAction", -- C->S (action, itemId) -> result
	"Session", -- C->S (action, mode, contentId) -> result
	"GetLeaderboard", -- C->S (survivalId) -> top entries
	"SolveSecret", -- C->S (text) -> secret result
	"Community", -- C->S ("status" | "claim") -> community reward
}

local Net = {}

local folder: Folder? = nil

local function getFolder(): Folder
	if folder then
		return folder
	end
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if existing then
			folder = existing
		else
			local created = Instance.new("Folder")
			created.Name = FOLDER_NAME
			for _, name in EVENTS do
				local remote = Instance.new("RemoteEvent")
				remote.Name = name
				remote.Parent = created
			end
			for _, name in FUNCTIONS do
				local remote = Instance.new("RemoteFunction")
				remote.Name = name
				remote.Parent = created
			end
			created.Parent = ReplicatedStorage
			folder = created
		end
	else
		folder = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
	end
	return folder :: Folder
end

function Net.Event(name: string): RemoteEvent
	assert(table.find(EVENTS, name), "[FZ-Net] Unknown RemoteEvent: " .. name)
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Net.Function(name: string): RemoteFunction
	assert(table.find(FUNCTIONS, name), "[FZ-Net] Unknown RemoteFunction: " .. name)
	return getFolder():WaitForChild(name) :: RemoteFunction
end

-- Call on the server before any client can need the remotes.
function Net.Init()
	getFolder()
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">SecretsRegistry</string>
          <string name="Source"><![CDATA[-- Community secrets: puzzles hidden in the maps, fully solvable inside the game.
-- Public part only (what unlocks, rewards). The ANSWERS live in
-- ServerStorage/Secrets/SecretAnswers.luau and never reach a client.
-- Add a new secret: one entry here + one answer there + its archive file in Lore.luau.

return {
	{
		id = "zero_frequency",
		unlock = "file_null", -- archive entry revealed when solved
		marks = 250,
		-- in-world clues: the fax time (02:14), June's tape (41 minutes), the core screen (run 0007)
	},
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">SessionState</string>
          <string name="Source"><![CDATA[-- SessionState: session-wide story state (shared by the whole team in this server).
-- Stored as attributes on ReplicatedStorage.FZ_State, so late joiners automatically
-- receive the current state without any extra remote calls or race conditions.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "FZ_State"

local SessionState = {}

local cached: Folder? = nil

local function getFolder(): Folder
	if cached then
		return cached
	end
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not existing then
			existing = Instance.new("Folder")
			existing.Name = FOLDER_NAME
			existing.Parent = ReplicatedStorage
		end
		cached = existing :: Folder
	else
		cached = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
	end
	return cached :: Folder
end

function SessionState.Get(key: string): any
	return getFolder():GetAttribute(key)
end

function SessionState.Set(key: string, value: any)
	assert(RunService:IsServer(), "SessionState.Set is server-only")
	getFolder():SetAttribute(key, value)
end

-- Calls callback immediately with the current value and again on every change.
function SessionState.Observe(key: string, callback: (any) -> ()): RBXScriptConnection
	local folder = getFolder()
	task.spawn(callback, folder:GetAttribute(key))
	return folder:GetAttributeChangedSignal(key):Connect(function()
		callback(folder:GetAttribute(key))
	end)
end

function SessionState.Init()
	getFolder()
end

return SessionState
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[-- Signal: tiny, leak-safe event implementation used by client and server modules.
-- Handlers run in their own thread so a failing handler never breaks the emitter.

local Connection = {}
Connection.__index = Connection

function Connection:Disconnect()
	if not self.Connected then
		return
	end
	self.Connected = false
	local list = self._signal._connections
	local index = table.find(list, self)
	if index then
		table.remove(list, index)
	end
end

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _connections = {} }, Signal)
end

function Signal:Connect(handler: (...any) -> ())
	local connection = setmetatable({ Connected = true, _handler = handler, _signal = self }, Connection)
	table.insert(self._connections, connection)
	return connection
end

function Signal:Once(handler: (...any) -> ())
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		handler(...)
	end)
	return connection
end

function Signal:Fire(...)
	for _, connection in table.clone(self._connections) do
		if connection.Connected then
			task.spawn(connection._handler, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	for _, connection in table.clone(self._connections) do
		connection:Disconnect()
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">Titles</string>
          <string name="Source"><![CDATA[-- Profile titles: earned by playing, never bought. Shown next to your name in the team
-- list. Requirements are evaluated on the server from the save data.

local Lore = require(script.Parent.Lore)

local Titles = {}

local function count(t: { [any]: any }?): number
	local n = 0
	for _ in t or {} do
		n += 1
	end
	return n
end

Titles.List = {
	{ id = "first_contact", name = "TITLE_FIRST_CONTACT", hint = "TITLE_FIRST_CONTACT_HINT", earned = function(data)
		return data.progress.completedChapters.ch1 ~= nil
	end },
	{ id = "breaker", name = "TITLE_BREAKER", hint = "TITLE_BREAKER_HINT", earned = function(data)
		return count(data.secrets.forecastsBroken) > 0
	end },
	{ id = "archivist", name = "TITLE_ARCHIVIST", hint = "TITLE_ARCHIVIST_HINT", earned = function(data)
		for _, entry in Lore do
			if entry.map == "relay07" and not entry.secret and not data.secrets.logs[entry.id] then
				return false
			end
		end
		return true
	end },
	{ id = "night_shift", name = "TITLE_NIGHT_SHIFT", hint = "TITLE_NIGHT_SHIFT_HINT", earned = function(data)
		for _, stats in data.modes.survival do
			if (stats.best or 0) >= 5 then
				return true
			end
		end
		return false
	end },
	{ id = "listener", name = "TITLE_LISTENER", hint = "TITLE_LISTENER_HINT", earned = function(data)
		return data.storyChoices.c1_answer == 1
	end },
	{ id = "silent", name = "TITLE_SILENT", hint = "TITLE_SILENT_HINT", earned = function(data)
		return data.storyChoices.c1_answer == 2
	end },
	-- the three endings of chapter 4
	{ id = "loop", name = "TITLE_LOOP", hint = "TITLE_LOOP_HINT", earned = function(data)
		return data.storyChoices.c4_ending == 1
	end },
	{ id = "dawn", name = "TITLE_DAWN", hint = "TITLE_DAWN_HINT", earned = function(data)
		return data.storyChoices.c4_ending == 2
	end },
	{ id = "june", name = "TITLE_JUNE", hint = "TITLE_JUNE_HINT", earned = function(data)
		return data.storyChoices.c4_ending == 3
	end },
	-- exclusive cosmetic badge for members of the official community
	{ id = "relay_member", name = "TITLE_RELAY_MEMBER", hint = "TITLE_RELAY_MEMBER_HINT", earned = function(data)
		return data.community ~= nil and data.community.claimed ~= nil
	end },
}

function Titles.Get(id: string)
	for _, title in Titles.List do
		if title.id == id then
			return title
		end
	end
	return nil
end

return Titles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Updates</string>
          <string name="Source"><![CDATA[-- Update log shown in "What's new" (main menu, small link - never a pop-up).
-- Newest first. Every entry's text lives in the language files (UPD_<id>_*).

return {
	{
		id = "0.5.0",
		title = "UPD_050_TITLE",
		lines = { "UPD_050_1", "UPD_050_2", "UPD_050_3" },
	},
	{
		id = "0.4.0",
		title = "UPD_040_TITLE",
		lines = { "UPD_040_1", "UPD_040_2", "UPD_040_3", "UPD_040_4", "UPD_040_5" },
	},
	{
		id = "0.3.0",
		title = "UPD_030_TITLE",
		lines = { "UPD_030_1", "UPD_030_2", "UPD_030_3", "UPD_030_4" },
	},
	{
		id = "0.2.0",
		title = "UPD_020_TITLE",
		lines = { "UPD_020_1", "UPD_020_2", "UPD_020_3" },
	},
}
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="28">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="29">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">AdminConfig</string>
          <string name="Source"><![CDATA[-- Who may use the owner/maintenance tools.
-- Authorization is ALWAYS decided here on the server. The in-game "gesture code" only
-- reveals the menu for people who are already authorized; it never grants rights.

return {
	-- Additional developer UserIds (numbers). The experience owner is detected automatically:
	-- * user-owned experience: game.CreatorId
	-- * group-owned experience: members with rank >= MinGroupRank in the owning group
	UserIds = {
		-- 123456789,
	},
	MinGroupRank = 254,

	-- Everyone who can open the place in Studio is a developer of it, so Studio test
	-- sessions are authorized by default. Set to false to test the "denied" path.
	AllowAllInStudio = true,
}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="31">
        <Properties>
          <string name="Name">Chapters</string>
        </Properties>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Chapter1</string>
            <string name="Source"><![CDATA[-- Chapter 1 "The Reception" on Relay Station 07.
-- The gameplay loop of the design: Explore -> Discover -> Understand -> Decide -> Act ->
-- Consequences -> new secrets. Built only from the generic systems:
--   DecisionService (team votes), ForecastService (predictions you can break),
--   DirectorService (scares + hints), PowerService (systems), StoryService (lines).
--
--  1  Gate: arrival transmission (per player) -> gatehouse fax "sent tomorrow, 02:14"
--  2  DECISION: the unknown voice asks you to answer. Answer or stay silent? (saved)
--  3  Control room: emergency power carries only 2 of 3 systems (levers, changeable):
--       cameras (see where it is) / hall lights (see better - and be seen) /
--       ventilation (fans mask your steps - but it can use the vents)
--  4  3 fuses in 3 random sectors. 1st fuse wakes the creature (earlier if you answered)
--  5  FORECAST 1 at the 2nd fuse: "lights in Sector A go out" - hold breaker A to break it
--  6  Relay B -> core doors open. FORECAST 2: "the generator in E fails" - restart it
--  7  Core -> the Relay says a player's name ("this time, not the left door")
--  8  Antenna -> ending line -> back to the menu, chapter saved as completed

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local Services = script.Parent.Parent.Services
local StoryService = require(Services.StoryService)
local InteractionService = require(Services.InteractionService)
local PowerService = require(Services.PowerService)
local CreatureService = require(Services.CreatureService)
local DataService = require(Services.DataService)
local NoiseService = require(Services.NoiseService)
local DecisionService = require(Services.DecisionService)
local ForecastService = require(Services.ForecastService)
local DirectorService = require(Services.DirectorService)
local DoorService = require(Services.DoorService)
local HealthService = require(Services.HealthService)
local AnalyticsTracker = require(Services.AnalyticsTracker)
local BadgeTracker = require(Services.BadgeTracker)
local HorrorEvents = require(script.Parent.Parent.Director.HorrorEvents)
local LoreService = require(Services.LoreService)
local AchievementService = require(Services.AchievementService)
local ReferralService = require(Services.ReferralService)

local Chapter1 = {}
Chapter1.StartCheckpoint = "C1_START"

local TOTAL_FUSES = 3
local SYSTEMS = { "cameras", "halls", "vents" }

local active = false
local ctx = nil -- { setCheckpoint, finish, playersInGame }
local fuseFolder: Folder? = nil

local state = {
	stage = "arrival", -- arrival | decision | control | power | fuses | relay | core | antenna | done
	fuses = 0,
	answered = false,
	systems = {} :: { [string]: boolean },
	powerChosenOnce = false,
	completedBy = {} :: { [Player]: boolean },
}

local ARRIVAL = {
	{ delay = 1.5, text = "SFX_STATIC", channel = "sfx", duration = 2 },
	{ delay = 1.0, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C1_001", channel = "radio", duration = 5.5 },
	{ delay = 5.8, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C1_002", channel = "radio", duration = 4 },
	{ delay = 5.0, text = "SFX_FAX", channel = "world", duration = 3 },
}

local HINTS = {
	OBJECTIVE_CHECK_GATEHOUSE = "HINT_GATEHOUSE",
	OBJECTIVE_REACH_CONTROL = "HINT_CONTROL",
	OBJECTIVE_POWER = "HINT_POWER",
	OBJECTIVE_FIND_FUSES = "HINT_FUSES",
	OBJECTIVE_RELAY_B = "HINT_RELAY",
	OBJECTIVE_CORE = "HINT_CORE",
	OBJECTIVE_ANTENNA = "HINT_ANTENNA",
}

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local stepped: { [string]: boolean } = {}
local function step(name: string)
	if stepped[name] then
		return
	end
	stepped[name] = true
	for _, player in ctx.playersInGame() do
		AnalyticsTracker.ChapterStep(player, "Chapter1", name)
	end
end

local function rewardAll(amount: number)
	for _, player in ctx.playersInGame() do
		DataService.Grant(player, amount)
	end
end

local function sfxAt(name: string, position: Vector3)
	Net.Event("Sfx"):FireAllClients(name, position)
end

local function relay(text: string, params: { [string]: any }?, delay: number?)
	StoryService.Sequence("all", { { delay = delay or 0.5, speaker = "SPEAKER_RELAY", text = text, params = params, channel = "radio", duration = 4.5 } })
end

local function unknown(text: string, params: { [string]: any }?, delay: number?)
	StoryService.Sequence("all", { { delay = delay or 0.5, speaker = "SPEAKER_UNKNOWN", text = text, params = params, channel = "radio", duration = 5 } })
end

local function patrolCenter(area: string): Vector3?
	for _, node in CollectionService:GetTagged("FZ_CreaturePatrol") do
		if node:IsA("BasePart") and node:GetAttribute("Area") == area then
			return node.Position
		end
	end
	return nil
end

local function randomName(): string
	local team = ctx.playersInGame()
	local named = team[math.random(1, math.max(1, #team))]
	return if named then named.DisplayName else ""
end

local function wakeCreature()
	if CreatureService.Get() then
		return
	end
	CreatureService.Spawn()
	relay("RADIO_C1_WAKE", nil, 1.5)
end

---------------------------------------------------------------------------
-- Power distribution (decision in the world, can be changed any time)
---------------------------------------------------------------------------
local function applySystems()
	local s = state.systems
	SessionState.Set("Cameras", s.cameras == true)
	if not s.cameras then
		SessionState.Set("CctvArea", nil)
	end
	PowerService.Set("HALLS", s.halls == true)
	CreatureService.SetSightScale(if s.halls then 1.3 else 1)
	CreatureService.SetVentsEnabled(s.vents == true)
	NoiseService.SetFootstepScale(if s.vents then 0.6 else 1)
	for _, lamp in CollectionService:GetTagged("FZ_LeverLamp") do
		if lamp:IsA("BasePart") then
			local on = s[lamp:GetAttribute("LeverLamp")] == true
			lamp.Color = if on then Color3.fromRGB(90, 220, 140) else Color3.fromRGB(40, 40, 38)
		end
	end
end

local function systemsOn(): number
	local count = 0
	for _, name in SYSTEMS do
		if state.systems[name] then
			count += 1
		end
	end
	return count
end

local function spawnFuses()
	if fuseFolder then
		fuseFolder:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "FZ_Fuses"
	folder.Parent = workspace
	fuseFolder = folder
	local bySector: { [string]: { BasePart } } = {}
	for _, spot in CollectionService:GetTagged("FZ_FuseSpot") do
		if spot:IsA("BasePart") then
			local sector = tostring(spot:GetAttribute("Sector"))
			bySector[sector] = bySector[sector] or {}
			table.insert(bySector[sector], spot)
		end
	end
	local sectors = {}
	for sector in bySector do
		table.insert(sectors, sector)
	end
	for i = #sectors, 2, -1 do
		local j = math.random(1, i)
		sectors[i], sectors[j] = sectors[j], sectors[i]
	end
	for i = 1, math.min(TOTAL_FUSES, #sectors) do
		local spots = bySector[sectors[i]]
		local spot = spots[math.random(1, #spots)]
		local fuse = Instance.new("Part")
		fuse.Name = "Fuse"
		fuse.Size = Vector3.new(0.5, 0.5, 1.4)
		fuse.Color = Color3.fromRGB(214, 170, 60)
		fuse.Material = Enum.Material.Metal
		fuse.Anchored = true
		fuse.CanCollide = false
		fuse.CFrame = spot.CFrame * CFrame.new(0, 0.1, 0)
		local glow = Instance.new("PointLight")
		glow.Range = 5
		glow.Brightness = 0.8
		glow.Color = Color3.fromRGB(255, 200, 90)
		glow.Parent = fuse
		fuse:SetAttribute("InteractId", "c1_fuse")
		fuse:SetAttribute("ActionKey", "INTERACT_PICKUP")
		fuse:SetAttribute("ObjectKey", "OBJECT_FUSE")
		fuse:SetAttribute("MaxDistance", 7)
		fuse.Parent = folder
		CollectionService:AddTag(fuse, "FZ_Interactable")
	end
end

local function startFuses()
	state.stage = "fuses"
	relay("RADIO_C1_TERMINAL", nil, 3)
	spawnFuses()
	StoryService.SetObjective("OBJECTIVE_FIND_FUSES", { count = 0, total = TOTAL_FUSES })
	if state.answered then
		-- Consequence of answering: the station knows you are here. It wakes up now.
		task.delay(8, function()
			if active then
				wakeCreature()
			end
		end)
	end
end

---------------------------------------------------------------------------
-- Decision: answer the voice?
---------------------------------------------------------------------------
local function askAnswer()
	state.stage = "decision"
	unknown("RADIO_C1_ASK", nil, 2)
	task.delay(6, function()
		if not active then
			return
		end
		DecisionService.Ask({
			id = "c1_answer",
			prompt = "DECISION_C1_ANSWER",
			options = { "DECISION_ANSWER", "DECISION_SILENT" },
			seconds = 20,
			default = 2,
			onDecided = function(index)
				if not active then
					return
				end
				state.answered = index == 1
				step("Decision")
				for _, p in ctx.playersInGame() do
					BadgeTracker.Award(p, if state.answered then "answered" else "stayed_silent")
				end
				if state.answered then
					unknown("RADIO_C1_ANSWERED", { name = randomName() }, 1)
					relay("RADIO_C1_RELAY_ANSWERED", nil, 7)
				else
					unknown("RADIO_C1_SILENT", nil, 1)
					relay("RADIO_C1_RELAY_SILENT", nil, 6)
				end
				task.delay(10, function()
					if active and state.stage == "decision" then
						state.stage = "control"
						StoryService.SetObjective("OBJECTIVE_REACH_CONTROL")
					end
				end)
			end,
		}, ctx.playersInGame)
	end)
end

---------------------------------------------------------------------------
-- Forecasts
---------------------------------------------------------------------------
local function forecastLightsA()
	ForecastService.Start({
		id = "c1_lights_a",
		kind = "power",
		text = "RADIO_C1_FORECAST",
		hud = "FORECAST_LIGHTS_A",
		seconds = 30,
		breakWith = "c1_breaker_a",
		onKept = function()
			PowerService.Set("A", false)
			local center = patrolCenter("A")
			if center then
				sfxAt("power_down", center)
				CreatureService.Alert(center)
			end
			StoryService.Say("all", { text = "SFX_POWER_DOWN", channel = "world", duration = 3, critical = true })
		end,
		onBroken = function() end,
		keptLine = "RADIO_C1_FORECAST_KEPT",
		brokenLine = "RADIO_C1_FORECAST_BROKEN",
	})
end

local function forecastGenerator()
	ForecastService.Start({
		id = "c1_generator_e",
		kind = "machine",
		text = "RADIO_C1_FORECAST_GEN",
		hud = "FORECAST_GENERATOR_E",
		seconds = 40,
		breakWith = "generator",
		onKept = function()
			PowerService.Set("E", false)
			local center = patrolCenter("E")
			if center then
				sfxAt("power_down", center)
				CreatureService.Alert(center)
			end
			StoryService.Say("all", { text = "SFX_POWER_DOWN", channel = "world", duration = 3, critical = true })
		end,
		onBroken = function(player)
			sfxAt("relay_activate", (player.Character :: Model):GetPivot().Position)
		end,
		keptLine = "RADIO_C1_FORECAST_KEPT",
		brokenLine = "RADIO_C1_FORECAST_GEN_BROKEN",
	})
end

---------------------------------------------------------------------------
-- Scares (HorrorDirector beats) - the moments of the first ten minutes
---------------------------------------------------------------------------
local function inBuilding(position: Vector3): boolean
	return math.abs(position.X) < 100 and position.Z > -85 and position.Z < 70
end

local function screenNear(position: Vector3, radius: number): boolean
	for _, screen in CollectionService:GetTagged("FZ_CctvScreen") do
		if screen:IsA("BasePart") and (screen.Position - position).Magnitude < radius then
			return true
		end
	end
	return false
end

local function beats()
	local function after(stage: string): boolean
		local order = { "arrival", "decision", "control", "power", "fuses", "relay", "core", "antenna", "done" }
		return (table.find(order, state.stage) or 0) >= (table.find(order, stage) or 0)
	end
	return {
		{
			-- The monitor shows the team in a hallway 20 s in the future - and something
			-- behind the last person. Only ONE player sees the figure; the others see the
			-- same feed without it.
			id = "cctv_future",
			kind = "cctv",
			once = true,
			weight = 50,
			others = true,
			condition = function(_player, info)
				return state.systems.cameras == true and after("power") and screenNear(info.position, 12)
			end,
			data = function()
				return { withFigure = true, offset = 20 }
			end,
		},
		{
			id = "name_call",
			kind = "namecall",
			once = true,
			weight = 20,
			condition = function(_player, info)
				return info.alone and after("fuses") and inBuilding(info.position)
			end,
			data = function(player)
				return { name = player.DisplayName, answered = state.answered }
			end,
		},
		{
			-- A figure at the end of a hallway that is gone a moment later.
			id = "apparition_hall",
			kind = "apparition",
			once = true,
			weight = 20,
			condition = function(_player, info)
				return info.area == "HALL" and after("control")
			end,
		},
		{
			id = "apparition_late",
			kind = "apparition",
			once = true,
			condition = function(_player, info)
				return info.area ~= nil and info.area ~= "HALL" and after("relay")
			end,
		},
		{
			id = "footsteps",
			kind = "footsteps",
			condition = function(_player, info)
				return info.alone and inBuilding(info.position) and after("control")
			end,
		},
		{
			id = "flicker",
			kind = "flicker",
			condition = function(_player, info)
				return info.area ~= nil and info.area ~= "HALL" and after("control")
			end,
		},
		{
			-- A familiar room changes: a door behind you closes by itself.
			id = "door_slam",
			kind = "doorslam",
			once = true,
			condition = function(_player, info)
				return after("fuses") and inBuilding(info.position)
			end,
			data = function(player)
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if root then
					for _, panel in CollectionService:GetTagged("FZ_Door") do
						if panel:IsA("BasePart") and panel:GetAttribute("Open") and (panel.Position - root.Position).Magnitude < 25 then
							DoorService.Close(panel)
							break
						end
					end
				end
				return {}
			end,
		},
	}
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------
local function reset()
	state.stage = "arrival"
	state.fuses = 0
	state.answered = false
	state.powerChosenOnce = false
	table.clear(state.systems)
	table.clear(state.completedBy)
	if fuseFolder then
		fuseFolder:Destroy()
		fuseFolder = nil
	end
	ForecastService.Cancel()
	DecisionService.Cancel()
	DirectorService.Stop()
	StoryService.ResetFlags()
	StoryService.SetObjective(nil)
	SessionState.Set("Cameras", nil)
	SessionState.Set("CctvArea", nil)
end

function Chapter1.Begin()
	reset()
	table.clear(stepped)
	active = true
	applySystems()
	DirectorService.Configure(HorrorEvents.With(beats()), HINTS, ctx.playersInGame)
end

function Chapter1.Stop()
	active = false
	reset()
	NoiseService.SetFootstepScale(1)
	CreatureService.SetVentsEnabled(true)
	CreatureService.SetSightScale(1)
end

-- Registers interaction handlers once. Every handler ignores input unless chapter 1 is
-- the running session (the same objects are used by the survival mode).
function Chapter1.Init(context)
	ctx = context
	ForecastService.Breakable("c1_breaker_a")
	ForecastService.Breakable("generator")

	InteractionService.Register("c1_fax", function(player)
		if not active then
			return
		end
		StoryService.ShowDocument(player, { title = "FAX_TITLE", body = "FAX_BODY", date = os.time() + 24 * 60 * 60 })
		if StoryService.GetFlag("C1_FaxRead") then
			return
		end
		StoryService.SetFlag("C1_FaxRead", true)
		step("Fax")
		LoreService.UnlockAll(ctx.playersInGame(), "rec_c1_relay")
		relay("RADIO_C1_003", nil, 3)
		askAnswer()
	end)

	InteractionService.Register("c1_terminal", function()
		if not active or (state.stage ~= "control" and state.stage ~= "arrival" and state.stage ~= "decision") then
			return
		end
		DecisionService.Cancel()
		state.stage = "power"
		step("Power")
		for _, p in ctx.playersInGame() do
			ReferralService.Complete(p) -- invited new players: reached the control room
		end
		ctx.setCheckpoint("C1_CONTROL")
		relay("RADIO_C1_POWER")
		StoryService.SetObjective("OBJECTIVE_POWER", { count = systemsOn(), total = 2 })
	end)

	InteractionService.Register("c1_power", function(player, lever)
		if not active or state.stage == "arrival" or state.stage == "decision" or state.stage == "control" then
			return
		end
		local system = lever:GetAttribute("System")
		if type(system) ~= "string" or not table.find(SYSTEMS, system) then
			return
		end
		if state.systems[system] then
			state.systems[system] = nil
		elseif systemsOn() < 2 then
			state.systems[system] = true
		else
			Net.Event("Notify"):FireClient(player, "SYS_FULL")
			Net.Event("Sfx"):FireAllClients("door_locked", (lever :: BasePart).Position)
			return
		end
		Net.Event("Sfx"):FireAllClients("relay_activate", (lever :: BasePart).Position)
		NoiseService.Emit((lever :: BasePart).Position, Config.Noise.Door, player)
		applySystems()
		if state.stage == "power" then
			StoryService.SetObjective("OBJECTIVE_POWER", { count = systemsOn(), total = 2 })
			if systemsOn() == 2 and not state.powerChosenOnce then
				state.powerChosenOnce = true
				-- The Relay reacts to WHAT you chose (consequence you can hear).
				local leftOut = "cameras"
				for _, name in SYSTEMS do
					if not state.systems[name] then
						leftOut = name
					end
				end
				relay("RADIO_C1_POWER_NO_" .. string.upper(leftOut), nil, 1)
				task.delay(6, function()
					if active and state.stage == "power" then
						startFuses()
					end
				end)
			end
		end
	end)

	InteractionService.Register("c1_fuse", function(player, fuse)
		if not active or state.stage ~= "fuses" or not fuse.Parent then
			return
		end
		sfxAt("fuse_pickup", (fuse :: BasePart).Position)
		fuse:Destroy()
		state.fuses += 1
		rewardAll(Config.Rewards.Fuse)
		NoiseService.Emit((player.Character :: Model):GetPivot().Position, Config.Noise.Interact, player)
		step(if state.fuses == 1 then "FirstFuse" else "")
		if state.fuses >= Config.Creature.ActivateAfterFuses then
			wakeCreature()
		end
		if state.fuses == 2 then
			forecastLightsA()
		end
		if state.fuses >= TOTAL_FUSES then
			state.stage = "relay"
			step("AllFuses")
			StoryService.SetObjective("OBJECTIVE_RELAY_B")
		else
			StoryService.SetObjective("OBJECTIVE_FIND_FUSES", { count = state.fuses, total = TOTAL_FUSES })
		end
	end)

	InteractionService.Register("c1_relay_b", function(_player, panel)
		if not active or state.stage ~= "relay" then
			return
		end
		state.stage = "core"
		step("Relay")
		PowerService.Set("B", true)
		sfxAt("relay_activate", (panel :: BasePart).Position)
		NoiseService.Emit((panel :: BasePart).Position, 60, nil)
		StoryService.Say("all", { text = "SFX_RELAY", channel = "world", duration = 3 })
		rewardAll(Config.Rewards.Relay)
		ctx.setCheckpoint("C1_CORE")
		StoryService.SetObjective("OBJECTIVE_CORE")
		task.delay(12, function()
			if active and state.stage == "core" and not ForecastService.IsActive() then
				forecastGenerator()
			end
		end)
	end)

	InteractionService.Register("c1_core", function(_player, console)
		if not active or state.stage ~= "core" then
			return
		end
		state.stage = "antenna"
		step("Core")
		PowerService.Set("CORE", true)
		sfxAt("relay_activate", (console :: BasePart).Position)
		CreatureService.Alert((console :: BasePart).Position)
		StoryService.Sequence("all", {
			{ delay = 2, text = "SFX_STATIC", channel = "sfx", duration = 2 },
			{
				delay = 1.5,
				speaker = "SPEAKER_RELAY",
				text = if state.answered then "RADIO_C1_CORE_ANSWERED" else "RADIO_C1_CORE",
				params = { name = randomName() },
				channel = "radio",
				duration = 5,
			},
		})
		task.delay(8, function()
			if active then
				StoryService.SetObjective("OBJECTIVE_ANTENNA")
			end
		end)
	end)

	InteractionService.Register("c1_antenna", function()
		if not active or (state.stage ~= "antenna" and state.stage ~= "done") then
			return
		end
		if state.stage == "antenna" then
			state.stage = "done"
			step("Antenna")
			ForecastService.Cancel()
			unknown(if state.answered then "RADIO_C1_ANTENNA_ANSWERED" else "RADIO_C1_ANTENNA", nil, 1)
			CreatureService.SetAIEnabled(false)
			task.delay(14, function()
				if active and state.stage == "done" then
					ctx.finish()
				end
			end)
		end
		for _, p in ctx.playersInGame() do
			if not state.completedBy[p] then
				state.completedBy[p] = true
				DataService.Grant(p, Config.Rewards.ChapterComplete)
				DataService.Mutate(p, function(data)
					if data.progress.completedChapters.ch1 == nil then
						data.progress.completedChapters.ch1 = os.time()
					end
				end)
				DataService.SaveNow(p)
				Net.Event("Notify"):FireClient(p, "CHAPTER_COMPLETE")
				BadgeTracker.Award(p, "ch1_complete")
				if not CreatureService.Spotted[p] then
					AchievementService.Award(p, "unseen")
				end
				local team = ctx.playersInGame()
				if #team >= 2 and next(HealthService.SessionStats.eliminated) == nil then
					AchievementService.Award(p, "nobody_left")
				end
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		state.completedBy[player] = nil
	end)
end

function Chapter1.OnPlayerEntered(player: Player, firstTime: boolean)
	if not firstTime or not active then
		return
	end
	if state.stage == "arrival" then
		AnalyticsTracker.ChapterStep(player, "Chapter1", "Gate")
		-- New Game+: after the "Answer" ending the station greets you back
		local lines = table.clone(ARRIVAL)
		local profile = DataService.Get(player)
		if profile and profile.Data.storyChoices.c4_ending == 1 then
			table.insert(lines, 2, { delay = 1.0, speaker = "SPEAKER_RELAY", text = "RADIO_C1_RETURN", channel = "radio", duration = 4 })
		end
		StoryService.Sequence(player, lines)
		task.delay(12, function()
			if player.Parent then
				LoreService.Unlock(player, "rec_c1_arrival", true)
				AchievementService.Award(player, "first_contact")
			end
		end)
		if StoryService.GetObjective() == nil then
			task.delay(14, function()
				if active and StoryService.GetObjective() == nil then
					StoryService.SetObjective("OBJECTIVE_CHECK_GATEHOUSE")
				end
			end)
		end
	end
end

return Chapter1
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Chapter2</string>
            <string name="Source"><![CDATA[-- Chapter 2 "The Wrong Voice" on Staumauer 3 (storm night).
-- Forecasts become personal, broken forecasts change the dam, the Listener hunts actively,
-- and for the first time the two voices contradict each other.
--
--  1  Valley road -> crew building (zone) -> read the dam keeper's log
--  2  FORECAST (door, personal): "the canteen locks - with {name} inside" (override panel)
--  3  Powerhouse: restart both turbines. FORECAST (water): "the bottom outlet opens, the
--     gallery floods" (valve wheel). Kept -> gallery closed, the long way: the ramp outside.
--  4  Valve house on the crest: the Unknown pleads "Answer us!", the Relay says "Not yet."
--     DECISION c2_trust: trust the unknown voice (gate opens now, the Listener hears it) or
--     the Relay (close the spillway first, then the gate opens)
--  5  Antenna yard: hold the uplink together through the storm -> both voices answer

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Services = script.Parent.Parent.Services
local StoryService = require(Services.StoryService)
local InteractionService = require(Services.InteractionService)
local CreatureService = require(Services.CreatureService)
local NoiseService = require(Services.NoiseService)
local DecisionService = require(Services.DecisionService)
local ForecastService = require(Services.ForecastService)
local DirectorService = require(Services.DirectorService)
local DoorService = require(Services.DoorService)
local LoreService = require(Services.LoreService)
local AchievementService = require(Services.AchievementService)
local HorrorEvents = require(script.Parent.Parent.Director.HorrorEvents)
local ChapterKit = require(script.Parent.ChapterKit)

local Chapter2 = {}
Chapter2.StartCheckpoint = "C2_START"

local k = ChapterKit.new("Chapter2", "ch2")
local UPLINK_SECONDS = 25
local UPLINK_RADIUS = 18

local ORDER = { "arrival", "crew", "forecast", "turbines", "crest", "decision", "spillway", "yard", "uplink", "done" }
local state = {
	stage = "arrival",
	turbines = {} :: { [any]: boolean },
	flooded = false,
	trustedUnknown = false,
	uplink = 0,
}

local HINTS = {
	OBJ_C2_CREW = "HINT_C2_CREW",
	OBJ_C2_LOG = "HINT_C2_LOG",
	OBJ_C2_TURBINES = "HINT_C2_TURBINES",
	OBJ_C2_CREST = "HINT_C2_CREST",
	OBJ_C2_CREST_RAMP = "HINT_C2_CREST_RAMP",
	OBJ_C2_SPILLWAY = "HINT_C2_SPILLWAY",
	OBJ_C2_UPLINK = "HINT_C2_UPLINK",
}

local function after(stage: string): boolean
	return (table.find(ORDER, state.stage) or 0) >= (table.find(ORDER, stage) or 0)
end

local function wake()
	if CreatureService.Count() == 0 then
		CreatureService.Spawn()
		k.relay("RADIO_C2_WAKE", nil, 1)
	end
end

---------------------------------------------------------------------------
-- Stages
---------------------------------------------------------------------------
local function startTurbines()
	state.stage = "turbines"
	k.step("Turbines")
	wake()
	k.objective("OBJ_C2_TURBINES", { count = 0, total = 2 })
	k.relay("RADIO_C2_TURBINES", nil, 3)
end

local function personalForecast()
	state.stage = "forecast"
	local name = k.randomName()
	ForecastService.Start({
		id = "c2_canteen",
		kind = "door",
		text = "RADIO_C2_FORECAST_DOOR",
		params = { name = name },
		hud = "FORECAST_CANTEEN",
		seconds = 30,
		breakWith = "c2_override",
		onKept = function()
			local doors = k.findAll("FZ_Door", function(panel)
				return panel:GetAttribute("Canteen") ~= nil
			end)
			for _, panel in doors do
				k.lock(panel)
			end
			k.world("SFX_DOORS_LOCK")
			wake()
			local canteen = k.find("FZ_CreaturePatrol", function(node)
				return node:GetAttribute("Area") == "CANTEEN"
			end)
			if canteen then
				CreatureService.Alert(canteen.Position)
			end
			k.after(25, function()
				for _, panel in doors do
					DoorService.SetLocked(panel, false)
				end
			end)
			k.after(4, startTurbines)
		end,
		onBroken = function()
			k.after(5, startTurbines)
		end,
		keptLine = "RADIO_C2_FORECAST_DOOR_KEPT",
		brokenLine = "RADIO_C2_FORECAST_DOOR_BROKEN",
	})
end

local function floodForecast()
	ForecastService.Start({
		id = "c2_flood",
		kind = "water",
		text = "RADIO_C2_FORECAST_FLOOD",
		hud = "FORECAST_FLOOD",
		seconds = 35,
		breakWith = "c2_valve",
		onKept = function()
			state.flooded = true
			k.setFlood(true)
			for _, panel in k.findAll("FZ_Door", function(p)
				return p:GetAttribute("Gallery") ~= nil
			end) do
				k.lock(panel)
			end
			local portal = k.door("Gallery")
			if portal then
				k.sfx("water_rush_loop", portal.Position, 1)
			end
			k.world("SFX_FLOOD")
		end,
		onBroken = function() end,
		keptLine = "RADIO_C2_FORECAST_FLOOD_KEPT",
		brokenLine = "RADIO_C2_FORECAST_FLOOD_BROKEN",
	})
end

local function startYard()
	state.stage = "yard"
	k.unlock(k.door("YardGate"), true)
	k.objective("OBJ_C2_UPLINK")
end

local function askTrust()
	state.stage = "decision"
	k.step("Decision")
	LoreService.UnlockAll(k.players(), "rec_c2_plea")
	k.sequence({
		{ delay = 1, text = "SFX_STATIC", channel = "sfx", duration = 2 },
		{ delay = 1.5, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C2_PLEA", channel = "radio", duration = 5, critical = true },
		{ delay = 5, speaker = "SPEAKER_RELAY", text = "RADIO_C2_NOT_YET", channel = "radio", duration = 4, critical = true },
		{ delay = 4.5, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C2_PLEA_2", channel = "radio", duration = 5 },
	})
	k.after(16, function()
		DecisionService.Ask({
			id = "c2_trust",
			prompt = "DECISION_C2_TRUST",
			options = { "DECISION_TRUST_UNKNOWN", "DECISION_TRUST_RELAY" },
			seconds = 25,
			default = 2,
			onDecided = function(index)
				if not k.active then
					return
				end
				state.trustedUnknown = index == 1
				if state.trustedUnknown then
					k.unknown("RADIO_C2_TRUST_UNKNOWN", nil, 1)
					k.relay("RADIO_C2_RELAY_HURT", nil, 7)
					-- the answer is loud: the Listener heard where you are
					local valve = k.interactable("c2_spillway")
					if valve then
						CreatureService.Alert(valve.Position)
					end
					startYard()
				else
					state.stage = "spillway"
					k.relay("RADIO_C2_TRUST_RELAY", nil, 1)
					k.unknown("RADIO_C2_UNKNOWN_HURT", nil, 6)
					k.objective("OBJ_C2_SPILLWAY")
				end
			end,
		}, k.players)
	end)
end

local function finishChapter()
	state.stage = "done"
	k.step("Uplink")
	ForecastService.Cancel()
	CreatureService.SetAIEnabled(false)
	k.objective(nil)
	k.sequence({
		{ delay = 1, text = "SFX_THUNDER", channel = "world", duration = 3 },
		{ delay = 2, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C2_END_UNKNOWN", channel = "radio", duration = 5 },
		{ delay = 5.5, speaker = "SPEAKER_RELAY", text = if state.trustedUnknown then "RADIO_C2_END_RELAY_UNKNOWN" else "RADIO_C2_END_RELAY", channel = "radio", duration = 5 },
		{ delay = 6, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C2_END_NAMES", params = { name = k.randomName() }, channel = "radio", duration = 5, critical = true },
	})
	k.after(19, function()
		k.complete("ch2_complete", function(player)
			AchievementService.Award(player, "storm_chaser")
		end)
	end)
	k.after(22, function()
		k.ctx.finish()
	end)
end

---------------------------------------------------------------------------
-- Scares
---------------------------------------------------------------------------
local function beats()
	return {
		{ id = "c2_footsteps", kind = "footsteps", condition = function(_p, info)
			return info.alone and after("crew")
		end },
		{ id = "c2_flicker", kind = "flicker", condition = function(_p, info)
			return info.area ~= nil and after("crew")
		end },
		{ id = "c2_gallery_figure", kind = "apparition", once = true, weight = 20, condition = function(_p, info)
			return info.area == "GALLERY" or info.area == "INCLINE"
		end },
		{ id = "c2_crest_figure", kind = "apparition", once = true, weight = 15, condition = function(_p, info)
			return (info.area == "CREST" or info.area == "RAMP") and after("turbines")
		end },
		{ id = "c2_name", kind = "namecall", once = true, weight = 20, condition = function(_p, info)
			return info.alone and after("turbines")
		end, data = function(player)
			return { name = player.DisplayName, answered = false }
		end },
		{ id = "c2_door", kind = "doorslam", once = true, condition = function(_p, info)
			return info.area == "CANTEEN" or info.area == "DORM" or info.area == "OFFICE"
		end, data = function(player)
			local root = k.rootOf(player)
			if root then
				local panel = k.find("FZ_Door", function(p)
					return p:GetAttribute("Open") == true and (p.Position - root.Position).Magnitude < 25
				end)
				if panel then
					DoorService.Close(panel)
				end
			end
			return {}
		end },
	}
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------
local function reset()
	k.reset()
	state.stage = "arrival"
	table.clear(state.turbines)
	state.flooded = false
	state.trustedUnknown = false
	state.uplink = 0
	k.setFlood(false)
	ForecastService.Cancel()
	DecisionService.Cancel()
	DirectorService.Stop()
	StoryService.ResetFlags()
	StoryService.SetObjective(nil)
	k.setState("Weather", nil)
end

function Chapter2.Begin()
	reset()
	k.active = true
	k.setState("Weather", "storm")
	CreatureService.SetDifficulty({ speed = 1.05, hearing = 1.2 })
	DirectorService.Configure(HorrorEvents.With(beats()), HINTS, k.players)

	k.zones({
		{ id = "crew", center = Vector3.new(-80, 0, 70), radius = 42, when = function()
			return state.stage == "arrival"
		end, fn = function()
			state.stage = "crew"
			k.step("Crew")
			k.ctx.setCheckpoint("C2_VALLEY")
			k.relay("RADIO_C2_CREW", nil, 1)
			k.objective("OBJ_C2_LOG")
		end },
		{ id = "crest", center = Vector3.new(132, 44, -10), radius = 16, when = function()
			return state.stage == "crest"
		end, fn = function()
			k.ctx.setCheckpoint("C2_CREST")
			askTrust()
		end },
	})
	-- the Listener hunts actively once the turbines run
	k.every(40, function()
		return after("turbines") and state.stage ~= "done"
	end, k.huntPulse)
	-- storm: thunder now and then (sound + caption only for people who want captions)
	k.every(23, function()
		return state.stage ~= "done"
	end, function()
		Net.Event("Sfx"):FireAllClients(if math.random() < 0.5 then "thunder_1" else "thunder_2", nil, 0.9)
	end)
end

function Chapter2.Stop()
	k.active = false
	reset()
	CreatureService.SetDifficulty({})
end

function Chapter2.Init(context)
	k.ctx = context
	ForecastService.Breakable("c2_override")
	ForecastService.Breakable("c2_valve")

	-- the dam keeper's log starts the personal forecast
	InteractionService.Register("lore", function(_player, object)
		if k.active and state.stage == "crew" and object:GetAttribute("LogId") == "c2_keeper_log" then
			k.step("Log")
			k.objective(nil)
			k.relay("RADIO_C2_LOG", nil, 4)
			k.after(9, personalForecast)
		end
	end)

	InteractionService.Register("generator", function(_player, generator)
		if not k.active or state.stage ~= "turbines" then
			return
		end
		local id = generator:GetAttribute("GeneratorId") or generator
		if state.turbines[id] then
			return
		end
		state.turbines[id] = true
		k.sfx("relay_activate", (generator :: BasePart).Position)
		NoiseService.Emit((generator :: BasePart).Position, 50, nil)
		local count = 0
		for _ in state.turbines do
			count += 1
		end
		k.rewardAll(Config.Rewards.Fuse)
		k.objective("OBJ_C2_TURBINES", { count = count, total = 2 })
		if count == 1 then
			k.after(3, floodForecast)
		elseif count >= 2 then
			state.stage = "crest"
			k.step("Power")
			k.ctx.setCheckpoint("C2_POWER")
			k.rewardAll(Config.Rewards.Relay)
			k.relay(if state.flooded then "RADIO_C2_CREST_RAMP" else "RADIO_C2_CREST", nil, 2)
			k.objective(if state.flooded then "OBJ_C2_CREST_RAMP" else "OBJ_C2_CREST")
		end
	end)

	InteractionService.Register("c2_spillway", function(_player, wheel)
		if not k.active or state.stage ~= "spillway" then
			return
		end
		k.sfx("relay_activate", (wheel :: BasePart).Position)
		k.relay("RADIO_C2_SPILLWAY_DONE", nil, 1)
		startYard()
	end)

	InteractionService.Register("c2_uplink", function(_player, cabinet)
		if not k.active or state.stage ~= "yard" then
			return
		end
		state.stage = "uplink"
		state.uplink = 0
		k.sfx("relay_activate", (cabinet :: BasePart).Position)
		k.relay("RADIO_C2_UPLINK", nil, 1)
		k.objective("OBJ_C2_UPLINK_HOLD", { percent = 0 })
		local center = (cabinet :: BasePart).Position
		k.every(1, function()
			return state.stage == "uplink"
		end, function()
			local here = k.near(center, UPLINK_RADIUS)
			if here == 0 then
				return
			end
			state.uplink += 1
			if state.uplink % 6 == 0 then
				NoiseService.Emit(center, 90, nil)
				CreatureService.Alert(center)
			end
			k.objective("OBJ_C2_UPLINK_HOLD", { percent = math.min(100, math.floor(state.uplink / k.scaled("HoldTime", UPLINK_SECONDS) * 100)) })
			if state.uplink >= k.scaled("HoldTime", UPLINK_SECONDS) then
				finishChapter()
			end
		end)
	end)

	Players.PlayerRemoving:Connect(function() end)
end

function Chapter2.OnPlayerEntered(player: Player, firstTime: boolean)
	if not firstTime or not k.active or state.stage ~= "arrival" then
		return
	end
	k.step("Arrival")
	StoryService.Sequence(player, {
		{ delay = 1.5, text = "SFX_STORM", channel = "world", duration = 3 },
		{ delay = 1.5, speaker = "SPEAKER_RELAY", text = "RADIO_C2_001", channel = "radio", duration = 5 },
		{ delay = 5.5, speaker = "SPEAKER_RELAY", text = "RADIO_C2_002", channel = "radio", duration = 5 },
	})
	k.after(12, function()
		if player.Parent then
			LoreService.Unlock(player, "rec_c2_arrival", true)
		end
	end)
	k.after(13, function()
		if state.stage == "arrival" and StoryService.GetObjective() == nil then
			k.objective("OBJ_C2_CREW")
		end
	end)
end

return Chapter2
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Chapter3</string>
            <string name="Source"><![CDATA[-- Chapter 3 "The Protocol" in the chapel and the archive bunker beneath the hill.
-- The night of 2009 is rebuilt from tapes (listening + ordering, no codes), and the big
-- twist: the Relay is your own team from an earlier run.
--
--  1  Forest path -> chapel (zone) -> search the altar -> hidden passage to the archive
--  2  FORECAST (power): "the archive goes dark" (breaker in the corridor)
--  3  Tape puzzle: five recorders, each holds one fragment of 02:14 (random per run).
--     Listening takes the tape along; the master deck only accepts them in time order.
--     A wrong tape resets the deck - loudly. FORECAST (door) after two tapes: the archive
--     gate (winch).
--  4  The sealed operator room opens: a radio painted like YOUR radio, a plaque with your
--     names and "RUN 0007", the Relay's own recorder.
--  5  DECISION c3_recorder: take the recorder along or destroy it (chapter 4 reacts)
--  6  The Listener hunts. Ring the bell in the tower -> end.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Catalog = require(Shared.Catalog)
local Net = require(Shared.Net)

local Services = script.Parent.Parent.Services
local StoryService = require(Services.StoryService)
local InteractionService = require(Services.InteractionService)
local CreatureService = require(Services.CreatureService)
local NoiseService = require(Services.NoiseService)
local DecisionService = require(Services.DecisionService)
local ForecastService = require(Services.ForecastService)
local DirectorService = require(Services.DirectorService)
local DoorService = require(Services.DoorService)
local PowerService = require(Services.PowerService)
local LoreService = require(Services.LoreService)
local DataService = require(Services.DataService)
local AchievementService = require(Services.AchievementService)
local HorrorEvents = require(script.Parent.Parent.Director.HorrorEvents)
local ChapterKit = require(script.Parent.ChapterKit)

local Chapter3 = {}
Chapter3.StartCheckpoint = "C3_START"

local k = ChapterKit.new("Chapter3", "ch3")
local TAPES = 5

local ORDER = { "arrival", "chapel", "archive", "tapes", "reveal", "recorder", "escape", "done" }
local state = {
	stage = "arrival",
	slotToFragment = {} :: { [number]: number },
	accepted = 0,
	gateForecastDone = false,
	recorderPlayed = false,
}

local HINTS = {
	OBJ_C3_CHAPEL = "HINT_C3_CHAPEL",
	OBJ_C3_ALTAR = "HINT_C3_ALTAR",
	OBJ_C3_ARCHIVE = "HINT_C3_ARCHIVE",
	OBJ_C3_TAPES = "HINT_C3_TAPES",
	OBJ_C3_OPERATOR = "HINT_C3_OPERATOR",
	OBJ_C3_BELL = "HINT_C3_BELL",
}

local function after(stage: string): boolean
	return (table.find(ORDER, state.stage) or 0) >= (table.find(ORDER, stage) or 0)
end

local function clearTapes()
	for _, player in Players:GetPlayers() do
		player:SetAttribute("FZ_Tape", nil)
	end
end

local function deckLamp(on: boolean)
	local lamp = k.find("FZ_Interactable", function(i)
		return i:GetAttribute("InteractId") == "c3_deck"
	end)
	local parent = lamp and lamp.Parent
	if parent then
		for _, child in parent:GetChildren() do
			if child:IsA("BasePart") and child:GetAttribute("DeckLamp") then
				child.Color = if on then Color3.fromRGB(90, 220, 140) else Color3.fromRGB(200, 40, 30)
			end
		end
	end
end

-- The twist props: the radio takes the colour of a player's equipped radio skin, the plaque
-- lists the team's display names.
local function stageTwist()
	local names = {}
	local radioColor = Catalog.DefaultRadioColor
	for _, player in k.players() do
		table.insert(names, player.DisplayName)
		local profile = DataService.Get(player)
		local skin = profile and profile.Data.equipped and profile.Data.equipped.radioSkin
		local item = skin and Catalog.Items[skin]
		if item and item.color then
			radioColor = item.color
		end
	end
	local radio = k.find("FZ_Interactable", function(i)
		return i:GetAttribute("InteractId") == "c3_relay_recorder"
	end)
	local props = radio and radio.Parent
	if props then
		for _, child in props:GetChildren() do
			if child:IsA("BasePart") and child:GetAttribute("TwistRadio") then
				child.Color = radioColor
			end
			if child:IsA("BasePart") and child.Name == "TwistPlaque" then
				local label = child:FindFirstChild("TwistPlaqueText", true)
				if label and label:IsA("TextLabel") then
					label.Text = "DURCHLAUF 0007\n" .. table.concat(names, "  ·  ")
				end
			end
		end
	end
end

local function resetTwist()
	local radio = k.find("FZ_Interactable", function(i)
		return i:GetAttribute("InteractId") == "c3_relay_recorder"
	end)
	local props = radio and radio.Parent
	if props then
		for _, child in props:GetChildren() do
			if child:IsA("BasePart") and child:GetAttribute("TwistRadio") then
				child.Color = Color3.fromRGB(40, 42, 44)
			end
			if child:IsA("BasePart") and child.Name == "TwistPlaque" then
				local label = child:FindFirstChild("TwistPlaqueText", true)
				if label and label:IsA("TextLabel") then
					label.Text = "DURCHLAUF 0007"
				end
			end
		end
	end
end

---------------------------------------------------------------------------
-- Stages
---------------------------------------------------------------------------
local function powerForecast()
	ForecastService.Start({
		id = "c3_archive_dark",
		kind = "power",
		text = "RADIO_C3_FORECAST_POWER",
		hud = "FORECAST_ARCHIVE_DARK",
		seconds = 30,
		breakWith = "c3_breaker",
		onKept = function()
			PowerService.Set("ARCHIVE", false)
			k.world("SFX_POWER_DOWN")
			local breaker = k.interactable("c3_breaker")
			if breaker then
				CreatureService.Alert(breaker.Position)
			end
		end,
		onBroken = function() end,
		keptLine = "RADIO_C1_FORECAST_KEPT",
		brokenLine = "RADIO_C3_FORECAST_POWER_BROKEN",
	})
end

local function gateForecast()
	state.gateForecastDone = true
	ForecastService.Start({
		id = "c3_archive_gate",
		kind = "door",
		text = "RADIO_C3_FORECAST_GATE",
		hud = "FORECAST_ARCHIVE_GATE",
		seconds = 35,
		breakWith = "c3_winch",
		onKept = function()
			local gate = k.door("ArchiveGate")
			k.lock(gate)
			k.world("SFX_GATE_DOWN")
			if gate then
				CreatureService.Alert(gate.Position)
			end
			k.after(40, function()
				if gate then
					DoorService.SetLocked(gate, false)
				end
			end)
		end,
		onBroken = function() end,
		keptLine = "RADIO_C3_FORECAST_GATE_KEPT",
		brokenLine = "RADIO_C3_FORECAST_GATE_BROKEN",
	})
end

local function startTapes()
	state.stage = "tapes"
	k.step("Tapes")
	k.objective("OBJ_C3_TAPES", { count = 0, total = TAPES })
	k.relay("RADIO_C3_TAPES", nil, 2)
	deckLamp(false)
end

local function reveal()
	state.stage = "reveal"
	k.step("Reveal")
	ForecastService.Cancel()
	clearTapes()
	deckLamp(true)
	stageTwist()
	k.unlock(k.door("Sealed"), true)
	k.rewardAll(Config.Rewards.Relay)
	k.ctx.setCheckpoint("C3_OPERATOR")
	k.sequence({
		{ delay = 1, text = "SFX_SEAL", channel = "world", duration = 3 },
		{ delay = 3, speaker = "SPEAKER_RELAY", text = "RADIO_C3_OPEN", channel = "radio", duration = 5 },
	})
	k.objective("OBJ_C3_OPERATOR")
end

local function askRecorder()
	DecisionService.Ask({
		id = "c3_recorder",
		prompt = "DECISION_C3_RECORDER",
		options = { "DECISION_TAKE_RECORDER", "DECISION_DESTROY_RECORDER" },
		seconds = 25,
		default = 1,
		onDecided = function(index)
			if not k.active then
				return
			end
			local recorder = k.interactable("c3_relay_recorder")
			if index == 1 then
				k.relay("RADIO_C3_TAKEN", nil, 1)
			else
				if recorder then
					k.sfx("creature_static_burst", recorder.Position)
				end
				k.relay("RADIO_C3_DESTROYED", nil, 2)
			end
			state.stage = "escape"
			CreatureService.SetDifficulty({ speed = 1.12, hearing = 1.3 })
			if recorder then
				CreatureService.Alert(recorder.Position)
			end
			k.after(5, function()
				k.unknown("RADIO_C3_ESCAPE", nil, 0)
				k.objective("OBJ_C3_BELL")
			end)
		end,
	}, k.players)
end

---------------------------------------------------------------------------
-- Scares
---------------------------------------------------------------------------
local function beats()
	return {
		{ id = "c3_footsteps", kind = "footsteps", condition = function(_p, info)
			return info.alone and after("chapel")
		end },
		{ id = "c3_flicker", kind = "flicker", condition = function(_p, info)
			return info.area ~= nil and after("archive")
		end },
		{ id = "c3_pews", kind = "apparition", once = true, weight = 20, condition = function(_p, info)
			return info.area == "NAVE" and after("chapel")
		end },
		{ id = "c3_cemetery", kind = "apparition", once = true, weight = 10, condition = function(_p, info)
			return info.area == "CEMETERY" and after("escape")
		end },
		{ id = "c3_name", kind = "namecall", once = true, weight = 20, condition = function(_p, info)
			return info.alone and after("tapes")
		end, data = function(player)
			return { name = player.DisplayName, answered = false }
		end },
		{ id = "c3_voices", kind = "voices", once = true, weight = 10, condition = function(_p, info)
			return info.area == "ARCHIVE" or info.area == "TAPES"
		end },
	}
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------
local function reset()
	k.reset()
	state.stage = "arrival"
	state.accepted = 0
	state.gateForecastDone = false
	state.recorderPlayed = false
	-- random fragment per recorder slot
	local fragments = { 1, 2, 3, 4, 5 }
	for i = #fragments, 2, -1 do
		local j = math.random(1, i)
		fragments[i], fragments[j] = fragments[j], fragments[i]
	end
	for slot = 1, TAPES do
		state.slotToFragment[slot] = fragments[slot]
	end
	clearTapes()
	resetTwist()
	ForecastService.Cancel()
	DecisionService.Cancel()
	DirectorService.Stop()
	StoryService.ResetFlags()
	StoryService.SetObjective(nil)
	k.setState("Weather", nil)
end

function Chapter3.Begin()
	reset()
	k.active = true
	k.setState("Weather", "fog")
	DirectorService.Configure(HorrorEvents.With(beats()), HINTS, k.players)
	k.zones({
		{ id = "chapel", center = Vector3.new(0, 0, 10), radius = 26, when = function()
			return state.stage == "arrival"
		end, fn = function()
			state.stage = "chapel"
			k.step("Chapel")
			k.ctx.setCheckpoint("C3_CHAPEL")
			k.unknown("RADIO_C3_WHISPER", nil, 1)
			k.objective("OBJ_C3_ALTAR")
		end },
		{ id = "archive", center = Vector3.new(48, 0, -20), radius = 10, when = function()
			return state.stage == "archive"
		end, fn = function()
			k.ctx.setCheckpoint("C3_ARCHIVE")
			k.relay("RADIO_C3_ARCHIVE", nil, 0.5)
			k.after(6, powerForecast)
			k.after(8, startTapes)
		end },
		{ id = "operator", center = Vector3.new(85, 0, -75), radius = 12, when = function()
			return state.stage == "reveal"
		end, fn = function()
			state.stage = "recorder"
			k.objective("OBJ_C3_RECORDER")
			k.relay("RADIO_C3_OPERATOR", nil, 2)
		end },
	})
	k.every(30, function()
		return state.stage == "escape"
	end, k.huntPulse)
	-- the bell tolls once when the team arrives (the first sound of the chapter)
	k.after(4, function()
		local bell = k.interactable("c3_bell")
		if bell then
			k.sfx("bell_toll", bell.Position + Vector3.new(0, 34, 0), 1)
		end
	end)
end

function Chapter3.Stop()
	k.active = false
	reset()
	CreatureService.SetDifficulty({})
end

function Chapter3.Init(context)
	k.ctx = context
	ForecastService.Breakable("c3_breaker")
	ForecastService.Breakable("c3_winch")

	InteractionService.Register("c3_altar", function(_player, altar)
		if not k.active or state.stage ~= "chapel" then
			return
		end
		state.stage = "archive"
		k.step("Altar")
		k.sfx("door_open", (altar :: BasePart).Position)
		k.unlock(k.door("Hidden"), true)
		k.world("SFX_PASSAGE")
		k.objective("OBJ_C3_ARCHIVE")
		k.after(20, function()
			if CreatureService.Count() == 0 then
				CreatureService.Spawn()
				k.relay("RADIO_C3_WAKE", nil, 0)
			end
		end)
	end)

	InteractionService.Register("c3_tape", function(player, recorder)
		if not k.active or state.stage ~= "tapes" then
			return
		end
		local slot = tonumber(recorder:GetAttribute("TapeSlot"))
		local fragment = slot and state.slotToFragment[slot]
		if not fragment then
			return
		end
		k.sfx("tape_play", (recorder :: BasePart).Position)
		NoiseService.Emit((recorder :: BasePart).Position, 18, player)
		StoryService.Sequence("all", {
			{ delay = 1.2, speaker = "SPEAKER_TAPE", text = "TAPE_FRAGMENT_" .. fragment, channel = "radio", duration = 6, critical = true },
		})
		player:SetAttribute("FZ_Tape", fragment)
		Net.Event("Notify"):FireClient(player, "TAPE_TAKEN", { slot = slot })
	end)

	InteractionService.Register("c3_deck", function(player, deck)
		if not k.active or state.stage ~= "tapes" then
			return
		end
		local tape = player:GetAttribute("FZ_Tape")
		if type(tape) ~= "number" then
			Net.Event("Notify"):FireClient(player, "TAPE_NONE")
			return
		end
		player:SetAttribute("FZ_Tape", nil)
		if tape == state.accepted + 1 then
			state.accepted += 1
			k.sfx("relay_activate", (deck :: BasePart).Position)
			k.objective("OBJ_C3_TAPES", { count = state.accepted, total = TAPES })
			if state.accepted == 2 and not state.gateForecastDone and not ForecastService.IsActive() then
				k.after(4, gateForecast)
			end
			if state.accepted >= TAPES then
				reveal()
			end
		else
			-- wrong order: the deck chews the tape, everyone (and everything) hears it
			state.accepted = 0
			k.sfx("creature_static_burst", (deck :: BasePart).Position, 1)
			NoiseService.Emit((deck :: BasePart).Position, 70, nil)
			CreatureService.Alert((deck :: BasePart).Position)
			k.relay("RADIO_C3_TAPE_WRONG", nil, 0.5)
			k.objective("OBJ_C3_TAPES", { count = 0, total = TAPES })
		end
	end)

	InteractionService.Register("c3_relay_recorder", function(_player, recorder)
		if not k.active or state.stage ~= "recorder" or state.recorderPlayed then
			return
		end
		state.recorderPlayed = true
		k.step("Recorder")
		k.objective(nil)
		k.sfx("tape_play", (recorder :: BasePart).Position)
		LoreService.UnlockAll(k.players(), "rec_c3_run0007")
		k.sequence({
			{ delay = 1.5, speaker = "SPEAKER_RELAY", text = "RADIO_C3_REC_1", channel = "radio", duration = 5, critical = true },
			{ delay = 5.5, speaker = "SPEAKER_RELAY", text = "RADIO_C3_REC_2", channel = "radio", duration = 5, critical = true },
			{ delay = 5.5, speaker = "SPEAKER_RELAY", text = "RADIO_C3_REC_3", channel = "radio", duration = 6, critical = true },
			{ delay = 6.5, speaker = "SPEAKER_RELAY", text = "RADIO_C3_REC_4", channel = "radio", duration = 5, critical = true },
		})
		for _, player in k.players() do
			AchievementService.Award(player, "run_0007")
		end
		k.after(24, askRecorder)
	end)

	InteractionService.Register("c3_bell", function(_player, rope)
		if not k.active or state.stage ~= "escape" then
			return
		end
		state.stage = "done"
		k.step("Bell")
		ForecastService.Cancel()
		CreatureService.SetAIEnabled(false)
		k.objective(nil)
		for i = 0, 2 do
			task.delay(i * 2.5, function()
				k.sfx("bell_toll", (rope :: BasePart).Position + Vector3.new(0, 34, 0), 1)
			end)
		end
		k.sequence({
			{ delay = 2, text = "SFX_BELL", channel = "world", duration = 4 },
			{ delay = 6, speaker = "SPEAKER_RELAY", text = "RADIO_C3_END_RELAY", channel = "radio", duration = 5 },
			{ delay = 5.5, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C3_END_UNKNOWN", channel = "radio", duration = 5, critical = true },
		})
		k.after(18, function()
			k.complete("ch3_complete")
		end)
		k.after(21, function()
			k.ctx.finish()
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		player:SetAttribute("FZ_Tape", nil)
	end)
end

function Chapter3.OnPlayerEntered(player: Player, firstTime: boolean)
	if not firstTime or not k.active or state.stage ~= "arrival" then
		return
	end
	k.step("Arrival")
	StoryService.Sequence(player, {
		{ delay = 2, speaker = "SPEAKER_RELAY", text = "RADIO_C3_001", channel = "radio", duration = 5 },
		{ delay = 5.5, speaker = "SPEAKER_RELAY", text = "RADIO_C3_002", channel = "radio", duration = 4.5 },
	})
	k.after(12, function()
		if state.stage == "arrival" and StoryService.GetObjective() == nil then
			k.objective("OBJ_C3_CHAPEL")
		end
	end)
end

return Chapter3
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Chapter4</string>
            <string name="Source"><![CDATA[-- Chapter 4 "Frequency Zero" in the mine above the Echo-Array.
-- The station breaks into time layers: every Array pulse switches between today and the
-- night of 2009 (parts tagged FZ_Layer). All mechanics combine: break forecasts to keep a
-- way open, avoid the Listener, reach the core together - and decide how it ends.
--
--  1  Mine yard -> winding house lever opens the gate
--  2  Pulses start (today <-> 2009). The old passage north is buried today, open in 2009.
--     FORECAST (machine): the cage falls (brake lever). Kept -> the loop route jams.
--     FORECAST (water): the lower level floods (pump). Kept -> the pump room goes dark.
--  3  Transformer room. FORECAST (power): the transformer burns through (breaker).
--  4  Blast door. FORECAST (door): it seals for good (override). Kept -> it only opens in
--     the 2009 layer - wait for the next pulse.
--  5  The core: everyone together. DECISION c4_ending:
--       Answer (the loop closes on you) | Silence (it is just morning) |
--       Counter-frequency (secret: all six ghost logs + every forecast kind broken once)

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Services = script.Parent.Parent.Services
local StoryService = require(Services.StoryService)
local InteractionService = require(Services.InteractionService)
local CreatureService = require(Services.CreatureService)
local DecisionService = require(Services.DecisionService)
local ForecastService = require(Services.ForecastService)
local DirectorService = require(Services.DirectorService)
local PowerService = require(Services.PowerService)
local LoreService = require(Services.LoreService)
local DataService = require(Services.DataService)
local AchievementService = require(Services.AchievementService)
local BadgeTracker = require(Services.BadgeTracker)
local HorrorEvents = require(script.Parent.Parent.Director.HorrorEvents)
local ChapterKit = require(script.Parent.ChapterKit)
local MapKit = require(script.Parent.Parent.Map.MapKit)

local Chapter4 = {}
Chapter4.StartCheckpoint = "C4_START"

local k = ChapterKit.new("Chapter4", "ch4")

local GHOST_LOGS = { "log_okafor", "log_venn", "log_ehle", "log_0006", "log_kessler", "log_marek" }
local FORECAST_KINDS = { "power", "machine", "water", "door" }
local LAYER_NOW, LAYER_2009 = 32, 18 -- seconds per layer

local ORDER = { "arrival", "inside", "transformer", "blast", "core", "ending", "done" }
local state = {
	stage = "arrival",
	layer = "now",
	blastSealed = false,
	cageForecast = false,
}

local HINTS = {
	OBJ_C4_GATE = "HINT_C4_GATE",
	OBJ_C4_TRANSFORMER = "HINT_C4_TRANSFORMER",
	OBJ_C4_BLAST = "HINT_C4_BLAST",
	OBJ_C4_BLAST_WAIT = "HINT_C4_BLAST_WAIT",
	OBJ_C4_GATHER = "HINT_C4_GATHER",
}

local function after(stage: string): boolean
	return (table.find(ORDER, state.stage) or 0) >= (table.find(ORDER, stage) or 0)
end

---------------------------------------------------------------------------
-- Time layers
---------------------------------------------------------------------------
local function setLayer(layer: string)
	state.layer = layer
	k.setState("TimeLayer", layer)
	for _, part in CollectionService:GetTagged("FZ_Layer") do
		if part:IsA("BasePart") then
			local visible = part:GetAttribute("Layer") == layer
			local base = part:GetAttribute("BaseTransparency")
			part.Transparency = if visible then (if type(base) == "number" then base else 0) else 1
			part.CanCollide = visible and part:GetAttribute("BaseCollide") ~= false
			part.CanQuery = visible
			for _, child in part:GetChildren() do
				if child:IsA("Light") then
					child.Enabled = visible
				end
			end
		end
	end
end

-- Nobody gets buried when today's rubble comes back: move them out of the rubble volume.
local function clearRubbleZone()
	for _, player in k.players() do
		local root = k.rootOf(player)
		if root and math.abs(root.Position.X) < 6 and root.Position.Z < -172 and root.Position.Z > -194 then
			local character = player.Character
			if character then
				character:PivotTo(CFrame.new(0, 3, -168))
			end
		end
	end
end

local function pulse()
	Net.Event("Sfx"):FireAllClients("array_pulse", nil, 0.9)
	if state.layer == "now" then
		setLayer("2009")
		if state.blastSealed then
			-- in 2009 the blast door stood open
			k.unlock(k.door("BlastDoor"), true)
			state.blastSealed = false
			k.relay("RADIO_C4_BLAST_2009", nil, 1)
			k.objective("OBJ_C4_GATHER")
			state.stage = "core"
		end
	else
		clearRubbleZone()
		setLayer("now")
	end
end

local function startPulses()
	local current = k.token
	task.spawn(function()
		while k.active and k.token == current and not after("ending") do
			task.wait(if state.layer == "now" then LAYER_NOW - 5 else LAYER_2009 - 5)
			if not (k.active and k.token == current) or after("ending") then
				return
			end
			if state.layer == "2009" then
				k.world("SFX_PULSE_WARN", 0, 4)
			end
			task.wait(5)
			if k.active and k.token == current and not after("ending") then
				pulse()
			end
		end
	end)
end

---------------------------------------------------------------------------
-- Forecasts
---------------------------------------------------------------------------
local function waterForecast()
	ForecastService.Start({
		id = "c4_flood",
		kind = "water",
		text = "RADIO_C4_FORECAST_FLOOD",
		hud = "FORECAST_MINE_FLOOD",
		seconds = 35,
		breakWith = "c4_pump",
		onKept = function()
			k.setFlood(true)
			PowerService.Set("PUMP", false)
			k.world("SFX_FLOOD")
			local door = k.door("PumpDoor")
			if door then
				k.lock(door)
			end
		end,
		onBroken = function() end,
		keptLine = "RADIO_C4_FORECAST_FLOOD_KEPT",
		brokenLine = "RADIO_C4_FORECAST_FLOOD_BROKEN",
	})
end

local function cageForecast()
	state.cageForecast = true
	ForecastService.Start({
		id = "c4_cage",
		kind = "machine",
		text = "RADIO_C4_FORECAST_CAGE",
		hud = "FORECAST_CAGE",
		seconds = 30,
		breakWith = "c4_brake",
		onKept = function()
			local cage = k.find("FZ_Interactable", function(i)
				return i:GetAttribute("InteractId") == "c4_brake"
			end)
			local position = if cage then cage.Position else Vector3.new(-74, 3, -122)
			k.sfx("metal_crash", position, 1)
			k.world("SFX_CAGE_CRASH")
			k.lock(k.door("LoopDoor")) -- the crash jams the loop route
			if CreatureService.Count() == 0 then
				CreatureService.Spawn()
			end
			CreatureService.Alert(position)
			k.after(20, waterForecast)
		end,
		onBroken = function()
			k.after(20, waterForecast)
		end,
		keptLine = "RADIO_C4_FORECAST_CAGE_KEPT",
		brokenLine = "RADIO_C4_FORECAST_CAGE_BROKEN",
	})
end

local function blastForecast()
	state.stage = "blast"
	k.objective("OBJ_C4_BLAST")
	ForecastService.Start({
		id = "c4_blast",
		kind = "door",
		text = "RADIO_C4_FORECAST_DOOR",
		hud = "FORECAST_BLAST",
		seconds = 40,
		breakWith = "c4_override",
		onKept = function()
			state.blastSealed = true
			k.world("SFX_SEAL")
			k.objective("OBJ_C4_BLAST_WAIT")
		end,
		onBroken = function()
			k.unlock(k.door("BlastDoor"), true)
			state.stage = "core"
			k.objective("OBJ_C4_GATHER")
		end,
		keptLine = "RADIO_C4_FORECAST_DOOR_KEPT",
		brokenLine = "RADIO_C4_FORECAST_DOOR_BROKEN",
	})
end

local function powerForecast()
	ForecastService.Start({
		id = "c4_transformer",
		kind = "power",
		text = "RADIO_C4_FORECAST_POWER",
		hud = "FORECAST_TRANSFORMER",
		seconds = 30,
		breakWith = "c4_breaker",
		onKept = function()
			PowerService.Set("MINE", false)
			PowerService.Set("TRANSFORMER", false)
			k.world("SFX_POWER_DOWN")
			k.after(6, blastForecast)
		end,
		onBroken = function()
			k.after(6, blastForecast)
		end,
		keptLine = "RADIO_C1_FORECAST_KEPT",
		brokenLine = "RADIO_C4_FORECAST_POWER_BROKEN",
	})
end

---------------------------------------------------------------------------
-- Endings
---------------------------------------------------------------------------
-- The secret ending: one player of the team carries all six ghost logs and has broken
-- every kind of forecast at least once (across all chapters).
local function counterEligible(): boolean
	for _, player in k.players() do
		local profile = DataService.Get(player)
		local data = profile and profile.Data
		if data then
			local ok = true
			for _, id in GHOST_LOGS do
				if not data.secrets.logs[id] then
					ok = false
				end
			end
			for _, kind in FORECAST_KINDS do
				if not data.secrets.forecastsBroken["kind:" .. kind] then
					ok = false
				end
			end
			if ok then
				return true
			end
		end
	end
	return false
end

local function playEnding(kind: string)
	state.stage = "done"
	k.step("Ending_" .. kind)
	ForecastService.Cancel()
	CreatureService.SetAIEnabled(false)
	CreatureService.Despawn()
	k.objective(nil)
	k.setState("Ending", kind)
	local name = k.randomName()
	if kind == "answer" then
		PowerService.Set("ARRAY", true)
		k.sequence({
			{ delay = 1, speaker = "SPEAKER_RELAY", text = "RADIO_C4_ANSWER_1", channel = "radio", duration = 5, critical = true },
			{ delay = 5.5, text = "SFX_STATIC", channel = "sfx", duration = 2 },
			{ delay = 2.5, speaker = "SPEAKER_RELAY", text = "RADIO_C4_ANSWER_2", params = { name = name }, channel = "radio", duration = 6, critical = true },
			{ delay = 7, text = "SFX_FAX", channel = "world", duration = 3 },
		})
		k.after(18, function()
			for _, player in k.players() do
				StoryService.ShowDocument(player, { title = "FAX_TITLE", body = "FAX_BODY_NEXT", date = os.time() + 24 * 60 * 60 })
			end
		end)
	elseif kind == "silence" then
		PowerService.Set("ARRAY", false)
		MapKit.ApplyLighting("dawn")
		k.sequence({
			{ delay = 1.5, speaker = "SPEAKER_RELAY", text = "RADIO_C4_SILENCE_1", channel = "radio", duration = 4, critical = true },
			{ delay = 4.5, speaker = "SPEAKER_RELAY", text = "RADIO_C4_SILENCE_2", channel = "radio", duration = 5, critical = true },
			{ delay = 6, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C4_SILENCE_3", channel = "radio", duration = 5 },
			{ delay = 6, text = "SFX_RADIOS_QUIET", channel = "world", duration = 4 },
		})
		k.after(20, function()
			for _, player in k.players() do
				StoryService.ShowDocument(player, { title = "FAX_TITLE", body = "FAX_BODY_EMPTY" })
			end
		end)
	else
		PowerService.Set("ARRAY", true)
		MapKit.ApplyLighting("day")
		k.sequence({
			{ delay = 1.5, speaker = "SPEAKER_RELAY", text = "RADIO_C4_COUNTER_1", channel = "radio", duration = 6, critical = true },
			{ delay = 7, text = "SFX_STATIC", channel = "sfx", duration = 2 },
			{ delay = 2.5, speaker = "SPEAKER_JUNE", text = "RADIO_C4_COUNTER_2", channel = "radio", duration = 5, critical = true },
			{ delay = 6, speaker = "SPEAKER_JUNE", text = "RADIO_C4_COUNTER_3", channel = "radio", duration = 6, critical = true },
		})
	end
	k.after(26, function()
		k.complete("ch4_complete", function(player)
			AchievementService.Award(player, "ending_" .. kind)
			if kind == "counter" then
				BadgeTracker.Award(player, "ending_counter")
			end
		end)
	end)
	k.after(30, function()
		k.ctx.finish()
	end)
end

local function askEnding()
	state.stage = "ending"
	k.step("Core")
	local options = { "DECISION_END_ANSWER", "DECISION_END_SILENCE" }
	local secret = counterEligible()
	if secret then
		table.insert(options, "DECISION_END_COUNTER")
	end
	k.sequence({
		{ delay = 0.5, speaker = "SPEAKER_RELAY", text = "RADIO_C4_CORE", channel = "radio", duration = 5, critical = true },
		{ delay = 5.5, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C4_CORE_UNKNOWN", channel = "radio", duration = 5, critical = true },
		{ delay = 5.5, speaker = if secret then "SPEAKER_RELAY" else nil, text = if secret then "RADIO_C4_CORE_SECRET" else "SFX_STATIC", channel = if secret then "radio" else "sfx", duration = 5 },
	})
	k.after(16, function()
		DecisionService.Ask({
			id = "c4_ending",
			prompt = "DECISION_C4_ENDING",
			options = options,
			seconds = 40,
			default = 2,
			onDecided = function(index)
				if k.active then
					playEnding(if index == 1 then "answer" elseif index == 2 then "silence" else "counter")
				end
			end,
		}, k.players)
	end)
end

---------------------------------------------------------------------------
-- Scares
---------------------------------------------------------------------------
local function beats()
	return {
		{ id = "c4_footsteps", kind = "footsteps", condition = function(_p, info)
			return info.alone and after("inside")
		end },
		{ id = "c4_flicker", kind = "flicker", condition = function(_p, info)
			return info.area ~= nil and after("inside")
		end },
		{ id = "c4_crew_2009", kind = "apparition", weight = 20, cooldown = 90, condition = function(_p, info)
			return state.layer == "2009" and (info.area == "PASSAGE" or info.area == "JUNCTION")
		end },
		{ id = "c4_voices", kind = "voices", once = true, weight = 15, condition = function(_p, info)
			return state.layer == "2009"
		end },
		{ id = "c4_name", kind = "namecall", once = true, weight = 20, condition = function(_p, info)
			return info.alone and after("transformer")
		end, data = function(player)
			return { name = player.DisplayName, answered = true }
		end },
	}
end

---------------------------------------------------------------------------
-- Lifecycle
---------------------------------------------------------------------------
local function reset()
	k.reset()
	state.stage = "arrival"
	state.blastSealed = false
	state.cageForecast = false
	setLayer("now")
	k.setState("TimeLayer", nil)
	k.setState("Ending", nil)
	k.setFlood(false)
	ForecastService.Cancel()
	DecisionService.Cancel()
	DirectorService.Stop()
	StoryService.ResetFlags()
	StoryService.SetObjective(nil)
	MapKit.ApplyLighting("mine")
end

function Chapter4.Begin()
	reset()
	k.active = true
	CreatureService.SetDifficulty({ speed = 1.08, hearing = 1.25 })
	DirectorService.Configure(HorrorEvents.With(beats()), HINTS, k.players)
	k.zones({
		{ id = "junction", center = Vector3.new(0, 0, -130), radius = 18, when = function()
			return state.stage == "inside" and not state.cageForecast
		end, fn = function()
			k.ctx.setCheckpoint("C4_JUNCTION")
			k.relay("RADIO_C4_JUNCTION", nil, 0.5)
			k.after(5, cageForecast)
		end },
		{ id = "transformer", center = Vector3.new(0, 0, -240), radius = 16, when = function()
			return state.stage == "inside"
		end, fn = function()
			state.stage = "transformer"
			k.step("Transformer")
			k.ctx.setCheckpoint("C4_TRANSFORMER")
			k.rewardAll(Config.Rewards.Relay)
			if ForecastService.IsActive() then
				ForecastService.Cancel()
			end
			k.after(3, powerForecast)
		end },
	})
	k.every(35, function()
		return after("inside") and not after("ending")
	end, k.huntPulse)
end

function Chapter4.Stop()
	k.active = false
	reset()
	CreatureService.SetDifficulty({})
end

function Chapter4.Init(context)
	k.ctx = context
	ForecastService.Breakable("c4_brake")
	ForecastService.Breakable("c4_pump")
	ForecastService.Breakable("c4_breaker")
	ForecastService.Breakable("c4_override")

	InteractionService.Register("c4_winch", function(_player, lever)
		if not k.active or state.stage ~= "arrival" then
			return
		end
		state.stage = "inside"
		k.step("Gate")
		k.sfx("relay_activate", (lever :: BasePart).Position)
		k.unlock(k.door("MineGate"), true)
		k.objective("OBJ_C4_TRANSFORMER")
		k.relay("RADIO_C4_INSIDE", nil, 2)
		startPulses()
		k.after(25, function()
			if CreatureService.Count() == 0 then
				CreatureService.Spawn()
				k.relay("RADIO_C4_WAKE", nil, 0)
			end
		end)
	end)

	InteractionService.Register("c4_core", function(player, console)
		if not k.active or state.stage ~= "core" then
			return
		end
		local here, total = k.near((console :: BasePart).Position, 24)
		if here < total then
			Net.Event("Notify"):FireClient(player, "C4_NEED_TEAM", { here = here, total = total })
			return
		end
		k.ctx.setCheckpoint("C4_CORE")
		askEnding()
	end)

	Players.PlayerRemoving:Connect(function() end)
end

function Chapter4.OnPlayerEntered(player: Player, firstTime: boolean)
	if not firstTime or not k.active or state.stage ~= "arrival" then
		return
	end
	k.step("Arrival")
	local lines = {
		{ delay = 2, speaker = "SPEAKER_RELAY", text = "RADIO_C4_001", channel = "radio", duration = 5 },
		{ delay = 5.5, speaker = "SPEAKER_RELAY", text = "RADIO_C4_002", channel = "radio", duration = 5 },
	}
	-- consequences of earlier choices
	if k.choice("c3_recorder") == 1 then
		table.insert(lines, { delay = 6, speaker = "SPEAKER_RELAY", text = "RADIO_C4_RECORDER", channel = "radio", duration = 6 })
	end
	if k.choice("c2_trust") == 1 then
		table.insert(lines, { delay = 6, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C4_UNKNOWN_TRUSTED", channel = "radio", duration = 5 })
	end
	StoryService.Sequence(player, lines)
	k.after(14, function()
		if state.stage == "arrival" and StoryService.GetObjective() == nil then
			k.objective("OBJ_C4_GATE")
		end
	end)
	k.after(16, function()
		if player.Parent then
			LoreService.Unlock(player, "rec_c4_arrival", true)
		end
	end)
end

return Chapter4
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">ChapterKit</string>
            <string name="Source"><![CDATA[-- ChapterKit: shared helpers for story chapters 2-4 (chapter 1 predates it and keeps its
-- own copies). Everything here only uses the generic services - no chapter logic.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local Services = script.Parent.Parent.Services
local StoryService = require(Services.StoryService)
local DataService = require(Services.DataService)
local CreatureService = require(Services.CreatureService)
local DoorService = require(Services.DoorService)
local HealthService = require(Services.HealthService)
local AnalyticsTracker = require(Services.AnalyticsTracker)
local BadgeTracker = require(Services.BadgeTracker)
local AchievementService = require(Services.AchievementService)

local ChapterKit = {}

function ChapterKit.new(chapterName: string, chapterId: string)
	local k: any = { ctx = nil, active = false, token = 0 }
	local stepped: { [string]: boolean } = {}
	local completedBy: { [Player]: boolean } = {}

	function k.players(): { Player }
		return if k.ctx then k.ctx.playersInGame() else {}
	end

	function k.alive(): { Player }
		local list = {}
		for _, player in k.players() do
			if not player:GetAttribute("FZ_Downed") and not player:GetAttribute("FZ_Eliminated") then
				table.insert(list, player)
			end
		end
		return list
	end

	-- A base value scaled by team size (see Config.Team).
	function k.scaled(name: string, base: number): number
		return math.floor(base * Config.TeamValue(name, math.max(1, #k.players())) + 0.5)
	end

	function k.reset()
		k.token += 1
		table.clear(stepped)
		table.clear(completedBy)
	end

	-- Runs fn after `seconds` only if the chapter run that scheduled it is still active.
	function k.after(seconds: number, fn: () -> ())
		local current = k.token
		task.delay(seconds, function()
			if k.active and k.token == current then
				fn()
			end
		end)
	end

	function k.step(name: string)
		if stepped[name] then
			return
		end
		stepped[name] = true
		for _, player in k.players() do
			AnalyticsTracker.ChapterStep(player, chapterName, name)
		end
	end

	function k.rewardAll(amount: number)
		for _, player in k.players() do
			DataService.Grant(player, amount)
		end
	end

	function k.sfx(name: string, position: Vector3, volume: number?)
		Net.Event("Sfx"):FireAllClients(name, position, volume)
	end

	function k.line(speaker: string?, text: string, params: { [string]: any }?, delay: number?, duration: number?, critical: boolean?)
		StoryService.Sequence("all", {
			{ delay = delay or 0.5, speaker = speaker, text = text, params = params, channel = if speaker then "radio" else "world", duration = duration or 5, critical = critical },
		})
	end
	function k.relay(text: string, params: { [string]: any }?, delay: number?, duration: number?)
		k.line("SPEAKER_RELAY", text, params, delay, duration or 4.5)
	end
	function k.unknown(text: string, params: { [string]: any }?, delay: number?, duration: number?)
		k.line("SPEAKER_UNKNOWN", text, params, delay, duration or 5)
	end
	function k.world(text: string, delay: number?, duration: number?)
		k.line(nil, text, nil, delay, duration or 3, true)
	end
	function k.sequence(lines: { any })
		StoryService.Sequence("all", lines)
	end

	function k.objective(key: string?, params: { [string]: any }?)
		StoryService.SetObjective(key, params)
	end

	function k.randomName(): string
		local team = k.players()
		local named = team[math.random(1, math.max(1, #team))]
		return if named then named.DisplayName else ""
	end

	-- First tagged BasePart that passes the filter (e.g. a door with an attribute).
	function k.find(tagName: string, filter: (instance: Instance) -> boolean): BasePart?
		for _, instance in CollectionService:GetTagged(tagName) do
			if instance:IsA("BasePart") and filter(instance) then
				return instance
			end
		end
		return nil
	end
	function k.findAll(tagName: string, filter: (instance: Instance) -> boolean): { BasePart }
		local list = {}
		for _, instance in CollectionService:GetTagged(tagName) do
			if instance:IsA("BasePart") and filter(instance) then
				table.insert(list, instance)
			end
		end
		return list
	end
	function k.door(attribute: string): BasePart?
		return k.find("FZ_Door", function(panel)
			return panel:GetAttribute(attribute) ~= nil
		end)
	end
	function k.interactable(id: string): BasePart?
		return k.find("FZ_Interactable", function(instance)
			return instance:GetAttribute("InteractId") == id
		end)
	end
	function k.unlock(panel: BasePart?, open: boolean?)
		if panel then
			DoorService.SetLocked(panel, false)
			if open then
				DoorService.Open(panel)
			end
		end
	end
	function k.lock(panel: BasePart?)
		if panel then
			DoorService.Close(panel)
			DoorService.SetLocked(panel, true)
		end
	end

	-- Shows / hides parts tagged FZ_FloodWater (visual only, never blocks movement).
	function k.setFlood(on: boolean)
		for _, water in CollectionService:GetTagged("FZ_FloodWater") do
			if water:IsA("BasePart") then
				water.Transparency = if on then 0.35 else 1
			end
		end
	end

	function k.rootOf(player: Player): BasePart?
		local character = player.Character
		return character and character:FindFirstChild("HumanoidRootPart") :: BasePart? or nil
	end

	-- How many standing players are within `radius` of `position` (and how many stand).
	function k.near(position: Vector3, radius: number): (number, number)
		local here, total = 0, 0
		for _, player in k.alive() do
			total += 1
			local root = k.rootOf(player)
			if root and (root.Position - position).Magnitude <= radius then
				here += 1
			end
		end
		return here, total
	end

	-- The creature gets a hint where a random standing player is (active hunting).
	function k.huntPulse()
		local targets = k.alive()
		local target = targets[math.random(1, math.max(1, #targets))]
		local root = target and k.rootOf(target)
		if root then
			CreatureService.Alert(root.Position)
		end
	end

	-- A team choice from an earlier chapter: the option most players in the session saved.
	function k.choice(decisionId: string): number?
		local votes: { [number]: number } = {}
		for _, player in k.players() do
			local profile = DataService.Get(player)
			local value = profile and profile.Data.storyChoices[decisionId]
			if type(value) == "number" then
				votes[value] = (votes[value] or 0) + 1
			end
		end
		local best, bestCount = nil, 0
		for option, count in votes do
			if count > bestCount or (count == bestCount and best and option < best) then
				best, bestCount = option, count
			end
		end
		return best
	end

	-- Chapter completion for everyone in the session (once per player per run).
	function k.complete(badgeKey: string?, extra: ((player: Player) -> ())?)
		for _, player in k.players() do
			if not completedBy[player] then
				completedBy[player] = true
				DataService.Grant(player, Config.Rewards.ChapterComplete)
				DataService.Mutate(player, function(data)
					if data.progress.completedChapters[chapterId] == nil then
						data.progress.completedChapters[chapterId] = os.time()
					end
				end)
				Net.Event("Notify"):FireClient(player, "CHAPTER_COMPLETE")
				if badgeKey then
					BadgeTracker.Award(player, badgeKey)
				end
				if not CreatureService.Spotted[player] then
					AchievementService.Award(player, "unseen")
				end
				if #k.players() >= 2 and next(HealthService.SessionStats.eliminated) == nil then
					AchievementService.Award(player, "nobody_left")
				end
				if extra then
					extra(player)
				end
				DataService.SaveNow(player)
			end
		end
	end

	-- 2 Hz trigger zones: { id, center, radius, when = () -> boolean, fn = (player) -> () }.
	-- A zone fires once per run (the first standing player that enters it).
	function k.zones(list: { any })
		local current = k.token
		local fired: { [string]: boolean } = {}
		task.spawn(function()
			while k.active and k.token == current do
				task.wait(0.5)
				for _, zone in list do
					if not fired[zone.id] and (not zone.when or zone.when()) then
						for _, player in k.alive() do
							local root = k.rootOf(player)
							if root and (root.Position - zone.center).Magnitude <= zone.radius then
								fired[zone.id] = true
								task.spawn(zone.fn, player)
								break
							end
						end
					end
				end
			end
		end)
	end

	-- Calls fn every `seconds` while the run is active and `when()` holds.
	function k.every(seconds: number, when: () -> boolean, fn: () -> ())
		local current = k.token
		task.spawn(function()
			while k.active and k.token == current do
				task.wait(seconds)
				if k.active and k.token == current and when() then
					fn()
				end
			end
		end)
	end

	function k.setState(key: string, value: any)
		SessionState.Set(key, value)
	end

	Players.PlayerRemoving:Connect(function(player)
		completedBy[player] = nil
	end)

	return k
end

return ChapterKit
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="37">
        <Properties>
          <string name="Name">Creature</string>
        </Properties>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Rig</string>
            <string name="Source"><![CDATA[-- Creature rig factory.
--
-- 1. Your own monster: put a Model into ServerStorage > Creatures. Requirements:
--    Humanoid + HumanoidRootPart (PrimaryPart), anchored = false, correct HipHeight.
--    Optional animation ids in Shared/Assets.luau (CreatureAnimations).
-- 2. Otherwise the built-in placeholder "Der Lauscher" is built from parts:
--    ~8.5 studs tall, very thin, horn-speaker head, arms down to the knees.
--    It is animated procedurally on the clients (CreatureVisualsController) by
--    driving Motor6D.Transform - no animation assets needed.

local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")

local Rig = {}

local SKIN = Color3.fromRGB(58, 52, 50)
local SKIN_DARK = Color3.fromRGB(34, 30, 30)
local FABRIC = Color3.fromRGB(24, 22, 22)

local function part(model: Model, name: string, size: Vector3, color: Color3, material: Enum.Material?, collide: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = collide == true
	p.CanQuery = true
	p.CanTouch = false
	p.Massless = not collide
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function motor(name: string, part0: BasePart, part1: BasePart, c0: CFrame, c1: CFrame)
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = c0
	m.C1 = c1
	m.Parent = part0
	return m
end

function Rig.BuildPlaceholder(): Model
	local model = Instance.new("Model")
	model.Name = "Lauscher"

	local root = part(model, "HumanoidRootPart", Vector3.new(2, 2, 1), SKIN, Enum.Material.SmoothPlastic, true)
	root.Transparency = 1
	model.PrimaryPart = root

	local torso = part(model, "Torso", Vector3.new(1.3, 3.2, 0.8), SKIN, Enum.Material.Fabric, true)
	local head = part(model, "Head", Vector3.new(1.3, 1.3, 1.6), SKIN_DARK, Enum.Material.Metal)
	local horn = part(model, "Horn", Vector3.new(0.4, 2.1, 2.1), SKIN_DARK, Enum.Material.Metal)
	horn.Shape = Enum.PartType.Cylinder
	local grille = part(model, "Grille", Vector3.new(0.12, 1.9, 1.9), FABRIC, Enum.Material.Fabric)
	grille.Shape = Enum.PartType.Cylinder

	motor("RootJoint", root, torso, CFrame.new(0, -1, 0), CFrame.new(0, -1.6, 0) * CFrame.Angles(math.rad(-12), 0, 0))
	motor("Neck", torso, head, CFrame.new(0, 1.6, 0), CFrame.new(0, -0.7, 0.2))
	-- Horn faces forward (-Z). Cylinders extend along X, so rotate 90 degrees around Y.
	local hornWeld = Instance.new("Weld")
	hornWeld.Part0 = head
	hornWeld.Part1 = horn
	hornWeld.C0 = CFrame.new(0, 0, -0.9) * CFrame.Angles(0, math.rad(90), 0)
	hornWeld.Parent = head
	local grilleWeld = Instance.new("Weld")
	grilleWeld.Part0 = head
	grilleWeld.Part1 = grille
	grilleWeld.C0 = CFrame.new(0, 0, -1.12) * CFrame.Angles(0, math.rad(90), 0)
	grilleWeld.Parent = head

	for _, side in { { "Left", -1 }, { "Right", 1 } } do
		local name, s = side[1], side[2]
		local upperArm = part(model, name .. "UpperArm", Vector3.new(0.35, 3.2, 0.35), SKIN, Enum.Material.Fabric)
		local lowerArm = part(model, name .. "LowerArm", Vector3.new(0.3, 3.4, 0.3), SKIN, Enum.Material.Fabric)
		local hand = part(model, name .. "Hand", Vector3.new(0.5, 1.1, 0.25), SKIN_DARK, Enum.Material.Fabric)
		motor(name .. "Shoulder", torso, upperArm, CFrame.new(s * 0.85, 1.3, 0), CFrame.new(0, 1.6, 0))
		motor(name .. "Elbow", upperArm, lowerArm, CFrame.new(0, -1.6, 0), CFrame.new(0, 1.7, 0))
		motor(name .. "Wrist", lowerArm, hand, CFrame.new(0, -1.7, 0), CFrame.new(0, 0.55, 0))

		local upperLeg = part(model, name .. "UpperLeg", Vector3.new(0.45, 2.4, 0.45), SKIN, Enum.Material.Fabric)
		local lowerLeg = part(model, name .. "LowerLeg", Vector3.new(0.4, 2.4, 0.4), SKIN, Enum.Material.Fabric)
		motor(name .. "Hip", root, upperLeg, CFrame.new(s * 0.4, -1, 0), CFrame.new(0, 1.2, 0))
		motor(name .. "Knee", upperLeg, lowerLeg, CFrame.new(0, -1.2, 0), CFrame.new(0, 1.2, 0))
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 4.8
	humanoid.AutomaticScalingEnabled = false
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.MaxHealth = 1e6
	humanoid.Health = 1e6
	humanoid.Parent = model
	Instance.new("Animator").Parent = humanoid

	model:SetAttribute("Procedural", true)
	return model
end

-- Returns the creature model to use (your model if present, else the placeholder).
function Rig.Create(): Model
	local folder = ServerStorage:FindFirstChild("Creatures")
	if folder then
		for _, candidate in folder:GetChildren() do
			if candidate:IsA("Model") and candidate:FindFirstChildOfClass("Humanoid") and candidate:FindFirstChild("HumanoidRootPart") then
				local clone = candidate:Clone()
				clone.PrimaryPart = clone:FindFirstChild("HumanoidRootPart") :: BasePart
				for _, descendant in clone:GetDescendants() do
					if descendant:IsA("BasePart") then
						descendant.Anchored = false
					end
				end
				if clone:GetAttribute("Procedural") == nil then
					clone:SetAttribute("Procedural", false)
				end
				return clone
			end
		end
		warn("[FZ-Creature] ServerStorage.Creatures has no valid model (needs Humanoid + HumanoidRootPart); using placeholder")
	end
	return Rig.BuildPlaceholder()
end

function Rig.Tag(model: Model)
	CollectionService:AddTag(model, "FZ_CreatureRig")
end

return Rig
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="39">
        <Properties>
          <string name="Name">Director</string>
        </Properties>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">HorrorEvents</string>
            <string name="Source"><![CDATA[-- The shared pool of psychological horror events (used by every mode).
-- Each entry: kind (performed by DirectorController), weight, cooldown, chance (rarity)
-- and a condition. The director never fires while a creature is chasing nearby and never
-- uses the real chase warning sound for a trick - danger always stays recognisable.

local Services = script.Parent.Parent.Services
local DirectorService = require(Services.DirectorService)
local CreatureService = require(Services.CreatureService)

local HorrorEvents = {}

local function noCreatureNear(position: Vector3, radius: number): boolean
	local model = CreatureService.Get()
	local root = model and model:FindFirstChild("HumanoidRootPart")
	return not root or ((root :: BasePart).Position - position).Magnitude > radius
end

local function inside(info): boolean
	return info.area ~= nil
end

function HorrorEvents.Pool(): { any }
	return {
		{ id = "ev_window", kind = "window", weight = 3, cooldown = 140, condition = function(_p, info)
			return DirectorService.NearTagged("FZ_Window", info.position, 6, 32)
		end },
		{ id = "ev_occupant", kind = "occupant", weight = 2, cooldown = 160, chance = 0.6, condition = function(_p, info)
			return info.area ~= nil and info.area ~= "HALL" and info.area ~= "CONTROL"
		end },
		{ id = "ev_speaker", kind = "speaker", weight = 3, cooldown = 100, condition = function(_p, info)
			return DirectorService.NearTagged("FZ_Speaker", info.position, 4, 40)
		end },
		{ id = "ev_neighbor_light", kind = "neighborlight", weight = 3, cooldown = 110, condition = function(_p, info)
			return inside(info)
		end },
		{ id = "ev_footsteps", kind = "footsteps", weight = 4, cooldown = 70, condition = function(_p, info)
			return info.alone and inside(info)
		end },
		{ id = "ev_shadow", kind = "shadow", weight = 2, cooldown = 150, condition = function(_p, info)
			return inside(info)
		end },
		-- Acoustic deception: creature sounds behind a wall although nothing is there.
		{ id = "ev_phantom", kind = "phantom", weight = 4, cooldown = 80, condition = function(_p, info)
			return inside(info) and noCreatureNear(info.position, 55)
		end },
		{ id = "ev_approach", kind = "approach", weight = 2, cooldown = 200, chance = 0.7, condition = function(_p, info)
			return info.area == "HALL" and noCreatureNear(info.position, 70)
		end },
		{ id = "ev_voices", kind = "voices", weight = 2, cooldown = 180, condition = function(_p, info)
			return inside(info) and info.alone
		end },
		-- Very rare: an object only YOU can see (another radio in your own colours...)
		{ id = "ev_object", kind = "object", weight = 1, cooldown = 600, chance = 0.35, condition = function(_p, info)
			return inside(info)
		end },
	}
end

-- Story beats first, then the pool (story beats keep their own conditions).
function HorrorEvents.With(storyBeats: { any }): { any }
	local list = table.clone(storyBeats)
	for _, beat in HorrorEvents.Pool() do
		table.insert(list, beat)
	end
	return list
end

return HorrorEvents
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="41">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- SILENT RELAY - server bootstrap.
-- Order matters: remotes and shared state first, then data, then gameplay services.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
require(Shared.Net).Init()
require(Shared.SessionState).Init()

local SERVICES = {
	"DataService",
	"MapService",
	"SettingsService",
	"AdminService",
	"CodeService",
	"InteractionService",
	"NoiseService",
	"DoorService",
	"PowerService",
	"HealthService",
	"InventoryService",
	"LoreService",
	"EvidenceService",
	"SecretService",
	"CommunityService",
	"ReferralService",
	"VoiceService",
	"ShopService",
	"CreatureService",
	"FlashlightService",
	"MovementGuardService",
	"LeaderboardService",
	"DecisionService",
	"DirectorService",
	"PlaceService",
	"PartyService",
	"SessionService",
}

for _, name in SERVICES do
	local module = script.Parent.Services:FindFirstChild(name)
	local ok, err = pcall(function()
		local service = require(module)
		if name == "PowerService" then
			service.Start(require(script.Parent.Services.DoorService))
		else
			service.Start()
		end
	end)
	if not ok then
		warn(string.format("[FZ] %s failed to start: %s", name, tostring(err)))
	end
end

print("[FZ] Server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="42">
        <Properties>
          <string name="Name">Map</string>
        </Properties>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">Chapel</string>
            <string name="Source"><![CDATA[-- Die Kapelle - chapter 3 "The Protocol".
--
--                 ┌──────────── HÜGEL (hill) ─────────────┐
--                 │  [Operatorraum]  (sealed)              │
--   ( Apsis )     │  [   ARCHIV    ][Tonbandraum]          │
--   [Kirchenschiff]─[Sakristei]═══ Gang ═══┘               │
--   [Glockenturm]                                          │
--   ─ Friedhof ─ Tor ─ Waldweg (south, start)
--
-- InteractIds: c3_altar (opens the hidden passage), c3_breaker, c3_winch, c3_tape (5x,
-- TapeSlot 1-5), c3_deck (master deck), c3_relay_recorder (the twist), c3_bell (end).

local CollectionService = game:GetService("CollectionService")

local MapKit = require(script.Parent.MapKit)
local MapDress = require(script.Parent.MapDress)
local C = MapKit.C

local Map = {}

local STONE = Color3.fromRGB(132, 128, 118)
local STONE_DARK = Color3.fromRGB(92, 88, 82)
local ROOF = Color3.fromRGB(58, 52, 50)

local function build()
	local kit = MapKit.new("FZ_Chapel", "Chapel", 404)
	local block, deco = kit.block, kit.deco
	local structure = kit.folder("Structure")
	local props = kit.folder("Props")
	local outside = kit.folder("Outside")
	local stone = { color = STONE, material = Enum.Material.Cobblestone, t = 2 }

	---------------------------------------------------------------------------
	-- Nave x -18..18, z -40..40, wall height 24, stepped gables, pitched roof
	---------------------------------------------------------------------------
	local NH = 24
	kit.slab("NaveFloor", -18, -40, 18, 40, 0, 1, Color3.fromRGB(96, 90, 84), Enum.Material.Slate)
	local naveWall = { y = 0, h = NH, doorH = 12, color = STONE, material = Enum.Material.Cobblestone, t = 2 }
	kit.wallZ(40, -18, 18, { { 0, 8 } }, naveWall)
	kit.wallX(-18, -40, 40, nil, naveWall)
	kit.wallX(18, -40, 40, { { -20, 6 } }, naveWall)
	-- apse (north): half ring of wall segments
	local segments = 6
	for i = 0, segments - 1 do
		local a0, a1 = math.pi + i / segments * math.pi, math.pi + (i + 1) / segments * math.pi
		local p0 = Vector3.new(math.cos(a0) * 18, 0, -40 + math.sin(a0) * 14)
		local p1 = Vector3.new(math.cos(a1) * 18, 0, -40 + math.sin(a1) * 14)
		local mid = (p0 + p1) / 2
		block(structure, "ApseWall", Vector3.new((p1 - p0).Magnitude + 1, NH - 4, 2), CFrame.lookAt(mid + Vector3.new(0, (NH - 4) / 2, 0), mid + Vector3.new(0, (NH - 4) / 2, 0) + (p1 - p0):Cross(Vector3.yAxis)), STONE, Enum.Material.Cobblestone)
	end
	kit.slab("ApseFloor", -18, -54, 18, -40, 0, 1, Color3.fromRGB(96, 90, 84), Enum.Material.Slate)
	block(structure, "ApseRoof", Vector3.new(38, 1.4, 16), CFrame.new(0, NH - 3.3, -47), ROOF, Enum.Material.Slate)
	-- pitched roof planes
	local rise, half = 12, 19
	local angle = math.atan(rise / half)
	local planeWidth = math.sqrt(rise * rise + half * half) + 1
	for _, side in { -1, 1 } do
		block(structure, "RoofPlane", Vector3.new(planeWidth, 1.2, 84), CFrame.new(side * half / 2, NH + rise / 2, 0) * CFrame.Angles(0, 0, -side * angle), ROOF, Enum.Material.Slate)
	end
	-- stepped gables (north + south)
	for _, z in { -40, 40 } do
		for step = 0, 5 do
			local w = 36 - step * 6
			block(structure, "Gable", Vector3.new(w, 2.2, 2), CFrame.new(0, NH + 1.1 + step * 2, z), STONE, Enum.Material.Cobblestone)
		end
	end
	block(structure, "Ceiling", Vector3.new(36, 0.6, 80), CFrame.new(0, NH - 0.3, 0), Color3.fromRGB(70, 56, 44), Enum.Material.WoodPlanks)
	for z = -36, 36, 8 do
		deco(structure, "Rafter", Vector3.new(36, 1.2, 0.9), CFrame.new(0, NH - 1.2, z), C.WoodDark, Enum.Material.Wood)
	end
	-- buttresses + tall windows (dim stained glass)
	local glass = { Color3.fromRGB(110, 30, 30), Color3.fromRGB(30, 50, 110), Color3.fromRGB(120, 100, 36), Color3.fromRGB(36, 86, 58) }
	for i, z in { -30, -15, 0, 15, 30 } do
		for _, side in { -1, 1 } do
			block(structure, "Buttress", Vector3.new(3, 18, 3), CFrame.new(side * 20, 9, z + 7.5), STONE_DARK, Enum.Material.Cobblestone)
			local pane = deco(structure, "StainedGlass", Vector3.new(0.3, 9, 3.4), CFrame.new(side * 17.1, 13, z), glass[(i % #glass) + 1], Enum.Material.Neon)
			pane.Transparency = 0.62
			local glow = Instance.new("SurfaceLight")
			glow.Face = if side < 0 then Enum.NormalId.Right else Enum.NormalId.Left
			glow.Range = 10
			glow.Brightness = 0.35
			glow.Color = pane.Color
			glow.Parent = pane
			CollectionService:AddTag(pane, "FZ_DecorLight")
		end
	end
	-- pews, aisle runner, altar, candles
	for z = -22, 30, 6 do
		kit.bench(CFrame.new(-9, 0, z), 12, C.WoodDark)
		kit.bench(CFrame.new(9, 0, z), 12, C.WoodDark)
		block(props, "PewBack", Vector3.new(12, 2.2, 0.3), CFrame.new(-9, 3, z + 0.8), C.WoodDark, Enum.Material.Wood)
		block(props, "PewBack", Vector3.new(12, 2.2, 0.3), CFrame.new(9, 3, z + 0.8), C.WoodDark, Enum.Material.Wood)
	end
	deco(props, "Runner", Vector3.new(4, 0.05, 70), CFrame.new(0, 0.03, 2), Color3.fromRGB(110, 30, 30), Enum.Material.Fabric)
	block(props, "AltarStep", Vector3.new(26, 1, 12), CFrame.new(0, 0.5, -38), STONE_DARK, Enum.Material.Marble)
	local altar = block(props, "Altar", Vector3.new(10, 4, 4), CFrame.new(0, 3, -42), Color3.fromRGB(200, 196, 186), Enum.Material.Marble)
	deco(props, "AltarCloth", Vector3.new(10.4, 0.1, 4.4), CFrame.new(0, 5.05, -42), Color3.fromRGB(230, 226, 214), Enum.Material.Fabric)
	kit.interactable(altar, "c3_altar", "INTERACT_SEARCH", "OBJECT_ALTAR", { MaxDistance = 8, HoldDuration = 1.5 })
	local cross = block(props, "Cross", Vector3.new(0.6, 8, 0.6), CFrame.new(0, 14, -52), C.WoodDark, Enum.Material.Wood)
	block(props, "CrossBar", Vector3.new(4.5, 0.6, 0.6), cross.CFrame * CFrame.new(0, 1.8, 0), C.WoodDark, Enum.Material.Wood)
	for _, x in { -4, -2.5, 2.5, 4 } do
		kit.candle(Vector3.new(x, 5.1, -42), x == -4)
	end
	for _, p in { Vector3.new(-12, 1, -36), Vector3.new(12, 1, -36), Vector3.new(-16, 1, 36), Vector3.new(16, 1, 36) } do
		block(props, "Candelabrum", Vector3.new(0.5, 4, 0.5), CFrame.new(p + Vector3.new(0, 1, 0)), C.SteelDark, Enum.Material.Metal)
		kit.candle(p + Vector3.new(0, 3, 0), true)
	end
	-- chandeliers (sector NAVE: power cut by the forecast? no - candles keep it readable)
	for _, z in { -20, 0, 20 } do
		kit.bulb(Vector3.new(0, NH - 6, z), C.Candle, 30, 1.3, "NAVE", z == 0)
		deco(props, "Chain", Vector3.new(0.15, 5, 0.15), CFrame.new(0, NH - 3.4, z), C.SteelDark, Enum.Material.Metal)
		deco(props, "Chandelier", Vector3.new(4, 0.3, 4), CFrame.new(0, NH - 6.5, z), C.SteelDark, Enum.Material.Metal)
	end
	kit.document(CFrame.new(12, 3.3, 26) * CFrame.Angles(0, 0.5, 0), "c3_hymn")
	kit.patrol(Vector3.new(0, 0, 0), "NAVE")
	kit.patrol(Vector3.new(0, 0, -30), "NAVE")
	kit.vent(Vector3.new(-16.9, 1.5, -10), Vector3.new(1, 0, 0), "chapel")
	kit.checkpoint("C3_CHAPEL", CFrame.new(0, 0.5, 32))

	---------------------------------------------------------------------------
	-- Bell tower x -7..7, z 40..54 (entrance through its base)
	---------------------------------------------------------------------------
	local TH = 44
	kit.slab("TowerFloor", -7, 40, 7, 54, 0, 1, Color3.fromRGB(96, 90, 84), Enum.Material.Slate)
	local towerWall = { y = 0, h = 32, doorH = 11, color = STONE, material = Enum.Material.Cobblestone, t = 2 }
	kit.wallZ(54, -7, 7, { { 0, 6 } }, towerWall)
	kit.wallX(-7, 40, 54, nil, towerWall)
	kit.wallX(7, 40, 54, nil, towerWall)
	block(structure, "TowerCeiling", Vector3.new(14, 1, 14), CFrame.new(0, 12.5, 47), C.WoodDark, Enum.Material.WoodPlanks)
	for _, c in { { -6, 41 }, { 6, 41 }, { -6, 53 }, { 6, 53 } } do
		block(structure, "BelfryPillar", Vector3.new(2.4, TH - 32, 2.4), CFrame.new(c[1], 32 + (TH - 32) / 2, c[2]), STONE, Enum.Material.Cobblestone)
	end
	block(structure, "BelfryFloor", Vector3.new(15, 1, 15), CFrame.new(0, 32, 47), STONE_DARK, Enum.Material.Cobblestone)
	for step = 0, 6 do
		local w = 16 - step * 2.2
		block(structure, "Spire", Vector3.new(w, 2.4, w), CFrame.new(0, TH + 1.2 + step * 2.4, 47), ROOF, Enum.Material.Slate)
	end
	block(structure, "SpireCross", Vector3.new(0.5, 5, 0.5), CFrame.new(0, TH + 20, 47), C.SteelDark, Enum.Material.Metal)
	block(structure, "SpireCrossBar", Vector3.new(2.6, 0.5, 0.5), CFrame.new(0, TH + 21, 47), C.SteelDark, Enum.Material.Metal)
	local bell = block(props, "Bell", Vector3.new(5, 5, 5), CFrame.new(0, 37, 47), Color3.fromRGB(150, 120, 60), Enum.Material.Metal)
	bell.Shape = Enum.PartType.Ball
	block(props, "BellYoke", Vector3.new(9, 0.8, 0.8), CFrame.new(0, 40, 47), C.WoodDark, Enum.Material.Wood)
	local rope = block(props, "BellRope", Vector3.new(0.3, 11, 0.3), CFrame.new(3, 6.5, 50), Color3.fromRGB(160, 140, 100), Enum.Material.Fabric)
	rope.CanCollide = false
	local ropeHandle = block(props, "BellRopeHandle", Vector3.new(0.8, 1.6, 0.8), CFrame.new(3, 1.8, 50), Color3.fromRGB(110, 30, 30), Enum.Material.Fabric)
	kit.interactable(ropeHandle, "c3_bell", "INTERACT_RING", "OBJECT_BELL", { HoldDuration = 3, MaxDistance = 8 })
	kit.bulb(Vector3.new(0, 11, 47), C.Warm, 16, 1, "TOWER", true)
	kit.patrol(Vector3.new(0, 0, 47), "TOWER")
	local towerDoor = kit.door(Vector3.new(0, 0, 54), true, 6, false, nil, { doorH = 11, color = C.WoodDark, material = Enum.Material.Wood, prefix = "DT" })
	towerDoor.Name = "TowerDoor"
	local naveDoor = kit.door(Vector3.new(0, 0, 40), true, 8, false, nil, { doorH = 12, color = C.WoodDark, material = Enum.Material.Wood, prefix = "DT" })
	naveDoor.Name = "NaveDoor"

	---------------------------------------------------------------------------
	-- Sacristy x 18..34, z -30..-10 (hidden passage east, opened by the altar)
	---------------------------------------------------------------------------
	kit.room(18, -30, 34, -10, { h = 14, gaps = { w = { { -20, 6 } }, e = { { -20, 6 } } }, floor = Color3.fromRGB(90, 74, 60), floorMaterial = Enum.Material.WoodPlanks, wall = STONE, wallMaterial = Enum.Material.Cobblestone, roof = ROOF })
	kit.door(Vector3.new(18, 0, -20), false, 6, false, nil, { color = C.WoodDark, material = Enum.Material.Wood, prefix = "DS" })
	local passage = kit.door(Vector3.new(34, 0, -20), false, 6, true, "", { color = C.WoodDark, material = Enum.Material.Wood, prefix = "DS" })
	passage.Name = "HiddenPassage"
	passage:SetAttribute("Hidden", true)
	kit.shelf(CFrame.new(33, 0, -13) * CFrame.Angles(0, math.rad(-90), 0))
	kit.cabinet(CFrame.new(20, 0, -28))
	kit.desk(CFrame.new(26, 0, -28))
	kit.document(CFrame.new(26, 3.25, -28) * CFrame.Angles(0, 0.2, 0), "c3_priest_note")
	kit.candle(Vector3.new(24, 3.15, -27.5), true)
	kit.bulb(Vector3.new(26, 12, -20), C.Warm, 18, 1, "SACRISTY", true)
	kit.firstAid(CFrame.new(18.6 + 1, 5, -12) * CFrame.Angles(0, math.rad(90), 0))
	kit.patrol(Vector3.new(26, 0, -20), "SACRISTY")
	kit.vent(Vector3.new(33.3, 1.5, -27), Vector3.new(-1, 0, 0), "chapel")

	---------------------------------------------------------------------------
	-- Bunker inside the hill: corridor, archive, tape room, operator room
	---------------------------------------------------------------------------
	local bunkerWall = Color3.fromRGB(110, 112, 106)
	-- corridor x 34..60, z -24..-16
	kit.room(34, -24, 60, -16, { gaps = { w = { { -20, 6 } }, e = { { -20, 8 } } }, floor = Color3.fromRGB(74, 76, 72), wall = bunkerWall })
	for x = 38, 58, 10 do
		kit.bulb(Vector3.new(x, 12.5, -20), C.Fluorescent, 16, 1, "ARCHIVE", x == 38)
	end
	kit.panel(CFrame.new(44, 5, -23.4), "c3_breaker", "INTERACT_HOLD_BREAKER", "OBJECT_BREAKER", { Sector = "ARCHIVE" })
	kit.checkpoint("C3_ARCHIVE", CFrame.new(48, 0.5, -20))
	kit.patrol(Vector3.new(48, 0, -20), "CORRIDOR")
	deco(props, "RoughWall", Vector3.new(26, 14, 0.4), CFrame.new(47, 7, -24.2), STONE_DARK, Enum.Material.Rock)
	-- archive x 60..110, z -60..0
	kit.room(60, -60, 110, 0, { gaps = { w = { { -20, 8 } }, e = { { -30, 8 } }, n = { { 85, 8 } } }, floor = Color3.fromRGB(84, 74, 58), wall = bunkerWall })
	for x = 66, 102, 9 do
		for _, z in { -50, -38 } do
			kit.shelf(CFrame.new(x, 0, z))
		end
	end
	for x = 70, 100, 15 do
		kit.shelf(CFrame.new(x, 0, -8))
	end
	kit.desk(CFrame.new(72, 0, -24))
	kit.deskLamp(CFrame.new(70, 3.15, -24.5))
	kit.document(CFrame.new(74, 3.25, -24) * CFrame.Angles(0, -0.3, 0), "c3_index_card")
	kit.recorder(CFrame.new(103, 0.6, -55), "log_marek")
	kit.lightGrid(60, 110, -60, 0, "ARCHIVE", Color3.fromRGB(235, 225, 200))
	kit.emergencyLight(Vector3.new(61.5, 11, -10), "ARCHIVE")
	kit.firstAid(CFrame.new(109.4, 5, -10) * CFrame.Angles(0, math.rad(-90), 0))
	kit.patrol(Vector3.new(85, 0, -28), "ARCHIVE")
	kit.patrol(Vector3.new(70, 0, -55), "ARCHIVE")
	kit.vent(Vector3.new(60.7, 1.5, -45), Vector3.new(1, 0, 0), "bunker")
	kit.creatureSpawn(CFrame.new(64, 3, -56))
	-- the archive gate (door kind forecast) + winch
	local gate = kit.door(Vector3.new(110, 0, -30), false, 8, false, nil, { prefix = "DA" })
	gate.Name = "ArchiveGate"
	gate:SetAttribute("ArchiveGate", true)
	kit.wheel(CFrame.new(106, 0, -24), "c3_winch", "INTERACT_TURN", "OBJECT_WINCH", { HoldDuration = 3 })
	-- tape room x 110..140, z -50..-10
	kit.room(110, -50, 140, -10, { gaps = { w = { { -30, 8 } } }, floor = Color3.fromRGB(70, 66, 60), wall = Color3.fromRGB(96, 92, 86) })
	local deck = block(props, "MasterDeck", Vector3.new(6, 4, 3), CFrame.new(125, 2, -30), Color3.fromRGB(60, 56, 50), Enum.Material.SmoothPlastic)
	for _, dx in { -1.6, 1.6 } do
		local reel = block(props, "DeckReel", Vector3.new(0.2, 2.2, 2.2), CFrame.new(125 + dx, 4.5, -30) * CFrame.Angles(0, math.rad(90), 0), C.Plastic, Enum.Material.SmoothPlastic)
		reel.Shape = Enum.PartType.Cylinder
		reel.CanCollide = false
	end
	local deckLamp = block(props, "DeckLamp", Vector3.new(0.5, 0.5, 0.1), CFrame.new(127.4, 3.4, -31.55), C.Emergency, Enum.Material.Neon)
	deckLamp.CanCollide = false
	deckLamp:SetAttribute("DeckLamp", true)
	kit.interactable(deck, "c3_deck", "INTERACT_INSERT_TAPE", "OBJECT_DECK", { MaxDistance = 8 })
	local tapeSpots = {
		CFrame.new(114, 3.6, -46), CFrame.new(136, 3.6, -46), CFrame.new(136, 3.6, -14),
		CFrame.new(64, 3.6, -26), CFrame.new(96, 3.6, -4),
	}
	for i, cf in tapeSpots do
		kit.table_(cf * CFrame.new(0, -3.6, 0), Vector3.new(4, 0.3, 2.4), Color3.fromRGB(70, 56, 44))
		local recorder = block(props, "TapeRecorder", Vector3.new(1.6, 0.7, 1.2), cf * CFrame.new(0, 0.35, 0), Color3.fromRGB(48, 44, 40), Enum.Material.SmoothPlastic)
		local reel = block(props, "Reel", Vector3.new(0.1, 0.6, 0.6), cf * CFrame.new(0, 0.85, 0) * CFrame.Angles(0, 0, math.rad(90)), C.Plastic, Enum.Material.SmoothPlastic)
		reel.Shape = Enum.PartType.Cylinder
		reel.CanCollide = false
		local led = Instance.new("PointLight")
		led.Range = 4
		led.Brightness = 0.7
		led.Color = Color3.fromRGB(255, 120, 60)
		led.Parent = recorder
		kit.interactable(recorder, "c3_tape", "INTERACT_LISTEN", "OBJECT_TAPE", { MaxDistance = 7, TapeSlot = i })
	end
	kit.lightGrid(110, 140, -50, -10, "TAPES", Color3.fromRGB(255, 214, 170))
	kit.patrol(Vector3.new(125, 0, -20), "TAPES")
	kit.vent(Vector3.new(139.3, 1.5, -40), Vector3.new(-1, 0, 0), "bunker")
	kit.firstAid(CFrame.new(139.4, 5, -24) * CFrame.Angles(0, math.rad(-90), 0))
	kit.speaker(Vector3.new(125, 12.5, -10.8), Vector3.new(0, 0, -1))
	-- sealed operator room x 70..100, z -90..-60 (behind a heavy door at z -60)
	kit.room(70, -90, 100, -60, { gaps = { s = { { 85, 8 } } }, floor = Color3.fromRGB(60, 62, 62), wall = Color3.fromRGB(80, 84, 86) })
	local sealed = kit.door(Vector3.new(85, 0, -60), true, 8, true, "", { color = Color3.fromRGB(90, 96, 98), prefix = "DO" })
	sealed.Name = "SealedDoor"
	sealed:SetAttribute("Sealed", true)
	local screens = kit.console(CFrame.new(85, 0, -86) * CFrame.Angles(0, math.rad(180), 0), Color3.fromRGB(120, 200, 255))
	for _, screen in screens do
		kit.worldText(screen, Enum.NormalId.Front, nil, "DURCHLAUF 0007", nil, Color3.fromRGB(10, 30, 50))
	end
	kit.serverRack(CFrame.new(72, 0, -88) * CFrame.Angles(0, math.rad(90), 0))
	kit.serverRack(CFrame.new(98, 0, -88) * CFrame.Angles(0, math.rad(-90), 0))
	kit.table_(CFrame.new(85, 0, -74), Vector3.new(7, 0.3, 3.2), Color3.fromRGB(70, 56, 44))
	-- the twist: a radio (painted like a player's own at runtime) and the Relay's recorder
	local twistRadio = block(props, "TwistRadio", Vector3.new(0.8, 1.8, 0.5), CFrame.new(83, 4.05, -74) * CFrame.Angles(0, math.rad(20), math.rad(-75)), Color3.fromRGB(40, 42, 44), Enum.Material.SmoothPlastic)
	twistRadio:SetAttribute("TwistRadio", true)
	local antennaRod = deco(props, "TwistRadioAntenna", Vector3.new(0.12, 1.6, 0.12), twistRadio.CFrame * CFrame.new(0.2, 1.5, 0), C.SteelDark, Enum.Material.Metal)
	antennaRod.Name = "TwistRadioAntenna"
	local relayRecorder = block(props, "RelayRecorder", Vector3.new(1.6, 0.7, 1.2), CFrame.new(87.5, 3.5, -74), Color3.fromRGB(40, 38, 36), Enum.Material.SmoothPlastic)
	kit.interactable(relayRecorder, "c3_relay_recorder", "INTERACT_LISTEN", "OBJECT_RELAY_RECORDER", { MaxDistance = 7 })
	local plaque = block(props, "TwistPlaque", Vector3.new(5, 1.2, 0.1), CFrame.new(85, 5, -89.4), Color3.fromRGB(180, 170, 140), Enum.Material.Metal)
	local plaqueText = kit.worldText(plaque, Enum.NormalId.Front, nil, "DURCHLAUF 0007", nil, Color3.fromRGB(30, 26, 20))
	plaqueText.Name = "TwistPlaqueText"
	plaque.CFrame = CFrame.lookAt(Vector3.new(85, 5.5, -89.4), Vector3.new(85, 5.5, -80))
	for _, x in { 74, 96 } do
		kit.emergencyLight(Vector3.new(x, 12, -61.5), "OPERATOR")
	end
	kit.lightGrid(70, 100, -90, -60, "OPERATOR", Color3.fromRGB(190, 220, 255))
	kit.checkpoint("C3_OPERATOR", CFrame.new(85, 0.5, -55))
	kit.patrol(Vector3.new(85, 0, -75), "OPERATOR")

	---------------------------------------------------------------------------
	-- Cemetery, path, forest
	---------------------------------------------------------------------------
	kit.previewGround(Vector3.new(0, -0.62, 80), Vector3.new(700, 1, 600), Color3.fromRGB(44, 52, 40))
	local hillPreview = block(outside, "EditPreviewHill", Vector3.new(130, 16, 110), CFrame.new(95, 23, -45), Color3.fromRGB(50, 58, 44), Enum.Material.Grass)
	hillPreview:SetAttribute("FZ_EditPreview", true)
	hillPreview.Transparency = 0.5
	hillPreview.CanCollide = false
	block(outside, "Path", Vector3.new(6, 0.6, 200), CFrame.new(0, -0.2, 155), Color3.fromRGB(96, 90, 80), Enum.Material.Pebble)
	-- cemetery wall with gate
	local fence = { h = 3, color = STONE_DARK, material = Enum.Material.Cobblestone, t = 1.2, doorH = 3 }
	kit.wallZ(130, -60, 60, { { 0, 6 } }, fence)
	kit.wallX(-60, 54, 130, nil, fence)
	kit.wallX(60, 54, 130, nil, fence)
	for _, x in { -3.6, 3.6 } do
		block(outside, "GatePillar", Vector3.new(1.6, 5, 1.6), CFrame.new(x, 2.5, 130), STONE, Enum.Material.Cobblestone)
		kit.bulb(Vector3.new(x, 5.8, 130), C.Candle, 20, 1.2, "CEMETERY", true)
	end
	-- graves
	for row = 0, 4 do
		for col = 0, 9 do
			local x = -52 + col * 11.5
			local z = 62 + row * 13
			if math.abs(x) > 7 then
				local tilt = kit.rng:NextNumber(-0.12, 0.12)
				local h = kit.rng:NextNumber(2.2, 4)
				local stoneCf = CFrame.new(x, h / 2, z) * CFrame.Angles(tilt, kit.rng:NextNumber(-0.1, 0.1), tilt * 0.5)
				if (row + col) % 5 == 0 then
					block(outside, "GraveCross", Vector3.new(0.5, h + 1.5, 0.5), stoneCf * CFrame.new(0, 0.75, 0), STONE_DARK, Enum.Material.Granite)
					block(outside, "GraveCrossBar", Vector3.new(2, 0.5, 0.5), stoneCf * CFrame.new(0, h / 2 + 0.3, 0), STONE_DARK, Enum.Material.Granite)
				else
					block(outside, "Gravestone", Vector3.new(2.6, h, 0.6), stoneCf, STONE:Lerp(STONE_DARK, kit.rng:NextNumber()), Enum.Material.Granite)
				end
				deco(outside, "GraveBed", Vector3.new(3, 0.3, 5), CFrame.new(x, 0.1, z + 3), Color3.fromRGB(56, 48, 38), Enum.Material.Ground)
			end
		end
	end
	-- the memorial for the six of 2009
	local memorial = block(outside, "Memorial", Vector3.new(6, 5, 1.2), CFrame.new(-30, 2.5, 120), Color3.fromRGB(150, 146, 140), Enum.Material.Marble)
	kit.worldText(memorial, Enum.NormalId.Back, "MEMORIAL_TEXT")
	memorial.CFrame = CFrame.lookAt(Vector3.new(-30, 2.5, 120), Vector3.new(-30, 2.5, 130))
	kit.interactable(memorial, "lore", "INTERACT_READ", "OBJECT_MEMORIAL", { MaxDistance = 8, LogId = "c3_memorial" })
	kit.candle(Vector3.new(-31.5, 0, 121.5), true)
	kit.candle(Vector3.new(-28.5, 0, 121.5), false)
	for _, p in { Vector3.new(-40, 0, 90), Vector3.new(40, 0, 75), Vector3.new(25, 0, 110) } do
		block(outside, "LanternPost", Vector3.new(0.4, 6, 0.4), CFrame.new(p + Vector3.new(0, 3, 0)), C.SteelDark, Enum.Material.Metal)
		kit.bulb(p + Vector3.new(0, 6.4, 0), C.Candle, 22, 1.3, "CEMETERY", true)
	end
	for _ = 1, 6 do
		kit.tree(outside, Vector3.new(kit.rng:NextNumber(-55, 55), 0, kit.rng:NextNumber(58, 125)), kit.rng:NextNumber(0.5, 0.8), true)
	end
	kit.patrol(Vector3.new(-30, 0, 90), "CEMETERY")
	kit.patrol(Vector3.new(30, 0, 100), "CEMETERY")
	kit.patrol(Vector3.new(0, 0, 160), "PATH")
	kit.forest(180, -340, 340, -260, 400, { { -70, -70, 175, 140 }, { -12, 130, 12, 420 }, { -40, 170, 40, 300 } }, 0.25)
	for _ = 1, 30 do
		local x, z = kit.rng:NextNumber(-200, 200), kit.rng:NextNumber(-150, 300)
		if not (x > -70 and x < 175 and z > -110 and z < 140) and math.abs(x) > 8 then
			kit.rock(Vector3.new(x, 0, z), kit.rng:NextNumber(1.5, 4))
		end
	end
	-- an old car at the end of the forest path (start)
	local car = block(outside, "Car", Vector3.new(6, 4.4, 12), CFrame.new(-7, 2.4, 205) * CFrame.Angles(0, math.rad(8), 0), Color3.fromRGB(80, 30, 28), Enum.Material.Metal)
	kit.interactable(car, "church_extract", "INTERACT_LEAVE", "OBJECT_CAR", { HoldDuration = 2, MaxDistance = 10 })
	kit.bulb(Vector3.new(-7, 2.5, 198.5), C.Warm, 26, 1.4, nil, true)

	---------------------------------------------------------------------------
	-- Survival ("Kapelle - Nachtwache"): generator shed, stations, breakers, keys
	---------------------------------------------------------------------------
	kit.slab("ShedFloor", -44, -22, -24, 6, 0, 1, Color3.fromRGB(70, 64, 56))
	block(structure, "ShedRoof", Vector3.new(22, 0.8, 30), CFrame.new(-34, 10, -8) * CFrame.Angles(0, 0, math.rad(-8)), ROOF, Enum.Material.CorrodedMetal)
	for _, p in { Vector3.new(-43, 0, -21), Vector3.new(-25, 0, -21), Vector3.new(-43, 0, 5), Vector3.new(-25, 0, 5) } do
		block(structure, "ShedPost", Vector3.new(0.6, 10, 0.6), CFrame.new(p + Vector3.new(0, 5, 0)), C.WoodDark, Enum.Material.Wood)
	end
	kit.generator(CFrame.new(-34, 0, -14) * CFrame.Angles(0, math.rad(90), 0), 1)
	kit.generator(CFrame.new(-34, 0, -1) * CFrame.Angles(0, math.rad(90), 0), 2)
	kit.bulb(Vector3.new(-34, 9, -8), C.Sodium, 24, 1.4, "CEMETERY", true)
	kit.station(CFrame.new(-14, 1.5, -46), "church_station_1")
	kit.station(CFrame.new(64, 1.5, -58), "church_station_2")
	kit.station(CFrame.new(76, 1.5, -64), "church_station_3")
	kit.panel(CFrame.new(-16.4, 5, 10) * CFrame.Angles(0, math.rad(90), 0), "breaker", "INTERACT_HOLD_BREAKER", "OBJECT_BREAKER", { Sector = "NAVE" })
	kit.panel(CFrame.new(33.4, 5, -26) * CFrame.Angles(0, math.rad(-90), 0), "breaker", "INTERACT_HOLD_BREAKER", "OBJECT_BREAKER", { Sector = "SACRISTY" })
	kit.panel(CFrame.new(139.4, 5, -16) * CFrame.Angles(0, math.rad(-90), 0), "breaker", "INTERACT_HOLD_BREAKER", "OBJECT_BREAKER", { Sector = "TAPES" })
	kit.panel(CFrame.new(28, 5, -10.6), "church_relay", "INTERACT_INSERT", "OBJECT_FUSE_PANEL", { HoldDuration = 3 }, C.Steel)
	kit.syncKey(CFrame.new(60.6, 4.5, -30) * CFrame.Angles(0, math.rad(90), 0), 1)
	kit.syncKey(CFrame.new(139.4, 4.5, -36) * CFrame.Angles(0, math.rad(-90), 0), 2)
	kit.checkpoint("CP_SV_CHURCH", CFrame.new(0, 0.5, 20))

	---------------------------------------------------------------------------
	-- Markers
	---------------------------------------------------------------------------
	kit.checkpoint("C3_START", CFrame.new(0, 0.5, 210))
	kit.spawnLocation(CFrame.new(0, 0.5, 270))
	for _, cf in {
		CFrame.new(-9, 2.2, 10), CFrame.new(9, 2.2, -16), CFrame.new(26, 3.45, -28.5), CFrame.new(50, 0.4, -18),
		CFrame.new(72, 3.45, -23), CFrame.new(100, 0.4, -30), CFrame.new(120, 0.4, -46), CFrame.new(134, 0.4, -12),
		CFrame.new(-20, 0.4, 100), CFrame.new(3, 0.4, 44),
	} do
		kit.itemSpot(cf)
	end
	for _, f in {
		{ CFrame.new(-14, 2.2, 22), "NAVE" }, { CFrame.new(30, 0.4, -12), "SACRISTY" },
		{ CFrame.new(66, 0.4, -4), "ARCHIVE" }, { CFrame.new(104, 0.4, -58), "ARCHIVE" },
		{ CFrame.new(136, 0.4, -48), "TAPES" }, { CFrame.new(-50, 0.4, 125), "CEMETERY" },
	} do
		kit.fuseSpot(f[1], f[2])
	end
	kit.speaker(Vector3.new(0, 18, -39), Vector3.new(0, 0, 1))
	kit.speaker(Vector3.new(85, 12.5, -0.8), Vector3.new(0, 0, -1))
	kit.menuCamera(1, Vector3.new(-14, 4, 178), Vector3.new(0, 22, 40), 6)
	kit.menuCamera(2, Vector3.new(0, 6, 34), Vector3.new(0, 6, -42), 5)
	kit.menuCamera(3, Vector3.new(-50, 5, 118), Vector3.new(0, 18, 50), 7)
	kit.menuCamera(4, Vector3.new(63, 8, -30), Vector3.new(108, 3, -28), 4)

	-- finishing pass: wood panelling in the nave, painted bunker walls, cemetery mist,
	-- moonlight falling through the stained glass
	local model = kit.root
	MapDress.Walls(model, { lower = Color3.fromRGB(70, 50, 36), rail = Color3.fromRGB(52, 36, 24), skirting = Color3.fromRGB(30, 24, 20), height = 5, material = Enum.Material.Wood })
	MapDress.Mist(model, Vector3.new(0, 0, 92), Vector3.new(120, 0, 76), Color3.fromRGB(176, 184, 200), 1.8)
	MapDress.Mist(model, Vector3.new(0, 0, 175), Vector3.new(60, 0, 80), Color3.fromRGB(176, 184, 200), 1.2)
	MapDress.Mist(model, Vector3.new(-120, 0, 40), Vector3.new(120, 0, 200), nil, 0.8)
	for _, pane in model:GetDescendants() do
		if pane:IsA("BasePart") and pane.Name == "StainedGlass" then
			local p = pane.CFrame.Position
			local inward = if p.X < 0 then 1 else -1
			MapDress.Shaft(pane, Vector3.new(p.X + inward * 12, 0, p.Z + 3), 6, Color3.fromRGB(170, 190, 230))
		end
	end
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d.Name == "RoofPlane" then
				d.Material = Enum.Material.RoofShingles
			elseif d.Name == "Floor" then
				local p = d.CFrame.Position
				if p.X > 60 and p.X < 110 and p.Z > -60 and p.Z < 0 then
					d.Material = Enum.Material.Carpet -- archive
					d.Color = Color3.fromRGB(84, 40, 36)
				elseif p.X > 110 then
					d.Material = Enum.Material.Carpet -- tape room
					d.Color = Color3.fromRGB(60, 58, 70)
				elseif p.Z < -60 then
					d.Material = Enum.Material.CeramicTiles -- operator room
					d.Color = Color3.fromRGB(150, 156, 156)
				end
			end
		end
	end
	MapDress.Flicker(model, 0.2, 44)
	return kit.finish()
end

function Map.BuildTerrain(model: Instance?)
	local terrain = workspace.Terrain
	terrain:FillBlock(CFrame.new(0, -5.1, 60), Vector3.new(900, 10, 900), Enum.Material.Grass)
	-- the hill over the bunker (the rooms have their own roofs at y 15): top layer plus
	-- flanks around the footprint x 34..140, z -90..0 (left open towards the sacristy)
	terrain:FillBlock(CFrame.new(98, 26, -46), Vector3.new(140, 20, 120), Enum.Material.Grass)
	terrain:FillBlock(CFrame.new(155, 14, -46), Vector3.new(30, 30, 120), Enum.Material.Rock)
	terrain:FillBlock(CFrame.new(98, 14, -100), Vector3.new(140, 30, 18), Enum.Material.Rock)
	terrain:FillBlock(CFrame.new(105, 8, 8), Vector3.new(90, 18, 14), Enum.Material.Grass)
	terrain:FillBlock(CFrame.new(50, 8, -50), Vector3.new(18, 18, 52), Enum.Material.Rock)
	terrain:FillWedge(CFrame.new(98, 23, 28) * CFrame.Angles(0, math.rad(180), 0), Vector3.new(140, 14, 26), Enum.Material.Grass)
	local patches = Random.new(23)
	for _ = 1, 24 do
		local x, z = patches:NextNumber(-380, 380), patches:NextNumber(-300, 420)
		if not (x > -70 and x < 175 and z > -110 and z < 140) and math.abs(x) > 8 then
			terrain:FillBall(Vector3.new(x, -2.4, z), patches:NextNumber(10, 24), if patches:NextNumber() < 0.5 then Enum.Material.LeafyGrass else Enum.Material.Ground)
		end
	end
	MapKit.ApplyClouds("chapel")
	MapDress.TerrainLook({
		Grass = Color3.fromRGB(58, 68, 52),
		LeafyGrass = Color3.fromRGB(52, 62, 46),
		Ground = Color3.fromRGB(72, 64, 54),
		Mud = Color3.fromRGB(52, 46, 40),
		Rock = Color3.fromRGB(92, 92, 90),
	})
	MapKit.RemovePreview(model)
end

function Map.ApplyLighting()
	MapKit.ApplyLighting("chapel")
end

function Map.Build(): Model
	local model = build()
	Map.ApplyLighting()
	if not Map.SkipTerrain then
		Map.BuildTerrain(model)
	end
	return model
end

return Map
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">Dam03</string>
            <string name="Source"><![CDATA[-- Staumauer 3 (Dam 3) - chapter 2 "The Wrong Voice" and the survival map "Floodgate".
--
--                    STAUSEE (lake, north)
--   ═══════════════ DAMMKRONE y=44 (crest) ═══════════════════════
--   [Messraum]─── Kontrollgalerie (inside the dam, y=0) ──┐  Schrägstollen ─► Schieberhaus (crest)
--               Antennenhof (crest, over the lake)         │
--   ─────────────────── Portal (x=0) ─────────────────────┘  Serpentinen-Rampe (dam face, east)
--   [Mannschaftstrakt: Kantine | Büro | Schlafsaal]      [Turbinenhalle | Schieberkammer | Leitstand]
--                         Talstraße (south) ─► Schranke (start)
--
-- Gameplay objects follow docs/MAP_CONTRACT.md. Chapter-2 objects use InteractIds "c2_*".

local CollectionService = game:GetService("CollectionService")

local MapKit = require(script.Parent.MapKit)
local MapDress = require(script.Parent.MapDress)
local C = MapKit.C

local Map = {}

local CREST = 44 -- crest walkway height
local LAKE = 38 -- water level of the reservoir

local function build()
	local kit = MapKit.new("FZ_Dam03", "Dam03", 303)
	local block, deco = kit.block, kit.deco
	local structure = kit.folder("Structure")
	local props = kit.folder("Props")
	local outside = kit.folder("Outside")
	local concrete = Color3.fromRGB(118, 116, 108)
	local concreteWet = Color3.fromRGB(84, 86, 84)

	---------------------------------------------------------------------------
	-- The dam: front shell (valley), back shell (lake), end caps, crest slab
	---------------------------------------------------------------------------
	-- front face with the gallery portal (x -4..4, height 9)
	block(structure, "DamFront", Vector3.new(146, CREST, 3), CFrame.new(-77, CREST / 2, -1.5), concreteWet, Enum.Material.Concrete)
	block(structure, "DamFront", Vector3.new(146, CREST, 3), CFrame.new(77, CREST / 2, -1.5), concreteWet, Enum.Material.Concrete)
	block(structure, "DamFrontPortalTop", Vector3.new(8, CREST - 9, 3), CFrame.new(0, 9 + (CREST - 9) / 2, -1.5), concreteWet, Enum.Material.Concrete)
	block(structure, "DamBack", Vector3.new(300, CREST, 3), CFrame.new(0, CREST / 2, -18.5), concreteWet, Enum.Material.Concrete)
	block(structure, "DamCapW", Vector3.new(4, CREST, 20), CFrame.new(-152, CREST / 2, -10), concreteWet, Enum.Material.Concrete)
	block(structure, "DamCapE", Vector3.new(4, CREST, 20), CFrame.new(152, CREST / 2, -10), concreteWet, Enum.Material.Concrete)
	-- crest slab, open above the inclined shaft (x 98..132, z -14..-8) so there is head room
	-- all the way up; the shaft housing rises through the crest there.
	local crestY = CREST - 1.5
	block(structure, "Crest", Vector3.new(248, 3, 20), CFrame.new(-26, crestY, -10), concrete, Enum.Material.Concrete)
	block(structure, "Crest", Vector3.new(52, 3, 6), CFrame.new(124, crestY, -17), concrete, Enum.Material.Concrete)
	block(structure, "Crest", Vector3.new(52, 3, 8), CFrame.new(124, crestY, -4), concrete, Enum.Material.Concrete)
	block(structure, "Crest", Vector3.new(18, 3, 6), CFrame.new(141, crestY, -11), concrete, Enum.Material.Concrete)
	-- buttresses on the valley face (rhythm + scale)
	for x = -140, 140, 20 do
		if math.abs(x) > 6 and not (x > 24 and x < 150) then
			block(structure, "Buttress", Vector3.new(4, CREST - 2, 6), CFrame.new(x, (CREST - 2) / 2, 3), concreteWet, Enum.Material.Concrete)
		end
	end
	-- streaks of damp concrete and a plaque
	for i = 1, 14 do
		local x = kit.rng:NextNumber(-140, 140)
		deco(structure, "Stain", Vector3.new(kit.rng:NextNumber(2, 6), kit.rng:NextNumber(12, 30), 0.1), CFrame.new(x, CREST - 18, 0.05), Color3.fromRGB(58, 64, 60), Enum.Material.Slate)
	end
	local plaque = deco(props, "DamPlaque", Vector3.new(14, 3, 0.3), CFrame.new(0, 13, 0.2), C.Plastic, Enum.Material.SmoothPlastic)
	kit.worldText(plaque, Enum.NormalId.Back, nil, "STAUMAUER 3  ·  1962")
	plaque.CFrame = CFrame.lookAt(Vector3.new(0, 13, 0.2), Vector3.new(0, 13, 10))

	-- crest parapets, lamp posts
	local function parapet(z: number, x0: number, x1: number)
		block(structure, "Parapet", Vector3.new(x1 - x0, 3.4, 1), CFrame.new((x0 + x1) / 2, CREST + 1.7, z), concrete, Enum.Material.Concrete)
	end
	parapet(-19.5, -150, -30)
	parapet(-19.5, 30, 150)
	parapet(-0.5, -150, 140)
	for x = -135, 135, 30 do
		local post = block(outside, "CrestLamp", Vector3.new(0.4, 9, 0.4), CFrame.new(x, CREST + 4.5, -1.5), C.SteelDark, Enum.Material.Metal)
		post.CanCollide = false
		kit.bulb(Vector3.new(x, CREST + 9, -2.5), C.Sodium, 26, 1.6, "CREST", true)
	end

	---------------------------------------------------------------------------
	-- Inspection gallery (inside the dam, y = 0)
	---------------------------------------------------------------------------
	local galleryWall = Color3.fromRGB(96, 98, 94)
	kit.slab("GalleryFloor", -130, -18, 12, -3, 0, 1, Color3.fromRGB(70, 72, 70))
	kit.wallZ(-14, -112, 12, nil, { h = 9, color = galleryWall })
	kit.wallZ(-8, -112, 12, { { 0, 8 } }, { h = 9, doorH = 9, color = galleryWall })
	block(structure, "GalleryCeiling", Vector3.new(124, 1, 6), CFrame.new(-50, 9.5, -11), Color3.fromRGB(56, 58, 58), Enum.Material.Concrete)
	-- portal corridor x -4..4, z -8..-3
	kit.wallX(-4, -8, -3, nil, { h = 9, color = galleryWall })
	kit.wallX(4, -8, -3, nil, { h = 9, color = galleryWall })
	block(structure, "PortalCeiling", Vector3.new(8, 1, 5), CFrame.new(0, 9.5, -5.5), Color3.fromRGB(56, 58, 58), Enum.Material.Concrete)
	kit.door(Vector3.new(0, 0, -1.5), true, 7, false, nil, { doorH = 9, prefix = "DG" }):SetAttribute("Gallery", "portal")
	-- measuring room (west end)
	kit.room(-130, -18, -112, -3, { h = 9, gaps = { e = { { -11, 6 } } }, floor = Color3.fromRGB(70, 72, 70), noFloor = true, wall = galleryWall })
	kit.lightGrid(-130, -112, -18, -3, "GALLERY", C.Fluorescent, 0, 9)
	kit.console(CFrame.new(-121, 0, -16) * CFrame.Angles(0, math.rad(180), 0))
	kit.shelf(CFrame.new(-128.5, 0, -10) * CFrame.Angles(0, math.rad(90), 0))
	kit.document(CFrame.new(-118, 3.25, -15) * CFrame.Angles(0, 0.4, 0), "c2_correction_3")
	kit.desk(CFrame.new(-118, 0, -15))
	-- gallery lights, pipes, drainage channel, water marks
	for x = -104, 8, 14 do
		kit.bulb(Vector3.new(x, 8.2, -11), C.Fluorescent, 16, 1, "GALLERY", x % 28 == 0)
	end
	kit.pipeRun(Vector3.new(-112, 7.6, -13.3), Vector3.new(12, 7.6, -13.3), 0.35)
	kit.pipeRun(Vector3.new(-112, 6.9, -13.3), Vector3.new(12, 6.9, -13.3), 0.25, Color3.fromRGB(120, 40, 30))
	deco(structure, "Drain", Vector3.new(124, 0.1, 0.8), CFrame.new(-50, 0.02, -8.8), Color3.fromRGB(30, 34, 36), Enum.Material.DiamondPlate)
	for x = -100, 0, 25 do
		deco(structure, "WaterMark", Vector3.new(16, 0.15, 0.05), CFrame.new(x, 3.2, -13.45), Color3.fromRGB(60, 70, 66), Enum.Material.Slate)
	end
	-- flood water (hidden; shown when the chapter-2 forecast comes true)
	for _, seg in { { -71, 82 }, { 12 - 15, 22 } } do
		local water = block(kit.folder("Flood"), "FloodWater", Vector3.new(seg[2], 4.2, 5.8), CFrame.new(seg[1], 2.1, -11), Color3.fromRGB(40, 70, 80), Enum.Material.Glass)
		water.Transparency = 1
		water.CanCollide = false
		water.CanQuery = false
		water.CastShadow = false
		CollectionService:AddTag(water, "FZ_FloodWater")
	end
	local floodRoom = block(kit.folder("Flood"), "FloodWater", Vector3.new(18, 4.2, 15), CFrame.new(-121, 2.1, -10.5), Color3.fromRGB(40, 70, 80), Enum.Material.Glass)
	floodRoom.Transparency = 1
	floodRoom.CanCollide = false
	floodRoom.CanQuery = false
	CollectionService:AddTag(floodRoom, "FZ_FloodWater")

	-- inclined shaft x 12 -> 132 (y 0 -> 44), z -14..-8
	local a, b = Vector3.new(12, 0, -11), Vector3.new(132, CREST, -11)
	local ramp = kit.ramp(a, b, 6, Color3.fromRGB(80, 80, 76))
	ramp.Name = "InclineFloor"
	local slope = CFrame.lookAt((a + b) / 2, b)
	local length = (b - a).Magnitude
	for _, side in { -3.3, 3.3 } do
		block(structure, "InclineWall", Vector3.new(0.8, 10, length + 2), slope * CFrame.new(side, 4.5, 0), galleryWall, Enum.Material.Concrete)
	end
	block(structure, "InclineCeiling", Vector3.new(7.4, 0.8, length + 2), slope * CFrame.new(0, 9.4, 0), Color3.fromRGB(56, 58, 58), Enum.Material.Concrete)
	for i = 1, 9 do
		local p = a:Lerp(b, i / 10)
		kit.bulb(p + Vector3.new(0, 7.6, 0), C.Fluorescent, 16, 0.9, "GALLERY", i % 3 == 0)
		deco(structure, "Step", Vector3.new(6, 0.12, 0.4), slope * CFrame.new(0, 0.07, -length / 2 + i * length / 10) , C.Hazard, Enum.Material.SmoothPlastic)
	end
	kit.door(Vector3.new(14, 0, -11), false, 5.6, false, nil, { doorH = 9, prefix = "DG" }):SetAttribute("Gallery", "incline")
	kit.recorder(CFrame.new(70, 22.6, -12.8), "log_kessler")

	---------------------------------------------------------------------------
	-- Crest buildings: valve house (top of the incline), antenna yard over the lake
	---------------------------------------------------------------------------
	-- valve house x 118..146, z -19..-1 on the crest (incline arrives inside)
	kit.room(118, -19, 146, -1, { y = CREST, h = 12, gaps = { w = { { -10, 6 } } }, noFloor = true, wall = Color3.fromRGB(132, 126, 112), roof = Color3.fromRGB(70, 60, 54) })
	kit.door(Vector3.new(118, CREST, -10), false, 6, false, "", { prefix = "DV" })
	kit.lightGrid(118, 146, -19, -1, "CREST", C.Fluorescent, CREST, 12)
	kit.console(CFrame.new(140, CREST, -5) * CFrame.Angles(0, math.rad(-90), 0))
	kit.wheel(CFrame.new(140, CREST, -15), "c2_spillway", "INTERACT_TURN", "OBJECT_SPILLWAY", { HoldDuration = 4 })
	kit.panel(CFrame.new(145.4, CREST + 5, -10) * CFrame.Angles(0, math.rad(-90), 0), "breaker", "INTERACT_HOLD_BREAKER", "OBJECT_BREAKER", { Sector = "CREST" })
	kit.interactable(kit.block(props, "StationValve", Vector3.new(2, 3, 2), CFrame.new(122, CREST + 1.5, -16), C.Steel, Enum.Material.Metal), "dam_station_2", "INTERACT_ACTIVATE", "OBJECT_STATION", { MaxDistance = 8 })
	kit.firstAid(CFrame.new(118.6, CREST + 5, -16) * CFrame.Angles(0, math.rad(90), 0))
	kit.checkpoint("C2_CREST", CFrame.new(110, CREST + 0.5, -10))

	-- antenna yard: platform over the lake x -30..30, z -44..-20, fenced, gated
	block(structure, "YardPlatform", Vector3.new(60, 3, 24), CFrame.new(0, crestY, -32), concrete, Enum.Material.Concrete)
	for _, x in { -26, -9, 9, 26 } do
		block(structure, "YardPillar", Vector3.new(4, CREST, 4), CFrame.new(x, CREST / 2 - 1, -40), concreteWet, Enum.Material.Concrete)
	end
	kit.railing(Vector3.new(-30, CREST, -44), Vector3.new(30, CREST, -44))
	kit.railing(Vector3.new(-30, CREST, -44), Vector3.new(-30, CREST, -20))
	kit.railing(Vector3.new(30, CREST, -44), Vector3.new(30, CREST, -20))
	-- fence with the yard gate on the crest side (locked until the team chose whom to trust)
	kit.wallZ(-19.5, -30, 30, { { 0, 8 } }, { y = CREST, h = 9, doorH = 8, color = C.SteelDark, material = Enum.Material.DiamondPlate, t = 0.4 })
	local yardGate = kit.door(Vector3.new(0, CREST, -19.5), true, 7.6, true, "", { doorH = 8, prefix = "DY" })
	yardGate:SetAttribute("YardGate", true)
	local ax, az = 0, -34
	local antenna = Instance.new("Model")
	antenna.Name = "StormAntenna"
	antenna.Parent = outside
	for i = 0, 5 do
		local y0, y1 = CREST + i * 7, CREST + (i + 1) * 7
		local w0, w1 = 4 - i * 0.5, 4 - (i + 1) * 0.5
		for _, corner in { { 1, 1 }, { -1, 1 }, { 1, -1 }, { -1, -1 } } do
			local p0 = Vector3.new(ax + corner[1] * w0, y0, az + corner[2] * w0)
			local p1 = Vector3.new(ax + corner[1] * w1, y1, az + corner[2] * w1)
			block(antenna, "Leg", Vector3.new(0.5, 0.5, (p1 - p0).Magnitude), CFrame.lookAt((p0 + p1) / 2, p1), C.Emergency:Lerp(C.SteelDark, 0.55), Enum.Material.Metal)
		end
	end
	local beacon = deco(antenna, "Beacon", Vector3.new(1, 1, 1), CFrame.new(ax, CREST + 43, az), C.Emergency, Enum.Material.Neon)
	local beaconLight = Instance.new("PointLight")
	beaconLight.Range = 24
	beaconLight.Brightness = 2
	beaconLight.Color = C.Emergency
	beaconLight.Parent = beacon
	CollectionService:AddTag(beacon, "FZ_Beacon")
	local uplink = block(props, "UplinkCabinet", Vector3.new(3, 5, 2), CFrame.new(ax + 8, CREST + 2.5, az), C.Steel, Enum.Material.Metal)
	kit.interactable(uplink, "c2_uplink", "INTERACT_ACTIVATE", "OBJECT_UPLINK", { HoldDuration = 2, MaxDistance = 8 })
	kit.floodLight(Vector3.new(-26, CREST + 8, -22), Vector3.new(0, CREST, -34), C.Fluorescent, 60)
	kit.floodLight(Vector3.new(26, CREST + 8, -22), Vector3.new(0, CREST, -34), C.Fluorescent, 60)
	kit.patrol(Vector3.new(0, CREST, -30), "ANTENNA")

	---------------------------------------------------------------------------
	-- Switchback ramp on the dam face (east): three legs to the crest
	---------------------------------------------------------------------------
	local legs = {
		{ Vector3.new(30, 0, 3), Vector3.new(140, 15, 3) },
		{ Vector3.new(140, 15, 9), Vector3.new(30, 30, 9) },
		{ Vector3.new(30, 30, 15), Vector3.new(140, CREST, 15) },
	}
	for i, leg in legs do
		local r = kit.ramp(leg[1], leg[2], 6, concrete)
		r.Name = "SwitchbackRamp" .. i
		-- outer and inner rails (the legs run side by side at different heights)
		kit.railing(leg[1] + Vector3.new(0, 0, 3), leg[2] + Vector3.new(0, 0, 3))
		if i > 1 then
			kit.railing(leg[1] - Vector3.new(0, 0, 3), leg[2] - Vector3.new(0, 0, 3))
		end
		-- supports
		for t = 0.15, 0.95, 0.2 do
			local p = leg[1]:Lerp(leg[2], t)
			if p.Y > 2 then
				block(structure, "RampSupport", Vector3.new(1.2, p.Y, 1.2), CFrame.new(p.X, p.Y / 2 - 0.5, p.Z + 2.2), concreteWet, Enum.Material.Concrete)
			end
		end
	end
	-- landings
	kit.slab("Landing1", 140, 0, 148, 12, 15, 1, concrete)
	kit.slab("Landing2", 22, 6, 30, 18, 30, 1, concrete)
	kit.slab("Landing3", 140, 0, 152, 18, CREST, 1, concrete)
	block(structure, "LandingPost", Vector3.new(2, 15, 2), CFrame.new(147, 7, 11), concreteWet, Enum.Material.Concrete)
	block(structure, "LandingPost", Vector3.new(2, 30, 2), CFrame.new(23, 15, 17), concreteWet, Enum.Material.Concrete)
	block(structure, "LandingPost", Vector3.new(2, CREST, 2), CFrame.new(151, CREST / 2, 17), concreteWet, Enum.Material.Concrete)
	kit.railing(Vector3.new(148, 15, 0), Vector3.new(148, 15, 12))
	kit.railing(Vector3.new(140, 15, 12), Vector3.new(148, 15, 12))
	kit.railing(Vector3.new(22, 30, 6), Vector3.new(30, 30, 6))
	kit.railing(Vector3.new(22, 30, 18), Vector3.new(30, 30, 18))
	kit.railing(Vector3.new(22, 30, 6), Vector3.new(22, 30, 18))
	kit.railing(Vector3.new(152, CREST, 0), Vector3.new(152, CREST, 18))
	kit.railing(Vector3.new(140, CREST, 18), Vector3.new(152, CREST, 18))
	for i, p in { Vector3.new(144, 15, 6), Vector3.new(26, 30, 12), Vector3.new(146, CREST, 9) } do
		local post = block(outside, "RampLamp", Vector3.new(0.3, 6, 0.3), CFrame.new(p + Vector3.new(0, 3, 0)), C.SteelDark, Enum.Material.Metal)
		post.CanCollide = false
		kit.bulb(p + Vector3.new(0, 6.2, 0), C.Sodium, 22, 1.4, "CREST", i == 1)
	end
	kit.patrol(Vector3.new(85, 7.5, 3), "RAMP")
	kit.patrol(Vector3.new(85, 22.5, 9), "RAMP")
	kit.patrol(Vector3.new(85, 37, 15), "RAMP")
	kit.patrol(Vector3.new(-80, CREST, -10), "CREST")
	kit.patrol(Vector3.new(60, CREST, -10), "CREST")
	kit.patrol(Vector3.new(-60, 0, -11), "GALLERY")
	kit.patrol(Vector3.new(-120, 0, -10), "GALLERY")
	kit.patrol(Vector3.new(72, 22, -11), "INCLINE")

	---------------------------------------------------------------------------
	-- Crew building (Mannschaftstrakt): canteen | office | dorm
	---------------------------------------------------------------------------
	local wallColor = Color3.fromRGB(150, 140, 120)
	kit.slab("CrewFloor", -110, 40, -50, 100, 0, 1, Color3.fromRGB(92, 84, 66), Enum.Material.Plastic)
	kit.slab("CrewRoof", -111, 39, -49, 101, kit.H + 1.2, 1.2, Color3.fromRGB(70, 60, 54))
	local wo = { color = wallColor }
	kit.wallZ(40, -110, -50, { { -95, 6 }, { -65, 6 } }, wo) -- north (dam side): canteen + office doors
	kit.wallZ(100, -110, -50, nil, wo)
	kit.wallX(-110, 40, 100, nil, wo)
	kit.wallX(-50, 40, 100, { { 55, 6 } }, wo) -- east: office entrance
	kit.wallX(-80, 40, 100, { { 55, 6 }, { 85, 6 } }, wo) -- canteen | office/dorm
	kit.wallZ(70, -80, -50, { { -65, 6 } }, wo) -- office | dorm
	local canteenDoorN = kit.door(Vector3.new(-95, 0, 40), true, 6, false, nil, { prefix = "DC" })
	local canteenDoorI = kit.door(Vector3.new(-80, 0, 55), false, 6, false, nil, { prefix = "DC" })
	local canteenDoorD = kit.door(Vector3.new(-80, 0, 85), false, 6, false, nil, { prefix = "DC" })
	for _, d in { canteenDoorN, canteenDoorI, canteenDoorD } do
		d:SetAttribute("Canteen", true)
	end
	kit.door(Vector3.new(-65, 0, 40), true, 6, false, nil, { prefix = "DC" })
	kit.door(Vector3.new(-50, 0, 55), false, 6, false, nil, { prefix = "DC" })
	kit.door(Vector3.new(-65, 0, 70), true, 6, false, nil, { prefix = "DC" })
	-- canteen
	for z = 52, 88, 12 do
		kit.table_(CFrame.new(-100, 0, z))
		kit.bench(CFrame.new(-100, 0, z - 2.6))
		kit.bench(CFrame.new(-100, 0, z + 2.6))
		kit.table_(CFrame.new(-88, 0, z))
		kit.bench(CFrame.new(-88, 0, z - 2.6))
		kit.bench(CFrame.new(-88, 0, z + 2.6))
	end
	block(props, "Counter", Vector3.new(26, 3.6, 2.6), CFrame.new(-95, 1.8, 96), Color3.fromRGB(170, 170, 166), Enum.Material.Metal)
	for x = -106, -84, 6 do
		block(props, "Pot", Vector3.new(1.6, 1.2, 1.6), CFrame.new(x, 4.2, 96), C.SteelDark, Enum.Material.Metal)
	end
	local coffee = block(props, "CoffeeMachine", Vector3.new(2, 2.4, 1.6), CFrame.new(-84, 4.8, 96), C.Emergency:Lerp(C.SteelDark, 0.5), Enum.Material.SmoothPlastic)
	kit.interactable(coffee, "lore", "INTERACT_LOOK", "OBJECT_COFFEE", { MaxDistance = 7, LogId = "c2_coffee" })
	kit.lightGrid(-110, -80, 40, 100, "CREW", C.Warm)
	kit.vent(Vector3.new(-109.3, 1.5, 70), Vector3.new(1, 0, 0), "crew")
	kit.patrol(Vector3.new(-95, 0, 70), "CANTEEN")
	-- office (dam keeper)
	kit.desk(CFrame.new(-60, 0, 48))
	kit.deskLamp(CFrame.new(-62, 3.15, 47.5))
	kit.document(CFrame.new(-58.5, 3.2, 48) * CFrame.Angles(0, 0.3, 0), "c2_keeper_log")
	kit.document(CFrame.new(-74, 0.1, 66) * CFrame.Angles(0, -0.6, 0), "c2_correction_1")
	kit.shelf(CFrame.new(-51, 0, 62) * CFrame.Angles(0, math.rad(-90), 0))
	kit.cabinet(CFrame.new(-77, 0, 44))
	local override = kit.panel(CFrame.new(-79.4, 5, 62) * CFrame.Angles(0, math.rad(90), 0), "c2_override", "INTERACT_HOLD_OVERRIDE", "OBJECT_DOOR_OVERRIDE", { HoldDuration = 2 })
	override.Name = "CanteenOverride"
	kit.panel(CFrame.new(-50.6, 5, 64) * CFrame.Angles(0, math.rad(-90), 0), "breaker", "INTERACT_HOLD_BREAKER", "OBJECT_BREAKER", { Sector = "CREW" })
	kit.lightGrid(-80, -50, 40, 70, "CREW", C.Warm)
	kit.patrol(Vector3.new(-65, 0, 55), "OFFICE")
	-- dorm
	for x = -74, -56, 9 do
		kit.bunk(CFrame.new(x, 0, 90))
	end
	for z = 74, 82, 2.5 do
		kit.locker(CFrame.new(-52, 0, z) * CFrame.Angles(0, math.rad(-90), 0))
	end
	kit.recorder(CFrame.new(-57, 2.2, 85), "c2_dorm_tape")
	kit.lightGrid(-80, -50, 70, 100, "CREW", C.Warm)
	kit.firstAid(CFrame.new(-50.6, 5, 92) * CFrame.Angles(0, math.rad(-90), 0))
	kit.patrol(Vector3.new(-65, 0, 85), "DORM")
	kit.vent(Vector3.new(-50.7, 1.5, 78), Vector3.new(-1, 0, 0), "crew")
	-- facade: lit windows, a porch light over each door
	for _, x in { -103, -87, -73, -57 } do
		local pane = deco(structure, "Window", Vector3.new(5, 2.2, 0.15), CFrame.new(x, 9, 39.4), Color3.fromRGB(255, 214, 150), Enum.Material.Neon)
		pane.Transparency = 0.25
	end
	for _, p in { Vector3.new(-95, 11, 38.5), Vector3.new(-65, 11, 38.5), Vector3.new(-48.5, 11, 55) } do
		kit.bulb(p, C.Warm, 18, 1.2, nil, true)
	end
	kit.sign(Vector3.new(-80, 12, 39.3), Vector3.new(0, 0, -1), "SIGN_CREW")

	---------------------------------------------------------------------------
	-- Powerhouse (Turbinenhalle): hall | valve room | control booth
	---------------------------------------------------------------------------
	local ph = { color = Color3.fromRGB(128, 120, 110), h = 18 }
	kit.slab("PowerFloor", 40, 30, 130, 90, 0, 1, Color3.fromRGB(80, 84, 80))
	kit.slab("PowerRoof", 39, 29, 131, 91, 19.2, 1.2, Color3.fromRGB(60, 62, 64))
	kit.wallZ(30, 40, 130, { { 60, 8 } }, ph)
	kit.wallZ(90, 40, 130, { { 75, 10 } }, ph)
	kit.wallX(40, 30, 90, nil, ph)
	kit.wallX(130, 30, 90, nil, ph)
	kit.wallX(110, 30, 90, { { 45, 6 }, { 75, 6 } }, ph)
	kit.wallZ(60, 110, 130, nil, ph)
	kit.door(Vector3.new(60, 0, 30), true, 8, false, nil, { prefix = "DP" })
	kit.door(Vector3.new(75, 0, 90), true, 10, false, nil, { prefix = "DP" })
	kit.door(Vector3.new(110, 0, 45), false, 6, false, nil, { prefix = "DP" })
	kit.door(Vector3.new(110, 0, 75), false, 6, false, nil, { prefix = "DP" })
	-- turbines
	for i, x in { 60, 90 } do
		local gen = kit.generator(CFrame.new(x, 0, 60), i)
		gen.Size = Vector3.new(10, 7, 7)
		gen.Position = Vector3.new(x, 3.5, 60)
		local housing = block(props, "TurbineHousing", Vector3.new(12, 9, 12), CFrame.new(x, 4.5, 60) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(70, 96, 104), Enum.Material.Metal)
		housing.Shape = Enum.PartType.Cylinder
		housing.Size = Vector3.new(7, 12, 12)
		housing.CFrame = CFrame.new(x, 3.5, 70) * CFrame.Angles(0, 0, math.rad(90))
		deco(props, "TurbineRing", Vector3.new(14, 0.4, 14), CFrame.new(x, 0.1, 66), C.Hazard, Enum.Material.SmoothPlastic)
	end
	kit.pipeRun(Vector3.new(60, 16, 31), Vector3.new(60, 8, 58), 1.6, Color3.fromRGB(60, 80, 86))
	kit.pipeRun(Vector3.new(90, 16, 31), Vector3.new(90, 8, 58), 1.6, Color3.fromRGB(60, 80, 86))
	-- gantry crane
	block(props, "CraneBeam", Vector3.new(70, 1.4, 2), CFrame.new(75, 16.5, 45), C.Hazard, Enum.Material.Metal)
	block(props, "CraneBeam", Vector3.new(70, 1.4, 2), CFrame.new(75, 16.5, 75), C.Hazard, Enum.Material.Metal)
	block(props, "CraneBridge", Vector3.new(2, 1.4, 30), CFrame.new(70, 15.5, 60), C.Hazard:Lerp(C.SteelDark, 0.3), Enum.Material.Metal)
	kit.lightGrid(40, 110, 30, 90, "POWER", C.Fluorescent, 0, 18)
	kit.panel(CFrame.new(40.6, 5, 80) * CFrame.Angles(0, math.rad(90), 0), "breaker", "INTERACT_HOLD_BREAKER", "OBJECT_BREAKER", { Sector = "POWER" })
	kit.patrol(Vector3.new(75, 0, 45), "TURBINE")
	kit.patrol(Vector3.new(75, 0, 80), "TURBINE")
	kit.vent(Vector3.new(40.7, 1.5, 50), Vector3.new(1, 0, 0), "power")
	-- valve room (forecast: close the bottom outlet)
	kit.wheel(CFrame.new(122, 0, 40), "c2_valve", "INTERACT_TURN", "OBJECT_VALVE", { HoldDuration = 3 })
	kit.pipeRun(Vector3.new(112, 2, 34), Vector3.new(128, 2, 34), 1.1, Color3.fromRGB(90, 50, 40))
	kit.lightGrid(110, 130, 30, 60, "POWER", C.Fluorescent, 0, 18)
	kit.patrol(Vector3.new(120, 0, 45), "VALVE")
	kit.vent(Vector3.new(129.3, 1.5, 52), Vector3.new(-1, 0, 0), "power")
	-- control booth
	kit.console(CFrame.new(120, 0, 85))
	kit.document(CFrame.new(116, 3.25, 66) * CFrame.Angles(0, -0.2, 0), "c2_correction_2")
	kit.desk(CFrame.new(116, 0, 66))
	local damRelay = kit.panel(CFrame.new(129.4, 5, 64) * CFrame.Angles(0, math.rad(-90), 0), "dam_relay", "INTERACT_INSERT", "OBJECT_DAM_RELAY", { HoldDuration = 3 }, C.Steel)
	damRelay.Name = "DamRelay"
	kit.interactable(block(props, "StationBooth", Vector3.new(2, 3, 2), CFrame.new(127, 1.5, 70), C.Steel, Enum.Material.Metal), "dam_station_1", "INTERACT_ACTIVATE", "OBJECT_STATION", { MaxDistance = 8 })
	kit.lightGrid(110, 130, 60, 90, "POWER", C.Fluorescent, 0, 18)
	kit.firstAid(CFrame.new(129.4, 5, 80) * CFrame.Angles(0, math.rad(-90), 0))
	-- facade
	for x = 48, 124, 12 do
		local pane = deco(structure, "Window", Vector3.new(6, 3, 0.15), CFrame.new(x, 14, 90.6), if x % 24 == 0 then Color3.fromRGB(220, 236, 255) else Color3.fromRGB(30, 36, 42), if x % 24 == 0 then Enum.Material.Neon else Enum.Material.Glass)
		pane.Transparency = 0.2
	end
	kit.sign(Vector3.new(75, 15, 90.7), Vector3.new(0, 0, 1), "SIGN_POWERHOUSE")
	kit.floodLight(Vector3.new(42, 17, 92), Vector3.new(20, 0, 130), C.Sodium, 70)

	-- security lock keys (survival): turbine control booth + valve room
	kit.syncKey(CFrame.new(129.4, 4.5, 84) * CFrame.Angles(0, math.rad(-90), 0), 1)
	kit.syncKey(CFrame.new(129.4, 4.5, 34) * CFrame.Angles(0, math.rad(-90), 0), 2)

	-- station 3 + breaker in the gallery (survival)
	kit.interactable(block(props, "StationGallery", Vector3.new(2, 3, 2), CFrame.new(-60, 1.5, -13), C.Steel, Enum.Material.Metal), "dam_station_3", "INTERACT_ACTIVATE", "OBJECT_STATION", { MaxDistance = 8 })
	kit.panel(CFrame.new(-90, 4.5, -13.4), "breaker", "INTERACT_HOLD_BREAKER", "OBJECT_BREAKER", { Sector = "GALLERY" })

	---------------------------------------------------------------------------
	-- Valley: road, barrier (start), van, floodlights, forest
	---------------------------------------------------------------------------
	kit.previewGround(Vector3.new(0, -0.62, 120), Vector3.new(700, 1, 280))
	local lakePreview = block(outside, "EditPreviewLake", Vector3.new(700, 1, 380), CFrame.new(0, LAKE - 0.5, -210), Color3.fromRGB(30, 46, 56), Enum.Material.Glass)
	lakePreview:SetAttribute("FZ_EditPreview", true)
	lakePreview.CanCollide = false
	block(outside, "Road", Vector3.new(14, 1, 270), CFrame.new(0, -0.45, 140), C.Asphalt, Enum.Material.Asphalt)
	block(outside, "Yard", Vector3.new(220, 1, 26), CFrame.new(0, -0.45, 20), C.Asphalt, Enum.Material.Asphalt)
	block(outside, "CrewPath", Vector3.new(10, 1, 70), CFrame.new(-40, -0.45, 60), C.Asphalt, Enum.Material.Asphalt)
	for z = 50, 260, 10 do
		deco(outside, "RoadMark", Vector3.new(0.4, 0.05, 4), CFrame.new(0, 0.06, z), Color3.fromRGB(210, 206, 190), Enum.Material.SmoothPlastic)
	end
	-- barrier + booth at the start
	block(outside, "BarrierBox", Vector3.new(1.4, 3.6, 1.4), CFrame.new(9, 1.8, 205), C.Hazard, Enum.Material.Metal)
	for i = 0, 5 do
		deco(outside, "BarrierArm", Vector3.new(0.5, 2.4, 0.5), CFrame.new(9, 3.6, 205) * CFrame.Angles(0, 0, math.rad(80)) * CFrame.new(0, 1.2 + i * 2.4, 0), if i % 2 == 0 then Color3.fromRGB(200, 40, 34) else Color3.fromRGB(230, 230, 225), Enum.Material.SmoothPlastic)
	end
	local van = block(outside, "Van", Vector3.new(7, 7, 15), CFrame.new(-12, 3.6, 222) * CFrame.Angles(0, math.rad(-6), 0), Color3.fromRGB(150, 150, 140), Enum.Material.Metal)
	kit.interactable(van, "dam_extract", "INTERACT_LEAVE", "OBJECT_VAN", { HoldDuration = 2, MaxDistance = 10 })
	kit.bulb(Vector3.new(9, 6, 205), C.Sodium, 24, 1.6, nil, true)
	kit.sign(Vector3.new(-9, 5, 200), Vector3.new(0, 0, 1), "SIGN_DAM_ACCESS", nil, Vector3.new(7, 3, 0.2))
	for z = 40, 190, 30 do
		local post = block(outside, "LampPost", Vector3.new(0.5, 12, 0.5), CFrame.new(9, 6, z), C.SteelDark, Enum.Material.Metal)
		post.CanCollide = false
		kit.bulb(Vector3.new(8, 12, z), C.Sodium, 30, 1.8, "YARD", z % 60 == 40)
	end
	kit.floodLight(Vector3.new(-30, 30, 4), Vector3.new(-30, 0, 40), C.Fluorescent, 60)
	kit.floodLight(Vector3.new(0, 12, 6), Vector3.new(0, 0, 30), C.Fluorescent, 40)
	kit.forest(140, -330, 330, 60, 380, { { -120, 30, 140, 110 }, { -20, 100, 20, 400 }, { -40, 180, 40, 260 }, { -75, 120, 0, 185 } }, 0.15)
	for _ = 1, 30 do
		local x, z = kit.rng:NextNumber(-250, 250), kit.rng:NextNumber(10, 260)
		if not (x > -120 and x < 140 and z < 110) and math.abs(x) > 14 then
			kit.rock(Vector3.new(x, 0, z), kit.rng:NextNumber(1.5, 5))
		end
	end
	kit.patrol(Vector3.new(0, 0, 25), "YARD")
	kit.patrol(Vector3.new(-30, 0, 120), "YARD")
	kit.patrol(Vector3.new(60, 0, 110), "YARD")
	kit.vent(Vector3.new(-3.3, 1.5, -6), Vector3.new(1, 0, 0), "dam")
	kit.vent(Vector3.new(125, CREST + 1.5, -18.3), Vector3.new(0, 0, 1), "dam")

	---------------------------------------------------------------------------
	-- Markers: checkpoints, spawn, creature, items, fuses, speakers, menu shots
	---------------------------------------------------------------------------
	kit.checkpoint("C2_START", CFrame.new(0, 0.5, 232))
	kit.checkpoint("C2_VALLEY", CFrame.new(-40, 0.5, 30))
	kit.checkpoint("C2_POWER", CFrame.new(75, 0.5, 100))
	kit.checkpoint("CP_SV_DAM", CFrame.new(75, 0.5, 80))
	kit.spawnLocation(CFrame.new(0, 0.5, 290))
	kit.creatureSpawn(CFrame.new(-121, 3, -10))
	for _, cf in {
		CFrame.new(-100, 3.45, 64), CFrame.new(-88, 3.45, 88), CFrame.new(-60, 3.45, 49), CFrame.new(-65, 2.2, 90),
		CFrame.new(58, 0.4, 42), CFrame.new(100, 0.4, 84), CFrame.new(124, 0.4, 54), CFrame.new(-118, 3.45, -14),
		CFrame.new(-30, 0.4, -12), CFrame.new(130, CREST + 0.4, -4), CFrame.new(-12, CREST + 0.4, -30), CFrame.new(144, 15.4, 4),
	} do
		kit.itemSpot(cf)
	end
	for _, f in {
		{ CFrame.new(-106, 0.4, 98), "CREW" }, { CFrame.new(-56, 3.45, 47), "CREW" },
		{ CFrame.new(46, 0.4, 86), "POWER" }, { CFrame.new(126, 3.45, 86), "POWER" },
		{ CFrame.new(-100, 0.4, -12), "GALLERY" }, { CFrame.new(-125, 0.4, -6), "GALLERY" },
		{ CFrame.new(136, CREST + 0.4, -17), "CREST" }, { CFrame.new(20, CREST + 0.4, -40), "CREST" },
	} do
		kit.fuseSpot(f[1], f[2])
	end
	for _, sp in {
		{ Vector3.new(-80, 12.5, 41), Vector3.new(0, 0, 1) }, { Vector3.new(75, 16, 31), Vector3.new(0, 0, 1) },
		{ Vector3.new(-50, 8, -13.2), Vector3.new(0, 0, 1) }, { Vector3.new(132, CREST + 10, -18.2), Vector3.new(0, 0, 1) },
	} do
		kit.speaker(sp[1], sp[2])
	end
	kit.menuCamera(1, Vector3.new(-40, 6, 150), Vector3.new(10, 26, 0), 8)
	kit.menuCamera(2, Vector3.new(-60, CREST + 7, -6), Vector3.new(0, CREST + 14, -34), 5)
	kit.menuCamera(3, Vector3.new(100, 8, 86), Vector3.new(60, 4, 58), 5)
	kit.menuCamera(4, Vector3.new(160, 30, 70), Vector3.new(60, 22, 0), 9)

	-- finishing pass
	local model = kit.root
	MapDress.Walls(model, { lower = Color3.fromRGB(78, 88, 84), rail = Color3.fromRGB(60, 64, 66), skirting = Color3.fromRGB(26, 26, 26) })
	MapDress.LightCones(model, { "FloodLight" }, 46)
	MapDress.Mist(model, Vector3.new(0, LAKE, -90), Vector3.new(300, 0, 90), Color3.fromRGB(150, 160, 175), 1.4) -- over the lake
	MapDress.Mist(model, Vector3.new(-10, 0, 140), Vector3.new(220, 0, 120))
	MapDress.Mist(model, Vector3.new(0, 0, 30), Vector3.new(260, 0, 40), nil, 0.7) -- spray at the foot of the dam
	MapDress.Steam(model, Vector3.new(60, 16, 31.6), Vector3.new(0, 0, 1))
	MapDress.Steam(model, Vector3.new(90, 16, 31.6), Vector3.new(0, 0, 1))
	MapDress.Steam(model, Vector3.new(0, 8.5, -6), Vector3.new(0, -0.2, 1), Color3.fromRGB(180, 190, 200)) -- breath of the gallery
	MapDress.Puddles(model, {
		{ -20, -10, 8, 3, CREST }, { 40, -6, 6, 4, CREST }, { -90, -12, 9, 3, CREST }, { 0, -30, 7, 5, CREST },
		{ 4, 60, 6, 4 }, { -6, 120, 8, 5 }, { 5, 175, 5, 3 }, { -40, 30, 9, 4 }, { 75, 98, 7, 4 }, { 95, 20, 6, 3 },
	})
	MapDress.Flicker(model, 0.15, 33)
	-- materials: tiled canteen, wet crest
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") then
			if d.Name == "CrewFloor" then
				d.Material = Enum.Material.CeramicTiles
				d.Color = Color3.fromRGB(150, 146, 134)
			elseif d.Name == "Crest" or d.Name == "YardPlatform" or d.Name == "Landing1" or d.Name == "Landing2" or d.Name == "Landing3" then
				d.Material = Enum.Material.Pavement
			end
		end
	end

	return kit.finish()
end

function Map.BuildTerrain(model: Instance?)
	local terrain = workspace.Terrain
	-- valley floor and the lake basin
	terrain:FillBlock(CFrame.new(0, -5.1, 150), Vector3.new(900, 10, 320), Enum.Material.Grass)
	terrain:FillBlock(CFrame.new(0, -6, -230), Vector3.new(900, 12, 420), Enum.Material.Mud)
	terrain:FillBlock(CFrame.new(0, LAKE / 2, -230), Vector3.new(900, LAKE, 420), Enum.Material.Water)
	-- valley flanks (they hold the lake), with rock faces near the dam
	for _, side in { -1, 1 } do
		terrain:FillBlock(CFrame.new(side * 290, 26, -150), Vector3.new(270, 64, 560), Enum.Material.Grass)
		terrain:FillBlock(CFrame.new(side * 170, 30, -12), Vector3.new(36, 60, 50), Enum.Material.Rock)
		terrain:FillWedge(CFrame.new(side * 290, 16, 175) * CFrame.Angles(0, if side < 0 then math.rad(180) else 0, 0), Vector3.new(270, 44, 90), Enum.Material.Grass)
	end
	local patches = Random.new(17)
	for _ = 1, 20 do
		local x, z = patches:NextNumber(-380, 380), patches:NextNumber(110, 400)
		if math.abs(x) > 20 then
			terrain:FillBall(Vector3.new(x, -2.4, z), patches:NextNumber(10, 24), if patches:NextNumber() < 0.5 then Enum.Material.LeafyGrass else Enum.Material.Ground)
		end
	end
	terrain.WaterWaveSize = 0.4
	terrain.WaterWaveSpeed = 14
	terrain.WaterColor = Color3.fromRGB(26, 40, 46)
	terrain.WaterTransparency = 0.6
	MapDress.TerrainLook({
		Grass = Color3.fromRGB(56, 70, 50),
		LeafyGrass = Color3.fromRGB(50, 64, 44),
		Ground = Color3.fromRGB(70, 62, 52),
		Mud = Color3.fromRGB(46, 42, 36),
		Rock = Color3.fromRGB(86, 88, 86),
	})
	MapKit.ApplyClouds("storm")
	MapKit.RemovePreview(model)
end

function Map.ApplyLighting()
	MapKit.ApplyLighting("storm")
end

function Map.Build(): Model
	local model = build()
	Map.ApplyLighting()
	if not Map.SkipTerrain then
		Map.BuildTerrain(model)
	end
	return model
end

return Map
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">MapDress</string>
            <string name="Source"><![CDATA[-- MapDress: a visual finishing pass for script-built maps. Runs after a builder, adds no
-- gameplay. Only built-in materials/textures - no uploaded assets needed.
--   * two-tone walls with dado rail + skirting (institutional paint)
--   * fake volumetric light cones under outdoor lamps and flood lights (Beams)
--   * ground mist and steam (ParticleEmitters, built-in smoke texture)
--   * puddles (reflective, wet look in the storm)
--   * a few flickering fluorescent tubes (client side, see AtmosphereController)
--   * terrain look: grass blades, muted material colours
-- Clients scale or switch the effects off per graphics profile (tags FZ_LightCone, FZ_Mist).

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local MapDress = {}

local SMOKE = "rbxasset://textures/particles/smoke_main.dds"

local function part(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function folderIn(model: Instance, name: string): Folder
	local f = model:FindFirstChild(name)
	if not f then
		f = Instance.new("Folder")
		f.Name = name
		f.Parent = model
	end
	return f :: Folder
end

---------------------------------------------------------------------------
-- Walls: lower paint band, dado rail and skirting on both faces of every wall segment
---------------------------------------------------------------------------
export type WallStyle = { lower: Color3, rail: Color3, skirting: Color3, height: number?, minLength: number?, material: Enum.Material?, skip: { Enum.Material }? }

function MapDress.Walls(model: Instance, style: WallStyle, folderName: string?)
	local walls = model:FindFirstChild(folderName or "Walls")
	if not walls then
		return
	end
	local out = folderIn(model, "WallTrim")
	local band = style.height or 4.2
	for _, wall in walls:GetChildren() do
		if wall:IsA("BasePart") and wall.Name == "Wall" and not table.find(style.skip or {}, wall.Material) then
			local size = wall.Size
			local alongX = size.X >= size.Z
			local length = if alongX then size.X else size.Z
			local thickness = if alongX then size.Z else size.X
			if length >= (style.minLength or 2) and size.Y >= 6 then
				local bottom = wall.CFrame.Position.Y - size.Y / 2
				for _, side in { -1, 1 } do
					local offset = side * (thickness / 2 + 0.06)
					local function strip(name: string, height: number, y: number, depth: number, color: Color3, material: Enum.Material)
						local s = if alongX then Vector3.new(length, height, depth) else Vector3.new(depth, height, length)
						local center = wall.CFrame.Position
						local pos = if alongX then Vector3.new(center.X, bottom + y, center.Z + offset) else Vector3.new(center.X + offset, bottom + y, center.Z)
						part(out, name, s, CFrame.new(pos), color, material)
					end
					strip("PaintBand", band, band / 2, 0.08, style.lower, style.material or Enum.Material.Plaster)
					strip("DadoRail", 0.22, band + 0.05, 0.18, style.rail, Enum.Material.Wood)
					strip("Skirting", 0.5, 0.25, 0.2, style.skirting, Enum.Material.SmoothPlastic)
				end
			end
		end
	end
end

---------------------------------------------------------------------------
-- Light cones: a soft, additive beam from a lamp along its light direction
---------------------------------------------------------------------------
local function cone(lamp: BasePart, direction: Vector3, length: number, spread: number, color: Color3, strength: number?)
	local a0 = Instance.new("Attachment")
	a0.Name = "ConeStart"
	a0.Parent = lamp
	local a1 = Instance.new("Attachment")
	a1.Name = "ConeEnd"
	a1.Parent = lamp
	-- attachments live in the lamp's space
	a1.Position = lamp.CFrame:PointToObjectSpace(lamp.CFrame.Position + direction.Unit * length)
	local beam = Instance.new("Beam")
	beam.Name = "LightCone"
	beam.Attachment0 = a0
	beam.Attachment1 = a1
	beam.Width0 = 1.2
	beam.Width1 = math.clamp(spread, 4, 26)
	beam.FaceCamera = true
	beam.Segments = 1
	beam.Texture = ""
	beam.LightEmission = 1
	beam.LightInfluence = 0
	beam.Color = ColorSequence.new(color)
	local s = strength or 0.82
	beam.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, s),
		NumberSequenceKeypoint.new(0.6, math.min(1, s + 0.1)),
		NumberSequenceKeypoint.new(1, 1),
	})
	beam.Parent = lamp
	CollectionService:AddTag(beam, "FZ_LightCone")
	return beam
end

-- Every SpotLight on a lamp whose name is in `names` gets a cone in its light direction.
function MapDress.LightCones(model: Instance, names: { string }, maxLength: number?)
	for _, lamp in model:GetDescendants() do
		if lamp:IsA("BasePart") and table.find(names, lamp.Name) then
			local light = lamp:FindFirstChildWhichIsA("SpotLight")
			if light then
				local cf = lamp.CFrame
				local direction = if light.Face == Enum.NormalId.Bottom then -cf.UpVector
					elseif light.Face == Enum.NormalId.Front then cf.LookVector
					elseif light.Face == Enum.NormalId.Top then cf.UpVector
					else -cf.UpVector
				local length = math.min(maxLength or 34, light.Range * 0.8)
				if direction.Y < -0.5 then
					length = math.min(length, cf.Position.Y + 0.5) -- down to the ground
				end
				local spread = length * math.tan(math.rad(math.min(light.Angle, 100) / 2)) * 1.4
				cone(lamp, direction, length, spread, light.Color, if direction.Y < -0.5 then 0.8 else 0.86)
			end
		end
	end
end

-- Moonlight through a window: a long pale shaft from outside down into the room.
function MapDress.Shaft(lamp: BasePart, to: Vector3, width: number, color: Color3)
	local direction = to - lamp.CFrame.Position
	cone(lamp, direction, direction.Magnitude, width, color, 0.9)
end

---------------------------------------------------------------------------
-- Mist, steam, puddles
---------------------------------------------------------------------------
-- Low drifting ground mist over an area (one emitter part per call).
function MapDress.Mist(model: Instance, center: Vector3, size: Vector3, color: Color3?, density: number?)
	local holder = part(folderIn(model, "Atmosphere"), "MistArea", Vector3.new(size.X, 1, size.Z), CFrame.new(center + Vector3.new(0, 0.6, 0)), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	holder.Transparency = 1
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Mist"
	emitter.Texture = SMOKE
	emitter.Color = ColorSequence.new(color or Color3.fromRGB(170, 180, 195))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 10), NumberSequenceKeypoint.new(1, 18) })
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.3, 0.88),
		NumberSequenceKeypoint.new(0.7, 0.9),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Lifetime = NumberRange.new(14, 22)
	emitter.Rate = (density or 1) * math.clamp(size.X * size.Z / 900, 0.5, 6)
	emitter.Speed = NumberRange.new(0.4, 1.2)
	emitter.SpreadAngle = Vector2.new(180, 10)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-6, 6)
	emitter.LightInfluence = 0.8
	emitter.LightEmission = 0
	emitter.Acceleration = Vector3.new(0.3, 0, 0.15)
	emitter.Shape = Enum.ParticleEmitterShape.Box
	emitter.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	emitter:SetAttribute("BaseRate", emitter.Rate)
	emitter.Parent = holder
	CollectionService:AddTag(emitter, "FZ_Mist")
	return holder
end

-- A thin column of steam (pipes, shafts, the Array).
function MapDress.Steam(model: Instance, position: Vector3, direction: Vector3?, color: Color3?)
	local holder = part(folderIn(model, "Atmosphere"), "SteamSource", Vector3.new(0.6, 0.6, 0.6), CFrame.lookAt(position, position + (direction or Vector3.yAxis)), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic)
	holder.Transparency = 1
	local emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Steam"
	emitter.Texture = SMOKE
	emitter.Color = ColorSequence.new(color or Color3.fromRGB(210, 214, 220))
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 5) })
	emitter.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 1) })
	emitter.Lifetime = NumberRange.new(2.5, 4)
	emitter.Rate = 6
	emitter.Speed = NumberRange.new(2, 4)
	emitter.SpreadAngle = Vector2.new(12, 12)
	emitter.EmissionDirection = Enum.NormalId.Front
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-20, 20)
	emitter.LightInfluence = 0.9
	emitter:SetAttribute("BaseRate", emitter.Rate)
	emitter.Parent = holder
	CollectionService:AddTag(emitter, "FZ_Mist")
	return holder
end

-- Flat reflective puddles at the given rectangles { { x, z, sizeX, sizeZ, y? } }.
function MapDress.Puddles(model: Instance, list: { { number } })
	local out = folderIn(model, "Puddles")
	for i, p in list do
		local puddle = part(out, "Puddle", Vector3.new(p[3], 0.04, p[4]), CFrame.new(p[1], (p[5] or 0) + 0.06, p[2]) * CFrame.Angles(0, (i * 1.7) % 3, 0), Color3.fromRGB(26, 30, 34), Enum.Material.Glass)
		puddle.Transparency = 0.25
		puddle.Reflectance = 0.35
	end
end

-- A share of decorative fluorescent fixtures flickers now and then (client side).
function MapDress.Flicker(model: Instance, share: number, seed: number)
	local rng = Random.new(seed)
	for _, fixture in model:GetDescendants() do
		if fixture:IsA("BasePart") and string.sub(fixture.Name, 1, 8) == "Fixture_" and rng:NextNumber() < share then
			CollectionService:AddTag(fixture, "FZ_Flicker")
		end
	end
end

---------------------------------------------------------------------------
-- Terrain + lighting quality (runtime only: terrain cannot be baked)
---------------------------------------------------------------------------
function MapDress.TerrainLook(colors: { [string]: Color3 }?)
	local terrain = workspace.Terrain
	pcall(function()
		(terrain :: any).Decoration = true -- animated grass blades on Grass
	end)
	local palette = colors or {
		Grass = Color3.fromRGB(64, 78, 52),
		LeafyGrass = Color3.fromRGB(58, 70, 46),
		Ground = Color3.fromRGB(78, 68, 56),
		Mud = Color3.fromRGB(58, 50, 42),
		Rock = Color3.fromRGB(96, 94, 90),
	}
	for name, color in palette do
		pcall(function()
			terrain:SetMaterialColor((Enum.Material :: any)[name], color)
		end)
	end
end

function MapDress.LightingQuality()
	pcall(function()
		(Lighting :: any).LightingStyle = Enum.LightingStyle.Realistic
	end)
	pcall(function()
		(Lighting :: any).PrioritizeLightingQuality = true
	end)
end

return MapDress
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">MapKit</string>
            <string name="Source"><![CDATA[-- MapKit: shared building blocks for script-built maps (Staumauer 3, Kapelle, Mine).
-- Every gameplay object follows docs/MAP_CONTRACT.md (tags + attributes), so any piece
-- can later be replaced by a hand-built Studio model.
--
--   local kit = MapKit.new("FZ_Dam03", "Dam03", 303)
--   kit.room(...); kit.door(...); kit.checkpoint(...)
--   return kit.finish()
--
-- Positions are world positions; walls/rooms take an optional floor height `y`.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local MapKit = {}

type WallOptions = { y: number?, h: number?, doorH: number?, color: Color3?, material: Enum.Material?, t: number? }

MapKit.C = {
	Concrete = Color3.fromRGB(104, 104, 100),
	ConcreteDark = Color3.fromRGB(64, 66, 66),
	Floor = Color3.fromRGB(78, 74, 66),
	Steel = Color3.fromRGB(64, 84, 82),
	SteelDark = Color3.fromRGB(42, 48, 50),
	Wood = Color3.fromRGB(82, 62, 44),
	WoodDark = Color3.fromRGB(52, 38, 28),
	Plastic = Color3.fromRGB(190, 184, 170),
	Paper = Color3.fromRGB(226, 220, 204),
	Sodium = Color3.fromRGB(255, 170, 96),
	Fluorescent = Color3.fromRGB(214, 236, 230),
	Warm = Color3.fromRGB(255, 206, 150),
	Candle = Color3.fromRGB(255, 176, 92),
	Emergency = Color3.fromRGB(200, 40, 30),
	Screen = Color3.fromRGB(90, 220, 140),
	Asphalt = Color3.fromRGB(36, 38, 40),
	Pine = Color3.fromRGB(28, 44, 34),
	Bark = Color3.fromRGB(52, 40, 32),
	Rock = Color3.fromRGB(70, 66, 62),
	RockDark = Color3.fromRGB(46, 43, 40),
	Stone = Color3.fromRGB(124, 120, 112),
	Hazard = Color3.fromRGB(214, 170, 40),
}
local C = MapKit.C

-- Lighting presets. Every preset sets the full property list, so switching maps never
-- leaves a property of the previous map behind.
MapKit.Lighting = {
	storm = {
		ClockTime = 0.2, Brightness = 1.2, ExposureCompensation = 0.4,
		Ambient = Color3.fromRGB(36, 40, 48), OutdoorAmbient = Color3.fromRGB(70, 80, 96),
		ColorShift_Top = Color3.fromRGB(120, 140, 170), ColorShift_Bottom = Color3.fromRGB(18, 20, 26),
		EnvironmentDiffuseScale = 0.5, EnvironmentSpecularScale = 1, ShadowSoftness = 0.3,
		Atmosphere = { Density = 0.38, Offset = 0.02, Color = Color3.fromRGB(120, 132, 150), Decay = Color3.fromRGB(56, 64, 80), Glare = 0, Haze = 2.2 },
		Sky = { StarCount = 0, MoonAngularSize = 0, CelestialBodiesShown = false },
		Clouds = { Cover = 0.9, Density = 0.75, Color = Color3.fromRGB(46, 52, 62) },
	},
	chapel = {
		ClockTime = 23.2, Brightness = 1.4, ExposureCompensation = 0.35,
		Ambient = Color3.fromRGB(40, 40, 46), OutdoorAmbient = Color3.fromRGB(84, 90, 108),
		ColorShift_Top = Color3.fromRGB(170, 175, 200), ColorShift_Bottom = Color3.fromRGB(22, 22, 28),
		EnvironmentDiffuseScale = 0.6, EnvironmentSpecularScale = 0.8, ShadowSoftness = 0.25,
		Atmosphere = { Density = 0.42, Offset = 0.1, Color = Color3.fromRGB(150, 156, 170), Decay = Color3.fromRGB(80, 84, 100), Glare = 0.1, Haze = 2.6 },
		Sky = { StarCount = 1500, MoonAngularSize = 18, CelestialBodiesShown = true },
		Clouds = { Cover = 0.5, Density = 0.35, Color = Color3.fromRGB(80, 86, 100) },
	},
	mine = {
		ClockTime = 4.6, Brightness = 1.3, ExposureCompensation = 0.3,
		Ambient = Color3.fromRGB(34, 32, 30), OutdoorAmbient = Color3.fromRGB(80, 86, 104),
		ColorShift_Top = Color3.fromRGB(160, 150, 140), ColorShift_Bottom = Color3.fromRGB(22, 20, 18),
		EnvironmentDiffuseScale = 0.55, EnvironmentSpecularScale = 0.9, ShadowSoftness = 0.2,
		Atmosphere = { Density = 0.3, Offset = 0.05, Color = Color3.fromRGB(140, 140, 150), Decay = Color3.fromRGB(70, 72, 86), Glare = 0.1, Haze = 1.4 },
		Sky = { StarCount = 2500, MoonAngularSize = 10, CelestialBodiesShown = true },
		Clouds = { Cover = 0.4, Density = 0.3, Color = Color3.fromRGB(70, 76, 90) },
	},
	dawn = {
		ClockTime = 6.4, Brightness = 2, ExposureCompensation = 0.2,
		Ambient = Color3.fromRGB(70, 62, 60), OutdoorAmbient = Color3.fromRGB(150, 130, 120),
		ColorShift_Top = Color3.fromRGB(255, 200, 160), ColorShift_Bottom = Color3.fromRGB(40, 34, 40),
		EnvironmentDiffuseScale = 0.8, EnvironmentSpecularScale = 1, ShadowSoftness = 0.2,
		Atmosphere = { Density = 0.3, Offset = 0.1, Color = Color3.fromRGB(230, 190, 170), Decay = Color3.fromRGB(140, 110, 120), Glare = 0.6, Haze = 1.4 },
		Sky = { StarCount = 0, MoonAngularSize = 0, CelestialBodiesShown = true },
		Clouds = { Cover = 0.45, Density = 0.3, Color = Color3.fromRGB(230, 200, 190) },
	},
	day = {
		ClockTime = 13, Brightness = 2.6, ExposureCompensation = 0,
		Ambient = Color3.fromRGB(90, 90, 92), OutdoorAmbient = Color3.fromRGB(150, 150, 150),
		ColorShift_Top = Color3.fromRGB(255, 245, 230), ColorShift_Bottom = Color3.fromRGB(60, 60, 64),
		EnvironmentDiffuseScale = 1, EnvironmentSpecularScale = 1, ShadowSoftness = 0.15,
		Atmosphere = { Density = 0.25, Offset = 0.05, Color = Color3.fromRGB(200, 210, 230), Decay = Color3.fromRGB(110, 130, 160), Glare = 0.3, Haze = 0.8 },
		Sky = { StarCount = 0, MoonAngularSize = 0, CelestialBodiesShown = true },
		Clouds = { Cover = 0.35, Density = 0.25, Color = Color3.fromRGB(240, 240, 245) },
	},
}

function MapKit.ApplyLighting(name: string)
	local preset = MapKit.Lighting[name]
	if not preset then
		return
	end
	for key, value in preset do
		if type(value) ~= "table" then
			(Lighting :: any)[key] = value
		end
	end
	Lighting.GlobalShadows = true
	pcall(function()
		(Lighting :: any).LightingStyle = Enum.LightingStyle.Realistic
		;(Lighting :: any).PrioritizeLightingQuality = true
	end)
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	for key, value in preset.Atmosphere do
		(atmosphere :: any)[key] = value
	end
	atmosphere.Parent = Lighting
	local sky = Lighting:FindFirstChildOfClass("Sky") or Instance.new("Sky")
	for key, value in preset.Sky do
		(sky :: any)[key] = value
	end
	sky.Parent = Lighting
end

-- Clouds live under Terrain (set together with the terrain at load time).
function MapKit.ApplyClouds(name: string)
	local preset = MapKit.Lighting[name]
	if not preset or not preset.Clouds then
		return
	end
	local terrain = workspace.Terrain
	local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	for key, value in preset.Clouds do
		(clouds :: any)[key] = value
	end
	clouds.Parent = terrain
end

-- Removes the edit-mode stand-in ground once real terrain exists.
function MapKit.RemovePreview(model: Instance?)
	if not model then
		return
	end
	for _, part in model:GetDescendants() do
		if part:IsA("BasePart") and part:GetAttribute("FZ_EditPreview") then
			part:Destroy()
		end
	end
end

function MapKit.new(modelName: string, builderName: string, seed: number)
	local kit: any = {}
	local root = Instance.new("Model")
	root.Name = modelName
	root:SetAttribute("FZ_Builder", builderName)
	kit.root = root
	kit.rng = Random.new(seed)
	kit.C = C
	kit.H = 14
	kit.DOOR_H = 10
	kit.T = 1
	local rng = kit.rng

	local folders: { [string]: Folder } = {}
	function kit.folder(name: string): Folder
		if not folders[name] then
			local f = Instance.new("Folder")
			f.Name = name
			f.Parent = root
			folders[name] = f
		end
		return folders[name]
	end

	function kit.block(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
		local p = Instance.new("Part")
		p.Name = name
		p.Anchored = true
		p.Size = size
		p.CFrame = cframe
		p.Color = color
		p.Material = material or Enum.Material.SmoothPlastic
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = parent
		return p
	end
	local block = kit.block

	function kit.deco(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
		local p = block(parent, name, size, cframe, color, material)
		p.CanCollide = false
		p.CanQuery = false
		return p
	end

	function kit.tag(instance: Instance, tagName: string, attributes: { [string]: any }?)
		for key, value in attributes or {} do
			instance:SetAttribute(key, value)
		end
		CollectionService:AddTag(instance, tagName)
	end
	local tag = kit.tag

	function kit.marker(name: string, cf: CFrame): Part
		local p = block(kit.folder("Markers"), name, Vector3.new(1, 1, 1), cf, C.Concrete)
		p.Transparency = 1
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		return p
	end

	function kit.worldText(target: BasePart, face: Enum.NormalId, key: string?, staticText: string?, params: { [string]: string }?, color: Color3?, font: Enum.Font?)
		local gui = Instance.new("SurfaceGui")
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 40
		gui.LightInfluence = 1
		gui.AutoLocalize = false
		gui.Parent = target
		local label = Instance.new("TextLabel")
		label.BackgroundTransparency = 1
		label.Size = UDim2.fromScale(1, 1)
		label.FontFace = Font.fromEnum(font or Enum.Font.RobotoMono)
		label.TextScaled = true
		label.TextWrapped = true
		label.TextColor3 = color or Color3.fromRGB(30, 28, 26)
		label.Text = staticText or ""
		label.AutoLocalize = false
		local padding = Instance.new("UIPadding")
		padding.PaddingLeft = UDim.new(0.06, 0)
		padding.PaddingRight = UDim.new(0.06, 0)
		padding.PaddingTop = UDim.new(0.1, 0)
		padding.PaddingBottom = UDim.new(0.1, 0)
		padding.Parent = label
		if key then
			label:SetAttribute("LocKey", key)
			for name, value in params or {} do
				label:SetAttribute("LocParam_" .. name, value)
			end
			CollectionService:AddTag(label, "FZ_WorldText")
		end
		label.Parent = gui
		return label
	end

	-----------------------------------------------------------------------
	-- Structure: walls with door gaps, slabs, rooms, ramps, railings
	-----------------------------------------------------------------------
	local function segments(a: number, b: number, gaps: { { number } }?): { { any } }
		local list = {}
		local cursor = a
		local sorted = table.clone(gaps or {})
		table.sort(sorted, function(x, y)
			return x[1] < y[1]
		end)
		for _, gap in sorted do
			local g0, g1 = gap[1] - gap[2] / 2, gap[1] + gap[2] / 2
			if g0 > cursor then
				table.insert(list, { cursor, g0, false })
			end
			table.insert(list, { g0, g1, true })
			cursor = g1
		end
		if cursor < b then
			table.insert(list, { cursor, b, false })
		end
		return list
	end

	-- Wall along X at constant z (gaps = { { centerX, width } }).
	function kit.wallZ(z: number, x0: number, x1: number, gaps: { { number } }?, o: WallOptions?)
		o = o or {}
		local y, h, dh, t = o.y or 0, o.h or kit.H, o.doorH or kit.DOOR_H, o.t or kit.T
		local walls = kit.folder("Walls")
		for _, s in segments(x0, x1, gaps) do
			local width, mid = s[2] - s[1], (s[1] + s[2]) / 2
			if s[3] then
				if h > dh then
					block(walls, "Lintel", Vector3.new(width, h - dh, t), CFrame.new(mid, y + dh + (h - dh) / 2, z), o.color or C.Concrete, o.material or Enum.Material.Concrete)
				end
			else
				block(walls, "Wall", Vector3.new(width, h, t), CFrame.new(mid, y + h / 2, z), o.color or C.Concrete, o.material or Enum.Material.Concrete)
			end
		end
	end

	-- Wall along Z at constant x (gaps = { { centerZ, width } }).
	function kit.wallX(x: number, z0: number, z1: number, gaps: { { number } }?, o: WallOptions?)
		o = o or {}
		local y, h, dh, t = o.y or 0, o.h or kit.H, o.doorH or kit.DOOR_H, o.t or kit.T
		local walls = kit.folder("Walls")
		for _, s in segments(z0, z1, gaps) do
			local depth, mid = s[2] - s[1], (s[1] + s[2]) / 2
			if s[3] then
				if h > dh then
					block(walls, "Lintel", Vector3.new(t, h - dh, depth), CFrame.new(x, y + dh + (h - dh) / 2, mid), o.color or C.Concrete, o.material or Enum.Material.Concrete)
				end
			else
				block(walls, "Wall", Vector3.new(t, h, depth), CFrame.new(x, y + h / 2, mid), o.color or C.Concrete, o.material or Enum.Material.Concrete)
			end
		end
	end

	function kit.slab(name: string, x0: number, z0: number, x1: number, z1: number, y: number, thickness: number, color: Color3, material: Enum.Material?): Part
		return block(kit.folder("Structure"), name, Vector3.new(x1 - x0, thickness, z1 - z0), CFrame.new((x0 + x1) / 2, y - thickness / 2, (z0 + z1) / 2), color, material or Enum.Material.Concrete)
	end

	-- A closed room: floor, roof and four walls. gaps = { n = {...}, s = {...}, w = {...}, e = {...} }
	-- (n = wall at z0, s = wall at z1, w = wall at x0, e = wall at x1)
	function kit.room(x0: number, z0: number, x1: number, z1: number, o: { y: number?, h: number?, gaps: any?, floor: Color3?, floorMaterial: Enum.Material?, wall: Color3?, wallMaterial: Enum.Material?, roof: Color3?, roofMaterial: Enum.Material?, noRoof: boolean?, noFloor: boolean?, doorH: number? }?)
		o = o or {}
		local y, h = o.y or 0, o.h or kit.H
		local gaps = o.gaps or {}
		if not o.noFloor then
			kit.slab("Floor", x0, z0, x1, z1, y, 1, o.floor or C.Floor, o.floorMaterial or Enum.Material.Concrete)
		end
		if not o.noRoof then
			kit.slab("Roof", x0 - 0.5, z0 - 0.5, x1 + 0.5, z1 + 0.5, y + h + 1.2, 1.2, o.roof or C.ConcreteDark, o.roofMaterial or Enum.Material.Concrete)
		end
		local wo = { y = y, h = h, color = o.wall, material = o.wallMaterial, doorH = o.doorH }
		kit.wallZ(z0, x0, x1, gaps.n, wo)
		kit.wallZ(z1, x0, x1, gaps.s, wo)
		kit.wallX(x0, z0, z1, gaps.w, wo)
		kit.wallX(x1, z0, z1, gaps.e, wo)
	end

	-- Sloped walkway from bottom centre `a` to top centre `b` (top surface walkable).
	function kit.ramp(a: Vector3, b: Vector3, width: number, color: Color3?, material: Enum.Material?): Part
		local length = (b - a).Magnitude
		local cf = CFrame.lookAt((a + b) / 2, b) * CFrame.new(0, -0.5, 0)
		return block(kit.folder("Structure"), "Ramp", Vector3.new(width, 1, length), cf, color or C.Concrete, material or Enum.Material.Concrete)
	end

	function kit.railing(a: Vector3, b: Vector3, color: Color3?)
		local f = kit.folder("Railings")
		local length = (b - a).Magnitude
		local count = math.max(1, math.floor(length / 4))
		for i = 0, count do
			local p = a:Lerp(b, i / count)
			block(f, "Post", Vector3.new(0.25, 3.6, 0.25), CFrame.new(p + Vector3.new(0, 1.8, 0)), color or C.SteelDark, Enum.Material.Metal)
		end
		block(f, "Rail", Vector3.new(0.3, 0.3, length), CFrame.lookAt((a + b) / 2 + Vector3.new(0, 3.6, 0), b + Vector3.new(0, 3.6, 0)), color or C.SteelDark, Enum.Material.Metal)
		local mid = block(f, "Rail", Vector3.new(0.18, 0.18, length), CFrame.lookAt((a + b) / 2 + Vector3.new(0, 1.9, 0), b + Vector3.new(0, 1.9, 0)), color or C.SteelDark, Enum.Material.Metal)
		mid.CanCollide = false
		-- invisible barrier so nobody falls off by accident (players and the creature)
		local guard = block(f, "Guard", Vector3.new(0.4, 6, length), CFrame.lookAt((a + b) / 2 + Vector3.new(0, 3, 0), b + Vector3.new(0, 3, 0)), C.Concrete)
		guard.Transparency = 1
	end

	-----------------------------------------------------------------------
	-- Doors (same contract as Relay 07: FZ_Door + FZ_Interactable "door")
	-----------------------------------------------------------------------
	local doorCount = 0
	function kit.door(center: Vector3, alongX: boolean, width: number, locked: boolean?, sector: string?, o: { doorH: number?, color: Color3?, material: Enum.Material?, prefix: string? }?)
		o = o or {}
		doorCount += 1
		local doors = kit.folder("Doors")
		local dh = o.doorH or kit.DOOR_H
		local y = center.Y
		local size = if alongX then Vector3.new(width, dh, 0.6) else Vector3.new(0.6, dh, width)
		local closed = CFrame.new(center.X, y + dh / 2, center.Z)
		local slide = if alongX then Vector3.new(width - 0.4, 0, 0) else Vector3.new(0, 0, width - 0.4)
		local panel = block(doors, "Door" .. doorCount, size, closed, o.color or C.Steel, o.material or Enum.Material.Metal)
		local along = if alongX then Vector3.new(1, 0, 0) else Vector3.new(0, 0, 1)
		for _, sideSign in { -1, 1 } do
			local postPos = Vector3.new(center.X, y + dh / 2, center.Z) + along * sideSign * (width / 2 + 0.35)
			block(doors, "DoorFrame", if alongX then Vector3.new(0.7, dh, 1.6) else Vector3.new(1.6, dh, 0.7), CFrame.new(postPos), C.SteelDark, Enum.Material.Metal)
		end
		block(doors, "DoorHeader", if alongX then Vector3.new(width + 1.4, 0.9, 1.6) else Vector3.new(1.6, 0.9, width + 1.4), CFrame.new(center.X, y + dh + 0.45, center.Z), C.SteelDark, Enum.Material.Metal)
		local stripe = block(panel, "Stripe", if alongX then Vector3.new(width, 0.4, 0.7) else Vector3.new(0.7, 0.4, width), closed * CFrame.new(0, 1.5 - dh / 2 + 5, 0), if locked then C.Emergency else C.Plastic, Enum.Material.Neon)
		stripe.CanCollide = false
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = panel
		weld.Part1 = stripe
		weld.Parent = panel
		stripe.Anchored = false
		local modifier = Instance.new("PathfindingModifier")
		modifier.PassThrough = not locked
		modifier.Parent = panel
		tag(panel, "FZ_Door", {
			DoorId = (o.prefix or "M") .. doorCount,
			Open = false,
			Locked = locked == true,
			PowerSector = sector or "",
			ClosedCFrame = closed,
			OpenCFrame = closed + slide,
		})
		tag(panel, "FZ_Interactable", { InteractId = "door", ActionKey = "INTERACT_OPEN", ObjectKey = "OBJECT_DOOR", MaxDistance = 9 })
		return panel
	end

	-----------------------------------------------------------------------
	-- Lights
	-----------------------------------------------------------------------
	local perSector: { [string]: number } = {}
	function kit.ceilingLight(position: Vector3, sector: string, color: Color3?, shadows: boolean?, forceKey: boolean?, height: number?)
		perSector[sector] = (perSector[sector] or 0) + 1
		local key = forceKey or perSector[sector] <= 2
		local h = height or (position.Y + kit.H)
		local lights = kit.folder("Lights")
		local housing = block(lights, "LampHousing", Vector3.new(6.6, 0.45, 1.6), CFrame.new(position.X, h - 0.25, position.Z), C.SteelDark, Enum.Material.Metal)
		housing.CanCollide = false
		local fixture = block(lights, "Fixture_" .. sector, Vector3.new(6, 0.15, 1.1), CFrame.new(position.X, h - 0.52, position.Z), color or C.Fluorescent, Enum.Material.Neon)
		fixture.CanCollide = false
		fixture.CastShadow = false
		local light = Instance.new("SurfaceLight")
		light.Face = Enum.NormalId.Bottom
		light.Range = 28
		light.Angle = 140
		light.Brightness = 1.9
		light.Color = color or C.Fluorescent
		light.Shadows = shadows == true
		light.Parent = fixture
		tag(fixture, "FZ_SectorLight", { Sector = sector, OnColor = color or C.Fluorescent })
		CollectionService:AddTag(fixture, if key then "FZ_KeyLight" else "FZ_DecorLight")
		return fixture
	end

	function kit.lightGrid(x0: number, x1: number, z0: number, z1: number, sector: string, color: Color3?, y: number?, h: number?)
		local nx = math.max(1, math.floor((x1 - x0) / 16))
		local nz = math.max(1, math.floor((z1 - z0) / 14))
		for ix = 1, nx do
			for iz = 1, nz do
				local x = x0 + (x1 - x0) * (ix - 0.5) / nx
				local z = z0 + (z1 - z0) * (iz - 0.5) / nz
				kit.ceilingLight(Vector3.new(x, y or 0, z), sector, color, ix == 1 and iz == 1, nil, if h then (y or 0) + h else nil)
			end
		end
	end

	-- Caged bulb / lantern: a small point light, optionally switched with a sector.
	function kit.bulb(position: Vector3, color: Color3?, range: number?, brightness: number?, sector: string?, key: boolean?)
		local lights = kit.folder("Lights")
		local bulb = block(lights, "Bulb", Vector3.new(0.6, 0.8, 0.6), CFrame.new(position), color or C.Warm, Enum.Material.Neon)
		bulb.Shape = Enum.PartType.Ball
		bulb.CanCollide = false
		bulb.CastShadow = false
		local cage = block(lights, "Cage", Vector3.new(0.9, 1.1, 0.9), CFrame.new(position), C.SteelDark, Enum.Material.DiamondPlate)
		cage.Transparency = 0.6
		cage.CanCollide = false
		local light = Instance.new("PointLight")
		light.Range = range or 18
		light.Brightness = brightness or 1.2
		light.Color = color or C.Warm
		light.Shadows = key == true
		light.Parent = bulb
		if sector then
			tag(bulb, "FZ_SectorLight", { Sector = sector, OnColor = color or C.Warm })
		end
		CollectionService:AddTag(bulb, if key ~= false then "FZ_KeyLight" else "FZ_DecorLight")
		return bulb
	end

	function kit.emergencyLight(position: Vector3, sector: string)
		local lamp = block(kit.folder("Lights"), "Emergency", Vector3.new(0.8, 0.5, 0.8), CFrame.new(position), C.Emergency, Enum.Material.Neon)
		lamp.CanCollide = false
		local light = Instance.new("PointLight")
		light.Range = 14
		light.Brightness = 0.7
		light.Color = C.Emergency
		light.Parent = lamp
		CollectionService:AddTag(lamp, "FZ_KeyLight")
		lamp:SetAttribute("Sector", sector)
		return lamp
	end

	function kit.floodLight(position: Vector3, target: Vector3, color: Color3?, range: number?)
		local lights = kit.folder("Lights")
		local head = block(lights, "FloodLight", Vector3.new(1.6, 1.2, 0.8), CFrame.lookAt(position, target), color or C.Fluorescent, Enum.Material.Neon)
		head.CanCollide = false
		local light = Instance.new("SpotLight")
		light.Face = Enum.NormalId.Front
		light.Range = range or 50
		light.Angle = 70
		light.Brightness = 2.4
		light.Color = color or C.Fluorescent
		light.Shadows = true
		light.Parent = head
		CollectionService:AddTag(head, "FZ_KeyLight")
		return head
	end

	-----------------------------------------------------------------------
	-- Props
	-----------------------------------------------------------------------
	local function props()
		return kit.folder("Props")
	end

	function kit.desk(cf: CFrame)
		block(props(), "Desk", Vector3.new(6, 0.3, 3), cf * CFrame.new(0, 3, 0), C.Wood, Enum.Material.Wood)
		for _, x in { -2.7, 2.7 } do
			block(props(), "DeskLeg", Vector3.new(0.4, 3, 2.6), cf * CFrame.new(x, 1.5, 0), C.SteelDark, Enum.Material.Metal)
		end
	end

	function kit.table_(cf: CFrame, size: Vector3?, color: Color3?)
		local s = size or Vector3.new(8, 0.3, 3.5)
		block(props(), "Table", s, cf * CFrame.new(0, 3, 0), color or C.Wood, Enum.Material.Wood)
		for _, x in { -s.X / 2 + 0.4, s.X / 2 - 0.4 } do
			for _, z in { -s.Z / 2 + 0.4, s.Z / 2 - 0.4 } do
				block(props(), "TableLeg", Vector3.new(0.3, 3, 0.3), cf * CFrame.new(x, 1.5, z), C.SteelDark, Enum.Material.Metal)
			end
		end
	end

	function kit.bench(cf: CFrame, length: number?, color: Color3?)
		local l = length or 7
		block(props(), "Bench", Vector3.new(l, 0.4, 1.4), cf * CFrame.new(0, 1.8, 0), color or C.Wood, Enum.Material.Wood)
		for _, x in { -l / 2 + 0.5, l / 2 - 0.5 } do
			block(props(), "BenchLeg", Vector3.new(0.3, 1.6, 1.2), cf * CFrame.new(x, 0.8, 0), color or C.WoodDark, Enum.Material.Wood)
		end
	end

	function kit.chair(cf: CFrame)
		block(props(), "ChairSeat", Vector3.new(1.8, 0.3, 1.8), cf * CFrame.new(0, 1.8, 0), C.SteelDark, Enum.Material.Fabric)
		block(props(), "ChairBack", Vector3.new(1.8, 2, 0.25), cf * CFrame.new(0, 2.9, 0.8), C.SteelDark, Enum.Material.Fabric)
		block(props(), "ChairLeg", Vector3.new(0.25, 1.7, 0.25), cf * CFrame.new(0, 0.85, 0), C.Steel, Enum.Material.Metal)
	end

	function kit.crate(cf: CFrame, size: number?)
		local s = size or 2.4
		block(props(), "Crate", Vector3.new(s, s, s), cf * CFrame.new(0, s / 2, 0), Color3.fromRGB(120, 96, 66), Enum.Material.WoodPlanks)
	end

	function kit.barrel(cf: CFrame, color: Color3?)
		local b = block(props(), "Barrel", Vector3.new(4, 2.6, 2.6), cf * CFrame.new(0, 2, 0) * CFrame.Angles(0, 0, math.rad(90)), color or Color3.fromRGB(150, 60, 34), Enum.Material.CorrodedMetal)
		b.Shape = Enum.PartType.Cylinder
		return b
	end

	function kit.shelf(cf: CFrame)
		block(props(), "Shelf", Vector3.new(8, 9, 2), cf * CFrame.new(0, 4.5, 0), C.Wood, Enum.Material.Wood)
		for row = 1, 4 do
			block(props(), "Files", Vector3.new(7.2, 1.4, 1.6), cf * CFrame.new(0, row * 2 - 0.3, -0.1), C.Paper:Lerp(C.Wood, rng:NextNumber(0.2, 0.6)), Enum.Material.Cardboard)
		end
	end

	function kit.bunk(cf: CFrame)
		for _, y in { 1.6, 5.2 } do
			block(props(), "Bed", Vector3.new(4, 0.8, 8), cf * CFrame.new(0, y, 0), C.Plastic:Lerp(C.Steel, 0.5), Enum.Material.Fabric)
		end
		for _, x in { -1.9, 1.9 } do
			for _, z in { -3.8, 3.8 } do
				block(props(), "BunkPost", Vector3.new(0.3, 6.4, 0.3), cf * CFrame.new(x, 3.2, z), C.SteelDark, Enum.Material.Metal)
			end
		end
	end

	function kit.locker(cf: CFrame)
		block(props(), "Locker", Vector3.new(2, 7, 2), cf * CFrame.new(0, 3.5, 0), C.Steel:Lerp(C.Plastic, 0.2), Enum.Material.Metal)
	end

	function kit.cabinet(cf: CFrame)
		block(props(), "Cabinet", Vector3.new(3, 7, 2), cf * CFrame.new(0, 3.5, 0), C.Steel, Enum.Material.Metal)
	end

	function kit.console(cf: CFrame, screenColor: Color3?): { BasePart }
		block(props(), "Console", Vector3.new(7, 3.4, 2.4), cf * CFrame.new(0, 1.7, 0), C.SteelDark, Enum.Material.Metal)
		block(props(), "ConsoleTop", Vector3.new(7.2, 0.3, 2.8), cf * CFrame.new(0, 3.5, 0) * CFrame.Angles(math.rad(-12), 0, 0), C.Steel, Enum.Material.Metal)
		for i = -3, 3 do
			local led = block(props(), "Led", Vector3.new(0.18, 0.18, 0.05), cf * CFrame.new(i * 0.6, 2.6, -1.22), if i % 3 == 0 then C.Emergency else C.Screen, Enum.Material.Neon)
			led.CanCollide = false
		end
		local screens = {}
		for i = -1, 1 do
			local monitor = block(props(), "Monitor", Vector3.new(2, 1.7, 1.6), cf * CFrame.new(i * 2.25, 4.7, 0.5), Color3.fromRGB(58, 56, 52), Enum.Material.SmoothPlastic)
			local glass = block(props(), "Screen", Vector3.new(1.6, 1.2, 0.05), monitor.CFrame * CFrame.new(0, 0.05, -0.82), screenColor or C.Screen, Enum.Material.Neon)
			glass.Transparency = 0.2
			glass.CanCollide = false
			local glow = Instance.new("SurfaceLight")
			glow.Face = Enum.NormalId.Front
			glow.Range = 7
			glow.Brightness = 0.6
			glow.Angle = 90
			glow.Color = screenColor or C.Screen
			glow.Parent = glass
			table.insert(screens, glass)
		end
		return screens
	end

	function kit.serverRack(cf: CFrame)
		local rack = block(props(), "ServerRack", Vector3.new(3, 9, 3), cf * CFrame.new(0, 4.5, 0), Color3.fromRGB(28, 30, 32), Enum.Material.Metal)
		for row = 0, 7 do
			for k = 0, 2 do
				local led = block(props(), "RackLed", Vector3.new(0.14, 0.14, 0.05), rack.CFrame * CFrame.new(-1 + k * 0.25, -3.6 + row * 1.05, -1.55), if (row + k) % 4 == 0 then Color3.fromRGB(255, 170, 60) else C.Screen, Enum.Material.Neon)
				led.CanCollide = false
			end
		end
		return rack
	end

	function kit.deskLamp(cf: CFrame)
		block(props(), "LampBase", Vector3.new(0.6, 0.15, 0.6), cf, C.SteelDark, Enum.Material.Metal)
		local head = block(props(), "LampHead", Vector3.new(0.7, 0.35, 0.5), cf * CFrame.new(-0.3, 1.25, 0), Color3.fromRGB(255, 214, 150), Enum.Material.Neon)
		head.CanCollide = false
		local light = Instance.new("SpotLight")
		light.Face = Enum.NormalId.Bottom
		light.Range = 12
		light.Angle = 100
		light.Brightness = 1.4
		light.Color = Color3.fromRGB(255, 205, 140)
		light.Parent = head
		CollectionService:AddTag(head, "FZ_DecorLight")
	end

	function kit.candle(position: Vector3, key: boolean?)
		local wax = block(props(), "Candle", Vector3.new(0.3, 0.9, 0.3), CFrame.new(position + Vector3.new(0, 0.45, 0)), Color3.fromRGB(230, 224, 200), Enum.Material.SmoothPlastic)
		wax.CanCollide = false
		local flame = block(props(), "Flame", Vector3.new(0.18, 0.3, 0.18), CFrame.new(position + Vector3.new(0, 1.05, 0)), C.Candle, Enum.Material.Neon)
		flame.Shape = Enum.PartType.Ball
		flame.CanCollide = false
		flame.CastShadow = false
		local light = Instance.new("PointLight")
		light.Range = 9
		light.Brightness = 0.9
		light.Color = C.Candle
		light.Parent = flame
		CollectionService:AddTag(flame, if key then "FZ_KeyLight" else "FZ_DecorLight")
		return flame
	end

	function kit.papers(cf: CFrame)
		for i = 1, 3 do
			local sheet = block(props(), "Paper", Vector3.new(0.9, 0.02, 1.2), cf * CFrame.new(i * 0.35, 0.01 * i, 0) * CFrame.Angles(0, math.rad(i * 17), 0), C.Paper, Enum.Material.SmoothPlastic)
			sheet.CanCollide = false
		end
	end

	function kit.generator(cf: CFrame, id: number)
		local body = block(props(), "Generator", Vector3.new(8, 6, 5), cf * CFrame.new(0, 3, 0), C.Steel:Lerp(C.Emergency, 0.15), Enum.Material.Metal)
		local drum = block(props(), "Drum", Vector3.new(7, 4, 4), cf * CFrame.new(0, 7.5, 0), C.SteelDark, Enum.Material.Metal)
		drum.Shape = Enum.PartType.Cylinder
		body:SetAttribute("SoundLoop", "generator_loop")
		CollectionService:AddTag(body, "FZ_AmbientSource")
		kit.interactable(body, "generator", "INTERACT_RESTART", "OBJECT_GENERATOR", { HoldDuration = 3, MaxDistance = 9, GeneratorId = id })
		return body
	end

	function kit.pipeRun(from: Vector3, to: Vector3, radius: number?, color: Color3?)
		local length = (to - from).Magnitude
		local pipe = block(props(), "Pipe", Vector3.new(length, (radius or 0.6) * 2, (radius or 0.6) * 2), CFrame.lookAt((from + to) / 2, to) * CFrame.Angles(0, math.rad(90), 0), color or C.SteelDark, Enum.Material.Metal)
		pipe.Shape = Enum.PartType.Cylinder
		pipe.CanCollide = false
		return pipe
	end

	function kit.sign(position: Vector3, facing: Vector3, key: string?, text: string?, size: Vector3?)
		local plate = block(props(), "Sign", size or Vector3.new(8, 2.4, 0.2), CFrame.lookAt(position, position + facing), C.Plastic, Enum.Material.SmoothPlastic)
		plate.CanCollide = false
		kit.worldText(plate, Enum.NormalId.Front, key, text)
		return plate
	end

	function kit.vent(position: Vector3, facing: Vector3, group: string)
		local grate = block(props(), "Vent", Vector3.new(3, 2, 0.3), CFrame.lookAt(position, position + facing), C.SteelDark, Enum.Material.DiamondPlate)
		grate.CanCollide = false
		tag(grate, "FZ_Vent", { VentGroup = group })
	end

	function kit.patrol(position: Vector3, area: string)
		tag(kit.marker("PatrolNode", CFrame.new(position.X, position.Y + 3, position.Z)), "FZ_CreaturePatrol", { Area = area })
	end

	function kit.fuseSpot(cf: CFrame, sector: string)
		tag(kit.marker("FuseSpot", cf), "FZ_FuseSpot", { Sector = sector })
	end

	function kit.checkpoint(id: string, cf: CFrame)
		local p = kit.marker("CP_" .. id, cf)
		p.Size = Vector3.new(4, 1, 4)
		tag(p, "FZ_Checkpoint", { CheckpointId = id })
	end

	function kit.itemSpot(cf: CFrame)
		CollectionService:AddTag(kit.marker("ItemSpot", cf), "FZ_ItemSpot")
	end

	function kit.creatureSpawn(cf: CFrame)
		CollectionService:AddTag(kit.marker("CreatureSpawn", cf), "FZ_CreatureSpawn")
	end

	function kit.menuCamera(index: number, from: Vector3, to: Vector3, drift: number?)
		local cam = kit.marker("MenuCamera" .. index, CFrame.lookAt(from, to))
		cam:SetAttribute("Shot", index)
		cam:SetAttribute("Drift", drift or 6)
		CollectionService:AddTag(cam, "FZ_MenuCamera")
	end

	function kit.interactable(part: BasePart, id: string, action: string, object: string, extra: { [string]: any }?)
		local attributes = { InteractId = id, ActionKey = action, ObjectKey = object }
		for key, value in extra or {} do
			attributes[key] = value
		end
		tag(part, "FZ_Interactable", attributes)
		return part
	end

	-- Wall-mounted panel (breaker, override, valve ...) that is used by holding it.
	function kit.panel(cf: CFrame, id: string, action: string, object: string, extra: { [string]: any }?, color: Color3?)
		local box = block(props(), "Panel_" .. id, Vector3.new(3, 4, 0.8), cf, color or C.Steel:Lerp(C.Emergency, 0.25), Enum.Material.Metal)
		local lamp = block(props(), "PanelLamp", Vector3.new(0.4, 0.4, 0.1), cf * CFrame.new(1.1, 1.6, -0.45), C.Emergency, Enum.Material.Neon)
		lamp.CanCollide = false
		local attributes = { MaxDistance = 8 }
		for key, value in extra or {} do
			attributes[key] = value
		end
		kit.interactable(box, id, action, object, attributes)
		return box
	end

	-- Hand wheel (valves, winches): a ring on a post.
	function kit.wheel(cf: CFrame, id: string, action: string, object: string, extra: { [string]: any }?)
		local post = block(props(), "WheelPost", Vector3.new(0.8, 3.6, 0.8), cf * CFrame.new(0, 1.8, 0), C.SteelDark, Enum.Material.Metal)
		local ring = block(props(), "Wheel", Vector3.new(0.3, 3, 3), cf * CFrame.new(0, 3.8, 0) * CFrame.Angles(0, math.rad(90), 0), C.Emergency:Lerp(C.SteelDark, 0.3), Enum.Material.Metal)
		ring.Shape = Enum.PartType.Cylinder
		local attributes = { MaxDistance = 8, HoldDuration = 3 }
		for key, value in extra or {} do
			attributes[key] = value
		end
		kit.interactable(post, id, action, object, attributes)
		return post
	end

	-- One of the two keys of a security lock (survival task "keys"): yellow/black housing,
	-- a key with a lamp. Index 1 and 2 belong together.
	function kit.syncKey(cf: CFrame, index: number)
		local box = block(props(), "SyncKey" .. index, Vector3.new(2.4, 3, 0.8), cf, C.Hazard, Enum.Material.Metal)
		for i = 0, 3 do
			local stripe = block(props(), "SyncStripe", Vector3.new(0.35, 3.1, 0.05), box.CFrame * CFrame.new(-0.9 + i * 0.6, 0, -0.42) * CFrame.Angles(0, 0, math.rad(30)), C.SteelDark, Enum.Material.SmoothPlastic)
			stripe.CanCollide = false
		end
		local lamp = block(props(), "SyncLamp", Vector3.new(0.5, 0.5, 0.2), box.CFrame * CFrame.new(0, 1.9, -0.3), C.Emergency, Enum.Material.Neon)
		lamp.CanCollide = false
		local glow = Instance.new("PointLight")
		glow.Range = 6
		glow.Brightness = 0.8
		glow.Color = C.Emergency
		glow.Parent = lamp
		kit.interactable(box, "sync_key", "INTERACT_TURN_KEY", "OBJECT_SYNC_KEY", { MaxDistance = 8, KeyIndex = index })
		return box
	end

	-- Small box used as a survival station / relay target.
	function kit.station(cf: CFrame, id: string, object: string?)
		local box = block(props(), "Station_" .. id, Vector3.new(2, 3, 2), cf, C.Steel, Enum.Material.Metal)
		local screen = block(props(), "StationScreen", Vector3.new(1.4, 0.9, 0.05), box.CFrame * CFrame.new(0, 0.7, -1.03), C.Screen, Enum.Material.Neon)
		screen.CanCollide = false
		kit.interactable(box, id, "INTERACT_ACTIVATE", object or "OBJECT_STATION", { MaxDistance = 8 })
		return box
	end

	function kit.firstAid(cf: CFrame)
		local cabinet = block(props(), "FirstAid", Vector3.new(2.6, 3.2, 0.9), cf, Color3.fromRGB(226, 224, 216), Enum.Material.SmoothPlastic)
		for _, size in { Vector3.new(0.4, 1.4, 0.05), Vector3.new(1.4, 0.4, 0.05) } do
			local cross = block(props(), "Cross", size, cabinet.CFrame * CFrame.new(0, 0.2, -0.47), Color3.fromRGB(190, 40, 34), Enum.Material.Neon)
			cross.CanCollide = false
		end
		kit.interactable(cabinet, "medcabinet", "INTERACT_TAKE_MEDKIT", "OBJECT_MEDCABINET", { MaxDistance = 7 })
		CollectionService:AddTag(cabinet, "FZ_MedCabinet")
		return cabinet
	end

	function kit.speaker(position: Vector3, facing: Vector3)
		local speaker = block(props(), "Speaker", Vector3.new(1.4, 1.4, 1.6), CFrame.lookAt(position, position + facing), C.SteelDark, Enum.Material.Metal)
		speaker.CanCollide = false
		CollectionService:AddTag(speaker, "FZ_Speaker")
	end

	-- Archive find: a tape recorder that unlocks a lore entry (LoreService "lore" handler).
	function kit.recorder(cf: CFrame, logId: string)
		local recorder = block(props(), "Recorder", Vector3.new(1.4, 0.6, 1), cf, Color3.fromRGB(48, 44, 40), Enum.Material.SmoothPlastic)
		local reel = block(props(), "Reel", Vector3.new(0.1, 0.5, 0.5), cf * CFrame.new(0, 0.35, 0) * CFrame.Angles(0, 0, math.rad(90)), C.Plastic, Enum.Material.SmoothPlastic)
		reel.Shape = Enum.PartType.Cylinder
		reel.CanCollide = false
		local led = Instance.new("PointLight")
		led.Range = 3
		led.Brightness = 0.6
		led.Color = Color3.fromRGB(255, 120, 60)
		led.Parent = recorder
		kit.interactable(recorder, "lore", "INTERACT_LISTEN", "OBJECT_RECORDER", { MaxDistance = 7, LogId = logId })
		return recorder
	end

	-- Readable document lying somewhere (lore handler, opens the archive entry).
	function kit.document(cf: CFrame, logId: string, objectKey: string?)
		local sheet = block(props(), "Document", Vector3.new(1.1, 0.06, 1.4), cf, C.Paper, Enum.Material.SmoothPlastic)
		sheet.CanCollide = false
		local glow = Instance.new("PointLight")
		glow.Range = 3
		glow.Brightness = 0.35
		glow.Color = C.Warm
		glow.Parent = sheet
		kit.interactable(sheet, "lore", "INTERACT_READ", objectKey or "OBJECT_DOCUMENT", { MaxDistance = 7, LogId = logId })
		return sheet
	end

	-----------------------------------------------------------------------
	-- Outdoor
	-----------------------------------------------------------------------
	function kit.tree(parent: Instance, position: Vector3, scale: number, dead: boolean?)
		local height = 30 * scale
		local model = Instance.new("Model")
		model.Name = if dead then "DeadTree" else "Pine"
		model.Parent = parent
		local trunk = block(model, "Trunk", Vector3.new(height, 1.3 * scale, 1.3 * scale), CFrame.new(position + Vector3.new(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), C.Bark, Enum.Material.Wood)
		trunk.Shape = Enum.PartType.Cylinder
		if dead then
			for i = 1, 4 do
				local y = height * (0.45 + i * 0.1)
				local branch = block(model, "Branch", Vector3.new(0.35 * scale, 0.35 * scale, 7 * scale * (1.1 - i * 0.15)), CFrame.new(position + Vector3.new(0, y, 0)) * CFrame.Angles(math.rad(-25), rng:NextNumber(0, 6.28), 0) * CFrame.new(0, 0, -3 * scale), C.Bark, Enum.Material.Wood)
				branch.CanCollide = false
			end
			return model
		end
		local tint = rng:NextNumber(-0.12, 0.12)
		local needleColor = Color3.new(math.clamp(C.Pine.R + tint * 0.3, 0, 1), math.clamp(C.Pine.G + tint * 0.4, 0, 1), math.clamp(C.Pine.B + tint * 0.3, 0, 1))
		for i = 0, 5 do
			local t = i / 5
			local radius = (7.5 - t * 5.8) * scale
			local layer = block(model, "Needles", Vector3.new(1, 1, 1), CFrame.new(position + Vector3.new(0, height * (0.28 + t * 0.66), 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi), 0), needleColor, Enum.Material.Grass)
			layer.CanCollide = false
			local mesh = Instance.new("SpecialMesh")
			mesh.MeshType = Enum.MeshType.Sphere
			mesh.Scale = Vector3.new(radius * 2, 4.2 * scale, radius * 2)
			mesh.Parent = layer
		end
		return model
	end

	-- Scatter trees in a ring, skipping excluded rectangles { {x0, z0, x1, z1} }.
	function kit.forest(count: number, x0: number, x1: number, z0: number, z1: number, exclude: { { number } }, deadShare: number?)
		local forest = kit.folder("Forest")
		local placed, tries = 0, 0
		while placed < count and tries < count * 20 do
			tries += 1
			local x = rng:NextNumber(x0, x1)
			local z = rng:NextNumber(z0, z1)
			local blocked = false
			for _, r in exclude do
				if x > r[1] and x < r[3] and z > r[2] and z < r[4] then
					blocked = true
					break
				end
			end
			if not blocked then
				kit.tree(forest, Vector3.new(x, 0, z), rng:NextNumber(0.8, 1.35), rng:NextNumber() < (deadShare or 0))
				placed += 1
			end
		end
	end

	function kit.rock(position: Vector3, size: number)
		return block(kit.folder("Rocks"), "Rock", Vector3.new(size * 1.4, size * 0.8, size), CFrame.new(position + Vector3.new(0, size * 0.25, 0)) * CFrame.Angles(rng:NextNumber(-0.3, 0.3), rng:NextNumber(0, 6.28), rng:NextNumber(-0.3, 0.3)), C.Rock, Enum.Material.Slate)
	end

	function kit.spawnLocation(cf: CFrame)
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "FZ_Spawn"
		spawn.Anchored = true
		spawn.Size = Vector3.new(6, 1, 6)
		spawn.CFrame = cf
		spawn.Transparency = 1
		spawn.CanCollide = false
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Parent = kit.folder("Markers")
		local decal = spawn:FindFirstChildOfClass("Decal")
		if decal then
			decal:Destroy()
		end
	end

	-- Flat stand-in ground for Studio's edit mode (removed when terrain is filled).
	function kit.previewGround(center: Vector3, size: Vector3, color: Color3?)
		local p = block(kit.folder("Outside"), "EditPreviewGround", size, CFrame.new(center), color or Color3.fromRGB(46, 58, 40), Enum.Material.Grass)
		p:SetAttribute("FZ_EditPreview", true)
		return p
	end

	function kit.finish(): Model
		root.Parent = workspace
		return root
	end

	return kit
end

return MapKit
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">Mine</string>
            <string name="Source"><![CDATA[-- Die Mine - chapter 4 "Frequency Zero": the Echo-Array lies deep in the old mine.
--
--                 [ ARRAY-KERN (core cavern) ]
--                        ║ Panzertür
--   Schleife ══╗   [ Trafokammer ]
--   (loop)     ║        ║  verschütteter Gang (open only in the 2009 layer)
--   [Förderkorb]══[ Kreuzung ]══[Pumpenkammer]
--                        ║  Hauptstollen
--   ─────────── Portal ──╨── Felswand ─────────────
--      [Fördermaschinenhaus]   Förderturm   Hof (start)
--
-- Time layers: parts tagged FZ_Layer (Layer = "now" | "2009") exist only in their layer;
-- chapter 4 switches the layer with every Array pulse.
-- InteractIds: c4_winch, c4_brake, c4_pump, c4_breaker, c4_override, c4_core.

local CollectionService = game:GetService("CollectionService")

local MapKit = require(script.Parent.MapKit)
local MapDress = require(script.Parent.MapDress)
local C = MapKit.C

local Map = {}

local TH = 12 -- tunnel wall height
local ROCK = Color3.fromRGB(76, 70, 64)
local TIMBER = Color3.fromRGB(96, 70, 46)

-- Every carved space (used to carve the mountain terrain at load time).
local CARVE = {
	{ -6, -122, 6, 2 }, -- main adit (incl. portal)
	{ -21, -141, 21, -119 }, -- junction
	{ 20, -136, 41, -124 }, { 39, -151, 81, -109 }, -- pump branch + room
	{ -41, -136, -20, -124 }, { -81, -151, -39, -109 }, -- lift branch + room
	{ -6, -221, 6, -139 }, -- collapsed passage
	{ -67, -251, -55, -149 }, { -67, -251, -5, -239 }, -- loop
	{ -21, -261, 21, -219 }, -- transformer room
	{ -46, -341, 46, -259 }, -- core cavern
}
Map.Carve = CARVE

local function build()
	local kit = MapKit.new("FZ_Mine", "Mine", 505)
	local block, deco = kit.block, kit.deco
	local structure = kit.folder("Structure")
	local props = kit.folder("Props")
	local outside = kit.folder("Outside")

	-- A tunnel/room with rock walls, rough ceiling and timber frames along its long axis.
	local function tunnel(x0: number, z0: number, x1: number, z1: number, gaps: any?, h: number?, sector: string?, lamps: boolean?)
		local height = h or TH
		kit.room(x0, z0, x1, z1, {
			h = height,
			gaps = gaps,
			floor = Color3.fromRGB(64, 58, 52),
			floorMaterial = Enum.Material.Ground,
			wall = ROCK,
			wallMaterial = Enum.Material.Rock,
			roof = C.RockDark,
		})
		local alongZ = (z1 - z0) >= (x1 - x0)
		local length = if alongZ then z1 - z0 else x1 - x0
		local width = if alongZ then x1 - x0 else z1 - z0
		if width <= 14 then
			for d = 4, length - 2, 8 do
				local cf = if alongZ then CFrame.new((x0 + x1) / 2, 0, z0 + d) else CFrame.new(x0 + d, 0, (z0 + z1) / 2) * CFrame.Angles(0, math.rad(90), 0)
				for _, side in { -1, 1 } do
					block(structure, "Timber", Vector3.new(0.9, height - 0.5, 0.9), cf * CFrame.new(side * (width / 2 - 0.9), (height - 0.5) / 2, 0), TIMBER, Enum.Material.Wood)
				end
				block(structure, "TimberCap", Vector3.new(width - 1, 0.9, 1), cf * CFrame.new(0, height - 0.9, 0), TIMBER, Enum.Material.Wood)
				if lamps ~= false and d % 16 == 4 then
					kit.bulb((cf * CFrame.new(0, height - 2, 0.9)).Position, C.Warm, 20, 1.1, sector or "MINE", d % 32 == 4)
				end
			end
		end
		-- rubble along the walls
		for _ = 1, math.floor(length / 10) do
			local t = kit.rng:NextNumber(0.05, 0.95)
			local side = if kit.rng:NextNumber() < 0.5 then -1 else 1
			local p = if alongZ then Vector3.new((x0 + x1) / 2 + side * (width / 2 - 1.5), 0, z0 + t * length) else Vector3.new(x0 + t * length, 0, (z0 + z1) / 2 + side * (width / 2 - 1.5))
			local stone = block(props, "Rubble", Vector3.new(1.6, 1, 1.4) * kit.rng:NextNumber(0.6, 1.5), CFrame.new(p + Vector3.new(0, 0.4, 0)) * CFrame.Angles(kit.rng:NextNumber(0, 1), kit.rng:NextNumber(0, 6), 0), C.Rock, Enum.Material.Slate)
			stone.CanCollide = false
		end
	end

	local function rails(a: Vector3, b: Vector3)
		local length = (b - a).Magnitude
		for _, side in { -1.2, 1.2 } do
			deco(props, "Rail", Vector3.new(0.25, 0.25, length), CFrame.lookAt((a + b) / 2, b) * CFrame.new(side, 0.15, 0), C.SteelDark, Enum.Material.Metal)
		end
		for d = 0, length, 2.5 do
			deco(props, "Sleeper", Vector3.new(3.4, 0.15, 0.5), CFrame.lookAt(a, b) * CFrame.new(0, 0.05, -d), TIMBER, Enum.Material.Wood)
		end
	end

	-- layer parts (only solid/visible in their time layer)
	local function layerPart(part: BasePart, layer: string)
		part:SetAttribute("Layer", layer)
		part:SetAttribute("BaseTransparency", part.Transparency)
		part:SetAttribute("BaseCollide", part.CanCollide)
		CollectionService:AddTag(part, "FZ_Layer")
		if layer ~= "now" then
			part.Transparency = 1
			part.CanCollide = false
			part.CanQuery = false
		end
		return part
	end

	---------------------------------------------------------------------------
	-- Main adit + portal
	---------------------------------------------------------------------------
	tunnel(-5, -120, 5, 0, { s = { { 0, 8 } }, n = { { 0, 8 } } })
	rails(Vector3.new(0, 0, -2), Vector3.new(0, 0, -118))
	local gate = kit.door(Vector3.new(0, 0, 0), true, 8, true, "", { color = C.SteelDark, material = Enum.Material.DiamondPlate, prefix = "DM" })
	gate.Name = "MineGate"
	gate:SetAttribute("MineGate", true)
	-- portal: timber frame + rock face around
	block(structure, "PortalBeam", Vector3.new(14, 1.6, 1.6), CFrame.new(0, 12.8, 1), TIMBER, Enum.Material.Wood)
	for _, x in { -6.5, 6.5 } do
		block(structure, "PortalPost", Vector3.new(1.6, 12, 1.6), CFrame.new(x, 6, 1), TIMBER, Enum.Material.Wood)
	end
	local sign = deco(structure, "PortalSign", Vector3.new(10, 2.2, 0.3), CFrame.new(0, 15, 1.4), TIMBER, Enum.Material.Wood)
	kit.worldText(sign, Enum.NormalId.Back, nil, "GLÜCK AUF  ·  STOLLEN 3", nil, Color3.fromRGB(230, 214, 180), Enum.Font.Garamond)
	sign.CFrame = CFrame.lookAt(Vector3.new(0, 15, 1.4), Vector3.new(0, 15, 10))
	local cliff = block(outside, "EditPreviewCliff", Vector3.new(300, 40, 4), CFrame.new(0, 20, -1), Color3.fromRGB(70, 66, 60), Enum.Material.Rock)
	cliff:SetAttribute("FZ_EditPreview", true)
	cliff.Transparency = 0.5
	cliff.CanCollide = false
	kit.bulb(Vector3.new(0, 11, 3), C.Sodium, 26, 1.6, nil, true)
	kit.patrol(Vector3.new(0, 0, -60), "ADIT")

	---------------------------------------------------------------------------
	-- Junction, pump branch, lift branch
	---------------------------------------------------------------------------
	tunnel(-20, -140, 20, -120, { s = { { 0, 8 } }, n = { { 0, 8 } }, e = { { -130, 8 } }, w = { { -130, 8 } } }, 14)
	kit.lightGrid(-20, 20, -140, -120, "MINE", C.Warm, 0, 14)
	kit.sign(Vector3.new(0, 11, -121), Vector3.new(0, 0, 1), "SIGN_JUNCTION")
	kit.patrol(Vector3.new(0, 0, -130), "JUNCTION")
	kit.checkpoint("C4_JUNCTION", CFrame.new(0, 0.5, -110))
	-- pump room
	tunnel(20, -135, 40, -125, { w = { { -130, 8 } }, e = { { -130, 8 } } })
	tunnel(40, -150, 80, -110, { w = { { -130, 8 } } }, 14)
	local pumpDoor = kit.door(Vector3.new(40, 0, -130), false, 8, false, nil, { prefix = "DM" })
	pumpDoor:SetAttribute("PumpDoor", true)
	local pump = block(props, "Pump", Vector3.new(6, 5, 4), CFrame.new(70, 2.5, -130), Color3.fromRGB(60, 80, 96), Enum.Material.Metal)
	pump:SetAttribute("SoundLoop", "water_rush_loop")
	CollectionService:AddTag(pump, "FZ_AmbientSource")
	kit.interactable(pump, "c4_pump", "INTERACT_RESTART", "OBJECT_PUMP", { HoldDuration = 3, MaxDistance = 9 })
	kit.pipeRun(Vector3.new(66, 3, -130), Vector3.new(44, 3, -148), 0.9, Color3.fromRGB(60, 80, 96))
	deco(props, "Sump", Vector3.new(14, 0.2, 10), CFrame.new(60, 0.1, -142), Color3.fromRGB(30, 50, 56), Enum.Material.Glass).Transparency = 0.3
	kit.lightGrid(40, 80, -150, -110, "PUMP", C.Fluorescent, 0, 14)
	kit.firstAid(CFrame.new(79.4, 5, -118) * CFrame.Angles(0, math.rad(-90), 0))
	kit.patrol(Vector3.new(60, 0, -130), "PUMP")
	kit.vent(Vector3.new(79.3, 1.5, -140), Vector3.new(-1, 0, 0), "deep")
	-- flood water (shown when the water forecast comes true)
	for _, w in { { Vector3.new(0, 1.2, -130), Vector3.new(38, 2.4, 18) }, { Vector3.new(0, 1.2, -100), Vector3.new(9, 2.4, 40) } } do
		local water = block(kit.folder("Flood"), "FloodWater", w[2], CFrame.new(w[1]), Color3.fromRGB(40, 64, 70), Enum.Material.Glass)
		water.Transparency = 1
		water.CanCollide = false
		water.CanQuery = false
		water.CastShadow = false
		CollectionService:AddTag(water, "FZ_FloodWater")
	end
	-- lift room (cage in a shaft, brake lever)
	tunnel(-40, -135, -20, -125, { w = { { -130, 8 } }, e = { { -130, 8 } } })
	tunnel(-80, -150, -40, -110, { e = { { -130, 8 } }, n = { { -61, 8 } } }, 14)
	local shaftWall = Color3.fromRGB(50, 48, 46)
	for _, w in { { Vector3.new(-78, 7, -122), Vector3.new(1, 14, 8) }, { Vector3.new(-70, 7, -122), Vector3.new(1, 14, 8) }, { Vector3.new(-74, 7, -118), Vector3.new(9, 14, 1) } } do
		block(structure, "ShaftWall", w[2], CFrame.new(w[1]), shaftWall, Enum.Material.DiamondPlate)
	end
	local cage = block(props, "LiftCage", Vector3.new(6, 8, 6), CFrame.new(-74, 9, -122), C.SteelDark, Enum.Material.DiamondPlate)
	cage.Transparency = 0.35
	cage.CanCollide = false
	cage:SetAttribute("LiftCage", true)
	deco(props, "LiftCable", Vector3.new(0.3, 40, 0.3), CFrame.new(-74, 33, -122), C.SteelDark, Enum.Material.Metal)
	local brake = block(props, "BrakeLever", Vector3.new(1, 4, 1), CFrame.new(-62, 2, -114) * CFrame.Angles(math.rad(20), 0, 0), C.Emergency:Lerp(C.SteelDark, 0.3), Enum.Material.Metal)
	block(props, "BrakeBase", Vector3.new(3, 1, 2), CFrame.new(-62, 0.5, -114), C.SteelDark, Enum.Material.Metal)
	kit.interactable(brake, "c4_brake", "INTERACT_PULL", "OBJECT_BRAKE", { HoldDuration = 2, MaxDistance = 8 })
	kit.lightGrid(-80, -40, -150, -110, "LIFT", C.Warm, 0, 14)
	kit.patrol(Vector3.new(-60, 0, -132), "LIFT")
	kit.vent(Vector3.new(-79.3, 1.5, -140), Vector3.new(1, 0, 0), "deep")
	local loopDoor = kit.door(Vector3.new(-61, 0, -150), true, 8, false, nil, { prefix = "DM" })
	loopDoor:SetAttribute("LoopDoor", true)

	---------------------------------------------------------------------------
	-- Collapsed passage (rubble in "now", open in "2009") and the long loop
	---------------------------------------------------------------------------
	tunnel(-5, -220, 5, -140, { s = { { 0, 8 } }, n = { { 0, 8 } } })
	rails(Vector3.new(0, 0, -142), Vector3.new(0, 0, -218))
	for i = 0, 5 do
		local rubble = block(structure, "CollapseRubble", Vector3.new(10, 12 - i * 0.6, 3), CFrame.new(0, (12 - i * 0.6) / 2, -176 - i * 3) * CFrame.Angles(kit.rng:NextNumber(-0.1, 0.1), 0, kit.rng:NextNumber(-0.08, 0.08)), C.Rock:Lerp(C.RockDark, i / 6), Enum.Material.Slate)
		layerPart(rubble, "now")
	end
	-- the 2009 layer shows the passage as it was: lit, a sign, a lamp - and a figure in a helmet
	local oldSign = deco(props, "OldSign", Vector3.new(6, 1.6, 0.2), CFrame.new(0, 9, -158), Color3.fromRGB(220, 200, 120), Enum.Material.SmoothPlastic)
	kit.worldText(oldSign, Enum.NormalId.Front, nil, "ARRAY  ↑  14.11.2009")
	oldSign.CFrame = CFrame.lookAt(Vector3.new(0, 9, -158), Vector3.new(0, 9, -150))
	layerPart(oldSign, "2009")
	for z = -150, -210, -20 do
		local lamp = deco(props, "Lamp2009", Vector3.new(0.6, 0.8, 0.6), CFrame.new(0, 10, z), C.Warm, Enum.Material.Neon)
		local light = Instance.new("PointLight")
		light.Range = 18
		light.Brightness = 1.2
		light.Color = Color3.fromRGB(255, 200, 140)
		light.Parent = lamp
		layerPart(lamp, "2009")
	end
	kit.patrol(Vector3.new(0, 0, -160), "PASSAGE")
	kit.patrol(Vector3.new(0, 0, -205), "PASSAGE")
	-- loop: north from the lift room, then east to the transformer room
	tunnel(-66, -240, -56, -150, { s = { { -61, 8 } }, n = { { -61, 8 } } })
	tunnel(-66, -250, -20, -240, { e = { { -245, 8 } }, s = { { -61, 8 } } })
	kit.recorder(CFrame.new(-61, 0.6, -200), "c4_loop_tape")
	kit.patrol(Vector3.new(-61, 0, -195), "LOOP")
	kit.patrol(Vector3.new(-40, 0, -245), "LOOP")
	kit.vent(Vector3.new(-65.3, 1.5, -230), Vector3.new(1, 0, 0), "deep")

	---------------------------------------------------------------------------
	-- Transformer room + blast door
	---------------------------------------------------------------------------
	tunnel(-20, -260, 20, -220, { s = { { 0, 8 } }, w = { { -245, 8 } }, n = { { 0, 10 } } }, 14)
	kit.lightGrid(-20, 20, -260, -220, "TRANSFORMER", C.Fluorescent, 0, 14)
	for _, x in { -14, 14 } do
		local tr = block(props, "Transformer", Vector3.new(6, 8, 6), CFrame.new(x, 4, -238), Color3.fromRGB(70, 90, 80), Enum.Material.Metal)
		for k = 0, 3 do
			deco(props, "Fin", Vector3.new(6.4, 7, 0.2), tr.CFrame * CFrame.new(0, 0, -2.4 + k * 1.6), C.SteelDark, Enum.Material.Metal)
		end
		deco(props, "Insulator", Vector3.new(0.6, 2, 0.6), tr.CFrame * CFrame.new(0, 5, 0), Color3.fromRGB(150, 90, 60), Enum.Material.SmoothPlastic)
	end
	kit.panel(CFrame.new(19.4, 5, -230) * CFrame.Angles(0, math.rad(-90), 0), "c4_breaker", "INTERACT_HOLD_BREAKER", "OBJECT_BREAKER", { HoldDuration = 3, Sector = "TRANSFORMER" })
	kit.panel(CFrame.new(6, 5, -259.4), "c4_override", "INTERACT_HOLD_OVERRIDE", "OBJECT_BLAST_OVERRIDE", { HoldDuration = 3 })
	local blast = kit.door(Vector3.new(0, 0, -260), true, 10, true, "", { color = Color3.fromRGB(80, 84, 76), material = Enum.Material.DiamondPlate, prefix = "DB" })
	blast.Name = "BlastDoor"
	blast:SetAttribute("BlastDoor", true)
	kit.emergencyLight(Vector3.new(-18.5, 11, -255), "TRANSFORMER")
	kit.emergencyLight(Vector3.new(18.5, 11, -225), "TRANSFORMER")
	kit.document(CFrame.new(-16, 0.1, -226) * CFrame.Angles(0, 0.7, 0), "c4_shift_log")
	kit.firstAid(CFrame.new(-19.4, 5, -230) * CFrame.Angles(0, math.rad(90), 0))
	kit.checkpoint("C4_TRANSFORMER", CFrame.new(0, 0.5, -226))
	kit.patrol(Vector3.new(0, 0, -240), "TRANSFORMER")

	---------------------------------------------------------------------------
	-- Core cavern: the Echo-Array
	---------------------------------------------------------------------------
	local CH = 30
	tunnel(-45, -340, 45, -260, { s = { { 0, 10 } } }, CH, "ARRAY", false)
	local center = Vector3.new(0, 0, -300)
	deco(structure, "Grating", Vector3.new(60, 0.2, 60), CFrame.new(center + Vector3.new(0, 0.1, 0)), C.SteelDark, Enum.Material.DiamondPlate)
	for i = 0, 7 do
		local a = i / 8 * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * 26, 0, math.sin(a) * 26)
		block(props, "ArrayMast", Vector3.new(1.2, 22, 1.2), CFrame.new(p + Vector3.new(0, 11, 0)), C.SteelDark, Enum.Material.Metal)
		local dish = block(props, "ArrayDish", Vector3.new(0.6, 6, 6), CFrame.lookAt(p + Vector3.new(0, 20, 0), center + Vector3.new(0, 14, 0)) * CFrame.Angles(0, math.rad(90), 0), C.Plastic, Enum.Material.Metal)
		dish.Shape = Enum.PartType.Cylinder
		local tip = deco(props, "ArrayTip", Vector3.new(0.8, 0.8, 0.8), CFrame.new(p + Vector3.new(0, 22.5, 0)), Color3.fromRGB(120, 200, 255), Enum.Material.Neon)
		tip.Shape = Enum.PartType.Ball
		kit.tag(tip, "FZ_SectorLight", { Sector = "ARRAY", OnColor = Color3.fromRGB(120, 200, 255) })
		local light = Instance.new("PointLight")
		light.Range = 22
		light.Brightness = 1.4
		light.Color = Color3.fromRGB(120, 200, 255)
		light.Parent = tip
		CollectionService:AddTag(tip, "FZ_KeyLight")
	end
	local column = block(props, "CoreColumn", Vector3.new(24, 8, 8), CFrame.new(center + Vector3.new(0, 12, 0)) * CFrame.Angles(0, 0, math.rad(90)), C.Steel, Enum.Material.Metal)
	column.Shape = Enum.PartType.Cylinder
	local glow = deco(props, "CoreGlow", Vector3.new(14, 8.6, 8.6), CFrame.new(center + Vector3.new(0, 14, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(150, 210, 255), Enum.Material.Neon)
	glow.Shape = Enum.PartType.Cylinder
	glow.Transparency = 0.35
	kit.tag(glow, "FZ_SectorLight", { Sector = "ARRAY", OnColor = Color3.fromRGB(150, 210, 255) })
	glow:SetAttribute("CoreGlow", true)
	local coreLight = Instance.new("PointLight")
	coreLight.Range = 50
	coreLight.Brightness = 2
	coreLight.Color = Color3.fromRGB(150, 210, 255)
	coreLight.Parent = glow
	CollectionService:AddTag(glow, "FZ_KeyLight")
	for r = 0, 2 do
		local ring = deco(props, "CoreRing", Vector3.new(0.6, 14 + r * 4, 14 + r * 4), CFrame.new(center + Vector3.new(0, 4 + r * 7, 0)) * CFrame.Angles(0, 0, math.rad(90)), C.SteelDark, Enum.Material.Metal)
		ring.Shape = Enum.PartType.Cylinder
		ring.Transparency = 0.3
	end
	local console = block(props, "CoreConsole", Vector3.new(6, 3.6, 2.4), CFrame.new(center + Vector3.new(0, 1.8, 14)), C.SteelDark, Enum.Material.Metal)
	local screen = deco(props, "CoreScreen", Vector3.new(5, 1.8, 0.1), CFrame.new(center + Vector3.new(0, 4.5, 13.3)) * CFrame.Angles(math.rad(-15), 0, 0), Color3.fromRGB(120, 200, 255), Enum.Material.Neon)
	kit.worldText(screen, Enum.NormalId.Back, nil, "FREQ 000.000  ·  DURCHLAUF 0007", nil, Color3.fromRGB(10, 30, 50))
	kit.interactable(console, "c4_core", "INTERACT_ACTIVATE", "OBJECT_ARRAY_CORE", { HoldDuration = 2, MaxDistance = 9 })
	-- cavern lights: tall floodlights on the walls
	for _, p in { Vector3.new(-42, 18, -280), Vector3.new(42, 18, -280), Vector3.new(-42, 18, -330), Vector3.new(42, 18, -330) } do
		kit.floodLight(p, center + Vector3.new(0, 4, 0), Color3.fromRGB(200, 220, 255), 70)
	end
	kit.checkpoint("C4_CORE", CFrame.new(0, 0.5, -270))
	kit.patrol(Vector3.new(-30, 0, -300), "CORE")
	kit.patrol(Vector3.new(30, 0, -320), "CORE")
	kit.vent(Vector3.new(44.3, 1.5, -320), Vector3.new(-1, 0, 0), "deep")
	kit.speaker(Vector3.new(0, 20, -339), Vector3.new(0, 0, 1))
	kit.speaker(Vector3.new(0, 10, -121), Vector3.new(0, 0, -1))

	---------------------------------------------------------------------------
	-- Surface: yard, headframe, winding house
	---------------------------------------------------------------------------
	kit.previewGround(Vector3.new(0, -0.62, 150), Vector3.new(700, 1, 320), Color3.fromRGB(56, 54, 46))
	block(outside, "Yard", Vector3.new(120, 1, 90), CFrame.new(10, -0.45, 55), Color3.fromRGB(70, 64, 56), Enum.Material.Pebble)
	block(outside, "Road", Vector3.new(14, 1, 140), CFrame.new(0, -0.45, 170), C.Asphalt, Enum.Material.Asphalt)
	rails(Vector3.new(0, 0, 4), Vector3.new(0, 0, 60))
	-- headframe (lattice tower with sheaves)
	local hf = Vector3.new(38, 0, 30)
	for _, c in { { -5, -5 }, { 5, -5 }, { -5, 5 }, { 5, 5 } } do
		block(structure, "HeadframeLeg", Vector3.new(1, 36, 1), CFrame.new(hf + Vector3.new(c[1] * (1 - 0.3), 18, c[2] * (1 - 0.3))) * CFrame.Angles(c[2] * 0.04, 0, -c[1] * 0.04), C.Emergency:Lerp(C.SteelDark, 0.6), Enum.Material.Metal)
	end
	for y = 6, 30, 8 do
		block(structure, "HeadframeRing", Vector3.new(9, 0.6, 9), CFrame.new(hf + Vector3.new(0, y, 0)), C.SteelDark, Enum.Material.Metal).CanCollide = false
	end
	for _, dx in { -2, 2 } do
		local sheave = deco(structure, "Sheave", Vector3.new(0.6, 7, 7), CFrame.new(hf + Vector3.new(dx, 36, 0)), C.SteelDark, Enum.Material.Metal)
		sheave.Shape = Enum.PartType.Cylinder
	end
	-- winding house x 60..90, z 40..70 (the gate lever is inside)
	kit.room(60, 40, 90, 70, { h = 14, gaps = { w = { { 55, 6 } } }, wall = Color3.fromRGB(120, 60, 46), wallMaterial = Enum.Material.Brick, roof = Color3.fromRGB(60, 56, 54) })
	kit.door(Vector3.new(60, 0, 55), false, 6, false, nil, { prefix = "DW" })
	local drum = block(props, "WindingDrum", Vector3.new(8, 8, 8), CFrame.new(78, 5, 55), C.SteelDark, Enum.Material.Metal)
	drum.Shape = Enum.PartType.Cylinder
	kit.wheel(CFrame.new(68, 0, 48), "c4_winch", "INTERACT_PULL", "OBJECT_GATE_LEVER", { HoldDuration = 3 })
	kit.lightGrid(60, 90, 40, 70, "SURFACE", C.Warm)
	kit.document(CFrame.new(84, 3.25, 66) * CFrame.Angles(0, 0.4, 0), "c4_mine_notice")
	kit.desk(CFrame.new(84, 0, 66))
	kit.firstAid(CFrame.new(89.4, 5, 48) * CFrame.Angles(0, math.rad(-90), 0))
	for x = 64, 86, 11 do
		local pane = deco(structure, "Window", Vector3.new(4, 2.4, 0.15), CFrame.new(x, 9, 70.6), Color3.fromRGB(255, 214, 150), Enum.Material.Neon)
		pane.Transparency = 0.3
	end
	-- yard props
	for i = 0, 3 do
		local cart = block(props, "MineCart", Vector3.new(4, 3, 6), CFrame.new(0, 1.9, 20 + i * 8), Color3.fromRGB(90, 60, 40), Enum.Material.CorrodedMetal)
		cart.CanCollide = i ~= 0
	end
	for i = 0, 7 do
		kit.barrel(CFrame.new(-30 + (i % 4) * 3, 0, 40 + math.floor(i / 4) * 3), if i % 2 == 0 then Color3.fromRGB(150, 60, 34) else Color3.fromRGB(60, 70, 60))
	end
	for _ = 1, 6 do
		kit.crate(CFrame.new(kit.rng:NextNumber(-40, -20), 0, kit.rng:NextNumber(60, 90)) * CFrame.Angles(0, kit.rng:NextNumber(0, 6), 0))
	end
	block(outside, "SpoilHeap", Vector3.new(30, 12, 26), CFrame.new(-60, 3, 40) * CFrame.Angles(0, 0.3, math.rad(10)), Color3.fromRGB(52, 48, 44), Enum.Material.Slate)
	for _, p in { Vector3.new(-14, 0, 30), Vector3.new(24, 0, 80), Vector3.new(-14, 0, 110) } do
		block(outside, "LampPost", Vector3.new(0.5, 12, 0.5), CFrame.new(p + Vector3.new(0, 6, 0)), C.SteelDark, Enum.Material.Metal).CanCollide = false
		kit.bulb(p + Vector3.new(0, 12, 0), C.Sodium, 32, 1.8, "SURFACE", true)
	end
	kit.floodLight(Vector3.new(38, 30, 30), Vector3.new(0, 0, 10), C.Fluorescent, 70)
	kit.forest(130, -320, 320, 30, 380, { { -80, 0, 100, 130 }, { -16, 100, 16, 400 }, { -40, 130, 40, 260 } }, 0.2)
	kit.patrol(Vector3.new(0, 0, 50), "SURFACE")
	kit.patrol(Vector3.new(70, 0, 30), "SURFACE")

	---------------------------------------------------------------------------
	-- Survival ("Mine - Tiefschicht"): generators, stations, breakers, keys, fuses
	---------------------------------------------------------------------------
	kit.generator(CFrame.new(-50, 0, -142) * CFrame.Angles(0, math.rad(90), 0), 1)
	kit.generator(CFrame.new(50, 0, -117), 2)
	kit.station(CFrame.new(16, 1.5, -122), "mine_station_1")
	kit.station(CFrame.new(76, 1.5, -112), "mine_station_2")
	kit.station(CFrame.new(-36, 1.5, -336), "mine_station_3")
	kit.panel(CFrame.new(79.4, 5, -126) * CFrame.Angles(0, math.rad(-90), 0), "breaker", "INTERACT_HOLD_BREAKER", "OBJECT_BREAKER", { Sector = "PUMP" })
	kit.panel(CFrame.new(-79.4, 5, -112) * CFrame.Angles(0, math.rad(90), 0), "breaker", "INTERACT_HOLD_BREAKER", "OBJECT_BREAKER", { Sector = "LIFT" })
	kit.panel(CFrame.new(89.4, 5, 62) * CFrame.Angles(0, math.rad(-90), 0), "breaker", "INTERACT_HOLD_BREAKER", "OBJECT_BREAKER", { Sector = "SURFACE" })
	kit.panel(CFrame.new(-19.4, 5, -123) * CFrame.Angles(0, math.rad(90), 0), "mine_relay", "INTERACT_INSERT", "OBJECT_FUSE_PANEL", { HoldDuration = 3 }, C.Steel)
	kit.syncKey(CFrame.new(-4.4, 4.5, -56) * CFrame.Angles(0, math.rad(90), 0), 1)
	kit.syncKey(CFrame.new(-79.4, 4.5, -128) * CFrame.Angles(0, math.rad(90), 0), 2)
	for _, f in {
		{ CFrame.new(3.5, 0.4, -30), "MINE" }, { CFrame.new(-3.5, 0.4, -90), "MINE" },
		{ CFrame.new(18, 0.4, -138), "MINE" }, { CFrame.new(74, 0.4, -146), "PUMP" },
		{ CFrame.new(-76, 0.4, -146), "LIFT" }, { CFrame.new(-61, 0.4, -230), "LIFT" },
		{ CFrame.new(16, 0.4, -256), "TRANSFORMER" }, { CFrame.new(-40, 0.4, -300), "ARRAY" },
		{ CFrame.new(86.5, 3.45, 66.5), "SURFACE" },
	} do
		kit.fuseSpot(f[1], f[2])
	end
	local truck = block(outside, "Truck", Vector3.new(8, 7, 16), CFrame.new(-22, 3.6, 105) * CFrame.Angles(0, math.rad(-10), 0), Color3.fromRGB(150, 120, 40), Enum.Material.Metal)
	kit.interactable(truck, "mine_extract", "INTERACT_LEAVE", "OBJECT_TRUCK", { HoldDuration = 2, MaxDistance = 11 })
	kit.checkpoint("CP_SV_MINE", CFrame.new(20, 0.5, 70))

	---------------------------------------------------------------------------
	-- Markers
	---------------------------------------------------------------------------
	kit.checkpoint("C4_START", CFrame.new(0, 0.5, 115))
	kit.spawnLocation(CFrame.new(0, 0.5, 250))
	kit.creatureSpawn(CFrame.new(-74, 3, -122))
	for _, cf in {
		CFrame.new(3, 0.4, -40), CFrame.new(-3, 0.4, -100), CFrame.new(15, 0.4, -138), CFrame.new(76, 0.4, -146),
		CFrame.new(-44, 0.4, -146), CFrame.new(-61, 0.4, -220), CFrame.new(-16, 0.4, -256), CFrame.new(40, 0.4, -336),
		CFrame.new(84, 3.45, 65), CFrame.new(-28, 0.4, 70),
	} do
		kit.itemSpot(cf)
	end
	kit.menuCamera(1, Vector3.new(-30, 5, 100), Vector3.new(20, 18, 10), 7)
	kit.menuCamera(2, Vector3.new(0, 5, -112), Vector3.new(0, 4, -30), 4)
	kit.menuCamera(3, Vector3.new(-35, 10, -270), Vector3.new(0, 12, -300), 6)

	-- finishing pass: only the winding house gets painted walls (tunnels stay raw rock)
	local model = kit.root
	MapDress.Walls(model, { lower = Color3.fromRGB(70, 60, 50), rail = Color3.fromRGB(50, 40, 30), skirting = Color3.fromRGB(26, 24, 22), skip = { Enum.Material.Rock } })
	MapDress.LightCones(model, { "FloodLight" }, 50)
	MapDress.Mist(model, Vector3.new(0, 0, 60), Vector3.new(160, 0, 110), Color3.fromRGB(160, 160, 168), 1.1)
	MapDress.Mist(model, Vector3.new(0, 0, -300), Vector3.new(80, 0, 70), Color3.fromRGB(150, 190, 220), 1.6) -- cold mist on the Array floor
	MapDress.Mist(model, Vector3.new(0, 0, -200), Vector3.new(8, 0, 60), Color3.fromRGB(140, 140, 140), 0.6)
	MapDress.Steam(model, Vector3.new(-74, 13, -122), Vector3.yAxis) -- out of the lift shaft
	MapDress.Steam(model, Vector3.new(0, 26, -300), Vector3.yAxis, Color3.fromRGB(170, 210, 240)) -- the Array breathes
	MapDress.Steam(model, Vector3.new(66, 3, -130), Vector3.new(0, 1, 0.2))
	MapDress.Puddles(model, { { 2, -40, 4, 3 }, { -2, -95, 5, 3 }, { 0, -132, 7, 4 }, { 56, -138, 6, 5 }, { -60, -205, 4, 6 }, { 12, 40, 6, 4 } })
	MapDress.Flicker(model, 0.2, 55)
	for _, d in model:GetDescendants() do
		if d:IsA("BasePart") and d.Name == "Roof" and d.CFrame.Position.Y > 10 and d.CFrame.Position.Z > 30 then
			d.Material = Enum.Material.RoofShingles -- winding house
		end
	end
	return kit.finish()
end

function Map.BuildTerrain(model: Instance?)
	local terrain = workspace.Terrain
	terrain:FillBlock(CFrame.new(0, -5.1, 180), Vector3.new(900, 10, 400), Enum.Material.Ground)
	-- the mountain, then the tunnels carved out of it (each tunnel has its own walls/roof)
	terrain:FillBlock(CFrame.new(0, 30, -200), Vector3.new(700, 80, 400), Enum.Material.Rock)
	terrain:FillBlock(CFrame.new(0, 75, -230), Vector3.new(600, 30, 300), Enum.Material.Grass)
	for _, r in CARVE do
		local x0, z0, x1, z1 = r[1] - 1, r[2] - 1, r[3] + 1, r[4] + 1
		local h = if z1 < -258 then 33 else 17
		terrain:FillBlock(CFrame.new((x0 + x1) / 2, h / 2 - 0.5, (z0 + z1) / 2), Vector3.new(x1 - x0, h, z1 - z0), Enum.Material.Air)
	end
	local patches = Random.new(31)
	for _ = 1, 20 do
		local x, z = patches:NextNumber(-380, 380), patches:NextNumber(20, 400)
		if not (x > -80 and x < 100 and z < 130) and math.abs(x) > 10 then
			terrain:FillBall(Vector3.new(x, -2.4, z), patches:NextNumber(10, 24), if patches:NextNumber() < 0.5 then Enum.Material.Grass else Enum.Material.Mud)
		end
	end
	MapKit.ApplyClouds("mine")
	MapDress.TerrainLook({
		Grass = Color3.fromRGB(62, 70, 50),
		LeafyGrass = Color3.fromRGB(56, 64, 46),
		Ground = Color3.fromRGB(74, 66, 56),
		Mud = Color3.fromRGB(54, 48, 42),
		Rock = Color3.fromRGB(84, 80, 76),
	})
	MapKit.RemovePreview(model)
end

function Map.ApplyLighting()
	MapKit.ApplyLighting("mine")
end

function Map.Build(): Model
	local model = build()
	Map.ApplyLighting()
	if not Map.SkipTerrain then
		Map.BuildTerrain(model)
	end
	return model
end

return Map
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">RelayStation07</string>
            <string name="Source"><![CDATA[-- Relay Station 07 - script-built playable map following the concept floor plan:
--
--            N (-Z)
--   [Sektor C]──────[N-Halle]──────[Sektor D]
--   [Sektor B]─[W]─( ZENTRALKERN )─[O]─[Sektor A]
--   [Sektor E]──────[S-Halle]──────[Eingang/Kontrolle]──► Hof, Straße, Tor
--                     Außenbereich: Antenne (Extraktion)
--
-- Everything gameplay-relevant is expressed through tags + attributes, so you can replace
-- any part of it with your own Studio build later (see docs/MAP_CONTRACT.md):
--   FZ_Interactable, FZ_Door, FZ_SectorLight, FZ_FuseSpot, FZ_CreaturePatrol, FZ_Vent,
--   FZ_CreatureSpawn, FZ_Checkpoint, FZ_MenuCamera, FZ_WorldText, FZ_KeyLight.
-- It is only built when Workspace has no "FZ_Map" model.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local MapDress = require(script.Parent.MapDress)

local Map = {}

local H = 14 -- wall height
local DOOR_H = 10
local T = 1 -- wall thickness

local C = {
	Concrete = Color3.fromRGB(104, 104, 100),
	ConcreteDark = Color3.fromRGB(64, 66, 66),
	Floor = Color3.fromRGB(78, 74, 66),
	Linoleum = Color3.fromRGB(92, 84, 66),
	Steel = Color3.fromRGB(64, 84, 82),
	SteelDark = Color3.fromRGB(42, 48, 50),
	Wood = Color3.fromRGB(82, 62, 44),
	Plastic = Color3.fromRGB(190, 184, 170),
	Paper = Color3.fromRGB(226, 220, 204),
	Sodium = Color3.fromRGB(255, 170, 96),
	Fluorescent = Color3.fromRGB(214, 236, 230),
	Emergency = Color3.fromRGB(200, 40, 30),
	Screen = Color3.fromRGB(90, 220, 140),
	Asphalt = Color3.fromRGB(36, 38, 40),
	Pine = Color3.fromRGB(28, 44, 34),
	Bark = Color3.fromRGB(52, 40, 32),
}

local root: Model
local exteriorDetail: (outside: Instance) -> ()
local rng = Random.new(707)

---------------------------------------------------------------------------
-- Primitive helpers
---------------------------------------------------------------------------
local function block(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function folder(name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = root
	return f
end

local function tag(instance: Instance, tagName: string, attributes: { [string]: any }?)
	for key, value in attributes or {} do
		instance:SetAttribute(key, value)
	end
	CollectionService:AddTag(instance, tagName)
end

local function worldText(target: BasePart, face: Enum.NormalId, key: string?, staticText: string?, params: { [string]: string }?, color: Color3?, font: Enum.Font?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 1
	gui.AutoLocalize = false
	gui.Parent = target
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.FontFace = Font.fromEnum(font or Enum.Font.RobotoMono)
	label.TextScaled = true
	label.TextWrapped = true
	label.TextColor3 = color or Color3.fromRGB(30, 28, 26)
	label.Text = staticText or ""
	label.AutoLocalize = false
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.06, 0)
	padding.PaddingRight = UDim.new(0.06, 0)
	padding.PaddingTop = UDim.new(0.1, 0)
	padding.PaddingBottom = UDim.new(0.1, 0)
	padding.Parent = label
	if key then
		label:SetAttribute("LocKey", key)
		for name, value in params or {} do
			label:SetAttribute("LocParam_" .. name, value)
		end
		CollectionService:AddTag(label, "FZ_WorldText")
	end
	label.Parent = gui
	return label
end

---------------------------------------------------------------------------
-- Walls with door gaps. gaps = { { center, width } }
---------------------------------------------------------------------------
local walls: Folder

local function wallSegments(a: number, b: number, gaps: { { number } }?): { { number } }
	local segments = {}
	local cursor = a
	local sorted = table.clone(gaps or {})
	table.sort(sorted, function(x, y)
		return x[1] < y[1]
	end)
	for _, gap in sorted do
		local g0, g1 = gap[1] - gap[2] / 2, gap[1] + gap[2] / 2
		if g0 > cursor then
			table.insert(segments, { cursor, g0, false })
		end
		table.insert(segments, { g0, g1, true })
		cursor = g1
	end
	if cursor < b then
		table.insert(segments, { cursor, b, false })
	end
	return segments
end

-- Wall running along X at constant z.
local function wallZ(z: number, x0: number, x1: number, gaps: { { number } }?, color: Color3?)
	for _, s in wallSegments(x0, x1, gaps) do
		local width = s[2] - s[1]
		local mid = (s[1] + s[2]) / 2
		if s[3] then
			block(walls, "Lintel", Vector3.new(width, H - DOOR_H, T), CFrame.new(mid, DOOR_H + (H - DOOR_H) / 2, z), color or C.Concrete, Enum.Material.Concrete)
		else
			block(walls, "Wall", Vector3.new(width, H, T), CFrame.new(mid, H / 2, z), color or C.Concrete, Enum.Material.Concrete)
		end
	end
end

-- Wall running along Z at constant x.
local function wallX(x: number, z0: number, z1: number, gaps: { { number } }?, color: Color3?)
	for _, s in wallSegments(z0, z1, gaps) do
		local depth = s[2] - s[1]
		local mid = (s[1] + s[2]) / 2
		if s[3] then
			block(walls, "Lintel", Vector3.new(T, H - DOOR_H, depth), CFrame.new(x, DOOR_H + (H - DOOR_H) / 2, mid), color or C.Concrete, Enum.Material.Concrete)
		else
			block(walls, "Wall", Vector3.new(T, H, depth), CFrame.new(x, H / 2, mid), color or C.Concrete, Enum.Material.Concrete)
		end
	end
end

---------------------------------------------------------------------------
-- Doors: sliding steel doors, optionally power-locked
---------------------------------------------------------------------------
local doors: Folder
local doorCount = 0

local function door(center: Vector3, alongX: boolean, width: number, locked: boolean?, sector: string?)
	doorCount += 1
	local size = if alongX then Vector3.new(width, DOOR_H, 0.6) else Vector3.new(0.6, DOOR_H, width)
	local closed = CFrame.new(center.X, DOOR_H / 2, center.Z)
	local slide = if alongX then Vector3.new(width - 0.4, 0, 0) else Vector3.new(0, 0, width - 0.4)
	local panel = block(doors, "Door" .. doorCount, size, closed, C.Steel, Enum.Material.Metal)
	-- frame (two posts + header) and yellow/black hazard stripes on the floor
	local along = if alongX then Vector3.new(1, 0, 0) else Vector3.new(0, 0, 1)
	for _, sideSign in { -1, 1 } do
		local postPos = Vector3.new(center.X, DOOR_H / 2, center.Z) + along * sideSign * (width / 2 + 0.35)
		block(doors, "DoorFrame", if alongX then Vector3.new(0.7, DOOR_H, 1.6) else Vector3.new(1.6, DOOR_H, 0.7), CFrame.new(postPos), C.SteelDark, Enum.Material.Metal)
	end
	block(doors, "DoorHeader", if alongX then Vector3.new(width + 1.4, 0.9, 1.6) else Vector3.new(1.6, 0.9, width + 1.4), CFrame.new(center.X, DOOR_H + 0.45, center.Z), C.SteelDark, Enum.Material.Metal)
	local stripes = math.max(2, math.floor(width / 1.2))
	for i = 0, stripes - 1 do
		local offset = -width / 2 + (i + 0.5) * width / stripes
		local stripe = block(doors, "Hazard", if alongX then Vector3.new(width / stripes, 0.05, 2.4) else Vector3.new(2.4, 0.05, width / stripes), CFrame.new(center.X, 0.03, center.Z) + along * offset, if i % 2 == 0 then Color3.fromRGB(214, 170, 40) else Color3.fromRGB(26, 24, 22), Enum.Material.SmoothPlastic)
		stripe.CanCollide = false
	end
	local stripe = block(panel, "Stripe", if alongX then Vector3.new(width, 0.4, 0.7) else Vector3.new(0.7, 0.4, width), closed * CFrame.new(0, 1.5, 0), if locked then C.Emergency else C.Plastic, Enum.Material.Neon)
	stripe.CanCollide = false
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = panel
	weld.Part1 = stripe
	weld.Parent = panel
	stripe.Anchored = false
	local modifier = Instance.new("PathfindingModifier")
	modifier.PassThrough = not locked
	modifier.Parent = panel
	tag(panel, "FZ_Door", {
		DoorId = "D" .. doorCount,
		Open = false,
		Locked = locked == true,
		PowerSector = sector or "",
		ClosedCFrame = closed,
		OpenCFrame = closed + slide,
	})
	tag(panel, "FZ_Interactable", {
		InteractId = "door",
		ActionKey = "INTERACT_OPEN",
		ObjectKey = "OBJECT_DOOR",
		MaxDistance = 9,
	})
	return panel
end

---------------------------------------------------------------------------
-- Lights (tagged by sector so PowerService can switch them)
---------------------------------------------------------------------------
local lights: Folder
local lightsPerSector: { [string]: number } = {}

-- The first light of every sector is a key light (on at every graphics level), so no
-- room is ever pitch black on low-end devices; further lights are decorative.
local function ceilingLight(position: Vector3, sector: string, color: Color3?, shadows: boolean?, forceKey: boolean?)
	lightsPerSector[sector] = (lightsPerSector[sector] or 0) + 1
	-- the first TWO lights per sector are key lights (on at every graphics level)
	local key = forceKey or lightsPerSector[sector] <= 2
	local housing = block(lights, "LampHousing", Vector3.new(6.6, 0.45, 1.6), CFrame.new(position.X, H - 0.25, position.Z), C.SteelDark, Enum.Material.Metal)
	housing.CanCollide = false
	local fixture = block(lights, "Fixture_" .. sector, Vector3.new(6, 0.15, 1.1), CFrame.new(position.X, H - 0.52, position.Z), color or C.Fluorescent, Enum.Material.Neon)
	fixture.CanCollide = false
	fixture.CastShadow = false
	local light = Instance.new("SurfaceLight")
	light.Face = Enum.NormalId.Bottom
	light.Range = 28
	light.Angle = 140
	light.Brightness = 1.9
	light.Color = color or C.Fluorescent
	light.Shadows = shadows == true
	light.Parent = fixture
	tag(fixture, "FZ_SectorLight", { Sector = sector, OnColor = color or C.Fluorescent })
	if key then
		CollectionService:AddTag(fixture, "FZ_KeyLight")
	else
		CollectionService:AddTag(fixture, "FZ_DecorLight")
	end
	return fixture
end

-- Fill a rectangular room with a grid of ceiling lights (spacing ~14 studs).
local function lightGrid(x0: number, x1: number, z0: number, z1: number, sector: string, color: Color3?)
	local nx = math.max(1, math.floor((x1 - x0) / 16))
	local nz = math.max(1, math.floor((z1 - z0) / 14))
	for ix = 1, nx do
		for iz = 1, nz do
			local x = x0 + (x1 - x0) * (ix - 0.5) / nx
			local z = z0 + (z1 - z0) * (iz - 0.5) / nz
			ceilingLight(Vector3.new(x, 0, z), sector, color, ix == 1 and iz == 1)
		end
	end
end

local function emergencyLight(position: Vector3, sector: string)
	local lamp = block(lights, "Emergency", Vector3.new(0.8, 0.5, 0.8), CFrame.new(position), C.Emergency, Enum.Material.Neon)
	lamp.CanCollide = false
	local light = Instance.new("PointLight")
	light.Range = 14
	light.Brightness = 0.7
	light.Color = C.Emergency
	light.Parent = lamp
	CollectionService:AddTag(lamp, "FZ_KeyLight") -- emergency lights never turn off: readable darkness
	lamp:SetAttribute("Sector", sector)
	return lamp
end

