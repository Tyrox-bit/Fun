    </Properties>
    <Item class="Folder" referent="16">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">AdminConfig</string>
          <string name="Source"><![CDATA[-- Who may use the owner/maintenance tools.
-- Authorization is ALWAYS decided here on the server. The in-game "gesture code" only
-- reveals the menu for people who are already authorized; it never grants rights.

return {
	-- Additional developer UserIds (numbers). The experience owner is detected automatically:
	-- * user-owned experience: game.CreatorId
	-- * group-owned experience: members with rank >= MinGroupRank in the owning group
	UserIds = {
		-- 123456789,
	},
	MinGroupRank = 254,

	-- Everyone who can open the place in Studio is a developer of it, so Studio test
	-- sessions are authorized by default. Set to false to test the "denied" path.
	AllowAllInStudio = true,
}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Chapters</string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Chapter1</string>
            <string name="Source"><![CDATA[-- Chapter 1 "The Reception" - opening section (gatehouse).
-- Content only: all systems used here are generic and reusable.

local StoryService = require(script.Parent.Parent.Services.StoryService)
local InteractionService = require(script.Parent.Parent.Services.InteractionService)

local Chapter1 = {}

-- Arrival transmission. Sent per player when they first enter, so a friend who joins
-- later still gets their own "they just arrived" moment.
local ARRIVAL = {
	{ delay = 1.5, text = "SFX_STATIC", channel = "sfx", duration = 2 },
	{ delay = 1.0, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C1_001", channel = "radio", duration = 5.5 },
	{ delay = 5.8, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C1_002", channel = "radio", duration = 4 },
	{ delay = 5.0, text = "SFX_FAX", channel = "world", duration = 3, critical = false },
}

function Chapter1.Start()
	InteractionService.Register("c1_fax", function(player, _instance, _prompt)
		-- The fax was "sent" tomorrow at 02:14: first clue that the station receives the future.
		StoryService.ShowDocument(player, {
			title = "FAX_TITLE",
			body = "FAX_BODY",
			date = os.time() + 24 * 60 * 60,
		})
		if StoryService.GetFlag("C1_FaxRead") then
			return
		end
		StoryService.SetFlag("C1_FaxRead", true)
		StoryService.Sequence("all", {
			{ delay = 3, speaker = "SPEAKER_RELAY", text = "RADIO_C1_003", channel = "radio", duration = 3.5 },
		})
		task.delay(7, function()
			StoryService.SetObjective("OBJECTIVE_FIND_SENDER")
		end)
	end)
end

function Chapter1.OnPlayerEntered(player: Player, firstTime: boolean)
	if not firstTime then
		return
	end
	StoryService.Sequence(player, ARRIVAL)
	if StoryService.GetObjective() == nil then
		task.delay(14, function()
			if StoryService.GetObjective() == nil then
				StoryService.SetObjective("OBJECTIVE_CHECK_GATEHOUSE")
			end
		end)
	end
end

return Chapter1
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="20">
        <Properties>
          <string name="Name">Dev</string>
        </Properties>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Greybox</string>
            <string name="Source"><![CDATA[-- Greybox: a small, script-built test area (gate + gatehouse) so every system can be
-- tested on any device right after syncing - before the real map exists.
-- It is only built when Workspace has no "FZ_Map" model. Replace it by building the real
-- map in Studio, naming its root model "FZ_Map" and placing the same tags/attributes.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local Greybox = {}

local COLORS = {
	Asphalt = Color3.fromRGB(38, 40, 42),
	Concrete = Color3.fromRGB(112, 110, 104),
	ConcreteDark = Color3.fromRGB(72, 72, 70),
	PaintedSteel = Color3.fromRGB(70, 92, 88),
	Linoleum = Color3.fromRGB(96, 84, 64),
	Wood = Color3.fromRGB(86, 64, 46),
	Plastic = Color3.fromRGB(196, 190, 176),
	Paper = Color3.fromRGB(226, 220, 204),
	Sodium = Color3.fromRGB(255, 170, 96),
}

local function part(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

-- World text that every client renders in its own language (see WorldTextController).
local function worldText(target: BasePart, face: Enum.NormalId, key: string?, staticText: string?, params: { [string]: string }?, textColor: Color3?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.LightInfluence = 1
	gui.AutoLocalize = false
	gui.Parent = target
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.RobotoMono
	label.TextScaled = true
	label.TextWrapped = true
	label.TextColor3 = textColor or Color3.fromRGB(30, 28, 26)
	label.Text = staticText or ""
	label.AutoLocalize = false
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.06, 0)
	padding.PaddingRight = UDim.new(0.06, 0)
	padding.PaddingTop = UDim.new(0.08, 0)
	padding.PaddingBottom = UDim.new(0.08, 0)
	padding.Parent = label
	if key then
		label:SetAttribute("LocKey", key)
		for name, value in params or {} do
			label:SetAttribute("LocParam_" .. name, value)
		end
		CollectionService:AddTag(label, "FZ_WorldText")
	end
	label.Parent = gui
end

local function buildLighting()
	Lighting.ClockTime = 0.6
	Lighting.Brightness = 0.6
	Lighting.Ambient = Color3.fromRGB(18, 21, 24)
	Lighting.OutdoorAmbient = Color3.fromRGB(34, 40, 46)
	Lighting.EnvironmentDiffuseScale = 0.35
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.38
	atmosphere.Offset = 0.12
	atmosphere.Color = Color3.fromRGB(112, 124, 130)
	atmosphere.Decay = Color3.fromRGB(52, 62, 68)
	atmosphere.Glare = 0
	atmosphere.Haze = 1.4
	atmosphere.Parent = Lighting
end

function Greybox.Build()
	local root = Instance.new("Model")
	root.Name = "FZ_Greybox"

	-- Ground and access road
	part(root, "Ground", Vector3.new(220, 1, 220), CFrame.new(0, -0.5, 0), COLORS.Asphalt, Enum.Material.Asphalt)

	-- Gate: two concrete pillars, a steel beam, the station sign and a sodium lamp
	local gateZ = 10
	part(root, "GatePillarL", Vector3.new(2, 9, 2), CFrame.new(-9, 4.5, gateZ), COLORS.Concrete, Enum.Material.Concrete)
	part(root, "GatePillarR", Vector3.new(2, 9, 2), CFrame.new(9, 4.5, gateZ), COLORS.Concrete, Enum.Material.Concrete)
	part(root, "GateBeam", Vector3.new(20, 0.8, 0.8), CFrame.new(0, 8.6, gateZ), COLORS.PaintedSteel, Enum.Material.Metal)
	local sign = part(root, "StationSign", Vector3.new(10, 2.6, 0.3), CFrame.new(0, 6.6, gateZ + 0.6), COLORS.Plastic, Enum.Material.SmoothPlastic)
	worldText(sign, Enum.NormalId.Back, "SIGN_STATION")

	local lampPost = part(root, "LampPost", Vector3.new(0.5, 12, 0.5), CFrame.new(-13, 6, gateZ + 2), COLORS.PaintedSteel, Enum.Material.Metal)
	local lampHead = part(root, "LampHead", Vector3.new(1.8, 0.5, 1), lampPost.CFrame * CFrame.new(0.8, 6, 0), COLORS.Plastic, Enum.Material.Neon)
	lampHead.Color = COLORS.Sodium
	local lamp = Instance.new("SpotLight")
	lamp.Face = Enum.NormalId.Bottom
	lamp.Angle = 100
	lamp.Range = 34
	lamp.Brightness = 3
	lamp.Color = COLORS.Sodium
	lamp.Shadows = true
	lamp.Parent = lampHead
	CollectionService:AddTag(lampHead, "FZ_KeyLight")

	-- Gatehouse (behind the gate, door facing the players)
	local gx, gz = 0, -14
	local w, d, h = 16, 12, 9
	part(root, "GH_Floor", Vector3.new(w, 0.4, d), CFrame.new(gx, 0.2, gz), COLORS.Linoleum, Enum.Material.Plastic)
	part(root, "GH_Roof", Vector3.new(w + 1, 0.6, d + 1), CFrame.new(gx, h + 0.3, gz), COLORS.ConcreteDark, Enum.Material.Concrete)
	part(root, "GH_WallBack", Vector3.new(w, h, 0.6), CFrame.new(gx, h / 2, gz - d / 2), COLORS.Concrete, Enum.Material.Concrete)
	part(root, "GH_WallL", Vector3.new(0.6, h, d), CFrame.new(gx - w / 2, h / 2, gz), COLORS.Concrete, Enum.Material.Concrete)
	part(root, "GH_WallR", Vector3.new(0.6, h, d), CFrame.new(gx + w / 2, h / 2, gz), COLORS.Concrete, Enum.Material.Concrete)
	-- Front wall with a door opening (4 studs wide, 7 high) in the middle
	local side = (w - 4) / 2
	part(root, "GH_FrontL", Vector3.new(side, h, 0.6), CFrame.new(gx - 2 - side / 2, h / 2, gz + d / 2), COLORS.Concrete, Enum.Material.Concrete)
	part(root, "GH_FrontR", Vector3.new(side, h, 0.6), CFrame.new(gx + 2 + side / 2, h / 2, gz + d / 2), COLORS.Concrete, Enum.Material.Concrete)
	part(root, "GH_FrontTop", Vector3.new(4, h - 7, 0.6), CFrame.new(gx, 7 + (h - 7) / 2, gz + d / 2), COLORS.Concrete, Enum.Material.Concrete)

	-- Ceiling light (warm, slightly weak)
	local ceilingLamp = part(root, "GH_CeilingLamp", Vector3.new(3, 0.2, 0.8), CFrame.new(gx, h - 0.1, gz), COLORS.Plastic, Enum.Material.Neon)
	ceilingLamp.Color = Color3.fromRGB(255, 214, 160)
	local ceilingLight = Instance.new("PointLight")
	ceilingLight.Range = 16
	ceilingLight.Brightness = 0.9
	ceilingLight.Color = Color3.fromRGB(255, 206, 150)
	ceilingLight.Shadows = true
	ceilingLight.Parent = ceilingLamp
	CollectionService:AddTag(ceilingLamp, "FZ_KeyLight")

	-- Desk, fax machine (interactable) and logbook (code VESPER-0214)
	local desk = part(root, "GH_Desk", Vector3.new(7, 3, 2.6), CFrame.new(gx + 3, 1.9, gz - d / 2 + 1.8), COLORS.Wood, Enum.Material.Wood)
	local fax = part(root, "GH_Fax", Vector3.new(1.6, 0.6, 1.2), desk.CFrame * CFrame.new(1.6, 1.8, 0), COLORS.Plastic, Enum.Material.SmoothPlastic)
	fax:SetAttribute("InteractId", "c1_fax")
	fax:SetAttribute("ActionKey", "INTERACT_READ")
	fax:SetAttribute("ObjectKey", "OBJECT_FAX")
	fax:SetAttribute("MaxDistance", 7)
	CollectionService:AddTag(fax, "FZ_Interactable")
	local faxLed = Instance.new("PointLight")
	faxLed.Range = 3
	faxLed.Brightness = 1.5
	faxLed.Color = Color3.fromRGB(255, 90, 60)
	faxLed.Parent = fax

	local logbook = part(root, "GH_Logbook", Vector3.new(1.4, 0.1, 1), desk.CFrame * CFrame.new(-1.8, 1.55, 0.2), COLORS.Paper, Enum.Material.Fabric)
	worldText(logbook, Enum.NormalId.Top, nil, "02:14  VESPER-0214")

	-- Notice board with the maintenance note (code SIGNAL-017)
	local board = part(root, "GH_NoticeBoard", Vector3.new(4.5, 3.2, 0.2), CFrame.new(gx - w / 2 + 0.45, 4.6, gz - 1) * CFrame.Angles(0, math.rad(-90), 0), Color3.fromRGB(120, 96, 70), Enum.Material.Cardboard)
	local note = part(root, "GH_Note", Vector3.new(2.4, 1.9, 0.05), board.CFrame * CFrame.new(0.4, 0.2, -0.13), COLORS.Paper, Enum.Material.SmoothPlastic)
	worldText(note, Enum.NormalId.Front, "NOTE_MAINTENANCE", nil, { code = "SIGNAL-017" })

	-- Spawn, team checkpoint and menu camera
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "FZ_Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.CFrame = CFrame.new(0, 0.5, 46) -- behind the menu camera, out of shot
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = root
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end

	local checkpoint = part(root, "CP_C1_START", Vector3.new(4, 1, 4), CFrame.new(0, 0.5, 22) * CFrame.Angles(0, 0, 0), COLORS.Asphalt, Enum.Material.Asphalt)
	checkpoint.Transparency = 1
	checkpoint.CanCollide = false
	checkpoint.CanQuery = false
	checkpoint:SetAttribute("CheckpointId", "C1_START")
	CollectionService:AddTag(checkpoint, "FZ_Checkpoint")

	local menuCamera = part(root, "MenuCamera", Vector3.new(1, 1, 1), CFrame.lookAt(Vector3.new(-7, 3.2, 36), Vector3.new(0, 4.5, gz)), COLORS.Asphalt, Enum.Material.Plastic)
	menuCamera.Transparency = 1
	menuCamera.CanCollide = false
	menuCamera.CanQuery = false
	CollectionService:AddTag(menuCamera, "FZ_MenuCamera")

	buildLighting()
	root.Parent = workspace
	return root
end

return Greybox
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="22">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- FREQUENCY ZERO - server bootstrap.
-- Order matters: remotes and shared state first, then data, then gameplay services.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
require(Shared.Net).Init()
require(Shared.SessionState).Init()

if not workspace:FindFirstChild("FZ_Map") then
	require(script.Parent.Dev.Greybox).Build()
end

local SERVICES = {
	"DataService",
	"SettingsService",
	"AdminService",
	"CodeService",
	"InteractionService",
	"FlashlightService",
	"GameFlowService",
}

for _, name in SERVICES do
	local module = script.Parent.Services:FindFirstChild(name)
	local ok, err = pcall(function()
		require(module).Start()
	end)
	if not ok then
		warn(string.format("[FZ] %s failed to start: %s", name, tostring(err)))
	end
end

print("[FZ] Server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="23">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[-- AdminService: server-side authorization and audit log for maintenance tools.
--
-- Security model:
--   1. IsAuthorized() checks UserId / ownership on the server (cached per session).
--   2. The gesture code is read from ServerStorage at runtime (attribute
--      "FZ_AdminGesture", set by the owner in Studio, NOT committed to git). It only
--      unlocks the hidden menu entry for authorized players.
--   3. Every admin remote call re-checks authorization; the client-visible attribute
--      FZ_Admin is only a UI hint and is never trusted.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local AdminConfig = require(script.Parent.Parent.AdminConfig)
local DataService = require(script.Parent.DataService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local AdminService = {}

local authorizedCache: { [Player]: boolean } = {}
local unlocked: { [Player]: boolean } = {}
local auditLog: { { time: number, userId: number, name: string, action: string, detail: string } } = {}
local MAX_LOG = 200

function AdminService.Log(player: Player, action: string, detail: string?)
	local entry = {
		time = os.time(),
		userId = player.UserId,
		name = player.Name,
		action = action,
		detail = detail or "",
	}
	table.insert(auditLog, entry)
	if #auditLog > MAX_LOG then
		table.remove(auditLog, 1)
	end
	print(string.format("[FZ-ADMIN] %s (%d) %s %s", entry.name, entry.userId, action, entry.detail))
end

function AdminService.IsAuthorized(player: Player): boolean
	local cached = authorizedCache[player]
	if cached ~= nil then
		return cached
	end
	local authorized = false
	local certain = true
	if RunService:IsStudio() and AdminConfig.AllowAllInStudio then
		authorized = true
	elseif table.find(AdminConfig.UserIds, player.UserId) then
		authorized = true
	elseif game.CreatorType == Enum.CreatorType.User then
		authorized = player.UserId == game.CreatorId
	elseif game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
		if ok then
			authorized = rank >= AdminConfig.MinGroupRank
		else
			certain = false -- web call failed: do not cache a false negative
		end
	end
	if certain then
		authorizedCache[player] = authorized
	end
	return authorized
end

function AdminService.MatchesGesture(normalizedCode: string): boolean
	local gesture = ServerStorage:GetAttribute("FZ_AdminGesture")
	if type(gesture) ~= "string" or #gesture < 6 then
		return false
	end
	return string.upper(gesture) == normalizedCode
end

function AdminService.Unlock(player: Player)
	unlocked[player] = true
	player:SetAttribute("FZ_Admin", true)
	AdminService.Log(player, "unlock")
end

local function isAllowed(player: Player): boolean
	return unlocked[player] == true and AdminService.IsAuthorized(player)
end

local ACTIONS = {}

ACTIONS.grant_test_marks = function(player: Player)
	local ok = DataService.Mutate(player, function(data)
		data.signalMarks += 100
	end)
	return { ok = ok }
end

ACTIONS.get_log = function()
	local recent = {}
	for i = math.max(1, #auditLog - 19), #auditLog do
		table.insert(recent, auditLog[i])
	end
	return { ok = true, log = recent }
end

function AdminService.Start()
	if type(ServerStorage:GetAttribute("FZ_AdminGesture")) ~= "string" then
		warn("[FZ-ADMIN] No gesture configured. Set the string attribute 'FZ_AdminGesture' on ServerStorage (min. 6 characters) to enable the hidden maintenance entry.")
	end

	local limiter = RateLimiter.new(10, 1)
	Net.Function("AdminAction").OnServerInvoke = function(player: Player, action: any, _payload: any)
		if not limiter:Allow(player) then
			return { ok = false, reason = "rate_limited" }
		end
		if type(action) ~= "string" or not isAllowed(player) then
			AdminService.Log(player, "denied", tostring(action))
			return { ok = false, reason = "denied" }
		end
		local handler = ACTIONS[action]
		if not handler then
			return { ok = false, reason = "unknown" }
		end
		AdminService.Log(player, action)
		return handler(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		authorizedCache[player] = nil
		unlocked[player] = nil
	end)
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">CodeService</string>
            <string name="Source"><![CDATA[-- CodeService: redeemable codes hidden inside the game world.
-- Codes are defined in ServerStorage.Secrets.Codes (never replicated to clients), checked
-- server-side, redeemable once per account (session lock in DataService prevents
-- cross-server duplication) and saved immediately.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local AdminService = require(script.Parent.AdminService)
local DataService = require(script.Parent.DataService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local Codes = require(ServerStorage:WaitForChild("Secrets"):WaitForChild("Codes"))

local CodeService = {}

local function normalize(raw: string): string
	local trimmed = string.gsub(raw, "%s+", "")
	return string.upper(trimmed)
end

function CodeService.Redeem(player: Player, raw: any): { [string]: any }
	if type(raw) ~= "string" or #raw == 0 or #raw > Config.Codes.MaxLength * 2 then
		return { status = "invalid" }
	end
	local code = normalize(raw)
	if #code == 0 or #code > Config.Codes.MaxLength then
		return { status = "invalid" }
	end

	if AdminService.MatchesGesture(code) then
		if AdminService.IsAuthorized(player) then
			AdminService.Unlock(player)
			return { status = "admin" }
		end
		AdminService.Log(player, "gesture_denied")
		return { status = "invalid" } -- indistinguishable from a wrong code
	end

	local definition = Codes[code]
	if not definition or definition.active == false then
		return { status = "invalid" }
	end

	local profile = DataService.Get(player)
	if not profile or not profile.Persistent then
		-- Never hand out a reward that cannot be saved (and could then be redeemed again).
		return { status = "error" }
	end
	if profile.Data.redeemedCodes[definition.id] then
		return { status = "used" }
	end

	-- No yield between the check above and this write, so double invocations are safe.
	local amount = definition.reward.signalMarks or 0
	DataService.Mutate(player, function(data)
		data.redeemedCodes[definition.id] = os.time()
		data.signalMarks += amount
	end)
	DataService.SaveNow(player) -- if this fails, autosave retries; the profile stays locked
	return { status = "ok", amount = amount, balance = profile.Data.signalMarks }
end

function CodeService.Start()
	local limiter = RateLimiter.new(5, 1 / 6) -- burst 5, then one attempt every 6 s
	Net.Function("RedeemCode").OnServerInvoke = function(player: Player, raw: any)
		if not limiter:Allow(player) then
			return { status = "rate_limited" }
		end
		return CodeService.Redeem(player, raw)
	end
end

return CodeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- DataService: persistent player data with session locking.
--
-- * One profile per player, loaded with UpdateAsync and locked to this server (JobId),
--   so two servers can never write the same save at the same time (protects codes,
--   currency and progress against duplication when a player hops servers quickly).
-- * Autosave refreshes the lock; leaving releases it.
-- * If DataStores are unavailable (Studio without API access, outage) the player gets a
--   session-only profile and is told that progress will not be saved. Anything that must
--   persist (code rewards, purchases) refuses to run on such a profile.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Signal = require(Shared.Signal)
local Net = require(Shared.Net)

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local DataService = {}
DataService.ProfileLoaded = Signal.new() -- (player, profile)

export type Profile = {
	Player: Player,
	Key: string,
	Data: { [string]: any },
	Persistent: boolean,
	Dirty: boolean,
	Saving: boolean,
	Released: boolean,
}

local profiles: { [Player]: Profile } = {}
local store: DataStore? = nil

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Data.StoreName)
	end)
	if ok then
		store = result
	else
		warn("[FZ-Data] DataStore unavailable, running session-only: " .. tostring(result))
	end
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

local function defaultData(): { [string]: any }
	return {
		version = Config.Data.SchemaVersion,
		settings = Config.DefaultSettings(),
		signalMarks = 0,
		redeemedCodes = {}, -- [codeId] = unix time
		progress = {
			chapter = 1,
			checkpoint = "C1_START",
			completed = {}, -- array of chapter numbers
		},
		stats = { sessions = 0, firstJoin = os.time(), lastJoin = 0 },
	}
end

local function reconcile(data: { [string]: any }, template: { [string]: any })
	for key, value in template do
		if data[key] == nil then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil then
			reconcile(data[key], value)
		end
	end
end

local function sanitizeSettings(settings: { [string]: any })
	for key, definition in Config.Settings do
		local value = settings[key]
		if value ~= nil then
			local ok = Config.ValidateSetting(key, value)
			if not ok then
				settings[key] = definition.default
			end
		end
	end
	for key in settings do
		if Config.Settings[key] == nil then
			settings[key] = nil
		end
	end
end

-- Schema migrations. Add a branch for every SchemaVersion bump.
local function migrate(data: { [string]: any })
	local version = tonumber(data.version) or 0
	-- if version < 2 then ... end
	if version < Config.Data.SchemaVersion then
		data.version = Config.Data.SchemaVersion
	end
end

local function prepare(data: { [string]: any })
	migrate(data)
	reconcile(data, defaultData())
	if type(data.settings) ~= "table" then
		data.settings = Config.DefaultSettings()
	end
	sanitizeSettings(data.settings)
	if type(data.signalMarks) ~= "number" or data.signalMarks ~= data.signalMarks or data.signalMarks < 0 then
		data.signalMarks = 0
	end
	data.signalMarks = math.floor(data.signalMarks)
end

local function withRetries(label: string, attempts: number, callback: () -> any): (boolean, any)
	local delayTime = 1
	for attempt = 1, attempts do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		warn(string.format("[FZ-Data] %s failed (attempt %d/%d): %s", label, attempt, attempts, tostring(result)))
		if attempt < attempts then
			task.wait(delayTime)
			delayTime = math.min(delayTime * 2, 8)
		end
	end
	return false, nil
end

local function publishAttributes(profile: Profile)
	local player = profile.Player
	player:SetAttribute("FZ_SignalMarks", profile.Data.signalMarks)
	player:SetAttribute("FZ_DataPersistent", profile.Persistent)
end

local function loadProfile(player: Player): Profile?
	local key = "u_" .. player.UserId
	local profile: Profile = {
		Player = player,
		Key = key,
		Data = {},
		Persistent = false,
		Dirty = false,
		Saving = false,
		Released = false,
	}

	local loaded = nil
	if store then
		local maxLockAttempts = 6
		for lockAttempt = 1, maxLockAttempts do
			local lockedByOther = false
			local ok, result = withRetries("Load " .. key, 4, function()
				return (store :: DataStore):UpdateAsync(key, function(old)
					lockedByOther = false
					local data = if type(old) == "table" then old else defaultData()
					local lock = data.lock
					if
						type(lock) == "table"
						and lock.job ~= game.JobId
						and os.time() - (tonumber(lock.time) or 0) < Config.Data.LockTimeout
						and lockAttempt < maxLockAttempts
					then
						-- Another server still owns this save (usually: it is finishing the
						-- save after the player left). Abort this write and retry shortly.
						lockedByOther = true
						return nil
					end
					prepare(data)
					data.lock = { job = game.JobId, time = os.time() }
					data.stats.sessions += 1
					data.stats.lastJoin = os.time()
					return data
				end)
			end)
			if not ok then
				break
			end
			if not lockedByOther and type(result) == "table" then
				loaded = result
				break
			end
			if player.Parent == nil then
				return nil
			end
			task.wait(5)
		end
	end

	if loaded then
		profile.Data = loaded
		profile.Persistent = true
	else
		profile.Data = defaultData()
		profile.Persistent = false
		if store then
			warn("[FZ-Data] Using session-only profile for " .. key)
		end
	end
	return profile
end

local function saveProfile(profile: Profile, release: boolean): boolean
	if not profile.Persistent or not store then
		return true
	end
	while profile.Saving do
		task.wait()
	end
	if profile.Released then
		return true
	end
	profile.Saving = true
	local lostLock = false
	local wasDirty = profile.Dirty
	local ok = withRetries("Save " .. profile.Key, if release then 5 else 3, function()
		return (store :: DataStore):UpdateAsync(profile.Key, function(old)
			lostLock = false
			if type(old) == "table" and type(old.lock) == "table" and old.lock.job ~= game.JobId then
				lostLock = true
				return nil
			end
			local out = table.clone(profile.Data)
			out.lock = if release then nil else { job = game.JobId, time = os.time() }
			return out
		end)
	end)
	profile.Saving = false
	if lostLock then
		-- Another server took this save over. Never overwrite it from here.
		warn("[FZ-Data] Lost session lock for " .. profile.Key .. "; profile is now read-only")
		profile.Persistent = false
		publishAttributes(profile)
		return false
	end
	if ok then
		if wasDirty then
			profile.Dirty = false
		end
		if release then
			profile.Released = true
		end
	end
	return ok
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function DataService.Get(player: Player): Profile?
	return profiles[player]
end

function DataService.WaitFor(player: Player, timeout: number?): Profile?
	local deadline = os.clock() + (timeout or 20)
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

-- Mutate data through this function so the profile is marked dirty.
function DataService.Mutate(player: Player, mutator: ({ [string]: any }) -> ()): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	mutator(profile.Data)
	profile.Dirty = true
	publishAttributes(profile)
	return true
end

-- Immediate save for important changes (code rewards, chapter completion).
function DataService.SaveNow(player: Player): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	return saveProfile(profile, false)
end

function DataService.Start()
	local fetchLimiter = RateLimiter.new(3, 0.2)

	local function onPlayerAdded(player: Player)
		local profile = loadProfile(player)
		if not profile then
			return
		end
		if player.Parent == nil then
			-- Left while loading: release the lock right away.
			saveProfile(profile, true)
			return
		end
		profiles[player] = profile
		publishAttributes(profile)
		player:SetAttribute("FZ_DataReady", true)
		DataService.ProfileLoaded:Fire(player, profile)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		local profile = profiles[player]
		if profile then
			saveProfile(profile, true)
			profiles[player] = nil
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for _, profile in profiles do
			pending += 1
			task.spawn(function()
				saveProfile(profile, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveInterval)
			for _, profile in profiles do
				-- Always save: this also refreshes the session lock.
				task.spawn(saveProfile, profile, false)
			end
		end
	end)

	Net.Function("FetchProfile").OnServerInvoke = function(player: Player)
		if not fetchLimiter:Allow(player) then
			return nil
		end
		local profile = DataService.WaitFor(player, 20)
		if not profile then
			return nil
		end
		local data = profile.Data
		return {
			settings = deepCopy(data.settings),
			signalMarks = data.signalMarks,
			progress = { chapter = data.progress.chapter, completed = deepCopy(data.progress.completed) },
			persistent = profile.Persistent,
			isNew = data.stats.sessions <= 1,
		}
	end
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">FlashlightService</string>
            <string name="Source"><![CDATA[-- FlashlightService: replicated flashlight so teammates see each other's light.
-- The owning client additionally renders a camera-aligned local light for precision
-- and mutes its own replicated copy (see FlashlightController).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local FlashlightService = {}

local function attach(character: Model)
	local head = character:WaitForChild("Head", 10)
	if not head or not head:IsA("BasePart") or head:FindFirstChild("FZ_Flashlight") then
		return
	end
	local light = Instance.new("SpotLight")
	light.Name = "FZ_Flashlight"
	light.Face = Enum.NormalId.Front
	light.Angle = 55
	light.Range = 38
	light.Brightness = 2.2
	light.Color = Color3.fromRGB(255, 236, 206)
	light.Shadows = true
	light.Enabled = false
	light.Parent = head
end

function FlashlightService.Start()
	local limiter = RateLimiter.new(6, 3)
	Net.Event("SetFlashlight").OnServerEvent:Connect(function(player: Player, enabled: any)
		if type(enabled) ~= "boolean" or not limiter:Allow(player) then
			return
		end
		local head = player.Character and player.Character:FindFirstChild("Head")
		local light = head and head:FindFirstChild("FZ_Flashlight")
		if light and light:IsA("SpotLight") then
			light.Enabled = enabled
		end
	end)

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(attach)
		if player.Character then
			task.spawn(attach, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return FlashlightService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">GameFlowService</string>
            <string name="Source"><![CDATA[-- GameFlowService: session flow (menu -> in game), checkpoints and chapter hooks.
--
-- Party model: one Roblox server = one team (max 4, set "Max Players" to 4 in Game
-- Settings). Story progress is shared per server through SessionState. Nobody waits for
-- anyone: a player who presses Play enters immediately; friends who join later are
-- placed at the team's current checkpoint.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local CHECKPOINT_TAG = "FZ_Checkpoint"

local GameFlowService = {}

local chapters = {
	[1] = require(script.Parent.Parent.Chapters.Chapter1),
}

local inGame: { [Player]: boolean } = {}
local entered: { [Player]: boolean } = {} -- entered at least once this session

local function findCheckpoint(id: string): BasePart?
	for _, part in CollectionService:GetTagged(CHECKPOINT_TAG) do
		if part:IsA("BasePart") and part:GetAttribute("CheckpointId") == id then
			return part
		end
	end
	return nil
end

local function placeAtCheckpoint(player: Player)
	local character = player.Character
	if not character then
		return
	end
	local checkpoint = findCheckpoint(SessionState.Get("Checkpoint") or "C1_START")
	if not checkpoint then
		return -- fall back to the default SpawnLocation
	end
	-- Spread the team a little so nobody spawns inside a teammate.
	local index = table.find(Players:GetPlayers(), player) or 1
	local offset = Vector3.new(((index - 1) % 2) * 3 - 1.5, 3, math.floor((index - 1) / 2) * 3)
	local target = checkpoint.CFrame * CFrame.new(offset)
	pcall(function()
		player:RequestStreamAroundAsync(target.Position, 5)
	end)
	if player.Character == character then
		character:PivotTo(target)
	end
end

function GameFlowService.SetCheckpoint(id: string)
	SessionState.Set("Checkpoint", id)
end

function GameFlowService.Start()
	SessionState.Set("Chapter", 1)
	SessionState.Set("Checkpoint", "C1_START")

	for _, chapter in chapters do
		chapter.Start()
	end

	local limiter = RateLimiter.new(2, 0.5)
	Net.Event("ClientReady").OnServerEvent:Connect(function(player: Player)
		if not limiter:Allow(player) or inGame[player] then
			return
		end
		inGame[player] = true
		player:SetAttribute("FZ_InGame", true)
		placeAtCheckpoint(player)
		local firstTime = not entered[player]
		entered[player] = true
		local chapter = chapters[SessionState.Get("Chapter") or 1]
		if chapter and chapter.OnPlayerEntered then
			chapter.OnPlayerEntered(player, firstTime)
		end
	end)

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function()
			if inGame[player] then
				task.defer(placeAtCheckpoint, player)
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		inGame[player] = nil
		entered[player] = nil
	end)
end

return GameFlowService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">InteractionService</string>
            <string name="Source"><![CDATA[-- InteractionService: one interaction system for every platform.
--
-- Level designers tag an object (BasePart, Model or Attachment) with "FZ_Interactable"
-- and set attributes:
--   InteractId   (string, required) handler id registered by a chapter module
--   ActionKey    (string) localization key for the verb, e.g. "INTERACT_READ"
--   ObjectKey    (string) localization key for the object, e.g. "OBJECT_FAX"
--   HoldDuration (number, optional) seconds to hold
--   MaxDistance  (number, optional) default 8 studs
--
-- A ProximityPrompt is generated automatically. ProximityPrompts give us keyboard (E),
-- gamepad (X / Square) and touch (tap) with the same logical action for free.
-- Text is localized per player on the client (prompts are tagged "FZ_Prompt").
-- The server validates distance and rate-limits every trigger.

local CollectionService = game:GetService("CollectionService")

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local TAG = "FZ_Interactable"
local PROMPT_TAG = "FZ_Prompt"
local DISTANCE_TOLERANCE = 6

local InteractionService = {}

type Handler = (player: Player, instance: Instance, prompt: ProximityPrompt) -> ()
local handlers: { [string]: Handler } = {}
local limiter = RateLimiter.new(6, 3)

function InteractionService.Register(id: string, handler: Handler)
	assert(handlers[id] == nil, "[FZ-Interact] Duplicate handler id: " .. id)
	handlers[id] = handler
end

local function worldPosition(instance: Instance): Vector3?
	if instance:IsA("BasePart") then
		return instance.Position
	elseif instance:IsA("Model") then
		return instance:GetPivot().Position
	elseif instance:IsA("Attachment") then
		return instance.WorldPosition
	end
	return nil
end

local function onTriggered(player: Player, instance: Instance, prompt: ProximityPrompt)
	if not limiter:Allow(player) or not prompt.Enabled then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	local position = worldPosition(instance)
	if not position or ((root :: BasePart).Position - position).Magnitude > prompt.MaxActivationDistance + DISTANCE_TOLERANCE then
		return
	end
	local id = instance:GetAttribute("InteractId")
	local handler = if type(id) == "string" then handlers[id] else nil
	if not handler then
		warn("[FZ-Interact] No handler for InteractId " .. tostring(id) .. " on " .. instance:GetFullName())
		return
	end
	local ok, err = pcall(handler, player, instance, prompt)
	if not ok then
		warn("[FZ-Interact] Handler " .. id .. " failed: " .. tostring(err))
	end
end

local function setup(instance: Instance)
	if not worldPosition(instance) then
		warn("[FZ-Interact] Unsupported interactable: " .. instance:GetFullName())
		return
	end
	local prompt = instance:FindFirstChild("FZ_Prompt")
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = "FZ_Prompt"
		prompt.Parent = instance
	end
	local p = prompt :: ProximityPrompt
	p.ActionText = "" -- localized on each client
	p.ObjectText = ""
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonX
	p.HoldDuration = tonumber(instance:GetAttribute("HoldDuration")) or 0
	p.MaxActivationDistance = tonumber(instance:GetAttribute("MaxDistance")) or 8
	p.RequiresLineOfSight = true
	p:SetAttribute("FZ_Action", instance:GetAttribute("ActionKey"))
	p:SetAttribute("FZ_Object", instance:GetAttribute("ObjectKey"))
	CollectionService:AddTag(p, PROMPT_TAG)
	p.Triggered:Connect(function(player)
		onTriggered(player, instance, p)
	end)
end

function InteractionService.Start()
	CollectionService:GetInstanceAddedSignal(TAG):Connect(setup)
	for _, instance in CollectionService:GetTagged(TAG) do
		setup(instance)
	end
end

return InteractionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">SettingsService</string>
            <string name="Source"><![CDATA[-- SettingsService: persists player settings (language, subtitles, accessibility, graphics).
-- Settings are not security relevant, but are still validated against the shared schema
-- so a manipulated client can never write garbage into the save.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local SettingsService = {}

function SettingsService.Start()
	local limiter = RateLimiter.new(20, 5)
	Net.Event("UpdateSetting").OnServerEvent:Connect(function(player: Player, key: any, value: any)
		if not limiter:Allow(player) then
			return
		end
		local ok, sanitized = Config.ValidateSetting(key, value)
		if not ok then
			return
		end
		DataService.Mutate(player, function(data)
			data.settings[key] = sanitized
		end)
	end)
end

return SettingsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">StoryService</string>
            <string name="Source"><![CDATA[-- StoryService: sends story content (subtitles, documents, objectives) to clients.
-- Only localization KEYS travel over the network; every client renders them in its own
-- language. Targets can be a single player (individual perception) or "all".

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local StoryService = {}

export type Line = {
	text: string, -- localization key
	speaker: string?, -- localization key
	params: { [string]: any }?,
	duration: number?,
	channel: string?, -- "radio" | "world" | "sfx"
	critical: boolean?, -- shown even with subtitles off (safety-relevant sounds)
	delay: number?, -- seconds to wait before this line (Sequence only)
}

type Target = Player | "all"

local subtitleRemote = Net.Event("Subtitle")
local documentRemote = Net.Event("Document")
local flags: { [string]: any } = {}

function StoryService.Say(target: Target, line: Line)
	if target == "all" then
		subtitleRemote:FireAllClients(line)
	else
		subtitleRemote:FireClient(target :: Player, line)
	end
end

function StoryService.Sequence(target: Target, lines: { Line })
	task.spawn(function()
		for _, line in lines do
			if line.delay then
				task.wait(line.delay)
			end
			if target ~= "all" and (target :: Player).Parent == nil then
				return
			end
			StoryService.Say(target, line)
		end
	end)
end

function StoryService.ShowDocument(player: Player, document: { [string]: any })
	documentRemote:FireClient(player, document)
end

function StoryService.SetObjective(key: string?)
	SessionState.Set("Objective", key)
end

function StoryService.GetObjective(): string?
	return SessionState.Get("Objective")
end

-- Session flags are shared by the whole team and replicated as "Flag_<name>".
function StoryService.SetFlag(name: string, value: any)
	flags[name] = value
	SessionState.Set("Flag_" .. name, value)
end

function StoryService.GetFlag(name: string): any
	return flags[name]
end

return StoryService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="32">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[-- Token-bucket rate limiter per player. Every client->server remote uses one.

local Players = game:GetService("Players")

local RateLimiter = {}
RateLimiter.__index = RateLimiter

local limiters = {}

Players.PlayerRemoving:Connect(function(player)
	for _, limiter in limiters do
		limiter._buckets[player] = nil
	end
end)

-- capacity: burst size, refillPerSecond: sustained rate
function RateLimiter.new(capacity: number, refillPerSecond: number)
	local self = setmetatable({
		_capacity = capacity,
		_refill = refillPerSecond,
		_buckets = {},
	}, RateLimiter)
	table.insert(limiters, self)
	return self
end

function RateLimiter:Allow(player: Player, cost: number?): boolean
	local price = cost or 1
	local now = os.clock()
	local bucket = self._buckets[player]
	if not bucket then
		bucket = { tokens = self._capacity, time = now }
		self._buckets[player] = bucket
	end
	bucket.tokens = math.min(self._capacity, bucket.tokens + (now - bucket.time) * self._refill)
	bucket.time = now
	if bucket.tokens < price then
		return false
	end
	bucket.tokens -= price
	return true
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
