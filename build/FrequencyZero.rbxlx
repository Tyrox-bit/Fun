	VALUE_HOLD = "Segurar",
	VALUE_TOGGLE = "Alternar",
	TOUCH_RADIO = "Rádio",
	TOUCH_MIC = "Mic",
	TOUCH_NIGHT = "Noite",
	RADIO_TX = "TRANSMITINDO",
	RADIO_RX = "Recebendo: {name}",
	MIC_ON = "Microfone aberto",
	MIC_OFF = "Microfone mudo",
	MIC_MUTE = "Silenciar meu microfone",
	MIC_UNMUTE = "Ativar meu microfone",
	VOICE_UNAVAILABLE = "O chat de voz está desligado na sua conta. Você ainda pode ouvir o rádio e jogar normalmente.",
	LOBBY_MUTE = "Silenciar",
	LOBBY_UNMUTE = "Ativar",
	MENU_SHOP = "Loja",
	SHOP_TAB_GEAR = "Equipamento",
	SHOP_TAB_UPGRADES = "Melhorias",
	SHOP_TAB_COSMETIC = "Cosméticos",
	SHOP_BUY = "Desbloquear · {price}",
	SHOP_EQUIP = "Equipar",
	SHOP_EQUIPPED = "Equipado",
	SHOP_UNEQUIP = "Remover",
	SHOP_OWNED = "Desbloqueado",
	SHOP_CONFIRM = "Desbloquear por {price} marcas de sinal?",
	SHOP_CONFIRM_YES = "Sim, desbloquear",
	SHOP_NOT_ENOUGH = "Ainda não há marcas de sinal suficientes.",
	SHOP_DONE = "Desbloqueado.",
	SHOP_ERROR = "Não deu certo. Nada foi descontado.",
	SHOP_FAIR = "Equipamentos só se conseguem jogando, nunca com Robux.",
	SHOP_ONE_SET = "Só é possível equipar um conjunto por vez.",
	ITEM_TECH_NAME = "Kit de técnico",
