      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Assets</string>
          <string name="Source"><![CDATA[-- Asset registry. The ONLY place where Roblox asset ids live.
-- Empty string = not uploaded yet: the game runs silently / with built-in fallbacks.
--
-- Sounds: upload the files from assets/audio/*.ogg (generated by tools/generate_sounds.py,
-- 100 % original) in the Creator Hub -> Development Items -> Audio, then paste the ids
-- here as "rbxassetid://<id>". Never invent ids.
--
-- Creature: put your own monster model into ServerStorage.Creatures (see docs/CREATURE.md)
-- and optionally its animation ids below. Without ids the built-in procedural
-- animation is used for the placeholder creature.

return {
	Sounds = {
		radio_static_loop = "",
		radio_squelch_on = "",
		radio_squelch_off = "",
		radio_channel_beep = "",
		hum_electric_loop = "",
		generator_loop = "",
		ambience_wind_loop = "",
		creature_click = "",
		creature_static_burst = "",
		creature_breath = "",
		creature_alert = "",
		heartbeat = "",
		footstep_concrete_1 = "",
		footstep_concrete_2 = "",
		footstep_concrete_3 = "",
		footstep_metal_1 = "",
		footstep_metal_2 = "",
		footstep_grass_1 = "",
		footstep_grass_2 = "",
		door_open = "",
		door_locked = "",
		fuse_pickup = "",
		relay_activate = "",
		power_down = "",
		vent_rattle = "",
		ui_focus = "",
		ui_select = "",
		stinger_low = "",
	},
	CreatureAnimations = {
		Idle = "",
		Walk = "",
		Run = "",
		Attack = "",
		Listen = "",
	},
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Catalog</string>
          <string name="Source"><![CDATA[-- Shop catalog. Prices are in Signal Marks (earned in-game only).
-- Fair-play rule: equipment that changes gameplay can ONLY be earned with Signal Marks.
-- Robux products are cosmetic only and there is no Robux -> Signal Marks conversion.

local Catalog = {}

Catalog.Tabs = { "gear", "upgrades", "cosmetic" }
Catalog.TabLabels = { gear = "SHOP_TAB_GEAR", upgrades = "SHOP_TAB_UPGRADES", cosmetic = "SHOP_TAB_COSMETIC" }

Catalog.Items = {
	set_technician = {
		tab = "gear",
		kind = "set",
		price = 1800,
		name = "ITEM_TECH_NAME",
		description = "ITEM_TECH_DESC",
		icon = "TECH",
		color = Color3.fromRGB(150, 110, 70),
		effects = { interactHoldMultiplier = 0.6 },
	},
	set_observer = {
		tab = "gear",
		kind = "set",
		price = 2400,
		name = "ITEM_OBSERVER_NAME",
		description = "ITEM_OBSERVER_DESC",
		icon = "OBS",
		color = Color3.fromRGB(90, 150, 100),
		effects = { nightVision = true, footprints = true },
	},
	set_medic = {
		tab = "gear",
		kind = "set",
		price = 1600,
		name = "ITEM_MEDIC_NAME",
		description = "ITEM_MEDIC_DESC",
		icon = "MED",
		color = Color3.fromRGB(170, 70, 64),
		effects = { reviveMultiplier = 0.5, reviveHealth = 60, regenCap = 70, scareDampening = true },
	},
	flashlight_upgrade = {
		tab = "upgrades",
		kind = "upgrade",
		price = 900,
		name = "ITEM_FLASHLIGHT_NAME",
		description = "ITEM_FLASHLIGHT_DESC",
		icon = "LUX",
		color = Color3.fromRGB(230, 214, 170),
		effects = { flashlightRange = 1.35, blindCooldown = 0.7 },
	},
	radio_olive = {
		tab = "cosmetic",
		kind = "radioSkin",
		price = 500,
		name = "ITEM_SKIN_OLIVE_NAME",
		description = "ITEM_SKIN_DESC",
		icon = "CH",
		color = Color3.fromRGB(86, 96, 62),
	},
	radio_rust = {
		tab = "cosmetic",
		kind = "radioSkin",
		price = 500,
		name = "ITEM_SKIN_RUST_NAME",
		description = "ITEM_SKIN_DESC",
		icon = "CH",
		color = Color3.fromRGB(122, 66, 44),
	},
	radio_signal = {
		tab = "cosmetic",
		kind = "radioSkin",
		price = 1200,
		name = "ITEM_SKIN_SIGNAL_NAME",
		description = "ITEM_SKIN_DESC",
		icon = "CH",
		color = Color3.fromRGB(176, 52, 40),
	},
}

Catalog.Order = { "set_technician", "set_observer", "set_medic", "flashlight_upgrade", "radio_olive", "radio_rust", "radio_signal" }

Catalog.DefaultRadioColor = Color3.fromRGB(46, 48, 50)

-- Robux (cosmetic only). Fill in the ids from the Creator Hub; 0 = product hidden.
Catalog.GamePasses = {
	supporter = { id = 0, name = "ITEM_SUPPORTER_NAME", description = "ITEM_SUPPORTER_DESC", grantsRadioSkin = "radio_signal" },
}

-- Combined effects of everything the player owns and has equipped.
function Catalog.Effects(inventory: { [string]: any }?, equipped: { [string]: any }?): { [string]: any }
	local result = {}
	local function merge(itemId)
		local item = Catalog.Items[itemId]
		if item and item.effects then
			for key, value in item.effects do
				result[key] = value
			end
		end
	end
	if equipped and equipped.set then
		merge(equipped.set)
	end
	if inventory and inventory.flashlight_upgrade then
		merge("flashlight_upgrade")
	end
	return result
end

return Catalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[-- Config: single source of truth for values shared by client and server.
-- Anything security-relevant (codes, admin gesture) lives in ServerStorage, never here.

local Config = {}

Config.Version = "0.1.0"
Config.MaxPartySize = 4

---------------------------------------------------------------------------
-- Languages (order = order in the language picker)
---------------------------------------------------------------------------
Config.Languages = { "de", "en", "es", "fr", "pt-br" }
Config.FallbackLanguage = "en"
Config.LanguageNames = {
	de = "Deutsch",
	en = "English",
	es = "Español",
	fr = "Français",
	["pt-br"] = "Português (Brasil)",
}
Config.LanguageTags = { de = "DE", en = "EN", es = "ES", fr = "FR", ["pt-br"] = "PT" }

---------------------------------------------------------------------------
-- Player settings schema (validated identically on client and server)
---------------------------------------------------------------------------
Config.Settings = {
	-- default = nil means "not chosen yet" -> first-start language picker.
	language = { kind = "enum", values = Config.Languages, default = nil },
	subtitles = { kind = "bool", default = true },
	subtitleSize = {
		kind = "enum",
		values = { "small", "medium", "large" },
		labels = { small = "VALUE_SMALL", medium = "VALUE_MEDIUM", large = "VALUE_LARGE" },
		default = "medium",
	},
	scareIntensity = {
		kind = "enum",
		values = { "reduced", "standard", "intense" },
		labels = { reduced = "VALUE_REDUCED", standard = "VALUE_STANDARD", intense = "VALUE_INTENSE" },
		default = "standard",
	},
	cameraEffects = {
		kind = "enum",
		values = { "off", "reduced", "full" },
		labels = { off = "VALUE_CAM_OFF", reduced = "VALUE_CAM_REDUCED", full = "VALUE_CAM_FULL" },
		default = "full",
	},
	graphics = {
		kind = "enum",
		values = { "auto", "low", "medium", "high", "ultra" },
		labels = { auto = "VALUE_AUTO", low = "VALUE_LOW", medium = "VALUE_MEDIUM", high = "VALUE_HIGH", ultra = "VALUE_ULTRA" },
		default = "auto",
	},
	brightness = { kind = "int", min = 0, max = 10, default = 5 },
	radioMode = {
		kind = "enum",
		values = { "hold", "toggle" },
		labels = { hold = "VALUE_HOLD", toggle = "VALUE_TOGGLE" },
		default = "hold",
	},
}

-- Display order + localization keys for the settings screen.
Config.SettingsOrder = {
	{ key = "language", label = "SETTINGS_LANGUAGE" },
	{ key = "subtitles", label = "SETTINGS_SUBTITLES" },
	{ key = "subtitleSize", label = "SETTINGS_SUBTITLE_SIZE" },
	{ key = "scareIntensity", label = "SETTINGS_SCARE", description = "SETTINGS_SCARE_DESC" },
	{ key = "cameraEffects", label = "SETTINGS_CAMERA", description = "SETTINGS_CAMERA_DESC" },
	{ key = "graphics", label = "SETTINGS_GRAPHICS", description = "SETTINGS_GRAPHICS_DESC" },
	{ key = "brightness", label = "SETTINGS_BRIGHTNESS", description = "SETTINGS_BRIGHTNESS_DESC" },
	{ key = "radioMode", label = "SETTINGS_RADIO_MODE", description = "SETTINGS_RADIO_MODE_DESC" },
}

function Config.ValidateSetting(key: any, value: any): (boolean, any)
	if type(key) ~= "string" then
		return false, nil
	end
	local definition = Config.Settings[key]
	if not definition then
		return false, nil
	end
	if definition.kind == "enum" then
		if type(value) == "string" and table.find(definition.values, value) then
			return true, value
		end
	elseif definition.kind == "bool" then
		if type(value) == "boolean" then
			return true, value
		end
	elseif definition.kind == "int" then
		if
			type(value) == "number"
			and value == value -- NaN guard
			and value % 1 == 0
			and value >= definition.min
			and value <= definition.max
		then
			return true, value
		end
	end
	return false, nil
end

function Config.DefaultSettings(): { [string]: any }
	local settings = {}
	for key, definition in Config.Settings do
		settings[key] = definition.default
	end
	return settings
end

---------------------------------------------------------------------------
-- Movement (horror pacing: slow walk, short limited sprint)
---------------------------------------------------------------------------
Config.Movement = {
	WalkSpeed = 10,
	SprintSpeed = 16,
	StaminaSeconds = 6, -- full bar lasts this long while sprinting
	RegenSeconds = 8, -- empty -> full while not sprinting
	RegenDelay = 1, -- seconds after sprinting before regeneration starts
	ExhaustedThreshold = 0.3, -- after running dry, sprint unlocks again at 30 %
	SprintFovBoost = 4,
	BaseFov = 70,
}

---------------------------------------------------------------------------
-- Persistence
---------------------------------------------------------------------------
Config.Data = {
	StoreName = "FZ_PlayerData_v1",
	SchemaVersion = 1,
	AutosaveInterval = 120,
	LockTimeout = 1800, -- a session lock older than this is considered stale
}

Config.Codes = {
	MaxLength = 24,
}

---------------------------------------------------------------------------
-- Voice and radio (Roblox Audio API)
---------------------------------------------------------------------------
Config.Voice = {
	ProximityFull = 12, -- studs: full volume for normal (spatial) voice
	ProximityMax = 90, -- studs: inaudible beyond this
	RadioFull = 40, -- studs: radio at full volume up to here
	RadioMax = 900, -- studs: radio fades out (only static) towards this
	RadioMinVolume = 0.08,
}

---------------------------------------------------------------------------
-- Noise (what the creature can hear). Radius in studs.
---------------------------------------------------------------------------
Config.Noise = {
	Walk = 7,
	Sprint = 20,
	Radio = 28,
	Door = 16,
	Interact = 10,
}

---------------------------------------------------------------------------
-- Creature ("Der Lauscher")
---------------------------------------------------------------------------
Config.Creature = {
	PatrolSpeed = 7,
	InvestigateSpeed = 11,
	ChaseSpeed = 15, -- slightly slower than sprint (16): breaking line of sight works
	SoloSpeedScale = 0.9,
	HearingScale = 1,
	SightRange = 42,
	SightAngle = 65, -- degrees from facing direction
	ListenTime = 1.6,
	AttackRange = 5.5,
	AttackWindup = 0.65, -- telegraphed: crackle + pose before every hit
	Damage = 34, -- three hits to go down, never a one-hit kill
	AttackCooldown = 1.8,
	LoseTrackTime = 6,
	SearchTime = 14,
	BlindRange = 26,
	BlindDuration = 1.8,
	BlindCooldown = 9,
	VentChance = 0.35,
	VentTravelTime = 4,
	VentWarning = 2.5, -- rattle at the exit vent before it appears
	ActivateAfterFuses = 1, -- the creature wakes after the first fuse is taken
}

---------------------------------------------------------------------------
-- Health, downed state, revive
---------------------------------------------------------------------------
Config.Health = {
	Max = 100,
	RegenDelay = 10,
	RegenCap = 50,
	RegenPerSecond = 3,
	DownedTimeout = 35,
	ReviveHold = 3,
	ReviveHealth = 35,
	CrawlSpeed = 2,
}

Config.Rewards = {
	Fuse = 60,
	Relay = 150,
	ForecastBroken = 100,
	ChapterComplete = 600,
}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Localization</string>
          <string name="Source"><![CDATA[-- LocalizationManager
-- Our own, fully controlled translation layer. Roblox auto-translation is disabled on every
-- text object that is bound through this module (AutoLocalize = false), so a player never
-- sees machine-translated or mixed-language game text.
--
-- Usage:
--   Localization.T("MENU_PLAY")                         -> "Spielen"
--   Localization.T("CODE_OK", { amount = 25 })          -> "... +25 ..."
--   Localization.Bind(label, "MENU_PLAY")               -> label.Text stays in sync on language change
--   Localization.Bind(box, "EXTRAS_CODE_PLACEHOLDER", nil, "PlaceholderText")

local Config = require(script.Parent.Config)
local Signal = require(script.Parent.Signal)

local Localization = {}
Localization.Changed = Signal.new()

local tables: { [string]: { [string]: string } } = {}
local languageFolder = script:WaitForChild("Languages")
for _, code in Config.Languages do
	local moduleName = (string.gsub(code, "-", "_"))
	local module = languageFolder:FindFirstChild(moduleName)
	if module then
		tables[code] = require(module)
	else
		warn("[FZ-Loc] Missing language module: " .. moduleName)
	end
end
assert(tables[Config.FallbackLanguage], "[FZ-Loc] Fallback language table is required")

local current = Config.FallbackLanguage
local reported: { [string]: boolean } = {}

-- object -> { [property]: { key, params } }
-- Strong references on purpose: Instance wrappers in weak tables can be collected while the
-- Instance still exists. Entries are removed when the object is destroyed.
local bindings: { [Instance]: { [string]: { key: string, params: { [string]: any }? } } } = {}

local function report(language: string, key: string)
	local id = language .. ":" .. key
	if reported[id] then
		return
	end
	reported[id] = true
	warn(string.format("[FZ-Loc] Missing translation '%s' for language '%s'", key, language))
end

local function format(text: string, params: { [string]: any }?): string
	if not params then
		return text
	end
	return (string.gsub(text, "{([%w_]+)}", function(name)
		local value = params[name]
		if value == nil then
			return "{" .. name .. "}"
		end
		return tostring(value)
	end))
end

function Localization.T(key: string, params: { [string]: any }?, language: string?): string
	local lang = language or current
	local languageTable = tables[lang]
	local text = languageTable and languageTable[key]
	if text == nil then
		if lang ~= Config.FallbackLanguage then
			report(lang, key)
		end
		text = tables[Config.FallbackLanguage][key]
		if text == nil then
			report(Config.FallbackLanguage, key)
			return key
		end
	end
	return format(text, params)
end

function Localization.Has(key: string): boolean
	return tables[Config.FallbackLanguage][key] ~= nil
end

function Localization.GetLanguage(): string
	return current
end

function Localization.IsSupported(language: any): boolean
	return type(language) == "string" and tables[language] ~= nil
end

-- Maps a Roblox locale id ("de-de", "pt-br", "es-mx") to one of our languages, or nil.
function Localization.Detect(localeId: string?): string?
	local id = string.lower(localeId or "")
	if tables[id] then
		return id
	end
	local base = string.match(id, "^(%a+)")
	if base == "pt" then
		return "pt-br"
	end
	if base and tables[base] then
		return base
	end
	return nil
end

local function applyBinding(object: Instance, property: string, entry)
	(object :: any)[property] = Localization.T(entry.key, entry.params)
end

function Localization.Bind(object: Instance, key: string, params: { [string]: any }?, property: string?)
	local prop = property or "Text"
	if object:IsA("GuiBase2d") then
		(object :: any).AutoLocalize = false
	end
	local objectBindings = bindings[object]
	if not objectBindings then
		objectBindings = {}
		bindings[object] = objectBindings
		object.Destroying:Connect(function()
			bindings[object] = nil
		end)
	end
	local entry = { key = key, params = params }
	objectBindings[prop] = entry
	applyBinding(object, prop, entry)
end

function Localization.Unbind(object: Instance)
	bindings[object] = nil
end

function Localization.SetLanguage(language: string): boolean
	if not tables[language] then
		return false
	end
	if language == current then
		return true
	end
	current = language
	-- Update everything synchronously in the same frame: no flicker, no mixed languages.
	for object, objectBindings in bindings do
		for prop, entry in objectBindings do
			applyBinding(object, prop, entry)
		end
	end
	Localization.Changed:Fire(language)
	return true
end

-- Development check: returns a list of human readable problems (missing keys, extra keys,
-- mismatching {placeholders}). Run automatically in Studio by the client bootstrap.
function Localization.Validate(): { string }
	local problems = {}
	local reference = tables[Config.FallbackLanguage]
	local function placeholders(text: string): string
		local found = {}
		for name in string.gmatch(text, "{([%w_]+)}") do
			table.insert(found, name)
		end
		table.sort(found)
		return table.concat(found, ",")
	end
	for language, languageTable in tables do
		if language == Config.FallbackLanguage then
			continue
		end
		for key, text in reference do
			local translated = languageTable[key]
			if translated == nil then
				table.insert(problems, string.format("%s: missing %s", language, key))
			elseif placeholders(translated) ~= placeholders(text) then
				table.insert(problems, string.format("%s: placeholder mismatch in %s", language, key))
			end
		end
		for key in languageTable do
			if reference[key] == nil then
				table.insert(problems, string.format("%s: extra key %s (not in %s)", language, key, Config.FallbackLanguage))
			end
		end
	end
	return problems
end

return Localization
]]></string>
        </Properties>
        <Item class="Folder" referent="9">
          <Properties>
            <string name="Name">Languages</string>
