	SIGN_SECTOR_C = "SETOR C\nPESQUISA",
	SIGN_SECTOR_D = "SETOR D\nALOJAMENTOS",
	SIGN_SECTOR_E = "SETOR E\nENGENHARIA",
	SIGN_CORE = "NÚCLEO CENTRAL\nSISTEMA DE RELÉS",
	SIGN_CONTROL = "ENTRADA / CONTROLE",
	ADMIN_SPAWN_CREATURE = "Fazer a criatura surgir à minha frente",
	ADMIN_CREATURE_AI = "IA da criatura liga / desliga",
	ADMIN_PLAY_CREATURE = "Jogar como a criatura",
	ADMIN_PLAY_HUMAN = "Voltar ao meu personagem",
	ADMIN_TP_CORE = "Teleportar para o núcleo",
	ADMIN_SPEED = "Velocidade de teste ×2 liga / desliga",
	ADMIN_RESET = "Reiniciar criatura e eventos",
	ADMIN_PUBLIC_BLOCKED = "Não permitido em servidores públicos.",
}
]]></string>
            </Properties>
