      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">Net</string>
          <string name="Source"><![CDATA[-- Net: declares every remote in one place. The server creates them, clients wait for them.
-- Direction is documented per remote; every client->server remote is validated and
-- rate limited on the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "FZ_Remotes"

local EVENTS = {
	"UpdateSetting", -- C->S (key, value)
	"ClientReady", -- C->S () player pressed Play / Continue
	"SetFlashlight", -- C->S (enabled)
	"Subtitle", -- S->C (line)
	"Document", -- S->C (document)
	"Notify", -- S->C (key, params)
	"Sfx", -- S->C (soundName, position | instance, volume?)
	"RadioState", -- C->S (transmitting)
	"MicMute", -- C->S (muted)
	"FlashCreature", -- C->S () flashlight cone hits the creature (server validates)
	"MonsterAttack", -- C->S () admin monster mode
	"Footprint", -- S->C (position) observer set only
	"Hurt", -- S->C (amount)
}

local FUNCTIONS = {
	"FetchProfile", -- C->S () -> snapshot of settings/progress
	"RedeemCode", -- C->S (code) -> result
	"AdminAction", -- C->S (action, payload) -> result
	"ShopAction", -- C->S (action, itemId) -> result
}

local Net = {}

local folder: Folder? = nil

local function getFolder(): Folder
	if folder then
		return folder
	end
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if existing then
			folder = existing
		else
			local created = Instance.new("Folder")
			created.Name = FOLDER_NAME
			for _, name in EVENTS do
				local remote = Instance.new("RemoteEvent")
				remote.Name = name
				remote.Parent = created
			end
			for _, name in FUNCTIONS do
				local remote = Instance.new("RemoteFunction")
				remote.Name = name
				remote.Parent = created
			end
			created.Parent = ReplicatedStorage
			folder = created
		end
	else
		folder = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
	end
	return folder :: Folder
end

function Net.Event(name: string): RemoteEvent
	assert(table.find(EVENTS, name), "[FZ-Net] Unknown RemoteEvent: " .. name)
	return getFolder():WaitForChild(name) :: RemoteEvent
end

function Net.Function(name: string): RemoteFunction
	assert(table.find(FUNCTIONS, name), "[FZ-Net] Unknown RemoteFunction: " .. name)
	return getFolder():WaitForChild(name) :: RemoteFunction
end

-- Call on the server before any client can need the remotes.
function Net.Init()
	getFolder()
end

return Net
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">SessionState</string>
          <string name="Source"><![CDATA[-- SessionState: session-wide story state (shared by the whole team in this server).
-- Stored as attributes on ReplicatedStorage.FZ_State, so late joiners automatically
-- receive the current state without any extra remote calls or race conditions.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local FOLDER_NAME = "FZ_State"

local SessionState = {}

local cached: Folder? = nil

local function getFolder(): Folder
	if cached then
		return cached
	end
	if RunService:IsServer() then
		local existing = ReplicatedStorage:FindFirstChild(FOLDER_NAME)
		if not existing then
			existing = Instance.new("Folder")
			existing.Name = FOLDER_NAME
			existing.Parent = ReplicatedStorage
		end
		cached = existing :: Folder
	else
		cached = ReplicatedStorage:WaitForChild(FOLDER_NAME) :: Folder
	end
	return cached :: Folder
end

function SessionState.Get(key: string): any
	return getFolder():GetAttribute(key)
end

function SessionState.Set(key: string, value: any)
	assert(RunService:IsServer(), "SessionState.Set is server-only")
	getFolder():SetAttribute(key, value)
end

-- Calls callback immediately with the current value and again on every change.
function SessionState.Observe(key: string, callback: (any) -> ()): RBXScriptConnection
	local folder = getFolder()
	task.spawn(callback, folder:GetAttribute(key))
	return folder:GetAttributeChangedSignal(key):Connect(function()
		callback(folder:GetAttribute(key))
	end)
end

function SessionState.Init()
	getFolder()
end

return SessionState
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Signal</string>
          <string name="Source"><![CDATA[-- Signal: tiny, leak-safe event implementation used by client and server modules.
-- Handlers run in their own thread so a failing handler never breaks the emitter.

local Connection = {}
Connection.__index = Connection

function Connection:Disconnect()
	if not self.Connected then
		return
	end
	self.Connected = false
	local list = self._signal._connections
	local index = table.find(list, self)
	if index then
		table.remove(list, index)
	end
end

local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _connections = {} }, Signal)
end

function Signal:Connect(handler: (...any) -> ())
	local connection = setmetatable({ Connected = true, _handler = handler, _signal = self }, Connection)
	table.insert(self._connections, connection)
	return connection
end

function Signal:Once(handler: (...any) -> ())
	local connection
	connection = self:Connect(function(...)
		connection:Disconnect()
		handler(...)
	end)
	return connection
end

function Signal:Fire(...)
	for _, connection in table.clone(self._connections) do
		if connection.Connected then
			task.spawn(connection._handler, ...)
		end
	end
end

function Signal:Wait()
	local thread = coroutine.running()
	self:Once(function(...)
		task.spawn(thread, ...)
	end)
	return coroutine.yield()
end

function Signal:DisconnectAll()
	for _, connection in table.clone(self._connections) do
		connection:Disconnect()
	end
end

return Signal
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="18">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="19">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">AdminConfig</string>
          <string name="Source"><![CDATA[-- Who may use the owner/maintenance tools.
-- Authorization is ALWAYS decided here on the server. The in-game "gesture code" only
-- reveals the menu for people who are already authorized; it never grants rights.

return {
	-- Additional developer UserIds (numbers). The experience owner is detected automatically:
	-- * user-owned experience: game.CreatorId
	-- * group-owned experience: members with rank >= MinGroupRank in the owning group
	UserIds = {
		-- 123456789,
	},
	MinGroupRank = 254,

	-- Everyone who can open the place in Studio is a developer of it, so Studio test
	-- sessions are authorized by default. Set to false to test the "denied" path.
	AllowAllInStudio = true,
}
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Chapters</string>
        </Properties>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Chapter1</string>
            <string name="Source"><![CDATA[-- Chapter 1 "The Reception" - playable flow on Relay Station 07.
--
--  Gate: arrival transmission -> gatehouse fax (dated tomorrow, 02:14)
--  Control room terminal -> 3 fuses appear in 3 of 4 sectors (random each session)
--  1st fuse: the creature wakes up            2nd fuse: FORECAST "lights in A go out"
--     -> hold the breaker in Sector A in time = forecast broken (reward, new line)
--     -> otherwise Sector A goes dark and the creature comes to look
--  3 fuses -> Relay Sector B -> core doors unlock -> central core
--  Core activation -> the Relay says a player's name -> antenna outside = end of slice

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local Services = script.Parent.Parent.Services
local StoryService = require(Services.StoryService)
local InteractionService = require(Services.InteractionService)
local PowerService = require(Services.PowerService)
local CreatureService = require(Services.CreatureService)
local DataService = require(Services.DataService)
local NoiseService = require(Services.NoiseService)

local Chapter1 = {}

local TOTAL_FUSES = 3
local FORECAST_SECONDS = 30

local state = {
	stage = "arrival", -- arrival | control | fuses | relay | core | antenna | done
	fuses = 0,
	forecast = "none", -- none | armed | broken | kept
	completedBy = {} :: { [Player]: boolean },
}
local fuseFolder: Folder? = nil
local checkpointSetter: ((string) -> ())? = nil

local ARRIVAL = {
	{ delay = 1.5, text = "SFX_STATIC", channel = "sfx", duration = 2 },
	{ delay = 1.0, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C1_001", channel = "radio", duration = 5.5 },
	{ delay = 5.8, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C1_002", channel = "radio", duration = 4 },
	{ delay = 5.0, text = "SFX_FAX", channel = "world", duration = 3 },
}

local function rewardAll(amount: number)
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("FZ_InGame") then
			DataService.Grant(player, amount)
		end
	end
end

local function sfxAt(name: string, position: Vector3)
	Net.Event("Sfx"):FireAllClients(name, position)
end

local function centerOf(tagName: string, attribute: string, value: string): Vector3?
	for _, instance in CollectionService:GetTagged(tagName) do
		if instance:IsA("BasePart") and instance:GetAttribute(attribute) == value then
			return instance.Position
		end
	end
	return nil
end

---------------------------------------------------------------------------
-- Fuses
---------------------------------------------------------------------------
local function spawnFuses()
	if fuseFolder then
		fuseFolder:Destroy()
	end
	local folder = Instance.new("Folder")
	folder.Name = "FZ_Fuses"
	folder.Parent = workspace
	fuseFolder = folder

	-- Pick one random spot in 3 of the available sectors.
	local bySector: { [string]: { BasePart } } = {}
	for _, spot in CollectionService:GetTagged("FZ_FuseSpot") do
		if spot:IsA("BasePart") then
			local sector = tostring(spot:GetAttribute("Sector"))
			bySector[sector] = bySector[sector] or {}
			table.insert(bySector[sector], spot)
		end
	end
	local sectors = {}
	for sector in bySector do
		table.insert(sectors, sector)
	end
	for i = #sectors, 2, -1 do
		local j = math.random(1, i)
		sectors[i], sectors[j] = sectors[j], sectors[i]
	end
	for i = 1, math.min(TOTAL_FUSES, #sectors) do
		local spots = bySector[sectors[i]]
		local spot = spots[math.random(1, #spots)]
		local fuse = Instance.new("Part")
		fuse.Name = "Fuse"
		fuse.Size = Vector3.new(0.5, 0.5, 1.4)
		fuse.Color = Color3.fromRGB(214, 170, 60)
		fuse.Material = Enum.Material.Metal
		fuse.Anchored = true
		fuse.CanCollide = false
		fuse.CFrame = spot.CFrame * CFrame.new(0, 0.1, 0)
		local glow = Instance.new("PointLight")
		glow.Range = 5
		glow.Brightness = 0.8
		glow.Color = Color3.fromRGB(255, 200, 90)
		glow.Parent = fuse
		fuse:SetAttribute("InteractId", "c1_fuse")
		fuse:SetAttribute("ActionKey", "INTERACT_PICKUP")
		fuse:SetAttribute("ObjectKey", "OBJECT_FUSE")
		fuse:SetAttribute("MaxDistance", 7)
		fuse.Parent = folder
		CollectionService:AddTag(fuse, "FZ_Interactable")
	end
end

local function updateFuseObjective()
	StoryService.SetObjective("OBJECTIVE_FIND_FUSES", { count = state.fuses, total = TOTAL_FUSES })
end

---------------------------------------------------------------------------
-- Forecast (prediction you can break)
---------------------------------------------------------------------------
local function startForecast()
	state.forecast = "armed"
	StoryService.Sequence("all", {
		{ delay = 1, speaker = "SPEAKER_RELAY", text = "RADIO_C1_FORECAST", channel = "radio", duration = 5 },
	})
	task.delay(FORECAST_SECONDS + 1, function()
		if state.forecast ~= "armed" then
			return
		end
		state.forecast = "kept"
		PowerService.Set("A", false)
		local center = centerOf("FZ_CreaturePatrol", "Area", "A")
		if center then
			sfxAt("power_down", center)
			NoiseService.Emit(center, 400, nil)
			CreatureService.Alert(center)
		end
		StoryService.Say("all", { text = "SFX_POWER_DOWN", channel = "world", duration = 3, critical = true })
		StoryService.Sequence("all", {
			{ delay = 2.5, speaker = "SPEAKER_RELAY", text = "RADIO_C1_FORECAST_KEPT", channel = "radio", duration = 3 },
		})
	end)
end

---------------------------------------------------------------------------
-- Flow
---------------------------------------------------------------------------
function Chapter1.Reset()
	state.stage = "arrival"
	state.fuses = 0
	state.forecast = "none"
	if fuseFolder then
		fuseFolder:Destroy()
		fuseFolder = nil
	end
	PowerService.Reset()
	CreatureService.Despawn()
	StoryService.ResetFlags()
	StoryService.SetObjective(nil)
	if checkpointSetter then
		checkpointSetter("C1_START")
	end
end

function Chapter1.Start(context: { setCheckpoint: (string) -> () })
	checkpointSetter = context.setCheckpoint

	InteractionService.Register("c1_fax", function(player)
		StoryService.ShowDocument(player, { title = "FAX_TITLE", body = "FAX_BODY", date = os.time() + 24 * 60 * 60 })
		if StoryService.GetFlag("C1_FaxRead") then
			return
		end
		StoryService.SetFlag("C1_FaxRead", true)
		StoryService.Sequence("all", {
			{ delay = 3, speaker = "SPEAKER_RELAY", text = "RADIO_C1_003", channel = "radio", duration = 3.5 },
		})
		task.delay(6, function()
			if state.stage == "arrival" then
				state.stage = "control"
				StoryService.SetObjective("OBJECTIVE_REACH_CONTROL")
			end
		end)
	end)

	InteractionService.Register("c1_terminal", function()
		if state.stage ~= "control" and state.stage ~= "arrival" then
			return
		end
		state.stage = "fuses"
		context.setCheckpoint("C1_CONTROL")
		StoryService.Say("all", { speaker = "SPEAKER_RELAY", text = "RADIO_C1_TERMINAL", channel = "radio", duration = 5 })
		spawnFuses()
		updateFuseObjective()
	end)

	InteractionService.Register("c1_fuse", function(player, fuse)
		if state.stage ~= "fuses" or not fuse.Parent then
			return
		end
		sfxAt("fuse_pickup", (fuse :: BasePart).Position)
		fuse:Destroy()
		state.fuses += 1
		rewardAll(Config.Rewards.Fuse)
		NoiseService.Emit((player.Character :: Model):GetPivot().Position, Config.Noise.Interact, player)
		if state.fuses >= Config.Creature.ActivateAfterFuses and not CreatureService.Get() then
			CreatureService.Spawn()
			StoryService.Sequence("all", {
				{ delay = 1.5, speaker = "SPEAKER_RELAY", text = "RADIO_C1_WAKE", channel = "radio", duration = 4 },
			})
		end
		if state.fuses == 2 and state.forecast == "none" then
			startForecast()
		end
		if state.fuses >= TOTAL_FUSES then
			state.stage = "relay"
			StoryService.SetObjective("OBJECTIVE_RELAY_B")
		else
			updateFuseObjective()
		end
	end)

	InteractionService.Register("c1_breaker_a", function()
		if state.forecast ~= "armed" then
			return
		end
		state.forecast = "broken"
		rewardAll(Config.Rewards.ForecastBroken)
		StoryService.SetFlag("C1_ForecastBroken", true)
		StoryService.Say("all", { speaker = "SPEAKER_RELAY", text = "RADIO_C1_FORECAST_BROKEN", channel = "radio", duration = 4 })
	end)

	InteractionService.Register("c1_relay_b", function(_player, panel)
		if state.stage ~= "relay" then
			return
		end
		state.stage = "core"
		PowerService.Set("B", true)
		sfxAt("relay_activate", (panel :: BasePart).Position)
		NoiseService.Emit((panel :: BasePart).Position, 60, nil)
		StoryService.Say("all", { text = "SFX_RELAY", channel = "world", duration = 3 })
		rewardAll(Config.Rewards.Relay)
		context.setCheckpoint("C1_CORE")
		StoryService.SetObjective("OBJECTIVE_CORE")
	end)

	InteractionService.Register("c1_core", function(_player, console)
		if state.stage ~= "core" then
			return
		end
		state.stage = "antenna"
		PowerService.Set("CORE", true)
		sfxAt("relay_activate", (console :: BasePart).Position)
		CreatureService.Alert((console :: BasePart).Position)
		local team = {}
		for _, p in Players:GetPlayers() do
			if p:GetAttribute("FZ_InGame") then
				table.insert(team, p)
			end
		end
		local named = team[math.random(1, math.max(1, #team))]
		StoryService.Sequence("all", {
			{ delay = 2, text = "SFX_STATIC", channel = "sfx", duration = 2 },
			{ delay = 1.5, speaker = "SPEAKER_RELAY", text = "RADIO_C1_CORE", params = { name = if named then named.DisplayName else "" }, channel = "radio", duration = 4.5 },
		})
		task.delay(7, function()
			StoryService.SetObjective("OBJECTIVE_ANTENNA")
		end)
	end)

	InteractionService.Register("c1_antenna", function()
		if state.stage ~= "antenna" and state.stage ~= "done" then
			return
		end
		if state.stage == "antenna" then
			state.stage = "done"
			StoryService.Sequence("all", {
				{ delay = 1, speaker = "SPEAKER_UNKNOWN", text = "RADIO_C1_ANTENNA", channel = "radio", duration = 6 },
			})
			CreatureService.SetAIEnabled(false)
		end
		for _, p in Players:GetPlayers() do
			if p:GetAttribute("FZ_InGame") and not state.completedBy[p] then
				state.completedBy[p] = true
				DataService.Grant(p, Config.Rewards.ChapterComplete)
				DataService.Mutate(p, function(data)
					if not table.find(data.progress.completed, 1) then
						table.insert(data.progress.completed, 1)
					end
				end)
				DataService.SaveNow(p)
				Net.Event("Notify"):FireClient(p, "CHAPTER_COMPLETE")
			end
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		state.completedBy[player] = nil
	end)
end

function Chapter1.OnPlayerEntered(player: Player, firstTime: boolean)
	if not firstTime then
		return
	end
	if state.stage == "arrival" then
		StoryService.Sequence(player, ARRIVAL)
		if StoryService.GetObjective() == nil then
			task.delay(14, function()
				if StoryService.GetObjective() == nil then
					StoryService.SetObjective("OBJECTIVE_CHECK_GATEHOUSE")
				end
			end)
		end
	end
end

return Chapter1
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="23">
        <Properties>
          <string name="Name">Creature</string>
        </Properties>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Rig</string>
            <string name="Source"><![CDATA[-- Creature rig factory.
--
-- 1. Your own monster: put a Model into ServerStorage > Creatures. Requirements:
--    Humanoid + HumanoidRootPart (PrimaryPart), anchored = false, correct HipHeight.
--    Optional animation ids in Shared/Assets.luau (CreatureAnimations).
-- 2. Otherwise the built-in placeholder "Der Lauscher" is built from parts:
--    ~8.5 studs tall, very thin, horn-speaker head, arms down to the knees.
--    It is animated procedurally on the clients (CreatureVisualsController) by
--    driving Motor6D.Transform - no animation assets needed.

local ServerStorage = game:GetService("ServerStorage")
local CollectionService = game:GetService("CollectionService")

local Rig = {}

local SKIN = Color3.fromRGB(58, 52, 50)
local SKIN_DARK = Color3.fromRGB(34, 30, 30)
local FABRIC = Color3.fromRGB(24, 22, 22)

local function part(model: Model, name: string, size: Vector3, color: Color3, material: Enum.Material?, collide: boolean?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.CanCollide = collide == true
	p.CanQuery = true
	p.CanTouch = false
	p.Massless = not collide
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

local function motor(name: string, part0: BasePart, part1: BasePart, c0: CFrame, c1: CFrame)
	local m = Instance.new("Motor6D")
	m.Name = name
	m.Part0 = part0
	m.Part1 = part1
	m.C0 = c0
	m.C1 = c1
	m.Parent = part0
	return m
end

function Rig.BuildPlaceholder(): Model
	local model = Instance.new("Model")
	model.Name = "Lauscher"

	local root = part(model, "HumanoidRootPart", Vector3.new(2, 2, 1), SKIN, Enum.Material.SmoothPlastic, true)
	root.Transparency = 1
	model.PrimaryPart = root

	local torso = part(model, "Torso", Vector3.new(1.3, 3.2, 0.8), SKIN, Enum.Material.Fabric, true)
	local head = part(model, "Head", Vector3.new(1.3, 1.3, 1.6), SKIN_DARK, Enum.Material.Metal)
	local horn = part(model, "Horn", Vector3.new(0.4, 2.1, 2.1), SKIN_DARK, Enum.Material.Metal)
	horn.Shape = Enum.PartType.Cylinder
	local grille = part(model, "Grille", Vector3.new(0.12, 1.9, 1.9), FABRIC, Enum.Material.Fabric)
	grille.Shape = Enum.PartType.Cylinder

	motor("RootJoint", root, torso, CFrame.new(0, -1, 0), CFrame.new(0, -1.6, 0) * CFrame.Angles(math.rad(-12), 0, 0))
	motor("Neck", torso, head, CFrame.new(0, 1.6, 0), CFrame.new(0, -0.7, 0.2))
	-- Horn faces forward (-Z). Cylinders extend along X, so rotate 90 degrees around Y.
	local hornWeld = Instance.new("Weld")
	hornWeld.Part0 = head
	hornWeld.Part1 = horn
	hornWeld.C0 = CFrame.new(0, 0, -0.9) * CFrame.Angles(0, math.rad(90), 0)
	hornWeld.Parent = head
	local grilleWeld = Instance.new("Weld")
	grilleWeld.Part0 = head
	grilleWeld.Part1 = grille
	grilleWeld.C0 = CFrame.new(0, 0, -1.12) * CFrame.Angles(0, math.rad(90), 0)
	grilleWeld.Parent = head

	for _, side in { { "Left", -1 }, { "Right", 1 } } do
		local name, s = side[1], side[2]
		local upperArm = part(model, name .. "UpperArm", Vector3.new(0.35, 3.2, 0.35), SKIN, Enum.Material.Fabric)
		local lowerArm = part(model, name .. "LowerArm", Vector3.new(0.3, 3.4, 0.3), SKIN, Enum.Material.Fabric)
		local hand = part(model, name .. "Hand", Vector3.new(0.5, 1.1, 0.25), SKIN_DARK, Enum.Material.Fabric)
		motor(name .. "Shoulder", torso, upperArm, CFrame.new(s * 0.85, 1.3, 0), CFrame.new(0, 1.6, 0))
		motor(name .. "Elbow", upperArm, lowerArm, CFrame.new(0, -1.6, 0), CFrame.new(0, 1.7, 0))
		motor(name .. "Wrist", lowerArm, hand, CFrame.new(0, -1.7, 0), CFrame.new(0, 0.55, 0))

		local upperLeg = part(model, name .. "UpperLeg", Vector3.new(0.45, 2.4, 0.45), SKIN, Enum.Material.Fabric)
		local lowerLeg = part(model, name .. "LowerLeg", Vector3.new(0.4, 2.4, 0.4), SKIN, Enum.Material.Fabric)
		motor(name .. "Hip", root, upperLeg, CFrame.new(s * 0.4, -1, 0), CFrame.new(0, 1.2, 0))
		motor(name .. "Knee", upperLeg, lowerLeg, CFrame.new(0, -1.2, 0), CFrame.new(0, 1.2, 0))
	end

	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 4.8
	humanoid.AutomaticScalingEnabled = false
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.MaxHealth = 1e6
	humanoid.Health = 1e6
	humanoid.Parent = model
	Instance.new("Animator").Parent = humanoid

	model:SetAttribute("Procedural", true)
	return model
end

-- Returns the creature model to use (your model if present, else the placeholder).
function Rig.Create(): Model
	local folder = ServerStorage:FindFirstChild("Creatures")
	if folder then
		for _, candidate in folder:GetChildren() do
			if candidate:IsA("Model") and candidate:FindFirstChildOfClass("Humanoid") and candidate:FindFirstChild("HumanoidRootPart") then
				local clone = candidate:Clone()
				clone.PrimaryPart = clone:FindFirstChild("HumanoidRootPart") :: BasePart
				for _, descendant in clone:GetDescendants() do
					if descendant:IsA("BasePart") then
						descendant.Anchored = false
					end
				end
				if clone:GetAttribute("Procedural") == nil then
					clone:SetAttribute("Procedural", false)
				end
				return clone
			end
		end
		warn("[FZ-Creature] ServerStorage.Creatures has no valid model (needs Humanoid + HumanoidRootPart); using placeholder")
	end
	return Rig.BuildPlaceholder()
end

function Rig.Tag(model: Model)
	CollectionService:AddTag(model, "FZ_CreatureRig")
end

return Rig
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="25">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- FREQUENCY ZERO - server bootstrap.
-- Order matters: remotes and shared state first, then data, then gameplay services.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
require(Shared.Net).Init()
require(Shared.SessionState).Init()

if not workspace:FindFirstChild("FZ_Map") then
	require(script.Parent.Map.RelayStation07).Build()
end

local SERVICES = {
	"DataService",
	"SettingsService",
	"AdminService",
	"CodeService",
	"InteractionService",
	"NoiseService",
	"DoorService",
	"PowerService",
	"HealthService",
	"VoiceService",
	"ShopService",
	"CreatureService",
	"FlashlightService",
	"GameFlowService",
}

for _, name in SERVICES do
	local module = script.Parent.Services:FindFirstChild(name)
	local ok, err = pcall(function()
		local service = require(module)
		if name == "PowerService" then
			service.Start(require(script.Parent.Services.DoorService))
		else
			service.Start()
		end
	end)
	if not ok then
		warn(string.format("[FZ] %s failed to start: %s", name, tostring(err)))
	end
end

print("[FZ] Server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="26">
        <Properties>
          <string name="Name">Map</string>
        </Properties>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">RelayStation07</string>
            <string name="Source"><![CDATA[-- Relay Station 07 - script-built playable map following the concept floor plan:
--
--            N (-Z)
--   [Sektor C]──────[N-Halle]──────[Sektor D]
--   [Sektor B]─[W]─( ZENTRALKERN )─[O]─[Sektor A]
--   [Sektor E]──────[S-Halle]──────[Eingang/Kontrolle]──► Hof, Straße, Tor
--                     Außenbereich: Antenne (Extraktion)
--
-- Everything gameplay-relevant is expressed through tags + attributes, so you can replace
-- any part of it with your own Studio build later (see docs/MAP_CONTRACT.md):
--   FZ_Interactable, FZ_Door, FZ_SectorLight, FZ_FuseSpot, FZ_CreaturePatrol, FZ_Vent,
--   FZ_CreatureSpawn, FZ_Checkpoint, FZ_MenuCamera, FZ_WorldText, FZ_KeyLight.
-- It is only built when Workspace has no "FZ_Map" model.

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")

local Map = {}

local H = 14 -- wall height
local DOOR_H = 10
local T = 1 -- wall thickness

local C = {
	Concrete = Color3.fromRGB(104, 104, 100),
	ConcreteDark = Color3.fromRGB(64, 66, 66),
	Floor = Color3.fromRGB(78, 74, 66),
	Linoleum = Color3.fromRGB(92, 84, 66),
	Steel = Color3.fromRGB(64, 84, 82),
	SteelDark = Color3.fromRGB(42, 48, 50),
	Wood = Color3.fromRGB(82, 62, 44),
	Plastic = Color3.fromRGB(190, 184, 170),
	Paper = Color3.fromRGB(226, 220, 204),
	Sodium = Color3.fromRGB(255, 170, 96),
	Fluorescent = Color3.fromRGB(214, 236, 230),
	Emergency = Color3.fromRGB(200, 40, 30),
	Screen = Color3.fromRGB(90, 220, 140),
	Asphalt = Color3.fromRGB(36, 38, 40),
	Pine = Color3.fromRGB(28, 44, 34),
	Bark = Color3.fromRGB(52, 40, 32),
}

local root: Model
local rng = Random.new(707)

---------------------------------------------------------------------------
-- Primitive helpers
---------------------------------------------------------------------------
local function block(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function folder(name: string): Folder
	local f = Instance.new("Folder")
	f.Name = name
	f.Parent = root
	return f
end

local function tag(instance: Instance, tagName: string, attributes: { [string]: any }?)
	for key, value in attributes or {} do
		instance:SetAttribute(key, value)
	end
	CollectionService:AddTag(instance, tagName)
end

local function worldText(target: BasePart, face: Enum.NormalId, key: string?, staticText: string?, params: { [string]: string }?, color: Color3?, font: Enum.Font?)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 1
	gui.AutoLocalize = false
	gui.Parent = target
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = font or Enum.Font.RobotoMono
	label.TextScaled = true
	label.TextWrapped = true
	label.TextColor3 = color or Color3.fromRGB(30, 28, 26)
	label.Text = staticText or ""
	label.AutoLocalize = false
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.06, 0)
	padding.PaddingRight = UDim.new(0.06, 0)
	padding.PaddingTop = UDim.new(0.1, 0)
	padding.PaddingBottom = UDim.new(0.1, 0)
	padding.Parent = label
	if key then
		label:SetAttribute("LocKey", key)
		for name, value in params or {} do
			label:SetAttribute("LocParam_" .. name, value)
		end
		CollectionService:AddTag(label, "FZ_WorldText")
	end
	label.Parent = gui
	return label
end

---------------------------------------------------------------------------
-- Walls with door gaps. gaps = { { center, width } }
---------------------------------------------------------------------------
local walls: Folder

local function wallSegments(a: number, b: number, gaps: { { number } }?): { { number } }
	local segments = {}
	local cursor = a
	local sorted = table.clone(gaps or {})
	table.sort(sorted, function(x, y)
		return x[1] < y[1]
	end)
	for _, gap in sorted do
		local g0, g1 = gap[1] - gap[2] / 2, gap[1] + gap[2] / 2
		if g0 > cursor then
			table.insert(segments, { cursor, g0, false })
		end
		table.insert(segments, { g0, g1, true })
		cursor = g1
	end
	if cursor < b then
		table.insert(segments, { cursor, b, false })
	end
	return segments
end

-- Wall running along X at constant z.
local function wallZ(z: number, x0: number, x1: number, gaps: { { number } }?, color: Color3?)
	for _, s in wallSegments(x0, x1, gaps) do
		local width = s[2] - s[1]
		local mid = (s[1] + s[2]) / 2
		if s[3] then
			block(walls, "Lintel", Vector3.new(width, H - DOOR_H, T), CFrame.new(mid, DOOR_H + (H - DOOR_H) / 2, z), color or C.Concrete, Enum.Material.Concrete)
		else
			block(walls, "Wall", Vector3.new(width, H, T), CFrame.new(mid, H / 2, z), color or C.Concrete, Enum.Material.Concrete)
		end
	end
end

-- Wall running along Z at constant x.
local function wallX(x: number, z0: number, z1: number, gaps: { { number } }?, color: Color3?)
	for _, s in wallSegments(z0, z1, gaps) do
		local depth = s[2] - s[1]
		local mid = (s[1] + s[2]) / 2
		if s[3] then
			block(walls, "Lintel", Vector3.new(T, H - DOOR_H, depth), CFrame.new(x, DOOR_H + (H - DOOR_H) / 2, mid), color or C.Concrete, Enum.Material.Concrete)
		else
			block(walls, "Wall", Vector3.new(T, H, depth), CFrame.new(x, H / 2, mid), color or C.Concrete, Enum.Material.Concrete)
		end
	end
end

---------------------------------------------------------------------------
-- Doors: sliding steel doors, optionally power-locked
---------------------------------------------------------------------------
local doors: Folder
local doorCount = 0

local function door(center: Vector3, alongX: boolean, width: number, locked: boolean?, sector: string?)
	doorCount += 1
	local size = if alongX then Vector3.new(width, DOOR_H, 0.6) else Vector3.new(0.6, DOOR_H, width)
	local closed = CFrame.new(center.X, DOOR_H / 2, center.Z)
	local slide = if alongX then Vector3.new(width - 0.4, 0, 0) else Vector3.new(0, 0, width - 0.4)
	local panel = block(doors, "Door" .. doorCount, size, closed, C.Steel, Enum.Material.Metal)
	local stripe = block(panel, "Stripe", if alongX then Vector3.new(width, 0.4, 0.7) else Vector3.new(0.7, 0.4, width), closed * CFrame.new(0, 1.5, 0), if locked then C.Emergency else C.Plastic, Enum.Material.Neon)
	stripe.CanCollide = false
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = panel
	weld.Part1 = stripe
	weld.Parent = panel
	stripe.Anchored = false
	local modifier = Instance.new("PathfindingModifier")
	modifier.PassThrough = not locked
	modifier.Parent = panel
	tag(panel, "FZ_Door", {
		DoorId = "D" .. doorCount,
		Open = false,
		Locked = locked == true,
		PowerSector = sector or "",
		ClosedCFrame = closed,
		OpenCFrame = closed + slide,
	})
	tag(panel, "FZ_Interactable", {
		InteractId = "door",
		ActionKey = "INTERACT_OPEN",
		ObjectKey = "OBJECT_DOOR",
		MaxDistance = 9,
	})
	return panel
end

---------------------------------------------------------------------------
-- Lights (tagged by sector so PowerService can switch them)
---------------------------------------------------------------------------
local lights: Folder
local lightsPerSector: { [string]: number } = {}

-- The first light of every sector is a key light (on at every graphics level), so no
-- room is ever pitch black on low-end devices; further lights are decorative.
local function ceilingLight(position: Vector3, sector: string, color: Color3?, shadows: boolean?, forceKey: boolean?)
	lightsPerSector[sector] = (lightsPerSector[sector] or 0) + 1
	local key = forceKey or lightsPerSector[sector] == 1
	local fixture = block(lights, "Fixture_" .. sector, Vector3.new(6, 0.3, 1), CFrame.new(position.X, H - 0.2, position.Z), color or C.Fluorescent, Enum.Material.Neon)
	fixture.CanCollide = false
	fixture.CastShadow = false
	local light = Instance.new("SurfaceLight")
	light.Face = Enum.NormalId.Bottom
	light.Range = 22
	light.Angle = 120
	light.Brightness = 1.1
	light.Color = color or C.Fluorescent
	light.Shadows = shadows == true
	light.Parent = fixture
	tag(fixture, "FZ_SectorLight", { Sector = sector, OnColor = color or C.Fluorescent })
	if key then
		CollectionService:AddTag(fixture, "FZ_KeyLight")
	else
		CollectionService:AddTag(fixture, "FZ_DecorLight")
	end
	return fixture
end

local function emergencyLight(position: Vector3, sector: string)
	local lamp = block(lights, "Emergency", Vector3.new(0.8, 0.5, 0.8), CFrame.new(position), C.Emergency, Enum.Material.Neon)
	lamp.CanCollide = false
	local light = Instance.new("PointLight")
	light.Range = 14
	light.Brightness = 0.7
	light.Color = C.Emergency
	light.Parent = lamp
	CollectionService:AddTag(lamp, "FZ_KeyLight") -- emergency lights never turn off: readable darkness
	lamp:SetAttribute("Sector", sector)
	return lamp
end

---------------------------------------------------------------------------
-- Props
---------------------------------------------------------------------------
local props: Folder

local function desk(cf: CFrame)
	block(props, "Desk", Vector3.new(6, 0.3, 3), cf * CFrame.new(0, 3, 0), C.Wood, Enum.Material.Wood)
	for _, x in { -2.7, 2.7 } do
		block(props, "DeskLeg", Vector3.new(0.4, 3, 2.6), cf * CFrame.new(x, 1.5, 0), C.SteelDark, Enum.Material.Metal)
	end
end

local function console(cf: CFrame)
	block(props, "Console", Vector3.new(7, 3.4, 2.4), cf * CFrame.new(0, 1.7, 0), C.SteelDark, Enum.Material.Metal)
	block(props, "ConsoleTop", Vector3.new(7, 0.3, 2.6), cf * CFrame.new(0, 3.5, 0) * CFrame.Angles(math.rad(-12), 0, 0), C.Steel, Enum.Material.Metal)
	for i = -1, 1 do
		local screen = block(props, "Monitor", Vector3.new(1.9, 1.5, 1.2), cf * CFrame.new(i * 2.2, 4.6, 0.4), C.ConcreteDark, Enum.Material.SmoothPlastic)
		local glass = block(props, "Screen", Vector3.new(1.6, 1.1, 0.05), screen.CFrame * CFrame.new(0, 0, -0.62), C.Screen, Enum.Material.Neon)
		glass.Transparency = 0.25
		glass.CanCollide = false
	end
end

local function cabinet(cf: CFrame)
	block(props, "Cabinet", Vector3.new(3, 7, 2), cf * CFrame.new(0, 3.5, 0), C.Steel, Enum.Material.Metal)
end

local function shelf(cf: CFrame)
	block(props, "Shelf", Vector3.new(8, 9, 2), cf * CFrame.new(0, 4.5, 0), C.Wood, Enum.Material.Wood)
	for row = 1, 4 do
		block(props, "Files", Vector3.new(7.2, 1.4, 1.6), cf * CFrame.new(0, row * 2 - 0.3, -0.1), C.Paper:Lerp(C.Wood, rng:NextNumber(0.2, 0.6)), Enum.Material.Cardboard)
	end
end

local function bunk(cf: CFrame)
	for _, y in { 1.6, 5.2 } do
		block(props, "Bed", Vector3.new(4, 0.8, 8), cf * CFrame.new(0, y, 0), C.Plastic:Lerp(C.Steel, 0.5), Enum.Material.Fabric)
	end
	for _, x in { -1.9, 1.9 } do
		for _, z in { -3.8, 3.8 } do
			block(props, "BunkPost", Vector3.new(0.3, 6.4, 0.3), cf * CFrame.new(x, 3.2, z), C.SteelDark, Enum.Material.Metal)
		end
	end
end

local function locker(cf: CFrame)
	block(props, "Locker", Vector3.new(2, 7, 2), cf * CFrame.new(0, 3.5, 0), C.Steel:Lerp(C.Plastic, 0.2), Enum.Material.Metal)
end

local function labTable(cf: CFrame)
	block(props, "LabTable", Vector3.new(8, 3.2, 3.5), cf * CFrame.new(0, 1.6, 0), C.Plastic, Enum.Material.SmoothPlastic)
	for i = -1, 1 do
		local flask = block(props, "Instrument", Vector3.new(1, 1.4, 1), cf * CFrame.new(i * 2.5, 3.9, 0), C.Screen:Lerp(C.Plastic, 0.6), Enum.Material.Glass)
		flask.Transparency = 0.3
	end
end

local function generator(cf: CFrame)
	local body = block(props, "Generator", Vector3.new(8, 6, 5), cf * CFrame.new(0, 3, 0), C.Steel:Lerp(C.Emergency, 0.15), Enum.Material.Metal)
	local drum = block(props, "Drum", Vector3.new(7, 4, 4), cf * CFrame.new(0, 7, 0) * CFrame.Angles(0, 0, math.rad(90)), C.SteelDark, Enum.Material.Metal)
	drum.Shape = Enum.PartType.Cylinder
	drum.Size = Vector3.new(7, 4, 4)
	drum.CFrame = cf * CFrame.new(0, 7.5, 0)
	return body
end

local function pipeRun(from: Vector3, to: Vector3, radius: number?)
	local length = (to - from).Magnitude
	local pipe = block(props, "Pipe", Vector3.new(length, (radius or 0.6) * 2, (radius or 0.6) * 2), CFrame.lookAt((from + to) / 2, to) * CFrame.Angles(0, math.rad(90), 0), C.SteelDark, Enum.Material.Metal)
	pipe.Shape = Enum.PartType.Cylinder
	pipe.CanCollide = false
end

local function sign(position: Vector3, facing: Vector3, key: string)
	local plate = block(props, "Sign", Vector3.new(8, 2.4, 0.2), CFrame.lookAt(position, position + facing), C.Plastic, Enum.Material.SmoothPlastic)
	plate.CanCollide = false
	worldText(plate, Enum.NormalId.Front, key)
end

local function vent(position: Vector3, facing: Vector3, group: string)
	local grate = block(props, "Vent", Vector3.new(3, 2, 0.3), CFrame.lookAt(position, position + facing), C.SteelDark, Enum.Material.DiamondPlate)
	grate.CanCollide = false
	tag(grate, "FZ_Vent", { VentGroup = group })
end

local function patrol(position: Vector3, area: string)
	local node = block(props, "PatrolNode", Vector3.new(1, 1, 1), CFrame.new(position.X, 3, position.Z), C.Concrete)
	node.Transparency = 1
	node.CanCollide = false
	node.CanQuery = false
	node.CanTouch = false
	tag(node, "FZ_CreaturePatrol", { Area = area })
end

local function fuseSpot(cf: CFrame, sector: string)
	local spot = block(props, "FuseSpot", Vector3.new(1, 1, 1), cf, C.Concrete)
	spot.Transparency = 1
	spot.CanCollide = false
	spot.CanQuery = false
	tag(spot, "FZ_FuseSpot", { Sector = sector })
end

local function checkpoint(id: string, cf: CFrame)
	local p = block(props, "CP_" .. id, Vector3.new(4, 1, 4), cf, C.Concrete)
	p.Transparency = 1
	p.CanCollide = false
	p.CanQuery = false
	tag(p, "FZ_Checkpoint", { CheckpointId = id })
end

local function interactable(part: BasePart, id: string, action: string, object: string, extra: { [string]: any }?)
	local attributes = { InteractId = id, ActionKey = action, ObjectKey = object }
	for key, value in extra or {} do
		attributes[key] = value
	end
	tag(part, "FZ_Interactable", attributes)
end

---------------------------------------------------------------------------
-- Building
---------------------------------------------------------------------------
local function buildShell()
	walls = folder("Walls")
	doors = folder("Doors")
	lights = folder("Lights")
	props = folder("Props")
	local structure = folder("Structure")

	-- Floors
	block(structure, "Floor_West", Vector3.new(50, 1, 170), CFrame.new(-75, -0.5, 0), C.Floor, Enum.Material.Concrete)
	block(structure, "Floor_East", Vector3.new(50, 1, 155), CFrame.new(75, -0.5, -7.5), C.Linoleum, Enum.Material.Plastic)
	block(structure, "Floor_Center", Vector3.new(100, 1, 120), CFrame.new(0, -0.5, 0), C.Floor, Enum.Material.Concrete)
	-- Roofs (separate per block so the shape reads from outside)
	block(structure, "Roof_West", Vector3.new(52, 1.2, 172), CFrame.new(-75, H + 0.6, 0), C.ConcreteDark, Enum.Material.Concrete)
	block(structure, "Roof_East", Vector3.new(52, 1.2, 157), CFrame.new(75, H + 0.6, -7.5), C.ConcreteDark, Enum.Material.Concrete)
	block(structure, "Roof_Center", Vector3.new(100, 1.2, 122), CFrame.new(0, H + 0.6, 0), C.ConcreteDark, Enum.Material.Concrete)

	-- Radome on the roof above the core: the landmark visible from the whole site.
	local radome = block(structure, "Radome", Vector3.new(30, 30, 30), CFrame.new(0, H + 10, 0), Color3.fromRGB(200, 202, 198), Enum.Material.Fabric)
	radome.Shape = Enum.PartType.Ball
	block(structure, "RadomeBase", Vector3.new(24, 4, 24), CFrame.new(0, H + 2.5, 0), C.ConcreteDark, Enum.Material.Concrete)

	-- Outer walls
	wallZ(-85, -100, -50)
	wallZ(-85, 50, 100)
	wallZ(-60, -50, 50)
	wallX(-100, -85, 85)
	wallX(100, -85, 70)
	wallZ(85, -100, -50)
	wallZ(60, -50, 50)
	wallZ(70, 50, 100, { { 75, 8 } }) -- main entrance

	-- West block: C | B | E
	wallZ(-25, -100, -50, { { -75, 6 } })
	wallZ(25, -100, -50, { { -75, 6 } })
	wallX(-50, -85, -25, { { -55, 10 } })
	wallX(-50, -25, 25, { { 0, 18 } })
	wallX(-50, 25, 85, { { 55, 10 } })

	-- East block: D | A | Control
	wallZ(-25, 50, 100, { { 75, 6 } })
	wallZ(25, 50, 100, { { 75, 6 } })
	wallX(50, -85, -25, { { -55, 10 } })
	wallX(50, -25, 25, { { 0, 18 } })
	wallX(50, 25, 70, { { 55, 10 } })

	-- Halls
	wallZ(-50, -50, 50, { { 0, 18 } })
	wallZ(50, -50, 50, { { 0, 18 } })

	-- Corridors to the core (18 wide = the core openings). The four pockets between
	-- corridors, halls and the core ring are closed off by these walls.
	wallZ(-9, -50, -20)
	wallZ(9, -50, -20)
	wallZ(-9, 20, 50)
	wallZ(9, 20, 50)
	wallX(-9, -50, -20)
	wallX(9, -50, -20)
	wallX(-9, 20, 50)
	wallX(9, 20, 50)

	-- Core: 16-sided ring, radius 22, openings N/E/S/W
	local core = folder("Core")
	local segments = 16
	local radius = 22
	for i = 0, segments - 1 do
		local angle = (i + 0.5) / segments * math.pi * 2
		local onAxis = (i % 4 == 0) or (i % 4 == 3) -- the two segments around each axis
		local mid = Vector3.new(math.cos(angle) * radius, 0, math.sin(angle) * radius)
		local length = 2 * radius * math.tan(math.pi / segments) + 0.4
		if onAxis then
			-- opening (17.5 studs over two segments) with a lintel above
			local y = DOOR_H + (H - DOOR_H) / 2
			block(core, "CoreLintel", Vector3.new(length, H - DOOR_H, T), CFrame.lookAt(mid + Vector3.new(0, y, 0), Vector3.new(0, y, 0)), C.SteelDark, Enum.Material.Metal)
		else
			block(core, "CoreWall", Vector3.new(length, H, T), CFrame.lookAt(mid + Vector3.new(0, H / 2, 0), Vector3.new(0, H / 2, 0)), C.SteelDark, Enum.Material.Metal)
		end
	end
	-- The core machine
	local column = block(core, "CoreColumn", Vector3.new(H, 10, 10), CFrame.new(0, H / 2, 0) * CFrame.Angles(0, 0, math.rad(90)), C.Steel, Enum.Material.Metal)
	column.Shape = Enum.PartType.Cylinder
	local ringA = block(core, "CoreRing", Vector3.new(1, 18, 18), CFrame.new(0, 3, 0) * CFrame.Angles(0, 0, math.rad(90)), C.SteelDark, Enum.Material.Metal)
	ringA.Shape = Enum.PartType.Cylinder
	local glow = block(core, "CoreGlow", Vector3.new(0.4, 11, 11), CFrame.new(0, 9, 0) * CFrame.Angles(0, 0, math.rad(90)), C.Emergency, Enum.Material.Neon)
	glow.Shape = Enum.PartType.Cylinder
	glow.CanCollide = false
	tag(glow, "FZ_SectorLight", { Sector = "CORE", OnColor = Color3.fromRGB(150, 210, 255) })
	local coreLight = Instance.new("PointLight")
	coreLight.Range = 30
	coreLight.Brightness = 1.4
	coreLight.Color = C.Emergency
	coreLight.Parent = glow

	local coreConsole = block(core, "CoreConsole", Vector3.new(5, 3.6, 2.4), CFrame.new(0, 1.8, 11), C.SteelDark, Enum.Material.Metal)
	local coreScreen = block(core, "CoreScreen", Vector3.new(4, 1.6, 0.1), CFrame.new(0, 4.4, 10.4) * CFrame.Angles(math.rad(-15), 0, 0), C.Screen, Enum.Material.Neon)
	coreScreen.CanCollide = false
	worldText(coreScreen, Enum.NormalId.Back, nil, "RELAIS 07 · DURCHLAUF 0007", nil, Color3.fromRGB(10, 40, 20))
	interactable(coreConsole, "c1_core", "INTERACT_ACTIVATE", "OBJECT_CORE", { HoldDuration = 3, MaxDistance = 8 })

	-- Core doors: locked until Relay Sector B is restored
	door(Vector3.new(0, 0, -21.6), true, 17.6, true, "B")
	door(Vector3.new(0, 0, 21.6), true, 17.6, true, "B")
	door(Vector3.new(-21.6, 0, 0), false, 17.6, true, "B")
	door(Vector3.new(21.6, 0, 0), false, 17.6, true, "B")

	-- Interior doors between sectors
	door(Vector3.new(-75, 0, -25), true, 6)
	door(Vector3.new(-75, 0, 25), true, 6)
	door(Vector3.new(75, 0, -25), true, 6)
	door(Vector3.new(75, 0, 25), true, 6)

	-- Signs at sector entrances
	-- (signs hang on the hall/corridor side of each lintel, facing the approaching player)
	sign(Vector3.new(-49.35, 12, -55), Vector3.new(1, 0, 0), "SIGN_SECTOR_C")
	sign(Vector3.new(-49.35, 12, 0), Vector3.new(1, 0, 0), "SIGN_SECTOR_B")
	sign(Vector3.new(-49.35, 12, 55), Vector3.new(1, 0, 0), "SIGN_SECTOR_E")
	sign(Vector3.new(49.35, 12, -55), Vector3.new(-1, 0, 0), "SIGN_SECTOR_D")
	sign(Vector3.new(49.35, 12, 0), Vector3.new(-1, 0, 0), "SIGN_SECTOR_A")
	sign(Vector3.new(75, 12, 70.65), Vector3.new(0, 0, 1), "SIGN_CONTROL")
	sign(Vector3.new(0, 12, -22.3), Vector3.new(0, 0, -1), "SIGN_CORE")
	sign(Vector3.new(0, 12, 22.3), Vector3.new(0, 0, 1), "SIGN_CORE")
end

local function furnish()
	-- Control room (start area, x 50..100, z 25..70)
	console(CFrame.new(62, 0, 66) * CFrame.Angles(0, math.rad(180), 0))
	console(CFrame.new(88, 0, 66) * CFrame.Angles(0, math.rad(180), 0))
	console(CFrame.new(96, 0, 40) * CFrame.Angles(0, math.rad(90), 0))
	local terminal = block(props, "ControlTerminal", Vector3.new(4, 3.6, 2.4), CFrame.new(75, 1.8, 38), C.SteelDark, Enum.Material.Metal)
	local screen = block(props, "TerminalScreen", Vector3.new(3.4, 1.5, 0.1), CFrame.new(75, 4.3, 37.2) * CFrame.Angles(math.rad(-15), 0, 0), C.Screen, Enum.Material.Neon)
	screen.CanCollide = false
	worldText(screen, Enum.NormalId.Front, nil, "KERN: OFFLINE  0/3", nil, Color3.fromRGB(10, 40, 20))
	interactable(terminal, "c1_terminal", "INTERACT_ACTIVATE", "OBJECT_CORE", { MaxDistance = 8 })
	desk(CFrame.new(62, 0, 45))
	cabinet(CFrame.new(98, 0, 30))
	for z = 35, 60, 12 do
		ceilingLight(Vector3.new(66, 0, z), "CONTROL", nil, z == 35, true)
		ceilingLight(Vector3.new(84, 0, z), "CONTROL")
	end
	checkpoint("C1_CONTROL", CFrame.new(75, 0.5, 52))

	-- Sector A: administration
	for x = 58, 92, 11 do
		desk(CFrame.new(x, 0, -10))
		desk(CFrame.new(x, 0, 10))
	end
	shelf(CFrame.new(99, 0, -14) * CFrame.Angles(0, math.rad(90), 0))
	cabinet(CFrame.new(98, 0, 18))
	local breaker = block(props, "BreakerA", Vector3.new(3, 4, 0.8), CFrame.new(99.2, 5, 4) * CFrame.Angles(0, math.rad(-90), 0), C.Steel:Lerp(C.Emergency, 0.25), Enum.Material.Metal)
	interactable(breaker, "c1_breaker_a", "INTERACT_HOLD_BREAKER", "OBJECT_BREAKER", { MaxDistance = 8 })
	breaker:SetAttribute("Armed", false)
	for x = 60, 90, 15 do
		ceilingLight(Vector3.new(x, 0, -12), "A")
		ceilingLight(Vector3.new(x, 0, 12), "A")
	end
	emergencyLight(Vector3.new(99, 11, -20), "A")
	fuseSpot(CFrame.new(91, 3.45, 10), "A")
	fuseSpot(CFrame.new(58, 3.45, -10), "A")

	-- Sector D: quarters
	for z = -78, -38, 13 do
		bunk(CFrame.new(60, 0, z))
		bunk(CFrame.new(93, 0, z))
	end
	for z = -80, -60, 3 do
		locker(CFrame.new(75 + (z % 2), 0, z) * CFrame.Angles(0, math.rad(90), 0))
	end
	ceilingLight(Vector3.new(66, 0, -70), "D", Color3.fromRGB(255, 214, 170))
	ceilingLight(Vector3.new(84, 0, -45), "D", Color3.fromRGB(255, 214, 170))
	fuseSpot(CFrame.new(93, 5.8, -65), "D")
	fuseSpot(CFrame.new(60, 2.2, -39), "D")

	-- Sector C: research / archive
	for z = -80, -35, 11 do
		shelf(CFrame.new(-90, 0, z) * CFrame.Angles(0, math.rad(90), 0))
		shelf(CFrame.new(-74, 0, z) * CFrame.Angles(0, math.rad(90), 0))
	end
	desk(CFrame.new(-60, 0, -40))
	ceilingLight(Vector3.new(-82, 0, -70), "C", nil, true)
	ceilingLight(Vector3.new(-62, 0, -45), "C")
	fuseSpot(CFrame.new(-60, 3.45, -40), "C")
	fuseSpot(CFrame.new(-82, 0.4, -82), "C")

	-- Sector B: laboratories + Relay panel (starts without power)
	for z = -15, 15, 10 do
		labTable(CFrame.new(-86, 0, z))
		labTable(CFrame.new(-68, 0, z))
	end
	local relay = block(props, "RelayPanelB", Vector3.new(0.8, 7, 6), CFrame.new(-99.2, 4.5, 0), C.Steel, Enum.Material.Metal)
	local relayLamp = block(props, "RelayLampB", Vector3.new(0.3, 0.8, 4), CFrame.new(-98.7, 8.6, 0), C.Emergency, Enum.Material.Neon)
	relayLamp.CanCollide = false
	tag(relayLamp, "FZ_SectorLight", { Sector = "B", OnColor = C.Screen })
	interactable(relay, "c1_relay_b", "INTERACT_INSERT", "OBJECT_RELAY_B", { HoldDuration = 4, MaxDistance = 8 })
	for z = -15, 15, 15 do
		ceilingLight(Vector3.new(-78, 0, z), "B")
	end
	emergencyLight(Vector3.new(-51.5, 9, 8), "B")

	-- Sector E: engineering
	local gen = generator(CFrame.new(-80, 0, 70))
	generator(CFrame.new(-80, 0, 45))
	gen:SetAttribute("SoundLoop", "generator_loop")
	CollectionService:AddTag(gen, "FZ_AmbientSource")
	pipeRun(Vector3.new(-98, 12, 30), Vector3.new(-98, 12, 84))
	pipeRun(Vector3.new(-60, 12.5, 30), Vector3.new(-60, 12.5, 84), 0.9)
	ceilingLight(Vector3.new(-70, 0, 40), "E", C.Sodium)
	ceilingLight(Vector3.new(-70, 0, 72), "E", C.Sodium)
	fuseSpot(CFrame.new(-66, 0.4, 82), "E")
	fuseSpot(CFrame.new(-95, 0.4, 56), "E")

	-- Halls and corridors: emergency lighting only (readable, tense)
	for x = -40, 40, 20 do
		emergencyLight(Vector3.new(x, 12, -59), "HALL")
		emergencyLight(Vector3.new(x, 12, 59), "HALL")
	end
	pipeRun(Vector3.new(-50, 13, -51), Vector3.new(50, 13, -51))
	pipeRun(Vector3.new(-50, 13, 51), Vector3.new(50, 13, 51))
	for _, p in { Vector3.new(0, 12, -36), Vector3.new(0, 12, 36), Vector3.new(-36, 12, 0), Vector3.new(36, 12, 0) } do
		emergencyLight(p + Vector3.new(if p.X == 0 then 8.3 else 0, 0, if p.X == 0 then 0 else 8.3), "HALL")
	end
	checkpoint("C1_CORE", CFrame.new(0, 0.5, 40))

	-- Vents (creature shortcuts, always announced by a rattle)
	vent(Vector3.new(99.3, 1.5, -40), Vector3.new(-1, 0, 0), "east")
	vent(Vector3.new(99.3, 1.5, 15), Vector3.new(-1, 0, 0), "east")
	vent(Vector3.new(-99.3, 1.5, -60), Vector3.new(1, 0, 0), "west")
	vent(Vector3.new(-99.3, 1.5, 70), Vector3.new(1, 0, 0), "west")
	vent(Vector3.new(-20, 1.5, -59.3), Vector3.new(0, 0, 1), "hall")
	vent(Vector3.new(20, 1.5, 59.3), Vector3.new(0, 0, -1), "hall")

	-- Patrol graph: one node per space
	for _, node in {
		{ Vector3.new(75, 0, -55), "D" }, { Vector3.new(75, 0, 0), "A" }, { Vector3.new(75, 0, 45), "CONTROL" },
		{ Vector3.new(-75, 0, -55), "C" }, { Vector3.new(-75, 0, 0), "B" }, { Vector3.new(-75, 0, 55), "E" },
		{ Vector3.new(-30, 0, -55), "HALL" }, { Vector3.new(30, 0, -55), "HALL" },
		{ Vector3.new(-30, 0, 55), "HALL" }, { Vector3.new(30, 0, 55), "HALL" },
		{ Vector3.new(0, 0, -36), "HALL" }, { Vector3.new(0, 0, 36), "HALL" },
		{ Vector3.new(-36, 0, 0), "HALL" }, { Vector3.new(36, 0, 0), "HALL" },
	} do
		patrol(node[1], node[2])
	end

	local spawn = block(props, "CreatureSpawn", Vector3.new(2, 1, 2), CFrame.new(-80, 3, -78), C.Concrete)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.CanQuery = false
	CollectionService:AddTag(spawn, "FZ_CreatureSpawn")
end

---------------------------------------------------------------------------
-- Outside: terrain, road, fence, gatehouse, antenna, forest
---------------------------------------------------------------------------
local function tree(parent: Instance, position: Vector3, scale: number)
	local height = 26 * scale
	block(parent, "Trunk", Vector3.new(1.4 * scale, height, 1.4 * scale), CFrame.new(position + Vector3.new(0, height / 2, 0)), C.Bark, Enum.Material.Wood)
	for i, s in { 1, 0.75, 0.5 } do
		local layer = block(parent, "Needles", Vector3.new(1, 1, 1), CFrame.new(position + Vector3.new(0, height * (0.35 + i * 0.18), 0)), C.Pine, Enum.Material.Grass)
		layer.CanCollide = false
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = Vector3.new(12 * s * scale, 10 * scale, 12 * s * scale)
		mesh.Parent = layer
	end
end

local function lampPost(parent: Instance, position: Vector3, facing: Vector3)
	local post = block(parent, "LampPost", Vector3.new(0.5, 14, 0.5), CFrame.new(position + Vector3.new(0, 7, 0)), C.SteelDark, Enum.Material.Metal)
	local head = block(parent, "LampHead", Vector3.new(2, 0.5, 1), CFrame.lookAt(post.Position + Vector3.new(0, 7, 0), post.Position + Vector3.new(0, 7, 0) + facing) * CFrame.new(0, 0, -1), C.Sodium, Enum.Material.Neon)
	local light = Instance.new("SpotLight")
	light.Face = Enum.NormalId.Bottom
	light.Angle = 110
	light.Range = 36
	light.Brightness = 2.4
	light.Color = C.Sodium
	light.Shadows = true
	light.Parent = head
	CollectionService:AddTag(head, "FZ_KeyLight")
end

local function buildOutside()
	local outside = folder("Outside")

	-- Terrain ground (cheap, looks natural). Building/road sit on top.
	workspace.Terrain:FillBlock(CFrame.new(0, -5.1, 80), Vector3.new(900, 10, 900), Enum.Material.Grass)
	workspace.Terrain:FillBlock(CFrame.new(-60, -1.2, 150), Vector3.new(60, 2, 40), Enum.Material.Mud)

	-- Yard and road (main entrance at x 75, z 70 -> gate at z 240)
	block(outside, "Yard", Vector3.new(120, 1, 60), CFrame.new(40, -0.45, 100), C.Asphalt, Enum.Material.Asphalt)
	block(outside, "Road", Vector3.new(16, 1, 140), CFrame.new(75, -0.45, 200), C.Asphalt, Enum.Material.Asphalt)
	block(outside, "RoadOut", Vector3.new(16, 1, 160), CFrame.new(75, -0.45, 350), C.Asphalt, Enum.Material.Asphalt)
	for z = 110, 230, 40 do
		lampPost(outside, Vector3.new(86, 0, z), Vector3.new(-1, 0, 0))
	end
	lampPost(outside, Vector3.new(40, 0, 82), Vector3.new(0, 0, 1))
	-- Parked service van (silhouette)
	block(outside, "Van", Vector3.new(7, 7, 15), CFrame.new(58, 3.6, 120) * CFrame.Angles(0, math.rad(8), 0), Color3.fromRGB(150, 150, 140), Enum.Material.Metal)

	-- Perimeter fence with gate gap
	local fence = Instance.new("Folder")
	fence.Name = "Fence"
	fence.Parent = outside
	local function fenceLine(a: Vector3, b: Vector3)
		local length = (b - a).Magnitude
		local count = math.max(1, math.floor(length / 12))
		for i = 0, count do
			local p = a:Lerp(b, i / count)
			block(fence, "Post", Vector3.new(0.4, 9, 0.4), CFrame.new(p + Vector3.new(0, 4.5, 0)), C.SteelDark, Enum.Material.Metal)
		end
		for _, y in { 0.6, 8.6 } do
			local rail = block(fence, "Rail", Vector3.new(0.25, 0.25, length), CFrame.lookAt((a + b) / 2 + Vector3.new(0, y, 0), b + Vector3.new(0, y, 0)), C.SteelDark, Enum.Material.Metal)
			rail.CanCollide = false
		end
		local mesh = block(fence, "Mesh", Vector3.new(0.1, 8, length), CFrame.lookAt((a + b) / 2 + Vector3.new(0, 4.6, 0), b + Vector3.new(0, 4.6, 0)), C.Steel, Enum.Material.DiamondPlate)
		mesh.Transparency = 0.75
	end
	fenceLine(Vector3.new(-130, 0, -110), Vector3.new(150, 0, -110))
	fenceLine(Vector3.new(150, 0, -110), Vector3.new(150, 0, 240))
	fenceLine(Vector3.new(150, 0, 240), Vector3.new(84, 0, 240))
	fenceLine(Vector3.new(66, 0, 240), Vector3.new(-130, 0, 240))
	fenceLine(Vector3.new(-130, 0, 240), Vector3.new(-130, 0, -110))

	-- Gate + gatehouse (opening sequence: fax, logbook code, maintenance note)
	block(outside, "GatePillarL", Vector3.new(2, 10, 2), CFrame.new(65, 5, 240), C.Concrete, Enum.Material.Concrete)
	block(outside, "GatePillarR", Vector3.new(2, 10, 2), CFrame.new(85, 5, 240), C.Concrete, Enum.Material.Concrete)
	local stationSign = block(outside, "StationSign", Vector3.new(14, 3, 0.3), CFrame.new(75, 8.5, 240.6), C.Plastic, Enum.Material.SmoothPlastic)
	worldText(stationSign, Enum.NormalId.Back, "SIGN_STATION")

	local gx, gz = 100, 232
	local gh = Instance.new("Model")
	gh.Name = "Gatehouse"
	gh.Parent = outside
	block(gh, "Floor", Vector3.new(14, 0.4, 12), CFrame.new(gx, 0.2, gz), C.Linoleum, Enum.Material.Plastic)
	block(gh, "Roof", Vector3.new(15, 0.6, 13), CFrame.new(gx, 9.3, gz), C.ConcreteDark, Enum.Material.Concrete)
	block(gh, "WallN", Vector3.new(14, 9, 0.6), CFrame.new(gx, 4.5, gz - 6), C.Concrete, Enum.Material.Concrete)
	block(gh, "WallE", Vector3.new(0.6, 9, 12), CFrame.new(gx + 7, 4.5, gz), C.Concrete, Enum.Material.Concrete)
	block(gh, "WallS", Vector3.new(14, 9, 0.6), CFrame.new(gx, 4.5, gz + 6), C.Concrete, Enum.Material.Concrete)
	block(gh, "WallW_A", Vector3.new(0.6, 9, 4), CFrame.new(gx - 7, 4.5, gz - 4), C.Concrete, Enum.Material.Concrete)
	block(gh, "WallW_B", Vector3.new(0.6, 9, 4), CFrame.new(gx - 7, 4.5, gz + 4), C.Concrete, Enum.Material.Concrete)
	block(gh, "WallW_Top", Vector3.new(0.6, 2, 4), CFrame.new(gx - 7, 8, gz), C.Concrete, Enum.Material.Concrete)
	local lamp = block(gh, "CeilingLamp", Vector3.new(3, 0.2, 0.8), CFrame.new(gx, 8.9, gz), Color3.fromRGB(255, 214, 160), Enum.Material.Neon)
	local lampLight = Instance.new("PointLight")
	lampLight.Range = 16
	lampLight.Brightness = 0.9
	lampLight.Color = Color3.fromRGB(255, 206, 150)
	lampLight.Shadows = true
	lampLight.Parent = lamp
	CollectionService:AddTag(lamp, "FZ_KeyLight")
	local deskTop = block(gh, "Desk", Vector3.new(2.6, 3, 7), CFrame.new(gx + 5, 1.9, gz), C.Wood, Enum.Material.Wood)
	local fax = block(gh, "Fax", Vector3.new(1.2, 0.6, 1.6), deskTop.CFrame * CFrame.new(0, 1.8, -1.6), C.Plastic, Enum.Material.SmoothPlastic)
	interactable(fax, "c1_fax", "INTERACT_READ", "OBJECT_FAX", { MaxDistance = 7 })
	local faxLed = Instance.new("PointLight")
	faxLed.Range = 3
	faxLed.Brightness = 1.5
	faxLed.Color = Color3.fromRGB(255, 90, 60)
	faxLed.Parent = fax
	local logbook = block(gh, "Logbook", Vector3.new(1, 0.1, 1.4), deskTop.CFrame * CFrame.new(0.1, 1.55, 1.8), C.Paper, Enum.Material.Fabric)
	worldText(logbook, Enum.NormalId.Top, nil, "02:14  VESPER-0214")
	local board = block(gh, "NoticeBoard", Vector3.new(4.5, 3.2, 0.2), CFrame.new(gx, 4.6, gz - 5.6), Color3.fromRGB(120, 96, 70), Enum.Material.Cardboard)
	local note = block(gh, "Note", Vector3.new(2.4, 1.9, 0.05), board.CFrame * CFrame.new(0.4, 0.2, 0.13), C.Paper, Enum.Material.SmoothPlastic)
	worldText(note, Enum.NormalId.Back, "NOTE_MAINTENANCE", nil, { code = "SIGNAL-017" })

	-- Antenna (extraction) south-west in the yard
	local antenna = Instance.new("Model")
	antenna.Name = "Antenna"
	antenna.Parent = outside
	local ax, az = -60, 150
	block(antenna, "Pad", Vector3.new(30, 1, 30), CFrame.new(ax, 0, az), C.ConcreteDark, Enum.Material.Concrete)
	local levels = 8
	local height = 110
	for i = 0, levels - 1 do
		local y0, y1 = i / levels * height, (i + 1) / levels * height
		local w0, w1 = 10 - i * 1.0, 10 - (i + 1) * 1.0
		for _, corner in { { 1, 1 }, { -1, 1 }, { 1, -1 }, { -1, -1 } } do
			local a = Vector3.new(ax + corner[1] * w0, y0, az + corner[2] * w0)
			local b = Vector3.new(ax + corner[1] * w1, y1, az + corner[2] * w1)
			block(antenna, "Leg", Vector3.new(0.7, 0.7, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), C.Emergency:Lerp(C.SteelDark, 0.55), Enum.Material.Metal)
		end
		for _, side in { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } } do
			local a = Vector3.new(ax + side[1] * w0 + side[2] * w0, y0, az + side[2] * w0 - side[1] * w0)
			local b = Vector3.new(ax + side[1] * w1 - side[2] * w1, y1, az + side[2] * w1 + side[1] * w1)
			local brace = block(antenna, "Brace", Vector3.new(0.35, 0.35, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), C.SteelDark, Enum.Material.Metal)
			brace.CanCollide = false
		end
		if i % 2 == 1 then
			local beacon = block(antenna, "Beacon", Vector3.new(1, 1, 1), CFrame.new(ax + w1, y1, az + w1), C.Emergency, Enum.Material.Neon)
			beacon.CanCollide = false
			local beaconLight = Instance.new("PointLight")
			beaconLight.Range = 18
			beaconLight.Brightness = 2
			beaconLight.Color = C.Emergency
			beaconLight.Parent = beacon
			CollectionService:AddTag(beacon, "FZ_Beacon")
		end
	end
	local dish = block(antenna, "Dish", Vector3.new(1, 12, 12), CFrame.new(ax + 4, 40, az - 4) * CFrame.Angles(0, math.rad(40), math.rad(20)), C.Plastic, Enum.Material.Metal)
	dish.Shape = Enum.PartType.Cylinder
	local cabinetBox = block(antenna, "ExtractionCabinet", Vector3.new(3, 5, 2), CFrame.new(ax, 3, az + 12), C.Steel, Enum.Material.Metal)
	interactable(cabinetBox, "c1_antenna", "INTERACT_LEAVE", "OBJECT_ANTENNA", { HoldDuration = 2, MaxDistance = 8 })

	-- Forest ring outside the fence (deterministic)
	local forest = Instance.new("Folder")
	forest.Name = "Forest"
	forest.Parent = outside
	local placed = 0
	while placed < 170 do
		local x = rng:NextNumber(-360, 380)
		local z = rng:NextNumber(-330, 460)
		local insideCompound = x > -140 and x < 160 and z > -120 and z < 250
		local onRoad = math.abs(x - 75) < 16 and z > 240
		if not insideCompound and not onRoad then
			tree(forest, Vector3.new(x, 0, z), rng:NextNumber(0.8, 1.35))
			placed += 1
		end
	end

	-- Spawn (behind the menu camera), checkpoint at the gate, menu camera
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "FZ_Spawn"
	spawn.Anchored = true
	spawn.Size = Vector3.new(6, 1, 6)
	spawn.CFrame = CFrame.new(75, 0.5, 300)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.Parent = outside
	local decal = spawn:FindFirstChildOfClass("Decal")
	if decal then
		decal:Destroy()
	end
	checkpoint("C1_START", CFrame.new(75, 0.5, 252))
	local menuCamera = block(outside, "MenuCamera", Vector3.new(1, 1, 1), CFrame.lookAt(Vector3.new(58, 7, 286), Vector3.new(10, 26, 60)), C.Concrete)
	menuCamera.Transparency = 1
	menuCamera.CanCollide = false
	menuCamera.CanQuery = false
	CollectionService:AddTag(menuCamera, "FZ_MenuCamera")
end

local function buildLighting()
	Lighting.ClockTime = 0.4
	Lighting.Brightness = 0.7
	Lighting.Ambient = Color3.fromRGB(18, 21, 24)
	Lighting.OutdoorAmbient = Color3.fromRGB(38, 44, 52)
	Lighting.EnvironmentDiffuseScale = 0.35
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	local atmosphere = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmosphere.Density = 0.36
	atmosphere.Offset = 0.12
	atmosphere.Color = Color3.fromRGB(112, 124, 134)
	atmosphere.Decay = Color3.fromRGB(46, 56, 66)
	atmosphere.Glare = 0
	atmosphere.Haze = 1.6
	atmosphere.Parent = Lighting
end

function Map.Build(): Model
	root = Instance.new("Model")
	root.Name = "FZ_RelayStation07"
	buildShell()
	furnish()
	buildOutside()
	buildLighting()
	root.Parent = workspace
	return root
end

return Map
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="28">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">AdminService</string>
            <string name="Source"><![CDATA[-- AdminService: server-side authorization and audit log for maintenance tools.
--
-- Security model:
--   1. IsAuthorized() checks UserId / ownership on the server (cached per session).
--   2. The gesture code is read from ServerStorage at runtime (attribute
--      "FZ_AdminGesture", set by the owner in Studio, NOT committed to git). It only
--      unlocks the hidden menu entry for authorized players.
--   3. Every admin remote call re-checks authorization; the client-visible attribute
--      FZ_Admin is only a UI hint and is never trusted.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local AdminConfig = require(script.Parent.Parent.AdminConfig)
local DataService = require(script.Parent.DataService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local AdminService = {}

local authorizedCache: { [Player]: boolean } = {}
local unlocked: { [Player]: boolean } = {}
local auditLog: { { time: number, userId: number, name: string, action: string, detail: string } } = {}
local MAX_LOG = 200

function AdminService.Log(player: Player, action: string, detail: string?)
	local entry = {
		time = os.time(),
		userId = player.UserId,
		name = player.Name,
		action = action,
		detail = detail or "",
	}
	table.insert(auditLog, entry)
	if #auditLog > MAX_LOG then
		table.remove(auditLog, 1)
	end
	print(string.format("[FZ-ADMIN] %s (%d) %s %s", entry.name, entry.userId, action, entry.detail))
end

function AdminService.IsAuthorized(player: Player): boolean
	local cached = authorizedCache[player]
	if cached ~= nil then
		return cached
	end
	local authorized = false
	local certain = true
	if RunService:IsStudio() and AdminConfig.AllowAllInStudio then
		authorized = true
	elseif table.find(AdminConfig.UserIds, player.UserId) then
		authorized = true
	elseif game.CreatorType == Enum.CreatorType.User then
		authorized = player.UserId == game.CreatorId
	elseif game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(player.GetRankInGroup, player, game.CreatorId)
		if ok then
			authorized = rank >= AdminConfig.MinGroupRank
		else
			certain = false -- web call failed: do not cache a false negative
		end
	end
	if certain then
		authorizedCache[player] = authorized
	end
	return authorized
end

function AdminService.MatchesGesture(normalizedCode: string): boolean
	local gesture = ServerStorage:GetAttribute("FZ_AdminGesture")
	if type(gesture) ~= "string" or #gesture < 6 then
		return false
	end
	return string.upper(gesture) == normalizedCode
end

function AdminService.Unlock(player: Player)
	unlocked[player] = true
	player:SetAttribute("FZ_Admin", true)
	AdminService.Log(player, "unlock")
end

local function isAllowed(player: Player): boolean
	return unlocked[player] == true and AdminService.IsAuthorized(player)
end

local ACTIONS = {}

ACTIONS.grant_test_marks = function(player: Player)
	local ok = DataService.Mutate(player, function(data)
		data.signalMarks += 100
	end)
	return { ok = ok }
end

-- World tools. Anything that can affect other players is limited to Studio and private
-- servers, so admins can never harass or break public sessions.
local function isTestServer(): boolean
	return RunService:IsStudio() or game.PrivateServerId ~= ""
end

local function lazy(name: string)
	return require(script.Parent[name])
end

ACTIONS.spawn_creature = function(player: Player)
	if not isTestServer() then
		return { ok = false, reason = "public" }
	end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return { ok = false }
	end
	local cf = root.CFrame * CFrame.new(0, 3, -18)
	lazy("CreatureService").Spawn(CFrame.lookAt(cf.Position, root.Position * Vector3.new(1, 0, 1) + Vector3.new(0, cf.Position.Y, 0)))
	return { ok = true }
end

ACTIONS.toggle_ai = function()
	local creatures = lazy("CreatureService")
	creatures.SetAIEnabled(not creatures.IsAIEnabled())
	return { ok = true, enabled = creatures.IsAIEnabled() }
end

ACTIONS.play_creature = function(player: Player)
	if not isTestServer() then
		return { ok = false, reason = "public" }
	end
	local Rig = require(script.Parent.Parent.Creature.Rig)
	local old = player.Character
	local pivot = if old then old:GetPivot() else CFrame.new(0, 10, 0)
	local model = Rig.Create()
	model.Name = player.Name
	model:PivotTo(pivot + Vector3.new(0, 4, 0))
	player:SetAttribute("FZ_MonsterMode", true)
	player.CameraMode = Enum.CameraMode.Classic
	player.CameraMinZoomDistance = 10
	player.CameraMaxZoomDistance = 18
	model.Parent = workspace
	Rig.Tag(model)
	player.Character = model
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = 14
	end
	if old then
		old:Destroy()
	end
	return { ok = true }
end

ACTIONS.play_human = function(player: Player)
	player:SetAttribute("FZ_MonsterMode", false)
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	player.CameraMinZoomDistance = 0.5
	player.CameraMaxZoomDistance = 0.5
	player:LoadCharacter()
	return { ok = true }
end

ACTIONS.tp_core = function(player: Player)
	local character = player.Character
	if character then
		character:PivotTo(CFrame.new(0, 4, 32))
	end
	return { ok = true }
end

ACTIONS.toggle_speed = function(player: Player)
	player:SetAttribute("FZ_AdminSpeed", not player:GetAttribute("FZ_AdminSpeed"))
	return { ok = true }
end

ACTIONS.reset = function()
	lazy("GameFlowService").ResetChapter()
	lazy("HealthService").HealAll()
	lazy("DoorService").CloseAll()
	return { ok = true }
end

ACTIONS.get_log = function()
	local recent = {}
	for i = math.max(1, #auditLog - 19), #auditLog do
		table.insert(recent, auditLog[i])
	end
	return { ok = true, log = recent }
end

function AdminService.Start()
	if type(ServerStorage:GetAttribute("FZ_AdminGesture")) ~= "string" then
		warn("[FZ-ADMIN] No gesture configured. Set the string attribute 'FZ_AdminGesture' on ServerStorage (min. 6 characters) to enable the hidden maintenance entry.")
	end

	local limiter = RateLimiter.new(10, 1)
	Net.Function("AdminAction").OnServerInvoke = function(player: Player, action: any, _payload: any)
		if not limiter:Allow(player) then
			return { ok = false, reason = "rate_limited" }
		end
		if type(action) ~= "string" or not isAllowed(player) then
			AdminService.Log(player, "denied", tostring(action))
			return { ok = false, reason = "denied" }
		end
		local handler = ACTIONS[action]
		if not handler then
			return { ok = false, reason = "unknown" }
		end
		AdminService.Log(player, action)
		return handler(player)
	end

	-- Monster mode attack: same telegraphed damage as the AI, test servers only.
	local attackLimiter = RateLimiter.new(1, 0.6)
	Net.Event("MonsterAttack").OnServerEvent:Connect(function(player: Player)
		if not player:GetAttribute("FZ_MonsterMode") or not isAllowed(player) or not isTestServer() or not attackLimiter:Allow(player) then
			return
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then
			return
		end
		local creatureConfig = require(ReplicatedStorage.Shared.Config).Creature
		player.Character:SetAttribute("State", "Attack")
		task.delay(creatureConfig.AttackWindup, function()
			if not player.Character then
				return
			end
			player.Character:SetAttribute("State", "Chase")
			for _, other in Players:GetPlayers() do
				local otherRoot = other ~= player and other.Character and other.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
				if otherRoot and (otherRoot.Position - root.Position).Magnitude <= creatureConfig.AttackRange + 1.5 then
					lazy("HealthService").Damage(other, creatureConfig.Damage)
				end
			end
		end)
	end)

	Players.PlayerRemoving:Connect(function(player)
		authorizedCache[player] = nil
		unlocked[player] = nil
	end)
end

return AdminService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">CodeService</string>
            <string name="Source"><![CDATA[-- CodeService: redeemable codes hidden inside the game world.
-- Codes are defined in ServerStorage.Secrets.Codes (never replicated to clients), checked
-- server-side, redeemable once per account (session lock in DataService prevents
-- cross-server duplication) and saved immediately.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local AdminService = require(script.Parent.AdminService)
local DataService = require(script.Parent.DataService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local Codes = require(ServerStorage:WaitForChild("Secrets"):WaitForChild("Codes"))

local CodeService = {}

local function normalize(raw: string): string
	local trimmed = string.gsub(raw, "%s+", "")
	return string.upper(trimmed)
end

function CodeService.Redeem(player: Player, raw: any): { [string]: any }
	if type(raw) ~= "string" or #raw == 0 or #raw > Config.Codes.MaxLength * 2 then
		return { status = "invalid" }
	end
	local code = normalize(raw)
	if #code == 0 or #code > Config.Codes.MaxLength then
		return { status = "invalid" }
	end

	if AdminService.MatchesGesture(code) then
		if AdminService.IsAuthorized(player) then
			AdminService.Unlock(player)
			return { status = "admin" }
		end
		AdminService.Log(player, "gesture_denied")
		return { status = "invalid" } -- indistinguishable from a wrong code
	end

	local definition = Codes[code]
	if not definition or definition.active == false then
		return { status = "invalid" }
	end

	local profile = DataService.Get(player)
	if not profile or not profile.Persistent then
		-- Never hand out a reward that cannot be saved (and could then be redeemed again).
		return { status = "error" }
	end
	if profile.Data.redeemedCodes[definition.id] then
		return { status = "used" }
	end

	-- No yield between the check above and this write, so double invocations are safe.
	local amount = definition.reward.signalMarks or 0
	DataService.Mutate(player, function(data)
		data.redeemedCodes[definition.id] = os.time()
		data.signalMarks += amount
	end)
	DataService.SaveNow(player) -- if this fails, autosave retries; the profile stays locked
	return { status = "ok", amount = amount, balance = profile.Data.signalMarks }
end

function CodeService.Start()
	local limiter = RateLimiter.new(5, 1 / 6) -- burst 5, then one attempt every 6 s
	Net.Function("RedeemCode").OnServerInvoke = function(player: Player, raw: any)
		if not limiter:Allow(player) then
			return { status = "rate_limited" }
		end
		return CodeService.Redeem(player, raw)
	end
end

return CodeService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">CreatureService</string>
            <string name="Source"><![CDATA[-- CreatureService: server-authoritative AI for "Der Lauscher".
--
-- Fair, learnable rules (see docs/GAME_DESIGN.md):
--   * It HEARS: walking (7 studs), sprinting (20), radio transmissions (28), doors (16).
--     Standing still is silent.
--   * It SEES within 42 studs in a 65 degree cone, only with line of sight.
--   * Light blinds it briefly (flashlight aimed at the head), then it backs off.
--   * Every attack has a wind-up (crackle + pose). Three hits put you down, never one.
--   * Vent travel is always announced by a rattle at the exit vent.
-- States: Dormant, Patrol, Listen, Investigate, Search, Chase, Attack, Blinded, Retreat, Vent
-- The current state is replicated as the model attribute "State" for visuals and audio.

local CollectionService = game:GetService("CollectionService")
local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared.Assets)
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local DoorService = require(script.Parent.DoorService)
local HealthService = require(script.Parent.HealthService)
local NoiseService = require(script.Parent.NoiseService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)
local Rig = require(script.Parent.Parent.Creature.Rig)

local CreatureService = {}

local CC = Config.Creature
local TICK = 0.1

type Creature = {
	model: Model,
	humanoid: Humanoid,
	root: BasePart,
	state: string,
	stateTime: number,
	target: Vector3?,
	targetPlayer: Player?,
	lastSeen: number,
	lastSeenPosition: Vector3?,
	waypoints: { PathWaypoint },
	waypointIndex: number,
	pathTarget: Vector3?,
	nextRepath: number,
	nextAttack: number,
	blindReadyAt: number,
	visitedPatrol: { [Instance]: number },
	searchCenter: Vector3?,
	pendingNoise: { position: Vector3, radius: number }?,
	tracks: { [string]: AnimationTrack },
	lastFootprint: number,
}

local creature: Creature? = nil
local aiEnabled = true
local running = false

---------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------
local function flat(v: Vector3): Vector3
	return Vector3.new(v.X, 0, v.Z)
end

local function soloScale(): number
	local count = 0
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("FZ_InGame") then
			count += 1
		end
	end
	return if count <= 1 then CC.SoloSpeedScale else 1
end

local function setState(c: Creature, state: string)
	if c.state == state then
		return
	end
	c.state = state
	c.stateTime = os.clock()
	c.model:SetAttribute("State", state)
	c.waypoints = {}
	c.pathTarget = nil
	-- Optional real animations for user-provided models
	for name, track in c.tracks do
		local wanted = (state == "Attack" and name == "Attack")
			or (state == "Listen" and name == "Listen")
			or ((state == "Chase") and name == "Run")
			or ((state == "Patrol" or state == "Investigate" or state == "Search" or state == "Retreat") and name == "Walk")
			or ((state == "Blinded" or state == "Dormant") and name == "Idle")
		if wanted and not track.IsPlaying then
			track:Play(0.2)
		elseif not wanted and track.IsPlaying then
			track:Stop(0.2)
		end
	end
	if state == "Chase" then
		Net.Event("Sfx"):FireAllClients("creature_alert", c.root)
	end
end

local function playersInGame(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("FZ_InGame") and not player:GetAttribute("FZ_Downed") and not player:GetAttribute("FZ_MonsterMode") then
			local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
			if root then
				table.insert(list, player)
			end
		end
	end
	return list
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function hasLineOfSight(c: Creature, from: Vector3, to: Vector3, ignore: { Instance }): boolean
	local filter = { c.model }
	for _, instance in ignore do
		table.insert(filter, instance)
	end
	rayParams.FilterDescendantsInstances = filter
	local result = workspace:Raycast(from, to - from, rayParams)
	return result == nil
end

local function eyePosition(c: Creature): Vector3
	local head = c.model:FindFirstChild("Head")
	return if head and head:IsA("BasePart") then head.Position else c.root.Position + Vector3.new(0, 3, 0)
end

local function findVisiblePlayer(c: Creature): (Player?, number)
	local best, bestDistance = nil, math.huge
	local eye = eyePosition(c)
	local look = flat(c.root.CFrame.LookVector).Unit
	for _, player in playersInGame() do
		local character = player.Character :: Model
		local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
		local target = (head :: BasePart).Position
		local offset = target - eye
		local distance = offset.Magnitude
		if distance < CC.SightRange then
			local direction = flat(offset)
			local angle = if direction.Magnitude > 0 then math.deg(math.acos(math.clamp(look:Dot(direction.Unit), -1, 1))) else 0
			if (angle <= CC.SightAngle or distance < 9) and hasLineOfSight(c, eye, target, { character }) then
				if distance < bestDistance then
					best, bestDistance = player, distance
				end
			end
		end
	end
	return best, bestDistance
end

---------------------------------------------------------------------------
-- Movement
---------------------------------------------------------------------------
local function computePath(c: Creature, target: Vector3)
	local path = PathfindingService:CreatePath({
		AgentRadius = 2,
		AgentHeight = 9,
		AgentCanJump = false,
		WaypointSpacing = 5,
	})
	local ok = pcall(function()
		path:ComputeAsync(c.root.Position, target)
	end)
	if ok and path.Status == Enum.PathStatus.Success then
		c.waypoints = path:GetWaypoints()
		c.waypointIndex = math.min(2, #c.waypoints)
	else
		c.waypoints = { PathWaypoint.new(target, Enum.PathWaypointAction.Walk) }
		c.waypointIndex = 1
	end
	c.pathTarget = target
end

-- Returns true when the target is reached.
local function moveTowards(c: Creature, target: Vector3, speed: number, repathInterval: number?): boolean
	c.humanoid.WalkSpeed = speed * soloScale()
	local now = os.clock()
	if not c.pathTarget or (c.pathTarget - target).Magnitude > 4 or (repathInterval and now >= c.nextRepath) then
		computePath(c, target)
		c.nextRepath = now + (repathInterval or 2)
	end
	if flat(c.root.Position - target).Magnitude < 3.5 then
		c.humanoid:Move(Vector3.zero)
		return true
	end
	local waypoint = c.waypoints[c.waypointIndex]
	if not waypoint then
		return true
	end
	if flat(c.root.Position - waypoint.Position).Magnitude < 3 then
		c.waypointIndex += 1
		waypoint = c.waypoints[c.waypointIndex]
		if not waypoint then
			return flat(c.root.Position - target).Magnitude < 6
		end
	end
	c.humanoid:MoveTo(waypoint.Position)
	-- Open unlocked doors right in front of it (makes noise, very readable)
	for _, panel in CollectionService:GetTagged("FZ_Door") do
		if panel:IsA("BasePart") and not panel:GetAttribute("Open") and not panel:GetAttribute("Locked") then
			if (panel.Position - c.root.Position).Magnitude < 8 then
				DoorService.Open(panel)
			end
		end
	end
	return false
end

local function stop(c: Creature)
	c.humanoid:MoveTo(c.root.Position)
	c.humanoid.WalkSpeed = 0
end

local function face(c: Creature, position: Vector3)
	local from = c.root.Position
	local to = Vector3.new(position.X, from.Y, position.Z)
	if (to - from).Magnitude > 0.1 then
		c.root.CFrame = CFrame.lookAt(from, to)
	end
end

local function pickPatrolNode(c: Creature, near: Vector3?, radius: number?): Vector3?
	local nodes = CollectionService:GetTagged("FZ_CreaturePatrol")
	local candidates = {}
	local now = os.clock()
	for _, node in nodes do
		if node:IsA("BasePart") then
			local distance = (node.Position - (near or c.root.Position)).Magnitude
			local fresh = now - (c.visitedPatrol[node] or -999) > 40
			if (not radius or distance <= radius) and distance > 6 and fresh then
				table.insert(candidates, node)
			end
		end
	end
	if #candidates == 0 then
		for _, node in nodes do
			if node:IsA("BasePart") then
				table.insert(candidates, node)
			end
		end
	end
	if #candidates == 0 then
		return nil
	end
	local chosen = candidates[math.random(1, #candidates)] :: BasePart
	c.visitedPatrol[chosen] = now
	return chosen.Position
end

---------------------------------------------------------------------------
-- Vents
---------------------------------------------------------------------------
local function nearestVent(position: Vector3, exclude: Instance?): BasePart?
	local best, bestDistance = nil, math.huge
	for _, vent in CollectionService:GetTagged("FZ_Vent") do
		if vent ~= exclude and vent:IsA("BasePart") then
			local d = (vent.Position - position).Magnitude
			if d < bestDistance then
				best, bestDistance = vent, d
			end
		end
	end
	return best
end

local function travelVent(c: Creature, destination: Vector3)
	local entry = nearestVent(c.root.Position)
	local exit = nearestVent(destination, entry)
	if not entry or not exit or (entry.Position - c.root.Position).Magnitude > 12 then
		return false
	end
	setState(c, "Vent")
	Net.Event("Sfx"):FireAllClients("vent_rattle", entry.Position)
	c.root.Anchored = true
	c.model:SetAttribute("Hidden", true)
	c.model:PivotTo(CFrame.new(entry.Position.X, -200, entry.Position.Z))
	task.wait(CC.VentTravelTime - CC.VentWarning)
	if creature ~= c then
		return true
	end
	Net.Event("Sfx"):FireAllClients("vent_rattle", exit.Position)
	for _, player in Players:GetPlayers() do
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and ((root :: BasePart).Position - exit.Position).Magnitude < 45 then
			Net.Event("Subtitle"):FireClient(player, { text = "SFX_VENT", channel = "world", duration = 3, critical = true })
		end
	end
	task.wait(CC.VentWarning)
	if creature ~= c then
		return true
	end
	local out = exit.CFrame * CFrame.new(0, 0, -4)
	c.model:PivotTo(CFrame.new(out.Position.X, exit.Position.Y + 5, out.Position.Z) * CFrame.Angles(0, select(2, out:ToOrientation()), 0))
	c.root.Anchored = false
	c.model:SetAttribute("Hidden", false)
	c.searchCenter = exit.Position
	setState(c, "Search")
	return true
end

---------------------------------------------------------------------------
-- State machine
---------------------------------------------------------------------------
local function startInvestigate(c: Creature, position: Vector3)
	c.target = position
	setState(c, "Listen")
	stop(c)
	face(c, position)
end

local function step(c: Creature)
	local now = os.clock()
	local elapsed = now - c.stateTime
	local state = c.state

	if state == "Dormant" or state == "Vent" then
		return
	end

	if state == "Blinded" then
		stop(c)
		if elapsed > CC.BlindDuration then
			setState(c, "Retreat")
			c.target = pickPatrolNode(c, nil, nil)
		end
		return
	end

	-- Perception (sight beats hearing)
	local seen, seenDistance = findVisiblePlayer(c)
	if seen and state ~= "Attack" then
		c.targetPlayer = seen
		c.lastSeen = now
		local root = (seen.Character :: Model):FindFirstChild("HumanoidRootPart") :: BasePart
		c.lastSeenPosition = root.Position
		if state ~= "Chase" and (seenDistance < 25 or state == "Investigate" or state == "Search") then
			setState(c, "Chase")
		elseif state == "Patrol" then
			startInvestigate(c, root.Position)
		end
	end
	local noise = c.pendingNoise
	c.pendingNoise = nil
	if noise and state ~= "Chase" and state ~= "Attack" and state ~= "Retreat" then
		if state == "Investigate" or state == "Search" then
			c.target = noise.position -- update the goal, keep moving
			if state == "Search" then
				setState(c, "Investigate")
			end
		elseif state ~= "Listen" then
			startInvestigate(c, noise.position)
		end
	end

	state = c.state
	elapsed = now - c.stateTime

	if state == "Patrol" then
		if not c.target then
			c.target = pickPatrolNode(c, nil, nil)
		end
		if c.target and moveTowards(c, c.target, CC.PatrolSpeed) then
			c.target = pickPatrolNode(c, nil, nil)
		end
	elseif state == "Listen" then
		stop(c)
		if elapsed > CC.ListenTime then
			setState(c, "Investigate")
		end
	elseif state == "Investigate" then
		if not c.target or moveTowards(c, c.target, CC.InvestigateSpeed) then
			c.searchCenter = c.target or c.root.Position
			setState(c, "Search")
		end
	elseif state == "Search" then
		if elapsed > CC.SearchTime then
			setState(c, "Patrol")
			c.target = nil
		else
			if not c.target or moveTowards(c, c.target, CC.PatrolSpeed + 1) then
				c.target = pickPatrolNode(c, c.searchCenter, 45) or c.searchCenter
			end
		end
	elseif state == "Chase" then
		local player = c.targetPlayer
		local character = player and player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not player or not root or player:GetAttribute("FZ_Downed") or not player:GetAttribute("FZ_InGame") then
			c.searchCenter = c.lastSeenPosition or c.root.Position
			setState(c, "Search")
			return
		end
		if now - c.lastSeen > CC.LoseTrackTime then
			c.searchCenter = c.lastSeenPosition
			c.target = c.lastSeenPosition
			-- Sometimes it takes the vents instead of following
			if c.lastSeenPosition and math.random() < CC.VentChance and (c.lastSeenPosition - c.root.Position).Magnitude > 40 then
				task.spawn(travelVent, c, c.lastSeenPosition)
				return
			end
			setState(c, "Investigate")
			return
		end
		local goal = if now - c.lastSeen < 0.5 then root.Position else (c.lastSeenPosition or root.Position)
		moveTowards(c, goal, CC.ChaseSpeed, 0.6)
		if (root.Position - c.root.Position).Magnitude <= CC.AttackRange and now >= c.nextAttack then
			setState(c, "Attack")
		end
	elseif state == "Attack" then
		local player = c.targetPlayer
		local root = player and player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		c.humanoid.WalkSpeed = 2
		if root then
			face(c, root.Position)
		end
		if elapsed >= CC.AttackWindup then
			if player and root and (root.Position - c.root.Position).Magnitude <= CC.AttackRange + 1.5 then
				HealthService.Damage(player, CC.Damage)
				Net.Event("Sfx"):FireAllClients("creature_static_burst", c.root)
			end
			c.nextAttack = now + CC.AttackCooldown
			setState(c, "Chase")
		end
	elseif state == "Retreat" then
		if not c.target or moveTowards(c, c.target, CC.InvestigateSpeed) or elapsed > 8 then
			setState(c, "Patrol")
			c.target = nil
		end
	end

	-- Observer set: fresh tracks
	if c.state ~= "Vent" and now - c.lastFootprint > 1.6 and c.root.AssemblyLinearVelocity.Magnitude > 2 then
		c.lastFootprint = now
		for _, player in Players:GetPlayers() do
			if player:GetAttribute("FZ_Footprints") then
				Net.Event("Footprint"):FireClient(player, c.root.Position - Vector3.new(0, 5.6, 0))
			end
		end
	end
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------
local function loadTracks(c: Creature)
	local animator = c.humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	for name, id in Assets.CreatureAnimations do
		if id ~= "" then
			local animation = Instance.new("Animation")
			animation.AnimationId = id
			local ok, track = pcall(animator.LoadAnimation, animator, animation)
			if ok then
				track.Looped = name ~= "Attack"
				c.tracks[name] = track
			end
		end
	end
end

function CreatureService.Despawn()
	if creature then
		creature.model:Destroy()
		creature = nil
	end
	running = false
end

function CreatureService.Spawn(cframe: CFrame?): Model
	CreatureService.Despawn()
	local spawnCFrame = cframe
	if not spawnCFrame then
		local marker = CollectionService:GetTagged("FZ_CreatureSpawn")[1]
		spawnCFrame = if marker and marker:IsA("BasePart") then marker.CFrame else CFrame.new(0, 10, 0)
	end
	local model = Rig.Create()
	model:PivotTo(spawnCFrame :: CFrame)
	pcall(function()
		model.ModelStreamingMode = Enum.ModelStreamingMode.Persistent
	end)
	model.Parent = workspace
	Rig.Tag(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	local c: Creature = {
		model = model,
		humanoid = humanoid,
		root = root,
		state = "",
		stateTime = os.clock(),
		target = nil,
		targetPlayer = nil,
		lastSeen = 0,
		lastSeenPosition = nil,
		waypoints = {},
		waypointIndex = 1,
		pathTarget = nil,
		nextRepath = 0,
		nextAttack = 0,
		blindReadyAt = 0,
		visitedPatrol = {},
		searchCenter = nil,
		pendingNoise = nil,
		tracks = {},
		lastFootprint = 0,
	}
	loadTracks(c)
	creature = c
	setState(c, if aiEnabled then "Patrol" else "Dormant")

	running = true
	task.spawn(function()
		while running and creature == c and model.Parent do
			if aiEnabled then
				local ok, err = pcall(step, c)
				if not ok then
					warn("[FZ-Creature] AI step failed: " .. tostring(err))
				end
			end
			task.wait(TICK)
		end
	end)
	return model
end

function CreatureService.SetAIEnabled(enabled: boolean)
	aiEnabled = enabled
	if creature then
		if enabled then
			setState(creature, "Patrol")
		else
			setState(creature, "Dormant")
			stop(creature)
		end
	end
end

function CreatureService.IsAIEnabled(): boolean
	return aiEnabled
end

function CreatureService.Get(): Model?
	return creature and creature.model
end

-- Loud event somewhere (story): the creature comes to look.
function CreatureService.Alert(position: Vector3)
	local c = creature
	if c and aiEnabled and c.state ~= "Chase" and c.state ~= "Vent" then
		startInvestigate(c, position)
	end
end

function CreatureService.Start()
	NoiseService.Heard:Connect(function(position, radius, _source)
		local c = creature
		if not c or c.model:GetAttribute("Hidden") then
			return
		end
		local distance = (position - c.root.Position).Magnitude
		if distance <= radius * CC.HearingScale then
			local current = c.pendingNoise
			if not current or radius > current.radius then
				c.pendingNoise = { position = position, radius = radius }
			end
		end
	end)

	-- Flashlight: the client reports a hit, the server re-validates everything.
	local limiter = RateLimiter.new(4, 2)
	Net.Event("FlashCreature").OnServerEvent:Connect(function(player: Player)
		local c = creature
		if not c or not limiter:Allow(player) or not aiEnabled then
			return
		end
		if os.clock() < c.blindReadyAt or c.state == "Vent" or c.state == "Blinded" or c.state == "Dormant" then
			return
		end
		local character = player.Character
		local head = character and character:FindFirstChild("Head") :: BasePart?
		local light = head and head:FindFirstChild("FZ_Flashlight") :: SpotLight?
		if not head or not light or not light.Enabled or player:GetAttribute("FZ_Downed") then
			return
		end
		local eye = eyePosition(c)
		local range = CC.BlindRange * (tonumber(player:GetAttribute("FZ_FlashRange")) or 1)
		local toCreature = eye - head.Position
		if toCreature.Magnitude > range then
			return
		end
		local facing = flat((character :: Model):GetPivot().LookVector)
		local direction = flat(toCreature)
		if facing.Magnitude > 0 and direction.Magnitude > 0 and facing.Unit:Dot(direction.Unit) < math.cos(math.rad(60)) then
			return
		end
		if not hasLineOfSight(c, head.Position, eye, { character :: Model }) then
			return
		end
		local cooldown = CC.BlindCooldown * (tonumber(player:GetAttribute("FZ_BlindCooldownScale")) or 1)
		c.blindReadyAt = os.clock() + cooldown
		setState(c, "Blinded")
		stop(c)
		Net.Event("Sfx"):FireAllClients("creature_static_burst", c.root)
	end)
end

return CreatureService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- DataService: persistent player data with session locking.
--
-- * One profile per player, loaded with UpdateAsync and locked to this server (JobId),
--   so two servers can never write the same save at the same time (protects codes,
--   currency and progress against duplication when a player hops servers quickly).
-- * Autosave refreshes the lock; leaving releases it.
-- * If DataStores are unavailable (Studio without API access, outage) the player gets a
--   session-only profile and is told that progress will not be saved. Anything that must
--   persist (code rewards, purchases) refuses to run on such a profile.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Signal = require(Shared.Signal)
local Net = require(Shared.Net)

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local DataService = {}
DataService.ProfileLoaded = Signal.new() -- (player, profile)

export type Profile = {
	Player: Player,
	Key: string,
	Data: { [string]: any },
	Persistent: boolean,
	Dirty: boolean,
	Saving: boolean,
	Released: boolean,
}

local profiles: { [Player]: Profile } = {}
local store: DataStore? = nil

do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(Config.Data.StoreName)
	end)
	if ok then
		store = result
	else
		warn("[FZ-Data] DataStore unavailable, running session-only: " .. tostring(result))
	end
end

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for k, v in value do
		copy[k] = deepCopy(v)
	end
	return copy
end

local function defaultData(): { [string]: any }
	return {
		version = Config.Data.SchemaVersion,
		settings = Config.DefaultSettings(),
		signalMarks = 0,
		redeemedCodes = {}, -- [codeId] = unix time
		progress = {
			chapter = 1,
			checkpoint = "C1_START",
			completed = {}, -- array of chapter numbers
		},
		stats = { sessions = 0, firstJoin = os.time(), lastJoin = 0 },
		inventory = {}, -- [itemId] = true
		equipped = {}, -- { set = itemId?, radioSkin = itemId? }
	}
end

local function reconcile(data: { [string]: any }, template: { [string]: any })
	for key, value in template do
		if data[key] == nil then
			data[key] = deepCopy(value)
		elseif type(value) == "table" and type(data[key]) == "table" and next(value) ~= nil then
			reconcile(data[key], value)
		end
	end
end

local function sanitizeSettings(settings: { [string]: any })
	for key, definition in Config.Settings do
		local value = settings[key]
		if value ~= nil then
			local ok = Config.ValidateSetting(key, value)
			if not ok then
				settings[key] = definition.default
			end
		end
	end
	for key in settings do
		if Config.Settings[key] == nil then
			settings[key] = nil
		end
	end
end

-- Schema migrations. Add a branch for every SchemaVersion bump.
local function migrate(data: { [string]: any })
	local version = tonumber(data.version) or 0
	-- if version < 2 then ... end
	if version < Config.Data.SchemaVersion then
		data.version = Config.Data.SchemaVersion
	end
end

local function prepare(data: { [string]: any })
	migrate(data)
	reconcile(data, defaultData())
	if type(data.settings) ~= "table" then
		data.settings = Config.DefaultSettings()
	end
	sanitizeSettings(data.settings)
	if type(data.signalMarks) ~= "number" or data.signalMarks ~= data.signalMarks or data.signalMarks < 0 then
		data.signalMarks = 0
	end
	data.signalMarks = math.floor(data.signalMarks)
end

local function withRetries(label: string, attempts: number, callback: () -> any): (boolean, any)
	local delayTime = 1
	for attempt = 1, attempts do
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		warn(string.format("[FZ-Data] %s failed (attempt %d/%d): %s", label, attempt, attempts, tostring(result)))
		if attempt < attempts then
			task.wait(delayTime)
			delayTime = math.min(delayTime * 2, 8)
		end
	end
	return false, nil
end

local function publishAttributes(profile: Profile)
	local player = profile.Player
	player:SetAttribute("FZ_SignalMarks", profile.Data.signalMarks)
	player:SetAttribute("FZ_DataPersistent", profile.Persistent)
end

local function loadProfile(player: Player): Profile?
	local key = "u_" .. player.UserId
	local profile: Profile = {
		Player = player,
		Key = key,
		Data = {},
		Persistent = false,
		Dirty = false,
		Saving = false,
		Released = false,
	}

	local loaded = nil
	if store then
		local maxLockAttempts = 6
		for lockAttempt = 1, maxLockAttempts do
			local lockedByOther = false
			local ok, result = withRetries("Load " .. key, 4, function()
				return (store :: DataStore):UpdateAsync(key, function(old)
					lockedByOther = false
					local data = if type(old) == "table" then old else defaultData()
					local lock = data.lock
					if
						type(lock) == "table"
						and lock.job ~= game.JobId
						and os.time() - (tonumber(lock.time) or 0) < Config.Data.LockTimeout
						and lockAttempt < maxLockAttempts
					then
						-- Another server still owns this save (usually: it is finishing the
						-- save after the player left). Abort this write and retry shortly.
						lockedByOther = true
						return nil
					end
					prepare(data)
					data.lock = { job = game.JobId, time = os.time() }
					data.stats.sessions += 1
					data.stats.lastJoin = os.time()
					return data
				end)
			end)
			if not ok then
				break
			end
			if not lockedByOther and type(result) == "table" then
				loaded = result
				break
			end
			if player.Parent == nil then
				return nil
			end
			task.wait(5)
		end
	end

	if loaded then
		profile.Data = loaded
		profile.Persistent = true
	else
		profile.Data = defaultData()
		profile.Persistent = false
		if store then
			warn("[FZ-Data] Using session-only profile for " .. key)
		end
	end
	return profile
end

local function saveProfile(profile: Profile, release: boolean): boolean
	if not profile.Persistent or not store then
		return true
	end
	while profile.Saving do
		task.wait()
	end
	if profile.Released then
		return true
	end
	profile.Saving = true
	local lostLock = false
	local wasDirty = profile.Dirty
	local ok = withRetries("Save " .. profile.Key, if release then 5 else 3, function()
		return (store :: DataStore):UpdateAsync(profile.Key, function(old)
			lostLock = false
			if type(old) == "table" and type(old.lock) == "table" and old.lock.job ~= game.JobId then
				lostLock = true
				return nil
			end
			local out = table.clone(profile.Data)
			out.lock = if release then nil else { job = game.JobId, time = os.time() }
			return out
		end)
	end)
	profile.Saving = false
	if lostLock then
		-- Another server took this save over. Never overwrite it from here.
		warn("[FZ-Data] Lost session lock for " .. profile.Key .. "; profile is now read-only")
		profile.Persistent = false
		publishAttributes(profile)
		return false
	end
	if ok then
		if wasDirty then
			profile.Dirty = false
		end
		if release then
			profile.Released = true
		end
	end
	return ok
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function DataService.Get(player: Player): Profile?
	return profiles[player]
end

function DataService.WaitFor(player: Player, timeout: number?): Profile?
	local deadline = os.clock() + (timeout or 20)
	while not profiles[player] and player.Parent and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

-- Mutate data through this function so the profile is marked dirty.
function DataService.Mutate(player: Player, mutator: ({ [string]: any }) -> ()): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	mutator(profile.Data)
	profile.Dirty = true
	publishAttributes(profile)
	return true
end

-- Adds earned Signal Marks (never negative) and tells the player.
function DataService.Grant(player: Player, amount: number): boolean
	if amount <= 0 then
		return false
	end
	local ok = DataService.Mutate(player, function(data)
		data.signalMarks += math.floor(amount)
	end)
	if ok then
		Net.Event("Notify"):FireClient(player, "REWARD_MARKS", { amount = math.floor(amount) })
	end
	return ok
end

-- Immediate save for important changes (code rewards, chapter completion).
function DataService.SaveNow(player: Player): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	return saveProfile(profile, false)
end

function DataService.Start()
	local fetchLimiter = RateLimiter.new(3, 0.2)

	local function onPlayerAdded(player: Player)
		local profile = loadProfile(player)
		if not profile then
			return
		end
		if player.Parent == nil then
			-- Left while loading: release the lock right away.
			saveProfile(profile, true)
			return
		end
		profiles[player] = profile
		publishAttributes(profile)
		player:SetAttribute("FZ_DataReady", true)
		DataService.ProfileLoaded:Fire(player, profile)
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	Players.PlayerRemoving:Connect(function(player)
		local profile = profiles[player]
		if profile then
			saveProfile(profile, true)
			profiles[player] = nil
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and not store then
			return
		end
		local pending = 0
		for _, profile in profiles do
			pending += 1
			task.spawn(function()
				saveProfile(profile, true)
				pending -= 1
			end)
		end
		local deadline = os.clock() + 25
		while pending > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)

	task.spawn(function()
		while true do
			task.wait(Config.Data.AutosaveInterval)
			for _, profile in profiles do
				-- Always save: this also refreshes the session lock.
				task.spawn(saveProfile, profile, false)
			end
		end
	end)

	Net.Function("FetchProfile").OnServerInvoke = function(player: Player)
		if not fetchLimiter:Allow(player) then
			return nil
		end
		local profile = DataService.WaitFor(player, 20)
		if not profile then
			return nil
		end
		local data = profile.Data
		return {
			settings = deepCopy(data.settings),
			signalMarks = data.signalMarks,
			progress = { chapter = data.progress.chapter, completed = deepCopy(data.progress.completed) },
			inventory = deepCopy(data.inventory),
			equipped = deepCopy(data.equipped),
			persistent = profile.Persistent,
			isNew = data.stats.sessions <= 1,
		}
	end
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">DoorService</string>
            <string name="Source"><![CDATA[-- DoorService: sliding doors (tag FZ_Door). Opening makes noise; locked doors buzz.
-- The creature opens unlocked doors in its way (CreatureService calls Open).

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local InteractionService = require(script.Parent.InteractionService)
local NoiseService = require(script.Parent.NoiseService)

local DoorService = {}

local TWEEN = TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
local busy: { [Instance]: boolean } = {}

local function setOpen(panel: BasePart, open: boolean)
	if busy[panel] or panel:GetAttribute("Open") == open then
		return
	end
	busy[panel] = true
	panel:SetAttribute("Open", open)
	local target = panel:GetAttribute(if open then "OpenCFrame" else "ClosedCFrame")
	Net.Event("Sfx"):FireAllClients("door_open", panel.Position)
	NoiseService.Emit(panel.Position, Config.Noise.Door, nil)
	local tween = TweenService:Create(panel, TWEEN, { CFrame = target })
	tween.Completed:Once(function()
		busy[panel] = nil
	end)
	tween:Play()
end

function DoorService.Open(panel: BasePart)
	if not panel:GetAttribute("Locked") then
		setOpen(panel, true)
	end
end

function DoorService.SetLocked(panel: BasePart, locked: boolean)
	panel:SetAttribute("Locked", locked)
	local stripe = panel:FindFirstChild("Stripe")
	if stripe and stripe:IsA("BasePart") then
		stripe.Color = if locked then Color3.fromRGB(200, 40, 30) else Color3.fromRGB(90, 220, 140)
	end
	local modifier = panel:FindFirstChildOfClass("PathfindingModifier")
	if modifier then
		modifier.PassThrough = not locked
	end
	if locked and panel:GetAttribute("Open") then
		setOpen(panel, false)
	end
end

function DoorService.CloseAll()
	for _, panel in CollectionService:GetTagged("FZ_Door") do
		if panel:IsA("BasePart") then
			setOpen(panel, false)
		end
	end
end

function DoorService.Start()
	InteractionService.Register("door", function(player, panel)
		if not panel:IsA("BasePart") then
			return
		end
		if panel:GetAttribute("Locked") then
			Net.Event("Sfx"):FireAllClients("door_locked", panel.Position)
			Net.Event("Notify"):FireClient(player, "DOOR_LOCKED")
			return
		end
		setOpen(panel, not panel:GetAttribute("Open"))
	end)
end

return DoorService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">FlashlightService</string>
            <string name="Source"><![CDATA[-- FlashlightService: replicated flashlight so teammates see each other's light.
-- The owning client additionally renders a camera-aligned local light for precision
-- and mutes its own replicated copy (see FlashlightController).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local FlashlightService = {}

local function attach(character: Model)
	local head = character:WaitForChild("Head", 10)
	if not head or not head:IsA("BasePart") or head:FindFirstChild("FZ_Flashlight") then
		return
	end
	local light = Instance.new("SpotLight")
	light.Name = "FZ_Flashlight"
	light.Face = Enum.NormalId.Front
	light.Angle = 55
	light.Range = 38
	light.Brightness = 2.2
	light.Color = Color3.fromRGB(255, 236, 206)
	light.Shadows = true
	light.Enabled = false
	light.Parent = head
end

function FlashlightService.Start()
	local limiter = RateLimiter.new(6, 3)
	Net.Event("SetFlashlight").OnServerEvent:Connect(function(player: Player, enabled: any)
		if type(enabled) ~= "boolean" or not limiter:Allow(player) then
			return
		end
		local head = player.Character and player.Character:FindFirstChild("Head")
		local light = head and head:FindFirstChild("FZ_Flashlight")
		if light and light:IsA("SpotLight") then
			light.Enabled = enabled
		end
	end)

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(attach)
		if player.Character then
			task.spawn(attach, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
end

return FlashlightService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">GameFlowService</string>
            <string name="Source"><![CDATA[-- GameFlowService: session flow (menu -> in game), checkpoints and chapter hooks.
--
-- Party model: one Roblox server = one team (max 4, set "Max Players" to 4 in Game
-- Settings). Story progress is shared per server through SessionState. Nobody waits for
-- anyone: a player who presses Play enters immediately; friends who join later are
-- placed at the team's current checkpoint.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local CHECKPOINT_TAG = "FZ_Checkpoint"

local GameFlowService = {}

local chapters = {
	[1] = require(script.Parent.Parent.Chapters.Chapter1),
}

local inGame: { [Player]: boolean } = {}
local entered: { [Player]: boolean } = {} -- entered at least once this session

local function findCheckpoint(id: string): BasePart?
	for _, part in CollectionService:GetTagged(CHECKPOINT_TAG) do
		if part:IsA("BasePart") and part:GetAttribute("CheckpointId") == id then
			return part
		end
	end
	return nil
end

local function placeAtCheckpoint(player: Player)
	local character = player.Character
	if not character or player:GetAttribute("FZ_MonsterMode") then
		return
	end
	local checkpoint = findCheckpoint(SessionState.Get("Checkpoint") or "C1_START")
	if not checkpoint then
		return -- fall back to the default SpawnLocation
	end
	-- Spread the team a little so nobody spawns inside a teammate.
	local index = table.find(Players:GetPlayers(), player) or 1
	local offset = Vector3.new(((index - 1) % 2) * 3 - 1.5, 3, math.floor((index - 1) / 2) * 3)
	local target = checkpoint.CFrame * CFrame.new(offset)
	pcall(function()
		player:RequestStreamAroundAsync(target.Position, 5)
	end)
	if player.Character == character then
		character:PivotTo(target)
	end
end

function GameFlowService.SetCheckpoint(id: string)
	SessionState.Set("Checkpoint", id)
end

function GameFlowService.PlaceAtCheckpoint(player: Player)
	placeAtCheckpoint(player)
end

function GameFlowService.ResetChapter()
	local chapter = chapters[SessionState.Get("Chapter") or 1]
	if chapter and chapter.Reset then
		chapter.Reset()
	end
end

function GameFlowService.Start()
	SessionState.Set("Chapter", 1)
	SessionState.Set("Checkpoint", "C1_START")

	local context = { setCheckpoint = GameFlowService.SetCheckpoint }
	for _, chapter in chapters do
		chapter.Start(context)
	end

	local limiter = RateLimiter.new(2, 0.5)
	Net.Event("ClientReady").OnServerEvent:Connect(function(player: Player)
		if not limiter:Allow(player) or inGame[player] then
			return
		end
		inGame[player] = true
		player:SetAttribute("FZ_InGame", true)
		placeAtCheckpoint(player)
		local firstTime = not entered[player]
		entered[player] = true
		local chapter = chapters[SessionState.Get("Chapter") or 1]
		if chapter and chapter.OnPlayerEntered then
			chapter.OnPlayerEntered(player, firstTime)
		end
	end)

	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function()
			if inGame[player] then
				task.defer(placeAtCheckpoint, player)
			end
		end)
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		inGame[player] = nil
		entered[player] = nil
	end)
end

return GameFlowService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">HealthService</string>
            <string name="Source"><![CDATA[-- HealthService: damage, downed state and revive. Nobody dies instantly:
--   damage -> downed (crawling) -> a teammate helps up (hold prompt)
--   solo, whole team down, or timeout -> back to the last checkpoint, nothing is lost.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local InteractionService = require(script.Parent.InteractionService)

local HealthService = {}

local HC = Config.Health
local lastDamage: { [Player]: number } = {}
local downedSince: { [Player]: number } = {}

local function humanoidOf(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function inGamePlayers(): { Player }
	local list = {}
	for _, player in Players:GetPlayers() do
		if player:GetAttribute("FZ_InGame") and not player:GetAttribute("FZ_MonsterMode") then
			table.insert(list, player)
		end
	end
	return list
end

function HealthService.IsDowned(player: Player): boolean
	return player:GetAttribute("FZ_Downed") == true
end

local function clearRevivePrompt(player: Player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		CollectionService:RemoveTag(root, "FZ_Interactable")
		local prompt = root:FindFirstChild("FZ_Prompt")
		if prompt then
			prompt:Destroy()
		end
	end
end

function HealthService.Respawn(player: Player)
	downedSince[player] = nil
	player:SetAttribute("FZ_Downed", false)
	clearRevivePrompt(player)
	player:LoadCharacter() -- GameFlowService places the new character at the checkpoint
end

local function checkTeamWipe()
	local players = inGamePlayers()
	if #players == 0 then
		return
	end
	for _, player in players do
		if not HealthService.IsDowned(player) then
			return
		end
	end
	task.delay(3, function()
		for _, player in inGamePlayers() do
			if HealthService.IsDowned(player) then
				Net.Event("Notify"):FireClient(player, "HUD_SIGNAL_LOST")
				HealthService.Respawn(player)
			end
		end
	end)
end

local function setDowned(player: Player, humanoid: Humanoid)
	humanoid.Health = 1
	player:SetAttribute("FZ_Downed", true)
	downedSince[player] = os.clock()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		root:SetAttribute("InteractId", "revive")
		root:SetAttribute("ActionKey", "INTERACT_REVIVE")
		root:SetAttribute("ObjectKey", "OBJECT_TEAMMATE")
		root:SetAttribute("HoldDuration", HC.ReviveHold)
		root:SetAttribute("MaxDistance", 7)
		CollectionService:AddTag(root, "FZ_Interactable")
	end
	checkTeamWipe()
end

function HealthService.Damage(player: Player, amount: number)
	local humanoid = humanoidOf(player)
	if not humanoid or HealthService.IsDowned(player) or player:GetAttribute("FZ_MonsterMode") then
		return
	end
	lastDamage[player] = os.clock()
	Net.Event("Hurt"):FireClient(player, amount)
	if humanoid.Health - amount <= 1 then
		setDowned(player, humanoid)
	else
		humanoid.Health -= amount
	end
end

function HealthService.Revive(target: Player, healthValue: number)
	local humanoid = humanoidOf(target)
	if not humanoid or not HealthService.IsDowned(target) then
		return
	end
	clearRevivePrompt(target)
	downedSince[target] = nil
	target:SetAttribute("FZ_Downed", false)
	humanoid.Health = math.clamp(healthValue, 1, humanoid.MaxHealth)
	lastDamage[target] = os.clock()
end

function HealthService.HealAll()
	for _, player in Players:GetPlayers() do
		local humanoid = humanoidOf(player)
		if humanoid then
			if HealthService.IsDowned(player) then
				HealthService.Revive(player, humanoid.MaxHealth)
			end
			humanoid.Health = humanoid.MaxHealth
		end
	end
end

function HealthService.Start()
	InteractionService.Register("revive", function(helper, root)
		local target = Players:GetPlayerFromCharacter(root.Parent)
		if not target or target == helper or HealthService.IsDowned(helper) then
			return
		end
		local reviveHealth = tonumber(helper:GetAttribute("FZ_ReviveHealth")) or HC.ReviveHealth
		HealthService.Revive(target, reviveHealth)
	end)

	local function onCharacter(player: Player, character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid or not humanoid:IsA("Humanoid") then
			return
		end
		humanoid.MaxHealth = HC.Max
		humanoid.Health = HC.Max
		humanoid.BreakJointsOnDeath = false
		player:SetAttribute("FZ_Downed", false)
		downedSince[player] = nil
		humanoid.Died:Connect(function()
			-- Safety net (falls, resets): never a game over, just back to the checkpoint.
			task.delay(2, function()
				if player.Parent and player.Character == character then
					HealthService.Respawn(player)
				end
			end)
		end)
	end
	local function onPlayer(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacter(player, character)
		end)
		if player.Character then
			task.spawn(onCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		lastDamage[player] = nil
		downedSince[player] = nil
		task.defer(checkTeamWipe)
	end)

	-- Regeneration and downed timeout (1 Hz is plenty)
	task.spawn(function()
		while true do
			task.wait(1)
			local now = os.clock()
			for _, player in Players:GetPlayers() do
				local humanoid = humanoidOf(player)
				if humanoid then
					local since = downedSince[player]
					if since and now - since > HC.DownedTimeout then
						Net.Event("Notify"):FireClient(player, "HUD_SIGNAL_LOST")
						HealthService.Respawn(player)
					elseif not since and humanoid.Health > 0 then
						local cap = tonumber(player:GetAttribute("FZ_RegenCap")) or HC.RegenCap
						if now - (lastDamage[player] or 0) > HC.RegenDelay and humanoid.Health < cap then
							humanoid.Health = math.min(cap, humanoid.Health + HC.RegenPerSecond)
						end
					end
				end
			end
		end
	end)
end

return HealthService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">InteractionService</string>
            <string name="Source"><![CDATA[-- InteractionService: one interaction system for every platform.
--
-- Level designers tag an object (BasePart, Model or Attachment) with "FZ_Interactable"
-- and set attributes:
--   InteractId   (string, required) handler id registered by a chapter module
--   ActionKey    (string) localization key for the verb, e.g. "INTERACT_READ"
--   ObjectKey    (string) localization key for the object, e.g. "OBJECT_FAX"
--   HoldDuration (number, optional) seconds to hold
--   MaxDistance  (number, optional) default 8 studs
--
-- A ProximityPrompt is generated automatically. ProximityPrompts give us keyboard (E),
-- gamepad (X / Square) and touch (tap) with the same logical action for free.
-- Text is localized per player on the client (prompts are tagged "FZ_Prompt").
-- The server validates distance and rate-limits every trigger.

local CollectionService = game:GetService("CollectionService")

local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local TAG = "FZ_Interactable"
local PROMPT_TAG = "FZ_Prompt"
local DISTANCE_TOLERANCE = 6

local InteractionService = {}

type Handler = (player: Player, instance: Instance, prompt: ProximityPrompt) -> ()
local handlers: { [string]: Handler } = {}
local limiter = RateLimiter.new(6, 3)

function InteractionService.Register(id: string, handler: Handler)
	assert(handlers[id] == nil, "[FZ-Interact] Duplicate handler id: " .. id)
	handlers[id] = handler
end

local function worldPosition(instance: Instance): Vector3?
	if instance:IsA("BasePart") then
		return instance.Position
	elseif instance:IsA("Model") then
		return instance:GetPivot().Position
	elseif instance:IsA("Attachment") then
		return instance.WorldPosition
	end
	return nil
end

local function onTriggered(player: Player, instance: Instance, prompt: ProximityPrompt)
	if not limiter:Allow(player) or not prompt.Enabled then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return
	end
	local position = worldPosition(instance)
	if not position or ((root :: BasePart).Position - position).Magnitude > prompt.MaxActivationDistance + DISTANCE_TOLERANCE then
		return
	end
	local id = instance:GetAttribute("InteractId")
	local handler = if type(id) == "string" then handlers[id] else nil
	if not handler then
		warn("[FZ-Interact] No handler for InteractId " .. tostring(id) .. " on " .. instance:GetFullName())
		return
	end
	local ok, err = pcall(handler, player, instance, prompt)
	if not ok then
		warn("[FZ-Interact] Handler " .. id .. " failed: " .. tostring(err))
	end
end

local function setup(instance: Instance)
	if not worldPosition(instance) then
		warn("[FZ-Interact] Unsupported interactable: " .. instance:GetFullName())
		return
	end
	local prompt = instance:FindFirstChild("FZ_Prompt")
	if not prompt then
		prompt = Instance.new("ProximityPrompt")
		prompt.Name = "FZ_Prompt"
		prompt.Parent = instance
	end
	local p = prompt :: ProximityPrompt
	p.ActionText = "" -- localized on each client
	p.ObjectText = ""
	p.KeyboardKeyCode = Enum.KeyCode.E
	p.GamepadKeyCode = Enum.KeyCode.ButtonX
	p.HoldDuration = tonumber(instance:GetAttribute("HoldDuration")) or 0
	p.MaxActivationDistance = tonumber(instance:GetAttribute("MaxDistance")) or 8
	p.RequiresLineOfSight = true
	p:SetAttribute("FZ_Action", instance:GetAttribute("ActionKey"))
	p:SetAttribute("FZ_Object", instance:GetAttribute("ObjectKey"))
	CollectionService:AddTag(p, PROMPT_TAG)
	p.Triggered:Connect(function(player)
		onTriggered(player, instance, p)
	end)
end

function InteractionService.Start()
	CollectionService:GetInstanceAddedSignal(TAG):Connect(setup)
	for _, instance in CollectionService:GetTagged(TAG) do
		setup(instance)
	end
end

return InteractionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">NoiseService</string>
            <string name="Source"><![CDATA[-- NoiseService: everything the creature can hear goes through here.
-- Footsteps are derived from server-side character velocity (no client trust needed):
-- standing still is silent, walking is quiet, sprinting is loud.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Signal = require(Shared.Signal)

local NoiseService = {}
NoiseService.Heard = Signal.new() -- (position: Vector3, radius: number, source: Player?)

function NoiseService.Emit(position: Vector3, radius: number, source: Player?)
	NoiseService.Heard:Fire(position, radius, source)
end

function NoiseService.Start()
	task.spawn(function()
		while true do
			task.wait(0.4)
			for _, player in Players:GetPlayers() do
				local character = player.Character
				local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
				local humanoid = character and character:FindFirstChildOfClass("Humanoid")
				if root and humanoid and humanoid.FloorMaterial ~= Enum.Material.Air and player:GetAttribute("FZ_InGame") and not player:GetAttribute("FZ_MonsterMode") then
					local velocity = root.AssemblyLinearVelocity
					local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
					if speed > Config.Movement.WalkSpeed + 2 then
						NoiseService.Emit(root.Position, Config.Noise.Sprint, player)
					elseif speed > 3 then
						NoiseService.Emit(root.Position, Config.Noise.Walk, player)
					end
				end
			end
		end
	end)
end

return NoiseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">PowerService</string>
            <string name="Source"><![CDATA[-- PowerService: sector power. Switches tagged lights (FZ_SectorLight) and unlocks/locks
-- doors whose PowerSector attribute matches. State is replicated as "Power_<sector>".

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local SessionState = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("SessionState"))

local PowerService = {}

local DEFAULT = { A = true, B = false, C = true, D = true, E = true, CONTROL = true, CORE = false, HALL = true }
local powered: { [string]: boolean } = {}
local OFF_COLOR = Color3.fromRGB(40, 40, 38)

local doorService = nil -- injected to avoid a require cycle

local function applyLight(fixture: Instance)
	local sector = fixture:GetAttribute("Sector")
	if type(sector) ~= "string" or not fixture:IsA("BasePart") then
		return
	end
	local on = powered[sector] ~= false
	fixture:SetAttribute("Powered", on)
	local onColor = fixture:GetAttribute("OnColor")
	fixture.Color = if on then (if typeof(onColor) == "Color3" then onColor else fixture.Color) else OFF_COLOR
	for _, child in fixture:GetChildren() do
		if child:IsA("Light") then
			child.Enabled = on
			if typeof(onColor) == "Color3" then
				child.Color = onColor
			end
		end
	end
end

function PowerService.IsOn(sector: string): boolean
	return powered[sector] ~= false
end

function PowerService.Set(sector: string, on: boolean)
	powered[sector] = on
	SessionState.Set("Power_" .. sector, on)
	for _, fixture in CollectionService:GetTagged("FZ_SectorLight") do
		if fixture:GetAttribute("Sector") == sector then
			applyLight(fixture)
		end
	end
	if doorService then
		for _, panel in CollectionService:GetTagged("FZ_Door") do
			if panel:GetAttribute("PowerSector") == sector then
				doorService.SetLocked(panel, not on)
			end
		end
	end
end

function PowerService.Reset()
	for sector, on in DEFAULT do
		PowerService.Set(sector, on)
	end
end

function PowerService.Start(injectedDoorService)
	doorService = injectedDoorService
	CollectionService:GetInstanceAddedSignal("FZ_SectorLight"):Connect(applyLight)
	PowerService.Reset()
end

return PowerService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">SettingsService</string>
            <string name="Source"><![CDATA[-- SettingsService: persists player settings (language, subtitles, accessibility, graphics).
-- Settings are not security relevant, but are still validated against the shared schema
-- so a manipulated client can never write garbage into the save.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local SettingsService = {}

function SettingsService.Start()
	local limiter = RateLimiter.new(20, 5)
	Net.Event("UpdateSetting").OnServerEvent:Connect(function(player: Player, key: any, value: any)
		if not limiter:Allow(player) then
			return
		end
		local ok, sanitized = Config.ValidateSetting(key, value)
		if not ok then
			return
		end
		DataService.Mutate(player, function(data)
			data.settings[key] = sanitized
		end)
	end)
end

return SettingsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[-- ShopService: unlock and equip items with earned Signal Marks (server-authoritative).
-- Effects are published as player attributes so client visuals and server rules read
-- the same values. Robux: only the cosmetic supporter game pass (Catalog.GamePasses).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local DataService = require(script.Parent.DataService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local ShopService = {}

function ShopService.Publish(player: Player)
	local profile = DataService.Get(player)
	if not profile then
		return
	end
	local data = profile.Data
	local effects = Catalog.Effects(data.inventory, data.equipped)
	player:SetAttribute("FZ_Set", data.equipped.set or "")
	player:SetAttribute("FZ_HoldMultiplier", effects.interactHoldMultiplier or 1)
	player:SetAttribute("FZ_NightVision", effects.nightVision == true)
	player:SetAttribute("FZ_Footprints", effects.footprints == true)
	player:SetAttribute("FZ_ReviveMultiplier", effects.reviveMultiplier or 1)
	player:SetAttribute("FZ_ReviveHealth", effects.reviveHealth or Config.Health.ReviveHealth)
	player:SetAttribute("FZ_RegenCap", effects.regenCap or Config.Health.RegenCap)
	player:SetAttribute("FZ_ScareDampening", effects.scareDampening == true)
	player:SetAttribute("FZ_FlashRange", effects.flashlightRange or 1)
	player:SetAttribute("FZ_BlindCooldownScale", effects.blindCooldown or 1)
	local skin = data.equipped.radioSkin and Catalog.Items[data.equipped.radioSkin]
	player:SetAttribute("FZ_RadioColor", if skin then skin.color else Catalog.DefaultRadioColor)
end

local function snapshot(player: Player)
	local profile = DataService.Get(player)
	if not profile then
		return { ok = false }
	end
	return {
		ok = true,
		inventory = table.clone(profile.Data.inventory),
		equipped = table.clone(profile.Data.equipped),
		balance = profile.Data.signalMarks,
	}
end

local function buy(player: Player, itemId: string)
	local item = Catalog.Items[itemId]
	local profile = DataService.Get(player)
	if not item or not profile then
		return { ok = false, reason = "error" }
	end
	if not profile.Persistent then
		return { ok = false, reason = "error" } -- never sell into a save that cannot be stored
	end
	if profile.Data.inventory[itemId] then
		return { ok = false, reason = "owned" }
	end
	if profile.Data.signalMarks < item.price then
		return { ok = false, reason = "funds" }
	end
	DataService.Mutate(player, function(data)
		data.signalMarks -= item.price
		data.inventory[itemId] = true
	end)
	DataService.SaveNow(player)
	return { ok = true }
end

local function equip(player: Player, itemId: string, on: boolean)
	local item = Catalog.Items[itemId]
	local profile = DataService.Get(player)
	if not item or not profile or not profile.Data.inventory[itemId] then
		return { ok = false, reason = "error" }
	end
	DataService.Mutate(player, function(data)
		if item.kind == "set" then
			data.equipped.set = if on then itemId else nil
		elseif item.kind == "radioSkin" then
			data.equipped.radioSkin = if on then itemId else nil
		end
	end)
	return { ok = true }
end

local function grantGamePass(player: Player, passKey: string)
	local pass = Catalog.GamePasses[passKey]
	if pass and pass.grantsRadioSkin then
		DataService.Mutate(player, function(data)
			data.inventory[pass.grantsRadioSkin] = true
		end)
	end
end

function ShopService.Start()
	local limiter = RateLimiter.new(8, 2)
	Net.Function("ShopAction").OnServerInvoke = function(player: Player, action: any, itemId: any)
		if not limiter:Allow(player) or type(action) ~= "string" then
			return { ok = false, reason = "error" }
		end
		local result
		if action == "get" then
			return snapshot(player)
		elseif type(itemId) ~= "string" then
			return { ok = false, reason = "error" }
		elseif action == "buy" then
			result = buy(player, itemId)
		elseif action == "equip" then
			result = equip(player, itemId, true)
		elseif action == "unequip" then
			result = equip(player, itemId, false)
		else
			return { ok = false, reason = "error" }
		end
		ShopService.Publish(player)
		local snap = snapshot(player)
		snap.ok = result.ok
		snap.reason = result.reason
		return snap
	end

	DataService.ProfileLoaded:Connect(function(player)
		for key, pass in Catalog.GamePasses do
			if pass.id > 0 then
				local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.id)
				if ok and owns then
					grantGamePass(player, key)
				end
			end
		end
		ShopService.Publish(player)
	end)

	for _, player in Players:GetPlayers() do
		if DataService.Get(player) then
			ShopService.Publish(player)
		end
	end

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		for key, pass in Catalog.GamePasses do
			if pass.id == passId then
				grantGamePass(player, key)
				ShopService.Publish(player)
			end
		end
	end)
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">StoryService</string>
            <string name="Source"><![CDATA[-- StoryService: sends story content (subtitles, documents, objectives) to clients.
-- Only localization KEYS travel over the network; every client renders them in its own
-- language. Targets can be a single player (individual perception) or "all".

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local StoryService = {}

export type Line = {
	text: string, -- localization key
	speaker: string?, -- localization key
	params: { [string]: any }?,
	duration: number?,
	channel: string?, -- "radio" | "world" | "sfx"
	critical: boolean?, -- shown even with subtitles off (safety-relevant sounds)
	delay: number?, -- seconds to wait before this line (Sequence only)
}

type Target = Player | "all"

local subtitleRemote = Net.Event("Subtitle")
local documentRemote = Net.Event("Document")
local flags: { [string]: any } = {}

function StoryService.Say(target: Target, line: Line)
	if target == "all" then
		subtitleRemote:FireAllClients(line)
	else
		subtitleRemote:FireClient(target :: Player, line)
	end
end

function StoryService.Sequence(target: Target, lines: { Line })
	task.spawn(function()
		for _, line in lines do
			if line.delay then
				task.wait(line.delay)
			end
			if target ~= "all" and (target :: Player).Parent == nil then
				return
			end
			StoryService.Say(target, line)
		end
	end)
end

function StoryService.ShowDocument(player: Player, document: { [string]: any })
	documentRemote:FireClient(player, document)
end

-- params are replicated as JSON (e.g. { count = 1, total = 3 } for "Find fuses (1/3)").
function StoryService.SetObjective(key: string?, params: { [string]: any }?)
	SessionState.Set("ObjectiveParams", if params then HttpService:JSONEncode(params) else nil)
	SessionState.Set("Objective", key)
end

function StoryService.GetObjective(): string?
	return SessionState.Get("Objective")
end

-- Session flags are shared by the whole team and replicated as "Flag_<name>".
function StoryService.SetFlag(name: string, value: any)
	flags[name] = value
	SessionState.Set("Flag_" .. name, value)
end

function StoryService.GetFlag(name: string): any
	return flags[name]
end

function StoryService.ResetFlags()
	for name in flags do
		SessionState.Set("Flag_" .. name, nil)
	end
	table.clear(flags)
end

return StoryService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">VoiceService</string>
            <string name="Source"><![CDATA[-- VoiceService: proximity voice + walkie-talkie radio on top of the Roblox Audio API.
--
-- Per player (server):  AudioDeviceInput (microphone)
--   -> AudioFader "FZ_VoiceFader" (clients use it to mute someone locally)
--   -> AudioEmitter "FZ_VoiceEmitter" in the head (spatial: quieter with distance)
-- The radio is mixed on every client (VoiceController): while a player transmits, each
-- listener wires that player's microphone through a radio filter whose volume and static
-- depend on the distance between them.
--
-- Requirements (Studio, not scriptable): VoiceChatService.UseAudioApi = Enabled and
-- VoiceChatService.EnableDefaultVoice = false (both set in default.project.json).
-- Players without Roblox voice chat simply have no microphone; everything else works.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Net = require(Shared.Net)

local NoiseService = require(script.Parent.NoiseService)
local RateLimiter = require(script.Parent.Parent.Util.RateLimiter)

local VoiceService = {}

local transmitting: { [Player]: boolean } = {}

local function wire(source: Instance, target: Instance, parent: Instance)
	local w = Instance.new("Wire")
	w.SourceInstance = source
	w.TargetInstance = target
	w.Parent = parent
	return w
end

local function getInput(player: Player): Instance?
	local existing = player:FindFirstChildOfClass("AudioDeviceInput")
	if existing then
		return existing
	end
	local ok, input = pcall(function()
		local created = Instance.new("AudioDeviceInput")
		created.Name = "FZ_Microphone"
		;(created :: any).Player = player
		created.Parent = player
		return created
	end)
	if not ok then
		warn("[FZ-Voice] Audio API unavailable: " .. tostring(input))
		return nil
	end
	return input
end

local function setupCharacter(player: Player, character: Model)
	local input = getInput(player)
	local head = character:WaitForChild("Head", 10)
	if not input or not head then
		return
	end
	pcall(function()
		local fader = Instance.new("AudioFader")
		fader.Name = "FZ_VoiceFader"
		fader.Parent = head
		local emitter = Instance.new("AudioEmitter")
		emitter.Name = "FZ_VoiceEmitter"
		emitter.Parent = head
		;(emitter :: any):SetDistanceAttenuation({
			[0] = 1,
			[Config.Voice.ProximityFull] = 1,
			[Config.Voice.ProximityFull * 3] = 0.35,
			[Config.Voice.ProximityMax] = 0,
		})
		wire(input, fader, fader)
		wire(fader, emitter, emitter)
	end)
end

local function setTransmitting(player: Player, value: boolean)
	transmitting[player] = value or nil
	player:SetAttribute("FZ_RadioTx", value)
end

function VoiceService.Start()
	local radioLimiter = RateLimiter.new(8, 4)
	local muteLimiter = RateLimiter.new(6, 2)

	Net.Event("RadioState").OnServerEvent:Connect(function(player: Player, value: any)
		if type(value) ~= "boolean" or not radioLimiter:Allow(player) then
			return
		end
		if value and not player:GetAttribute("FZ_InGame") then
			return
		end
		setTransmitting(player, value)
	end)

	Net.Event("MicMute").OnServerEvent:Connect(function(player: Player, muted: any)
		if type(muted) ~= "boolean" or not muteLimiter:Allow(player) then
			return
		end
		local input = getInput(player)
		if input then
			pcall(function()
				(input :: any).Muted = muted
			end)
		end
		player:SetAttribute("FZ_MicMuted", muted)
	end)

	local function onPlayer(player: Player)
		player:SetAttribute("FZ_MicMuted", false)
		player:SetAttribute("FZ_RadioTx", false)
		player.CharacterAdded:Connect(function(character)
			setupCharacter(player, character)
		end)
		if player.Character then
			task.spawn(setupCharacter, player, player.Character)
		end
	end
	Players.PlayerAdded:Connect(onPlayer)
	for _, player in Players:GetPlayers() do
		onPlayer(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		transmitting[player] = nil
	end)

	-- A live radio is audible to the creature at the sender's position.
	task.spawn(function()
		while true do
			task.wait(1)
			for player in transmitting do
				local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
				if root then
					NoiseService.Emit((root :: BasePart).Position, Config.Noise.Radio, player)
				end
			end
		end
	end)
end

return VoiceService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="44">
        <Properties>
          <string name="Name">Util</string>
        </Properties>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">RateLimiter</string>
            <string name="Source"><![CDATA[-- Token-bucket rate limiter per player. Every client->server remote uses one.

local Players = game:GetService("Players")

local RateLimiter = {}
RateLimiter.__index = RateLimiter

local limiters = {}

Players.PlayerRemoving:Connect(function(player)
	for _, limiter in limiters do
		limiter._buckets[player] = nil
	end
end)

-- capacity: burst size, refillPerSecond: sustained rate
function RateLimiter.new(capacity: number, refillPerSecond: number)
	local self = setmetatable({
		_capacity = capacity,
		_refill = refillPerSecond,
		_buckets = {},
	}, RateLimiter)
	table.insert(limiters, self)
	return self
end

function RateLimiter:Allow(player: Player, cost: number?): boolean
	local price = cost or 1
	local now = os.clock()
	local bucket = self._buckets[player]
	if not bucket then
		bucket = { tokens = self._capacity, time = now }
		self._buckets[player] = bucket
	end
	bucket.tokens = math.min(self._capacity, bucket.tokens + (now - bucket.time) * self._refill)
	bucket.time = now
	if bucket.tokens < price then
		return false
	end
	bucket.tokens -= price
	return true
end

return RateLimiter
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="46">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="Folder" referent="47">
      <Properties>
        <string name="Name">Secrets</string>
      </Properties>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">Codes</string>
          <string name="Source"><![CDATA[-- Redeemable codes. Lives in ServerStorage: never replicated to clients.
-- Key = exactly what the player types (normalized: uppercase, no whitespace).
-- id   = stable save id. Never reuse or rename an id, or players could redeem twice.
-- Each code must be physically findable in the world (see docs/GAME_DESIGN.md, "Codes").

return {
	-- Lobby notice board, maintenance note (Chapter 1).
	["SIGNAL-017"] = { id = "signal_017", reward = { signalMarks = 25 }, active = true },
	-- Gatehouse logbook, last line (Chapter 1).
	["VESPER-0214"] = { id = "vesper_0214", reward = { signalMarks = 40 }, active = true },
}
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="49">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="CameraMode">1</token>
      <float name="CharacterWalkSpeed">10</float>
      <bool name="EnableMouseLockOption">false</bool>
    </Properties>
    <Item class="StarterCharacterScripts" referent="50">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Script" referent="51">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Intentionally empty. A Script named "Health" in StarterCharacterScripts replaces
-- Roblox's default health regeneration, so HealthService alone controls healing.
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="52">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="53">
        <Properties>
          <string name="Name">Client</string>
        </Properties>
        <Item class="Folder" referent="54">
          <Properties>
            <string name="Name">Controllers</string>
          </Properties>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">AudioController</string>
              <string name="Source"><![CDATA[-- AudioController: every non-voice sound on the client.
--   * Sound groups (Ambience / SFX / Creature / UI) for clean mixing and ducking
--   * Ambience: wind outside, electric hum inside the building, generators (3D)
--   * Footsteps for every nearby character, by floor material (local, no network)
--   * Server-triggered 3D effects via the "Sfx" remote
-- Sounds play only when their id is set in Shared/Assets.luau; otherwise silently skipped.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Assets = require(Shared.Assets)
local Net = require(Shared.Net)

local AudioController = {}

local groups: { [string]: SoundGroup } = {}
local BUILDING_MIN = Vector3.new(-100, -5, -85)
local BUILDING_MAX = Vector3.new(100, 20, 85)

local function group(name: string, volume: number): SoundGroup
	local g = Instance.new("SoundGroup")
	g.Name = "FZ_" .. name
	g.Volume = volume
	g.Parent = SoundService
	groups[name] = g
	return g
end

function AudioController.Id(name: string): string?
	local id = Assets.Sounds[name]
	if type(id) == "string" and id ~= "" then
		return id
	end
	return nil
end

-- Plays a one-shot. `at` may be a Vector3, a BasePart/Attachment, or nil (2D).
function AudioController.Play(name: string, at: any?, volume: number?, groupName: string?): Sound?
	local id = AudioController.Id(name)
	if not id then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.8
	sound.SoundGroup = groups[groupName or "SFX"]
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 8
	sound.RollOffMaxDistance = 120
	if typeof(at) == "Vector3" then
		local attachment = Instance.new("Attachment")
		attachment.WorldPosition = at
		attachment.Parent = workspace.Terrain
		sound.Parent = attachment
		sound.Ended:Once(function()
			attachment:Destroy()
		end)
	elseif typeof(at) == "Instance" and (at:IsA("BasePart") or at:IsA("Attachment")) then
		sound.Parent = at
		sound.Ended:Once(function()
			sound:Destroy()
		end)
	else
		sound.Parent = SoundService
		sound.Ended:Once(function()
			sound:Destroy()
		end)
	end
	sound:Play()
	return sound
end

function AudioController.Loop(name: string, parent: Instance, volume: number, groupName: string?): Sound?
	local id = AudioController.Id(name)
	if not id then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = "Loop_" .. name
	sound.SoundId = id
	sound.Looped = true
	sound.Volume = volume
	sound.SoundGroup = groups[groupName or "Ambience"]
	sound.RollOffMode = Enum.RollOffMode.InverseTapered
	sound.RollOffMinDistance = 6
	sound.RollOffMaxDistance = 70
	sound.Parent = parent
	sound:Play()
	return sound
end

-- Lowers ambience while important voices/radio play (simple ducking).
function AudioController.Duck(active: boolean)
	local target = if active then 0.45 else 1
	TweenService:Create(groups.Ambience, TweenInfo.new(0.4), { Volume = target }):Play()
end

local function insideBuilding(position: Vector3): boolean
	return position.X > BUILDING_MIN.X and position.X < BUILDING_MAX.X and position.Z > BUILDING_MIN.Z and position.Z < BUILDING_MAX.Z and position.Y < BUILDING_MAX.Y
end

local function materialSound(material: Enum.Material): string
	if material == Enum.Material.Metal or material == Enum.Material.DiamondPlate or material == Enum.Material.CorrodedMetal then
		return "footstep_metal_" .. math.random(1, 2)
	elseif material == Enum.Material.Grass or material == Enum.Material.Ground or material == Enum.Material.Mud or material == Enum.Material.LeafyGrass then
		return "footstep_grass_" .. math.random(1, 2)
	end
	return "footstep_concrete_" .. math.random(1, 3)
end

function AudioController.Init()
	group("Ambience", 1)
	group("SFX", 1)
	group("Creature", 1)
	group("UI", 0.7)

	-- Ambient beds (2D), crossfaded by position
	local wind = AudioController.Loop("ambience_wind_loop", SoundService, 0)
	local hum = AudioController.Loop("hum_electric_loop", SoundService, 0)
	if wind then
		wind.RollOffMaxDistance = 10000
	end

	for _, source in CollectionService:GetTagged("FZ_AmbientSource") do
		local loopName = source:GetAttribute("SoundLoop")
		if type(loopName) == "string" then
			AudioController.Loop(loopName, source, 0.6)
		end
	end
	CollectionService:GetInstanceAddedSignal("FZ_AmbientSource"):Connect(function(source)
		local loopName = source:GetAttribute("SoundLoop")
		if type(loopName) == "string" then
			AudioController.Loop(loopName, source, 0.6)
		end
	end)

	Net.Event("Sfx").OnClientEvent:Connect(function(name, at, volume)
		if type(name) ~= "string" then
			return
		end
		local groupName = if string.sub(name, 1, 8) == "creature" then "Creature" else "SFX"
		AudioController.Play(name, at, if type(volume) == "number" then volume else nil, groupName)
	end)

	-- Footsteps + ambience mix, 10 Hz is enough
	local stepTimers: { [Model]: number } = {}
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		for model, timer in stepTimers do
			stepTimers[model] = timer - dt
		end
		if accumulator < 0.1 then
			return
		end
		local elapsed = accumulator
		accumulator = 0
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local inside = insideBuilding(camera.CFrame.Position)
		if wind then
			wind.Volume += ((if inside then 0.12 else 0.55) - wind.Volume) * math.min(1, elapsed * 2)
		end
		if hum then
			hum.Volume += ((if inside then 0.35 else 0) - hum.Volume) * math.min(1, elapsed * 2)
		end
		for _, player in Players:GetPlayers() do
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if root and humanoid and not player:GetAttribute("FZ_MonsterMode") and (root.Position - camera.CFrame.Position).Magnitude < 60 then
				local velocity = root.AssemblyLinearVelocity
				local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
				if speed > 2 and humanoid.FloorMaterial ~= Enum.Material.Air then
					local remaining = stepTimers[character :: Model] or 0
					if remaining <= 0 then
						local interval = math.clamp(4.2 / speed, 0.26, 0.65)
						stepTimers[character :: Model] = interval
						AudioController.Play(materialSound(humanoid.FloorMaterial), root.Position - Vector3.new(0, 2.5, 0), if speed > 13 then 0.9 else 0.55)
					end
				end
			end
		end
		for model in stepTimers do
			if not model.Parent then
				stepTimers[model] = nil
			end
		end
	end)
end

function AudioController.UI(name: string)
	AudioController.Play(name, nil, 0.5, "UI")
end

return AudioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">CreatureVisualsController</string>
              <string name="Source"><![CDATA[-- CreatureVisualsController: everything the player SEES and HEARS of the creature.
--   * Procedural animation (Motor6D.Transform) for the built-in rig: long-limbed gait,
--     listening head tilt, telegraphed attack wind-up, covering its head when blinded
--   * "Signal dropouts": the pose freezes for a few frames now and then, with a crackle
--   * Breath loop on the head, random clicks, a close-range warning caption
--   * Vent travel: hidden locally while the server moves it
-- Rigs with Procedural = false (your own model with real animations) only get audio.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local AudioController = require(script.Parent.AudioController)

local CreatureVisualsController = {}

type RigState = {
	model: Model,
	motors: { [string]: Motor6D },
	phase: number,
	frozenUntil: number,
	nextFreeze: number,
	nextClick: number,
	breath: Sound?,
	lastHidden: boolean?,
}

local rigs: { [Model]: RigState } = {}
local showCaption: ((line: { [string]: any }) -> ())? = nil
local lastWarning = 0

local function angles(x: number, y: number, z: number): CFrame
	return CFrame.Angles(x, y, z)
end

local function register(model: Instance)
	if not model:IsA("Model") or rigs[model] then
		return
	end
	local motors = {}
	for _, descendant in model:GetDescendants() do
		if descendant:IsA("Motor6D") then
			motors[descendant.Name] = descendant
		end
	end
	local head = model:WaitForChild("Head", 5)
	local state: RigState = {
		model = model,
		motors = motors,
		phase = 0,
		frozenUntil = 0,
		nextFreeze = os.clock() + 2,
		nextClick = os.clock() + 3,
		breath = if head and head:IsA("BasePart") then AudioController.Loop("creature_breath", head, 0.45, "Creature") else nil,
		lastHidden = nil,
	}
	rigs[model] = state
	model.AncestryChanged:Connect(function()
		if not model:IsDescendantOf(workspace) then
			rigs[model] = nil
		end
	end)
end

local function setHidden(state: RigState, hidden: boolean)
	if state.lastHidden == hidden then
		return
	end
	state.lastHidden = hidden
	for _, descendant in state.model:GetDescendants() do
		if descendant:IsA("BasePart") then
			descendant.LocalTransparencyModifier = if hidden then 1 else 0
		end
	end
	if state.breath then
		state.breath.Volume = if hidden then 0 else 0.45
	end
end

local function animate(state: RigState, dt: number)
	local model = state.model
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	local m = state.motors
	local now = os.clock()
	local creatureState = model:GetAttribute("State") or "Patrol"
	setHidden(state, model:GetAttribute("Hidden") == true)

	-- Audio cues (distance-limited)
	local camera = workspace.CurrentCamera
	local distance = if camera then (root.Position - camera.CFrame.Position).Magnitude else math.huge
	if model == Players.LocalPlayer.Character then
		distance = math.huge -- you are the monster (admin test mode): no warnings for yourself
	end
	if now >= state.nextClick and creatureState ~= "Dormant" and distance < 60 and not state.lastHidden then
		state.nextClick = now + math.random(30, 70) / 10
		AudioController.Play("creature_click", root, 0.7, "Creature")
	end
	if distance < 16 and creatureState ~= "Dormant" and not state.lastHidden and now - lastWarning > 25 and showCaption then
		lastWarning = now
		showCaption({ text = "SFX_CREATURE_NEAR", channel = "world", duration = 2.5, critical = true })
	end

	if model:GetAttribute("Procedural") ~= true then
		return
	end

	-- Signal dropout: freeze the pose for a few frames
	if now >= state.nextFreeze then
		state.frozenUntil = now + math.random(6, 16) / 100
		state.nextFreeze = now + math.random(8, 26) / 10
		if distance < 35 and math.random() < 0.35 then
			AudioController.Play("creature_static_burst", root, 0.35, "Creature")
		end
	end
	if now < state.frozenUntil then
		return
	end

	local velocity = root.AssemblyLinearVelocity
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local stride = math.clamp(speed / 12, 0, 1.2)
	state.phase += dt * (2 + speed * 0.45)
	local p = state.phase
	local swing = math.sin(p) * 0.7 * stride
	local breathe = math.sin(now * 1.7) * 0.04

	local hunch, neckX, neckZ = -0.15, 0.25, 0
	local armL, armR, elbow = 0.25 - swing * 0.6, 0.25 + swing * 0.6, -0.35
	if creatureState == "Listen" then
		hunch, neckX, neckZ = 0.05, 0.1, math.sin(now * 0.8) * 0.15 + 0.55
		armL, armR = 0.05, 0.05
	elseif creatureState == "Attack" then
		hunch, neckX = -0.35, 0.45
		armL, armR, elbow = -2.3, -2.1, -0.6
	elseif creatureState == "Blinded" then
		hunch, neckX = 0.25, -0.4
		armL, armR, elbow = -2.6, -2.6, -2.0
	elseif creatureState == "Chase" then
		hunch, neckX = -0.45, 0.55
	end

	local function set(name: string, cf: CFrame)
		local motor = m[name]
		if motor then
			motor.Transform = cf
		end
	end
	set("RootJoint", angles(hunch + breathe, 0, math.sin(p) * 0.06 * stride))
	set("Neck", angles(neckX, math.sin(now * 0.37) * 0.15, neckZ))
	set("LeftShoulder", angles(armL, 0, -0.08))
	set("RightShoulder", angles(armR, 0, 0.08))
	set("LeftElbow", angles(elbow - math.max(0, swing) * 0.4, 0, 0))
	set("RightElbow", angles(elbow - math.max(0, -swing) * 0.4, 0, 0))
	set("LeftHip", angles(swing, 0, 0))
	set("RightHip", angles(-swing, 0, 0))
	set("LeftKnee", angles(-math.max(0, math.sin(p + 0.9)) * 1.1 * stride, 0, 0))
	set("RightKnee", angles(-math.max(0, math.sin(p + 0.9 + math.pi)) * 1.1 * stride, 0, 0))
end

function CreatureVisualsController.Init(captionCallback: (line: { [string]: any }) -> ())
	showCaption = captionCallback
	CollectionService:GetInstanceAddedSignal("FZ_CreatureRig"):Connect(register)
	for _, model in CollectionService:GetTagged("FZ_CreatureRig") do
		task.spawn(register, model)
	end
	CollectionService:GetInstanceRemovedSignal("FZ_CreatureRig"):Connect(function(model)
		rigs[model :: Model] = nil
	end)
	-- Stepped runs before physics/animation, the documented place for Motor6D.Transform.
	RunService.Stepped:Connect(function(_, dt)
		for _, state in rigs do
			animate(state, dt)
		end
	end)
end

return CreatureVisualsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">EquipmentController</string>
              <string name="Source"><![CDATA[-- EquipmentController: client side of shop equipment.
--   Observer set: night vision (N / D-pad up / touch "Night") with a 30 s battery that
--   recharges, and fresh creature tracks (sent by the server only to observers).

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local InputController = require(script.Parent.InputController)

local EquipmentController = {}

local player = Players.LocalPlayer
local BATTERY_SECONDS = 30
local battery = BATTERY_SECONDS
local active = false
local effect: ColorCorrectionEffect? = nil
local loop: RBXScriptConnection? = nil

local function setNightVision(on: boolean)
	if on and (not player:GetAttribute("FZ_NightVision") or battery < 2) then
		return
	end
	active = on
	InputController.SetTouchActive("NightVision", on)
	if not effect then
		local e = Instance.new("ColorCorrectionEffect")
		e.Name = "FZ_NightVision"
		e.Enabled = false
		e.Parent = Lighting
		effect = e
	end
	local e = effect :: ColorCorrectionEffect
	e.Enabled = true
	TweenService:Create(e, TweenInfo.new(0.25), {
		Brightness = if on then 0.32 else 0,
		Contrast = if on then 0.25 else 0,
		Saturation = if on then -0.9 else 0,
		TintColor = if on then Color3.fromRGB(150, 255, 170) else Color3.new(1, 1, 1),
	}):Play()
	if not loop then
		loop = RunService.Heartbeat:Connect(function(dt)
			if active then
				battery -= dt
				if battery <= 0 then
					battery = 0
					setNightVision(false)
				end
			else
				battery = math.min(BATTERY_SECONDS, battery + dt * 0.5)
				if battery >= BATTERY_SECONDS and loop then
					loop:Disconnect()
					loop = nil
				end
			end
		end)
	end
end

local function footprint(position: Vector3)
	if typeof(position) ~= "Vector3" then
		return
	end
	local mark = Instance.new("Part")
	mark.Name = "FZ_Track"
	mark.Anchored = true
	mark.CanCollide = false
	mark.CanQuery = false
	mark.CanTouch = false
	mark.CastShadow = false
	mark.Size = Vector3.new(1.2, 0.05, 2.2)
	mark.CFrame = CFrame.new(position) * CFrame.Angles(0, math.random() * math.pi, 0)
	mark.Material = Enum.Material.Neon
	mark.Color = Color3.fromRGB(150, 30, 26)
	mark.Transparency = 0.35
	mark.Parent = workspace.CurrentCamera
	local fade = TweenService:Create(mark, TweenInfo.new(18, Enum.EasingStyle.Linear), { Transparency = 1 })
	fade.Completed:Once(function()
		mark:Destroy()
	end)
	fade:Play()
end

function EquipmentController.SetActive(gameplay: boolean)
	if not gameplay and active then
		setNightVision(false)
	end
end

function EquipmentController.Init()
	local function refresh()
		local owned = player:GetAttribute("FZ_NightVision") == true
		InputController.SetTouchVisible("NightVision", owned)
		if not owned and active then
			setNightVision(false)
		end
	end
	player:GetAttributeChangedSignal("FZ_NightVision"):Connect(refresh)
	refresh()
	InputController.Action:Connect(function(name, pressed)
		if name == "NightVision" and pressed then
			setNightVision(not active)
		end
	end)
	Net.Event("Footprint").OnClientEvent:Connect(footprint)
end

return EquipmentController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">FlashlightController</string>
              <string name="Source"><![CDATA[-- FlashlightController: precise camera-aligned light for the local player, plus the
-- replicated head light (FlashlightService) so teammates see it too. The local player's
-- own replicated copy is muted locally to avoid a double light.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Net = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Net"))

local InputController = require(script.Parent.InputController)

local FlashlightController = {}

local player = Players.LocalPlayer
local enabled = false
local lightPart: Part? = nil
local follow: RBXScriptConnection? = nil
local setRemote = Net.Event("SetFlashlight")

local OFFSET = CFrame.new(0.6, -0.5, -0.4)
local BLIND_RANGE = 26 -- matches Config.Creature.BlindRange; the server re-validates
local nextBlindCheck = 0
local blindRay = RaycastParams.new()
blindRay.FilterType = Enum.RaycastFilterType.Exclude

-- While the light is on, report when the beam hits a creature's head (4 Hz).
local function checkBlind(camera: Camera)
	local now = os.clock()
	if now < nextBlindCheck then
		return
	end
	nextBlindCheck = now + 0.25
	local range = BLIND_RANGE * (tonumber(player:GetAttribute("FZ_FlashRange")) or 1)
	for _, model in CollectionService:GetTagged("FZ_CreatureRig") do
		local head = model:FindFirstChild("Head")
		if head and head:IsA("BasePart") and model ~= player.Character and not model:GetAttribute("Hidden") then
			local offset = head.Position - camera.CFrame.Position
			if offset.Magnitude < range and camera.CFrame.LookVector:Dot(offset.Unit) > math.cos(math.rad(14)) then
				blindRay.FilterDescendantsInstances = { player.Character :: Instance, camera }
				local hit = workspace:Raycast(camera.CFrame.Position, offset, blindRay)
				if hit and hit.Instance:IsDescendantOf(model) then
					Net.Event("FlashCreature"):FireServer()
				end
			end
		end
	end
end

local function ensurePart(): Part
	if lightPart and lightPart.Parent then
		return lightPart
	end
	local part = Instance.new("Part")
	part.Name = "FZ_LocalFlashlight"
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.Transparency = 1
	part.Size = Vector3.new(0.2, 0.2, 0.2)
	local light = Instance.new("SpotLight")
	light.Name = "Light"
	light.Face = Enum.NormalId.Front
	light.Angle = 50
	light.Range = 40
	light.Brightness = 2.4
	light.Color = Color3.fromRGB(255, 236, 206)
	light.Shadows = true
	light.Parent = part
	part.Parent = workspace.CurrentCamera
	lightPart = part
	return part
end

local function muteOwnReplicatedLight(character: Model)
	local head = character:WaitForChild("Head", 10)
	if not head then
		return
	end
	local function mute(child: Instance)
		if child.Name == "FZ_Flashlight" and child:IsA("SpotLight") then
			child.Brightness = 0 -- local only; the server never changes Brightness
		end
	end
	for _, child in head:GetChildren() do
		mute(child)
	end
	head.ChildAdded:Connect(mute)
end

function FlashlightController.Set(value: boolean)
	enabled = value
	local part = ensurePart()
	local light = part:FindFirstChild("Light") :: SpotLight
	light.Enabled = value
	light.Range = 40 * (tonumber(player:GetAttribute("FZ_FlashRange")) or 1)
	if value and not follow then
		follow = RunService.RenderStepped:Connect(function()
			local camera = workspace.CurrentCamera
			if camera then
				part.CFrame = camera.CFrame * OFFSET
				checkBlind(camera)
			end
		end)
	elseif not value and follow then
		follow:Disconnect()
		follow = nil
	end
	InputController.SetTouchActive("Flashlight", value)
	setRemote:FireServer(value)
end

function FlashlightController.IsOn(): boolean
	return enabled
end

function FlashlightController.Init()
	InputController.Action:Connect(function(name, pressed)
		if name == "Flashlight" and pressed then
			if player:GetAttribute("FZ_MonsterMode") then
				Net.Event("MonsterAttack"):FireServer() -- admin test: F / RB attacks as the creature
				return
			end
			FlashlightController.Set(not enabled)
		end
	end)
	player.CharacterAdded:Connect(function(character)
		muteOwnReplicatedLight(character)
		if enabled then
			setRemote:FireServer(true) -- new character, re-sync state
		end
	end)
	if player.Character then
		task.spawn(muteOwnReplicatedLight, player.Character)
	end
end

return FlashlightController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">GraphicsController</string>
              <string name="Source"><![CDATA[-- GraphicsController: quality profiles for the parts an experience may control itself.
-- Roblox's own graphics quality slider is respected and never overridden.
--
-- Invariants on EVERY profile (fairness + atmosphere):
--   * Atmosphere/fog is identical, so creatures are never easier/harder to see.
--   * Lights tagged "FZ_KeyLight" (gameplay-relevant lighting) are always on.
--   * Only decoration scales: post effects, lights tagged "FZ_DecorLight",
--     and the particle multiplier other systems read via GetParticleScale().

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local UserInputService = game:GetService("UserInputService")

local GraphicsController = {}

local PROFILES = {
	low = { bloom = false, decorLights = false, particles = 0.35, grade = 0.8 },
	medium = { bloom = true, decorLights = false, particles = 0.65, grade = 1 },
	high = { bloom = true, decorLights = true, particles = 1, grade = 1 },
	ultra = { bloom = true, decorLights = true, particles = 1.4, grade = 1 },
}

local current = "high"
local resolvedProfile = PROFILES.high
local brightness = 5
local grade: ColorCorrectionEffect? = nil
local bloom: BloomEffect? = nil
local decorConnection: RBXScriptConnection? = nil

local function ensureEffects()
	-- Created on the client: these effects exist only for this player.
	if not grade then
		local effect = Instance.new("ColorCorrectionEffect")
		effect.Name = "FZ_Grade"
		effect.Parent = Lighting
		grade = effect
	end
	if not bloom then
		local effect = Instance.new("BloomEffect")
		effect.Name = "FZ_Bloom"
		effect.Intensity = 0.35
		effect.Size = 22
		effect.Threshold = 1.6
		effect.Parent = Lighting
		bloom = effect
	end
end

local function resolve(name: string): string
	if name ~= "auto" then
		return name
	end
	-- Conservative default: phones/tablets start at medium, everything else at high.
	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
		return "medium"
	end
	return "high"
end

local watched: { [Instance]: boolean } = {}

local function applyDecor(fixture: Instance)
	-- A fixture without power stays off no matter which profile is selected.
	local on = resolvedProfile.decorLights and fixture:GetAttribute("Powered") ~= false
	for _, descendant in fixture:GetDescendants() do
		if descendant:IsA("Light") then
			descendant.Enabled = on
		end
	end
	if not watched[fixture] then
		watched[fixture] = true
		fixture:GetAttributeChangedSignal("Powered"):Connect(function()
			applyDecor(fixture)
		end)
		fixture.Destroying:Connect(function()
			watched[fixture] = nil
		end)
	end
end

local function apply()
	ensureEffects()
	resolvedProfile = PROFILES[resolve(current)] or PROFILES.high
	local g = grade :: ColorCorrectionEffect
	-- Base grade: slightly desaturated, cool shadows. Brightness setting 0..10 (5 = neutral).
	g.Saturation = -0.18 * resolvedProfile.grade
	g.Contrast = 0.08 * resolvedProfile.grade
	g.TintColor = Color3.fromRGB(236, 242, 244)
	g.Brightness = (brightness - 5) * 0.025
	;(bloom :: BloomEffect).Enabled = resolvedProfile.bloom
	for _, light in CollectionService:GetTagged("FZ_DecorLight") do
		applyDecor(light)
	end
	if not decorConnection then
		decorConnection = CollectionService:GetInstanceAddedSignal("FZ_DecorLight"):Connect(applyDecor)
	end
end

function GraphicsController.Init(settings)
	current = settings.Get("graphics") or "auto"
	brightness = settings.Get("brightness") or 5
	apply()
	settings.Changed:Connect(function(key, value)
		if key == "graphics" then
			current = value
			apply()
		elseif key == "brightness" then
			brightness = value
			apply()
		end
	end)
end

function GraphicsController.GetParticleScale(): number
	return resolvedProfile.particles
end

function GraphicsController.GetProfileName(): string
	return resolve(current)
end

function GraphicsController.GetRobloxQualityLevel(): number
	local ok, level = pcall(function()
		return UserSettings().GameSettings.SavedQualityLevel.Value
	end)
	return if ok then level else -1
end

return GraphicsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">HealthController</string>
              <string name="Source"><![CDATA[-- HealthController: health HUD (only visible when hurt), damage vignette, downed overlay.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Net = require(Shared.Net)

local Components = require(script.Parent.Parent.UI.Components)
local Theme = require(script.Parent.Parent.UI.Theme)

local HealthController = {}

local player = Players.LocalPlayer

function HealthController.Init(hudGui: ScreenGui, settings)
	-- Damage flash: a red screen edge (UIStroke), no texture asset required.
	local edge = Instance.new("Frame")
	edge.Name = "DamageEdge"
	edge.BackgroundTransparency = 1
	edge.Size = UDim2.fromScale(1, 1)
	edge.Parent = hudGui
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Colors.Accent
	stroke.Thickness = 28
	stroke.Transparency = 1
	stroke.Parent = edge
	local gradient = Instance.new("UIGradient")
	gradient.Transparency = NumberSequence.new(0.2)
	gradient.Parent = stroke

	local bar = Instance.new("Frame")
	bar.Name = "Health"
	bar.AnchorPoint = Vector2.new(0, 1)
	bar.Position = UDim2.new(0, 24, 1, -16)
	bar.Size = UDim2.fromOffset(180, 4)
	bar.BackgroundColor3 = Theme.Colors.TextFaint
	bar.BackgroundTransparency = 0.4
	bar.BorderSizePixel = 0
	bar.Visible = false
	bar.Parent = hudGui
	local fill = Instance.new("Frame")
	fill.BorderSizePixel = 0
	fill.BackgroundColor3 = Theme.Colors.TextBright
	fill.Size = UDim2.fromScale(1, 1)
	fill.Parent = bar

	local downed = Components.Text({ Key = "HUD_DOWNED", Font = Theme.Fonts.Medium, TextSize = Theme.Sizes.TextHeading, Color = Theme.Colors.TextBright, XAlign = Enum.TextXAlignment.Center, Size = UDim2.new(0.8, 0, 0, 40), Position = UDim2.fromScale(0.5, 0.42), AnchorPoint = Vector2.new(0.5, 0.5), Parent = hudGui })
	downed.TextStrokeTransparency = 0.4
	downed.Visible = false

	local function cameraScale(): number
		local value = settings.Get("cameraEffects")
		return if value == "off" then 0 elseif value == "reduced" then 0.5 else 1
	end

	local function bindHumanoid(character: Model)
		local humanoid = character:WaitForChild("Humanoid", 10)
		if not humanoid or not humanoid:IsA("Humanoid") then
			return
		end
		local function update()
			local ratio = math.clamp(humanoid.Health / math.max(1, humanoid.MaxHealth), 0, 1)
			bar.Visible = ratio < 0.999 and player:GetAttribute("FZ_InGame") == true and not player:GetAttribute("FZ_MonsterMode")
			fill.Size = UDim2.fromScale(ratio, 1)
			fill.BackgroundColor3 = if ratio < 0.35 then Theme.Colors.Accent else Theme.Colors.TextBright
		end
		humanoid.HealthChanged:Connect(update)
		update()
	end
	player.CharacterAdded:Connect(bindHumanoid)
	if player.Character then
		task.spawn(bindHumanoid, player.Character)
	end

	Net.Event("Hurt").OnClientEvent:Connect(function()
		stroke.Transparency = 0.15
		TweenService:Create(stroke, TweenInfo.new(1.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 1 }):Play()
		local camera = workspace.CurrentCamera
		local scale = cameraScale()
		if camera and scale > 0 then
			-- short, small kick (no strong shake)
			local original = camera.FieldOfView
			camera.FieldOfView = original - 3 * scale
			TweenService:Create(camera, TweenInfo.new(0.35), { FieldOfView = original }):Play()
		end
	end)

	player:GetAttributeChangedSignal("FZ_Downed"):Connect(function()
		downed.Visible = player:GetAttribute("FZ_Downed") == true
	end)
end

return HealthController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">InputController</string>
              <string name="Source"><![CDATA[-- InputController: one logical action layer for keyboard/mouse, gamepad and touch.
--
-- Primary path: Roblox Input Action System (InputContext / InputAction / InputBinding).
-- Fallback path: UserInputService, used automatically if the Input Action System cannot be
-- created on this client (or when Config FORCE_LEGACY is set for debugging).
--
-- Gameplay code only ever sees logical actions:
--   InputController.Action:Connect(function(name, pressed, device) ... end)
-- Interactions themselves use ProximityPrompts (E / X / tap) via InteractionService.
--
-- Default bindings
--   Sprint      LeftShift | L3 (left stick click) | touch "Run" (toggle)
--   Flashlight  F         | R1 / RB               | touch "Light"
--   Radio       R         | L1 / LB               | touch "Radio"   (push to talk)
--   Mic         M         | D-pad left            | touch "Mic"     (mute / unmute)
--   NightVision N         | D-pad up              | touch "Night"   (observer set only)
--   Pause       P         | View / Share (Select) | touch "II"
-- GuiService.AutoSelectGuiEnabled is turned off so the Select button is free for our
-- menu; the Router sets gamepad focus explicitly whenever a menu opens.

local GuiService = game:GetService("GuiService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Signal = require(Shared.Signal)
local Localization = require(Shared.Localization)

local Theme = require(script.Parent.Parent.UI.Theme)

local FORCE_LEGACY = false

export type Device = "keyboard" | "gamepad" | "touch"

local InputController = {}
InputController.Action = Signal.new() -- (name: string, pressed: boolean, device: Device)
InputController.DeviceChanged = Signal.new() -- (device: Device)

local ACTIONS = {
	{ name = "Sprint", keys = { Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3 }, touchKey = "TOUCH_SPRINT" },
	{ name = "Flashlight", keys = { Enum.KeyCode.F, Enum.KeyCode.ButtonR1 }, touchKey = "TOUCH_LIGHT" },
	{ name = "Radio", keys = { Enum.KeyCode.R, Enum.KeyCode.ButtonL1 }, touchKey = "TOUCH_RADIO" },
	{ name = "NightVision", keys = { Enum.KeyCode.N, Enum.KeyCode.DPadUp }, touchKey = "TOUCH_NIGHT", hidden = true },
	{ name = "Mic", keys = { Enum.KeyCode.M, Enum.KeyCode.DPadLeft }, touchKey = "TOUCH_MIC", small = true, slot = 1 },
	{ name = "Pause", keys = { Enum.KeyCode.P, Enum.KeyCode.ButtonSelect }, touchText = "II", small = true, slot = 0 },
}

local device: Device = "keyboard"
local gameplayEnabled = false
local usingActionSystem = false
local held: { [string]: boolean } = {}
local touchButtons: { [string]: TextButton } = {}
local touchContainer: Frame? = nil
local context: Instance? = nil

local function fire(name: string, pressed: boolean)
	if pressed then
		if not gameplayEnabled or UserInputService:GetFocusedTextBox() then
			return
		end
		if held[name] then
			return
		end
		held[name] = true
	else
		if not held[name] then
			return
		end
		held[name] = nil
	end
	InputController.Action:Fire(name, pressed, device)
end

---------------------------------------------------------------------------
-- Device detection
---------------------------------------------------------------------------

local function deviceFromLastInput(inputType: Enum.UserInputType): Device?
	if inputType == Enum.UserInputType.Touch then
		return "touch"
	end
	local name = inputType.Name
	if string.sub(name, 1, 7) == "Gamepad" then
		return "gamepad"
	end
	if inputType == Enum.UserInputType.Keyboard or string.sub(name, 1, 5) == "Mouse" then
		return "keyboard"
	end
	return nil
end

local function setDevice(newDevice: Device?)
	if not newDevice or newDevice == device then
		return
	end
	device = newDevice
	if touchContainer then
		touchContainer.Visible = gameplayEnabled and device == "touch"
	end
	InputController.DeviceChanged:Fire(device)
end

local function readPreferredInput(): Device?
	local ok, preferred = pcall(function()
		return (UserInputService :: any).PreferredInput
	end)
	if not ok or preferred == nil then
		return nil
	end
	if preferred == Enum.PreferredInput.Touch then
		return "touch"
	elseif preferred == Enum.PreferredInput.Gamepad then
		return "gamepad"
	end
	return "keyboard"
end

local function initDeviceDetection()
	local preferred = readPreferredInput()
	if preferred then
		device = preferred
		UserInputService:GetPropertyChangedSignal("PreferredInput"):Connect(function()
			setDevice(readPreferredInput())
		end)
	else
		device = deviceFromLastInput(UserInputService:GetLastInputType())
			or (if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then "touch" else "keyboard")
		UserInputService.LastInputTypeChanged:Connect(function(inputType)
			setDevice(deviceFromLastInput(inputType))
		end)
	end
end

---------------------------------------------------------------------------
-- Touch buttons (large, few, right thumb area; Pause sits top-right)
---------------------------------------------------------------------------

local function createTouchButtons(parent: ScreenGui)
	local container = Instance.new("Frame")
	container.Name = "TouchControls"
	container.BackgroundTransparency = 1
	container.Size = UDim2.fromScale(1, 1)
	container.Visible = false
	container.Parent = parent
	touchContainer = container

	local index = 0
	for _, definition in ACTIONS do
		local button = Instance.new("TextButton")
		button.Name = definition.name
		button.AutoButtonColor = false
		button.AutoLocalize = false
		button.BackgroundColor3 = Theme.Colors.Panel
		button.BackgroundTransparency = 0.35
		button.TextColor3 = Theme.Colors.TextBright
		button.Font = Theme.Fonts.Medium
		button.TextSize = 15
		button.Selectable = false
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = button
		local stroke = Instance.new("UIStroke")
		stroke.Color = Theme.Colors.TextFaint
		stroke.Transparency = 0.3
		stroke.Thickness = 1
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Parent = button
		if definition.small then
			button.Size = UDim2.fromOffset(48, 48)
			button.AnchorPoint = Vector2.new(1, 0)
			button.Position = UDim2.new(1, -16 - (definition.slot or 0) * 58, 0, 8)
			button.TextSize = 12
		else
			button.Size = UDim2.fromOffset(72, 72)
			button.AnchorPoint = Vector2.new(1, 1)
			button.Position = UDim2.new(1, -150 - index * 84, 1, -28 - index * 60)
			index += 1
		end
		if definition.touchKey then
			Localization.Bind(button, definition.touchKey)
		else
			button.Text = definition.touchText or ""
		end
		button.Visible = not definition.hidden
		button.Parent = container
		touchButtons[definition.name] = button
	end
end

---------------------------------------------------------------------------
-- Binding paths
---------------------------------------------------------------------------

local function bindWithActionSystem(): boolean
	local ok, err = pcall(function()
		local newContext = Instance.new("InputContext")
		newContext.Name = "FZ_Gameplay"
		for _, definition in ACTIONS do
			local action = Instance.new("InputAction")
			action.Name = definition.name
			action.Type = Enum.InputActionType.Bool
			for _, key in definition.keys do
				local binding = Instance.new("InputBinding")
				binding.KeyCode = key
				binding.Parent = action
			end
			local touchButton = touchButtons[definition.name]
			if touchButton then
				local binding = Instance.new("InputBinding")
				binding.UIButton = touchButton
				binding.Parent = action
			end
			action.Pressed:Connect(function()
				fire(definition.name, true)
			end)
			action.Released:Connect(function()
				fire(definition.name, false)
			end)
			action.Parent = newContext
		end
		newContext.Enabled = gameplayEnabled
		newContext.Parent = Players.LocalPlayer:WaitForChild("PlayerScripts")
		context = newContext
	end)
	if not ok then
		warn("[FZ-Input] Input Action System unavailable, using fallback: " .. tostring(err))
		if context then
			context:Destroy()
			context = nil
		end
	end
	return ok
end

local function bindWithFallback()
	local keyToAction: { [Enum.KeyCode]: string } = {}
	for _, definition in ACTIONS do
		for _, key in definition.keys do
			keyToAction[key] = definition.name
		end
	end
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		local name = keyToAction[input.KeyCode]
		if name then
			fire(name, true)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		local name = keyToAction[input.KeyCode]
		if name then
			fire(name, false)
		end
	end)
	for name, button in touchButtons do
		button.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				fire(name, true)
			end
		end)
		button.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.Touch then
				fire(name, false)
			end
		end)
	end
end

---------------------------------------------------------------------------
-- Public API
---------------------------------------------------------------------------

function InputController.Init(hudGui: ScreenGui)
	GuiService.AutoSelectGuiEnabled = false
	initDeviceDetection()
	createTouchButtons(hudGui)
	usingActionSystem = not FORCE_LEGACY and bindWithActionSystem()
	if not usingActionSystem then
		bindWithFallback()
	end
end

function InputController.GetDevice(): Device
	return device
end

function InputController.IsUsingActionSystem(): boolean
	return usingActionSystem
end

function InputController.SetGameplayEnabled(enabled: boolean)
	gameplayEnabled = enabled
	if context then
		(context :: any).Enabled = enabled
	end
	if touchContainer then
		touchContainer.Visible = enabled and device == "touch"
	end
	if not enabled then
		-- Release everything that is still held so nothing gets stuck "on".
		for name in table.clone(held) do
			held[name] = nil
			InputController.Action:Fire(name, false, device)
		end
	end
end

function InputController.SetTouchVisible(name: string, visible: boolean)
	local button = touchButtons[name]
	if button then
		button.Visible = visible
	end
end

-- Lets gameplay code reflect state on touch buttons (e.g. sprint toggle highlighted).
function InputController.SetTouchActive(name: string, active: boolean)
	local button = touchButtons[name]
	if button then
		button.BackgroundColor3 = if active then Theme.Colors.Accent else Theme.Colors.Panel
	end
end

return InputController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">MovementController</string>
              <string name="Source"><![CDATA[-- MovementController: slow walk, short limited sprint with stamina.
-- Keyboard: hold to sprint. Gamepad (L3) and touch: toggle, ends automatically when the
-- player stops moving or runs out of breath. No permanent sprinting by design.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local InputController = require(script.Parent.InputController)

local MovementController = {}

local M = Config.Movement
local player = Players.LocalPlayer

local stamina = 1
local exhausted = false
local wantsSprint = false
local sprinting = false
local regenTimer = 0
local heartbeat: RBXScriptConnection? = nil
local settings = nil
local onStamina: ((number, boolean) -> ())? = nil

local function cameraEffectsScale(): number
	local value = settings and settings.Get("cameraEffects") or "full"
	return if value == "off" then 0 elseif value == "reduced" then 0.5 else 1
end

local function setSprinting(value: boolean)
	if sprinting == value then
		return
	end
	sprinting = value
	InputController.SetTouchActive("Sprint", value)
	local camera = workspace.CurrentCamera
	if camera then
		local fov = M.BaseFov + (if value then M.SprintFovBoost * cameraEffectsScale() else 0)
		TweenService:Create(camera, TweenInfo.new(0.35, Enum.EasingStyle.Sine), { FieldOfView = fov }):Play()
	end
end

local function step(dt: number)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	local moving = humanoid.MoveDirection.Magnitude > 0.1
	if not moving and InputController.GetDevice() ~= "keyboard" then
		wantsSprint = false -- toggle sprint ends when the player stops
	end

	local canSprint = wantsSprint and moving and not exhausted and stamina > 0 and not player:GetAttribute("FZ_Downed")
	setSprinting(canSprint)

	if sprinting then
		stamina = math.max(0, stamina - dt / M.StaminaSeconds)
		regenTimer = M.RegenDelay
		if stamina <= 0 then
			exhausted = true
			wantsSprint = false
		end
	else
		regenTimer = math.max(0, regenTimer - dt)
		if regenTimer <= 0 then
			stamina = math.min(1, stamina + dt / M.RegenSeconds)
		end
		if exhausted and stamina >= M.ExhaustedThreshold then
			exhausted = false
		end
	end

	if player:GetAttribute("FZ_MonsterMode") then
		return -- the creature rig keeps the speed the server gave it
	end
	local speed = if sprinting then M.SprintSpeed else M.WalkSpeed
	if player:GetAttribute("FZ_Downed") then
		speed = Config.Health.CrawlSpeed
		wantsSprint = false
	end
	if player:GetAttribute("FZ_AdminSpeed") then
		speed *= 2
	end
	humanoid.WalkSpeed = speed
	if onStamina then
		onStamina(stamina, exhausted)
	end
end

function MovementController.Init(settingsController, staminaCallback: (number, boolean) -> ())
	settings = settingsController
	onStamina = staminaCallback
	InputController.Action:Connect(function(name, pressed, device)
		if name ~= "Sprint" then
			return
		end
		if device == "keyboard" then
			wantsSprint = pressed
		elseif pressed then
			wantsSprint = not wantsSprint
		end
	end)
end

function MovementController.SetActive(active: boolean)
	if active and not heartbeat then
		heartbeat = RunService.Heartbeat:Connect(step)
	elseif not active and heartbeat then
		heartbeat:Disconnect()
		heartbeat = nil
		wantsSprint = false
		setSprinting(false)
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if humanoid then
			humanoid.WalkSpeed = M.WalkSpeed
		end
	end
end

return MovementController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">RadioController</string>
              <string name="Source"><![CDATA[-- RadioController: the walkie-talkie in your hand.
--   * Push to talk (R / LB / touch "Radio"), hold or toggle (Settings -> Radio button)
--   * Mute / unmute your own microphone (M / D-pad left / touch "Mic")
--   * Viewmodel: raised while transmitting, half-raised while receiving, otherwise away
--   * Small HUD line: "TRANSMITTING", "Receiving: name", "Microphone muted"
-- Transmitting is audible to the creature (server NoiseService) - talk with care.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local InputController = require(script.Parent.InputController)
local VoiceController = require(script.Parent.VoiceController)
local AudioController = require(script.Parent.AudioController)

local Theme = require(script.Parent.Parent.UI.Theme)
local Components = require(script.Parent.Parent.UI.Components)

local RadioController = {}

local player = Players.LocalPlayer
local settings = nil
local transmitting = false
local muted = false
local receiving: { string } = {}

local viewmodel: Model? = nil
local led: BasePart? = nil
local body: BasePart? = nil
local render: RBXScriptConnection? = nil
local pose = 0 -- 0 hidden, 0.5 receiving, 1 transmitting

local statusLabel: TextLabel
local micLabel: TextLabel

local HIDDEN = CFrame.new(0.9, -2.8, -1.4) * CFrame.Angles(math.rad(-30), 0, 0)
local HALF = CFrame.new(0.95, -1.45, -1.7) * CFrame.Angles(math.rad(8), math.rad(-14), math.rad(-6))
local RAISED = CFrame.new(0.55, -0.85, -1.35) * CFrame.Angles(math.rad(14), math.rad(-24), math.rad(-10))

local function part(model: Model, name: string, size: Vector3, color: Color3, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Name = name
	p.Size = size
	p.Color = color
	p.Material = material
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Parent = model
	return p
end

local function buildViewmodel(): Model
	local model = Instance.new("Model")
	model.Name = "FZ_RadioViewmodel"
	local color = player:GetAttribute("FZ_RadioColor")
	local b = part(model, "Body", Vector3.new(0.75, 1.7, 0.42), if typeof(color) == "Color3" then color else Color3.fromRGB(46, 48, 50), Enum.Material.SmoothPlastic)
	model.PrimaryPart = b
	body = b
	local antenna = part(model, "Antenna", Vector3.new(0.14, 1.3, 0.14), Color3.fromRGB(26, 26, 26), Enum.Material.Rubber)
	antenna:SetAttribute("Offset", CFrame.new(-0.22, 1.45, 0))
	local screen = part(model, "Screen", Vector3.new(0.56, 0.42, 0.05), Color3.fromRGB(255, 150, 60), Enum.Material.Neon)
	screen.Transparency = 0.15
	screen:SetAttribute("Offset", CFrame.new(0, 0.42, -0.22))
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 200
	gui.AutoLocalize = false
	gui.Parent = screen
	local text = Instance.new("TextLabel")
	text.BackgroundTransparency = 1
	text.Size = UDim2.fromScale(1, 1)
	text.Font = Enum.Font.RobotoMono
	text.TextScaled = true
	text.TextColor3 = Color3.fromRGB(40, 16, 0)
	text.Text = "CH-07\nRELAIS"
	text.AutoLocalize = false
	text.Parent = gui
	local grille = part(model, "Speaker", Vector3.new(0.5, 0.5, 0.05), Color3.fromRGB(20, 20, 20), Enum.Material.DiamondPlate)
	grille:SetAttribute("Offset", CFrame.new(0, -0.35, -0.22))
	local l = part(model, "Led", Vector3.new(0.1, 0.1, 0.06), Color3.fromRGB(60, 20, 20), Enum.Material.Neon)
	l:SetAttribute("Offset", CFrame.new(0.26, 0.74, -0.22))
	led = l
	local knob = part(model, "Knob", Vector3.new(0.18, 0.2, 0.18), Color3.fromRGB(30, 30, 30), Enum.Material.Metal)
	knob:SetAttribute("Offset", CFrame.new(0.2, 0.92, 0))
	return model
end

local function placeViewmodel(cframe: CFrame)
	local model = viewmodel :: Model
	local b = body :: BasePart
	b.CFrame = cframe
	for _, child in model:GetChildren() do
		if child ~= b and child:IsA("BasePart") then
			local offset = child:GetAttribute("Offset")
			if typeof(offset) == "CFrame" then
				child.CFrame = cframe * offset
			end
		end
	end
end

local function targetPose(): number
	if transmitting then
		return 1
	elseif #receiving > 0 then
		return 0.5
	end
	return 0
end

local function ensureRender()
	if render then
		return
	end
	render = RunService.RenderStepped:Connect(function(dt)
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local goal = targetPose()
		pose += (goal - pose) * math.min(1, dt * 9)
		if math.abs(goal - pose) < 0.01 then
			pose = goal
		end
		if pose <= 0.001 and goal == 0 then
			if viewmodel then
				viewmodel:Destroy()
				viewmodel = nil
			end
			(render :: RBXScriptConnection):Disconnect()
			render = nil
			return
		end
		if not viewmodel or not viewmodel.Parent then
			viewmodel = buildViewmodel()
			viewmodel.Parent = camera
		end
		local offset = if pose <= 0.5 then HIDDEN:Lerp(HALF, pose * 2) else HALF:Lerp(RAISED, (pose - 0.5) * 2)
		local t = os.clock()
		local sway = CFrame.new(math.sin(t * 1.3) * 0.015, math.sin(t * 2.1) * 0.012, 0)
		placeViewmodel(camera.CFrame * offset * sway)
		if led then
			led.Color = if transmitting then Color3.fromRGB(255, 40, 30) elseif #receiving > 0 then Color3.fromRGB(80, 255, 120) else Color3.fromRGB(60, 20, 20)
		end
	end)
end

local function refreshHud()
	if transmitting then
		statusLabel.TextColor3 = Theme.Colors.Accent
		Localization.Bind(statusLabel, "RADIO_TX")
		statusLabel.Text = "● " .. statusLabel.Text
		statusLabel.Visible = true
	elseif #receiving > 0 then
		statusLabel.TextColor3 = Theme.Colors.Relay
		Localization.Bind(statusLabel, "RADIO_RX", { name = table.concat(receiving, ", ") })
		statusLabel.Visible = true
	else
		statusLabel.Visible = false
	end
	micLabel.Visible = muted
end

local function setTransmitting(value: boolean)
	if transmitting == value then
		return
	end
	transmitting = value
	Net.Event("RadioState"):FireServer(value)
	AudioController.Play(if value then "radio_squelch_on" else "radio_squelch_off", nil, 0.5, "SFX")
	InputController.SetTouchActive("Radio", value)
	ensureRender()
	refreshHud()
end

local function setMuted(value: boolean)
	muted = value
	Net.Event("MicMute"):FireServer(value)
	InputController.SetTouchActive("Mic", value)
	refreshHud()
end

function RadioController.IsMuted(): boolean
	return muted
end

function RadioController.ToggleMute()
	setMuted(not muted)
end

-- Called when gameplay is paused (menus, documents, downed is fine).
function RadioController.Stop()
	setTransmitting(false)
end

function RadioController.Init(hudGui: ScreenGui, settingsController)
	settings = settingsController
	statusLabel = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.Accent, Size = UDim2.fromOffset(360, 20), Position = UDim2.new(0, 24, 1, -64), Parent = hudGui })
	statusLabel.Visible = false
	statusLabel.TextStrokeTransparency = 0.5
	micLabel = Components.Text({ Key = "MIC_OFF", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, Size = UDim2.fromOffset(360, 20), Position = UDim2.new(0, 24, 1, -40), Parent = hudGui })
	micLabel.Visible = false
	micLabel.TextStrokeTransparency = 0.5

	InputController.Action:Connect(function(name, pressed)
		if name == "Radio" then
			if settings.Get("radioMode") == "toggle" then
				if pressed then
					setTransmitting(not transmitting)
				end
			else
				setTransmitting(pressed)
			end
		elseif name == "Mic" and pressed then
			setMuted(not muted)
		end
	end)

	VoiceController.ReceivingChanged:Connect(function(names)
		receiving = names
		ensureRender()
		refreshHud()
	end)
	Localization.Changed:Connect(refreshHud)
	player:GetAttributeChangedSignal("FZ_RadioColor"):Connect(function()
		if viewmodel then
			viewmodel:Destroy()
			viewmodel = nil
		end
	end)
end

return RadioController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">SettingsController</string>
              <string name="Source"><![CDATA[-- SettingsController: local source of truth for player settings.
-- Changes apply instantly on this client and are persisted through the server.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)
local Signal = require(Shared.Signal)

local SettingsController = {}
SettingsController.Changed = Signal.new() -- (key, value)

local values: { [string]: any } = Config.DefaultSettings()
local updateRemote = Net.Event("UpdateSetting")

function SettingsController.Load(saved: { [string]: any }?)
	for key, value in saved or {} do
		local ok, sanitized = Config.ValidateSetting(key, value)
		if ok then
			values[key] = sanitized
		end
	end
end

function SettingsController.Get(key: string): any
	return values[key]
end

function SettingsController.Set(key: string, value: any): boolean
	local ok, sanitized = Config.ValidateSetting(key, value)
	if not ok then
		return false
	end
	if values[key] == sanitized then
		return true
	end
	values[key] = sanitized
	if key == "language" then
		Localization.SetLanguage(sanitized)
	end
	SettingsController.Changed:Fire(key, sanitized)
	updateRemote:FireServer(key, sanitized)
	return true
end

-- Cycles enum / bool / int settings by delta (+1 / -1). Wraps for enums and bools.
function SettingsController.Step(key: string, delta: number)
	local definition = Config.Settings[key]
	if not definition then
		return
	end
	local current = values[key]
	if definition.kind == "bool" then
		SettingsController.Set(key, not current)
	elseif definition.kind == "enum" then
		local index = table.find(definition.values, current) or 1
		local nextIndex = ((index - 1 + delta) % #definition.values) + 1
		SettingsController.Set(key, definition.values[nextIndex])
	elseif definition.kind == "int" then
		SettingsController.Set(key, math.clamp((current or definition.default) + delta, definition.min, definition.max))
	end
end

-- Display text for a setting value in the current language.
function SettingsController.Describe(key: string): string
	local definition = Config.Settings[key]
	local value = values[key]
	if not definition then
		return ""
	end
	if key == "language" then
		return Config.LanguageNames[value] or ""
	elseif definition.kind == "bool" then
		return Localization.T(if value then "VALUE_ON" else "VALUE_OFF")
	elseif definition.kind == "enum" then
		return Localization.T(definition.labels[value])
	elseif definition.kind == "int" then
		return tostring(value)
	end
	return tostring(value)
end

return SettingsController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">VoiceController</string>
              <string name="Source"><![CDATA[-- VoiceController: hearing voices on this client.
--
-- Proximity voice: one AudioListener on the camera hears every player's head emitter
-- (spatial, quieter with distance). Your own emitter is silenced locally so you never
-- hear yourself. Muting a teammate only changes YOUR local copy of their fader.
--
-- Radio (walkie-talkie, like Escape the Backrooms): while someone transmits, their
-- microphone is wired through a radio filter (band-pass + distortion) straight to your
-- speakers. Volume falls with distance and static rises; far away only static remains.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local VoiceChatService = game:GetService("VoiceChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Signal = require(Shared.Signal)

local AudioController = require(script.Parent.AudioController)

local VoiceController = {}
VoiceController.ReceivingChanged = Signal.new() -- (names: { string })

local localPlayer = Players.LocalPlayer
local output: Instance? = nil
local available = false
local locallyMuted: { [number]: boolean } = {}

type RadioChain = { nodes: { Instance }, fader: Instance, static: Sound? }
local radioChains: { [Player]: RadioChain } = {}

local function create(className: string, props: { [string]: any }, parent: Instance): Instance
	local instance = Instance.new(className)
	for key, value in props do
		(instance :: any)[key] = value
	end
	instance.Parent = parent
	return instance
end

local function wire(source: Instance, target: Instance, parent: Instance): Instance
	return create("Wire", { SourceInstance = source, TargetInstance = target }, parent)
end

local function voiceFader(player: Player): Instance?
	local head = player.Character and player.Character:FindFirstChild("Head")
	return head and head:FindFirstChild("FZ_VoiceFader")
end

local function applyLocalVolume(player: Player)
	local fader = voiceFader(player)
	if fader then
		local volume = if player == localPlayer or locallyMuted[player.UserId] then 0 else 1
		pcall(function()
			(fader :: any).Volume = volume
		end)
	end
end

local function distanceTo(player: Player): number
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local camera = workspace.CurrentCamera
	if not root or not camera then
		return math.huge
	end
	return (root.Position - camera.CFrame.Position).Magnitude
end

local function radioVolume(distance: number): (number, number)
	local V = Config.Voice
	if distance <= V.RadioFull then
		return 1, 0.05
	end
	local t = math.clamp((distance - V.RadioFull) / (V.RadioMax - V.RadioFull), 0, 1)
	local voice = math.max(V.RadioMinVolume, (1 - t) ^ 1.6) * (if t >= 1 then 0 else 1)
	return voice, 0.05 + t * 0.5
end

local function stopRadio(player: Player)
	local chain = radioChains[player]
	if not chain then
		return
	end
	radioChains[player] = nil
	for _, node in chain.nodes do
		node:Destroy()
	end
	if chain.static then
		chain.static:Destroy()
	end
	AudioController.Play("radio_squelch_off", nil, 0.6, "SFX")
end

local function startRadio(player: Player)
	if radioChains[player] or player == localPlayer or locallyMuted[player.UserId] or not output then
		return
	end
	AudioController.Play("radio_squelch_on", nil, 0.6, "SFX")
	local static = AudioController.Loop("radio_static_loop", game:GetService("SoundService"), 0.05, "SFX")
	local input = player:FindFirstChildOfClass("AudioDeviceInput")
	local nodes = {}
	local fader = nil
	if input and available then
		local ok = pcall(function()
			local holder = Instance.new("Folder")
			holder.Name = "FZ_Radio_" .. player.UserId
			holder.Parent = localPlayer
			table.insert(nodes, holder)
			local bandpass = create("AudioFilter", { FilterType = Enum.AudioFilterType.Bandpass, Frequency = 1700, Q = 0.9 }, holder)
			local distortion = create("AudioDistortion", { Level = 0.35 }, holder)
			fader = create("AudioFader", { Volume = 1 }, holder)
			wire(input, bandpass, holder)
			wire(bandpass, distortion, holder)
			wire(distortion, fader, holder)
			wire(fader, output :: Instance, holder)
		end)
		if not ok then
			for _, node in nodes do
				node:Destroy()
			end
			nodes = {}
			fader = nil
		end
	end
	radioChains[player] = { nodes = nodes, fader = fader :: any, static = static }
end

local function refreshReceiving()
	local names = {}
	for player in radioChains do
		table.insert(names, player.DisplayName)
	end
	VoiceController.ReceivingChanged:Fire(names)
end

local function watchPlayer(player: Player)
	player:GetAttributeChangedSignal("FZ_RadioTx"):Connect(function()
		if player:GetAttribute("FZ_RadioTx") then
			startRadio(player)
		else
			stopRadio(player)
		end
		refreshReceiving()
	end)
	player.CharacterAdded:Connect(function(character)
		local head = character:WaitForChild("Head", 10)
		if head then
			head.ChildAdded:Connect(function(child)
				if child.Name == "FZ_VoiceFader" then
					applyLocalVolume(player)
				end
			end)
			applyLocalVolume(player)
		end
	end)
	applyLocalVolume(player)
end

function VoiceController.IsAvailable(): boolean
	return available
end

function VoiceController.SetMuted(player: Player, muted: boolean)
	locallyMuted[player.UserId] = muted or nil
	applyLocalVolume(player)
	if muted then
		stopRadio(player)
		refreshReceiving()
	end
end

function VoiceController.IsMuted(player: Player): boolean
	return locallyMuted[player.UserId] == true
end

function VoiceController.Init()
	local ok, enabled = pcall(function()
		return VoiceChatService:IsVoiceEnabledForUserIdAsync(localPlayer.UserId)
	end)
	available = ok and enabled == true

	pcall(function()
		local camera = workspace.CurrentCamera
		local listener = create("AudioListener", { Name = "FZ_Listener" }, camera)
		output = create("AudioDeviceOutput", { Name = "FZ_Output" }, localPlayer)
		wire(listener, output :: Instance, listener)
		workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
			if workspace.CurrentCamera then
				listener.Parent = workspace.CurrentCamera
			end
		end)
	end)

	for _, player in Players:GetPlayers() do
		watchPlayer(player)
	end
	Players.PlayerAdded:Connect(watchPlayer)
	Players.PlayerRemoving:Connect(function(player)
		stopRadio(player)
		refreshReceiving()
	end)

	-- Distance-based radio mix, 10 Hz
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.1 or next(radioChains) == nil then
			return
		end
		accumulator = 0
		for player, chain in radioChains do
			local voice, staticVolume = radioVolume(distanceTo(player))
			if chain.fader then
				pcall(function()
					(chain.fader :: any).Volume = voice
				end)
			end
			if chain.static then
				chain.static.Volume = staticVolume
			end
		end
	end)
end

return VoiceController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">WorldTextController</string>
              <string name="Source"><![CDATA[-- WorldTextController: per-player localization of text that lives in the 3D world.
--   * ProximityPrompts tagged "FZ_Prompt" (attributes FZ_Action / FZ_Object)
--   * TextLabels on SurfaceGuis tagged "FZ_WorldText" (attribute LocKey, LocParam_<name>)
-- Text is set locally, so four players can read the same sign in four languages.
-- Works with StreamingEnabled: objects are localized whenever they stream in.

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Localization = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Localization"))

local WorldTextController = {}

local function localizePrompt(prompt: Instance)
	if not prompt:IsA("ProximityPrompt") then
		return
	end
	local action = prompt:GetAttribute("FZ_Action")
	local object = prompt:GetAttribute("FZ_Object")
	prompt.ActionText = if type(action) == "string" then Localization.T(action) else ""
	prompt.ObjectText = if type(object) == "string" then Localization.T(object) else ""
	-- Equipment changes hold times locally (technician / medic). The base value is kept.
	if prompt:GetAttribute("FZ_BaseHold") == nil then
		prompt:SetAttribute("FZ_BaseHold", prompt.HoldDuration)
	end
	local base = prompt:GetAttribute("FZ_BaseHold") :: number
	local player = Players.LocalPlayer
	local multiplier = if object == "OBJECT_TEAMMATE"
		then tonumber(player:GetAttribute("FZ_ReviveMultiplier")) or 1
		else tonumber(player:GetAttribute("FZ_HoldMultiplier")) or 1
	prompt.HoldDuration = base * multiplier
	-- Your own "help up" prompt is for your teammates, not for you.
	local character = player.Character
	if character and prompt:IsDescendantOf(character) then
		prompt.Enabled = false
	end
end

local function localizeText(label: Instance)
	if not label:IsA("TextLabel") then
		return
	end
	local key = label:GetAttribute("LocKey")
	if type(key) ~= "string" then
		return
	end
	local params = {}
	for name, value in label:GetAttributes() do
		local paramName = string.match(name, "^LocParam_(.+)$")
		if paramName then
			params[paramName] = value
		end
	end
	label.AutoLocalize = false
	label.Text = Localization.T(key, params)
end

local function refreshAll()
	for _, prompt in CollectionService:GetTagged("FZ_Prompt") do
		localizePrompt(prompt)
	end
	for _, label in CollectionService:GetTagged("FZ_WorldText") do
		localizeText(label)
	end
end

function WorldTextController.Init()
	CollectionService:GetInstanceAddedSignal("FZ_Prompt"):Connect(localizePrompt)
	CollectionService:GetInstanceAddedSignal("FZ_WorldText"):Connect(localizeText)
	Localization.Changed:Connect(refreshAll)
	local player = Players.LocalPlayer
	player:GetAttributeChangedSignal("FZ_HoldMultiplier"):Connect(refreshAll)
	player:GetAttributeChangedSignal("FZ_ReviveMultiplier"):Connect(refreshAll)
	refreshAll()
end

return WorldTextController
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="67">
          <Properties>
            <string name="Name">Main</string>
            <string name="Source"><![CDATA[-- FREQUENCY ZERO - client bootstrap.
--
-- Flow: boot screen (logo only) -> load profile -> apply saved language BEFORE any text
-- exists -> first start: language picker / otherwise: main menu -> play.
-- Because no localized UI is created before the language is known, players never see
-- placeholder or wrong-language text that changes a moment later.

local CollectionService = game:GetService("CollectionService")
local HttpService = game:GetService("HttpService")
local SoundService = game:GetService("SoundService")
local LocalizationService = game:GetService("LocalizationService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)
local SessionState = require(Shared.SessionState)

local Controllers = script.Parent:WaitForChild("Controllers")
local UI = script.Parent:WaitForChild("UI")

local InputController = require(Controllers.InputController)
local SettingsController = require(Controllers.SettingsController)
local GraphicsController = require(Controllers.GraphicsController)
local MovementController = require(Controllers.MovementController)
local FlashlightController = require(Controllers.FlashlightController)
local WorldTextController = require(Controllers.WorldTextController)
local AudioController = require(Controllers.AudioController)
local VoiceController = require(Controllers.VoiceController)
local RadioController = require(Controllers.RadioController)
local CreatureVisualsController = require(Controllers.CreatureVisualsController)
local HealthController = require(Controllers.HealthController)
local EquipmentController = require(Controllers.EquipmentController)

local Components = require(UI.Components)
local Theme = require(UI.Theme)
local Router = require(UI.Router)
local Hud = require(UI.Hud)
local DebugOverlay = require(UI.DebugOverlay)
local MainMenu = require(UI.Screens.MainMenu)
local LanguageSelect = require(UI.Screens.LanguageSelect)

---------------------------------------------------------------------------
-- 1. Screen layers (no text yet)
---------------------------------------------------------------------------
local backdropGui = Components.ScreenGui("FZ_Backdrop", 10, true)
local menuGui = Components.ScreenGui("FZ_Menu", 20)
Components.AttachScale(menuGui)
local hudGui = Components.ScreenGui("FZ_HUD", 30)
Components.AttachScale(hudGui)

-- Dark on the left (menu column), revealing the scene on the right.
local backdrop = Instance.new("Frame")
backdrop.Name = "Backdrop"
backdrop.BackgroundColor3 = Theme.Colors.Background
backdrop.BorderSizePixel = 0
backdrop.Size = UDim2.fromScale(1, 1)
backdrop.Visible = false
backdrop.Parent = backdropGui
local gradient = Instance.new("UIGradient")
gradient.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.05),
	NumberSequenceKeypoint.new(0.45, 0.35),
	NumberSequenceKeypoint.new(1, 0.75),
})
gradient.Parent = backdrop

InputController.Init(hudGui)

---------------------------------------------------------------------------
-- 2. Profile + language (before any localized UI is built)
---------------------------------------------------------------------------
local function waitForAttribute(name: string, timeout: number): boolean
	local deadline = os.clock() + timeout
	while player:GetAttribute(name) ~= true and os.clock() < deadline do
		task.wait(0.1)
	end
	return player:GetAttribute(name) == true
end

local profile = nil
if waitForAttribute("FZ_DataReady", 25) then
	local ok, result = pcall(function()
		return Net.Function("FetchProfile"):InvokeServer()
	end)
	if ok and type(result) == "table" then
		profile = result
	end
end
profile = profile
	or { settings = {}, signalMarks = 0, progress = { chapter = 1, completed = {} }, persistent = false, isNew = true }

SettingsController.Load(profile.settings)

local function robloxLocale(): string
	local ok, locale = pcall(function()
		return LocalizationService.RobloxLocaleId
	end)
	if ok and type(locale) == "string" and locale ~= "" then
		return locale
	end
	return player.LocaleId
end

local savedLanguage = SettingsController.Get("language")
local detectedLanguage = Localization.Detect(robloxLocale()) or Config.FallbackLanguage
Localization.SetLanguage(savedLanguage or detectedLanguage)

if RunService:IsStudio() then
	for _, problem in Localization.Validate() do
		warn("[FZ-Loc] " .. problem)
	end
end

---------------------------------------------------------------------------
-- 3. Controllers and HUD
---------------------------------------------------------------------------
local state = "boot" -- boot | language | menu | playing | paused
local router = Router.new(menuGui, InputController)

local controls = nil
local function getControls()
	if controls then
		return controls
	end
	local ok, result = pcall(function()
		local playerModule = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule") :: ModuleScript)
		return (playerModule :: any):GetControls()
	end)
	if ok then
		controls = result
	else
		warn("[FZ] PlayerModule controls unavailable: " .. tostring(result))
	end
	return controls
end

local function setGameplay(enabled: boolean)
	InputController.SetGameplayEnabled(enabled)
	MovementController.SetActive(enabled)
	-- No world interactions (E / X / tap prompts) while a menu or document is open.
	pcall(function()
		(ProximityPromptService :: any).Enabled = enabled
	end)
	if not enabled then
		RadioController.Stop()
	end
	EquipmentController.SetActive(enabled)
	local c = getControls()
	if c then
		if enabled then
			c:Enable()
		else
			c:Disable()
		end
	end
end

local function setMenuCamera(active: boolean)
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	if active then
		local anchor = CollectionService:GetTagged("FZ_MenuCamera")[1]
		if anchor and anchor:IsA("BasePart") then
			camera.CameraType = Enum.CameraType.Scriptable
			camera.CFrame = anchor.CFrame
		end
	else
		camera.CameraType = Enum.CameraType.Custom
		camera.FieldOfView = Config.Movement.BaseFov
	end
end

GraphicsController.Init(SettingsController)
WorldTextController.Init()
Hud.Init(hudGui, SettingsController, InputController, {
	onOpen = function()
		setGameplay(false)
	end,
	onClose = function()
		if state == "playing" then
			setGameplay(true)
		end
	end,
})
DebugOverlay.Init(hudGui, {
	profile = GraphicsController.GetProfileName,
	quality = GraphicsController.GetRobloxQualityLevel,
	device = InputController.GetDevice,
	input = function()
		return if InputController.IsUsingActionSystem() then "IAS" else "UIS"
	end,
})
MovementController.Init(SettingsController, Hud.SetStamina)
FlashlightController.Init()
AudioController.Init()
VoiceController.Init()
RadioController.Init(hudGui, SettingsController)
CreatureVisualsController.Init(Hud.ShowSubtitle)
HealthController.Init(hudGui, SettingsController)
EquipmentController.Init()

-- Scare intensity: creature sounds are mixed down on "reduced" (medic set dampens too).
local function applyScareMix()
	local group = SoundService:FindFirstChild("FZ_Creature")
	if group and group:IsA("SoundGroup") then
		local level = SettingsController.Get("scareIntensity")
		local volume = if level == "reduced" then 0.55 elseif level == "intense" then 1 else 0.85
		if player:GetAttribute("FZ_ScareDampening") then
			volume *= 0.8
		end
		group.Volume = volume
	end
end
applyScareMix()
SettingsController.Changed:Connect(applyScareMix)
player:GetAttributeChangedSignal("FZ_ScareDampening"):Connect(applyScareMix)

if not VoiceController.IsAvailable() then
	task.delay(8, function()
		Hud.Notify("VOICE_UNAVAILABLE")
	end)
end

Net.Event("Subtitle").OnClientEvent:Connect(Hud.ShowSubtitle)
Net.Event("Document").OnClientEvent:Connect(Hud.ShowDocument)
Net.Event("Notify").OnClientEvent:Connect(function(key, params)
	if type(key) == "string" then
		Hud.Notify(key, if type(params) == "table" then params else nil)
	end
end)
local function objectiveParams(): { [string]: any }?
	local raw = SessionState.Get("ObjectiveParams")
	if type(raw) ~= "string" then
		return nil
	end
	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, raw)
	return if ok and type(decoded) == "table" then decoded else nil
end
local function showObjective(announce: boolean?)
	local key = SessionState.Get("Objective")
	if state == "playing" and type(key) == "string" then
		Hud.ShowObjective(key, announce, objectiveParams())
	end
end
SessionState.Observe("Objective", function()
	showObjective()
end)
SessionState.Observe("ObjectiveParams", function()
	showObjective()
end)

---------------------------------------------------------------------------
-- 4. App flow
---------------------------------------------------------------------------
local readyRemote = Net.Event("ClientReady")
local pauseOpenedAt = 0

local app = {
	Settings = SettingsController,
	Input = InputController,
	Hud = Hud,
	Debug = DebugOverlay,
	Profile = profile,
	Voice = VoiceController,
	Radio = RadioController,
}
router.App = app

function app.HasProgress(): boolean
	return profile.isNew == false
end

function app.Play(_chapter: number?)
	if state == "menu" then
		state = "playing"
		router:Clear()
		backdrop.Visible = false
		setMenuCamera(false)
		setGameplay(true)
		readyRemote:FireServer()
		showObjective(false)
	elseif state == "paused" then
		state = "playing"
		router:Clear()
		backdrop.Visible = false
		setGameplay(true)
	end
end

local function openPause()
	if state ~= "playing" or Hud.IsDocumentOpen() then
		return
	end
	state = "paused"
	pauseOpenedAt = os.clock()
	setGameplay(false)
	backdrop.Visible = true
	router:Replace(MainMenu, { mode = "pause" })
end

InputController.Action:Connect(function(name, pressed)
	if name == "Pause" and pressed then
		openPause()
	end
end)

-- The same buttons close the in-game menu again (only from its first page).
UserInputService.InputBegan:Connect(function(input)
	if state ~= "paused" or #router.Stack ~= 1 or os.clock() - pauseOpenedAt < 0.25 then
		return
	end
	local key = input.KeyCode
	if key == Enum.KeyCode.ButtonSelect or (key == Enum.KeyCode.P and not UserInputService:GetFocusedTextBox()) then
		app.Play()
	end
end)

local function showMainMenu()
	state = "menu"
	backdrop.Visible = true
	setMenuCamera(true)
	router:Replace(MainMenu, { mode = "main" })
end

setGameplay(false)
if savedLanguage == nil then
	state = "language"
	backdrop.Visible = true
	router:Replace(LanguageSelect, {
		firstStart = true,
		suggested = detectedLanguage,
		onChosen = function(code: string)
			SettingsController.Set("language", code)
			showMainMenu()
		end,
	})
else
	showMainMenu()
end

if player:GetAttribute("FZ_DataPersistent") == false then
	Hud.Notify("ERROR_DATA")
end

---------------------------------------------------------------------------
-- 5. Remove boot screen (fade)
---------------------------------------------------------------------------
local boot = player:WaitForChild("PlayerGui"):FindFirstChild("FZ_Boot")
if boot then
	local background = boot:FindFirstChild("Background")
	if background then
		for _, child in background:GetDescendants() do
			if child:IsA("TextLabel") then
				TweenService:Create(child, Theme.Slow, { TextTransparency = 1 }):Play()
			elseif child:IsA("Frame") then
				TweenService:Create(child, Theme.Slow, { BackgroundTransparency = 1 }):Play()
			end
		end
		local fade = TweenService:Create(background, Theme.Slow, { BackgroundTransparency = 1 })
		fade.Completed:Once(function()
			boot:Destroy()
		end)
		fade:Play()
	else
		boot:Destroy()
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="68">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="69">
            <Properties>
              <string name="Name">Components</string>
              <string name="Source"><![CDATA[-- Components: small set of UI building blocks shared by every screen.
-- All text goes through Localization.Bind, so language changes update instantly and
-- Roblox auto-translation never touches our text.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Localization = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Localization"))
local Theme = require(script.Parent.Theme)

local Components = {}

local playerGui = Players.LocalPlayer:WaitForChild("PlayerGui")

-- Shared invisible selection object: we draw our own focus state instead of Roblox's box.
local hiddenSelection = Instance.new("Frame")
hiddenSelection.BackgroundTransparency = 1
hiddenSelection.Size = UDim2.fromScale(1, 1)

function Components.ScreenGui(name: string, displayOrder: number, fullBleed: boolean?): ScreenGui
	local gui = Instance.new("ScreenGui")
	gui.Name = name
	gui.ResetOnSpawn = false
	gui.DisplayOrder = displayOrder
	gui.AutoLocalize = false
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.ScreenInsets = if fullBleed then Enum.ScreenInsets.None else Enum.ScreenInsets.CoreUISafeInsets
	gui.Parent = playerGui
	return gui
end

-- Responsive scaling: logical layout at 720p height, clamped so touch targets stay large
-- on phones and text does not become huge on 4K screens.
function Components.AttachScale(gui: ScreenGui): UIScale
	local scale = Instance.new("UIScale")
	scale.Parent = gui
	local function update()
		local camera = workspace.CurrentCamera
		if not camera then
			return
		end
		local viewport = camera.ViewportSize
		scale.Scale = math.clamp(viewport.Y / 720, 0.9, 1.5)
	end
	local connection
	local function bindCamera()
		if connection then
			connection:Disconnect()
		end
		local camera = workspace.CurrentCamera
		if camera then
			connection = camera:GetPropertyChangedSignal("ViewportSize"):Connect(update)
		end
		update()
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(bindCamera)
	bindCamera()
	return scale
end

export type TextProps = {
	Name: string?,
	Key: string?,
	Params: { [string]: any }?,
	Text: string?,
	Font: Enum.Font?,
	TextSize: number?,
	Color: Color3?,
	Size: UDim2?,
	Position: UDim2?,
	AnchorPoint: Vector2?,
	XAlign: Enum.TextXAlignment?,
	YAlign: Enum.TextYAlignment?,
	Wrapped: boolean?,
	AutoY: boolean?,
	RichText: boolean?,
	LayoutOrder: number?,
	Parent: Instance?,
}

function Components.Text(props: TextProps): TextLabel
	local label = Instance.new("TextLabel")
	label.Name = props.Name or (props.Key or "Text")
	label.BackgroundTransparency = 1
	label.AutoLocalize = false
	label.Font = props.Font or Theme.Fonts.Body
	label.TextSize = props.TextSize or Theme.Sizes.TextBody
	label.TextColor3 = props.Color or Theme.Colors.Text
	label.TextXAlignment = props.XAlign or Enum.TextXAlignment.Left
	label.TextYAlignment = props.YAlign or Enum.TextYAlignment.Center
	label.TextWrapped = props.Wrapped ~= false
	label.RichText = props.RichText == true
	label.Size = props.Size or UDim2.new(1, 0, 0, (props.TextSize or Theme.Sizes.TextBody) + 8)
	if props.AutoY then
		label.AutomaticSize = Enum.AutomaticSize.Y
	end
	if props.Position then
		label.Position = props.Position
	end
	if props.AnchorPoint then
		label.AnchorPoint = props.AnchorPoint
	end
	label.LayoutOrder = props.LayoutOrder or 0
	if props.Key then
		Localization.Bind(label, props.Key, props.Params)
	else
		label.Text = props.Text or ""
	end
	label.Parent = props.Parent
	return label
end

function Components.List(parent: Instance, padding: number?, horizontal: boolean?): UIListLayout
	local layout = Instance.new("UIListLayout")
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, padding or Theme.Sizes.Gap)
	layout.FillDirection = if horizontal then Enum.FillDirection.Horizontal else Enum.FillDirection.Vertical
	layout.Parent = parent
	return layout
end

function Components.Padding(parent: Instance, left: number, top: number?, right: number?, bottom: number?)
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, left)
	padding.PaddingTop = UDim.new(0, top or left)
	padding.PaddingRight = UDim.new(0, right or left)
	padding.PaddingBottom = UDim.new(0, bottom or top or left)
	padding.Parent = parent
	return padding
end

export type ButtonProps = {
	Key: string?,
	Params: { [string]: any }?,
	Text: string?,
	TagKey: string?, -- small right-aligned hint ("Suggested", "No signal yet", ...)
	TagParams: { [string]: any }?,
	OnActivated: (() -> ())?,
	LayoutOrder: number?,
	Height: number?,
	Disabled: boolean?,
	Font: Enum.Font?,
	Parent: Instance?,
}

export type Button = {
	Instance: TextButton,
	Label: TextLabel,
	Tag: TextLabel,
	SetDisabled: (disabled: boolean) -> (),
	SetFocused: (focused: boolean) -> (),
}

function Components.Button(props: ButtonProps): Button
	local height = props.Height or Theme.Sizes.Button
	local button = Instance.new("TextButton")
	button.Name = props.Key or "Button"
	button.AutoButtonColor = false
	button.AutoLocalize = false
	button.Text = ""
	button.BackgroundColor3 = Theme.Colors.TextBright
	button.BackgroundTransparency = 1
	button.BorderSizePixel = 0
	button.Size = UDim2.new(1, 0, 0, height)
	button.LayoutOrder = props.LayoutOrder or 0
	button.Selectable = true
	button.SelectionImageObject = hiddenSelection

	local bar = Instance.new("Frame")
	bar.Name = "FocusBar"
	bar.BackgroundColor3 = Theme.Colors.Accent
	bar.BorderSizePixel = 0
	bar.AnchorPoint = Vector2.new(0, 0.5)
	bar.Position = UDim2.fromScale(0, 0.5)
	bar.Size = UDim2.new(0, 3, 0.55, 0)
	bar.BackgroundTransparency = 1
	bar.Parent = button

	local label = Components.Text({
		Name = "Label",
		Key = props.Key,
		Params = props.Params,
		Text = props.Text,
		Font = props.Font or Theme.Fonts.Medium,
		TextSize = Theme.Sizes.TextButton,
		Wrapped = false,
		Size = UDim2.new(1, -18, 1, 0),
		Position = UDim2.fromOffset(16, 0),
		Parent = button,
	})
	label.TextTruncate = Enum.TextTruncate.AtEnd

	local tag = Components.Text({
		Name = "Tag",
		Key = props.TagKey,
		Params = props.TagParams,
		Font = Theme.Fonts.Mono,
		TextSize = Theme.Sizes.TextSmall,
		Color = Theme.Colors.TextDim,
		XAlign = Enum.TextXAlignment.Right,
		Wrapped = false,
		Size = UDim2.new(0.45, -12, 1, 0),
		Position = UDim2.new(0.55, 0, 0, 0),
		Parent = button,
	})
	tag.Visible = props.TagKey ~= nil
	if tag.Visible then
		label.Size = UDim2.new(0.6, -18, 1, 0)
	end

	local disabled = props.Disabled == true
	local focused = false
	local hovered = false

	local function render()
		local active = (focused or hovered) and not disabled
		TweenService:Create(bar, Theme.Fast, { BackgroundTransparency = if active then 0 else 1 }):Play()
		TweenService:Create(button, Theme.Fast, { BackgroundTransparency = if active then 0.93 else 1 }):Play()
		TweenService:Create(label, Theme.Fast, {
			TextColor3 = if disabled then Theme.Colors.TextFaint elseif active then Theme.Colors.TextBright else Theme.Colors.Text,
			Position = UDim2.fromOffset(if active then 20 else 16, 0),
		}):Play()
	end

	button.MouseEnter:Connect(function()
		hovered = true
		render()
	end)
	button.MouseLeave:Connect(function()
		hovered = false
		render()
	end)
	button.SelectionGained:Connect(function()
		focused = true
		render()
	end)
	button.SelectionLost:Connect(function()
		focused = false
		render()
	end)
	button.Activated:Connect(function()
		if disabled or not props.OnActivated then
			return
		end
		props.OnActivated()
	end)

	render()
	button.Parent = props.Parent

	return {
		Instance = button,
		Label = label,
		Tag = tag,
		SetDisabled = function(value: boolean)
			disabled = value
			render()
		end,
		SetFocused = function(value: boolean)
			focused = value
			render()
		end,
	}
end

-- Scrollable vertical column. Gamepad selection scrolls it automatically.
function Components.ScrollColumn(parent: Instance, size: UDim2, position: UDim2?): ScrollingFrame
	local frame = Instance.new("ScrollingFrame")
	frame.Name = "Scroll"
	frame.BackgroundTransparency = 1
	frame.BorderSizePixel = 0
	frame.Size = size
	frame.Position = position or UDim2.new()
	frame.CanvasSize = UDim2.new()
	frame.AutomaticCanvasSize = Enum.AutomaticSize.Y
	frame.ScrollingDirection = Enum.ScrollingDirection.Y
	frame.ScrollBarThickness = 3
	frame.ScrollBarImageColor3 = Theme.Colors.TextFaint
	frame.Selectable = false
	frame.Parent = parent
	Components.List(frame, Theme.Sizes.Gap)
	Components.Padding(frame, 2, 2, 8, 12)
	return frame
end

function Components.Heading(parent: Instance, key: string, layoutOrder: number?): TextLabel
	return Components.Text({
		Key = key,
		Font = Theme.Fonts.Bold, -- Michroma is reserved for the Latin-only logo (accent coverage)
		TextSize = Theme.Sizes.TextHeading + 4,
		Color = Theme.Colors.TextBright,
		Size = UDim2.new(1, 0, 0, 44),
		LayoutOrder = layoutOrder or 0,
		Parent = parent,
	})
end

function Components.Spacer(parent: Instance, height: number, layoutOrder: number)
	local spacer = Instance.new("Frame")
	spacer.BackgroundTransparency = 1
	spacer.Size = UDim2.new(1, 0, 0, height)
	spacer.LayoutOrder = layoutOrder
	spacer.Parent = parent
	return spacer
end

-- Standard screen root: a CanvasGroup (for fades) holding a left-aligned content column.
function Components.ScreenRoot(name: string): (CanvasGroup, Frame)
	local root = Instance.new("CanvasGroup")
	root.Name = name
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)
	root.GroupTransparency = 1

	local column = Instance.new("Frame")
	column.Name = "Column"
	column.BackgroundTransparency = 1
	column.AnchorPoint = Vector2.new(0, 0.5)
	column.Position = UDim2.new(0, Theme.Sizes.Margin, 0.5, 0)
	column.Size = UDim2.new(0, Theme.Sizes.ContentWidth, 1, -48)
	column.Parent = root
	local constraint = Instance.new("UISizeConstraint")
	constraint.MaxSize = Vector2.new(Theme.Sizes.ContentWidth, math.huge)
	constraint.Parent = column
	return root, column
end

return Components
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="70">
            <Properties>
              <string name="Name">DebugOverlay</string>
              <string name="Source"><![CDATA[-- DebugOverlay: real measured performance numbers (admin only, toggled from Maintenance).
-- Runs no per-frame work while hidden.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local Components = require(script.Parent.Components)
local Theme = require(script.Parent.Theme)

local DebugOverlay = {}

local label: TextLabel? = nil
local connection: RBXScriptConnection? = nil
local providers = {}

function DebugOverlay.Init(gui: ScreenGui, infoProviders)
	providers = infoProviders
	label = Components.Text({
		Name = "Debug",
		Text = "",
		Font = Theme.Fonts.Mono,
		TextSize = 14,
		Color = Theme.Colors.TextBright,
		XAlign = Enum.TextXAlignment.Right,
		Size = UDim2.new(0, 520, 0, 20),
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -136, 0, 18),
		Parent = gui,
	})
	;(label :: TextLabel).TextStrokeTransparency = 0.4
	;(label :: TextLabel).Visible = false
end

function DebugOverlay.IsVisible(): boolean
	return connection ~= nil
end

function DebugOverlay.Toggle()
	local l = label :: TextLabel
	if connection then
		connection:Disconnect()
		connection = nil
		l.Visible = false
		return
	end
	l.Visible = true
	local frames, elapsed, worst = 0, 0, 0
	connection = RunService.RenderStepped:Connect(function(dt)
		frames += 1
		elapsed += dt
		worst = math.max(worst, dt)
		if elapsed < 0.5 then
			return
		end
		local fps = frames / elapsed
		local ping = math.floor(Players.LocalPlayer:GetNetworkPing() * 1000 + 0.5)
		local memory = math.floor(Stats:GetTotalMemoryUsageMb())
		l.Text = string.format(
			"%d FPS (min %d) | %d ms | %d MB | %s Q%d | %s | %s",
			math.floor(fps + 0.5),
			math.floor(1 / worst + 0.5),
			ping,
			memory,
			providers.profile(),
			providers.quality(),
			providers.device(),
			providers.input()
		)
		frames, elapsed, worst = 0, 0, 0
	end)
end

return DebugOverlay
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="71">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- HUD: deliberately minimal. Nothing is permanently on screen; every element appears in
-- context and fades away again.
--   * Subtitles (radio / voices / sound captions). Safety-relevant captions ("critical")
--     are shown even when subtitles are turned off.
--   * Objective toast
--   * Document reader (fax, notes)
--   * Short notifications
--   * Stamina line (only while not full)

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")

local Localization = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Localization"))

local Components = require(script.Parent.Components)
local Theme = require(script.Parent.Theme)

local Hud = {}

local SUBTITLE_SIZES = { small = 18, medium = 22, large = 28 }
local MAX_LINES = 3

local gui: ScreenGui
local settings
local input
local subtitleFrame: Frame
local objectiveFrame: CanvasGroup
local objectiveText: TextLabel
local notifyLabel: TextLabel
local staminaTrack: Frame
local staminaFill: Frame
local documentLayer: Frame? = nil
local documentCallbacks: { onOpen: () -> (), onClose: () -> () }? = nil

type ActiveLine = { label: TextLabel, line: { [string]: any }, expires: number }
local activeLines: { ActiveLine } = {}
local currentObjective: string? = nil
local objectiveToken = 0
local notifyToken = 0
local lineCounter = 0

local function escape(text: string): string
	return (string.gsub(text, "[<>&]", { ["<"] = "&lt;", [">"] = "&gt;", ["&"] = "&amp;" }))
end

local function escapeParams(params: { [string]: any }?): { [string]: any }?
	if not params then
		return nil
	end
	local out = {}
	for key, value in params do
		out[key] = escape(tostring(value))
	end
	return out
end

local function subtitleText(line: { [string]: any }): string
	-- Base strings are ours (no markup); only runtime params (e.g. player names) are escaped.
	local text = Localization.T(line.text, escapeParams(line.params))
	if line.speaker then
		local color = if line.speaker == "SPEAKER_RELAY" then Theme.Colors.Relay else Theme.Colors.Radio
		return string.format('<font color="%s">%s</font>  %s', Theme.Hex(color), escape(Localization.T(line.speaker)), text)
	end
	return string.format('<font color="%s"><i>%s</i></font>', Theme.Hex(Theme.Colors.World), text)
end

local function subtitleSize(): number
	return SUBTITLE_SIZES[settings.Get("subtitleSize")] or SUBTITLE_SIZES.medium
end

local function removeLine(entry: ActiveLine)
	local index = table.find(activeLines, entry)
	if index then
		table.remove(activeLines, index)
	end
	local tween = TweenService:Create(entry.label, Theme.Fade, { TextTransparency = 1, TextStrokeTransparency = 1 })
	tween.Completed:Once(function()
		entry.label:Destroy()
	end)
	tween:Play()
end

function Hud.ShowSubtitle(line: { [string]: any })
	if type(line) ~= "table" or type(line.text) ~= "string" then
		return
	end
	if not settings.Get("subtitles") and not line.critical then
		return
	end
	if #activeLines >= MAX_LINES then
		removeLine(activeLines[1])
	end
	local label = Components.Text({
		Name = "Line",
		Text = "",
		RichText = true,
		Font = Theme.Fonts.Medium,
		TextSize = subtitleSize(),
		Color = Theme.Colors.TextBright,
		XAlign = Enum.TextXAlignment.Center,
		AutoY = true,
		Size = UDim2.fromScale(1, 0),
		Parent = subtitleFrame,
	})
	label.Text = subtitleText(line)
	label.TextStrokeColor3 = Color3.new(0, 0, 0)
	label.TextStrokeTransparency = 1
	label.TextTransparency = 1
	lineCounter += 1
	label.LayoutOrder = lineCounter
	TweenService:Create(label, Theme.Fast, { TextTransparency = 0, TextStrokeTransparency = 0.45 }):Play()

	local duration = math.clamp(tonumber(line.duration) or 4, 1.5, 12)
	local entry: ActiveLine = { label = label, line = line, expires = os.clock() + duration }
	table.insert(activeLines, entry)
	task.delay(duration, function()
		if table.find(activeLines, entry) then
			removeLine(entry)
		end
	end)
end

function Hud.ShowObjective(key: string?, announce: boolean?, params: { [string]: any }?)
	currentObjective = key
	if not key then
		objectiveFrame.Visible = false
		return
	end
	Localization.Bind(objectiveText, key, params)
	objectiveToken += 1
	local token = objectiveToken
	objectiveFrame.Visible = true
	objectiveFrame.GroupTransparency = 1
	TweenService:Create(objectiveFrame, Theme.Slow, { GroupTransparency = 0 }):Play()
	task.delay(if announce == false then 4 else 7, function()
		if token == objectiveToken then
			TweenService:Create(objectiveFrame, Theme.Slow, { GroupTransparency = 1 }):Play()
		end
	end)
end

function Hud.Notify(key: string, params: { [string]: any }?)
	notifyToken += 1
	local token = notifyToken
	Localization.Bind(notifyLabel, key, params)
	notifyLabel.Visible = true
	notifyLabel.TextTransparency = 1
	TweenService:Create(notifyLabel, Theme.Fast, { TextTransparency = 0 }):Play()
	task.delay(4, function()
		if token == notifyToken then
			TweenService:Create(notifyLabel, Theme.Fade, { TextTransparency = 1 }):Play()
		end
	end)
end

function Hud.SetStamina(value: number, exhausted: boolean)
	local visible = value < 0.999
	if staminaTrack.Visible ~= visible then
		staminaTrack.Visible = visible
	end
	staminaFill.Size = UDim2.fromScale(value, 1)
	staminaFill.BackgroundColor3 = if exhausted then Theme.Colors.Accent else Theme.Colors.TextDim
end

local function formatDate(unix: number): string
	local t = os.date("*t", unix)
	return Localization.T("DATE_FORMAT", {
		d = string.format("%02d", t.day),
		m = string.format("%02d", t.month),
		y = tostring(t.year),
	})
end

function Hud.IsDocumentOpen(): boolean
	return documentLayer ~= nil
end

function Hud.CloseDocument()
	if not documentLayer then
		return
	end
	documentLayer:Destroy()
	documentLayer = nil
	GuiService.SelectedObject = nil
	if documentCallbacks then
		documentCallbacks.onClose()
	end
end

function Hud.ShowDocument(document: { [string]: any })
	if type(document) ~= "table" or type(document.title) ~= "string" or type(document.body) ~= "string" then
		return
	end
	Hud.CloseDocument()

	local layer = Instance.new("Frame")
	layer.Name = "Document"
	layer.BackgroundColor3 = Color3.new(0, 0, 0)
	layer.BackgroundTransparency = 0.35
	layer.Size = UDim2.fromScale(1, 1)
	layer.ZIndex = 20
	layer.Parent = gui
	documentLayer = layer

	local unlock = Instance.new("TextButton")
	unlock.Modal = true
	unlock.Text = ""
	unlock.BackgroundTransparency = 1
	unlock.Size = UDim2.fromOffset(0, 0)
	unlock.Selectable = false
	unlock.Parent = layer

	local panel = Instance.new("Frame")
	panel.Name = "Paper"
	panel.AnchorPoint = Vector2.new(0.5, 0.5)
	panel.Position = UDim2.fromScale(0.5, 0.5)
	panel.Size = UDim2.new(0, 520, 0, 0)
	panel.AutomaticSize = Enum.AutomaticSize.Y
	panel.BackgroundColor3 = Theme.Colors.Panel
	panel.BorderSizePixel = 0
	panel.ZIndex = 21
	panel.Parent = layer
	local sizeLimit = Instance.new("UISizeConstraint")
	sizeLimit.MaxSize = Vector2.new(520, 600)
	sizeLimit.Parent = panel
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Colors.PanelLine
	stroke.Parent = panel
	Components.Padding(panel, 28, 24)
	Components.List(panel, 12)

	local params = nil
	if type(document.date) == "number" then
		params = { date = formatDate(document.date) }
	end
	local title = Components.Text({ Key = document.title, Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.Accent, LayoutOrder = 1, Parent = panel })
	title.ZIndex = 22
	local body = Components.Text({ Key = document.body, Params = params, Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextBody, Color = Theme.Colors.TextBright, AutoY = true, Size = UDim2.fromScale(1, 0), YAlign = Enum.TextYAlignment.Top, LayoutOrder = 2, Parent = panel })
	body.ZIndex = 22
	local close = Components.Button({ Key = "DOC_CLOSE", LayoutOrder = 3, OnActivated = Hud.CloseDocument, Parent = panel })
	close.Instance.ZIndex = 22
	for _, child in close.Instance:GetDescendants() do
		if child:IsA("GuiObject") then
			child.ZIndex = 23
		end
	end

	if documentCallbacks then
		documentCallbacks.onOpen()
	end
	if input.GetDevice() == "gamepad" then
		GuiService.SelectedObject = close.Instance
	end
end

function Hud.Init(hudGui: ScreenGui, settingsController, inputController, callbacks: { onOpen: () -> (), onClose: () -> () })
	gui = hudGui
	settings = settingsController
	input = inputController
	documentCallbacks = callbacks

	subtitleFrame = Instance.new("Frame")
	subtitleFrame.Name = "Subtitles"
	subtitleFrame.BackgroundTransparency = 1
	subtitleFrame.AnchorPoint = Vector2.new(0.5, 1)
	subtitleFrame.Position = UDim2.new(0.5, 0, 1, -24)
	subtitleFrame.Size = UDim2.new(0.62, 0, 0.4, 0)
	subtitleFrame.Parent = gui
	local subtitleLayout = Components.List(subtitleFrame, 6)
	subtitleLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	subtitleLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center

	objectiveFrame = Instance.new("CanvasGroup")
	objectiveFrame.Name = "Objective"
	objectiveFrame.BackgroundTransparency = 1
	objectiveFrame.Position = UDim2.fromOffset(24, 16)
	objectiveFrame.Size = UDim2.fromOffset(420, 70)
	objectiveFrame.Visible = false
	objectiveFrame.Parent = gui
	Components.List(objectiveFrame, 2)
	Components.Text({ Key = "OBJECTIVE_NEW", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.Accent, LayoutOrder = 1, Parent = objectiveFrame })
	objectiveText = Components.Text({ Text = "", Font = Theme.Fonts.Medium, TextSize = Theme.Sizes.TextHeading, Color = Theme.Colors.TextBright, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 2, Parent = objectiveFrame })

	notifyLabel = Components.Text({ Text = "", Font = Theme.Fonts.Medium, TextSize = Theme.Sizes.TextBody, Color = Theme.Colors.TextBright, XAlign = Enum.TextXAlignment.Center, Size = UDim2.new(0.8, 0, 0, 28), Position = UDim2.new(0.5, 0, 0, 20), AnchorPoint = Vector2.new(0.5, 0), Parent = gui })
	notifyLabel.Visible = false

	staminaTrack = Instance.new("Frame")
	staminaTrack.Name = "Stamina"
	staminaTrack.AnchorPoint = Vector2.new(0.5, 1)
	staminaTrack.Position = UDim2.new(0.5, 0, 1, -8)
	staminaTrack.Size = UDim2.fromOffset(160, 2)
	staminaTrack.BackgroundColor3 = Theme.Colors.TextFaint
	staminaTrack.BackgroundTransparency = 0.5
	staminaTrack.BorderSizePixel = 0
	staminaTrack.Visible = false
	staminaTrack.Parent = gui
	staminaFill = Instance.new("Frame")
	staminaFill.BorderSizePixel = 0
	staminaFill.BackgroundColor3 = Theme.Colors.TextDim
	staminaFill.Size = UDim2.fromScale(1, 1)
	staminaFill.Parent = staminaTrack

	-- Re-render visible subtitles when the language or subtitle size changes.
	Localization.Changed:Connect(function()
		for _, entry in activeLines do
			entry.label.Text = subtitleText(entry.line)
		end
	end)
	settings.Changed:Connect(function(key)
		if key == "subtitleSize" then
			for _, entry in activeLines do
				entry.label.TextSize = subtitleSize()
			end
		end
	end)

	UserInputService.InputBegan:Connect(function(inputObject)
		if not documentLayer then
			return
		end
		local key = inputObject.KeyCode
		if key == Enum.KeyCode.ButtonB or (key == Enum.KeyCode.Backspace and not UserInputService:GetFocusedTextBox()) then
			Hud.CloseDocument()
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="72">
            <Properties>
              <string name="Name">Router</string>
              <string name="Source"><![CDATA[-- Router: screen stack for menus with fades, gamepad focus and universal "back".
--
-- A screen module exposes .new(router, args) and returns:
--   { Root: GuiObject, Focus: GuiObject?, OnBack: (() -> boolean)?, Destroy: (() -> ())? }
-- OnBack returning true means "handled", otherwise the router pops the screen.
-- Back works with: gamepad B / Circle, keyboard Backspace, and the on-screen Back button.

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Signal = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Signal"))
local Theme = require(script.Parent.Theme)

local Router = {}
Router.__index = Router

function Router.new(container: GuiObject, input)
	local self = setmetatable({
		Container = container,
		Input = input,
		Stack = {},
		Changed = Signal.new(), -- fired with the number of open screens
		RootBackHandler = nil :: (() -> ())?, -- called when Back is pressed on the last screen
	}, Router)

	-- Modal button: frees the mouse in first person while any menu is open.
	local modal = Instance.new("TextButton")
	modal.Name = "MouseUnlock"
	modal.Modal = true
	modal.Text = ""
	modal.BackgroundTransparency = 1
	modal.Size = UDim2.fromOffset(0, 0)
	modal.Selectable = false
	modal.Visible = false
	modal.Parent = container
	self._modal = modal

	UserInputService.InputBegan:Connect(function(inputObject)
		if #self.Stack == 0 then
			return
		end
		local key = inputObject.KeyCode
		if key == Enum.KeyCode.ButtonB or (key == Enum.KeyCode.Backspace and not UserInputService:GetFocusedTextBox()) then
			self:Back()
		end
	end)

	input.DeviceChanged:Connect(function()
		self:RefreshFocus()
	end)

	return self
end

function Router:Top()
	return self.Stack[#self.Stack]
end

function Router:IsOpen(): boolean
	return #self.Stack > 0
end

function Router:RefreshFocus()
	local top = self:Top()
	if top and self.Input.GetDevice() == "gamepad" then
		local current = GuiService.SelectedObject
		if not current or not current:IsDescendantOf(top.Root) then
			GuiService.SelectedObject = top.Focus
		end
	elseif not top then
		GuiService.SelectedObject = nil
	end
end

local function fadeIn(root: GuiObject)
	root.Visible = true
	if root:IsA("CanvasGroup") then
		root.GroupTransparency = 1
		TweenService:Create(root, Theme.Fade, { GroupTransparency = 0 }):Play()
	end
end

function Router:_show(screen)
	screen.Root.Parent = self.Container
	fadeIn(screen.Root)
	self._modal.Visible = true
	self:RefreshFocus()
	self.Changed:Fire(#self.Stack)
end

function Router:Push(screenModule, args: any?)
	local previous = self:Top()
	if previous then
		previous.Root.Visible = false
	end
	local screen = screenModule.new(self, args)
	table.insert(self.Stack, screen)
	self:_show(screen)
	return screen
end

function Router:Pop()
	local screen = table.remove(self.Stack)
	if not screen then
		return
	end
	if screen.Destroy then
		screen.Destroy()
	end
	screen.Root:Destroy()
	local top = self:Top()
	if top then
		self:_show(top)
	else
		self._modal.Visible = false
		GuiService.SelectedObject = nil
		self.Changed:Fire(0)
	end
end

function Router:Replace(screenModule, args: any?)
	self:Clear(true)
	return self:Push(screenModule, args)
end

function Router:Clear(silent: boolean?)
	while #self.Stack > 0 do
		local screen = table.remove(self.Stack)
		if screen.Destroy then
			screen.Destroy()
		end
		screen.Root:Destroy()
	end
	self._modal.Visible = false
	GuiService.SelectedObject = nil
	if not silent then
		self.Changed:Fire(0)
	end
end

function Router:Back()
	local top = self:Top()
	if not top then
		return
	end
	if top.OnBack and top.OnBack() then
		return
	end
	if #self.Stack > 1 then
		self:Pop()
	elseif self.RootBackHandler then
		self.RootBackHandler()
	end
end

return Router
]]></string>
            </Properties>
          </Item>
          <Item class="Folder" referent="73">
            <Properties>
              <string name="Name">Screens</string>
            </Properties>
            <Item class="ModuleScript" referent="74">
              <Properties>
                <string name="Name">Admin</string>
                <string name="Source"><![CDATA[-- Maintenance (owner/developer tools). The server re-checks authorization on every
-- action; this screen is only a convenience UI. World tools (creature spawning, monster
-- mode, teleports, story triggers) are added together with the creature and the map.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local Admin = {}

function Admin.new(router)
	local app = router.App
	local root, column = Components.ScreenRoot("Admin")
	local scroll = Components.ScrollColumn(column, UDim2.fromScale(1, 1))
	column = scroll :: any

	Components.Heading(column, "ADMIN_TITLE", 1)
	Components.Text({
		Text = string.format("input: %s | device: %s", if app.Input.IsUsingActionSystem() then "InputActionSystem" else "fallback", app.Input.GetDevice()),
		Font = Theme.Fonts.Mono,
		TextSize = 13,
		Color = Theme.Colors.TextFaint,
		LayoutOrder = 2,
		Parent = column,
	})
	Components.Spacer(column, 10, 3)

	local status = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, LayoutOrder = 20, Parent = column })

	local debugButton = Components.Button({ Key = "ADMIN_DEBUG", LayoutOrder = 10, Parent = column, OnActivated = function()
		app.Debug.Toggle()
	end })
	Components.Button({ Key = "ADMIN_GRANT_TEST", LayoutOrder = 11, Parent = column, OnActivated = function()
		local ok, response = pcall(function()
			return Net.Function("AdminAction"):InvokeServer("grant_test_marks")
		end)
		local success = ok and type(response) == "table" and response.ok
		Localization.Bind(status, if success then "ADMIN_DONE" else "ADMIN_DENIED")
	end })
	local function action(key: string, order: number, actionName: string)
		Components.Button({ Key = key, LayoutOrder = order, Height = 40, Parent = column, OnActivated = function()
			local ok, response = pcall(function()
				return Net.Function("AdminAction"):InvokeServer(actionName)
			end)
			local success = ok and type(response) == "table" and response.ok
			local reason = ok and type(response) == "table" and response.reason
			Localization.Bind(status, if success then "ADMIN_DONE" elseif reason == "public" then "ADMIN_PUBLIC_BLOCKED" else "ADMIN_DENIED")
			if success and (actionName == "play_creature" or actionName == "play_human" or actionName == "tp_core") then
				app.Play()
			end
		end })
	end
	action("ADMIN_SPAWN_CREATURE", 12, "spawn_creature")
	action("ADMIN_CREATURE_AI", 13, "toggle_ai")
	action("ADMIN_PLAY_CREATURE", 14, "play_creature")
	action("ADMIN_PLAY_HUMAN", 15, "play_human")
	action("ADMIN_TP_CORE", 16, "tp_core")
	action("ADMIN_SPEED", 17, "toggle_speed")
	action("ADMIN_RESET", 18, "reset")
	Components.Spacer(column, 10, 19)
	Components.Button({ Key = "MENU_BACK", LayoutOrder = 30, Parent = column, OnActivated = function()
		router:Pop()
	end })

	return { Root = root, Focus = debugButton.Instance }
end

return Admin
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="75">
              <Properties>
                <string name="Name">Chapters</string>
                <string name="Source"><![CDATA[-- Chapter overview. Locked chapters are visible (they create anticipation) but cannot be
-- started; nothing is ever locked behind Robux.

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local Chapters = {}

local AVAILABLE_IN_BUILD = 1 -- chapters that exist in this build

function Chapters.new(router)
	local app = router.App
	local root, column = Components.ScreenRoot("Chapters")
	local layout = Components.List(column, Theme.Sizes.Gap)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center

	Components.Heading(column, "MENU_CHAPTERS", 1)
	Components.Spacer(column, 10, 2)

	local completed = app.Profile.progress and app.Profile.progress.completed or {}
	local focus = nil
	for number = 1, 4 do
		local unlocked = number <= AVAILABLE_IN_BUILD and (number == 1 or table.find(completed, number - 1) ~= nil)
		local button = Components.Button({
			Key = string.format("CHAPTER_%02d_TITLE", number),
			TagKey = if unlocked then "CHAPTER_LABEL" else "CHAPTER_LOCKED",
			TagParams = if unlocked then { number = number } else nil,
			Disabled = not unlocked,
			LayoutOrder = 10 + number,
			Parent = column,
			OnActivated = function()
				app.Play(number)
			end,
		})
		if unlocked and not focus then
			focus = button.Instance
		end
	end

	Components.Spacer(column, 10, 20)
	local back = Components.Button({ Key = "MENU_BACK", LayoutOrder = 21, Parent = column, OnActivated = function()
		router:Pop()
	end })

	return { Root = root, Focus = focus or back.Instance }
end

return Chapters
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="76">
              <Properties>
                <string name="Name">Extras</string>
                <string name="Source"><![CDATA[-- Extras: transmission codes found in the world. The hidden maintenance entry appears
-- here only after the server confirmed authorization (see AdminService).

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local Extras = {}

local RESULT_KEYS = {
	ok = "CODE_OK",
	invalid = "CODE_INVALID",
	used = "CODE_USED",
	rate_limited = "CODE_RATE_LIMITED",
	error = "CODE_ERROR",
	admin = "ADMIN_GRANTED",
}

function Extras.new(router)
	local player = Players.LocalPlayer
	local root, column = Components.ScreenRoot("Extras")
	local layout = Components.List(column, Theme.Sizes.Gap)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center

	Components.Heading(column, "EXTRAS_TITLE", 1)
	local balance = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, LayoutOrder = 2, Parent = column })
	local function refreshBalance()
		Localization.Bind(balance, "EXTRAS_BALANCE", { amount = player:GetAttribute("FZ_SignalMarks") or 0 })
	end
	refreshBalance()

	Components.Spacer(column, 12, 3)
	Components.Text({ Key = "EXTRAS_CODE_TITLE", Font = Theme.Fonts.Medium, TextSize = Theme.Sizes.TextButton, Color = Theme.Colors.TextBright, LayoutOrder = 4, Parent = column })
	Components.Text({ Key = "EXTRAS_CODE_HINT", TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 5, Parent = column })

	local box = Instance.new("TextBox")
	box.Name = "CodeInput"
	box.AutoLocalize = false
	box.ClearTextOnFocus = false
	box.Text = ""
	box.Font = Theme.Fonts.Mono
	box.TextSize = Theme.Sizes.TextButton
	box.TextColor3 = Theme.Colors.TextBright
	box.PlaceholderColor3 = Theme.Colors.TextFaint
	box.BackgroundColor3 = Theme.Colors.Panel
	box.BackgroundTransparency = 0.1
	box.BorderSizePixel = 0
	box.Size = UDim2.new(1, 0, 0, Theme.Sizes.Button)
	box.TextXAlignment = Enum.TextXAlignment.Left
	box.LayoutOrder = 6
	box.Selectable = true
	Localization.Bind(box, "EXTRAS_CODE_PLACEHOLDER", nil, "PlaceholderText")
	Components.Padding(box, 16, 0)
	local stroke = Instance.new("UIStroke")
	stroke.Color = Theme.Colors.PanelLine
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = box
	box.Parent = column
	box:GetPropertyChangedSignal("Text"):Connect(function()
		if #box.Text > Config.Codes.MaxLength then
			box.Text = string.sub(box.Text, 1, Config.Codes.MaxLength)
		end
	end)
	box.SelectionGained:Connect(function()
		stroke.Color = Theme.Colors.Accent
	end)
	box.SelectionLost:Connect(function()
		stroke.Color = Theme.Colors.PanelLine
	end)

	local result = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextBright, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 8, Parent = column })

	local maintenance
	local pending = false
	local redeemButton
	local function redeem()
		local text = box.Text
		if pending or #string.gsub(text, "%s", "") == 0 then
			return
		end
		pending = true
		redeemButton.SetDisabled(true)
		local ok, response = pcall(function()
			return Net.Function("RedeemCode"):InvokeServer(text)
		end)
		pending = false
		redeemButton.SetDisabled(false)
		local status = if ok and type(response) == "table" then response.status else "error"
		local key = RESULT_KEYS[status] or "CODE_ERROR"
		local positive = status == "ok" or status == "admin"
		result.TextColor3 = if positive then Theme.Colors.Relay else Theme.Colors.TextDim
		Localization.Bind(result, key, { amount = if ok and type(response) == "table" then response.amount or 0 else 0 })
		if positive then
			box.Text = ""
		end
		if status == "admin" then
			maintenance.Instance.Visible = true
		end
	end

	redeemButton = Components.Button({ Key = "EXTRAS_REDEEM", LayoutOrder = 7, Parent = column, OnActivated = redeem })
	box.FocusLost:Connect(function(enterPressed)
		if enterPressed then
			redeem()
		end
	end)

	Components.Spacer(column, 10, 9)
	maintenance = Components.Button({ Key = "ADMIN_TITLE", LayoutOrder = 10, Parent = column, OnActivated = function()
		router:Push(require(script.Parent.Admin))
	end })
	maintenance.Instance.Visible = player:GetAttribute("FZ_Admin") == true

	Components.Button({ Key = "MENU_BACK", LayoutOrder = 11, Parent = column, OnActivated = function()
		router:Pop()
	end })

	local connections = {
		player:GetAttributeChangedSignal("FZ_SignalMarks"):Connect(refreshBalance),
	}

	return {
		Root = root,
		Focus = box,
		Destroy = function()
			for _, connection in connections do
				connection:Disconnect()
			end
		end,
	}
end

return Extras
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="77">
              <Properties>
                <string name="Name">LanguageSelect</string>
                <string name="Source"><![CDATA[-- Language selection. Used on the very first start (before the main menu, cannot be
-- skipped with Back) and from Settings -> Language. One click / one button press selects.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Localization = require(Shared.Localization)

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local LanguageSelect = {}

-- args: { firstStart: boolean, suggested: string?, onChosen: ((string) -> ())? }
function LanguageSelect.new(router, args)
	local app = router.App
	local firstStart = args and args.firstStart
	local suggested = args and args.suggested
	local current = if firstStart then suggested else app.Settings.Get("language")

	local root = Instance.new("CanvasGroup")
	root.Name = "LanguageSelect"
	root.BackgroundTransparency = 1
	root.Size = UDim2.fromScale(1, 1)

	local column = Instance.new("Frame")
	column.BackgroundTransparency = 1
	column.AnchorPoint = Vector2.new(0.5, 0.5)
	column.Position = UDim2.fromScale(0.5, 0.5)
	column.Size = UDim2.new(0, 420, 1, -32)
	column.Parent = root
	local layout = Components.List(column, Theme.Sizes.Gap)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center

	if firstStart then
		Components.Text({ Text = "FREQUENCY ZERO", Font = Theme.Fonts.Title, TextSize = 18, Color = Theme.Colors.TextDim, LayoutOrder = 1, Parent = column })
	end
	Components.Heading(column, "LANG_PROMPT", 2)
	if firstStart and Localization.GetLanguage() ~= Config.FallbackLanguage then
		-- Bilingual header on first start, in case the suggestion is wrong.
		Components.Text({
			Text = Localization.T("LANG_PROMPT", nil, Config.FallbackLanguage),
			Font = Theme.Fonts.Body,
			TextSize = Theme.Sizes.TextBody,
			Color = Theme.Colors.TextDim,
			LayoutOrder = 3,
			Parent = column,
		})
	end
	Components.Spacer(column, 8, 4)

	local focus = nil
	for index, code in Config.Languages do
		local button = Components.Button({
			Text = Config.LanguageNames[code],
			TagKey = if code == suggested and firstStart then "LANG_SUGGESTED" else nil,
			LayoutOrder = 10 + index,
			Parent = column,
			OnActivated = function()
				if firstStart and args.onChosen then
					args.onChosen(code)
				else
					app.Settings.Set("language", code)
					router:Pop()
				end
			end,
		})
		if code == current or (focus == nil and index == 1) then
			focus = button.Instance
		end
		if code == current and not firstStart then
			button.Tag.Visible = true
			button.Tag.Text = "●"
			button.Tag.TextColor3 = Theme.Colors.Accent
		end
	end

	Components.Spacer(column, 8, 20)
	Components.Text({ Key = "LANG_HINT", TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 21, Parent = column })
	if not firstStart then
		Components.Button({ Key = "MENU_BACK", LayoutOrder = 30, Parent = column, OnActivated = function()
			router:Pop()
		end })
	end

	return {
		Root = root,
		Focus = focus,
		OnBack = function()
			return firstStart == true -- first start: a language must be chosen
		end,
	}
end

return LanguageSelect
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="78">
              <Properties>
                <string name="Name">Lobby</string>
                <string name="Source"><![CDATA[-- Team screen: who is in this session, one-tap invite, clear solo message.
-- One Roblox server = one team. Friends who accept the invite join this server.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)
local Localization = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Localization"))

local Lobby = {}

function Lobby.new(router)
	local app = router.App
	local root, column = Components.ScreenRoot("Lobby")
	local layout = Components.List(column, Theme.Sizes.Gap)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center

	Components.Heading(column, "LOBBY_TITLE", 1)
	local count = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, LayoutOrder = 2, Parent = column })

	local list = Instance.new("Frame")
	list.Name = "Players"
	list.BackgroundTransparency = 1
	list.Size = UDim2.fromScale(1, 0)
	list.AutomaticSize = Enum.AutomaticSize.Y
	list.LayoutOrder = 3
	list.Parent = column
	Components.List(list, 2)

	local function refresh()
		for _, child in list:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		local players = Players:GetPlayers()
		Localization.Bind(count, "LOBBY_COUNT", { count = #players, max = Config.MaxPartySize })
		for index, player in players do
			local isSelf = player == Players.LocalPlayer
			local suffix = if isSelf then "  " .. Localization.T("LOBBY_YOU") else ""
			if isSelf then
				Components.Text({
					Text = string.format("%s  @%s%s", player.DisplayName, player.Name, suffix),
					Font = Theme.Fonts.Body,
					TextSize = Theme.Sizes.TextBody,
					Color = Theme.Colors.Text,
					Wrapped = false,
					LayoutOrder = index,
					Parent = list,
				})
			else
				-- Tap a teammate to mute / unmute their voice and radio for you only.
				local muted = app.Voice.IsMuted(player)
				local row = Components.Button({
					Text = string.format("%s  @%s", player.DisplayName, player.Name),
					TagKey = if muted then "LOBBY_UNMUTE" else "LOBBY_MUTE",
					Height = 40,
					LayoutOrder = index,
					Parent = list,
				})
				row.Instance.Activated:Connect(function()
					app.Voice.SetMuted(player, not app.Voice.IsMuted(player))
					refresh()
				end)
			end
		end
	end
	refresh()
	local connections = {
		Players.PlayerAdded:Connect(refresh),
		Players.PlayerRemoving:Connect(function()
			task.defer(refresh)
		end),
		Localization.Changed:Connect(refresh),
	}

	Components.Spacer(column, 10, 4)
	local invite = Components.Button({ Key = "LOBBY_INVITE", LayoutOrder = 5, Parent = column, OnActivated = function()
		task.spawn(function()
			local ok, canInvite = pcall(SocialService.CanSendGameInviteAsync, SocialService, Players.LocalPlayer)
			if ok and canInvite then
				pcall(SocialService.PromptGameInvite, SocialService, Players.LocalPlayer)
			else
				app.Hud.Notify("LOBBY_INVITE_UNAVAILABLE")
			end
		end)
	end })
	Components.Text({ Key = "LOBBY_SOLO_HINT", TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 6, Parent = column })
	Components.Spacer(column, 10, 7)
	Components.Button({ Key = "MENU_BACK", LayoutOrder = 8, Parent = column, OnActivated = function()
		router:Pop()
	end })

	return {
		Root = root,
		Focus = invite.Instance,
		Destroy = function()
			for _, connection in connections do
				connection:Disconnect()
			end
		end,
	}
end

return Lobby
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="79">
              <Properties>
                <string name="Name">MainMenu</string>
                <string name="Source"><![CDATA[-- Main menu (mode "main") and in-game menu (mode "pause").
-- No shop button yet: the shop arrives after the vertical slice (see roadmap).

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Localization = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Localization"))

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local MainMenu = {}

function MainMenu.new(router, args)
	local app = router.App
	local pause = args and args.mode == "pause"
	local root, column = Components.ScreenRoot(if pause then "PauseMenu" else "MainMenu")
	local layout = Components.List(column, Theme.Sizes.Gap)
	layout.VerticalAlignment = Enum.VerticalAlignment.Center

	if pause then
		Components.Heading(column, "PAUSE_TITLE", 1)
		Components.Text({ Key = "PAUSE_NOTE", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 2, Parent = column })
	else
		Components.Text({ Text = "FREQUENCY ZERO", Font = Theme.Fonts.Title, TextSize = Theme.Sizes.TextTitle, Color = Theme.Colors.TextBright, Size = UDim2.new(1, 0, 0, 44), LayoutOrder = 1, Parent = column })
		Components.Text({ Key = "MENU_TAGLINE", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, LayoutOrder = 2, Parent = column })
	end
	Components.Spacer(column, 18, 3)

	local Lobby = require(script.Parent.Lobby)
	local Chapters = require(script.Parent.Chapters)
	local Settings = require(script.Parent.Settings)
	local Extras = require(script.Parent.Extras)
	local Shop = require(script.Parent.Shop)

	local primaryKey = if pause then "MENU_RESUME" elseif app.HasProgress() then "MENU_CONTINUE" else "MENU_PLAY"
	local primary = Components.Button({ Key = primaryKey, LayoutOrder = 10, Parent = column, OnActivated = function()
		app.Play()
	end })
	Components.Button({ Key = "MENU_LOBBY", LayoutOrder = 11, Parent = column, OnActivated = function()
		router:Push(Lobby)
	end })
	if not pause then
		Components.Button({ Key = "MENU_CHAPTERS", LayoutOrder = 12, Parent = column, OnActivated = function()
			router:Push(Chapters)
		end })
	end
	Components.Button({ Key = "MENU_SETTINGS", LayoutOrder = 13, Parent = column, OnActivated = function()
		router:Push(Settings)
	end })
	Components.Button({ Key = "MENU_SHOP", LayoutOrder = 14, Parent = column, OnActivated = function()
		router:Push(Shop)
	end })
	Components.Button({ Key = "MENU_EXTRAS", LayoutOrder = 15, Parent = column, OnActivated = function()
		router:Push(Extras)
	end })
	if pause then
		local mic = Components.Button({ Key = if app.Radio.IsMuted() then "MIC_UNMUTE" else "MIC_MUTE", LayoutOrder = 16, Parent = column })
		mic.Instance.Activated:Connect(function()
			app.Radio.ToggleMute()
			Localization.Bind(mic.Label, if app.Radio.IsMuted() then "MIC_UNMUTE" else "MIC_MUTE")
		end)
	end

	Components.Text({
		Text = "v" .. Config.Version,
		Font = Theme.Fonts.Mono,
		TextSize = 13,
		Color = Theme.Colors.TextFaint,
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, Theme.Sizes.Margin + 16, 1, -12),
		Size = UDim2.fromOffset(200, 18),
		Parent = root,
	})

	return {
		Root = root,
		Focus = primary.Instance,
		OnBack = function()
			if pause then
				app.Play()
			end
			return true
		end,
	}
end

return MainMenu
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="80">
              <Properties>
                <string name="Name">Settings</string>
                <string name="Source"><![CDATA[-- Settings. Every row works the same on every device:
--   mouse / touch: tap the row (next value) or the ‹ › arrows
--   gamepad: A = next value, D-pad left / right = previous / next
--   keyboard: click, or arrow keys while the row is focused
-- Changes apply immediately (no "apply" step) and are saved automatically.

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Localization = require(Shared.Localization)

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local Settings = {}

local function arrow(text: string, parent: Instance, position: UDim2, onActivated: () -> ()): TextButton
	local button = Instance.new("TextButton")
	button.AutoLocalize = false
	button.Text = text
	button.Font = Theme.Fonts.Medium
	button.TextSize = 24
	button.TextColor3 = Theme.Colors.TextDim
	button.BackgroundTransparency = 1
	button.Size = UDim2.new(0, 36, 1, 0)
	button.Position = position
	button.Selectable = false
	button.ZIndex = 3
	button.Parent = parent
	button.Activated:Connect(onActivated)
	return button
end

function Settings.new(router)
	local app = router.App
	local settings = app.Settings
	local root, column = Components.ScreenRoot("Settings")
	column.Size = UDim2.new(0, Theme.Sizes.ContentWidth + 60, 1, -48)
	Components.List(column, Theme.Sizes.Gap)

	Components.Heading(column, "SETTINGS_TITLE", 1)
	local scroll = Components.ScrollColumn(column, UDim2.new(1, 0, 1, -110))
	scroll.LayoutOrder = 2

	local rows: { [GuiObject]: string } = {}
	local valueLabels: { [string]: TextLabel } = {}
	local focus = nil

	local function refreshValues()
		for key, label in valueLabels do
			label.Text = settings.Describe(key)
		end
	end

	local function step(key: string, delta: number, wrapInts: boolean?)
		if key == "language" then
			router:Push(require(script.Parent.LanguageSelect), { firstStart = false })
			return
		end
		local definition = Config.Settings[key]
		if wrapInts and definition.kind == "int" and settings.Get(key) >= definition.max then
			settings.Set(key, definition.min)
		else
			settings.Step(key, delta)
		end
	end

	for index, entry in Config.SettingsOrder do
		local key = entry.key
		-- Row button and value area are siblings (value area on top), so a tap on an
		-- arrow is handled only by the arrow, never also by the row.
		local wrapper = Instance.new("Frame")
		wrapper.Name = key
		wrapper.BackgroundTransparency = 1
		wrapper.Size = UDim2.new(1, 0, 0, Theme.Sizes.Button)
		wrapper.LayoutOrder = index * 2
		wrapper.Parent = scroll

		local row = Components.Button({
			Key = entry.label,
			Parent = wrapper,
			OnActivated = function()
				step(key, 1, true)
			end,
		})
		row.Instance.Size = UDim2.fromScale(1, 1)
		row.Label.Size = UDim2.new(0.5, -16, 1, 0)
		rows[row.Instance] = key
		if not focus then
			focus = row.Instance
		end

		local valueArea = Instance.new("Frame")
		valueArea.Name = "Value"
		valueArea.BackgroundTransparency = 1
		valueArea.Active = false
		valueArea.ZIndex = 2
		valueArea.AnchorPoint = Vector2.new(1, 0)
		valueArea.Position = UDim2.fromScale(1, 0)
		valueArea.Size = UDim2.new(0.5, 0, 1, 0)
		valueArea.Parent = wrapper

		local value = Components.Text({
			Text = "",
			Font = Theme.Fonts.Mono,
			TextSize = Theme.Sizes.TextSmall + 1,
			Color = Theme.Colors.TextBright,
			XAlign = Enum.TextXAlignment.Center,
			Wrapped = false,
			Size = UDim2.new(1, -72, 1, 0),
			Position = UDim2.fromOffset(36, 0),
			Parent = valueArea,
		})
		value.TextTruncate = Enum.TextTruncate.AtEnd
		value.ZIndex = 2
		valueLabels[key] = value

		if key ~= "language" then
			arrow("‹", valueArea, UDim2.fromScale(0, 0), function()
				step(key, -1)
			end)
			arrow("›", valueArea, UDim2.new(1, -36, 0, 0), function()
				step(key, 1)
			end)
		end

		if entry.description then
			Components.Text({
				Key = entry.description,
				TextSize = Theme.Sizes.TextSmall,
				Color = Theme.Colors.TextDim,
				AutoY = true,
				Size = UDim2.fromScale(1, 0),
				LayoutOrder = index * 2 + 1,
				Parent = scroll,
			})
		end
	end

	local back = Components.Button({ Key = "MENU_BACK", LayoutOrder = 3, Parent = column, OnActivated = function()
		router:Pop()
	end })
	back.Instance.Size = UDim2.new(1, 0, 0, Theme.Sizes.Button)

	refreshValues()
	local connections = {
		settings.Changed:Connect(refreshValues),
		Localization.Changed:Connect(refreshValues),
		UserInputService.InputBegan:Connect(function(input)
			local selected = GuiService.SelectedObject
			local key = selected and rows[selected]
			if not key or key == "language" then
				return
			end
			if input.KeyCode == Enum.KeyCode.DPadLeft or input.KeyCode == Enum.KeyCode.Left then
				step(key, -1)
			elseif input.KeyCode == Enum.KeyCode.DPadRight or input.KeyCode == Enum.KeyCode.Right then
				step(key, 1)
			end
		end),
	}

	-- D-pad left/right must change values instead of moving focus out of the row.
	for row in rows do
		row.NextSelectionLeft = row
		row.NextSelectionRight = row
	end

	return {
		Root = root,
		Focus = focus,
		Destroy = function()
			for _, connection in connections do
				connection:Disconnect()
			end
		end,
	}
end

return Settings
]]></string>
              </Properties>
            </Item>
            <Item class="ModuleScript" referent="81">
              <Properties>
                <string name="Name">Shop</string>
                <string name="Source"><![CDATA[-- Shop: tabs (Equipment / Upgrades / Cosmetics) with large cards, Signal Mark balance,
-- confirmation before every unlock. Works with mouse, touch and gamepad (cards are
-- selectable buttons, tabs too). No Robux prompts in here except the clearly labelled,
-- purely cosmetic supporter pass (only shown when its id is configured).

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local GuiService = game:GetService("GuiService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Catalog = require(Shared.Catalog)
local Localization = require(Shared.Localization)
local Net = require(Shared.Net)

local Components = require(script.Parent.Parent.Components)
local Theme = require(script.Parent.Parent.Theme)

local Shop = {}

local RESULT = { funds = "SHOP_NOT_ENOUGH", error = "SHOP_ERROR", owned = "SHOP_OWNED" }

function Shop.new(router)
	local app = router.App
	local player = Players.LocalPlayer
	local root, column = Components.ScreenRoot("Shop")
	column.Size = UDim2.new(0, 640, 1, -48)
	local sizeLimit = column:FindFirstChildOfClass("UISizeConstraint")
	if sizeLimit then
		sizeLimit.MaxSize = Vector2.new(640, math.huge)
	end
	Components.List(column, Theme.Sizes.Gap)

	local header = Instance.new("Frame")
	header.BackgroundTransparency = 1
	header.Size = UDim2.new(1, 0, 0, 44)
	header.LayoutOrder = 1
	header.Parent = column
	Components.Heading(header, "MENU_SHOP")
	local balance = Components.Text({ Text = "", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextBody, Color = Theme.Colors.Radio, XAlign = Enum.TextXAlignment.Right, Size = UDim2.new(0.5, 0, 1, 0), Position = UDim2.fromScale(0.5, 0), Parent = header })

	local tabsRow = Instance.new("Frame")
	tabsRow.BackgroundTransparency = 1
	tabsRow.Size = UDim2.new(1, 0, 0, 40)
	tabsRow.LayoutOrder = 2
	tabsRow.Parent = column
	Components.List(tabsRow, 4, true)

	local grid = Instance.new("ScrollingFrame")
	grid.Name = "Grid"
	grid.BackgroundTransparency = 1
	grid.BorderSizePixel = 0
	grid.Size = UDim2.new(1, 0, 1, -220)
	grid.CanvasSize = UDim2.new()
	grid.AutomaticCanvasSize = Enum.AutomaticSize.Y
	grid.ScrollBarThickness = 3
	grid.ScrollBarImageColor3 = Theme.Colors.TextFaint
	grid.Selectable = false
	grid.LayoutOrder = 3
	grid.Parent = column
	local gridLayout = Instance.new("UIGridLayout")
	gridLayout.CellSize = UDim2.new(0.5, -6, 0, 132)
	gridLayout.CellPadding = UDim2.fromOffset(8, 8)
	gridLayout.SortOrder = Enum.SortOrder.LayoutOrder
	gridLayout.Parent = grid

	local status = Components.Text({ Key = "SHOP_FAIR", Font = Theme.Fonts.Mono, TextSize = Theme.Sizes.TextSmall, Color = Theme.Colors.TextDim, AutoY = true, Size = UDim2.fromScale(1, 0), LayoutOrder = 4, Parent = column })
	Components.Button({ Key = "MENU_BACK", LayoutOrder = 6, Parent = column, OnActivated = function()
		router:Pop()
	end })

	local data = { inventory = {}, equipped = {}, balance = 0 }
	local currentTab = "gear"
	local pendingConfirm: string? = nil
	local busy = false
	local firstCard: GuiObject? = nil
	local render: () -> ()

	local function setStatus(key: string, params: { [string]: any }?, positive: boolean?)
		status.TextColor3 = if positive then Theme.Colors.Relay else Theme.Colors.TextDim
		Localization.Bind(status, key, params)
	end

	local function call(action: string, itemId: string?)
		if busy then
			return
		end
		busy = true
		local ok, result = pcall(function()
			return Net.Function("ShopAction"):InvokeServer(action, itemId)
		end)
		busy = false
		if ok and type(result) == "table" and result.inventory then
			data = result
		end
		if not ok or type(result) ~= "table" or not result.ok then
			setStatus(RESULT[(type(result) == "table" and result.reason) or "error"] or "SHOP_ERROR")
		elseif action == "buy" then
			setStatus("SHOP_DONE", nil, true)
		elseif action == "equip" and Catalog.Items[itemId :: string].kind == "set" then
			setStatus("SHOP_ONE_SET")
		end
		render()
	end

	local function card(itemId: string, order: number)
		local item = Catalog.Items[itemId]
		local owned = data.inventory[itemId] == true
		local equipped = data.equipped.set == itemId or data.equipped.radioSkin == itemId
		local button = Instance.new("TextButton")
		button.Name = itemId
		button.AutoButtonColor = false
		button.Text = ""
		button.AutoLocalize = false
		button.BackgroundColor3 = Theme.Colors.Panel
		button.BackgroundTransparency = 0.05
		button.LayoutOrder = order
		button.Selectable = true
		local stroke = Instance.new("UIStroke")
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
		stroke.Color = if equipped then Theme.Colors.Relay else Theme.Colors.PanelLine
		stroke.Thickness = if equipped then 2 else 1
		stroke.Parent = button
		local selection = Instance.new("Frame")
		selection.BackgroundTransparency = 1
		local selectionStroke = Instance.new("UIStroke")
		selectionStroke.Color = Theme.Colors.Accent
		selectionStroke.Thickness = 2
		selectionStroke.Parent = selection
		button.SelectionImageObject = selection
		button.Parent = grid
		Components.Padding(button, 12, 10)

		local icon = Instance.new("Frame")
		icon.Size = UDim2.fromOffset(56, 56)
		icon.BackgroundColor3 = item.color
		icon.BorderSizePixel = 0
		icon.Parent = button
		Components.Text({ Text = item.icon, Font = Theme.Fonts.Mono, TextSize = 14, Color = Theme.Colors.TextBright, XAlign = Enum.TextXAlignment.Center, Size = UDim2.fromScale(1, 1), Parent = icon })

		Components.Text({ Key = item.name, Font = Theme.Fonts.Bold, TextSize = Theme.Sizes.TextBody, Color = Theme.Colors.TextBright, Size = UDim2.new(1, -66, 0, 22), Position = UDim2.fromOffset(66, 0), Wrapped = false, Parent = button })
		local desc = Components.Text({ Key = item.description, TextSize = 13, Color = Theme.Colors.TextDim, Size = UDim2.new(1, -66, 0, 54), Position = UDim2.fromOffset(66, 22), YAlign = Enum.TextYAlignment.Top, Parent = button })
		desc.TextTruncate = Enum.TextTruncate.AtEnd

		local actionKey, params
		if pendingConfirm == itemId then
			actionKey, params = "SHOP_CONFIRM_YES", nil
		elseif not owned then
			actionKey, params = "SHOP_BUY", { price = item.price }
		elseif equipped and item.kind ~= "upgrade" then
			actionKey = "SHOP_UNEQUIP"
		elseif item.kind == "upgrade" then
			actionKey = "SHOP_OWNED"
		else
			actionKey = "SHOP_EQUIP"
		end
		local action = Components.Text({ Key = actionKey, Params = params, Font = Theme.Fonts.Mono, TextSize = 14, Color = if pendingConfirm == itemId then Theme.Colors.Accent elseif owned then Theme.Colors.Relay else Theme.Colors.Radio, XAlign = Enum.TextXAlignment.Right, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 1, -20), Parent = button })
		action.Name = "Action"

		button.Activated:Connect(function()
			if not owned then
				if pendingConfirm == itemId then
					pendingConfirm = nil
					call("buy", itemId)
				else
					pendingConfirm = itemId
					setStatus("SHOP_CONFIRM", { price = item.price })
					render()
					GuiService.SelectedObject = grid:FindFirstChild(itemId) :: GuiObject?
				end
			elseif item.kind ~= "upgrade" then
				call(if equipped then "unequip" else "equip", itemId)
			end
		end)
		if not firstCard then
			firstCard = button
		end
	end

	local tabButtons = {}
	render = function()
		local selectedName = GuiService.SelectedObject and GuiService.SelectedObject.Name
		Localization.Bind(balance, "EXTRAS_BALANCE", { amount = data.balance or 0 })
		for _, child in grid:GetChildren() do
			if child:IsA("GuiObject") then
				child:Destroy()
			end
		end
		firstCard = nil
		for index, itemId in Catalog.Order do
			if Catalog.Items[itemId].tab == currentTab then
				card(itemId, index)
			end
		end
		for tab, button in tabButtons do
			button.SetFocused(tab == currentTab)
		end
		if selectedName and app.Input.GetDevice() == "gamepad" then
			local again = grid:FindFirstChild(selectedName)
			if again then
				GuiService.SelectedObject = again :: GuiObject
			end
		end
	end

	for index, tab in Catalog.Tabs do
		local tabButton = Components.Button({ Key = Catalog.TabLabels[tab], Height = 40, LayoutOrder = index, Parent = tabsRow, OnActivated = function()
			currentTab = tab
			pendingConfirm = nil
			render()
		end })
		tabButton.Instance.Size = UDim2.new(1 / #Catalog.Tabs, -4, 1, 0)
		tabButton.Label.TextSize = Theme.Sizes.TextBody
		tabButtons[tab] = tabButton
	end

	-- Cosmetic supporter pass (Robux), only if configured
	for _, pass in Catalog.GamePasses do
		if pass.id > 0 then
			Components.Button({ Key = pass.name, TagKey = pass.description, LayoutOrder = 5, Parent = column, OnActivated = function()
				MarketplaceService:PromptGamePassPurchase(player, pass.id)
			end })
		end
	end

	render()
	task.spawn(call, "get")

	return {
		Root = root,
		Focus = tabButtons.gear.Instance,
		OnBack = function()
			if pendingConfirm then
				pendingConfirm = nil
				render()
				return true
			end
			return false
		end,
	}
end

return Shop
]]></string>
              </Properties>
            </Item>
          </Item>
          <Item class="ModuleScript" referent="82">
            <Properties>
              <string name="Name">Theme</string>
              <string name="Source"><![CDATA[-- Visual language of every interface: quiet, cinematic, high contrast, one accent colour.

local Theme = {}

Theme.Colors = {
	Background = Color3.fromRGB(6, 8, 9),
	Panel = Color3.fromRGB(13, 17, 19),
	PanelLine = Color3.fromRGB(38, 44, 46),
	Text = Color3.fromRGB(206, 202, 192),
	TextBright = Color3.fromRGB(240, 236, 226),
	TextDim = Color3.fromRGB(128, 134, 131),
	TextFaint = Color3.fromRGB(78, 84, 82),
	Accent = Color3.fromRGB(201, 64, 48), -- "signal red": focus bar, warnings, live signal
	Radio = Color3.fromRGB(214, 184, 120), -- unknown voices on the radio (warm amber)
	Relay = Color3.fromRGB(146, 192, 188), -- the Relay voice (cold teal)
	World = Color3.fromRGB(180, 180, 172), -- sound captions
}

Theme.Fonts = {
	Title = Enum.Font.Michroma,
	Body = Enum.Font.BuilderSans,
	Medium = Enum.Font.BuilderSansMedium,
	Bold = Enum.Font.BuilderSansBold,
	Mono = Enum.Font.RobotoMono,
}

-- Logical sizes at UIScale 1 (UIScale adapts them to the device, see Components.AttachScale).
Theme.Sizes = {
	Button = 48,
	Gap = 6,
	TextTitle = 30,
	TextHeading = 24,
	TextButton = 22,
	TextBody = 18,
	TextSmall = 15,
	Margin = 48,
	ContentWidth = 440,
}

Theme.Fast = TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
Theme.Fade = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
Theme.Slow = TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.Out)

function Theme.Hex(color: Color3): string
	return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

return Theme
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
