	SFX_CREATURE_NEAR = "[Estalos de estática – muito perto]",
	SFX_VENT = "[Algo se move dentro dos dutos]",
	SFX_POWER_DOWN = "[A energia cai]",
	SFX_RELAY = "[Um relé começa a zumbir]",
	SIGN_SECTOR_A = "SETOR A\nADMINISTRAÇÃO",
