 "sentences": [
  {
   "t": 0.1,
   "end": 1.06,
   "text": "Ganz Deutschland."
  },
  {
   "t": 1.53,
   "end": 2.43,
   "text": "Kein Strom."
  },
  {
   "t": 2.8,
   "end": 4.7,
   "text": "72 Stunden."
  },
  {
   "t": 5.12,
   "end": 6.59,
   "text": "Die erste Stunde ist noch lustig."
  },
  {
   "t": 6.99,
   "end": 7.75,
   "text": "Minute 1:"
  },
  {
   "t": 8.02,
   "end": 8.7,
   "text": "Ampeln aus."
  },
  {
   "t": 8.93,
   "end": 10.09,
   "text": "Aufzüge stecken fest."
  },
  {
   "t": 10.39,
   "end": 11.89,
   "text": "Alle zücken die Handylampe."
  },
  {
   "t": 12.11,
   "end": 14.34,
   "text": "Fühlt sich noch an wie ein Abenteuer."
  },
  {
   "t": 14.75,
   "end": 15.53,
   "text": "Stunde 3:"
  },
  {
   "t": 16.0,
   "end": 18.14,
   "text": "Viele Funkmasten laufen nur noch auf Akku."
  },
  {
   "t": 18.56,
   "end": 19.37,
   "text": "Dann ist Schluss."
  },
  {
   "t": 19.73,
   "end": 22.33,
   "text": "Kein Netz, kein WhatsApp, kein Notruf."
  },
  {
   "t": 22.76,
   "end": 24.64,
   "text": "Dein Handy ist jetzt eine Taschenlampe."
  },
  {
   "t": 25.07,
   "end": 25.78,
   "text": "Stunde 12:"
  },
  {
   "t": 26.31,
   "end": 29.74,
   "text": "Tankstellen geben kein Benzin mehr raus, denn die Pumpen brauchen Strom."
  },
  {
   "t": 30.07,
   "end": 32.39,
   "text": "Karte geht nicht, Geldautomat auch nicht."
  },
  {
   "t": 32.71,
   "end": 33.83,
   "text": "Kein Bargeld heißt:"
  },
  {
   "t": 34.08,
   "end": 35.18,
   "text": "Du kaufst nichts mehr."
  },
  {
   "t": 35.55,
   "end": 36.75,
   "text": "Stunde 24:"
  },
  {
   "t": 37.16,
   "end": 39.96,
   "text": "In Hochhäusern kommt oben kein Wasser mehr an."
  },
  {
   "t": 40.18,
   "end": 41.03,
   "text": "Keine Dusche."
  },
  {
   "t": 41.32,
   "end": 44.29,
   "text": "Und die Toilette spült genau noch ein Mal."
  },
  {
   "t": 44.65,
   "end": 45.85,
   "text": "Stunde 48:"
  },
  {
   "t": 46.18,
   "end": 47.99,
   "text": "Krankenhäuser laufen auf Notstrom."
  },
  {
   "t": 48.39,
   "end": 49.15,
   "text": "Mit Diesel."
  },
  {
   "t": 49.51,
   "end": 54.43,
   "text": "Den muss jemand liefern, über Straßen ohne Ampeln und mit LKWs, die nicht tanken können."
  },
  {
   "t": 54.92,
   "end": 56.02,
   "text": "Stunde 72:"
  },
  {
   "t": 56.64,
   "end": 57.62,
   "text": "Supermärkte leer."
  },
  {
   "t": 58.05,
   "end": 59.02,
   "text": "Kühlschränke warm."
  },
  {
   "t": 59.51,
   "end": 60.88,
   "text": "Jemand klopft an deine Tür."
  },
  {
   "t": 61.33,
   "end": 63.28,
   "text": "Und jetzt die Frage, die keiner hören will:"
  },
  {
   "t": 64.75,
   "end": 67.17,
   "text": "Der Staat empfiehlt Vorräte für 10 Tage."
  },
  {
   "t": 67.52,
   "end": 69.46,
   "text": "Du hast wahrscheinlich nicht mal welche für 3."
  },
  {
   "t": 69.82,
   "end": 71.35,
   "text": "Denn genau so fängt es an …"
  },
  {
   "t": 71.86,
   "end": 73.02,
   "text": "Wie lange hältst du durch?"
  },
  {
   "t": 73.28,
   "end": 74.47,
   "text": "Schreib's in die Kommentare!"
  }
 ]
}